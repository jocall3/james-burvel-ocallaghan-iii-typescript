interface I18nContextType {
  locale: Locale;
  setLocale: (newLocale: Locale) => void;
  t: (key: string, args?: Record<string, string | number>) => string;
}

export const I18nContext = createContext<I18nContextType | undefined>(undefined);

export const I18nProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const { user } = useUser();
  const [locale, setLocaleState] = useLocalStorage<Locale>(
    'appLocale',
    user?.preferredLocale === 'es-ES' ? 'es-ES' : 'en-US', // Default to user's preferred or en-US
  );

  useEffect(() => {
    // Update locale if user preference changes
    if (user?.preferredLocale && user.preferredLocale !== locale) {
      setLocaleState(user.preferredLocale as Locale);
    }
  }, [user?.preferredLocale, locale, setLocaleState]);

  const t = useCallback(
    (key: string, args?: Record<string, string | number>): string => {
      const translation = messages[locale]?.[key];
      if (typeof translation === 'string') {
        let result = translation;
        if (args) {
          for (const argKey in args) {
            result = result.replace(`{{${argKey}}}`, String(args[argKey]));
          }
        }
        return result;
      }
      if (typeof translation === 'object' && translation !== null) {
        // Handle pluralization or context-specific translations if needed
        // For simplicity, return default if not a string directly
        return (translation as any).default || key;
      }
      return key; // Fallback to key if translation not found
    },
    [locale],
  );

  const setLocale = useCallback((newLocale: Locale) => {
    setLocaleState(newLocale);
    // Optionally update user preference
    // userContext.updateUserPreferences({ preferredLocale: newLocale });
  }, []);

  const value = useMemo(() => ({ locale, setLocale, t }), [locale, setLocale, t]);

  return <I18nContext.Provider value={value}>{children}</I18nContext.Provider>;
};

export const useI18n = () => {
  const context = useContext(I18nContext);
  if (context === undefined) {
    throw new Error('useI18n must be used within an I18nProvider');
  }
  return context;
};

// 4. Notification Context
type NotificationType = 'success' | 'error' | 'warning' | 'info';

interface Notification {
  id: string;
  message: string;
  type: NotificationType;
  duration?: number; // ms, 0 for sticky
  isPersistent?: boolean; // If user dismisses, it stays until they explicitly remove
}

interface NotificationContextType {
  notifications: Notification[];
  addNotification: (message: string, type: NotificationType, duration?: number) => string;
  removeNotification: (id: string) => void;
  clearAllNotifications: () => void;
}

export const NotificationContext = createContext<NotificationContextType | undefined>(undefined);

export const NotificationProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [notifications, setNotifications] = useState<Notification[]>([]);

  const addNotification = useCallback(
    (message: string, type: NotificationType, duration: number = 5000) => {
      const id = generateUUID();
      const newNotification: Notification = { id, message, type, duration };
      setNotifications((prev) => [...prev, newNotification]);

      if (duration > 0) {
        setTimeout(() => {
          setNotifications((prev) => prev.filter((n) => n.id !== id));
        }, duration);
      }
      return id;
    },
    [],
  );

  const removeNotification = useCallback((id: string) => {
    setNotifications((prev) => prev.filter((n) => n.id !== id));
  }, []);

  const clearAllNotifications = useCallback(() => {
    setNotifications([]);
  }, []);

  const value = useMemo(
    () => ({ notifications, addNotification, removeNotification, clearAllNotifications }),
    [notifications, addNotification, removeNotification, clearAllNotifications],
  );

  return <NotificationContext.Provider value={value}>{children}</NotificationContext.Provider>;
};

export const useNotifications = () => {
  const context = useContext(NotificationContext);
  if (context === undefined) {
    throw new Error('useNotifications must be used within a NotificationProvider');
  }
  return context;
}

// 5. Audit Log Context
type AuditAction =
  | 'ACCOUNT_VIEWED'
  | 'ACCOUNT_FILTERED'
  | 'ACCOUNT_SEARCHED'
  | 'ACCOUNT_SELECTED'
  | 'ACCOUNT_HIDDEN'
  | 'ACCOUNT_UNHIDDEN'
  | 'ACCOUNT_NICKNAME_UPDATED'
  | 'USER_LOGIN'
  | 'USER_LOGOUT'
  | 'PREFERENCES_UPDATED'
  | 'TRANSFER_INITIATED'
  | 'BILL_PAID'
  | 'ERROR';

interface AuditLogEntry {
  id: string;
  timestamp: Date;
  userId: string | null;
  action: AuditAction;
  details: Record<string, any>;
  ipAddress: string; // In a real app, this would be captured server-side
}

interface AuditLogContextType {
  logAction: (action: AuditAction, details?: Record<string, any>) => void;
  getRecentLogs: () => AuditLogEntry[];
}

export const AuditLogContext = createContext<AuditLogContextType | undefined>(undefined);

export const AuditLogProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const { user } = useUser();
  const [logs, setLogs] = useLocalStorage<AuditLogEntry[]>('auditLogs', []);

  // Simulate capturing IP address (client-side approximation)
  const getIpAddress = useCallback((): string => {
    return '192.168.1.1'; // Mock IP
  }, []);

  const logAction = useCallback(
    (action: AuditAction, details: Record<string, any> = {}) => {
      const newEntry: AuditLogEntry = {
        id: generateUUID(),
        timestamp: new Date(),
        userId: user?.id || null,
        action,
        details,
        ipAddress: getIpAddress(),
      };
      setLogs((prev) => [newEntry, ...prev].slice(0, 100)); // Keep last 100 logs
      console.log('AUDIT LOG:', newEntry);
    },
    [user?.id, getIpAddress, setLogs],
  );

  const getRecentLogs = useCallback(() => {
    return logs;
  }, [logs]);

  const value = useMemo(() => ({ logAction, getRecentLogs }), [logAction, getRecentLogs]);

  return <AuditLogContext.Provider value={value}>{children}</AuditLogContext.Provider>;
};

export const useAuditLog = () => {
  const context = useContext(AuditLogContext);
  if (context === undefined) {
    throw new Error('useAuditLog must be used within an AuditLogProvider');
  }
  return context;
};

// --- GraphQL Query Definition (from original JSON) ---
// This would typically be in a .graphql file and imported, or generated by a tool.
// For this exercise, it's embedded.
const ACCOUNT_SELECT_QUERY = `
  query accountSelect($includeAllAccountsOption: Boolean, $accountIds: [ID!], $accountSearchName: String, $isMulti: Boolean) {
    accountSelectOptions(
      includeAllAccountsOption: $includeAllAccountsOption
      accountIds: $accountIds
      accountSearchName: $accountSearchName
      isMulti: $isMulti
    ) {
      typename: __typename
      ... on SelectSimpleOption {
        label
        value
        __typename
      }
      ... on SelectGroupOption {
        label
        options {
          label
          value
          __typename
        }
        __typename
      }
    }
  }
`;

// --- GraphQL Client Emulation (Apollo Client like structure) ---
// In a real application, you would use @apollo/client or similar.
// Here, we simulate the `useQuery` hook.

interface SelectSimpleOption {
  label: string;
  value: string;
  __typename: 'SelectSimpleOption';
}

interface SelectGroupOption {
  label: string;
  options: SelectSimpleOption[];
  __typename: 'SelectGroupOption';
}

type AccountSelectOption = SelectSimpleOption | SelectGroupOption;

interface AccountSelectQueryVariables {
  includeAllAccountsOption?: boolean;
  accountIds?: string[];
  accountSearchName?: string;
  isMulti?: boolean;
}

interface AccountSelectQueryData {
  accountSelectOptions: AccountSelectOption[];
}

interface UseQueryResult<TData, TVariables> {
  data?: TData;
  loading: boolean;
  error?: Error;
  refetch: (variables?: TVariables) => Promise<any>;
}

