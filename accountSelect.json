// 1. User Context
export interface UserProfile {
  id: string;
  firstName: string;
  lastName: string;
  email: string;
  preferredLocale: string;
  permissions: {
    canViewAllAccounts: boolean;
    canInitiateTransfers: boolean;
    canManageBeneficiaries: boolean;
    canViewStatements: boolean;
    accountAccess: Record<string, 'read' | 'write' | 'none'>; // Specific account permissions
  };
  lastLogin: Date;
  themePreference: 'light' | 'dark' | 'system';
}

interface UserContextType {
  user: UserProfile | null;
  isAuthenticated: boolean;
  login: (credentials: any) => Promise<void>;
  logout: () => void;
  updateUserPreferences: (prefs: Partial<UserProfile>) => void;
  hasAccountAccess: (accountId: string, level: 'read' | 'write') => boolean;
}

const defaultUserProfile: UserProfile = {
  id: 'USER_001',
  firstName: 'Jane',
  lastName: 'Doe',
  email: 'jane.doe@examplebank.com',
  preferredLocale: 'en-US',
  permissions: {
    canViewAllAccounts: false, // Default to false, controlled by role
    canInitiateTransfers: true,
    canManageBeneficiaries: true,
    canViewStatements: true,
    accountAccess: {
      'ACC_001': 'write', // Checking
      'ACC_002': 'read', // Savings
      'ACC_003': 'none', // Restricted account
      'ACC_004': 'write', // Credit Card
      'ACC_005': 'read', // Investment
    },
  },
  lastLogin: new Date(),
  themePreference: 'system',
};

export const UserContext = createContext<UserContextType | undefined>(undefined);

export const UserProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [user, setUser] = useLocalStorage<UserProfile | null>('currentUser', null);
  const [isAuthenticated, setIsAuthenticated] = useState(false);

  useEffect(() => {
    // Simulate initial authentication check or token validation
    if (user?.id) {
      setIsAuthenticated(true);
      // Refresh user data or validate session here
    }
  }, [user]);

  const login = useCallback(async (credentials: any) => {
    // Simulate API call for login
    return new Promise<void>((resolve) => {
      setTimeout(() => {
        console.log('Simulating login for:', credentials);
        setUser({ ...defaultUserProfile, email: credentials.username });
        setIsAuthenticated(true);
        resolve();
      }, 1000);
    });
  }, []);

  const logout = useCallback(() => {
    setUser(null);
    setIsAuthenticated(false);
    console.log('User logged out.');
  }, []);

  const updateUserPreferences = useCallback((prefs: Partial<UserProfile>) => {
    setUser((prevUser) => (prevUser ? { ...prevUser, ...prefs } : null));
    console.log('User preferences updated:', prefs);
  }, []);

  const hasAccountAccess = useCallback(
    (accountId: string, level: 'read' | 'write'): boolean => {
      if (!user) return false;
      if (user.permissions.canViewAllAccounts) return true; // Admin/Super user access

      const accessLevel = user.permissions.accountAccess[accountId];
      if (level === 'read') return accessLevel === 'read' || accessLevel === 'write';
      if (level === 'write') return accessLevel === 'write';
      return false;
    },
    [user],
  );

  const value = useMemo(
    () => ({
      user,
      isAuthenticated,
      login,
      logout,
      updateUserPreferences,
      hasAccountAccess,
    }),
    [user, isAuthenticated, login, logout, updateUserPreferences, hasAccountAccess],
  );

  return <UserContext.Provider value={value}>{children}</UserContext.Provider>;
};

export const useUser = () => {
  const context = useContext(UserContext);
  if (context === undefined) {
    throw new Error('useUser must be used within a UserProvider');
  }
  return context;
};

// 2. Theme Context
type ThemeMode = 'light' | 'dark';
interface ThemeContextType {
  theme: ThemeMode;
  toggleTheme: () => void;
  setTheme: (mode: ThemeMode) => void;
}

export const ThemeContext = createContext<ThemeContextType | undefined>(undefined);

export const ThemeProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [theme, setThemeState] = useLocalStorage<ThemeMode>('appTheme', 'light');
  const { user } = useUser();

  useEffect(() => {
    // Apply theme to document body
    document.documentElement.classList.remove('light', 'dark');
    document.documentElement.classList.add(theme);
  }, [theme]);

  useEffect(() => {
    // Apply user's preferred theme from profile
    if (user?.themePreference === 'dark') {
      setThemeState('dark');
    } else if (user?.themePreference === 'light') {
      setThemeState('light');
    } else if (user?.themePreference === 'system') {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      setThemeState(prefersDark ? 'dark' : 'light');
    }
  }, [user?.themePreference, setThemeState]);

  const toggleTheme = useCallback(() => {
    setThemeState((prev) => (prev === 'light' ? 'dark' : 'light'));
  }, []);

  const setTheme = useCallback((mode: ThemeMode) => {
    setThemeState(mode);
  }, []);

  const value = useMemo(() => ({ theme, toggleTheme, setTheme }), [theme, toggleTheme, setTheme]);

  return <ThemeContext.Provider value={value}>{children}</ThemeContext.Provider>;
};

export const useTheme = () => {
  const context = useContext(ThemeContext);
  if (context === undefined) {
    throw new Error('useTheme must be used within a ThemeProvider');
  }
  return context;
};

