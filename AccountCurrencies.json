/**
 * PrivateRoute: A wrapper component for routes that require authentication and/or specific roles.
 */
export const PrivateRoute: React.FC<{
  children: React.ReactNode;
  roles?: UserRole[];
}> = ({ children, roles }) => {
  const { isAuthenticated, hasRole } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();

  useEffect(() => {
    if (!isAuthenticated) {
      navigate("/login", { state: { from: location } }); // Redirect to login
    } else if (roles && !roles.some((role) => hasRole(role))) {
      navigate("/unauthorized"); // Redirect to unauthorized page
    }
  }, [isAuthenticated, roles, hasRole, navigate, location]);

  if (!isAuthenticated || (roles && !roles.some((role) => hasRole(role)))) {
    return null; // Or a loading spinner
  }

  return <>{children}</>;
};

