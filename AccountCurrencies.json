// --- TypeScript Interfaces for Data Models ---
export interface Currency {
  code: string; // e.g., "USD"
  name: string; // e.g., "United States Dollar"
  symbol: string; // e.g., "$"
  country: string; // e.g., "USA"
  status: CurrencyStatus;
  isBaseCurrency?: boolean; // Can be a system's base, e.g., USD, EUR
  description?: string;
  __typename?: "Currency";
}

export interface ExchangeRate {
  id: string;
  fromCurrency: Currency;
  toCurrency: Currency;
  rate: number; // 1 FromCurrency = rate ToCurrency
  bidRate: number; // Rate bank buys at
  askRate: number; // Rate bank sells at
  lastUpdated: string; // ISO 8601 string
  source: string; // e.g., "ECB", "Reuters", "InternalTradingDesk"
  __typename?: "ExchangeRate";
}

export interface AccountCurrency {
  accountId: string;
  currency: Currency;
  balance: number;
  availableBalance: number;
  holdingsValueUSD: number; // Value converted to a common base for reporting
  __typename?: "AccountCurrency";
}

export interface UserPreferences {
  id: string;
  userId: string;
  preferredDisplayCurrency: Currency;
  favoriteCurrencies: Currency[];
  emailNotificationsEnabled: boolean;
  smsNotificationsEnabled: boolean;
  locale: string;
  theme: "light" | "dark";
  __typename?: "UserPreferences";
}

export interface HistoricalRate {
  date: string; // YYYY-MM-DD
  rate: number;
  __typename?: "HistoricalRate";
}

export interface ExchangeTransaction {
  id: string;
  userId: string;
  accountId: string;
  fromCurrency: Currency;
  toCurrency: Currency;
  amountFrom: number;
  amountTo: number;
  exchangeRate: number; // Rate at time of transaction
  fee: number;
  status: "PENDING" | "COMPLETED" | "FAILED" | "CANCELLED";
  timestamp: string;
  referenceNumber: string;
  __typename?: "ExchangeTransaction";
}

export interface AuditLogEntry {
  id: string;
  timestamp: string;
  userId: string;
  action: AuditLogAction;
  details: string; // JSON string or detailed message
  ipAddress: string;
  __typename?: "AuditLogEntry";
}

export interface ComplianceReport {
  id: string;
  reportName: string;
  generatedBy: string;
  generationDate: string;
  parameters: string; // JSON string of report parameters
  status: "GENERATED" | "PENDING" | "FAILED";
  downloadUrl: string;
  __typename?: "ComplianceReport";
}

export interface UserProfile {
  id: string;
  username: string;
  email: string;
  role: UserRole;
  isActive: boolean;
  lastLogin: string;
  __typename?: "UserProfile";
}

