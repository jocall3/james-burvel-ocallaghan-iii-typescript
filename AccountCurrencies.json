// --- GraphQL Definitions ---
// The original query from the JSON file:
export const GET_ACCOUNT_CURRENCIES = gql`
  query AccountCurrencies($accountId: ID!) {
    accountCurrencies(accountId: $accountId) {
      currencies {
        code
        name
        symbol
        country
        status
        isBaseCurrency
        description
        __typename
      }
      primaryCurrency {
        code
        name
        symbol
        country
        status
        isBaseCurrency
        description
        __typename
      }
      holdings {
        currency {
          code
          name
          symbol
        }
        balance
        availableBalance
        holdingsValueUSD
        __typename
      }
      __typename
    }
  }
`;

export const GET_ALL_CURRENCIES = gql`
  query AllCurrencies {
    allCurrencies {
      code
      name
      symbol
      country
      status
      isBaseCurrency
      description
      __typename
    }
  }
`;

export const GET_EXCHANGE_RATES = gql`
  query ExchangeRates($fromCurrencyCode: String, $toCurrencyCode: String) {
    exchangeRates(
      fromCurrencyCode: $fromCurrencyCode
      toCurrencyCode: $toCurrencyCode
    ) {
      id
      fromCurrency {
        code
        name
        symbol
      }
      toCurrency {
        code
        name
        symbol
      }
      rate
      bidRate
      askRate
      lastUpdated
      source
      __typename
    }
  }
`;

