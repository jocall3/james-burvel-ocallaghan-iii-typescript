const allMessages: Record<string, Record<string, string>> = {
  "en-US": messages_enUS,
  "es-ES": messages_esES,
  // Add more locales as needed
};

export const LocaleProvider: React.FC<{ children: React.ReactNode }> = ({
  children,
}) => {
  const [locale, setLocale] = useState<string>("en-US");
  const [messages, setMessages] = useState<Record<string, string>>(
    allMessages["en-US"]
  );

  useEffect(() => {
    // Attempt to load locale from user preferences or localStorage
    const savedLocale = localStorage.getItem("appLocale");
    if (savedLocale && allMessages[savedLocale]) {
      setLocale(savedLocale);
      setMessages(allMessages[savedLocale]);
    }
  }, []);

  const changeLocale = useCallback((newLocale: string) => {
    if (allMessages[newLocale]) {
      setLocale(newLocale);
      setMessages(allMessages[newLocale]);
      localStorage.setItem("appLocale", newLocale);
    } else {
      console.warn(`Locale ${newLocale} not supported.`);
    }
  }, []);

  const contextValue = useMemo(
    () => ({ locale, setLocale: changeLocale, messages }),
    [locale, changeLocale, messages]
  );

  return (
    <LocaleContext.Provider value={contextValue}>
      {children}
    </LocaleContext.Provider>
  );
};

export const useLocale = () => {
  const context = useContext(LocaleContext);
  if (!context) {
    throw new Error("useLocale must be used within a LocaleProvider");
  }
  return context;
};

// --- Custom Hooks ---

/**
 * useNotifications: Manages application-wide user notifications (toasts/banners).
 */
export interface Notification {
  id: string;
  message: string;
  type: "success" | "error" | "info" | "warning";
  timestamp: Date;
  duration?: number; // ms
}

interface NotificationContextType {
  notifications: Notification[];
  addNotification: (
    message: string,
    type: Notification["type"],
    duration?: number
  ) => void;
  removeNotification: (id: string) => void;
}

export const NotificationContext = createContext<
  NotificationContextType | undefined
>(undefined);

export const NotificationProvider: React.FC<{ children: React.ReactNode }> = ({
  children,
}) => {
  const [notifications, setNotifications] = useState<Notification[]>([]);

  const addNotification = useCallback(
    (message: string, type: Notification["type"], duration: number = 5000) => {
      const id = generateUniqueId("notif");
      const newNotification: Notification = {
        id,
        message,
        type,
        timestamp: new Date(),
        duration,
      };
      setNotifications((prev) => [...prev, newNotification]);

      if (duration > 0) {
        setTimeout(() => removeNotification(id), duration);
      }
    },
    []
  );

  const removeNotification = useCallback((id: string) => {
    setNotifications((prev) => prev.filter((n) => n.id !== id));
  }, []);

  const contextValue = useMemo(
    () => ({ notifications, addNotification, removeNotification }),
    [notifications, addNotification, removeNotification]
  );

  return (
    <NotificationContext.Provider value={contextValue}>
      {children}
    </NotificationContext.Provider>
  );
};

export const useNotifications = () => {
  const context = useContext(NotificationContext);
  if (!context) {
    throw new Error(
      "useNotifications must be used within a NotificationProvider"
    );
  }
  return context;
};

/**
 * useRealtimeExchangeRates: Fetches and updates exchange rates periodically.
 */
export const useRealtimeExchangeRates = (
  fromCode?: string,
  toCode?: string
) => {
  const {
    data,
    loading,
    error,
    refetch,
    networkStatus,
  } = useQuery<{ exchangeRates: ExchangeRate[] }>(GET_EXCHANGE_RATES, {
    variables: { fromCurrencyCode: fromCode, toCurrencyCode: toCode },
    pollInterval: AppConfig.EXCHANGE_RATE_REFRESH_INTERVAL_MS,
    notifyOnNetworkStatusChange: true, // Useful for showing refetching status
    fetchPolicy: "network-only", // Always get fresh data
  });

  const isRefetching = networkStatus === NetworkStatus.poll;

  useEffect(() => {
    if (error) {
      console.error("Error fetching real-time exchange rates:", error);
    }
  }, [error]);

  return {
    rates: data?.exchangeRates || [],
    loading,
    error,
    refetch,
    isRefetching,
  };
};

