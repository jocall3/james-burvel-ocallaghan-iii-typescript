// --- Utility Functions ---
/**
 * Formats a currency value for display, including symbol and precision.
 * @param value The numeric value to format.
 * @param currencyCode The ISO 4217 currency code (e.g., 'USD', 'EUR').
 * @param locale The locale string (e.g., 'en-US').
 * @param precision Optional number of decimal places.
 * @returns Formatted currency string.
 */
export function formatCurrency(
  value: number,
  currencyCode: string,
  locale: string = "en-US",
  precision?: number
): string {
  try {
    return new Intl.NumberFormat(locale, {
      style: "currency",
      currency: currencyCode,
      minimumFractionDigits: precision ?? AppConfig.DEFAULT_CURRENCY_PRECISION,
      maximumFractionDigits: precision ?? AppConfig.DEFAULT_CURRENCY_PRECISION,
    }).format(value);
  } catch (e) {
    console.error(`Error formatting currency ${value} ${currencyCode}:`, e);
    return `${currencyCode} ${value.toFixed(
      AppConfig.DEFAULT_CURRENCY_PRECISION
    )}`;
  }
}

/**
 * Formats a date into a user-friendly string.
 * @param date The Date object or string to format.
 * @param locale The locale string (e.g., 'en-US').
 * @returns Formatted date string.
 */
export function formatDate(
  date: Date | string,
  locale: string = "en-US"
): string {
  const d = typeof date === "string" ? new Date(date) : date;
  return new Intl.DateTimeFormat(locale, {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
  }).format(d);
}

/**
 * Generates a unique ID for UI elements.
 * @returns A unique string ID.
 */
export function generateUniqueId(prefix: string = "id"): string {
  return `${prefix}-${Math.random().toString(36).substr(2, 9)}`;
}

/**
 * Debounces a function call.
 * @param func The function to debounce.
 * @param delay The delay in milliseconds.
 * @returns A debounced version of the function.
 */
export function debounce<T extends (...args: any[]) => void>(
  func: T,
  delay: number
): T {
  let timeout: NodeJS.Timeout;
  return ((...args: Parameters<T>) => {
    clearTimeout(timeout);
    timeout = setTimeout(() => func(...args), delay);
  }) as T;
}

