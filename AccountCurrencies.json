/**
 * CurrencyDashboard: Displays user's account holdings and primary currency.
 */
export const CurrencyDashboard: React.FC = () => {
  const { currentUser, isAuthenticated } = useAuth();
  const { addNotification } = useNotifications();
  const { messages, locale } = useLocale();
  const accountId = currentUser?.id; // Assuming user ID is account ID for simplicity

  const { data, loading, error, refetch } = useQuery<{
    accountCurrencies: {
      currencies: Currency[];
      primaryCurrency: Currency;
      holdings: AccountCurrency[];
    };
  }>(GET_ACCOUNT_CURRENCIES, {
    variables: { accountId },
    skip: !isAuthenticated || !accountId,
    fetchPolicy: "cache-and-network",
    onError: (err) => {
      addNotification(`${messages["error.fetch"]} ${err.message}`, "error");
    },
  });

  useEffect(() => {
    if (!isAuthenticated) return;
    const interval = setInterval(() => {
      refetch(); // Refresh data periodically
    }, AppConfig.EXCHANGE_RATE_REFRESH_INTERVAL_MS * 2); // Less frequent than exchange rates
    return () => clearInterval(interval);
  }, [isAuthenticated, refetch]);

  if (!isAuthenticated) {
    return (
      <div className="page-container dashboard-section">
        <h2>{messages["dashboard.welcome"]}</h2>
        <p>Please log in to view your account currencies and holdings.</p>
      </div>
    );
  }

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorDisplay error={error} />;
  if (!data?.accountCurrencies)
    return <ErrorDisplay message="No account currency data available." />;

  const { currencies, primaryCurrency, holdings } = data.accountCurrencies;

  return (
    <div className="page-container dashboard-section">
      <h2 className="section-title">{messages["dashboard.welcome"]}</h2>
      <p>
        Your primary display currency is:{" "}
        <strong>
          {primaryCurrency?.name} ({primaryCurrency?.code})
        </strong>
      </p>

      <h3 className="sub-section-title">
        {messages["dashboard.currentHoldings"]}
      </h3>
      <div className="currency-holdings-grid">
        {holdings.length === 0 && (
          <p>No currency holdings found for this account.</p>
        )}
        {holdings.map((holding) => (
          <div key={holding.currency.code} className="holding-card">
            <div className="holding-header">
              <span className="holding-symbol">{holding.currency.symbol}</span>
              <h4 className="holding-currency-name">
                {holding.currency.name} ({holding.currency.code})
              </h4>
            </div>
            <p className="holding-balance">
              {messages["currency.balance"]}:{" "}
              <strong>
                {formatCurrency(holding.balance, holding.currency.code, locale)}
              </strong>
            </p>
            <p className="holding-available">
              {messages["currency.available"]}:{" "}
              <strong>
                {formatCurrency(
                  holding.availableBalance,
                  holding.currency.code,
                  locale
                )}
              </strong>
            </p>
            <p className="holding-value-usd">
              {messages["currency.valueUSD"]}:{" "}
              <strong>
                {formatCurrency(holding.holdingsValueUSD, "USD", locale)}
              </strong>
            </p>
          </div>
        ))}
      </div>

      <h3 className="sub-section-title">Available Currencies in System</h3>
      <div className="currency-list-compact">
        {currencies.map((c) => (
          <span key={c.code} className="currency-tag">
            {c.name} ({c.code}) {c.symbol}
          </span>
        ))}
      </div>
    </div>
  );
};

/**
 * CurrencyExchangeWidget: Component for performing currency exchanges.
 */
export const CurrencyExchangeWidget: React.FC = () => {
  const { currentUser, isAuthenticated } = useAuth();
  const { addNotification } = useNotifications();
  const { messages, locale } = useLocale();

  const [fromCurrencyCode, setFromCurrencyCode] = useState("USD");
  const [toCurrencyCode, setToCurrencyCode] = useState("EUR");
  const [amountFrom, setAmountFrom] = useState<number | string>("");
  const [exchangeRate, setExchangeRate] = useState<ExchangeRate | null>(null);
  const [amountTo, setAmountTo] = useState<number | string>("");
  const [fee, setFee] = useState(0);

  const {
    rates: allRates,
    loading: ratesLoading,
    error: ratesError,
    isRefetching: ratesRefetching,
  } = useRealtimeExchangeRates();
  const { data: allCurrenciesData } = useQuery<{ allCurrencies: Currency[] }>(
    GET_ALL_CURRENCIES
  );

  const [
    performExchange,
    { loading: exchangeLoading, error: exchangeError },
  ] = useMutation(PERFORM_CURRENCY_EXCHANGE, {
    onCompleted: (data) => {
      addNotification(
        `Exchange ${data.performCurrencyExchange.referenceNumber} completed successfully! You received ${formatCurrency(
          data.performCurrencyExchange.amountTo,
          data.performCurrencyExchange.toCurrency.code,
          locale
        )}.`,
        "success"
      );
      setAmountFrom("");
      setAmountTo("");
      setFee(0);
      // Invalidate cache for account currencies to show updated balances
      client.refetchQueries({
        include: [GET_ACCOUNT_CURRENCIES],
      });
    },
    onError: (err) => {
      addNotification(
        `${messages["notification.error"]}: Failed to perform exchange. ${err.message}`,
        "error"
      );
    },
  });

  const availableCurrencies = allCurrenciesData?.allCurrencies || [];
  const currencyOptions = availableCurrencies.map((c) => ({
    value: c.code,
    label: `${c.name} (${c.code})`,
  }));

  // Update exchange rate when currencies change
  useEffect(() => {
    const rate = allRates.find(
      (r) =>
        r.fromCurrency.code === fromCurrencyCode &&
        r.toCurrency.code === toCurrencyCode
    );
    if (rate) {
      setExchangeRate(rate);
      // Simulate a small transaction fee (e.g., 0.5% of 'from' amount)
      setFee(
        typeof amountFrom === "number" ? amountFrom * 0.005 : 0 // Assuming fixed 0.5% fee
      );
    } else {
      setExchangeRate(null);
      setFee(0);
      setAmountTo("");
    }
  }, [fromCurrencyCode, toCurrencyCode, allRates, amountFrom]);

  // Calculate amountTo when amountFrom or rate changes
  useEffect(() => {
    if (typeof amountFrom === "number" && amountFrom > 0 && exchangeRate) {
      const calculatedAmount = (amountFrom - fee) * exchangeRate.askRate; // Using ask rate for client purchase
      setAmountTo(calculatedAmount);
    } else {
      setAmountTo("");
    }
  }, [amountFrom, exchangeRate, fee]);

  const handleAmountFromChange = useCallback(
    (e: React.ChangeEvent<HTMLInputElement>) => {
      const value = parseFloat(e.target.value);
      setAmountFrom(isNaN(value) ? "" : value);
    },
    []
  );

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (
      !isAuthenticated ||
      !currentUser?.id ||
      !exchangeRate ||
      typeof amountFrom !== "number" ||
      amountFrom <= 0
    ) {
      addNotification("Please ensure all fields are valid.", "warning");
      return;
    }

    if (amountFrom > AppConfig.MAX_TRANSACTION_VALUE) {
      addNotification(
        `Transaction amount exceeds the maximum allowed ${formatCurrency(
          AppConfig.MAX_TRANSACTION_VALUE,
          fromCurrencyCode
        )}.`,
        "error"
      );
      return;
    }

    try {
      await performExchange({
        variables: {
          input: {
            userId: currentUser.id,
            accountId: currentUser.id, // Using user ID as account ID for demo
            fromCurrencyCode,
            toCurrencyCode,
            amountFrom,
            exchangeRate: exchangeRate.askRate,
            fee,
          },
        },
      });
    } catch (err) {
      console.error("Exchange mutation failed:", err);
      // Error notification handled by onError callback in useMutation
    }
  };

  const isFormValid =
    isAuthenticated &&
    !!currentUser?.id &&
    !!exchangeRate &&
    typeof amountFrom === "number" &&
    amountFrom > 0 &&
    amountFrom <= AppConfig.MAX_TRANSACTION_VALUE;

  if (!isAuthenticated) {
    return (
      <div className="page-container exchange-section">
        <h2>{messages["exchange.title"]}</h2>
        <p>Please log in to perform currency exchanges.</p>
      </div>
    );
  }

  if (ratesLoading && allRates.length === 0) return <LoadingSpinner />;
  if (ratesError) return <ErrorDisplay error={ratesError} />;

  return (
    <div className="page-container exchange-section">
      <h2 className="section-title">{messages["exchange.title"]}</h2>
      <form onSubmit={handleSubmit} className="exchange-form">
        <div className="form-row">
          <SelectField
            id="from-currency"
            label={messages["exchange.from"]}
            value={fromCurrencyCode}
            onChange={(e) => setFromCurrencyCode(e.target.value)}
            options={currencyOptions}
            required
            disabled={exchangeLoading}
          />
          <SelectField
            id="to-currency"
            label={messages["exchange.to"]}
            value={toCurrencyCode}
            onChange={(e) => setToCurrencyCode(e.target.value)}
            options={currencyOptions}
            required
            disabled={exchangeLoading}
          />
        </div>

        <InputField
          id="amount-from"
          label={messages["exchange.amount"]}
          type="number"
          value={amountFrom}
          onChange={handleAmountFromChange}
          min="0.01"
          step="0.01"
          required
          disabled={exchangeLoading}
          aria-live="polite"
        />

        {exchangeRate ? (
          <div className="exchange-rate-info">
            <p>
              {messages["exchange.rate"]}: 1 {fromCurrencyCode} ={" "}
              <strong>
                {exchangeRate.askRate.toFixed(6)}{" "}
                {exchangeRate.toCurrency.code}
              </strong>
              {ratesRefetching && (
                <span className="rate-refreshing"> (Updating...)</span>
              )}
            </p>
            <p>
              {messages["exchange.bidRate"]}: 1 {fromCurrencyCode} ={" "}
              {exchangeRate.bidRate.toFixed(6)}{" "}
              {exchangeRate.toCurrency.code}
            </p>
            <p className="exchange-fee">
              {messages["exchange.fee"]}:{" "}
              {formatCurrency(fee, fromCurrencyCode, locale)}
            </p>
            <p className="exchange-total-receive">
              {messages["exchange.totalReceive"]}:{" "}
              <strong>
                {formatCurrency(
                  typeof amountTo === "number" ? amountTo : 0,
                  toCurrencyCode,
                  locale
                )}
              </strong>
            </p>
            <p className="exchange-last-updated">
              Last updated: {formatDate(exchangeRate.lastUpdated, locale)} (
              {exchangeRate.source})
            </p>
          </div>
        ) : (
          <p className="warning-message">
            No exchange rate found for the selected pair.
          </p>
        )}

        <Button
          type="submit"
          disabled={!isFormValid || exchangeLoading}
          className="btn-primary exchange-submit-btn"
        >
          {exchangeLoading ? (
            <>
              <LoadingSpinner /> Performing Exchange...
            </>
          ) : (
            messages["exchange.execute"]
          )}
        </Button>

        {exchangeError && <ErrorDisplay error={exchangeError} />}
      </form>
    </div>
  );
};

/**
 * UserPreferencesSettings: Allows users to configure their display preferences.
 */
export const UserPreferencesSettings: React.FC = () => {
  const { currentUser, isAuthenticated } = useAuth();
  const { addNotification } = useNotifications();
  const { messages, locale, setLocale: changeAppLocale } = useLocale();
  const { applyTheme: applyAppTheme } = useTheme();

  const {
    data,
    loading,
    error,
    refetch: refetchPreferences,
  } = useQuery<{ userPreferences: UserPreferences }>(GET_USER_PREFERENCES, {
    variables: { userId: currentUser?.id },
    skip: !isAuthenticated || !currentUser?.id,
    fetchPolicy: "network-only", // Always get fresh preferences
    onError: (err) => {
      addNotification(
        `${messages["error.fetch"]} preferences: ${err.message}`,
        "error"
      );
    },
  });

  const { data: allCurrenciesData } = useQuery<{ allCurrencies: Currency[] }>(
    GET_ALL_CURRENCIES
  );

  const [
    updatePreferences,
    { loading: updateLoading, error: updateError },
  ] = useMutation(UPDATE_USER_PREFERENCES, {
    onCompleted: (result) => {
      addNotification(
        `${messages["notification.success"]}: Preferences updated successfully!`,
        "success"
      );
      // Apply theme and locale immediately after successful update
      applyAppTheme(result.updateUserPreferences.theme);
      changeAppLocale(result.updateUserPreferences.locale);
    },
    onError: (err) => {
      addNotification(
        `${messages["notification.error"]}: Failed to update preferences. ${err.message}`,
        "error"
      );
    },
  });

  const [preferredDisplayCurrency, setPreferredDisplayCurrency] = useState("");
  const [favoriteCurrencies, setFavoriteCurrencies] = useState<string[]>([]);
  const [emailNotificationsEnabled, setEmailNotificationsEnabled] = useState(
    false
  );
  const [smsNotificationsEnabled, setSmsNotificationsEnabled] = useState(false);
  const [userLocale, setUserLocale] = useState("");
  const [userTheme, setUserTheme] = useState<"light" | "dark">("light");

  useEffect(() => {
    if (data?.userPreferences) {
      const prefs = data.userPreferences;
      setPreferredDisplayCurrency(prefs.preferredDisplayCurrency.code);
      setFavoriteCurrencies(prefs.favoriteCurrencies.map((c) => c.code));
      setEmailNotificationsEnabled(prefs.emailNotificationsEnabled);
      setSmsNotificationsEnabled(prefs.smsNotificationsEnabled);
      setUserLocale(prefs.locale);
      setUserTheme(prefs.theme);
      // Sync app theme/locale if they were different
      applyAppTheme(prefs.theme);
      changeAppLocale(prefs.locale);
    }
  }, [data, applyAppTheme, changeAppLocale]);

  const availableCurrencies = allCurrenciesData?.allCurrencies || [];
  const currencyOptions = availableCurrencies.map((c) => ({
    value: c.code,
    label: `${c.name} (${c.code})`,
  }));

  const handleFavoriteChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const options = Array.from(
      e.target.selectedOptions,
      (option) => option.value
    );
    setFavoriteCurrencies(options);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!isAuthenticated || !currentUser?.id) {
      addNotification("You must be logged in to update preferences.", "error");
      return;
    }

    try {
      await updatePreferences({
        variables: {
          input: {
            userId: currentUser.id,
            preferredDisplayCurrencyCode: preferredDisplayCurrency,
            favoriteCurrencyCodes: favoriteCurrencies,
            emailNotificationsEnabled,
            smsNotificationsEnabled,
            locale: userLocale,
            theme: userTheme,
          },
        },
      });
    } catch (err) {
      console.error("Update preferences mutation failed:", err);
      // Error notification handled by onError callback in useMutation
    }
  };

  if (!isAuthenticated) {
    return (
      <div className="page-container preferences-section">
        <h2>{messages["preferences.title"]}</h2>
        <p>Please log in to manage your user preferences.</p>
      </div>
    );
  }

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorDisplay error={error} />;

  return (
    <div className="page-container preferences-section">
      <h2 className="section-title">{messages["preferences.title"]}</h2>
      <form onSubmit={handleSubmit} className="preferences-form">
        <SelectField
          id="preferred-display-currency"
          label={messages["preferences.displayCurrency"]}
          value={preferredDisplayCurrency}
          onChange={(e) => setPreferredDisplayCurrency(e.target.value)}
          options={currencyOptions}
          required
          disabled={updateLoading}
        />

        <div className="form-group">
          <label htmlFor="favorite-currencies">
            {messages["preferences.favoriteCurrencies"]}
          </label>
          <select
            id="favorite-currencies"
            className="form-select"
            multiple
            value={favoriteCurrencies}
            onChange={handleFavoriteChange}
            disabled={updateLoading}
            size={Math.min(5, currencyOptions.length)} // Show up to 5 options
          >
            {currencyOptions.map((option) => (
              <option key={option.value} value={option.value}>
                {option.label}
              </option>
            ))}
          </select>
          <small>Hold Ctrl/Cmd to select multiple.</small>
        </div>

        <CheckboxField
          id="email-notifications"
          label={messages["preferences.emailNotifications"]}
          checked={emailNotificationsEnabled}
          onChange={(e) => setEmailNotificationsEnabled(e.target.checked)}
          disabled={updateLoading}
        />

        <CheckboxField
          id="sms-notifications"
          label={messages["preferences.smsNotifications"]}
          checked={smsNotificationsEnabled}
          onChange={(e) => setSmsNotificationsEnabled(e.target.checked)}
          disabled={updateLoading}
        />

        <SelectField
          id="user-locale"
          label={messages["preferences.locale"]}
          value={userLocale}
          onChange={(e) => setUserLocale(e.target.value)}
          options={[
            { value: "en-US", label: "English (US)" },
            { value: "es-ES", label: "Español (ES)" },
          ]}
          required
          disabled={updateLoading}
        />

        <SelectField
          id="user-theme"
          label={messages["preferences.theme"]}
          value={userTheme}
          onChange={(e) => setUserTheme(e.target.value as "light" | "dark")}
          options={[
            { value: "light", label: "Light" },
            { value: "dark", label: "Dark" },
          ]}
          required
          disabled={updateLoading}
        />

        <Button
          type="submit"
          disabled={!isAuthenticated || updateLoading}
          className="btn-primary"
        >
          {updateLoading ? (
            <>
              <LoadingSpinner /> {messages["button.submit"]}...
            </>
          ) : (
            messages["preferences.save"]
          )}
        </Button>
        {updateError && <ErrorDisplay error={updateError} />}
      </form>
    </div>
  );
};

/**
 * HistoricalRatesChart: Displays historical exchange rate data.
 * This would typically use a charting library like Chart.js or D3.js.
 * For now, it will be a simplified textual display.
 */
export const HistoricalRatesChart: React.FC = () => {
  const { addNotification } = useNotifications();
  const { messages, locale } = useLocale();

  const [fromCurrencyCode, setFromCurrencyCode] = useState("USD");
  const [toCurrencyCode, setToCurrencyCode] = useState("EUR");
  const [startDate, setStartDate] = useState(
    new Date(Date.now() - 30 * 24 * 60 * 60 * 1000)
      .toISOString()
      .split("T")[0]
  ); // 30 days ago
  const [endDate, setEndDate] = useState(
    new Date().toISOString().split("T")[0]
  ); // Today

  const { data: allCurrenciesData } = useQuery<{ allCurrencies: Currency[] }>(
    GET_ALL_CURRENCIES
  );

  const {
    data: historicalData,
    loading,
    error,
    refetch,
  } = useQuery<{ historicalRates: HistoricalRate[] }>(GET_HISTORICAL_RATES, {
    variables: { fromCurrencyCode, toCurrencyCode, startDate, endDate },
    skip: !fromCurrencyCode || !toCurrencyCode || !startDate || !endDate,
    onError: (err) => {
      addNotification(
        `${messages["error.fetch"]} historical rates: ${err.message}`,
        "error"
      );
    },
  });

  const availableCurrencies = allCurrenciesData?.allCurrencies || [];
  const currencyOptions = availableCurrencies.map((c) => ({
    value: c.code,
    label: `${c.name} (${c.code})`,
  }));

  const handleFetchHistory = (e: React.FormEvent) => {
    e.preventDefault();
    if (new Date(startDate) >= new Date(endDate)) {
      addNotification("Start date must be before end date.", "warning");
      return;
    }
    refetch();
  };

  return (
    <div className="page-container history-section">
      <h2 className="section-title">{messages["history.title"]}</h2>
      <form onSubmit={handleFetchHistory} className="history-form">
        <div className="form-row">
          <SelectField
            id="history-from-currency"
            label={messages["exchange.from"]}
            value={fromCurrencyCode}
            onChange={(e) => setFromCurrencyCode(e.target.value)}
            options={currencyOptions}
            required
          />
          <SelectField
            id="history-to-currency"
            label={messages["exchange.to"]}
            value={toCurrencyCode}
            onChange={(e) => setToCurrencyCode(e.target.value)}
            options={currencyOptions}
            required
          />
        </div>
        <div className="form-row">
          <InputField
            id="history-start-date"
            label={messages["history.startDate"]}
            type="date"
            value={startDate}
            onChange={(e) => setStartDate(e.target.value)}
            required
          />
          <InputField
            id="history-end-date"
            label={messages["history.endDate"]}
            type="date"
            value={endDate}
            onChange={(e) => setEndDate(e.target.value)}
            required
          />
        </div>
        <Button type="submit" className="btn-secondary">
          View History
        </Button>
      </form>

      {loading && <LoadingSpinner />}
      {error && <ErrorDisplay error={error} />}

      {historicalData?.historicalRates && (
        <div className="historical-rates-display">
          <h3>
            Historical Rates: {fromCurrencyCode} to {toCurrencyCode}
          </h3>
          {historicalData.historicalRates.length === 0 ? (
            <p>No historical data available for the selected period.</p>
          ) : (
            <>
              {/* This is where a charting library would render a graph.
                For demonstration, we'll just list the data. */}
              <div className="chart-placeholder">
                <p>
                  [Placeholder for a beautiful interactive chart using Chart.js
                  or D3.js]
                </p>
                <img
                  src="https://via.placeholder.com/600x300?text=Historical+Rates+Chart"
                  alt="Historical Rates Chart Placeholder"
                  style={{ maxWidth: "100%", height: "auto" }}
                />
              </div>

              <div className="rate-list">
                <h4>Raw Data:</h4>
                <ul className="unstyled-list">
                  {historicalData.historicalRates.map((hr, index) => (
                    <li key={index}>
                      {hr.date}: 1 {fromCurrencyCode} ={" "}
                      {hr.rate.toFixed(6)} {toCurrencyCode}
                    </li>
                  ))}
                </ul>
              </div>
            </>
          )}
        </div>
      )}
    </div>
  );
};

/**
 * AdminCurrencyManagement: Admin panel for managing currencies.
 */
export const AdminCurrencyManagement: React.FC = () => {
  const { addNotification } = useNotifications();
  const { messages } = useLocale();

  const {
    data,
    loading,
    error,
    refetch,
  } = useQuery<{ allCurrencies: Currency[] }>(GET_ALL_CURRENCIES, {
    fetchPolicy: "network-only", // Always get fresh data for admin
    onError: (err) => {
      addNotification(
        `${messages["error.fetch"]} currencies: ${err.message}`,
        "error"
      );
    },
  });

  const [addCurrencyMutation, { loading: addLoading }] = useMutation(
    ADD_CURRENCY_ADMIN,
    {
      onCompleted: () => {
        addNotification(
          `${messages["notification.success"]}: Currency added.`,
          "success"
        );
        refetch();
      },
      onError: (err) => {
        addNotification(
          `${messages["notification.error"]}: Failed to add currency. ${err.message}`,
          "error"
        );
      },
    }
  );

  const [updateCurrencyMutation, { loading: updateLoading }] = useMutation(
    UPDATE_CURRENCY_ADMIN,
    {
      onCompleted: () => {
        addNotification(
          `${messages["notification.success"]}: Currency updated.`,
          "success"
        );
        refetch();
      },
      onError: (err) => {
        addNotification(
          `${messages["notification.error"]}: Failed to update currency. ${err.message}`,
          "error"
        );
      },
    }
  );

  const [newCurrency, setNewCurrency] = useState<Partial<Currency>>({
    code: "",
    name: "",
    symbol: "",
    country: "",
    status: CurrencyStatus.ACTIVE,
  });
  const [selectedCurrencyCode, setSelectedCurrencyCode] = useState("");
  const [updatedCurrency, setUpdatedCurrency] = useState<Partial<Currency>>({
    code: "",
    name: "",
    symbol: "",
    country: "",
    status: CurrencyStatus.ACTIVE,
  });

  useEffect(() => {
    if (selectedCurrencyCode && data?.allCurrencies) {
      const currency = data.allCurrencies.find(
        (c) => c.code === selectedCurrencyCode
      );
      if (currency) {
        setUpdatedCurrency(currency);
      }
    } else {
      setUpdatedCurrency({
        code: "",
        name: "",
        symbol: "",
        country: "",
        status: CurrencyStatus.ACTIVE,
      });
    }
  }, [selectedCurrencyCode, data?.allCurrencies]);

  const handleAddCurrencySubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newCurrency.code || !newCurrency.name) {
      addNotification("Currency code and name are required.", "warning");
      return;
    }
    await addCurrencyMutation({ variables: { input: newCurrency } });
    setNewCurrency({
      code: "",
      name: "",
      symbol: "",
      country: "",
      status: CurrencyStatus.ACTIVE,
    }); // Clear form
  };

  const handleUpdateCurrencySubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedCurrencyCode || !updatedCurrency.name) {
      addNotification("Select a currency and provide a name.", "warning");
      return;
    }
    await updateCurrencyMutation({
      variables: { code: selectedCurrencyCode, input: updatedCurrency },
    });
  };

  const currencyStatusOptions = Object.values(CurrencyStatus).map((status) => ({
    value: status,
    label: messages[`currency.status.${status}`] || status,
  }));
  const currencySelectOptions = (data?.allCurrencies || []).map((c) => ({
    value: c.code,
    label: `${c.name} (${c.code})`,
  }));

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorDisplay error={error} />;

  return (
    <div className="page-container admin-section">
      <h2 className="section-title">{messages["admin.currencyManagement"]}</h2>

      <div className="admin-card add-currency">
        <h3>{messages["admin.addNewCurrency"]}</h3>
        <form onSubmit={handleAddCurrencySubmit}>
          <InputField
            id="new-currency-code"
            label={messages["currency.code"]}
            value={newCurrency.code || ""}
            onChange={(e) =>
              setNewCurrency({ ...newCurrency, code: e.target.value.toUpperCase() })
            }
            required
            maxLength={3}
            pattern="[A-Z]{3}"
            title="3-letter ISO code (e.g., USD)"
            disabled={addLoading}
          />
          <InputField
            id="new-currency-name"
            label={messages["currency.name"]}
            value={newCurrency.name || ""}
            onChange={(e) => setNewCurrency({ ...newCurrency, name: e.target.value })}
            required
            disabled={addLoading}
          />
          <InputField
            id="new-currency-symbol"
            label="Symbol"
            value={newCurrency.symbol || ""}
            onChange={(e) => setNewCurrency({ ...newCurrency, symbol: e.target.value })}
            disabled={addLoading}
          />
          <InputField
            id="new-currency-country"
            label="Country"
            value={newCurrency.country || ""}
            onChange={(e) => setNewCurrency({ ...newCurrency, country: e.target.value })}
            disabled={addLoading}
          />
          <SelectField
            id="new-currency-status"
            label="Status"
            value={newCurrency.status || CurrencyStatus.ACTIVE}
            onChange={(e) =>
              setNewCurrency({ ...newCurrency, status: e.target.value as CurrencyStatus })
            }
            options={currencyStatusOptions}
            disabled={addLoading}
          />
          <CheckboxField
            id="new-currency-isbase"
            label="Is Base Currency?"
            checked={newCurrency.isBaseCurrency || false}
            onChange={(e) =>
              setNewCurrency({ ...newCurrency, isBaseCurrency: e.target.checked })
            }
            disabled={addLoading}
          />
          <Button type="submit" disabled={addLoading}>
            {addLoading ? "Adding..." : "Add Currency"}
          </Button>
        </form>
      </div>

      <div className="admin-card update-currency">
        <h3>{messages["admin.updateCurrency"]}</h3>
        <form onSubmit={handleUpdateCurrencySubmit}>
          <SelectField
            id="select-currency-to-update"
            label="Select Currency"
            value={selectedCurrencyCode}
            onChange={(e) => setSelectedCurrencyCode(e.target.value)}
            options={currencySelectOptions}
            required
            disabled={updateLoading}
          />
          {selectedCurrencyCode && (
            <>
              <InputField
                id="update-currency-name"
                label={messages["currency.name"]}
                value={updatedCurrency.name || ""}
                onChange={(e) =>
                  setUpdatedCurrency({ ...updatedCurrency, name: e.target.value })
                }
                required
                disabled={updateLoading}
              />
              <InputField
                id="update-currency-symbol"
                label="Symbol"
                value={updatedCurrency.symbol || ""}
                onChange={(e) =>
                  setUpdatedCurrency({ ...updatedCurrency, symbol: e.target.value })
                }
                disabled={updateLoading}
              />
              <InputField
                id="update-currency-country"
                label="Country"
                value={updatedCurrency.country || ""}
                onChange={(e) =>
                  setUpdatedCurrency({ ...updatedCurrency, country: e.target.value })
                }
                disabled={updateLoading}
              />
              <SelectField
                id="update-currency-status"
                label="Status"
                value={updatedCurrency.status || CurrencyStatus.ACTIVE}
                onChange={(e) =>
                  setUpdatedCurrency({ ...updatedCurrency, status: e.target.value as CurrencyStatus })
                }
                options={currencyStatusOptions}
                disabled={updateLoading}
              />
              <CheckboxField
                id="update-currency-isbase"
                label="Is Base Currency?"
                checked={updatedCurrency.isBaseCurrency || false}
                onChange={(e) =>
                  setUpdatedCurrency({ ...updatedCurrency, isBaseCurrency: e.target.checked })
                }
                disabled={updateLoading}
              />
              <Button type="submit" disabled={updateLoading}>
                {updateLoading ? "Updating..." : "Update Currency"}
              </Button>
            </>
          )}
        </form>
      </div>

      <div className="admin-card current-currencies">
        <h3>All Currencies</h3>
        <div className="table-responsive">
          <table className="data-table">
            <thead>
              <tr>
                <th>{messages["currency.code"]}</th>
                <th>{messages["currency.name"]}</th>
                <th>Symbol</th>
                <th>Country</th>
                <th>Status</th>
                <th>Base</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {data?.allCurrencies.map((c) => (
                <tr key={c.code}>
                  <td>{c.code}</td>
                  <td>{c.name}</td>
                  <td>{c.symbol}</td>
                  <td>{c.country}</td>
                  <td>{messages[`currency.status.${c.status}`] || c.status}</td>
                  <td>{c.isBaseCurrency ? "Yes" : "No"}</td>
                  <td>{c.description || "-"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <AdminExchangeRateManagement />
    </div>
  );
};

/**
 * AdminExchangeRateManagement: Nested component for managing exchange rates.
 */
export const AdminExchangeRateManagement: React.FC = () => {
  const { addNotification } = useNotifications();
  const { messages, locale } = useLocale();

  const {
    rates,
    loading: ratesLoading,
    error: ratesError,
    refetch: refetchRates,
  } = useRealtimeExchangeRates(); // This hook also provides refetch

  const { data: allCurrenciesData } = useQuery<{ allCurrencies: Currency[] }>(
    GET_ALL_CURRENCIES
  );

  const [addRateMutation, { loading: addLoading }] = useMutation(
    ADD_EXCHANGE_RATE_ADMIN,
    {
      onCompleted: () => {
        addNotification(
          `${messages["notification.success"]}: Exchange rate added.`,
          "success"
        );
        refetchRates();
      },
      onError: (err) => {
        addNotification(
          `${messages["notification.error"]}: Failed to add exchange rate. ${err.message}`,
          "error"
        );
      },
    }
  );

  const [updateRateMutation, { loading: updateLoading }] = useMutation(
    UPDATE_EXCHANGE_RATE_ADMIN,
    {
      onCompleted: () => {
        addNotification(
          `${messages["notification.success"]}: Exchange rate updated.`,
          "success"
        );
        refetchRates();
      },
      onError: (err) => {
        addNotification(
          `${messages["notification.error"]}: Failed to update exchange rate. ${err.message}`,
          "error"
        );
      },
    }
  );

  const [newRate, setNewRate] = useState<{
    from: string;
    to: string;
    rate: number | "";
    bidRate: number | "";
    askRate: number | "";
  }>({ from: "USD", to: "EUR", rate: "", bidRate: "", askRate: "" });

  const [selectedRateId, setSelectedRateId] = useState("");
  const [updatedRate, setUpdatedRate] = useState<{
    rate: number | "";
    bidRate: number | "";
    askRate: number | "";
  }>({ rate: "", bidRate: "", askRate: "" });

  useEffect(() => {
    if (selectedRateId && rates) {
      const rate = rates.find((r) => r.id === selectedRateId);
      if (rate) {
        setUpdatedRate({
          rate: rate.rate,
          bidRate: rate.bidRate,
          askRate: rate.askRate,
        });
      }
    } else {
      setUpdatedRate({ rate: "", bidRate: "", askRate: "" });
    }
  }, [selectedRateId, rates]);

  const currencyOptions = (allCurrenciesData?.allCurrencies || []).map(
    (c) => ({
      value: c.code,
      label: `${c.name} (${c.code})`,
    })
  );
  const rateSelectOptions = rates.map((r) => ({
    value: r.id,
    label: `${r.fromCurrency.code}/${r.toCurrency.code} (${r.rate.toFixed(4)})`,
  }));

  const handleAddRateSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (
      !newRate.from ||
      !newRate.to ||
      newRate.rate === "" ||
      newRate.bidRate === "" ||
      newRate.askRate === ""
    ) {
      addNotification("All new rate fields are required.", "warning");
      return;
    }
    if (newRate.from === newRate.to) {
      addNotification("From and To currencies cannot be the same.", "warning");
      return;
    }
    if (typeof newRate.rate !== "number" || newRate.rate <= 0) {
      addNotification("Rate must be a positive number.", "warning");
      return;
    }
    if (
      typeof newRate.bidRate !== "number" ||
      typeof newRate.askRate !== "number" ||
      newRate.bidRate <= 0 ||
      newRate.askRate <= 0 ||
      newRate.bidRate > newRate.askRate
    ) {
      addNotification("Bid/Ask rates must be positive and Bid <= Ask.", "warning");
      return;
    }

    await addRateMutation({
      variables: {
        input: {
          fromCurrencyCode: newRate.from,
          toCurrencyCode: newRate.to,
          rate: newRate.rate,
          bidRate: newRate.bidRate,
          askRate: newRate.askRate,
          source: "Admin Manual Entry", // Default source
        },
      },
    });
    setNewRate({ from: "USD", to: "EUR", rate: "", bidRate: "", askRate: "" });
  };

  const handleUpdateRateSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (
      !selectedRateId ||
      updatedRate.rate === "" ||
      updatedRate.bidRate === "" ||
      updatedRate.askRate === ""
    ) {
      addNotification("Select a rate and fill all fields.", "warning");
      return;
    }
    if (typeof updatedRate.rate !== "number" || updatedRate.rate <= 0) {
      addNotification("Rate must be a positive number.", "warning");
      return;
    }
    if (
      typeof updatedRate.bidRate !== "number" ||
      typeof updatedRate.askRate !== "number" ||
      updatedRate.bidRate <= 0 ||
      updatedRate.askRate <= 0 ||
      updatedRate.bidRate > updatedRate.askRate
    ) {
      addNotification("Bid/Ask rates must be positive and Bid <= Ask.", "warning");
      return;
    }

    await updateRateMutation({
      variables: {
        id: selectedRateId,
        input: updatedRate,
      },
    });
  };

  if (ratesLoading && !rates.length) return <LoadingSpinner />;
  if (ratesError) return <ErrorDisplay error={ratesError} />;

  return (
    <div className="admin-card exchange-rate-management">
      <h3>{messages["admin.exchangeRateManagement"]}</h3>

      <div className="admin-sub-card">
        <h4>{messages["admin.addNewRate"]}</h4>
        <form onSubmit={handleAddRateSubmit}>
          <div className="form-row">
            <SelectField
              id="new-rate-from"
              label={messages["exchange.from"]}
              value={newRate.from}
              onChange={(e) => setNewRate({ ...newRate, from: e.target.value })}
              options={currencyOptions}
              required
              disabled={addLoading}
            />
            <SelectField
              id="new-rate-to"
              label={messages["exchange.to"]}
              value={newRate.to}
              onChange={(e) => setNewRate({ ...newRate, to: e.target.value })}
              options={currencyOptions}
              required
              disabled={addLoading}
            />
          </div>
          <InputField
            id="new-rate-value"
            label="Mid Rate (1 From = X To)"
            type="number"
            step="0.000001"
            min="0.000001"
            value={newRate.rate}
            onChange={(e) =>
              setNewRate({ ...newRate, rate: parseFloat(e.target.value) || "" })
            }
            required
            disabled={addLoading}
          />
          <InputField
            id="new-rate-bid"
            label="Bid Rate (Bank Buys From)"
            type="number"
            step="0.000001"
            min="0.000001"
            value={newRate.bidRate}
            onChange={(e) =>
              setNewRate({ ...newRate, bidRate: parseFloat(e.target.value) || "" })
            }
            required
            disabled={addLoading}
          />
          <InputField
            id="new-rate-ask"
            label="Ask Rate (Bank Sells To)"
            type="number"
            step="0.000001"
            min="0.000001"
            value={newRate.askRate}
            onChange={(e) =>
              setNewRate({ ...newRate, askRate: parseFloat(e.target.value) || "" })
            }
            required
            disabled={addLoading}
          />
          <Button type="submit" disabled={addLoading}>
            {addLoading ? "Adding..." : "Add Rate"}
          </Button>
        </form>
      </div>

      <div className="admin-sub-card">
        <h4>{messages["admin.updateRate"]}</h4>
        <form onSubmit={handleUpdateRateSubmit}>
          <SelectField
            id="select-rate-to-update"
            label="Select Rate Pair"
            value={selectedRateId}
            onChange={(e) => setSelectedRateId(e.target.value)}
            options={rateSelectOptions}
            required
            disabled={updateLoading}
          />
          {selectedRateId && (
            <>
              <InputField
                id="update-rate-value"
                label="Mid Rate"
                type="number"
                step="0.000001"
                min="0.000001"
                value={updatedRate.rate}
                onChange={(e) =>
                  setUpdatedRate({ ...updatedRate, rate: parseFloat(e.target.value) || "" })
                }
                required
                disabled={updateLoading}
              />
              <InputField
                id="update-rate-bid"
                label="Bid Rate"
                type="number"
                step="0.000001"
                min="0.000001"
                value={updatedRate.bidRate}
                onChange={(e) =>
                  setUpdatedRate({ ...updatedRate, bidRate: parseFloat(e.target.value) || "" })
                }
                required
                disabled={updateLoading}
              />
              <InputField
                id="update-rate-ask"
                label="Ask Rate"
                type="number"
                step="0.000001"
                min="0.000001"
                value={updatedRate.askRate}
                onChange={(e) =>
                  setUpdatedRate({ ...updatedRate, askRate: parseFloat(e.target.value) || "" })
                }
                required
                disabled={updateLoading}
              />
              <Button type="submit" disabled={updateLoading}>
                {updateLoading ? "Updating..." : "Update Rate"}
              </Button>
            </>
          )}
        </form>
      </div>

      <div className="admin-sub-card">
        <h4>Current Exchange Rates</h4>
        <div className="table-responsive">
          <table className="data-table">
            <thead>
              <tr>
                <th>From</th>
                <th>To</th>
                <th>Mid Rate</th>
                <th>Bid Rate</th>
                <th>Ask Rate</th>
                <th>Last Updated</th>
                <th>Source</th>
              </tr>
            </thead>
            <tbody>
              {rates.map((r) => (
                <tr key={r.id}>
                  <td>{r.fromCurrency.code}</td>
                  <td>{r.toCurrency.code}</td>
                  <td>{r.rate.toFixed(6)}</td>
                  <td>{r.bidRate.toFixed(6)}</td>
                  <td>{r.askRate.toFixed(6)}</td>
                  <td>{formatDate(r.lastUpdated, locale)}</td>
                  <td>{r.source}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};

/**
 * ComplianceReports: Component for generating and viewing compliance reports.
 */
export const ComplianceReports: React.FC = () => {
  const { currentUser, isAuthenticated, hasRole } = useAuth();
  const { addNotification } = useNotifications();
  const { messages, locale } = useLocale();

  const {
    data,
    loading,
    error,
    refetch,
  } = useQuery<{ complianceReports: ComplianceReport[] }>(
    GET_COMPLIANCE_REPORTS,
    {
      variables: {
        filter: { generatedBy: currentUser?.id },
      },
      skip:
        !isAuthenticated || !currentUser?.id || !hasRole(UserRole.COMPLIANCE_OFFICER),
      fetchPolicy: "network-only",
      onError: (err) => {
        addNotification(
          `${messages["error.fetch"]} compliance reports: ${err.message}`,
          "error"
        );
      },
    }
  );

  const [generateReportMutation, { loading: generateLoading }] = useMutation(
    GENERATE_COMPLIANCE_REPORT,
    {
      onCompleted: () => {
        addNotification(
          `${messages["notification.success"]}: Report generation initiated.`,
          "success"
        );
        refetch();
      },
      onError: (err) => {
        addNotification(
          `${messages["notification.error"]}: Failed to generate report. ${err.message}`,
          "error"
        );
      },
    }
  );

  const [reportName, setReportName] = useState("");
  const [reportType, setReportType] = useState("AML_SUMMARY");
  const [reportPeriodStart, setReportPeriodStart] = useState(
    new Date(Date.now() - 30 * 24 * 60 * 60 * 1000)
      .toISOString()
      .split("T")[0]
  );
  const [reportPeriodEnd, setReportPeriodEnd] = useState(
    new Date().toISOString().split("T")[0]
  );

  const handleGenerateReport = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!reportName || !reportType || !reportPeriodStart || !reportPeriodEnd) {
      addNotification("All report fields are required.", "warning");
      return;
    }
    if (new Date(reportPeriodStart) >= new Date(reportPeriodEnd)) {
      addNotification("Start date must be before end date.", "warning");
      return;
    }
    if (!currentUser?.id) {
      addNotification("User ID not available for report generation.", "error");
      return;
    }

    try {
      await generateReportMutation({
        variables: {
          input: {
            reportName,
            reportType,
            periodStart: reportPeriodStart,
            periodEnd: reportPeriodEnd,
            generatedByUserId: currentUser.id,
            additionalParameters: JSON.stringify({ department: "Compliance" }),
          },
        },
      });
      setReportName("");
    } catch (err) {
      console.error("Generate report mutation failed:", err);
    }
  };

  if (!isAuthenticated || !hasRole(UserRole.COMPLIANCE_OFFICER)) {
    return (
      <div className="page-container compliance-section">
        <h2>{messages["compliance.title"]}</h2>
        <p>
          You must be a {UserRole.COMPLIANCE_OFFICER} to access compliance
          reports.
        </p>
      </div>
    );
  }

  return (
    <div className="page-container compliance-section">
      <h2 className="section-title">{messages["compliance.title"]}</h2>

      <div className="admin-card generate-report">
        <h3>{messages["compliance.generateReport"]}</h3>
        <form onSubmit={handleGenerateReport}>
          <InputField
            id="report-name"
            label={messages["compliance.reportName"]}
            value={reportName}
            onChange={(e) => setReportName(e.target.value)}
            required
            disabled={generateLoading}
          />
          <SelectField
            id="report-type"
            label={messages["compliance.reportType"]}
            value={reportType}
            onChange={(e) => setReportType(e.target.value)}
            options={[
              { value: "AML_SUMMARY", label: "AML Summary Report" },
              { value: "HIGH_VALUE_TRANSACTIONS", label: "High Value Transactions" },
              { value: "CURRENCY_FLOW_ANALYSIS", label: "Currency Flow Analysis" },
            ]}
            required
            disabled={generateLoading}
          />
          <div className="form-row">
            <InputField
              id="report-period-start"
              label={`${messages["compliance.reportPeriod"]} (Start)`}
              type="date"
              value={reportPeriodStart}
              onChange={(e) => setReportPeriodStart(e.target.value)}
              required
              disabled={generateLoading}
            />
            <InputField
              id="report-period-end"
              label={`${messages["compliance.reportPeriod"]} (End)`}
              type="date"
              value={reportPeriodEnd}
              onChange={(e) => setReportPeriodEnd(e.target.value)}
              required
              disabled={generateLoading}
            />
          </div>
          <Button type="submit" disabled={generateLoading}>
            {generateLoading ? "Generating..." : "Generate Report"}
          </Button>
        </form>
      </div>

      <div className="admin-card report-list">
        <h3>Previous Reports</h3>
        {loading && <LoadingSpinner />}
        {error && <ErrorDisplay error={error} />}
        {data?.complianceReports.length === 0 ? (
          <p>No compliance reports found.</p>
        ) : (
          <div className="table-responsive">
            <table className="data-table">
              <thead>
                <tr>
                  <th>{messages["compliance.reportName"]}</th>
                  <th>Generated By</th>
                  <th>{messages["compliance.reportPeriod"]}</th>
                  <th>{messages["compliance.status"]}</th>
                  <th>{messages["compliance.download"]}</th>
                  <th>Generation Date</th>
                </tr>
              </thead>
              <tbody>
                {data?.complianceReports.map((report) => (
                  <tr key={report.id}>
                    <td>{report.reportName}</td>
                    <td>{report.generatedBy}</td>
                    <td>
                      {JSON.parse(report.parameters).periodStart} to{" "}
                      {JSON.parse(report.parameters).periodEnd}
                    </td>
                    <td>
                      <span className={`status-badge status-${report.status.toLowerCase()}`}>
                        {report.status}
                      </span>
                    </td>
                    <td>
                      {report.status === "GENERATED" && (
                        <a
                          href={report.downloadUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="btn-link"
                        >
                          Download
                        </a>
                      )}
                    </td>
                    <td>{formatDate(report.generationDate, locale)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
};

/**
 * AuditLogs: Displays system audit trails for authorized users.
 */
export const AuditLogs: React.FC = () => {
  const { currentUser, isAuthenticated, hasRole } = useAuth();
  const { addNotification } = useNotifications();
  const { messages, locale } = useLocale();

  const [userIdFilter, setUserIdFilter] = useState("");
  const [actionFilter, setActionFilter] = useState("");
  const [startDateFilter, setStartDateFilter] = useState("");
  const [endDateFilter, setEndDateFilter] = useState("");

  const {
    data,
    loading,
    error,
    refetch,
  } = useQuery<{ auditLogs: AuditLogEntry[] }>(GET_AUDIT_LOGS, {
    variables: {
      filter: {
        userId: userIdFilter || undefined,
        action: actionFilter || undefined,
        startDate: startDateFilter || undefined,
        endDate: endDateFilter || undefined,
      },
    },
    skip: !isAuthenticated || !hasRole(UserRole.AUDITOR) && !hasRole(UserRole.ADMIN),
    fetchPolicy: "network-only",
    onError: (err) => {
      addNotification(
        `${messages["error.fetch"]} audit logs: ${err.message}`,
        "error"
      );
    },
  });

  const auditActionOptions = Object.values(AuditLogAction).map((action) => ({
    value: action,
    label: action.replace(/_/g, " "),
  }));

  const handleApplyFilter = (e: React.FormEvent) => {
    e.preventDefault();
    refetch();
  };

  if (!isAuthenticated || (!hasRole(UserRole.AUDITOR) && !hasRole(UserRole.ADMIN))) {
    return (
      <div className="page-container audit-section">
        <h2>{messages["audit.title"]}</h2>
        <p>
          You must be an {UserRole.AUDITOR} or {UserRole.ADMIN} to access
          audit logs.
        </p>
      </div>
    );
  }

  return (
    <div className="page-container audit-section">
      <h2 className="section-title">{messages["audit.title"]}</h2>

      <div className="filter-panel admin-card">
        <h3>Filter Audit Logs</h3>
        <form onSubmit={handleApplyFilter}>
          <InputField
            id="audit-filter-userid"
            label={messages["audit.user"]}
            value={userIdFilter}
            onChange={(e) => setUserIdFilter(e.target.value)}
          />
          <SelectField
            id="audit-filter-action"
            label={messages["audit.action"]}
            value={actionFilter}
            onChange={(e) => setActionFilter(e.target.value)}
            options={[{ value: "", label: "All Actions" }, ...auditActionOptions]}
          />
          <InputField
            id="audit-filter-startdate"
            label="Start Date"
            type="date"
            value={startDateFilter}
            onChange={(e) => setStartDateFilter(e.target.value)}
          />
          <InputField
            id="audit-filter-enddate"
            label="End Date"
            type="date"
            value={endDateFilter}
            onChange={(e) => setEndDateFilter(e.target.value)}
          />
          <Button type="submit" className="btn-secondary">
            Apply Filters
          </Button>
        </form>
      </div>

      <div className="admin-card audit-log-list">
        <h3>Recent Audit Entries</h3>
        {loading && <LoadingSpinner />}
        {error && <ErrorDisplay error={error} />}
        {data?.auditLogs.length === 0 ? (
          <p>No audit logs found matching the criteria.</p>
        ) : (
          <div className="table-responsive">
            <table className="data-table">
              <thead>
                <tr>
                  <th>{messages["audit.timestamp"]}</th>
                  <th>{messages["audit.user"]}</th>
                  <th>{messages["audit.action"]}</th>
                  <th>{messages["audit.details"]}</th>
                  <th>IP Address</th>
                </tr>
              </thead>
              <tbody>
                {data?.auditLogs.map((log) => (
                  <tr key={log.id}>
                    <td>{formatDate(log.timestamp, locale)}</td>
                    <td>{log.userId}</td>
                    <td>{log.action.replace(/_/g, " ")}</td>
                    <td>{log.details}</td>
                    <td>{log.ipAddress}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
};

// --- Main Application Component ---
/**
 * AccountCurrenciesApp: The root component for the entire currency management application.
 * It sets up context providers, routing, and integrates all major features.
 */
export const AccountCurrenciesApp: React.FC = () => {
  return (
    // ApolloProvider wraps the entire app to enable GraphQL access
    <ApolloProvider client={client}>
      {/* BrowserRouter for client-side routing */}
      <Router>
        {/* All global contexts are provided here */}
        <AuthProvider>
          <ThemeProvider>
            <LocaleProvider>
              <NotificationProvider>
                <NotificationBanner />
                <div className="app-container">
                  <AppHeader />
                  <main className="app-main-content">
                    <Routes>
                      {/* Public Routes */}
                      <Route path="/login" element={<LoginPage />} />
                      <Route
                        path="/unauthorized"
                        element={<UnauthorizedPage />}
                      />
                      {/* Protected Routes */}
                      <Route
                        path="/"
                        element={
                          <PrivateRoute roles={[UserRole.CLIENT, UserRole.ADMIN, UserRole.COMPLIANCE_OFFICER, UserRole.AUDITOR, UserRole.SUPPORT]}>
                            <CurrencyDashboard />
                          </PrivateRoute>
                        }
                      />
                      <Route
                        path="/exchange"
                        element={
                          <PrivateRoute roles={[UserRole.CLIENT, UserRole.ADMIN, UserRole.SUPPORT]}>
                            <CurrencyExchangeWidget />
                          </PrivateRoute>
                        }
                      />
                      <Route
                        path="/preferences"
                        element={
                          <PrivateRoute roles={[UserRole.CLIENT, UserRole.ADMIN, UserRole.SUPPORT]}>
                            <UserPreferencesSettings />
                          </PrivateRoute>
                        }
                      />
                      <Route
                        path="/history"
                        element={
                          <PrivateRoute roles={[UserRole.CLIENT, UserRole.ADMIN, UserRole.SUPPORT]}>
                            <HistoricalRatesChart />
                          </PrivateRoute>
                        }
                      />
                      <Route
                        path="/admin"
                        element={
                          <PrivateRoute roles={[UserRole.ADMIN]}>
                            <AdminCurrencyManagement />
                          </PrivateRoute>
                        }
                      />
                      <Route
                        path="/compliance"
                        element={
                          <PrivateRoute roles={[UserRole.ADMIN, UserRole.COMPLIANCE_OFFICER]}>
                            <ComplianceReports />
                          </PrivateRoute>
                        }
                      />
                      <Route
                        path="/audit"
                        element={
                          <PrivateRoute roles={[UserRole.ADMIN, UserRole.AUDITOR]}>
                            <AuditLogs />
                          </PrivateRoute>
                        }
                      />
                      {/* Fallback for unknown routes */}
                      <Route
                        path="*"
                        element={
                          <div className="page-container">
                            <h1>404 - Page Not Found</h1>
                            <p>The page you are looking for does not exist.</p>
                            <Link to="/">Go to Dashboard</Link>
                          </div>
                        }
                      />
                    </Routes>
                  </main>
                  <AppFooter />
                </div>
              </NotificationProvider>
            </LocaleProvider>
          </ThemeProvider>
        </AuthProvider>
      </Router>
    </ApolloProvider>
  );
};

