// --- Data Models (based on GraphQL schema) ---
export interface PageInfo {
  startCursor: string;
  endCursor: string;
  hasNextPage: boolean;
  hasPreviousPage: boolean;
  __typename: 'PageInfo';
}

export interface InternalAccount {
  typename: 'InternalAccount';
  vendorId: string;
  id: string;
  bestName: string;
  childrenCount: number;
  prettyChildrenCount: string; // "3 sub-accounts"
  bankName: string;
  currency: string;
  operationalStatus: (typeof APP_CONFIG.ACCOUNT_OPERATIONAL_STATUSES)[number];
  parentAccountName?: string;
  updatedAt: string; // ISO string date
  path: string; // e.g., "Holding Company > Subsidiary Bank > Branch 1 > Account Group A"
  // Expanded fields for a real app
  accountType: (typeof APP_CONFIG.INTERNAL_ACCOUNT_TYPES)[number];
  balance: number;
  availableBalance: number;
  iban?: string;
  swiftCode?: string;
  branchAddress?: string;
  accountManagerId?: string;
  accountManagerName?: string;
  openedDate: string;
  metadata?: Record<string, any>;
  linkedAccountIds?: string[]; // e.g., for related accounts or credit lines
  securityLevel: 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL';
  kycStatus: 'COMPLETED' | 'PENDING' | 'REQUIRED' | 'FAILED';
  lastActivityDate: string;
  dailyTransactionLimit?: number;
  monthlyTransactionLimit?: number;
  dailyTransferLimit?: number;
  riskScore: number; // 0-100
  fraudStatus: 'CLEAN' | 'REVIEW' | 'FLAGGED' | 'RESOLVED';
  interestRate?: number;
  fees?: { type: string, amount: number }[];
  creditLimit?: number; // For Credit Card accounts
  nextReviewDate?: string;
}

export interface InternalAccountEdge {
  node: InternalAccount;
  __typename: 'InternalAccountEdge';
}

export interface InternalAccountConnection {
  edges: InternalAccountEdge[];
  pageInfo: PageInfo;
  __typename: 'InternalAccountConnection';
}

export interface GraphQLResponse<T> {
  data: T;
  errors?: any[];
}

export interface AccountGroupAccountsQuery {
  internalAccounts: InternalAccountConnection;
}

