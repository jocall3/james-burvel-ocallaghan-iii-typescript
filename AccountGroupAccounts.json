  currentBalance: number;
  referenceNumber: string;
  merchantName?: string;
  category?: string;
  status: 'COMPLETED' | 'PENDING' | 'REVERSED' | 'FAILED' | 'DECLINED';
  source?: string; // e.g., "Online Banking", "ATM", "POS"
  destination?: string;
  tags?: string[];
  attachments?: { url: string, name: string }[];
}

export interface Statement {
  id: string;
