// Mock GraphQL Client for the original query
export const mockGraphQLClient = {
  query: async <T>(query: string, variables: Record<string, any>): Promise<GraphQLResponse<T>> => {
    // Simulate network delay
    await new Promise(resolve => setTimeout(resolve, Math.random() * 500 + 300));

    if (query.includes('query AccountGroupAccounts')) {
      const { first, after, accountGroupIds, accountSearchName, currency, activeOnly, operationalStatuses } = variables;

      let filteredAccounts = MOCK_ACCOUNTS;

      if (accountGroupIds && accountGroupIds.length > 0) {
        filteredAccounts = filteredAccounts.filter(acc =>
          accountGroupIds.some((groupId: string) => acc.path.includes(groupId))
        );
      }
      if (accountSearchName) {
        const searchLower = accountSearchName.toLowerCase();
        filteredAccounts = filteredAccounts.filter(acc =>
          acc.bestName.toLowerCase().includes(searchLower) ||
          acc.id.toLowerCase().includes(searchLower) ||
          acc.bankName.toLowerCase().includes(searchLower)
        );
      }
      if (currency) {
        filteredAccounts = filteredAccounts.filter(acc => acc.currency === currency);
      }
      if (activeOnly) {
        filteredAccounts = filteredAccounts.filter(acc => acc.operationalStatus === 'ACTIVE');
      }
      if (operationalStatuses && operationalStatuses.length > 0) {
        filteredAccounts = filteredAccounts.filter(acc => operationalStatuses.includes(acc.operationalStatus));
      }

      // Pagination logic
      const pageSize = first || APP_CONFIG.ACCOUNTS_PER_PAGE;
      let startIndex = 0;
      if (after) {
        const lastId = Buffer.from(after, 'base64').toString('ascii');
        const lastIndex = filteredAccounts.findIndex(acc => acc.id === lastId);
        if (lastIndex !== -1) {
          startIndex = lastIndex + 1;
        }
      }

      const pagedAccounts = filteredAccounts.slice(startIndex, startIndex + pageSize);

      const hasNextPage = filteredAccounts.length > startIndex + pageSize;
      const hasPreviousPage = startIndex > 0; // Simplified
      const startCursor = pagedAccounts.length > 0 ? Buffer.from(pagedAccounts[0].id).toString('base64') : '';
      const endCursor = pagedAccounts.length > 0 ? Buffer.from(pagedAccounts[pagedAccounts.length - 1].id).toString('base64') : '';

      return {
        data: {
          internalAccounts: {
            edges: pagedAccounts.map(node => ({ node, __typename: 'InternalAccountEdge' })),
            pageInfo: {
              startCursor,
              endCursor,
              hasNextPage,
              hasPreviousPage,
              __typename: 'PageInfo',
            },
            __typename: 'InternalAccountConnection',
          },
        } as T,
      };
    } else if (query.includes('query AccountDetailsQuery')) { // Mock for fetching single account details
      const accountId = variables.id;
      const account = MOCK_ACCOUNTS.find(acc => acc.id === accountId);
      if (account) {
        return { data: { internalAccount: account } } as T;
      } else {
        return { data: { internalAccount: null }, errors: [{ message: 'Account not found' }] } as T;
      }
    }
    // Add more mock queries as needed for transactions, etc.
    return { data: {} as T, errors: [{ message: 'Unknown query' }] };
  },
};

// Generic GraphQL Hook (simulating Apollo Client's useQuery)
export const useGraphQLQuery = <T, V>(query: string, variables?: V) => {
  const [data, setData] = useState<T | null>(null);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<Error | null>(null);
  const refetchTrigger = useState(0)[1]; // For manual refetch

  const refetch = useCallback(() => refetchTrigger(prev => prev + 1), [refetchTrigger]);

  useEffect(() => {
    setLoading(true);
    setError(null);
    mockGraphQLClient.query<T>(query, variables as Record<string, any>)
      .then(response => {
        if (response.errors) {
          setError(new Error(response.errors.map(err => err.message).join(', ')));
        } else {
          setData(response.data);
        }
      })
      .catch(err => {
        setError(err);
      })
      .finally(() => {
        setLoading(false);
      });
  }, [query, variables, refetchTrigger]);

  return { data, loading, error, refetch };
};

// Services encapsulating API calls and business logic
export class AccountService {
  private static readonly ACCOUNT_GROUP_ACCOUNTS_QUERY = `
    query AccountGroupAccounts($first: Int, $after: String, $last: Int, $before: String, $accountGroupIds: [ID!], $accountSearchName: String, $currency: String, $activeOnly: Boolean, $operationalStatuses: [String!]) {
      internalAccounts(
        first: $first
        after: $after
        last: $last
        before: $before
        accountGroupIds: $accountGroupIds
        accountSearchName: $accountSearchName
        currency: $currency
        activeOnly: $activeOnly
        operationalStatuses: $operationalStatuses
      ) {
        ...InternalAccountList
        __typename
      }
    }

    fragment InternalAccountList on InternalAccountConnection {
      edges {
        node {
          typename: __typename
          vendorId
          id
          bestName
          childrenCount
          prettyChildrenCount
          bankName
          currency
          operationalStatus
          parentAccountName
          updatedAt
          path
          accountType
          balance
          availableBalance
          iban
          swiftCode
          branchAddress
          accountManagerId
          accountManagerName
          openedDate
          securityLevel
          kycStatus
          lastActivityDate
          dailyTransactionLimit
          monthlyTransactionLimit
          dailyTransferLimit
          riskScore
          fraudStatus
          interestRate
          fees { type amount }
          creditLimit
          nextReviewDate
        }
        __typename
      }
      pageInfo {
        startCursor
        endCursor
        hasNextPage
        hasPreviousPage
        __typename
      }
      __typename
    }
  `;

  private static readonly GET_ACCOUNT_DETAILS_QUERY = `
    query AccountDetailsQuery($id: ID!) {
      internalAccount(id: $id) {
        typename: __typename
        vendorId
        id
        bestName
        childrenCount
        prettyChildrenCount
        bankName
        currency
        operationalStatus
        parentAccountName
        updatedAt
        path
        accountType
        balance
        availableBalance
        iban
        swiftCode
        branchAddress
        accountManagerId
        accountManagerName
        openedDate
        securityLevel
        kycStatus
        lastActivityDate
        dailyTransactionLimit
        monthlyTransactionLimit
        dailyTransferLimit
        riskScore
        fraudStatus
        metadata
        linkedAccountIds
        interestRate
        fees { type amount }
        creditLimit
        nextReviewDate
      }
    }
  `;

  static async fetchAccounts(variables: any): Promise<InternalAccountConnection> {
    const response = await mockGraphQLClient.query<AccountGroupAccountsQuery>(
      AccountService.ACCOUNT_GROUP_ACCOUNTS_QUERY,
      variables
    );
    if (response.errors) {
      AuditService.logAction('FETCH_ACCOUNTS_FAILED', 'System', 'N/A', { variables, error: response.errors[0].message }, false, response.errors[0].message);
      throw new Error(response.errors.map(e => e.message).join(', '));
    }
    AuditService.logAction('FETCH_ACCOUNTS_SUCCESS', 'System', 'N/A', { variables }, true);
    return response.data.internalAccounts;
  }

  static async getAccountDetails(accountId: string): Promise<InternalAccount | null> {
    const response = await mockGraphQLClient.query<any>(
      AccountService.GET_ACCOUNT_DETAILS_QUERY,
      { id: accountId }
    );
    if (response.errors) {
      AuditService.logAction('FETCH_ACCOUNT_DETAILS_FAILED', 'Account', accountId, { error: response.errors[0].message }, false, response.errors[0].message);
      throw new Error(response.errors.map(e => e.message).join(', '));
    }
    if (response.data.internalAccount) {
      AuditService.logAction('FETCH_ACCOUNT_DETAILS_SUCCESS', 'Account', accountId, {}, true);
    } else {
      AuditService.logAction('FETCH_ACCOUNT_DETAILS_NOT_FOUND', 'Account', accountId, {}, false, 'Account not found');
    }
    return response.data.internalAccount;
  }

  static async updateAccountStatus(accountId: string, newStatus: string): Promise<InternalAccount> {
    await new Promise(resolve => setTimeout(resolve, 500)); // Simulate API call
    const accountIndex = MOCK_ACCOUNTS.findIndex(acc => acc.id === accountId);
    if (accountIndex !== -1) {
      const oldStatus = MOCK_ACCOUNTS[accountIndex].operationalStatus;
      MOCK_ACCOUNTS[accountIndex].operationalStatus = newStatus;
      MOCK_ACCOUNTS[accountIndex].updatedAt = new Date().toISOString();
      AuditService.logAction('UPDATE_ACCOUNT_STATUS', 'Account', accountId, { oldStatus, newStatus }, true);
      NotificationService.addNotification({ id: generateUniqueId(), type: 'SUCCESS', message: `Account ${MOCK_ACCOUNTS[accountIndex].bestName} status updated to ${newStatus}.`, timestamp: new Date().toISOString(), isRead: false, accountId, priority: 'MEDIUM', sourceSystem: 'AccountService' });
      return MOCK_ACCOUNTS[accountIndex];
    }
    const errorMessage = 'Account not found';
    AuditService.logAction('UPDATE_ACCOUNT_STATUS_FAILED', 'Account', accountId, { newStatus }, false, errorMessage);
    throw new Error(errorMessage);
  }

  static async updateAccountDetails(accountId: string, updates: Partial<InternalAccount>): Promise<InternalAccount> {
    await new Promise(resolve => setTimeout(resolve, 500));
    const accountIndex = MOCK_ACCOUNTS.findIndex(acc => acc.id === accountId);
    if (accountIndex !== -1) {
      const oldAccount = { ...MOCK_ACCOUNTS[accountIndex] };
      MOCK_ACCOUNTS[accountIndex] = { ...MOCK_ACCOUNTS[accountIndex], ...updates, updatedAt: new Date().toISOString() };
      AuditService.logAction('UPDATE_ACCOUNT_DETAILS', 'Account', accountId, { oldValues: oldAccount, newValues: updates }, true);
      NotificationService.addNotification({ id: generateUniqueId(), type: 'SUCCESS', message: `Account ${MOCK_ACCOUNTS[accountIndex].bestName} details updated.`, timestamp: new Date().toISOString(), isRead: false, accountId, priority: 'LOW', sourceSystem: 'AccountService' });
      return MOCK_ACCOUNTS[accountIndex];
    }
    const errorMessage = 'Account not found';
    AuditService.logAction('UPDATE_ACCOUNT_DETAILS_FAILED', 'Account', accountId, { updates }, false, errorMessage);
    throw new Error(errorMessage);
  }

  static async createVirtualCard(accountId: string, limit: number, purpose: string): Promise<VirtualCard> {
    await new Promise(resolve => setTimeout(resolve, 1000));
    const account = MOCK_ACCOUNTS.find(acc => acc.id === accountId);
    if (!account) throw new Error('Account not found for virtual card creation.');

    const newCard: VirtualCard = {
      id: generateUniqueId('VCARD'),
      accountId: accountId,
      cardNumber: `**** **** **** ${Math.floor(1000 + Math.random() * 8999).toString()}`,
      expirationDate: `12/${(new Date().getFullYear() % 100) + 3}`, // Valid for 3 years
      cvv: '***',
      limit: limit,
      spent: 0,
      status: 'ACTIVE',
      purpose: purpose,
      createdAt: new Date().toISOString(),
    };
    MOCK_VIRTUAL_CARDS.push(newCard);
    AuditService.logAction('CREATE_VIRTUAL_CARD', 'Account', accountId, { cardId: newCard.id, limit, purpose }, true);
    NotificationService.addNotification({ id: generateUniqueId(), type: 'SUCCESS', message: `Virtual card for ${account.bestName} (${newCard.purpose}) created.`, timestamp: new Date().toISOString(), isRead: false, accountId, priority: 'MEDIUM', sourceSystem: 'AccountService' });
    return newCard;
  }

  static async fetchVirtualCards(accountId: string): Promise<VirtualCard[]> {
    await new Promise(resolve => setTimeout(resolve, 500));
    return MOCK_VIRTUAL_CARDS.filter(card => card.accountId === accountId);
  }

  static async updateVirtualCardStatus(cardId: string, status: 'ACTIVE' | 'INACTIVE' | 'BLOCKED'): Promise<VirtualCard> {
    await new Promise(resolve => setTimeout(resolve, 500));
    const cardIndex = MOCK_VIRTUAL_CARDS.findIndex(c => c.id === cardId);
    if (cardIndex === -1) throw new Error('Virtual card not found.');
    MOCK_VIRTUAL_CARDS[cardIndex].status = status;
    AuditService.logAction('UPDATE_VIRTUAL_CARD_STATUS', 'Account', MOCK_VIRTUAL_CARDS[cardIndex].accountId, { cardId, newStatus: status }, true);
    NotificationService.addNotification({ id: generateUniqueId(), type: 'INFO', message: `Virtual card ${cardId} status updated to ${status}.`, timestamp: new Date().toISOString(), isRead: false, accountId: MOCK_VIRTUAL_CARDS[cardIndex].accountId, priority: 'MEDIUM', sourceSystem: 'AccountService' });
    return MOCK_VIRTUAL_CARDS[cardIndex];
  }
}

export class TransactionService {
  static async fetchTransactions(accountId: string, page: number = 1, pageSize: number = APP_CONFIG.ACCOUNTS_PER_PAGE, sortBy: keyof Transaction = 'date', sortOrder: 'asc' | 'desc' = 'desc'): Promise<{ transactions: Transaction[], total: number }> {
    await new Promise(resolve => setTimeout(resolve, Math.random() * 300 + 200));
    const accountTransactions = MOCK_TRANSACTIONS.filter(t => t.accountId === accountId);

    // Sort transactions
    const sortedTransactions = [...accountTransactions].sort((a, b) => {
      const aValue = a[sortBy];
      const bValue = b[sortBy];

      if (typeof aValue === 'string' && typeof bValue === 'string') {
        return sortOrder === 'asc' ? aValue.localeCompare(bValue) : bValue.localeCompare(aValue);
      }
      if (typeof aValue === 'number' && typeof bValue === 'number') {
        return sortOrder === 'asc' ? aValue - bValue : bValue - aValue;
      }
      // Fallback for dates or mixed types
      if (sortBy === 'date') {
        return sortOrder === 'asc' ? new Date(a.date).getTime() - new Date(b.date).getTime() : new Date(b.date).getTime() - new Date(a.date).getTime();
      }
      return 0;
    });

    const startIndex = (page - 1) * pageSize;
    const endIndex = startIndex + pageSize;
    AuditService.logAction('FETCH_TRANSACTIONS_SUCCESS', 'Account', accountId, { page, pageSize, sortBy, sortOrder }, true);
    return {
      transactions: sortedTransactions.slice(startIndex, endIndex),
      total: sortedTransactions.length,
    };
  }
}

export class StatementService {
  static async fetchStatements(accountId: string, year?: number, month?: number): Promise<Statement[]> {
    await new Promise(resolve => setTimeout(resolve, Math.random() * 300 + 200));
    const mockStatements: Statement[] = [];
    const currentYear = new Date().getFullYear();
    // Generate some mock statements dynamically for the last 5 years
    for (let y = 0; y < 5; y++) {
      for (let m = 0; m < 12; m++) {
        const statementDate = new Date(currentYear - y, m, 1);
        if ((!year || statementDate.getFullYear() === year) && (!month || statementDate.getMonth() === month - 1)) {
          const periodStart = new Date(statementDate.getFullYear(), statementDate.getMonth(), 1).toISOString();
          const periodEnd = new Date(statementDate.getFullYear(), statementDate.getMonth() + 1, 0).toISOString();
          mockStatements.push({
            id: generateUniqueId('STM'),
            accountId: accountId,
            periodStart,
            periodEnd,
            downloadUrl: `/api/statements/${accountId}/${statementDate.getFullYear()}/${statementDate.getMonth() + 1}.pdf`,
            balanceStart: parseFloat((Math.random() * 100000).toFixed(2)),
            balanceEnd: parseFloat((Math.random() * 100000).toFixed(2)),
            totalCredits: parseFloat((Math.random() * 10000).toFixed(2)),
            totalDebits: parseFloat((Math.random() * 10000).toFixed(2)),
            transactionsCount: Math.floor(Math.random() * 50) + 20,
            format: 'PDF',
            generatedDate: new Date(statementDate.getFullYear(), statementDate.getMonth() + 1, 5).toISOString(),
          });
        }
      }
    }
    AuditService.logAction('FETCH_STATEMENTS_SUCCESS', 'Account', accountId, { year, month }, true);
    return mockStatements.sort((a,b) => new Date(b.periodStart).getTime() - new Date(a.periodStart).getTime());
  }

  static async downloadStatement(url: string, format: 'PDF' | 'CSV' | 'XML' = 'PDF'): Promise<void> {
    await new Promise(resolve => setTimeout(resolve, 1000));
    console.log(`Simulating download for: ${url} (format: ${format})`);
    NotificationService.addNotification({ id: generateUniqueId(), type: 'INFO', message: `Statement download for ${url.split('/').pop()} (${format}) started.`, timestamp: new Date().toISOString(), isRead: false, priority: 'LOW', sourceSystem: 'StatementService' });
    AuditService.logAction('DOWNLOAD_STATEMENT', 'System', 'N/A', { url, format }, true);
    // In a real app, this would trigger a file download.
  }
}

export class TransferService {
  static async initiateTransfer(transfer: Omit<TransferRequest, 'id' | 'status' | 'requestedAt' | 'requestedBy' | 'referenceCode' | 'paymentMethod' | 'priority'>, priority: 'STANDARD' | 'EXPEDITED' | 'URGENT' = 'STANDARD'): Promise<TransferRequest> {
    await new Promise(resolve => setTimeout(resolve, Math.random() * 1000 + 500));

    const fromAccount = MOCK_ACCOUNTS.find(acc => acc.id === transfer.fromAccountId);
    if (!fromAccount) throw new Error('Source account not found.');
    if (fromAccount.balance < transfer.amount) throw new Error('Insufficient funds.');

    const newTransfer: TransferRequest = {
      ...transfer,
      id: generateUniqueId('TRF'),
      status: 'PENDING_APPROVAL', // All transfers require approval in this mock
      requestedAt: new Date().toISOString(),
      requestedBy: MOCK_USERS[1].id, // Mock Bob Manager as current user for transfers
      processingFee: transfer.currency === 'USD' ? 5.00 : 0, // Mock fee
      priority: priority,
      referenceCode: `TRF-${generateUniqueId('')}`,
      paymentMethod: 'ACH', // Default mock
    };

    // Deduct from balance for PENDING transfers (or after approval)
    fromAccount.balance -= newTransfer.amount + (newTransfer.processingFee || 0);

    // In a real system, this would go to a queue for approval
    NotificationService.addNotification({ id: generateUniqueId(), type: 'INFO', message: `Transfer request ${newTransfer.id} submitted for approval.`, timestamp: new Date().toISOString(), isRead: false, accountId: newTransfer.fromAccountId, priority: 'MEDIUM', sourceSystem: 'TransferService' });
    AuditService.logAction('INITIATE_TRANSFER', 'Transfer', newTransfer.id, { ...newTransfer, fromAccountBalanceAfter: fromAccount.balance }, true);
    return newTransfer;
  }
}

export class AlertService {
  static alerts: Alert[] = MOCK_ALERTS; // Use the mock data directly

  static async fetchAlerts(readStatus?: boolean, priority?: Alert['priority']): Promise<Alert[]> {
    await new Promise(resolve => setTimeout(resolve, Math.random() * 300 + 200));
    return AlertService.alerts
      .filter(alert => readStatus === undefined || alert.isRead === readStatus)
      .filter(alert => priority === undefined || alert.priority === priority)
      .sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());
  }

  static async markAlertAsRead(alertId: string): Promise<Alert> {
    await new Promise(resolve => setTimeout(resolve, 200));
    const alert = AlertService.alerts.find(a => a.id === alertId);
    if (alert) {
      alert.isRead = true;
      NotificationService.addNotification({ id: generateUniqueId(), type: 'SUCCESS', message: `Alert ${alert.id} marked as read.`, timestamp: new Date().toISOString(), isRead: false, priority: 'LOW', sourceSystem: 'AlertService' });
      AuditService.logAction('MARK_ALERT_READ', 'System', alertId, {}, true);
      return { ...alert };
    }
    AuditService.logAction('MARK_ALERT_READ_FAILED', 'System', alertId, {}, false, 'Alert not found');
    throw new Error('Alert not found');
  }

  static async markAllAlertsAsRead(): Promise<Alert[]> {
    await new Promise(resolve => setTimeout(resolve, 500));
    AlertService.alerts.forEach(alert => (alert.isRead = true));
    NotificationService.addNotification({ id: generateUniqueId(), type: 'SUCCESS', message: 'All alerts marked as read.', timestamp: new Date().toISOString(), isRead: false, priority: 'LOW', sourceSystem: 'AlertService' });
    AuditService.logAction('MARK_ALL_ALERTS_READ', 'System', 'N/A', {}, true);
    return AlertService.alerts.filter(alert => alert.isRead);
  }
}

