const ALL_TRANSLATIONS: Translations = {
  ...Object.fromEntries(Object.entries(EN_TRANSLATIONS).map(([key, value]) => [key, { en: value }])),
  ...Object.fromEntries(Object.entries(ES_TRANSLATIONS).map(([key, value]) => [key, { ...ALL_TRANSLATIONS[key], es: value }])),
  // This is where FR, DE, ZH_TRANSLATIONS would be expanded, etc.
  // For brevity in this exercise, I'll primarily use English and Spanish for demonstration.
};


export const useTranslation = () => {
  const { language } = useAppContext(); // Get language from context

  const t = useCallback((key: string, variables?: { [key: string]: string | number }) => {
    let translation = ALL_TRANSLATIONS[key]?.[language] || ALL_TRANSLATIONS[key]?.['en'] || key;
    if (variables) {
      for (const [varKey, varValue] of Object.entries(variables)) {
        translation = translation.replace(`{${varKey}}`, String(varValue));
      }
    }
    return translation;
  }, [language]);

  return { t };
};

