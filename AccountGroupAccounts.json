export class UserService {
  static users: UserProfile[] = MOCK_USERS;

  static async fetchUsers(page: number = 1, pageSize: number = APP_CONFIG.ACCOUNTS_PER_PAGE): Promise<{ users: UserProfile[], total: number }> {
    await new Promise(resolve => setTimeout(resolve, Math.random() * 300 + 200));
    const startIndex = (page - 1) * pageSize;
    const endIndex = startIndex + pageSize;
    AuditService.logAction('FETCH_USERS_SUCCESS', 'System', 'N/A', { page, pageSize }, true);
    return {
      users: UserService.users.slice(startIndex, endIndex),
      total: UserService.users.length,
    };
  }

  static async addUser(user: Omit<UserProfile, 'id' | 'lastLogin' | 'permissions'>): Promise<UserProfile> {
    await new Promise(resolve => setTimeout(resolve, 500));
    if (UserService.users.some(u => u.email === user.email)) {
      const errorMessage = `User with email ${user.email} already exists.`;
      AuditService.logAction('ADD_USER_FAILED', 'User', 'N/A', { userDetails: user }, false, errorMessage);
      throw new Error(errorMessage);
    }

    const defaultPermissions = {
      ADMIN: ['canViewAccounts', 'canEditAccountDetails', 'canInitiateTransfers', 'canManageUsers', 'canViewAuditLog', 'canGenerateReports'],
      MANAGER: ['canViewAccounts', 'canInitiateTransfers', 'canViewAuditLog'],
      VIEWER: ['canViewAccounts'],
      AUDITOR: ['canViewAccounts', 'canViewAuditLog', 'canGenerateReports'],
      SUPPORT: ['canViewAccounts', 'canViewTransactions', 'canViewStatements'],
    };

    const newUser: UserProfile = { ...user, id: generateUniqueId('USR'), lastLogin: new Date().toISOString(), permissions: defaultPermissions[user.role], twoFactorEnabled: false };
    UserService.users.push(newUser);
    AuditService.logAction('ADD_USER', 'User', newUser.id, { userDetails: newUser }, true);
    NotificationService.addNotification({ id: generateUniqueId(), type: 'SUCCESS', message: `User ${newUser.name} added successfully.`, timestamp: new Date().toISOString(), isRead: false, priority: 'MEDIUM', sourceSystem: 'UserService' });
    return newUser;
  }

  static async updateUser(userId: string, updates: Partial<Omit<UserProfile, 'id' | 'lastLogin' | 'permissions'>>): Promise<UserProfile> {
    await new Promise(resolve => setTimeout(resolve, 500));
    const userIndex = UserService.users.findIndex(u => u.id === userId);
    if (userIndex !== -1) {
      const oldUser = { ...UserService.users[userIndex] };
      UserService.users[userIndex] = { ...UserService.users[userIndex], ...updates };
      // If role changes, update permissions (simplified logic for mock)
      if (updates.role && oldUser.role !== updates.role) {
        const defaultPermissions = {
          ADMIN: ['canViewAccounts', 'canEditAccountDetails', 'canInitiateTransfers', 'canManageUsers', 'canViewAuditLog', 'canGenerateReports'],
          MANAGER: ['canViewAccounts', 'canInitiateTransfers', 'canViewAuditLog'],
          VIEWER: ['canViewAccounts'],
          AUDITOR: ['canViewAccounts', 'canViewAuditLog', 'canGenerateReports'],
          SUPPORT: ['canViewAccounts', 'canViewTransactions', 'canViewStatements'],
        };
        UserService.users[userIndex].permissions = defaultPermissions[updates.role];
      }
      AuditService.logAction('UPDATE_USER', 'User', userId, { oldValues: oldUser, newValues: updates }, true);
      NotificationService.addNotification({ id: generateUniqueId(), type: 'SUCCESS', message: `User ${UserService.users[userIndex].name} updated successfully.`, timestamp: new Date().toISOString(), isRead: false, priority: 'LOW', sourceSystem: 'UserService' });
      return UserService.users[userIndex];
    }
    const errorMessage = 'User not found';
    AuditService.logAction('UPDATE_USER_FAILED', 'User', userId, { updates }, false, errorMessage);
    throw new Error(errorMessage);
  }

  static async deleteUser(userId: string): Promise<void> {
    await new Promise(resolve => setTimeout(resolve, 500));
    const initialLength = UserService.users.length;
    UserService.users.splice(UserService.users.findIndex(u => u.id === userId), 1);
    if (UserService.users.length === initialLength) {
      const errorMessage = 'User not found';
      AuditService.logAction('DELETE_USER_FAILED', 'User', userId, {}, false, errorMessage);
      throw new Error(errorMessage);
    }
    AuditService.logAction('DELETE_USER', 'User', userId, {}, true);
    NotificationService.addNotification({ id: generateUniqueId(), type: 'SUCCESS', message: `User ${userId} deleted.`, timestamp: new Date().toISOString(), isRead: false, priority: 'MEDIUM', sourceSystem: 'UserService' });
  }

  static async authenticateUser(email: string, passwordAttempt: string): Promise<UserProfile> {
    await new Promise(resolve => setTimeout(resolve, 1000));
    const user = UserService.users.find(u => u.email === email);
    if (!user) {
      AuditService.logAction('LOGIN_FAILED', 'User', 'N/A', { email, reason: 'User not found' }, false, 'Invalid credentials');
      throw new Error('Invalid credentials');
    }
    // Simple password check (in real app, use hashing)
    if (passwordAttempt === 'password123') { // Mock static password for all users
      user.lastLogin = new Date().toISOString();
      AuditService.logAction('LOGIN_SUCCESS', 'User', user.id, { email }, true);
      NotificationService.addNotification({ id: generateUniqueId(), type: 'SUCCESS', message: `Welcome back, ${user.name}!`, timestamp: new Date().toISOString(), isRead: true, priority: 'LOW', sourceSystem: 'AuthService' });
      return user;
    } else {
      AuditService.logAction('LOGIN_FAILED', 'User', user.id, { email, reason: 'Incorrect password' }, false, 'Invalid credentials');
      throw new Error('Invalid credentials');
    }
  }

  static async fetchCurrentUser(): Promise<UserProfile> {
    await new Promise(resolve => setTimeout(resolve, 200));
    return MOCK_USERS[0]; // Always return Alice Admin for mock
  }
}

export class NotificationService {
  static notifications: Alert[] = MOCK_ALERTS; // Keep a local copy

  static getNotifications(unreadOnly: boolean = false): Alert[] {
    return unreadOnly ? NotificationService.notifications.filter(n => !n.isRead) : NotificationService.notifications;
  }

  static addNotification(notification: Alert) {
    NotificationService.notifications.unshift(notification); // Add to beginning
    // In a real app, this would also trigger a UI update (e.g., via a global state store)
  }

  static markAsRead(notificationId: string) {
    const notification = NotificationService.notifications.find(n => n.id === notificationId);
    if (notification) {
      notification.isRead = true;
      AuditService.logAction('MARK_NOTIFICATION_READ', 'System', notificationId, {}, true);
      return true;
    }
    return false;
  }

  // Simulates a subscription for real-time updates (e.g., WebSockets)
  static subscribeToNotifications(callback: (notifications: Alert[]) => void) {
    const interval = setInterval(() => {
      // In a real app, this would push new alerts from the server.
      // Here, we just check if any new mock alerts were added or modified
      const currentAlerts = [...NotificationService.notifications]; // Create a copy
      callback(currentAlerts);
    }, 5000); // Poll every 5 seconds for changes

    return () => clearInterval(interval);
  }
}


// --- Global Application Context ---
interface AppContextType {
  theme: ThemeMode;
  setTheme: (theme: ThemeMode) => void;
  language: string;
  setLanguage: (lang: string) => void;
  currentUser: UserProfile | null;
  setCurrentUser: (user: UserProfile | null) => void;
  notifications: Alert[];
  addNotification: (notification: Alert) => void;
  markNotificationRead: (id: string) => void;
  unreadNotificationCount: number;
  isAuthenticated: boolean;
  logout: () => void;
}

const AppContext = createContext<AppContextType | undefined>(undefined);

export const AppProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [theme, setTheme] = useState<ThemeMode>(() => (localStorage.getItem('app-theme') as ThemeMode) || 'light');
  const [language, setLanguage] = useState(() => localStorage.getItem('app-language') || APP_CONFIG.DEFAULT_LANGUAGE);
  const [notifications, setNotifications] = useState<Alert[]>(NotificationService.getNotifications());
  const [currentUser, setCurrentUser] = useState<UserProfile | null>(null);
  const [isAuthenticated, setIsAuthenticated] = useState(false);

  // Initial user fetch
  useEffect(() => {
    const checkAuth = async () => {
      try {
        const user = await UserService.fetchCurrentUser(); // Mock fetching a logged-in user
        setCurrentUser(user);
        setIsAuthenticated(true);
      } catch (e) {
        console.error("No current user session:", e);
        setIsAuthenticated(false);
      }
    };
    checkAuth();
  }, []);

  useEffect(() => {
    localStorage.setItem('app-theme', theme);
    const root = document.documentElement;
    const styles = getThemeStyles(theme);
    for (const [key, value] of Object.entries(styles)) {
      root.style.setProperty(key, value);
    }
  }, [theme]);

  useEffect(() => {
    localStorage.setItem('app-language', language);
  }, [language]);

  useEffect(() => {
    const unsubscribe = NotificationService.subscribeToNotifications((allNotifications) => {
      setNotifications(allNotifications.sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()));
    });
    return () => unsubscribe();
  }, []);

  const addNotification = useCallback((notification: Alert) => {
    NotificationService.addNotification(notification);
    setNotifications(prev => [notification, ...prev].sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()));
  }, []);

  const markNotificationRead = useCallback((id: string) => {
    if (NotificationService.markAsRead(id)) {
      setNotifications(prev => prev.map(n => n.id === id ? { ...n, isRead: true } : n));
    }
  }, []);

  const unreadNotificationCount = useMemo(() => notifications.filter(n => !n.isRead).length, [notifications]);

  const logout = useCallback(() => {
    setCurrentUser(null);
    setIsAuthenticated(false);
    // In a real app, clear tokens, redirect to login
    window.location.hash = '#/login';
    NotificationService.addNotification({ id: generateUniqueId(), type: 'INFO', message: 'You have been logged out.', timestamp: new Date().toISOString(), isRead: true, priority: 'LOW', sourceSystem: 'AuthService' });
  }, []);


  const contextValue = useMemo(() => ({
    theme, setTheme, language, setLanguage, currentUser, setCurrentUser, notifications, addNotification, markNotificationRead, unreadNotificationCount, isAuthenticated, logout
  }), [theme, language, currentUser, setCurrentUser, notifications, addNotification, markNotificationRead, unreadNotificationCount, isAuthenticated, logout]);

  return (
    <AppContext.Provider value={contextValue}>
      {children}
    </AppContext.Provider>
  );
};

export const useAppContext = () => {
  const context = useContext(AppContext);
  if (!context) {
    throw new Error('useAppContext must be used within an AppProvider');
  }
  return context;
};

