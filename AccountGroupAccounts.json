export const Button: React.FC<React.ButtonHTMLAttributes<HTMLButtonElement> & { variant?: 'primary' | 'secondary' | 'danger' | 'ghost', size?: 'small' | 'medium' | 'large' }> = ({ children, variant = 'primary', size = 'medium', ...props }) => {
  const getVariantStyles = () => {
    switch (variant) {
      case 'secondary': return `
        background-color: var(--secondary-color);
        color: var(--text-color);
        border: 1px solid var(--border-color);
        &:hover { background-color: rgba(var(--secondary-color), 0.8); }
      `;
      case 'danger': return `
        background-color: var(--danger-color);
        color: #fff;
        border: none;
        &:hover { background-color: #c53030; }
      `;
      case 'ghost': return `
        background: none;
        color: var(--primary-color);
        border: 1px solid transparent;
        &:hover { background-color: rgba(var(--primary-color), 0.1); }
      `;
      case 'primary':
      default: return `
        background-color: var(--button-bg);
        color: var(--button-text);
        border: none;
        &:hover { background-color: rgba(var(--button-bg), 0.8); }
      `;
    }
  };

  const getSizeStyles = () => {
    switch (size) {
      case 'small': return `padding: 6px 12px; font-size: 0.8em;`;
      case 'large': return `padding: 12px 24px; font-size: 1.1em;`;
      case 'medium':
      default: return `padding: 8px 16px; font-size: 1em;`;
    }
  };

  return (
    <button {...props}>
      {children}
      <style jsx>{`
        button {
          border-radius: 4px;
          cursor: pointer;
          transition: all 0.2s ease-in-out;
          ${getVariantStyles()}
          ${getSizeStyles()}
          outline: none;
        }
        button:disabled {
          opacity: 0.6;
          cursor: not-allowed;
        }
      `}</style>
    </button>
  );
};

