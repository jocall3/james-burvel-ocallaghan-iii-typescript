// Simulates a GraphQL client (e.g., Apollo Client's `gql` tag)
export const gql = (strings: TemplateStringsArray, ...values: any[]): string => {
  let query = strings[0];
  for (let i = 0; i < values.length; i++) {
    query += values[i];
    query += strings[i + 1];
  }
  return query.replace(/\\n/g, '\n').trim(); // Basic cleanup
};

/**
 * Mocks a GraphQL API call.
 * This function simulates network latency and backend logic for different queries.
 */
export const mockGraphQLClient = async <TData = any, TVariables = any>(
  query: string,
  variables?: TVariables
): Promise<{ data: TData; errors?: any[] }> => {
  logger.debug('Mock GraphQL Request', { query, variables });
  await new Promise(resolve => setTimeout(resolve, Math.random() * 800 + 200)); // Simulate network latency

  let data: TData | null = null;
  let errors: any[] | undefined = undefined;

  // Simulate different queries based on their content
  if (query.includes('query AccountGroupsSelect')) {
    const { first, after, last, before, name } = variables as any || {};

    let filteredGroups = MOCK_DB.accountGroups;
    if (name) {
      filteredGroups = filteredGroups.filter(g => g.name.toLowerCase().includes(name.toLowerCase()));
    }

    filteredGroups.sort((a, b) => a.id.localeCompare(b.id)); // Consistent sorting for pagination

    let startIndex = 0;
    let endIndex = filteredGroups.length;

    if (after) {
      const afterIndex = filteredGroups.findIndex(g => g.id === after);
      if (afterIndex !== -1) startIndex = afterIndex + 1;
    }
    if (before) {
      const beforeIndex = filteredGroups.findIndex(g => g.id === before);
      if (beforeIndex !== -1) endIndex = beforeIndex;
    }

    let slicedGroups = filteredGroups.slice(startIndex, endIndex);

    if (first !== undefined) {
      slicedGroups = slicedGroups.slice(0, first);
    } else if (last !== undefined) {
      slicedGroups = slicedGroups.slice(-last);
    }

    const edges: IAccountGroupEdge[] = slicedGroups.map(group => ({
      node: group,
      cursor: group.id, // Using ID as cursor for simplicity
      __typename: 'AccountGroupEdge',
    }));

    const hasNextPage = (endIndex > startIndex + slicedGroups.length) || (slicedGroups.length < filteredGroups.slice(startIndex, endIndex).length);
    const hasPreviousPage = startIndex > 0;

    data = {
      accountGroups: {
        pageInfo: {
          hasNextPage: hasNextPage,
          hasPreviousPage: hasPreviousPage,
          startCursor: edges.length > 0 ? edges[0].cursor : null,
          endCursor: edges.length > 0 ? edges[edges.length - 1].cursor : null,
          __typename: 'PageInfo',
        },
        edges: edges,
        __typename: 'AccountGroupsConnection',
      },
    } as TData;

  } else if (query.includes('query GetAccountGroupDetails')) {
    const { id } = variables as { id: string };
    const group = MOCK_DB.accountGroups.find(g => g.id === id);
    if (!group) {
      errors = [{ message: `Account Group with ID ${id} not found.` }];
    } else {
      const accountsInGroup = MOCK_DB.accounts.filter(acc => acc.groupIds.includes(id));
      data = {
        accountGroup: {
          ...group,
          accounts: accountsInGroup,
        },
      } as TData;
    }
  } else if (query.includes('mutation CreateAccountGroup')) {
    const { input } = variables as { input: Omit<IAccountGroupNode, 'id' | 'createdAt' | 'updatedAt'> };
    if (!input.name || !input.createdBy) {
      errors = [{ message: 'Name and createdBy are required for new account group.' }];
    } else {
      const newGroup: IAccountGroupNode = {
        id: generateUniqueId(),
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        status: 'PENDING_APPROVAL', // New groups often need approval
        riskScore: 0,
        ...input,
        tags: input.tags || [],
        metadata: input.metadata || {},
      };
      MOCK_DB.accountGroups.push(newGroup);
      MOCK_DB.auditLogs.push({
        id: generateUniqueId(), timestamp: new Date().toISOString(), userId: newGroup.createdBy, username: MOCK_DB.users.find(u => u.id === newGroup.createdBy)?.username || 'unknown',
        action: 'CREATE', entityType: 'AccountGroup', entityId: newGroup.id, details: { name: newGroup.name }, ipAddress: '127.0.0.1'
      });
      data = { createAccountGroup: newGroup } as TData;
      logger.info(`Account group ${newGroup.name} created.`);
    }
  } else if (query.includes('mutation UpdateAccountGroup')) {
    const { id, input } = variables as { id: string; input: Partial<IAccountGroupNode> };
    const groupIndex = MOCK_DB.accountGroups.findIndex(g => g.id === id);
    if (groupIndex === -1) {
      errors = [{ message: `Account Group with ID ${id} not found for update.` }];
    } else {
      const oldGroup = MOCK_DB.accountGroups[groupIndex];
      const updatedGroup = {
        ...oldGroup,
        ...input,
        updatedAt: new Date().toISOString(),
      };
      MOCK_DB.accountGroups[groupIndex] = updatedGroup;
      MOCK_DB.auditLogs.push({
        id: generateUniqueId(), timestamp: new Date().toISOString(), userId: updatedGroup.createdBy || 'system', username: MOCK_DB.users.find(u => u.id === updatedGroup.createdBy)?.username || 'unknown',
        action: 'UPDATE', entityType: 'AccountGroup', entityId: updatedGroup.id, details: { changes: input }, ipAddress: '127.0.0.1'
      });
      data = { updateAccountGroup: updatedGroup } as TData;
      logger.info(`Account group ${updatedGroup.name} updated.`);
    }
  } else if (query.includes('mutation DeleteAccountGroup')) {
    const { id } = variables as { id: string };
    const initialLength = MOCK_DB.accountGroups.length;
    MOCK_DB.accountGroups = MOCK_DB.accountGroups.filter(g => g.id !== id);
    if (MOCK_DB.accountGroups.length === initialLength) {
      errors = [{ message: `Account Group with ID ${id} not found for deletion.` }];
    } else {
      MOCK_DB.auditLogs.push({
        id: generateUniqueId(), timestamp: new Date().toISOString(), userId: 'user-001', username: 'admin',
        action: 'DELETE', entityType: 'AccountGroup', entityId: id, details: {}, ipAddress: '127.0.0.1'
      });
      data = { deleteAccountGroup: { id } } as TData;
      logger.info(`Account group ${id} deleted.`);
    }
  } else if (query.includes('query GetUser')) {
    const { id, username, email } = variables as { id?: string; username?: string; email?: string };
    const user = MOCK_DB.users.find(u => (id && u.id === id) || (username && u.username === username) || (email && u.email === email));
    data = { user: user || null } as TData;
  } else if (query.includes('query GetUserAccounts')) {
    const { userId } = variables as { userId: string };
    const accounts = MOCK_DB.accounts.filter(acc => acc.ownerId === userId);
    data = { userAccounts: accounts } as TData;
  } else if (query.includes('query GetAccountTransactions')) {
    const { accountId, first, after } = variables as any;
    const transactions = MOCK_DB.transactions
      .filter(t => t.accountId === accountId)
      .sort((a, b) => new Date(b.transactionDate).getTime() - new Date(a.transactionDate).getTime());

    let startIndex = 0;
    if (after) {
      const afterIndex = transactions.findIndex(t => t.id === after);
      if (afterIndex !== -1) startIndex = afterIndex + 1;
    }

    const slicedTransactions = transactions.slice(startIndex, startIndex + (first || DEFAULT_PAGE_SIZE));
    const edges = slicedTransactions.map(t => ({ node: t, cursor: t.id }));
    const hasNextPage = startIndex + slicedTransactions.length < transactions.length;

    data = {
      accountTransactions: {
        pageInfo: {
          hasNextPage, hasPreviousPage: startIndex > 0,
          startCursor: edges.length > 0 ? edges[0].cursor : null, endCursor: edges.length > 0 ? edges[edges.length - 1].cursor : null
        },
        edges,
        __typename: 'TransactionConnection'
      }
    } as TData;
  }
  // Add more query/mutation handlers here to expand the API surface
  // For example: GetAuditLogs, CreateNotification, UpdateUser, etc.

  if (!data && !errors) {
    errors = [{ message: `Unsupported GraphQL operation: ${query.substring(0, 50)}...` }];
    logger.warn('Unsupported GraphQL operation detected.', { query });
  }

  logger.debug('Mock GraphQL Response', { data, errors });
  return { data: data as TData, errors };
};

// Simulates `useQuery` from Apollo Client for this specific file
export function useMockQuery<TData = any, TVariables = any>(
  query: string,
  options?: { variables?: TVariables; skip?: boolean; pollInterval?: number }
) {
  const [data, setData] = useState<TData | undefined>(undefined);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<any>(undefined);
  const variablesRef = useRef(options?.variables);
  const queryRef = useRef(query);

  const fetchData = useCallback(async (currentVariables: TVariables | undefined) => {
    if (options?.skip) {
      setData(undefined);
      setLoading(false);
      return;
    }
    setLoading(true);
    setError(undefined);
    try {
      const result = await mockGraphQLClient<TData, TVariables>(queryRef.current, currentVariables);
      if (result.errors && result.errors.length > 0) {
        setError(result.errors[0]); // Take first error
        logger.error('GraphQL Query Error', result.errors[0]);
      } else if (result.data) {
        setData(result.data);
      }
    } catch (e: any) {
      setError(e);
      logger.error('GraphQL Client Error', e);
    } finally {
      setLoading(false);
    }
  }, [options?.skip]);

  // Deep compare variables to prevent unnecessary re-fetches
  useEffect(() => {
    if (JSON.stringify(options?.variables) !== JSON.stringify(variablesRef.current)) {
      variablesRef.current = options?.variables;
      fetchData(options?.variables);
    }
  }, [options?.variables, fetchData]);

  useEffect(() => {
    fetchData(options?.variables);

    if (options?.pollInterval) {
      const interval = setInterval(() => fetchData(options?.variables), options.pollInterval);
      return () => clearInterval(interval);
    }
  }, [fetchData, options?.variables, options?.pollInterval]);

  return { data, loading, error, refetch: fetchData };
}

// --- Global Contexts & State Management ---

interface IAuthContext {
  isAuthenticated: boolean;
  user: IUser | null;
  login: (username: string, password: string) => Promise<boolean>;
  logout: () => void;
  hasPermission: (permission: string) => boolean;
  hasRole: (role: UserRole) => boolean;
  loading: boolean;
  error: string | null;
}

export const AuthContext = createContext<IAuthContext | undefined>(undefined);

export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [user, setUser] = useState<IUser | null>(null);
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const navigate = useNavigate();

  // Simulate session check on load
  useEffect(() => {
    const checkSession = async () => {
      setLoading(true);
      const token = localStorage.getItem('authToken');
      if (token) {
        const session = MOCK_DB.sessions.get(token);
        if (session && new Date(session.expiresAt) > new Date()) {
          const fetchedUser = MOCK_DB.users.find(u => u.id === session.userId);
          if (fetchedUser) {
            setUser(fetchedUser);
            setIsAuthenticated(true);
            logger.info(`User ${fetchedUser.username} re-authenticated from session.`);
          } else {
            localStorage.removeItem('authToken');
            MOCK_DB.sessions.delete(token);
            logger.warn('Session found, but user not found. Cleared session.');
          }
        } else {
          localStorage.removeItem('authToken');
          if (session) MOCK_DB.sessions.delete(token);
          logger.warn('Expired or invalid session token. Cleared session.');
        }
      }
      setLoading(false);
    };
    checkSession();

    // Set up a session timeout checker
    const sessionTimeout = setTimeout(() => {
      if (isAuthenticated) {
        logger.warn('Session timed out. User logged out.');
        logout();
        navigate('/login', { state: { message: 'Session expired. Please log in again.' } });
      }
    }, SESSION_TIMEOUT_MS);

    return () => clearTimeout(sessionTimeout);

  }, [isAuthenticated, navigate]); // Added navigate to dependency array

  const login = useCallback(async (username, password) => {
    setLoading(true);
    setError(null);
    try {
      // Simulate API call for login
      await new Promise(resolve => setTimeout(resolve, 1500));
      const foundUser = MOCK_DB.users.find(u => u.username === username); // No password check for demo
      if (foundUser) {
        // Simulate JWT token generation
        const token = generateUniqueId();
        const expiresAt = new Date(Date.now() + SESSION_TIMEOUT_MS).toISOString();
        const session: ISession = { token, userId: foundUser.id, expiresAt, issuedAt: new Date().toISOString() };
        MOCK_DB.sessions.set(token, session);
        localStorage.setItem('authToken', token);
        setUser(foundUser);
        setIsAuthenticated(true);
        setError(null);
        logger.info(`User ${username} logged in successfully.`, { userId: foundUser.id });

        MOCK_DB.auditLogs.push({
          id: generateUniqueId(), timestamp: new Date().toISOString(), userId: foundUser.id, username: foundUser.username,
          action: 'LOGIN', entityType: 'Auth', entityId: foundUser.id, details: { success: true }, ipAddress: '127.0.0.1'
        });
        return true;
      } else {
        const msg = 'Invalid username or password.';
        setError(msg);
        logger.warn(`Failed login attempt for ${username}.`);
        MOCK_DB.auditLogs.push({
          id: generateUniqueId(), timestamp: new Date().toISOString(), userId: 'unknown', username: username,
          action: 'LOGIN', entityType: 'Auth', entityId: 'N/A', details: { success: false, reason: msg }, ipAddress: '127.0.0.1'
        });
        return false;
      }
    } catch (err: any) {
      setError(err.message || 'An unexpected error occurred during login.');
      logger.error('Login error', { error: err, username });
      return false;
    } finally {
      setLoading(false);
    }
  }, []);

  const logout = useCallback(() => {
    const token = localStorage.getItem('authToken');
    if (token) {
      MOCK_DB.sessions.delete(token);
      localStorage.removeItem('authToken');
    }
    if (user) {
      MOCK_DB.auditLogs.push({
        id: generateUniqueId(), timestamp: new Date().toISOString(), userId: user.id, username: user.username,
        action: 'LOGOUT', entityType: 'Auth', entityId: user.id, details: {}, ipAddress: '127.0.0.1'
      });
      logger.info(`User ${user.username} logged out.`);
    }
    setUser(null);
    setIsAuthenticated(false);
    setError(null);
  }, [user]);

  const hasPermission = useCallback((permission: string): boolean => {
    if (!user) return false;
    if (user.roles.includes('ADMIN')) return true; // Admins have all permissions
    return user.permissions.includes(permission) || user.permissions.includes('*');
  }, [user]);

  const hasRole = useCallback((role: UserRole): boolean => {
    if (!user) return false;
    return user.roles.includes(role);
  }, [user]);

  const authContextValue = useMemo(() => ({
    isAuthenticated, user, login, logout, hasPermission, hasRole, loading, error
  }), [isAuthenticated, user, login, logout, hasPermission, hasRole, loading, error]);

  return (
    <AuthContext.Provider value={authContextValue}>
      {children}
    </AuthContext.Provider>
  );
};

export const useAuth = (): IAuthContext => {
  const context = useContext(AuthContext);
  if (context === undefined) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
};

// Theme Context
interface IThemeContext {
  theme: 'light' | 'dark' | 'system';
  setTheme: (theme: 'light' | 'dark' | 'system') => void;
}
export const ThemeContext = createContext<IThemeContext | undefined>(undefined);

export const ThemeProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [theme, setThemeState] = useState<'light' | 'dark' | 'system'>(() => {
    const savedTheme = localStorage.getItem('app-theme');
    return (savedTheme === 'light' || savedTheme === 'dark' || savedTheme === 'system') ? savedTheme : 'system';
  });

  useEffect(() => {
    const applyTheme = (currentTheme: 'light' | 'dark') => {
      document.documentElement.setAttribute('data-theme', currentTheme);
      document.body.className = currentTheme; // For CSS styling
    };

    if (theme === 'system') {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
      applyTheme(prefersDark.matches ? 'dark' : 'light');
      const handler = (e: MediaQueryListEvent) => applyTheme(e.matches ? 'dark' : 'light');
      prefersDark.addEventListener('change', handler);
      return () => prefersDark.removeEventListener('change', handler);
    } else {
      applyTheme(theme);
    }
    localStorage.setItem('app-theme', theme);
  }, [theme]);

  const setTheme = useCallback((newTheme: 'light' | 'dark' | 'system') => {
    setThemeState(newTheme);
    logger.info(`Theme changed to ${newTheme}.`);
  }, []);

  const themeContextValue = useMemo(() => ({ theme, setTheme }), [theme, setTheme]);

  return (
    <ThemeContext.Provider value={themeContextValue}>
      {children}
    </ThemeContext.Provider>
  );
};

export const useTheme = (): IThemeContext => {
  const context = useContext(ThemeContext);
  if (context === undefined) {
    throw new Error('useTheme must be used within a ThemeProvider');
  }
  return context;
};

// Notification Context
interface INotificationContext {
  notifications: INotification[];
  addNotification: (message: string, type?: INotification['type'], link?: string) => void;
  markAsRead: (id: string) => void;
  clearAllNotifications: () => void;
  unreadCount: number;
}
export const NotificationContext = createContext<INotificationContext | undefined>(undefined);

export const NotificationProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [notifications, setNotifications] = useState<INotification[]>([]);
  const { user } = useAuth(); // Integrate with AuthContext

  useEffect(() => {
    if (user) {
      // In a real app, fetch user-specific notifications from backend
      // For mock: filter generic notifications by user ID if they exist
      const userNotifications = MOCK_DB.notifications.filter(n => n.userId === user.id);
      setNotifications(userNotifications);
      logger.info(`Fetched ${userNotifications.length} notifications for user ${user.username}.`);
    } else {
      setNotifications([]);
    }
  }, [user]);

  const addNotification = useCallback((message: string, type: INotification['type'] = 'INFO', link?: string) => {
    if (!user) {
      logger.warn('Attempted to add notification without logged-in user.');
      return;
    }
    const newNotification: INotification = {
      id: generateUniqueId(),
      userId: user.id,
      message,
      type,
      read: false,
      timestamp: new Date().toISOString(),
      link,
    };
    setNotifications(prev => {
      const updated = [newNotification, ...prev];
      MOCK_DB.notifications.push(newNotification); // Add to mock DB
      return updated;
    });
    // In a real app, also send to backend
    logger.info(`Added notification for ${user.username}: ${message}`, { type });
    // Simulate toast notification
    // toast[type.toLowerCase() as 'info'|'warning'|'error'|'success'](message);
  }, [user]);

  const markAsRead = useCallback((id: string) => {
    setNotifications(prev => prev.map(n => n.id === id ? { ...n, read: true } : n));
    // In a real app, update backend
    logger.info(`Notification ${id} marked as read.`);
  }, []);

  const clearAllNotifications = useCallback(() => {
    setNotifications([]);
    // In a real app, clear all from backend for user
    logger.info('All notifications cleared.');
  }, []);

  const unreadCount = useMemo(() => notifications.filter(n => !n.read).length, [notifications]);

  const notificationContextValue = useMemo(() => ({
    notifications, addNotification, markAsRead, clearAllNotifications, unreadCount
  }), [notifications, addNotification, markAsRead, clearAllNotifications, unreadCount]);

  return (
    <NotificationContext.Provider value={notificationContextValue}>
      {children}
    </NotificationContext.Provider>
  );
};

export const useNotifications = (): INotificationContext => {
  const context = useContext(NotificationContext);
  if (context === undefined) {
    throw new Error('useNotifications must be used within a NotificationProvider');
  }
  return context;
};

