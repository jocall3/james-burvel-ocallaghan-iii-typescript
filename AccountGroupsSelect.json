export const AccountGroupsPage: React.FC = () => {
  const { addNotification, notifications } = useNotifications();
  const { user, hasPermission } = useAuth();
  const navigate = useNavigate();

  const [searchTerm, setSearchTerm] = useState('');
  const [currentPage, setCurrentPage] = useState(1);
  const [pageSize, setPageSize] = useState(DEFAULT_PAGE_SIZE);

  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);
  const [isEditModalOpen, setIsEditModalOpen] = useState(false);
  const [selectedGroup, setSelectedGroup] = useState<IAccountGroupNode | null>(null);

  const graphqlQuery = gql`
    query AccountGroupsSelect($first: Int, $after: String, $name: String) {
      accountGroups(first: $first, after: $after, name: $name) {
        pageInfo {
          hasNextPage
          hasPreviousPage
          startCursor
          endCursor
        }
        edges {
          node {
            id
            name
            description
            createdAt
            updatedAt
            createdBy
            status
            riskScore
            tags
            metadata
          }
          cursor
        }
      }
    }
  `;

  const { data, loading, error, refetch } = useMockQuery<{ accountGroups: IAccountGroupsConnection }, { first: number; after?: string; name?: string }>(
    graphqlQuery,
    {
      variables: {
        first: pageSize,
        name: searchTerm || undefined,
        after: notifications.find(n => n.link === `/account-groups/${searchTerm}`) ? 'some-cursor-logic' : undefined, // Example of notification-driven data fetching
      },
      pollInterval: 1000 * 60 * 5, // Poll every 5 minutes for updates
    }
  );

  const accountGroups = data?.accountGroups.edges.map(edge => edge.node) || [];
  const pageInfo = data?.accountGroups.pageInfo;

  const handleCreateGroup = useCallback(async (newGroup: Omit<IAccountGroupNode, 'id' | 'createdAt' | 'updatedAt' | 'status' | 'riskScore' | '__typename'>) => {
    if (!user) {
      addNotification('User not logged in.', 'ERROR');
      return;
    }
    const createMutation = gql`
      mutation CreateAccountGroup($input: AccountGroupInput!) {
        createAccountGroup(input: $input) {
          id
          name
          status
        }
      }
    `;
    const result = await mockGraphQLClient<{ createAccountGroup: IAccountGroupNode }, { input: any }>(createMutation, {
      input: {
        ...newGroup,
        createdBy: user.id,
        status: 'PENDING_APPROVAL', // Always pending for new
        riskScore: 0,
        tags: newGroup.tags || [],
        metadata: newGroup.metadata || {},
      }
    });
    if (result.errors) {
      addNotification(`Failed to create group: ${result.errors[0].message}`, 'ERROR');
    } else {
      addNotification(`Account Group "${newGroup.name}" created successfully! It requires approval.`, 'SUCCESS', `/account-groups/${result.data?.createAccountGroup.id}`);
      setIsCreateModalOpen(false);
      refetch();
    }
  }, [user, addNotification, refetch]);

  const handleUpdateGroup = useCallback(async (updatedFields: Partial<IAccountGroupNode>) => {
    if (!selectedGroup || !user) return;
    const updateMutation = gql`
      mutation UpdateAccountGroup($id: ID!, $input: UpdateAccountGroupInput!) {
        updateAccountGroup(id: $id, input: $input) {
          id
          name
          status
        }
      }
    `;
    const result = await mockGraphQLClient<{ updateAccountGroup: IAccountGroupNode }, { id: string; input: any }>(updateMutation, {
      id: selectedGroup.id,
      input: { ...updatedFields, updatedAt: new Date().toISOString() }
    });
    if (result.errors) {
      addNotification(`Failed to update group: ${result.errors[0].message}`, 'ERROR');
    } else {
      addNotification(`Account Group "${result.data?.updateAccountGroup.name}" updated.`, 'SUCCESS');
      setIsEditModalOpen(false);
      setSelectedGroup(null);
      refetch();
    }
  }, [selectedGroup, user, addNotification, refetch]);

  const handleDeleteGroup = useCallback(async (id: string, name: string) => {
    if (!window.confirm(`Are you sure you want to delete account group "${name}"? This action cannot be undone.`)) return;
    const deleteMutation = gql`
      mutation DeleteAccountGroup($id: ID!) {
        deleteAccountGroup(id: $id) {
          id
        }
      }
    `;
    const result = await mockGraphQLClient<{ deleteAccountGroup: { id: string } }, { id: string }>(deleteMutation, { id });
    if (result.errors) {
      addNotification(`Failed to delete group: ${result.errors[0].message}`, 'ERROR');
    } else {
      addNotification(`Account Group "${name}" deleted successfully.`, 'SUCCESS');
      refetch();
    }
  }, [addNotification, refetch]);

  const columns: ITableColumn<IAccountGroupNode>[] = useMemo(() => [
    { key: 'name', header: 'Group Name', sortable: true, render: (group) => <Link to={`/account-groups/${group.id}`} className="text-blue-600 dark:text-blue-400 hover:underline">{group.name}</Link> },
    { key: 'status', header: 'Status', sortable: true, render: (group) => <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${group.status === 'ACTIVE' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : group.status === 'PENDING_APPROVAL' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'}`}>{group.status.replace(/_/g, ' ')}</span> },
    { key: 'riskScore', header: 'Risk Score', sortable: true, render: (group) => <span className={`${group.riskScore > 7 ? 'text-red-600' : group.riskScore > 4 ? 'text-yellow-600' : 'text-green-600'} dark:text-white`}>{group.riskScore.toFixed(2)}</span> },
    { key: 'createdBy', header: 'Created By', render: (group) => MOCK_DB.users.find(u => u.id === group.createdBy)?.username || 'N/A' },
    { key: 'createdAt', header: 'Created At', sortable: true, render: (group) => formatDate(group.createdAt, 'en-US', { dateStyle: 'short' }) },
    { key: 'updatedAt', header: 'Last Updated', sortable: true, render: (group) => formatDate(group.updatedAt, 'en-US', { dateStyle: 'short', timeStyle: 'short' }) },
    {
      key: 'actions',
      header: 'Actions',
      render: (group) => (
        <div className="flex space-x-2">
          {hasPermission('manage:account_groups') && (
            <>
              <Button variant="secondary" size="small" onClick={(e) => { e.stopPropagation(); setSelectedGroup(group); setIsEditModalOpen(true); }}>Edit</Button>
              <Button variant="danger" size="small" onClick={(e) => { e.stopPropagation(); handleDeleteGroup(group.id, group.name); }}>Delete</Button>
            </>
          )}
          <Button variant="primary" size="small" onClick={(e) => { e.stopPropagation(); navigate(`/account-groups/${group.id}`); }}>View</Button>
        </div>
      )
    }
  ], [handleDeleteGroup, hasPermission, navigate]);

  const paginatedTableData = useMemo(() => {
    // This is effectively handled by useMockQuery's variables for 'first' and 'after'
    // but the Table component needs to display the actual results.
    return accountGroups;
  }, [accountGroups]);

  const handleNextPage = useCallback(() => {
    if (pageInfo?.hasNextPage && pageInfo.endCursor) {
      setCurrentPage(prev => prev + 1);
      refetch({ first: pageSize, after: pageInfo.endCursor, name: searchTerm || undefined });
    }
  }, [pageInfo, pageSize, searchTerm, refetch]);

  const handlePreviousPage = useCallback(() => {
    if (pageInfo?.hasPreviousPage && pageInfo.startCursor) {
      setCurrentPage(prev => prev - 1);
      // Relay-style `before` pagination is more complex, typically needs `last` and `before`
      // For simplicity in mock, just decrement page and refetch (or use client-side history for `before`)
      // A full implementation would need to send `last` and `before` to the GraphQL endpoint.
      // Here we'll just simulate by going back to the previous page's start.
      refetch({ first: pageSize, before: pageInfo.startCursor, name: searchTerm || undefined });
    }
  }, [pageInfo, pageSize, searchTerm, refetch]);

  const totalPages = pageInfo?.hasNextPage || pageInfo?.hasPreviousPage ? currentPage + 1 : currentPage; // Simplified for mock cursor pagination

  return (
    <div className="space-y-6">
      <h1 className="text-3xl font-bold">Manage Account Groups</h1>

      <div className="flex justify-between items-center mb-4 flex-wrap gap-2">
        <Input
          type="search"
          placeholder="Search group by name..."
          value={searchTerm}
          onChange={(e) => { setSearchTerm(e.target.value); setCurrentPage(1); }}
          className="w-full sm:w-80"
          id="group-search"
        />
        {hasPermission('manage:account_groups') && (
          <Button variant="primary" onClick={() => setIsCreateModalOpen(true)}>
            Create New Group
          </Button>
        )}
      </div>

      <Card>
        <Table<IAccountGroupNode>
          data={paginatedTableData}
          columns={columns}
          isLoading={loading}
          error={error ? error.message : undefined}
          enablePagination={true}
          pageSize={pageSize}
          // The built-in Table pagination is client-side.
          // For server-side (GraphQL cursor) pagination, we need custom controls.
          // Disabling Table's built-in pagination for server-side control.
          enableSorting={true}
          enableFiltering={false} // Handled by search input
        />
        <div className="flex justify-between items-center py-4">
          <Button
            variant="outline"
            onClick={handlePreviousPage}
            disabled={!pageInfo?.hasPreviousPage || loading}
          >
            Previous
          </Button>
          <span className="text-sm text-gray-700 dark:text-gray-300">
            Page {currentPage} (mock)
          </span>
          <Button
            variant="outline"
            onClick={handleNextPage}
            disabled={!pageInfo?.hasNextPage || loading}
          >
            Next
          </Button>
        </div>
      </Card>

      <Modal
        isOpen={isCreateModalOpen}
        onClose={() => setIsCreateModalOpen(false)}
        title="Create New Account Group"
      >
        <AccountGroupForm
          onSubmit={handleCreateGroup}
          onCancel={() => setIsCreateModalOpen(false)}
          isLoading={loading}
          initialValues={{ name: '', description: '', tags: [], metadata: {} }}
        />
      </Modal>

      <Modal
        isOpen={isEditModalOpen}
        onClose={() => { setIsEditModalOpen(false); setSelectedGroup(null); }}
        title={`Edit Account Group: ${selectedGroup?.name || ''}`}
      >
        {selectedGroup && (
          <AccountGroupForm
            onSubmit={handleUpdateGroup}
            onCancel={() => { setIsEditModalOpen(false); setSelectedGroup(null); }}
            isLoading={loading}
            initialValues={selectedGroup}
            isEdit={true}
          />
        )}
      </Modal>
    </div>
  );
};

interface IAccountGroupFormProps {
  onSubmit: (group: Partial<IAccountGroupNode>) => void;
  onCancel: () => void;
  isLoading: boolean;
  initialValues: Partial<IAccountGroupNode>;
  isEdit?: boolean;
}

export const AccountGroupForm: React.FC<IAccountGroupFormProps> = ({ onSubmit, onCancel, isLoading, initialValues, isEdit = false }) => {
  const [formData, setFormData] = useState<Partial<IAccountGroupNode>>(initialValues);
  const [errors, setErrors] = useState<Record<string, string>>({});

  useEffect(() => {
    setFormData(initialValues);
  }, [initialValues]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
    setErrors(prev => ({ ...prev, [name]: '' }));
  };

  const handleTagsChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    setFormData(prev => ({ ...prev, tags: e.target.value.split(',').map(tag => tag.trim()).filter(Boolean) }));
  };

  const validate = () => {
    const newErrors: Record<string, string> = {};
    if (!formData.name?.trim()) newErrors.name = 'Group Name is required.';
    // Add more validation rules here
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (validate()) {
      onSubmit(formData);
    }
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-4 p-4 dark:bg-gray-800 rounded-lg">
      <Input
        label="Group Name"
        id="name"
        name="name"
        value={formData.name || ''}
        onChange={handleChange}
        error={errors.name}
        required
        disabled={isLoading}
      />
      <Input
        label="Description"
        id="description"
        name="description"
        value={formData.description || ''}
        onChange={handleChange}
        disabled={isLoading}
        as="textarea" // Simulating a textarea input
      />
      <Input
        label="Tags (comma-separated)"
        id="tags"
        name="tags"
        value={formData.tags?.join(', ') || ''}
        onChange={handleTagsChange}
        disabled={isLoading}
        placeholder="e.g., Corporate, High Value, SMB"
      />
      {isEdit && (
        <>
          <Select
            label="Status"
            id="status"
            name="status"
            value={formData.status || 'ACTIVE'}
            onChange={handleChange}
            options={[
              { value: 'ACTIVE', label: 'Active' },
              { value: 'PENDING_APPROVAL', label: 'Pending Approval' },
              { value: 'INACTIVE', label: 'Inactive' },
            ]}
            disabled={isLoading}
          />
          <Input
            label="Risk Score"
            id="riskScore"
            name="riskScore"
            type="number"
            step="0.01"
            value={formData.riskScore !== undefined ? String(formData.riskScore) : '0'}
            onChange={(e) => setFormData(prev => ({ ...prev, riskScore: parseFloat(e.target.value) }))}
            disabled={isLoading}
          />
        </>
      )}

      <div className="flex justify-end space-x-2 pt-4">
        <Button type="button" variant="secondary" onClick={onCancel} disabled={isLoading}>
          Cancel
        </Button>
        <Button type="submit" variant="primary" isLoading={isLoading}>
          {isEdit ? 'Save Changes' : 'Create Group'}
        </Button>
      </div>
    </form>
  );
};

export const AccountGroupDetailsPage: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { addNotification, hasPermission } = useNotifications(); // Assuming hasPermission comes from auth
  const navigate = useNavigate();

  const graphqlQuery = gql`
    query GetAccountGroupDetails($id: ID!) {
      accountGroup(id: $id) {
        id
        name
        description
        createdAt
        updatedAt
        createdBy
        approvedBy
        status
        riskScore
        tags
        metadata
        accounts { # This field is mocked in mockGraphQLClient
          id
          accountNumber
          accountName
          accountType
          currentBalance
          currency
          ownerId
          status
        }
      }
    }
  `;

  const { data, loading, error, refetch } = useMockQuery<{ accountGroup: IAccountGroupNode & { accounts: IAccount[] } }, { id: string }>(
    graphqlQuery,
    { variables: { id: id! }, skip: !id }
  );

  const group = data?.accountGroup;
  const accountsInGroup = group?.accounts || [];

  const handleApproveGroup = useCallback(async () => {
    if (!group || !hasPermission('approve:account_groups')) {
      addNotification('Unauthorized or group not found.', 'ERROR');
      return;
    }
    if (!window.confirm(`Approve account group "${group.name}"?`)) return;

    const updateMutation = gql`
      mutation UpdateAccountGroup($id: ID!, $input: UpdateAccountGroupInput!) {
        updateAccountGroup(id: $id, input: $input) {
          id
          name
          status
          approvedBy
        }
      }
    `;
    const currentUser = MOCK_DB.users.find(u => u.username === 'admin'); // Assuming admin approval
    const result = await mockGraphQLClient(updateMutation, {
      id: group.id,
      input: { status: 'ACTIVE', approvedBy: currentUser?.id, updatedAt: new Date().toISOString() }
    });
    if (result.errors) {
      addNotification(`Failed to approve group: ${result.errors[0].message}`, 'ERROR');
    } else {
      addNotification(`Account Group "${group.name}" approved and is now active.`, 'SUCCESS');
      refetch();
    }
  }, [group, addNotification, refetch, hasPermission]);


  if (loading) return <Loader />;
  if (error) return <ErrorMessage message={error.message} />;
  if (!group) return <ErrorMessage message="Account Group not found." />;

  const accountColumns: ITableColumn<IAccount>[] = [
    { key: 'accountName', header: 'Account Name', render: (account) => <Link to={`/accounts/${account.id}`} className="text-blue-600 dark:text-blue-400 hover:underline">{account.accountName}</Link> },
    { key: 'accountNumber', header: 'Account Number' },
    { key: 'accountType', header: 'Type' },
    { key: 'currentBalance', header: 'Balance', render: (account) => formatCurrency(account.currentBalance, account.currency) },
    { key: 'status', header: 'Status' },
    {
      key: 'actions', header: 'Actions', render: (account) => (
        <Button variant="secondary" size="small" onClick={() => navigate(`/accounts/${account.id}`)}>View</Button>
      )
    },
  ];

  return (
    <div className="space-y-6">
      <h1 className="text-3xl font-bold">{group.name}</h1>
      <Button variant="outline" onClick={() => navigate('/account-groups')}>← Back to Groups</Button>

      <Card title="Group Details" headerActions={
        hasPermission('manage:account_groups') && group.status === 'PENDING_APPROVAL' && (
          <Button variant="success" onClick={handleApproveGroup}>Approve Group</Button>
        )
      }>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-gray-700 dark:text-gray-300">
          <div>
            <p><strong>Description:</strong> {group.description || 'N/A'}</p>
            <p><strong>Status:</strong> <span className={`font-semibold ${group.status === 'ACTIVE' ? 'text-green-600' : group.status === 'PENDING_APPROVAL' ? 'text-yellow-600' : 'text-red-600'}`}>{group.status.replace(/_/g, ' ')}</span></p>
            <p><strong>Risk Score:</strong> {group.riskScore?.toFixed(2) || 'N/A'}</p>
            <p><strong>Tags:</strong> {(group.tags && group.tags.length > 0) ? group.tags.join(', ') : 'None'}</p>
          </div>
          <div>
            <p><strong>Created By:</strong> {MOCK_DB.users.find(u => u.id === group.createdBy)?.username || 'Unknown'}</p>
            <p><strong>Created At:</strong> {formatDate(group.createdAt, 'en-US', { dateStyle: 'medium', timeStyle: 'short' })}</p>
            <p><strong>Last Updated:</strong> {formatDate(group.updatedAt, 'en-US', { dateStyle: 'medium', timeStyle: 'short' })}</p>
            <p><strong>Approved By:</strong> {group.approvedBy ? MOCK_DB.users.find(u => u.id === group.approvedBy)?.username : 'N/A'}</p>
          </div>
        </div>
        {group.metadata && Object.keys(group.metadata).length > 0 && (
          <div className="mt-4 border-t border-gray-200 dark:border-gray-700 pt-4">
            <h3 className="font-semibold text-lg">Metadata:</h3>
            <pre className="bg-gray-50 dark:bg-gray-700 p-3 rounded-md text-sm whitespace-pre-wrap">{JSON.stringify(group.metadata, null, 2)}</pre>
          </div>
        )}
      </Card>

      <Card title={`Accounts in ${group.name}`} headerActions={
        hasPermission('assign:accounts_to_groups') && (
          <Button variant="primary">Assign Account</Button> // Placeholder for future feature
        )
      }>
        <Table<IAccount>
          data={accountsInGroup}
          columns={accountColumns}
          enablePagination={true}
          enableSorting={true}
          pageSize={5}
        />
      </Card>
    </div>
  );
};

export const AccountsPage: React.FC = () => {
