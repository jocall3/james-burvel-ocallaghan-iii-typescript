export const AuditLogsPage: React.FC = () => {
  const { hasPermission } = useAuth();
  const [searchTerm, setSearchTerm] = useState('');
  const [filterAction, setFilterAction] = useState<AuditAction | 'ALL'>('ALL');
  const [filterEntityType, setFilterEntityType] = useState<string | 'ALL'>('ALL');
  const [startDate, setStartDate] = useState<Date | null>(null);
  const [endDate, setEndDate] = useState<Date | null>(null);

  if (!hasPermission('monitor:audit_logs')) {
    return <ErrorMessage message="You do not have permission to view Audit Logs." />;
  }

  const availableActions = useMemo(() => Array.from(new Set(MOCK_DB.auditLogs.map(log => log.action))), []);
  const availableEntityTypes = useMemo(() => Array.from(new Set(MOCK_DB.auditLogs.map(log => log.entityType))), []);

  const filteredLogs = useMemo(() => {
    let result = MOCK_DB.auditLogs;

    if (filterAction !== 'ALL') {
      result = result.filter(log => log.action === filterAction);
    }
    if (filterEntityType !== 'ALL') {
      result = result.filter(log => log.entityType === filterEntityType);
    }
    if (searchTerm) {
      const lowerSearch = searchTerm.toLowerCase();
      result = result.filter(log =>
        log.username.toLowerCase().includes(lowerSearch) ||
        log.action.toLowerCase().includes(lowerSearch) ||
        log.entityType.toLowerCase().includes(lowerSearch) ||
        JSON.stringify(log.details).toLowerCase().includes(lowerSearch) ||
        log.ipAddress.toLowerCase().includes(lowerSearch)
      );
    }
    if (startDate) {
      result = result.filter(log => new Date(log.timestamp) >= startDate);
    }
    if (endDate) {
      result = result.filter(log => new Date(log.timestamp) <= endDate);
    }

    return result.sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());
  }, [filterAction, filterEntityType, searchTerm, startDate, endDate]);

  const auditColumns: ITableColumn<IAuditLog>[] = useMemo(() => [
    { key: 'timestamp', header: 'Time', sortable: true, render: (log) => formatDate(log.timestamp, 'en-US', { dateStyle: 'short', timeStyle: 'short' }) },
    { key: 'username', header: 'User', sortable: true },
    { key: 'action', header: 'Action', sortable: true },
    { key: 'entityType', header: 'Entity Type', sortable: true },
    { key: 'entityId', header: 'Entity ID', sortable: true },
    { key: 'ipAddress', header: 'IP Address', sortable: true },
    { key: 'details', header: 'Details', render: (log) => <span className="text-xs text-gray-500 dark:text-gray-400 truncate w-48 block">{JSON.stringify(log.details)}</span> },
  ], []);

  return (
    <div className="space-y-6 mt-8">
      <h2 className="text-2xl font-bold">Audit Logs</h2>

      <div className="flex flex-wrap gap-4 items-end mb-4 p-4 bg-white dark:bg-gray-800 rounded-lg shadow-md">
        <Input
          type="search"
          placeholder="Search logs..."
          value={searchTerm}
          onChange={(e) => setSearchTerm(e.target.value)}
          className="w-full sm:w-64"
          id="audit-log-search"
        />
        <Select
          id="filter-audit-action"
          label="Action"
          value={filterAction}
          onChange={(e) => setFilterAction(e.target.value as AuditAction | 'ALL')}
          options={[{ value: 'ALL', label: 'All Actions' }, ...availableActions.map(a => ({ value: a, label: a.replace(/_/g, ' ') }))]}
          className="w-full sm:w-48"
        />
        <Select
          id="filter-audit-entity-type"
          label="Entity Type"
          value={filterEntityType}
          onChange={(e) => setFilterEntityType(e.target.value as string | 'ALL')}
          options={[{ value: 'ALL', label: 'All Entity Types' }, ...availableEntityTypes.map(et => ({ value: et, label: et }))]}
          className="w-full sm:w-48"
        />
        <div className="flex flex-col">
          <label htmlFor="audit-start-date" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Start Date</label>
          <input
            type="date"
            id="audit-start-date"
            className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"
            value={startDate ? startDate.toISOString().split('T')[0] : ''}
            onChange={(e) => setStartDate(e.target.value ? new Date(e.target.value) : null)}
          />
        </div>
        <div className="flex flex-col">
          <label htmlFor="audit-end-date" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">End Date</label>
          <input
            type="date"
            id="audit-end-date"
            className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"
            value={endDate ? endDate.toISOString().split('T')[0] : ''}
            onChange={(e) => setEndDate(e.target.value ? new Date(e.target.value) : null)}
          />
        </div>
        <Button variant="outline" onClick={() => {
          setSearchTerm(''); setFilterAction('ALL'); setFilterEntityType('ALL'); setStartDate(null); setEndDate(null);
        }}>Clear Filters</Button>
      </div>

      <Card>
        <Table<IAuditLog>
          data={filteredLogs}
          columns={auditColumns}
          enablePagination={true}
          enableSorting={true}
          enableFiltering={false}
          pageSize={DEFAULT_PAGE_SIZE}
        />
      </Card>
    </div>
  );
};

export const SystemSettingsPage: React.FC = () => {
  const { hasPermission } = useAuth();
  const { addNotification } = useNotifications();
  const [settings, setSettings] = useState({
    maintenanceMode: false,
    maxLoginAttempts: 5,
    sessionTimeout: SESSION_TIMEOUT_MS / 60000, // in minutes
    emailNotificationsEnabled: true,
    dataRetentionDays: 365,
    apiRateLimit: 1000,
  });
  const [isLoading, setIsLoading] = useState(false);

  useEffect(() => {
    // In a real app, fetch these from backend
    setSettings({
      maintenanceMode: false,
      maxLoginAttempts: 5,
      sessionTimeout: SESSION_TIMEOUT_MS / 60000,
      emailNotificationsEnabled: true,
      dataRetentionDays: 365,
      apiRateLimit: 1000,
    });
  }, []);

  const handleSettingChange = useCallback((e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value, type, checked } = e.target as HTMLInputElement;
    setSettings(prev => ({
      ...prev,
      [name]: type === 'checkbox' ? checked : (type === 'number' ? parseInt(value) : value),
    }));
  }, []);

  const handleSaveSettings = useCallback(async () => {
    if (!hasPermission('manage:system_settings')) {
      addNotification('Unauthorized to manage system settings.', 'ERROR');
      return;
    }
    setIsLoading(true);
    await new Promise(resolve => setTimeout(resolve, 1000)); // Simulate API call
    logger.info('System settings updated.', { settings });
    addNotification('System settings saved successfully!', 'SUCCESS');
    setIsLoading(false);
    // In a real app, send to backend to update global configuration
  }, [settings, addNotification, hasPermission]);

  if (!hasPermission('manage:system_settings')) {
    return <ErrorMessage message="You do not have permission to manage System Settings." />;
  }

  return (
    <div className="space-y-6 mt-8">
      <h2 className="text-2xl font-bold">System Settings</h2>

      <Card title="Application Configuration">
        <Input
          label="Maximum Login Attempts"
          id="maxLoginAttempts"
          name="maxLoginAttempts"
          type="number"
          value={settings.maxLoginAttempts}
          onChange={handleSettingChange}
          min={1}
          disabled={isLoading}
        />
        <Input
          label="Session Timeout (minutes)"
          id="sessionTimeout"
          name="sessionTimeout"
          type="number"
          value={settings.sessionTimeout}
          onChange={handleSettingChange}
          min={1}
          disabled={isLoading}
        />
        <Checkbox
          label="Enable Email Notifications"
          id="emailNotificationsEnabled"
          name="emailNotificationsEnabled"
          checked={settings.emailNotificationsEnabled}
          onChange={handleSettingChange}
          disabled={isLoading}
        />
        <Input
          label="Data Retention Period (days)"
          id="dataRetentionDays"
          name="dataRetentionDays"
          type="number"
          value={settings.dataRetentionDays}
          onChange={handleSettingChange}
          min={30}
          disabled={isLoading}
        />
        <Input
          label="API Rate Limit (requests/minute)"
          id="apiRateLimit"
          name="apiRateLimit"
          type="number"
          value={settings.apiRateLimit}
          onChange={handleSettingChange}
          min={10}
          disabled={isLoading}
        />
        <div className="flex justify-end mt-4">
          <Button variant="primary" onClick={handleSaveSettings} isLoading={isLoading}>
            Save Settings
          </Button>
        </div>
      </Card>
      <Card title="System Health & Maintenance">
        <Checkbox
          label="Enable Maintenance Mode"
          id="maintenanceMode"
          name="maintenanceMode"
          checked={settings.maintenanceMode}
          onChange={handleSettingChange}
          disabled={isLoading}
        />
        <p className="mt-2 text-sm text-yellow-600 dark:text-yellow-400">
          When Maintenance Mode is enabled, only administrators can access the application. Use with caution.
        </p>
        <div className="flex justify-end mt-4 space-x-2">
          <Button variant="danger" onClick={() => addNotification('System Restart initiated...', 'WARNING')}>
            Restart Services
          </Button>
          <Button variant="secondary" onClick={() => addNotification('Cache cleared successfully!', 'SUCCESS')}>
            Clear Cache
          </Button>
        </div>
      </Card>
    </div>
  );
};

export const BankBranchesPage: React.FC = () => {
  const { hasPermission } = useAuth();
  const { addNotification } = useNotifications();
  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);
  const [isEditModalOpen, setIsEditModalOpen] = useState(false);
  const [selectedBranch, setSelectedBranch] = useState<IBankBranch | null>(null);

  if (!hasPermission('read:bank_branches')) {
    return <ErrorMessage message="You do not have permission to view Bank Branches." />;
  }

  const handleCreateBranch = useCallback(async (newBranch: Omit<IBankBranch, 'id' | '__typename'>) => {
    // Simulate API call for creating a branch
    await new Promise(resolve => setTimeout(resolve, 1000));
    const createdBranch = {
      ...newBranch,
      id: generateUniqueId(),
      managerId: MOCK_DB.users.find(u => u.roles.includes('MANAGER'))?.id || 'user-001', // Assign a default manager
    };
    MOCK_DB.branches.push(createdBranch);
    addNotification(`Branch "${newBranch.name}" created successfully.`, 'SUCCESS');
    setIsCreateModalOpen(false);
  }, [addNotification]);

  const handleUpdateBranch = useCallback(async (branchId: string, updatedFields: Partial<IBankBranch>) => {
    // Simulate API call for updating a branch
    await new Promise(resolve => setTimeout(resolve, 1000));
    const index = MOCK_DB.branches.findIndex(b => b.id === branchId);
    if (index !== -1) {
      MOCK_DB.branches[index] = { ...MOCK_DB.branches[index], ...updatedFields };
      addNotification(`Branch "${updatedFields.name || MOCK_DB.branches[index].name}" updated successfully.`, 'SUCCESS');
      setIsEditModalOpen(false);
      setSelectedBranch(null);
    } else {
      addNotification('Branch not found.', 'ERROR');
    }
  }, [addNotification]);

  const handleDeleteBranch = useCallback(async (branchId: string, branchName: string) => {
    if (!window.confirm(`Are you sure you want to delete branch "${branchName}"? This action cannot be undone.`)) return;
    // Simulate API call for deleting a branch
    await new Promise(resolve => setTimeout(resolve, 1000));
    MOCK_DB.branches = MOCK_DB.branches.filter(b => b.id !== branchId);
    addNotification(`Branch "${branchName}" deleted.`, 'SUCCESS');
  }, [addNotification]);


  const branchColumns: ITableColumn<IBankBranch>[] = useMemo(() => [
    { key: 'name', header: 'Branch Name', sortable: true },
    { key: 'address', header: 'Address', render: (branch) => `${branch.address.street}, ${branch.address.city}` },
    { key: 'phoneNumber', header: 'Phone' },
    { key: 'email', header: 'Email' },
    { key: 'managerId', header: 'Manager', render: (branch) => MOCK_DB.users.find(u => u.id === branch.managerId)?.username || 'N/A' },
    { key: 'hoursOfOperation', header: 'Hours' },
    {
      key: 'actions',
      header: 'Actions',
      render: (branch) => (
        <div className="flex space-x-2">
          {hasPermission('manage:bank_branches') && (
            <>
              <Button variant="secondary" size="small" onClick={(e) => { e.stopPropagation(); setSelectedBranch(branch); setIsEditModalOpen(true); }}>Edit</Button>
              <Button variant="danger" size="small" onClick={(e) => { e.stopPropagation(); handleDeleteBranch(branch.id, branch.name); }}>Delete</Button>
            </>
          )}
        </div>
      )
    },
  ], [hasPermission, handleDeleteBranch]);

  return (
    <div className="space-y-6 mt-8">
      <h2 className="text-2xl font-bold">Bank Branches</h2>

      {hasPermission('manage:bank_branches') && (
        <div className="flex justify-end mb-4">
          <Button variant="primary" onClick={() => setIsCreateModalOpen(true)}>
            Add New Branch
          </Button>
        </div>
      )}

      <Card>
        <Table<IBankBranch>
          data={MOCK_DB.branches}
          columns={branchColumns}
          enablePagination={true}
          enableSorting={true}
          enableFiltering={true}
          pageSize={DEFAULT_PAGE_SIZE}
          filterFields={['name', 'address.city', 'phoneNumber', 'email']}
        />
      </Card>

      <Modal
        isOpen={isCreateModalOpen}
        onClose={() => setIsCreateModalOpen(false)}
        title="Create New Bank Branch"
      >
        <BranchForm
          onSubmit={handleCreateBranch}
          onCancel={() => setIsCreateModalOpen(false)}
          isLoading={false}
          initialValues={{
            name: '',
            address: { street: '', city: '', state: '', zip: '', country: '' },
            phoneNumber: '',
            email: '',
            managerId: '',
            hoursOfOperation: 'Mon-Fri 9-5',
          }}
        />
      </Modal>

      <Modal
        isOpen={isEditModalOpen}
        onClose={() => { setIsEditModalOpen(false); setSelectedBranch(null); }}
        title={`Edit Branch: ${selectedBranch?.name || ''}`}
      >
        {selectedBranch && (
          <BranchForm
            onSubmit={(updatedFields) => handleUpdateBranch(selectedBranch.id, updatedFields)}
            onCancel={() => { setIsEditModalOpen(false); setSelectedBranch(null); }}
            isLoading={false}
            initialValues={selectedBranch}
            isEdit={true}
          />
        )}
      </Modal>
    </div>
  );
};

interface IBranchFormProps {
  onSubmit: (branch: Partial<IBankBranch>) => void;
  onCancel: () => void;
  isLoading: boolean;
  initialValues: Partial<IBankBranch>;
  isEdit?: boolean;
}

export const BranchForm: React.FC<IBranchFormProps> = ({ onSubmit, onCancel, isLoading, initialValues, isEdit = false }) => {
  const [formData, setFormData] = useState<Partial<IBankBranch>>(initialValues);
  const [errors, setErrors] = useState<Record<string, string>>({});
  const managers = useMemo(() => MOCK_DB.users.filter(u => u.roles.includes('MANAGER')), []);

  useEffect(() => {
    setFormData(initialValues);
  }, [initialValues]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {
    const { name, value } = e.target;
    if (name.startsWith('address.')) {
      const addressField = name.split('.')[1] as keyof IBankBranch['address'];
      setFormData(prev => ({ ...prev, address: { ...(prev.address || {}), [addressField]: value } }));
    } else {
      setFormData(prev => ({ ...prev, [name]: value }));
    }
    setErrors(prev => ({ ...prev, [name]: '' }));
  };

  const validate = () => {
    const newErrors: Record<string, string> = {};
    if (!formData.name?.trim()) newErrors.name = 'Branch Name is required.';
    if (!formData.address?.street?.trim()) newErrors.street = 'Street is required.';
    if (!formData.address?.city?.trim()) newErrors.city = 'City is required.';
    if (!formData.address?.state?.trim()) newErrors.state = 'State is required.';
    if (!formData.address?.zip?.trim()) newErrors.zip = 'Zip Code is required.';
    if (!formData.address?.country?.trim()) newErrors.country = 'Country is required.';
    if (!formData.phoneNumber?.trim()) newErrors.phoneNumber = 'Phone Number is required.';
    if (!formData.email?.trim() || !validateEmail(formData.email)) newErrors.email = 'Valid Email is required.';
    if (!formData.managerId?.trim()) newErrors.managerId = 'Manager is required.';
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (validate()) {
      onSubmit(formData);
    }
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-4 p-4 dark:bg-gray-800 rounded-lg">
      <Input label="Branch Name" id="name" name="name" value={formData.name || ''} onChange={handleChange} error={errors.name} required disabled={isLoading} />
      <fieldset className="border p-4 rounded-md space-y-2 dark:border-gray-700">
        <legend className="text-lg font-semibold px-2 dark:text-gray-200">Address</legend>
        <Input label="Street" id="address.street" name="address.street" value={formData.address?.street || ''} onChange={handleChange} error={errors.street} required disabled={isLoading} />
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input label="City" id="address.city" name="address.city" value={formData.address?.city || ''} onChange={handleChange} error={errors.city} required disabled={isLoading} />
          <Input label="State" id="address.state" name="address.state" value={formData.address?.state || ''} onChange={handleChange} error={errors.state} required disabled={isLoading} />
        </div>
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input label="Zip Code" id="address.zip" name="address.zip" value={formData.address?.zip || ''} onChange={handleChange} error={errors.zip} required disabled={isLoading} />
          <Input label="Country" id="address.country" name="address.country" value={formData.address?.country || ''} onChange={handleChange} error={errors.country} required disabled={isLoading} />
        </div>
      </fieldset>
      <Input label="Phone Number" id="phoneNumber" name="phoneNumber" value={formData.phoneNumber || ''} onChange={handleChange} error={errors.phoneNumber} required disabled={isLoading} />
      <Input label="Email" id="email" name="email" type="email" value={formData.email || ''} onChange={handleChange} error={errors.email} required disabled={isLoading} />
      <Select
        label="Manager"
        id="managerId"
        name="managerId"
        value={formData.managerId || ''}
        onChange={handleChange}
        options={[{ value: '', label: 'Select a Manager', disabled: true }, ...managers.map(m => ({ value: m.id, label: `${m.firstName} ${m.lastName} (${m.username})` }))]}
        error={errors.managerId}
        required
        disabled={isLoading}
      />
      <Input label="Hours of Operation" id="hoursOfOperation" name="hoursOfOperation" value={formData.hoursOfOperation || ''} onChange={handleChange} disabled={isLoading} />

      <div className="flex justify-end space-x-2 pt-4">
        <Button type="button" variant="secondary" onClick={onCancel} disabled={isLoading}>
          Cancel
        </Button>
        <Button type="submit" variant="primary" isLoading={isLoading}>
          {isEdit ? 'Save Changes' : 'Create Branch'}
        </Button>
      </div>
    </form>
  );
};

export const MortgageApplicationsPage: React.FC = () => {
  const { hasPermission } = useAuth();
  const { addNotification } = useNotifications();
  const [filterStatus, setFilterStatus] = useState<'ALL' | 'PENDING' | 'APPROVED' | 'REJECTED' | 'IN_REVIEW'>('ALL');
  const [selectedApplication, setSelectedApplication] = useState<IMortgageApplication | null>(null);
  const [isDetailModalOpen, setIsDetailModalOpen] = useState(false);
  const [isApproveRejectModalOpen, setIsApproveRejectModalOpen] = useState(false);
  const [approvalNotes, setApprovalNotes] = useState('');
  const [approvalAction, setApprovalAction] = useState<'APPROVE' | 'REJECT' | null>(null);

  if (!hasPermission('read:mortgage_applications')) {
    return <ErrorMessage message="You do not have permission to view Mortgage Applications." />;
  }

  const filteredApplications = useMemo(() => {
    let result = MOCK_DB.mortgageApplications;
    if (filterStatus !== 'ALL') {
      result = result.filter(app => app.status === filterStatus);
    }
    return result.sort((a, b) => new Date(b.submittedDate).getTime() - new Date(a.submittedDate).getTime());
  }, [filterStatus]);

  const handleViewDetails = useCallback((app: IMortgageApplication) => {
    setSelectedApplication(app);
    setIsDetailModalOpen(true);
  }, []);

  const handleApproveRejectClick = useCallback((app: IMortgageApplication, action: 'APPROVE' | 'REJECT') => {
    setSelectedApplication(app);
    setApprovalAction(action);
    setIsApproveRejectModalOpen(true);
  }, []);

  const handleApproveRejectSubmit = useCallback(async () => {
    if (!selectedApplication || !approvalAction || !hasPermission('approve:mortgage_applications')) {
      addNotification('Invalid action or unauthorized.', 'ERROR');
      return;
    }
    await new Promise(resolve => setTimeout(resolve, 1500)); // Simulate API call
    const index = MOCK_DB.mortgageApplications.findIndex(app => app.id === selectedApplication.id);
    if (index !== -1) {
      MOCK_DB.mortgageApplications[index] = {
        ...MOCK_DB.mortgageApplications[index],
        status: approvalAction === 'APPROVE' ? 'APPROVED' : 'REJECTED',
        approvedDate: new Date().toISOString(),
        notes: approvalNotes,
        agentId: MOCK_DB.users.find(u => u.roles.includes('MANAGER'))?.id || 'user-001', // Assign current agent
      };
      addNotification(`Mortgage Application ${selectedApplication.id} ${approvalAction}D successfully.`, 'SUCCESS');
    } else {
      addNotification('Application not found.', 'ERROR');
    }
    setIsApproveRejectModalOpen(false);
    setSelectedApplication(null);
    setApprovalNotes('');
    setApprovalAction(null);
  }, [selectedApplication, approvalAction, approvalNotes, addNotification, hasPermission]);


  const applicationColumns: ITableColumn<IMortgageApplication>[] = useMemo(() => [
    { key: 'id', header: 'Application ID', render: (app) => <span className="font-mono text-xs">{app.id}</span> },
    { key: 'applicantId', header: 'Applicant', render: (app) => MOCK_DB.users.find(u => u.id === app.applicantId)?.username || 'N/A' },
    { key: 'loanAmount', header: 'Loan Amount', sortable: true, render: (app) => formatCurrency(app.loanAmount, 'USD') },
    { key: 'propertyAddress', header: 'Property Address' },
    { key: 'submittedDate', header: 'Submitted Date', sortable: true, render: (app) => formatDate(app.submittedDate, 'en-US', { dateStyle: 'short' }) },
    { key: 'status', header: 'Status', sortable: true, render: (app) => <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${app.status === 'APPROVED' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : app.status === 'PENDING' || app.status === 'IN_REVIEW' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'}`}>{app.status.replace(/_/g, ' ')}</span> },
    {
      key: 'actions',
      header: 'Actions',
      render: (app) => (
        <div className="flex space-x-2">
          <Button variant="secondary" size="small" onClick={(e) => { e.stopPropagation(); handleViewDetails(app); }}>View</Button>
          {hasPermission('approve:mortgage_applications') && app.status === 'PENDING' && (
            <>
              <Button variant="success" size="small" onClick={(e) => { e.stopPropagation(); handleApproveRejectClick(app, 'APPROVE'); }}>Approve</Button>
              <Button variant="danger" size="small" onClick={(e) => { e.stopPropagation(); handleApproveRejectClick(app, 'REJECT'); }}>Reject</Button>
            </>
          )}
        </div>
      )
    },
  ], [handleViewDetails, hasPermission, handleApproveRejectClick]);

  // Seed some mock mortgage applications
  useEffect(() => {
    if (MOCK_DB.mortgageApplications.length === 0) {
      MOCK_DB.mortgageApplications.push(
        { id: generateUniqueId(), applicantId: MOCK_DB.users[1].id, loanAmount: 350000, propertyAddress: '123 Oak St, Metropolis, NY', status: 'PENDING', submittedDate: new Date(Date.now() - 5 * 24 * 60 * 60 * 1000).toISOString() },
        { id: generateUniqueId(), applicantId: MOCK_DB.users[1].id, loanAmount: 500000, propertyAddress: '456 Pine Ave, Gotham, NJ', status: 'APPROVED', submittedDate: new Date(Date.now() - 15 * 24 * 60 * 60 * 1000).toISOString(), approvedDate: new Date(Date.now() - 10 * 24 * 60 * 60 * 1000).toISOString(), agentId: MOCK_DB.users[0].id, notes: 'Good credit score.' },
        { id: generateUniqueId(), applicantId: MOCK_DB.users[2].id, loanAmount: 200000, propertyAddress: '789 Birch Ln, Starling City, CA', status: 'IN_REVIEW', submittedDate: new Date(Date.now() - 2 * 24 * 60 * 60 * 1000).toISOString() },
        { id: generateUniqueId(), applicantId: MOCK_DB.users[2].id, loanAmount: 600000, propertyAddress: '101 Cedar Rd, Central City, MO', status: 'REJECTED', submittedDate: new Date(Date.now() - 25 * 24 * 60 * 60 * 1000).toISOString(), approvedDate: new Date(Date.now() - 20 * 24 * 60 * 60 * 1000).toISOString(), agentId: MOCK_DB.users[0].id, notes: 'Insufficient collateral.' },
      );
    }
  }, []);

  return (
    <div className="space-y-6 mt-8">
      <h2 className="text-2xl font-bold">Mortgage Applications</h2>

      <div className="flex justify-between items-center mb-4 flex-wrap gap-2">
        <Select
          id="filter-mortgage-status"
          label="Filter by Status"
          value={filterStatus}
          onChange={(e) => setFilterStatus(e.target.value as 'ALL' | 'PENDING' | 'APPROVED' | 'REJECTED' | 'IN_REVIEW')}
          options={[
            { value: 'ALL', label: 'All Statuses' },
            { value: 'PENDING', label: 'Pending' },
            { value: 'IN_REVIEW', label: 'In Review' },
            { value: 'APPROVED', label: 'Approved' },
            { value: 'REJECTED', label: 'Rejected' },
          ]}
          className="w-full sm:w-48"
        />
        {hasPermission('submit:mortgage_application') && (
          <Button variant="primary" onClick={() => addNotification('New mortgage application submission initiated.', 'INFO')}>
            Submit New Application
          </Button>
        )}
      </div>

      <Card>
        <Table<IMortgageApplication>
          data={filteredApplications}
          columns={applicationColumns}
          enablePagination={true}
          enableSorting={true}
          enableFiltering={true}
          pageSize={DEFAULT_PAGE_SIZE}
          filterFields={['id', 'applicantId', 'propertyAddress', 'status']}
        />
      </Card>

      <Modal
        isOpen={isDetailModalOpen}
        onClose={() => setIsDetailModalOpen(false)}
        title={`Mortgage Application Details: ${selectedApplication?.id || ''}`}
        size="lg"
      >
        {selectedApplication && (
          <div className="p-4 space-y-4 text-gray-700 dark:text-gray-300">
            <p><strong>Applicant:</strong> {MOCK_DB.users.find(u => u.id === selectedApplication.applicantId)?.username || 'N/A'}</p>
            <p><strong>Loan Amount:</strong> {formatCurrency(selectedApplication.loanAmount, 'USD')}</p>
            <p><strong>Property Address:</strong> {selectedApplication.propertyAddress}</p>
            <p><strong>Status:</strong> <span className={`font-semibold ${selectedApplication.status === 'APPROVED' ? 'text-green-600' : selectedApplication.status === 'PENDING' || selectedApplication.status === 'IN_REVIEW' ? 'text-yellow-600' : 'text-red-600'}`}>{selectedApplication.status.replace(/_/g, ' ')}</span></p>
            <p><strong>Submitted Date:</strong> {formatDate(selectedApplication.submittedDate, 'en-US', { dateStyle: 'medium', timeStyle: 'short' })}</p>
            {selectedApplication.approvedDate && <p><strong>Approved/Rejected Date:</strong> {formatDate(selectedApplication.approvedDate, 'en-US', { dateStyle: 'medium', timeStyle: 'short' })}</p>}
            {selectedApplication.agentId && <p><strong>Processed By:</strong> {MOCK_DB.users.find(u => u.id === selectedApplication.agentId)?.username || 'N/A'}</p>}
            {selectedApplication.notes && (
              <div>
                <strong>Notes:</strong>
                <p className="bg-gray-50 dark:bg-gray-700 p-2 rounded-md whitespace-pre-wrap">{selectedApplication.notes}</p>
              </div>
            )}
          </div>
        )}
        <div className="flex justify-end pt-4">
          <Button variant="secondary" onClick={() => setIsDetailModalOpen(false)}>Close</Button>
        </div>
      </Modal>

      <Modal
        isOpen={isApproveRejectModalOpen}
        onClose={() => { setIsApproveRejectModalOpen(false); setSelectedApplication(null); setApprovalNotes(''); setApprovalAction(null); }}
        title={`${approvalAction} Mortgage Application: ${selectedApplication?.id || ''}`}
      >
        {selectedApplication && (
          <div className="p-4 space-y-4">
            <p>Are you sure you want to {approvalAction?.toLowerCase()} this application for {formatCurrency(selectedApplication.loanAmount, 'USD')}?</p>
            <Input
              label="Notes (Optional)"
              id="approval-notes"
              name="approvalNotes"
              as="textarea"
              value={approvalNotes}
              onChange={(e) => setApprovalNotes(e.target.value)}
              rows={4}
            />
            <div className="flex justify-end space-x-2 pt-4">
              <Button variant="secondary" onClick={() => { setIsApproveRejectModalOpen(false); setSelectedApplication(null); setApprovalNotes(''); setApprovalAction(null); }}>
                Cancel
              </Button>
              <Button
                variant={approvalAction === 'APPROVE' ? 'success' : 'danger'}
                onClick={handleApproveRejectSubmit}
              >
                {approvalAction}
              </Button>
            </div>
          </div>
        )}
      </Modal>
    </div>
  );
};


export const SecurityCenterPage: React.FC = () => {
  const { hasPermission, user } = useAuth();
  const { addNotification } = useNotifications();

  const [mfaEnabled, setMfaEnabled] = useState(false);
  const [passwordLastChanged, setPasswordLastChanged] = useState<string>('');
  const [activeSessions, setActiveSessions] = useState<ISession[]>([]);
  const [suspiciousActivityDetected, setSuspiciousActivityDetected] = useState(false);

  useEffect(() => {
    if (user) {
      // Mock fetching user security settings
      setMfaEnabled(Math.random() > 0.5);
      setPasswordLastChanged(formatDate(new Date(Date.now() - Math.random() * 365 * 24 * 60 * 60 * 1000), 'en-US', { dateStyle: 'medium' }));
      // Filter sessions for the current user
      setActiveSessions(Array.from(MOCK_DB.sessions.values()).filter(s => s.userId === user.id && new Date(s.expiresAt) > new Date()));
      setSuspiciousActivityDetected(Math.random() > 0.8); // Simulate occasional detection
    }
  }, [user]);

  const handleToggleMFA = useCallback(async () => {
    if (!hasPermission('manage:own_security_settings')) {
      addNotification('Unauthorized to change MFA settings.', 'ERROR');
      return;
    }
    await new Promise(resolve => setTimeout(resolve, 1000));
    setMfaEnabled(prev => !prev);
    addNotification(`MFA ${mfaEnabled ? 'disabled' : 'enabled'} successfully.`, 'SUCCESS');
  }, [mfaEnabled, addNotification, hasPermission]);

  const handleChangePassword = useCallback(async () => {
    if (!hasPermission('manage:own_security_settings')) {
      addNotification('Unauthorized to change password.', 'ERROR');
      return;
    }
    // In real app, open a modal for old/new password input, then send to API
    await new Promise(resolve => setTimeout(resolve, 1500));
    setPasswordLastChanged(formatDate(new Date(), 'en-US', { dateStyle: 'medium' }));
    addNotification('Password changed successfully!', 'SUCCESS');
    logger.info(`User ${user?.username} changed password.`);
  }, [addNotification, hasPermission, user]);

  const handleEndSession = useCallback(async (sessionId: string) => {
    if (!hasPermission('manage:own_security_settings')) {
      addNotification('Unauthorized to manage sessions.', 'ERROR');
      return;
    }
    if (!window.confirm('Are you sure you want to end this session?')) return;
    await new Promise(resolve => setTimeout(resolve, 500));
    MOCK_DB.sessions.delete(sessionId); // Remove from mock DB
    setActiveSessions(prev => prev.filter(s => s.token !== sessionId));
    addNotification('Session ended successfully.', 'SUCCESS');
    logger.info(`User ${user?.username} ended session ${sessionId}.`);
  }, [addNotification, hasPermission, user]);


  if (!user || !hasPermission('view:security_center')) {
    return <ErrorMessage message="You do not have permission to access the Security Center." />;
  }

  const sessionColumns: ITableColumn<ISession>[] = [
    { key: 'token', header: 'Session Token', render: (session) => <span className="font-mono text-xs">{session.token.substring(0, 8)}...</span> },
    { key: 'issuedAt', header: 'Login Time', render: (session) => formatDate(session.issuedAt, 'en-US', { dateStyle: 'short', timeStyle: 'short' }) },
    { key: 'expiresAt', header: 'Expires', render: (session) => formatDate(session.expiresAt, 'en-US', { dateStyle: 'short', timeStyle: 'short' }) },
    { key: 'ipAddress', header: 'IP Address', render: () => '127.0.0.1 (Mock)' }, // Mock IP
    {
      key: 'actions', header: 'Actions', render: (session) => (
        <Button variant="danger" size="small" onClick={(e) => { e.stopPropagation(); handleEndSession(session.token); }}>End Session</Button>
      )
    },
  ];

  return (
    <div className="space-y-6 mt-8">
      <h2 className="text-2xl font-bold">Security Center</h2>

      {suspiciousActivityDetected && (
        <ErrorMessage message="Suspicious activity detected on your account! Please review your recent activity and connected devices. Contact support if you did not authorize these actions." />
      )}

      <Card title="Account Security Settings">
        <div className="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-700">
          <span className="font-medium">Two-Factor Authentication (MFA)</span>
          <Button variant={mfaEnabled ? 'danger' : 'success'} onClick={handleToggleMFA} disabled={!hasPermission('manage:own_security_settings')}>
            {mfaEnabled ? 'Disable MFA' : 'Enable MFA'}
          </Button>
        </div>
        <div className="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-700">
          <span className="font-medium">Password Last Changed</span>
          <span>{passwordLastChanged}</span>
          <Button variant="secondary" onClick={handleChangePassword} disabled={!hasPermission('manage:own_security_settings')}>
            Change Password
          </Button>
        </div>
        <div className="flex items-center justify-between py-2">
          <span className="font-medium">Security Questions</span>
          <Button variant="secondary" onClick={() => addNotification('Update security questions feature initiated.', 'INFO')} disabled={!hasPermission('manage:own_security_settings')}>
            Update Questions
          </Button>
        </div>
      </Card>

      <Card title="Active Sessions">
        <p className="mb-4 text-gray-500 dark:text-gray-400">Review and manage devices currently logged into your account.</p>
        <Table<ISession>
          data={activeSessions}
          columns={sessionColumns}
          enablePagination={true}
          enableSorting={false}
          enableFiltering={false}
          pageSize={5}
        />
      </Card>

      <Card title="Recent Security Events (Audit Log Snippet)">
        <Table<IAuditLog>
          data={MOCK_DB.auditLogs.filter(log => log.userId === user?.id || log.username === user?.username).slice(-5).reverse()}
          columns={[
            { key: 'timestamp', header: 'Time', render: (log) => formatDate(log.timestamp, 'en-US', { dateStyle: 'short', timeStyle: 'short' }) },
            { key: 'action', header: 'Action' },
            { key: 'ipAddress', header: 'IP Address' },
            { key: 'details', header: 'Details', render: (log) => <span className="text-xs text-gray-500 dark:text-gray-400 truncate">{JSON.stringify(log.details)}</span> },
          ]}
          enablePagination={false}
          enableSorting={false}
        />
        <div className="flex justify-end mt-4">
          <Button variant="outline" onClick={() => navigate('/admin/audit')}>View All Audit Logs</Button>
        </div>
      </Card>
    </div>
  );
};

export const MaintenanceModePage: React.FC = () => {
  const { hasRole } = useAuth();
  const { addNotification } = useNotifications();

  if (!hasRole('ADMIN')) {
    return <ErrorMessage message="You do not have permission to manage Maintenance Mode." />;
  }

  const [isMaintenanceMode, setIsMaintenanceMode] = useState(false);
  const [countdown, setCountdown] = useState<number | null>(null);

  useEffect(() => {
    // Simulate fetching current maintenance status from system settings
    setIsMaintenanceMode(false); // Default to off for mock
  }, []);

  const handleToggleMaintenanceMode = useCallback(async (enable: boolean) => {
    if (!window.confirm(`Are you sure you want to ${enable ? 'ENABLE' : 'DISABLE'} Maintenance Mode? This will affect all non-admin users.`)) return;

    // In a real app, this would trigger a backend process
    addNotification(`Initiating ${enable ? 'enable' : 'disable'} maintenance mode sequence...`, 'INFO');
    setCountdown(5); // Start 5-second countdown

    const timer = setInterval(() => {
      setCountdown(prev => {
        if (prev === null) return null;
        if (prev <= 1) {
          clearInterval(timer);
          setIsMaintenanceMode(enable);
          setCountdown(null);
          addNotification(`Maintenance Mode ${enable ? 'ENABLED' : 'DISABLED'} successfully.`, 'SUCCESS');
          logger.warn(`Maintenance Mode ${enable ? 'ENABLED' : 'DISABLED'}.`);
          return null;
        }
        return prev - 1;
      });
    }, 1000);

    return () => clearInterval(timer);
  }, [addNotification]);

  return (
    <div className="space-y-6 mt-8">
      <h2 className="text-2xl font-bold">Maintenance Mode Management</h2>

      <Card title="Control Maintenance Status">
        <p className="text-lg mb-4">Current Status: <span className={`font-bold ${isMaintenanceMode ? 'text-red-600 dark:text-red-400' : 'text-green-600 dark:text-green-400'}`}>
          {isMaintenanceMode ? 'ENABLED' : 'DISABLED'}
        </span></p>

        {countdown !== null && (
          <div className="bg-blue-100 dark:bg-blue-900 border-l-4 border-blue-500 text-blue-700 dark:text-blue-200 p-4 mb-4" role="alert">
            <p className="font-bold">Process in progress:</p>
            <p>Maintenance mode will be {isMaintenanceMode ? 'disabled' : 'enabled'} in {countdown} seconds.</p>
          </div>
        )}

        <div className="flex space-x-4 mt-4">
          <Button
            variant="danger"
            onClick={() => handleToggleMaintenanceMode(true)}
            disabled={isMaintenanceMode || countdown !== null}
            isLoading={countdown !== null && !isMaintenanceMode}
          >
            Enable Maintenance Mode
          </Button>
          <Button
            variant="success"
            onClick={() => handleToggleMaintenanceMode(false)}
            disabled={!isMaintenanceMode || countdown !== null}
            isLoading={countdown !== null && isMaintenanceMode}
          >
            Disable Maintenance Mode
          </Button>
        </div>

        <p className="mt-6 text-sm text-gray-600 dark:text-gray-400">
          Enabling maintenance mode will restrict access to all non-administrator users, displaying a custom maintenance page.
          Ensure all necessary procedures are followed before enabling or disabling.
        </p>
      </Card>

      <Card title="Scheduled Maintenance">
        <p className="text-gray-500 dark:text-gray-400 mb-4">
          Configure upcoming maintenance windows. Users will be notified in advance. (Feature placeholder)
        </p>
        <Button variant="secondary" onClick={() => addNotification('Scheduling maintenance feature initiated.', 'INFO')}>
          Schedule New Maintenance
        </Button>
      </Card>
    </div>
  );
};


export const NotificationsPage: React.FC = () => {
  const { notifications, markAsRead, clearAllNotifications, unreadCount } = useNotifications();
  const { user } = useAuth();
  const navigate = useNavigate();

  if (!user) return <ErrorMessage message="Please log in to view notifications." />;

  const notificationColumns: ITableColumn<INotification>[] = useMemo(() => [
    { key: 'timestamp', header: 'Time', sortable: true, render: (notif) => formatDate(notif.timestamp, 'en-US', { dateStyle: 'short', timeStyle: 'short' }) },
    { key: 'type', header: 'Type', sortable: true, render: (notif) => <span className={`font-semibold ${notif.type === 'ERROR' ? 'text-red-600' : notif.type === 'WARNING' ? 'text-yellow-600' : notif.type === 'SUCCESS' ? 'text-green-600' : 'text-blue-600'}`}>{notif.type}</span> },
    { key: 'message', header: 'Message', sortable: true, render: (notif) => <span className={!notif.read ? 'font-bold' : ''}>{notif.message}</span> },
    { key: 'read', header: 'Read', sortable: true, render: (notif) => notif.read ? 'Yes' : 'No' },
    {
      key: 'actions',
      header: 'Actions',
      render: (notif) => (
        <div className="flex space-x-2">
          {!notif.read && (
            <Button variant="secondary" size="small" onClick={(e) => { e.stopPropagation(); markAsRead(notif.id); }}>Mark as Read</Button>
          )}
          {notif.link && (
            <Button variant="primary" size="small" onClick={(e) => { e.stopPropagation(); navigate(notif.link!); markAsRead(notif.id); }}>View Details</Button>
          )}
        </div>
      )
    },
  ], [markAsRead, navigate]);

  return (
    <div className="space-y-6">
      <h1 className="text-3xl font-bold">Your Notifications ({unreadCount} unread)</h1>

      <div className="flex justify-end mb-4">
        <Button variant="danger" onClick={clearAllNotifications} disabled={notifications.length === 0}>
          Clear All Notifications
        </Button>
      </div>

      <Card>
        <Table<INotification>
          data={notifications}
          columns={notificationColumns}
          enablePagination={true}
          enableSorting={true}
          enableFiltering={true}
          pageSize={DEFAULT_PAGE_SIZE}
          initialSort={{ key: 'timestamp', direction: 'desc' }}
          filterFields={['message', 'type', 'read']}
        />
      </Card>
    </div>
  );
};


export const UserProfilePage: React.FC = () => {
  const { user, hasPermission } = useAuth();
  const { addNotification } = useNotifications();
  const [formData, setFormData] = useState<Partial<IUser> | null>(null);
  const [isEditing, setIsEditing] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [errors, setErrors] = useState<Record<string, string>>({});

  useEffect(() => {
    if (user) {
      setFormData(user);
    }
  }, [user]);

  const handleChange = useCallback((e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
    const { name, value } = e.target;
    if (name.startsWith('address.')) {
      const addressField = name.split('.')[1] as keyof IUser['address'];
      setFormData(prev => ({ ...prev, address: { ...(prev?.address || {}), [addressField]: value } }));
    } else {
      setFormData(prev => ({ ...prev, [name]: value }));
    }
    setErrors(prev => ({ ...prev, [name]: '' }));
  }, []);

  const validate = useCallback(() => {
    const newErrors: Record<string, string> = {};
    if (!formData?.firstName?.trim()) newErrors.firstName = 'First Name is required.';
    if (!formData?.lastName?.trim()) newErrors.lastName = 'Last Name is required.';
    if (!formData?.email?.trim() || (formData?.email && !validateEmail(formData.email))) newErrors.email = 'Valid Email is required.';
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  }, [formData]);

  const handleSave = useCallback(async () => {
    if (!user || !formData || !validate()) return;
    setIsLoading(true);
    // Simulate API call to update user profile
    await new Promise(resolve => setTimeout(resolve, 1500));
    const userIndex = MOCK_DB.users.findIndex(u => u.id === user.id);
    if (userIndex !== -1) {
      MOCK_DB.users[userIndex] = { ...MOCK_DB.users[userIndex], ...formData, updatedAt: new Date().toISOString() };
      addNotification('Profile updated successfully!', 'SUCCESS');
      logger.info(`User ${user.username} updated their profile.`);
    } else {
      addNotification('Failed to update profile: User not found.', 'ERROR');
      logger.error('Failed to update profile: User not found for update.', { userId: user.id });
    }
    setIsLoading(false);
    setIsEditing(false);
  }, [user, formData, validate, addNotification]);

  if (!user || !formData) return <Loader />;

  return (
    <div className="space-y-6">
      <h1 className="text-3xl font-bold">My Profile</h1>

      <Card title="Personal Information" headerActions={
        hasPermission('manage:own_profile') && (
          <Button variant="outline" onClick={() => setIsEditing(!isEditing)}>
            {isEditing ? 'Cancel Edit' : 'Edit Profile'}
          </Button>
        )
      }>
        <form className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <Input label="Username" value={formData.username || ''} disabled />
          <Input label="Email" name="email" value={formData.email || ''} onChange={handleChange} disabled={!isEditing || isLoading} error={errors.email} />
          <Input label="First Name" name="firstName" value={formData.firstName || ''} onChange={handleChange} disabled={!isEditing || isLoading} error={errors.firstName} />
          <Input label="Last Name" name="lastName" value={formData.lastName || ''} onChange={handleChange} disabled={!isEditing || isLoading} error={errors.lastName} />
          <Input label="Phone Number" name="phoneNumber" value={formData.phoneNumber || ''} onChange={handleChange} disabled={!isEditing || isLoading} />
          <Input label="Avatar URL" name="avatarUrl" value={formData.avatarUrl || ''} onChange={handleChange} disabled={!isEditing || isLoading} />

          <fieldset className="border p-4 rounded-md space-y-2 col-span-full dark:border-gray-700">
            <legend className="text-lg font-semibold px-2 dark:text-gray-200">Address</legend>
            <Input label="Street" name="address.street" value={formData.address?.street || ''} onChange={handleChange} disabled={!isEditing || isLoading} />
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Input label="City" name="address.city" value={formData.address?.city || ''} onChange={handleChange} disabled={!isEditing || isLoading} />
              <Input label="State" name="address.state" value={formData.address?.state || ''} onChange={handleChange} disabled={!isEditing || isLoading} />
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Input label="Zip Code" name="address.zip" value={formData.address?.zip || ''} onChange={handleChange} disabled={!isEditing || isLoading} />
              <Input label="Country" name="address.country" value={formData.address?.country || ''} onChange={handleChange} disabled={!isEditing || isLoading} />
            </div>
          </fieldset>

          {isEditing && (
            <div className="col-span-full flex justify-end space-x-2 pt-4">
              <Button type="button" variant="secondary" onClick={() => { setIsEditing(false); setFormData(user); setErrors({}); }} disabled={isLoading}>
                Cancel
              </Button>
              <Button type="button" variant="primary" onClick={handleSave} isLoading={isLoading}>
                Save Changes
              </Button>
            </div>
          )}
        </form>
      </Card>

      <Card title="Security & Roles">
        <p><strong>Roles:</strong> {user.roles.join(', ')}</p>
        <p><strong>Last Login:</strong> {formatDate(user.lastLogin, 'en-US', { dateStyle: 'medium', timeStyle: 'short' })}</p>
        <p className="mt-4">
          <Link to="/admin/security" className="text-blue-600 dark:text-blue-400 hover:underline">Manage Security Settings</Link>
        </p>
      </Card>

      <Card title="Preferences">
        <div className="flex justify-between items-center py-2 border-b border-gray-200 dark:border-gray-700">
          <span>Theme:</span>
          <Select
            id="pref-theme"
            name="theme"
            value={formData.preferences?.theme || 'system'}
            onChange={(e) => setFormData(prev => ({ ...prev, preferences: { ...prev?.preferences, theme: e.target.value as 'light' | 'dark' | 'system' } }))}
            options={[
              { value: 'light', label: 'Light' },
              { value: 'dark', label: 'Dark' },
              { value: 'system', label: 'System' },
            ]}
            disabled={!isEditing || isLoading}
          />
        </div>
        <div className="flex justify-between items-center py-2">
          <span>Language:</span>
          <Select
            id="pref-locale"
            name="locale"
            value={formData.preferences?.locale || 'en-US'}
            onChange={(e) => setFormData(prev => ({ ...prev, preferences: { ...prev?.preferences, locale: e.target.value } }))}
            options={[
              { value: 'en-US', label: 'English (US)' },
              { value: 'es-ES', label: 'Spanish (ES)' },
              { value: 'fr-FR', label: 'French (FR)' },
            ]}
            disabled={!isEditing || isLoading}
          />
        </div>
        <div className="flex justify-end mt-4">
          {isEditing && (
            <Button variant="primary" onClick={handleSave} isLoading={isLoading}>
              Save Preferences
            </Button>
          )}
        </div>
      </Card>
    </div>
  );
};


export const SettingsPage: React.FC = () => {
  const { user } = useAuth();
  const { theme, setTheme } = useTheme();
  const { addNotification } = useNotifications();

  const [localSettings, setLocalSettings] = useState({
    notificationSound: true,
    emailFrequency: 'DAILY',
    currencyDisplay: 'USD',
  });
  const [isSaving, setIsSaving] = useState(false);

  useEffect(() => {
    // In a real app, fetch user-specific settings from backend
    if (user) {
      setLocalSettings({
        notificationSound: true,
        emailFrequency: 'DAILY',
        currencyDisplay: user.preferences?.locale === 'en-US' ? 'USD' : 'EUR', // Example based on locale
      });
    }
  }, [user]);

  const handleSettingChange = useCallback((e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value, type, checked } = e.target as HTMLInputElement;
    setLocalSettings(prev => ({
      ...prev,
      [name]: type === 'checkbox' ? checked : value,
    }));
  }, []);

  const handleSaveSettings = useCallback(async () => {
    if (!user) {
      addNotification('Please log in to save settings.', 'ERROR');
      return;
    }
    setIsSaving(true);
    await new Promise(resolve => setTimeout(resolve, 1000)); // Simulate API call
    // In a real app, send `localSettings` to update user preferences in backend
    // Also update theme preference via context
    if (user.preferences?.theme !== theme || user.preferences?.locale !== 'en-US') { // Simple check, locale not directly managed here
      addNotification('User preferences updated on backend. (Simulated)', 'SUCCESS');
    }

    addNotification('Your settings have been saved.', 'SUCCESS');
    setIsSaving(false);
  }, [user, localSettings, theme, addNotification]);

  if (!user) return <ErrorMessage message="Please log in to view settings." />;

  return (
    <div className="space-y-6">
      <h1 className="text-3xl font-bold">User Settings</h1>

      <Card title="Theme & Display">
        <div className="flex justify-between items-center py-2">
          <span>Application Theme:</span>
          <Select
            id="app-theme"
            name="theme"
            value={theme}
            onChange={(e) => setTheme(e.target.value as 'light' | 'dark' | 'system')}
            options={[
              { value: 'light', label: 'Light' },
              { value: 'dark', label: 'Dark' },
              { value: 'system', label: 'System' },
            ]}
          />
        </div>
        <div className="flex justify-between items-center py-2">
          <span>Default Currency Display:</span>
          <Select
            id="currencyDisplay"
            name="currencyDisplay"
            value={localSettings.currencyDisplay}
            onChange={handleSettingChange}
            options={[
              { value: 'USD', label: 'USD - United States Dollar' },
              { value: 'EUR', label: 'EUR - Euro' },
              { value: 'GBP', label: 'GBP - British Pound' },
              { value: 'JPY', label: 'JPY - Japanese Yen' },
            ]}
          />
        </div>
      </Card>

      <Card title="Notification Preferences">
        <Checkbox
          label="Play sound for new notifications"
          id="notificationSound"
          name="notificationSound"
          checked={localSettings.notificationSound}
          onChange={handleSettingChange}
        />
        <div className="flex justify-between items-center py-2 mt-4">
          <span>Email Notification Frequency:</span>
          <Select
            id="emailFrequency"
            name="emailFrequency"
            value={localSettings.emailFrequency}
            onChange={handleSettingChange}
            options={[
              { value: 'INSTANT', label: 'Instant' },
              { value: 'DAILY', label: 'Daily Digest' },
              { value: 'WEEKLY', label: 'Weekly Summary' },
              { value: 'NONE', label: 'None' },
            ]}
          />
        </div>
        <p className="mt-2 text-sm text-gray-500 dark:text-gray-400">
          This setting controls how often you receive email updates about your account activity and system alerts.
        </p>
      </Card>

      <Card title="Privacy Settings">
        <Checkbox
          label="Allow personalized marketing communications"
          id="marketingComms"
          name="marketingComms"
          checked={true} // Mock default
          onChange={() => addNotification('This feature is a placeholder.', 'INFO')}
        />
        <Checkbox
          label="Share anonymized data for product improvement"
          id="shareData"
          name="shareData"
          checked={false} // Mock default
          onChange={() => addNotification('This feature is a placeholder.', 'INFO')}
        />
        <Button variant="danger" className="mt-4" onClick={() => addNotification('Deleting account feature initiated.', 'WARNING')}>
          Delete Account Permanently
        </Button>
      </Card>

      <div className="flex justify-end mt-6">
        <Button variant="primary" onClick={handleSaveSettings} isLoading={isSaving}>
          Save All Settings
        </Button>
      </div>
    </div>
  );
};


export const LoginPage: React.FC = () => {
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const { login, isAuthenticated, loading, error } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();
  const from = location.state?.from?.pathname || '/dashboard';
  const loginMessage = location.state?.message as string | undefined;

  useEffect(() => {
    if (isAuthenticated) {
      navigate(from, { replace: true });
    }
  }, [isAuthenticated, navigate, from]);

  const handleSubmit = useCallback(async (e: React.FormEvent) => {
    e.preventDefault();
    const success = await login(username, password);
    if (success) {
      navigate(from, { replace: true });
    }
  }, [login, username, password, navigate, from]);

  return (
    <div className="flex items-center justify-center min-h-screen bg-gray-100 dark:bg-gray-900">
      <Card title="Citibank Global Banking Portal Login" className="w-full max-w-md p-8">
        {loginMessage && <div className="bg-blue-100 dark:bg-blue-900 border-l-4 border-blue-500 text-blue-700 dark:text-blue-200 p-4 mb-4" role="alert"><p>{loginMessage}</p></div>}
        {error && <ErrorMessage message={error} className="mb-4" />}
        <form onSubmit={handleSubmit} className="space-y-6">
          <Input
            label="Username"
            id="username"
            name="username"
            type="text"
            value={username}
            onChange={(e) => setUsername(e.target.value)}
            required
            disabled={loading}
          />
          <Input
            label="Password"
            id="password"
            name="password"
            type="password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            required
            disabled={loading}
          />
          <Button type="submit" variant="primary" className="w-full" isLoading={loading}>
            Sign In
          </Button>
          <div className="text-center text-sm text-gray-600 dark:text-gray-400">
            <Link to="/forgot-password" className="text-blue-600 hover:underline dark:text-blue-400">Forgot password?</Link>
          </div>
        </form>
        <div className="mt-8 text-sm text-gray-500 dark:text-gray-400">
          <p>Demo Credentials:</p>
          <ul className="list-disc list-inside">
            <li>Admin: `admin` / (any password)</li>
            <li>Customer: `john.doe` / (any password)</li>
            <li>Auditor: `external.auditor` / (any password)</li>
          </ul>
          <p className="mt-4">
            By logging in, you agree to the <Link to="/terms" className="text-blue-600 hover:underline dark:text-blue-400">Terms of Service</Link> and <Link to="/privacy" className="text-blue-600 hover:underline dark:text-blue-400">Privacy Policy</Link>.
          </p>
        </div>
      </Card>
    </div>
  );
};

