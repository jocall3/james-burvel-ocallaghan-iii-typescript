export const AccountDetailsPage: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { addNotification } = useNotifications();
  const { user, hasPermission } = useAuth();
  const navigate = useNavigate();

  const [currentPage, setCurrentPage] = useState(1);
  const [pageSize] = useState(DEFAULT_PAGE_SIZE);
  const [afterCursor, setAfterCursor] = useState<string | null>(null);

  const account = MOCK_DB.accounts.find(acc => acc.id === id); // Find account from mock DB

  // Ensure user can access this account
  useEffect(() => {
    if (!account) {
      addNotification('Account not found.', 'ERROR');
      navigate('/accounts');
      return;
    }
    if (user && account.ownerId !== user.id && !hasPermission('read:all_accounts')) {
      addNotification('You do not have permission to view this account.', 'ERROR');
      navigate('/accounts');
    }
  }, [account, user, hasPermission, addNotification, navigate]);

  const graphqlQuery = gql`
    query GetAccountTransactions($accountId: ID!, $first: Int, $after: String) {
      accountTransactions(accountId: $accountId, first: $first, after: $after) {
        pageInfo {
          hasNextPage
          hasPreviousPage
          startCursor
          endCursor
        }
        edges {
          node {
            id
            transactionDate
            amount
            currency
            type
            status
            description
            referenceId
            merchantName
            category
          }
          cursor
        }
      }
    }
  `;

  const { data, loading, error, refetch } = useMockQuery<{ accountTransactions: IAccountGroupsConnection & { edges: { node: ITransaction, cursor: string }[] } }, { accountId: string; first: number; after?: string }>(
    graphqlQuery,
    {
      variables: { accountId: id!, first: pageSize, after: afterCursor || undefined },
      skip: !id || !account || (user && account.ownerId !== user.id && !hasPermission('read:all_accounts'))
    }
  );

  const transactions = data?.accountTransactions.edges.map(edge => edge.node) || [];
  const pageInfo = data?.accountTransactions.pageInfo;

  const handleNextPage = useCallback(() => {
    if (pageInfo?.hasNextPage && pageInfo.endCursor) {
      setAfterCursor(pageInfo.endCursor);
      setCurrentPage(prev => prev + 1);
    }
  }, [pageInfo]);

  const handlePreviousPage = useCallback(() => {
    // For simplicity with mock backend, going back clears cursor to refetch initial page
    // In a real app, you'd manage `before` cursors or use page numbers
    if (currentPage > 1) {
      setAfterCursor(null); // This would fetch from start
      setCurrentPage(1); // Reset to first page effectively for this mock, or implement true back navigation.
      // A more robust solution would keep track of previous cursors or use `before` parameter.
      addNotification('Previous page navigation is simplified in this demo. Real app would implement full cursor pagination.', 'INFO');
    }
  }, [currentPage, addNotification]);


  const transactionColumns: ITableColumn<ITransaction>[] = [
    { key: 'transactionDate', header: 'Date', sortable: true, render: (txn) => formatDate(txn.transactionDate, 'en-US', { dateStyle: 'short', timeStyle: 'short' }) },
    { key: 'description', header: 'Description', sortable: true },
    { key: 'merchantName', header: 'Merchant', sortable: true, render: (txn) => txn.merchantName || 'N/A' },
    { key: 'type', header: 'Type', sortable: true, render: (txn) => <span className={`font-semibold ${txn.type === 'DEBIT' ? 'text-red-600 dark:text-red-400' : 'text-green-600 dark:text-green-400'}`}>{txn.type}</span> },
    { key: 'amount', header: 'Amount', sortable: true, render: (txn) => formatCurrency(txn.amount, txn.currency) },
    { key: 'status', header: 'Status', sortable: true, render: (txn) => <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${txn.status === 'CLEARED' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'}`}>{txn.status}</span> },
  ];

  if (!account) return null; // Handled by useEffect redirect
  if (loading && !data) return <Loader />;
  if (error) return <ErrorMessage message={error.message} />;

  return (
    <div className="space-y-6">
      <h1 className="text-3xl font-bold">Account Details: {account.accountName} ({account.accountNumber})</h1>
      <Button variant="outline" onClick={() => navigate('/accounts')}>← Back to Accounts</Button>

      <Card title="Account Summary">
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-gray-700 dark:text-gray-300">
          <div>
            <p><strong>Account Type:</strong> {account.accountType.replace(/_/g, ' ')}</p>
            <p><strong>Current Balance:</strong> <span className="font-semibold text-green-600 dark:text-green-400">{formatCurrency(account.currentBalance, account.currency)}</span></p>
            <p><strong>Available Balance:</strong> <span className="font-semibold text-green-600 dark:text-green-400">{formatCurrency(account.availableBalance, account.currency)}</span></p>
            {account.creditLimit && <p><strong>Credit Limit:</strong> {formatCurrency(account.creditLimit, account.currency)}</p>}
            {account.outstandingBalance && <p><strong>Outstanding Balance:</strong> {formatCurrency(account.outstandingBalance, account.currency)}</p>}
          </div>
          <div>
            <p><strong>Status:</strong> <span className={`font-semibold ${account.status === 'ACTIVE' ? 'text-green-600' : 'text-red-600'}`}>{account.status}</span></p>
            <p><strong>Created At:</strong> {formatDate(account.createdAt, 'en-US', { dateStyle: 'medium' })}</p>
            <p><strong>Last Activity:</strong> {formatDate(account.lastActivity, 'en-US', { dateStyle: 'medium', timeStyle: 'short' })}</p>
            <p><strong>Branch:</strong> {MOCK_DB.branches.find(b => b.id === account.branchId)?.name || 'N/A'}</p>
          </div>
        </div>
        <div className="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 flex justify-end space-x-2">
          {hasPermission('initiate:transfer') && <Button variant="primary">Make Transfer</Button>}
          {hasPermission('pay:bill') && <Button variant="secondary">Pay Bill</Button>}
        </div>
      </Card>

      <Card title="Transaction History">
        <Table<ITransaction>
          data={transactions}
          columns={transactionColumns}
          isLoading={loading}
          error={error ? error.message : undefined}
          enablePagination={false} // Handled by custom pagination for cursor-based
          enableSorting={true}
          pageSize={pageSize}
        />
        <div className="flex justify-between items-center py-4">
          <Button
            variant="outline"
            onClick={handlePreviousPage}
            disabled={!pageInfo?.hasPreviousPage || loading}
          >
            Previous
          </Button>
          <span className="text-sm text-gray-700 dark:text-gray-300">
            Page {currentPage} (mock)
          </span>
          <Button
            variant="outline"
            onClick={handleNextPage}
            disabled={!pageInfo?.hasNextPage || loading}
          >
            Next
          </Button>
        </div>
      </Card>
    </div>
  );
};

export const TransactionsPage: React.FC = () => {
  const { user, hasPermission } = useAuth();
  const navigate = useNavigate();

  const [filterAccount, setFilterAccount] = useState<string>('ALL');
  const [filterType, setFilterType] = useState<TransactionType | 'ALL'>('ALL');
  const [filterStatus, setFilterStatus] = useState<TransactionStatus | 'ALL'>('ALL');
  const [startDate, setStartDate] = useState<Date | null>(null);
  const [endDate, setEndDate] = useState<Date | null>(null);

  const allAccountsForUser = useMemo(() => {
    if (!user) return [];
    return MOCK_DB.accounts.filter(acc => acc.ownerId === user.id || hasPermission('read:all_accounts'));
  }, [user, hasPermission]);

  const allTransactions = useMemo(() => {
    let txns = MOCK_DB.transactions;
    if (user && !hasPermission('read:all_accounts')) {
      const userAccountIds = allAccountsForUser.map(acc => acc.id);
      txns = txns.filter(txn => userAccountIds.includes(txn.accountId));
    }
    return txns;
  }, [user, hasPermission, allAccountsForUser]);

  const filteredTransactions = useMemo(() => {
    let result = allTransactions;

    if (filterAccount !== 'ALL') {
      result = result.filter(txn => txn.accountId === filterAccount);
    }
    if (filterType !== 'ALL') {
      result = result.filter(txn => txn.type === filterType);
    }
    if (filterStatus !== 'ALL') {
      result = result.filter(txn => txn.status === filterStatus);
    }
    if (startDate) {
      result = result.filter(txn => new Date(txn.transactionDate) >= startDate);
    }
    if (endDate) {
      result = result.filter(txn => new Date(txn.transactionDate) <= endDate);
    }

    return result.sort((a, b) => new Date(b.transactionDate).getTime() - new Date(a.transactionDate).getTime());
  }, [allTransactions, filterAccount, filterType, filterStatus, startDate, endDate]);


  const transactionColumns: ITableColumn<ITransaction>[] = [
    { key: 'transactionDate', header: 'Date', sortable: true, render: (txn) => formatDate(txn.transactionDate, 'en-US', { dateStyle: 'short', timeStyle: 'short' }) },
    { key: 'description', header: 'Description', sortable: true },
    { key: 'account', header: 'Account', sortable: false, render: (txn) => {
        const acc = MOCK_DB.accounts.find(a => a.id === txn.accountId);
        return acc ? <Link to={`/accounts/${acc.id}`} className="text-blue-600 dark:text-blue-400 hover:underline">{acc.accountName}</Link> : 'N/A';
      }
    },
    { key: 'type', header: 'Type', sortable: true, render: (txn) => <span className={`font-semibold ${txn.type === 'DEBIT' ? 'text-red-600 dark:text-red-400' : 'text-green-600 dark:text-green-400'}`}>{txn.type}</span> },
    { key: 'amount', header: 'Amount', sortable: true, render: (txn) => formatCurrency(txn.amount, txn.currency) },
    { key: 'status', header: 'Status', sortable: true, render: (txn) => <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${txn.status === 'CLEARED' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'}`}>{txn.status}</span> },
    {
      key: 'actions', header: 'Actions', render: (txn) => (
        <Button variant="secondary" size="small" onClick={() => addNotification(`Viewing transaction ${txn.id} details`, 'INFO')}>Details</Button>
      )
    },
  ];

  const handleDateChange = (date: Date | null, type: 'start' | 'end') => {
    if (type === 'start') setStartDate(date);
    else setEndDate(date);
  };

  return (
    <div className="space-y-6">
      <h1 className="text-3xl font-bold">Transaction History</h1>

      <div className="flex flex-wrap gap-4 items-end mb-4 p-4 bg-white dark:bg-gray-800 rounded-lg shadow-md">
        <Select
          id="filter-txn-account"
          label="Account"
          value={filterAccount}
          onChange={(e) => setFilterAccount(e.target.value)}
          options={[
            { value: 'ALL', label: 'All Accounts' },
            ...allAccountsForUser.map(acc => ({ value: acc.id, label: `${acc.accountName} (${acc.accountNumber})` }))
          ]}
          className="w-full sm:w-64"
        />
        <Select
          id="filter-txn-type"
          label="Type"
          value={filterType}
          onChange={(e) => setFilterType(e.target.value as TransactionType | 'ALL')}
          options={[
            { value: 'ALL', label: 'All Types' },
            ...(['DEBIT', 'CREDIT', 'TRANSFER', 'PAYMENT', 'FEE', 'INTEREST'] as TransactionType[]).map(type => ({ value: type, label: type.replace(/_/g, ' ') }))
          ]}
          className="w-full sm:w-48"
        />
        <Select
          id="filter-txn-status"
          label="Status"
          value={filterStatus}
          onChange={(e) => setFilterStatus(e.target.value as TransactionStatus | 'ALL')}
          options={[
            { value: 'ALL', label: 'All Statuses' },
            ...(['PENDING', 'CLEARED', 'REVERSED', 'FAILED'] as TransactionStatus[]).map(status => ({ value: status, label: status.replace(/_/g, ' ') }))
          ]}
          className="w-full sm:w-48"
        />
        <div className="flex flex-col">
          <label htmlFor="start-date" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Start Date</label>
          <input
            type="date"
            id="start-date"
            className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"
            value={startDate ? startDate.toISOString().split('T')[0] : ''}
            onChange={(e) => handleDateChange(e.target.value ? new Date(e.target.value) : null, 'start')}
          />
        </div>
        <div className="flex flex-col">
          <label htmlFor="end-date" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">End Date</label>
          <input
            type="date"
            id="end-date"
            className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"
            value={endDate ? endDate.toISOString().split('T')[0] : ''}
            onChange={(e) => handleDateChange(e.target.value ? new Date(e.target.value) : null, 'end')}
          />
        </div>
        <Button variant="outline" onClick={() => {
          setFilterAccount('ALL'); setFilterType('ALL'); setFilterStatus('ALL'); setStartDate(null); setEndDate(null);
        }}>Clear Filters</Button>
      </div>

      <Card>
        <Table<ITransaction>
          data={filteredTransactions}
          columns={transactionColumns}
          enablePagination={true}
          enableSorting={true}
          enableFiltering={false}
          pageSize={DEFAULT_PAGE_SIZE}
        />
      </Card>
    </div>
  );
};

export const UserManagementPage: React.FC = () => {
  const { hasRole, hasPermission, user: currentUser } = useAuth();
  const { addNotification } = useNotifications();
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isEditModalOpen, setIsEditModalOpen] = useState(false);
  const [selectedUser, setSelectedUser] = useState<IUser | null>(null);

  const { data: usersData, loading: usersLoading, error: usersError, refetch: refetchUsers } = useMockQuery<{ user: IUser[] }>(
    gql`query GetUsers { users { id username email firstName lastName roles lastLogin status } }`,
    {
      variables: {}, // No specific variables for all users in mock
      skip: !hasRole('ADMIN') && !hasPermission('read:user_management'),
      pollInterval: 1000 * 60, // Refresh user list every minute
    }
  );

  const users = usersData?.user || MOCK_DB.users; // Fallback to raw mock DB if query skips

  const handleUserUpdate = useCallback(async (userId: string, updatedFields: Partial<IUser>) => {
    if (!hasPermission('update:user_management')) {
      addNotification('Unauthorized to update users.', 'ERROR');
      return;
    }
    const userIndex = MOCK_DB.users.findIndex(u => u.id === userId);
    if (userIndex !== -1) {
      MOCK_DB.users[userIndex] = { ...MOCK_DB.users[userIndex], ...updatedFields, updatedAt: new Date().toISOString() };
      addNotification(`User ${MOCK_DB.users[userIndex].username} updated successfully.`, 'SUCCESS');
      refetchUsers();
      setIsEditModalOpen(false);
      setSelectedUser(null);
    } else {
      addNotification('User not found for update.', 'ERROR');
    }
  }, [addNotification, hasPermission, refetchUsers]);

  const handleUserDelete = useCallback(async (userId: string, username: string) => {
    if (!hasPermission('delete:user_management')) {
      addNotification('Unauthorized to delete users.', 'ERROR');
      return;
    }
    if (currentUser?.id === userId) {
      addNotification('Cannot delete your own user account.', 'ERROR');
      return;
    }
    if (!window.confirm(`Are you sure you want to delete user "${username}"? This action cannot be undone.`)) return;

    MOCK_DB.users = MOCK_DB.users.filter(u => u.id !== userId);
    addNotification(`User "${username}" deleted successfully.`, 'SUCCESS');
    refetchUsers();
  }, [addNotification, hasPermission, currentUser, refetchUsers]);


  const userColumns: ITableColumn<IUser>[] = useMemo(() => [
    { key: 'username', header: 'Username', sortable: true },
    { key: 'firstName', header: 'First Name', sortable: true },
    { key: 'lastName', header: 'Last Name', sortable: true },
    { key: 'email', header: 'Email', sortable: true },
    { key: 'roles', header: 'Roles', render: (user) => user.roles.join(', ') },
    { key: 'status', header: 'Status', sortable: true, render: (user) => <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${user.status === 'ACTIVE' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'}`}>{user.status}</span> },
    { key: 'lastLogin', header: 'Last Login', sortable: true, render: (user) => formatDate(user.lastLogin, 'en-US', { dateStyle: 'short', timeStyle: 'short' }) },
    {
      key: 'actions',
      header: 'Actions',
      render: (user) => (
        <div className="flex space-x-2">
          {hasPermission('update:user_management') && (
            <Button variant="secondary" size="small" onClick={(e) => { e.stopPropagation(); setSelectedUser(user); setIsEditModalOpen(true); }}>Edit</Button>
          )}
          {hasPermission('delete:user_management') && (
            <Button variant="danger" size="small" onClick={(e) => { e.stopPropagation(); handleUserDelete(user.id, user.username); }}>Delete</Button>
          )}
        </div>
      )
    },
  ], [hasPermission, handleUserDelete]);

  if (!hasRole('ADMIN') && !hasPermission('read:user_management')) {
    return <ErrorMessage message="You do not have permission to view User Management." />;
  }
  if (usersLoading) return <Loader />;
  if (usersError) return <ErrorMessage message={usersError.message} />;


  return (
    <div className="space-y-6">
      <h1 className="text-3xl font-bold">User Management</h1>

      <div className="flex justify-end mb-4">
        {hasPermission('create:user') && (
          <Button variant="primary" onClick={() => setIsModalOpen(true)}>
            Add New User
          </Button>
        )}
      </div>

      <Card>
        <Table<IUser>
          data={users}
          columns={userColumns}
          enablePagination={true}
          enableSorting={true}
          enableFiltering={true}
          pageSize={DEFAULT_PAGE_SIZE}
          filterFields={['username', 'firstName', 'lastName', 'email', 'roles']}
        />
      </Card>

      <Modal
        isOpen={isModalOpen}
        onClose={() => setIsModalOpen(false)}
        title="Add New User"
      >
        <UserForm
          onSubmit={(newUser) => {
            const createdUser: IUser = {
              ...newUser,
              id: generateUniqueId(),
              createdAt: new Date().toISOString(),
              lastLogin: '',
              status: 'ACTIVE',
              permissions: newUser.roles.includes('ADMIN') ? ['*'] : [], // Simple permission logic
            };
            MOCK_DB.users.push(createdUser);
            addNotification(`User ${newUser.username} created.`, 'SUCCESS');
            refetchUsers();
            setIsModalOpen(false);
          }}
          onCancel={() => setIsModalOpen(false)}
          isLoading={false} // No direct loading for mock create
          initialValues={{ username: '', email: '', firstName: '', lastName: '', roles: ['CUSTOMER'] }}
        />
      </Modal>

      <Modal
        isOpen={isEditModalOpen}
        onClose={() => { setIsEditModalOpen(false); setSelectedUser(null); }}
        title={`Edit User: ${selectedUser?.username || ''}`}
      >
        {selectedUser && (
          <UserForm
            onSubmit={(updatedFields) => handleUserUpdate(selectedUser.id, updatedFields)}
            onCancel={() => { setIsEditModalOpen(false); setSelectedUser(null); }}
            isLoading={false}
            initialValues={selectedUser}
            isEdit={true}
          />
        )}
      </Modal>
    </div>
  );
};

interface IUserFormProps {
  onSubmit: (user: Partial<IUser>) => void;
  onCancel: () => void;
  isLoading: boolean;
  initialValues: Partial<IUser>;
  isEdit?: boolean;
}

export const UserForm: React.FC<IUserFormProps> = ({ onSubmit, onCancel, isLoading, initialValues, isEdit = false }) => {
  const [formData, setFormData] = useState<Partial<IUser>>(initialValues);
  const [errors, setErrors] = useState<Record<string, string>>({});

  useEffect(() => {
    setFormData(initialValues);
  }, [initialValues]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
    setErrors(prev => ({ ...prev, [name]: '' }));
  };

  const handleRolesChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const selectedOptions = Array.from(e.target.selectedOptions, option => option.value as UserRole);
    setFormData(prev => ({ ...prev, roles: selectedOptions }));
  };

  const validate = () => {
    const newErrors: Record<string, string> = {};
    if (!formData.username?.trim()) newErrors.username = 'Username is required.';
    if (!formData.firstName?.trim()) newErrors.firstName = 'First Name is required.';
    if (!formData.lastName?.trim()) newErrors.lastName = 'Last Name is required.';
    if (!formData.email?.trim() || !validateEmail(formData.email)) newErrors.email = 'Valid Email is required.';
    if (!formData.roles || formData.roles.length === 0) newErrors.roles = 'At least one role is required.';
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (validate()) {
      onSubmit(formData);
    }
  };

  const allRoles: UserRole[] = ['ADMIN', 'MANAGER', 'CUSTOMER_SERVICE', 'CUSTOMER', 'EXTERNAL_AUDITOR'];

  return (
    <form onSubmit={handleSubmit} className="space-y-4 p-4 dark:bg-gray-800 rounded-lg">
      <Input label="Username" id="username" name="username" value={formData.username || ''} onChange={handleChange} error={errors.username} required disabled={isLoading || isEdit} />
      <Input label="First Name" id="firstName" name="firstName" value={formData.firstName || ''} onChange={handleChange} error={errors.firstName} required disabled={isLoading} />
      <Input label="Last Name" id="lastName" name="lastName" value={formData.lastName || ''} onChange={handleChange} error={errors.lastName} required disabled={isLoading} />
      <Input label="Email" id="email" name="email" type="email" value={formData.email || ''} onChange={handleChange} error={errors.email} required disabled={isLoading} />
      <Select
        label="Roles (Select multiple)"
        id="roles"
        name="roles"
        multiple={true}
        value={formData.roles || []}
        onChange={handleRolesChange}
        options={allRoles.map(role => ({ value: role, label: role.replace(/_/g, ' ') }))}
        error={errors.roles}
        required
        disabled={isLoading}
        className="h-28"
      />
      {isEdit && (
        <Select
          label="Status"
          id="status"
          name="status"
          value={formData.status || 'ACTIVE'}
          onChange={handleChange}
          options={['ACTIVE', 'INACTIVE', 'LOCKED'].map(s => ({ value: s, label: s }))}
          disabled={isLoading}
        />
      )}
      <div className="flex justify-end space-x-2 pt-4">
        <Button type="button" variant="secondary" onClick={onCancel} disabled={isLoading}>
          Cancel
        </Button>
        <Button type="submit" variant="primary" isLoading={isLoading}>
          {isEdit ? 'Save Changes' : 'Create User'}
        </Button>
      </div>
    </form>
  );
};

export const ReportsPage: React.FC = () => {
  const { hasPermission } = useAuth();
  const { addNotification } = useNotifications();
  const [reportConfig, setReportConfig] = useState<Partial<IReportConfiguration>>({
    name: '',
    reportType: 'TRANSACTIONS',
    parameters: { startDate: new Date().toISOString().split('T')[0], endDate: new Date().toISOString().split('T')[0] },
  });
  const [generatedReport, setGeneratedReport] = useState<any>(null);
  const [loadingReport, setLoadingReport] = useState(false);
  const [errorReport, setErrorReport] = useState<string | null>(null);

  const reportTypes = [
    { value: 'TRANSACTIONS', label: 'Transaction Summary' },
    { value: 'ACCOUNT_BALANCES', label: 'Account Balances' },
    { value: 'ACCOUNT_GROUPS', label: 'Account Group Overview' },
    { value: 'USER_ACTIVITY', label: 'User Activity Log' },
  ];

  const handleConfigChange = useCallback((e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    if (name === 'reportType') {
      setReportConfig(prev => ({ ...prev, reportType: value as IReportConfiguration['reportType'], parameters: {} }));
    } else {
      setReportConfig(prev => ({ ...prev, [name]: value }));
    }
  }, []);

  const handleParameterChange = useCallback((paramName: string, value: any) => {
    setReportConfig(prev => ({
      ...prev,
      parameters: { ...prev.parameters, [paramName]: value },
    }));
  }, []);

  const generateReport = useCallback(async () => {
    if (!hasPermission('generate:reports')) {
      addNotification('Unauthorized to generate reports.', 'ERROR');
      return;
    }
    if (!reportConfig.name || !reportConfig.reportType) {
      setErrorReport('Report Name and Type are required.');
      return;
    }

    setLoadingReport(true);
    setGeneratedReport(null);
    setErrorReport(null);

    await new Promise(resolve => setTimeout(resolve, Math.random() * 2000 + 1000)); // Simulate generation time

    try {
      let reportData: any = {};
      switch (reportConfig.reportType) {
        case 'TRANSACTIONS':
          reportData = MOCK_DB.transactions.filter(txn => {
            const txnDate = new Date(txn.transactionDate).toISOString().split('T')[0];
            return txnDate >= (reportConfig.parameters?.startDate || '1970-01-01') && txnDate <= (reportConfig.parameters?.endDate || new Date().toISOString().split('T')[0]);
          }).slice(0, 100); // Limit mock report size
          break;
        case 'ACCOUNT_BALANCES':
          reportData = MOCK_DB.accounts.map(acc => ({
            accountName: acc.accountName,
            accountNumber: acc.accountNumber,
            type: acc.accountType,
            balance: formatCurrency(acc.currentBalance, acc.currency),
            owner: MOCK_DB.users.find(u => u.id === acc.ownerId)?.username || 'N/A',
          })).slice(0, 50);
          break;
        case 'ACCOUNT_GROUPS':
          reportData = MOCK_DB.accountGroups.map(group => ({
            groupName: group.name,
            status: group.status,
            riskScore: group.riskScore,
            accountCount: MOCK_DB.accounts.filter(acc => acc.groupIds.includes(group.id)).length,
          })).slice(0, 50);
          break;
        case 'USER_ACTIVITY':
          reportData = MOCK_DB.auditLogs.filter(log => {
            const logDate = new Date(log.timestamp).toISOString().split('T')[0];
            return logDate >= (reportConfig.parameters?.startDate || '1970-01-01') && logDate <= (reportConfig.parameters?.endDate || new Date().toISOString().split('T')[0]);
          }).slice(0, 100);
          break;
        default:
          setErrorReport('Unknown report type.');
          break;
      }
      setGeneratedReport({
        id: generateUniqueId(),
        config: reportConfig,
        generatedAt: new Date().toISOString(),
        data: reportData,
        summary: `Generated ${reportData.length} records for ${reportConfig.reportType}.`
      });
      addNotification(`Report "${reportConfig.name}" generated successfully.`, 'SUCCESS');
    } catch (err: any) {
      setErrorReport(err.message || 'Error generating report.');
      logger.error('Report generation error', { config: reportConfig, error: err });
    } finally {
      setLoadingReport(false);
    }
  }, [reportConfig, addNotification, hasPermission]);

  if (!hasPermission('generate:reports')) {
    return <ErrorMessage message="You do not have permission to access Reports." />;
  }

  return (
    <div className="space-y-6">
      <h1 className="text-3xl font-bold">Reports & Analytics</h1>

      <Card title="Generate New Report">
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <Input
            label="Report Name"
            id="report-name"
            name="name"
            value={reportConfig.name || ''}
            onChange={handleConfigChange}
            required
            disabled={loadingReport}
          />
          <Select
            label="Report Type"
            id="report-type"
            name="reportType"
            value={reportConfig.reportType || 'TRANSACTIONS'}
            onChange={handleConfigChange}
            options={reportTypes}
            required
            disabled={loadingReport}
          />
        </div>
        <div className="mt-4 border-t border-gray-200 dark:border-gray-700 pt-4 space-y-4">
          <h3 className="font-semibold text-lg">Report Parameters</h3>
          {reportConfig.reportType === 'TRANSACTIONS' || reportConfig.reportType === 'USER_ACTIVITY' ? (
            <div className="flex flex-wrap gap-4">
              <div className="flex flex-col">
                <label htmlFor="param-start-date" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Start Date</label>
                <input
                  type="date"
                  id="param-start-date"
                  className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                  value={reportConfig.parameters?.startDate || ''}
                  onChange={(e) => handleParameterChange('startDate', e.target.value)}
                  disabled={loadingReport}
                />
              </div>
              <div className="flex flex-col">
                <label htmlFor="param-end-date" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">End Date</label>
                <input
                  type="date"
                  id="param-end-date"
                  className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                  value={reportConfig.parameters?.endDate || ''}
                  onChange={(e) => handleParameterChange('endDate', e.target.value)}
                  disabled={loadingReport}
                />
              </div>
            </div>
          ) : (
            <p className="text-gray-500 dark:text-gray-400">No specific parameters for this report type.</p>
          )}
        </div>
        {errorReport && <ErrorMessage message={errorReport} className="mt-4" />}
        <div className="flex justify-end mt-6">
          <Button variant="primary" onClick={generateReport} isLoading={loadingReport} disabled={!reportConfig.name || !reportConfig.reportType}>
            Generate Report
          </Button>
        </div>
      </Card>

      {generatedReport && (
        <Card title={`Report: ${generatedReport.config.name}`} className="mt-6">
          <p className="text-sm text-gray-500 dark:text-gray-400 mb-2">Generated At: {formatDate(generatedReport.generatedAt, 'en-US', { dateStyle: 'medium', timeStyle: 'short' })}</p>
          <p className="font-semibold mb-4">{generatedReport.summary}</p>
          <div className="max-h-96 overflow-auto bg-gray-50 dark:bg-gray-700 p-4 rounded-md">
            <pre className="text-sm text-gray-800 dark:text-gray-200">{JSON.stringify(generatedReport.data, null, 2)}</pre>
          </div>
          <div className="flex justify-end mt-4 space-x-2">
            <Button variant="secondary" onClick={() => addNotification('Report export initiated (CSV).', 'INFO')}>Export CSV</Button>
            <Button variant="secondary" onClick={() => addNotification('Report export initiated (PDF).', 'INFO')}>Export PDF</Button>
            <Button variant="success" onClick={() => addNotification('Report scheduled for email delivery.', 'INFO')}>Schedule Email</Button>
          </div>
        </Card>
      )}

      <Card title="Saved Report Configurations">
        <Table
          data={MOCK_DB.reports} // Mock saved reports
          columns={[
            { key: 'name', header: 'Report Name' },
            { key: 'reportType', header: 'Type' },
            { key: 'createdBy', header: 'Created By', render: (rep) => MOCK_DB.users.find(u => u.id === rep.createdBy)?.username || 'N/A' },
            { key: 'createdAt', header: 'Created At', render: (rep) => formatDate(rep.createdAt, 'en-US', { dateStyle: 'short' }) },
            { key: 'lastRun', header: 'Last Run', render: (rep) => rep.lastRun ? formatDate(rep.lastRun, 'en-US', { dateStyle: 'short' }) : 'Never' },
            {
              key: 'actions', header: 'Actions', render: (rep) => (
                <div className="space-x-2">
                  <Button size="small" variant="primary" onClick={() => { setReportConfig(rep); addNotification('Loaded report configuration.', 'INFO'); }}>Load</Button>
                  <Button size="small" variant="secondary" onClick={() => addNotification(`Running saved report ${rep.name}`, 'INFO')}>Run</Button>
                  {hasPermission('delete:reports') && <Button size="small" variant="danger" onClick={() => addNotification(`Deleting report ${rep.name}`, 'WARNING')}>Delete</Button>}
                </div>
              )
            },
          ]}
          enablePagination={true}
          enableSorting={true}
          pageSize={5}
        />
      </Card>
    </div>
  );
};


