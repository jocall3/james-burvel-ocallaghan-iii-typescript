    { key: 'lastActivity', header: 'Last Activity', sortable: true, render: (acc) => formatDate(acc.lastActivity, 'en-US', { dateStyle: 'short' }) },
    {
      key: 'actions',
      header: 'Actions',
      render: (acc) => (
