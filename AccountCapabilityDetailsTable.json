// --- Dynamic Content Renderer (Handles DisplayColumn logic) ---

export interface DynamicCellValueProps {
  column: DisplayColumn;
  data: AccountCapability | Record<string, any>; // Data for the current row/object
  onAssociationClick?: (entityType: string, id: string) => void;
  onLinkClick?: (href: string, openNewTab?: boolean) => void;
}

export const DynamicCellValue: React.FC<DynamicCellValueProps> = ({ column, data, onAssociationClick, onLinkClick }) => {
  const value = (data as any)[column.id]; // Access data by column ID (field name)

  if (column.viewOptions?.detailsTable?.hideIfNull && (value === null || value === undefined || value === '')) {
    return <span className="text-gray-400 italic">N/A</span>;
  }

  // Handle specific displayTypeOptions
  const displayOptions = column.displayTypeOptions;

  if (!displayOptions) {
    return <DefaultCellValue value={value} columnType={column.type} />;
  }

  switch (displayOptions.typename) {
    case 'AssociationOption':
    case 'AssociationListOption': {
      const associatedEntity = value; // Assume value is the associated entity object
      if (!associatedEntity) return <span className="text-gray-400 italic">None</span>;

      const labelField = displayOptions.associatedEntityLabelField;
      const entityLabel = associatedEntity[labelField] || associatedEntity.bestName || 'Unknown Entity';
      const entityId = associatedEntity.id;
      const entityType = associatedEntity.typename; // Assuming typename exists on associated entity

      const handleClick = () => {
        if (displayOptions.drawerEnabled && onAssociationClick && entityId && entityType) {
          onAssociationClick(entityType, entityId);
        } else if (displayOptions.linkEnabled && associatedEntity.path && onLinkClick) {
          onLinkClick(associatedEntity.path);
        }
      };

      const linkClasses = (displayOptions.drawerEnabled || displayOptions.linkEnabled) ? "text-blue-600 hover:underline cursor-pointer" : "";

      if (Array.isArray(associatedEntity) && displayOptions.typename === 'AssociationListOption') {
        return (
          <div className="flex flex-wrap gap-1">
            {associatedEntity.map((item: any, index: number) => (
              <span key={index} className={`bg-blue-50 text-blue-800 text-xs font-medium mr-1 px-2.5 py-0.5 rounded ${linkClasses}`} onClick={handleClick}>
                {item[labelField] || item.bestName || 'Unknown'}
              </span>
            ))}
          </div>
        );
      }
      return (
        <span className={linkClasses} onClick={handleClick}>
          {entityLabel}
        </span>
      );
    }
    case 'PolymorphicAssociationOption': {
      // For polymorphic associations, the value might be an array or a single object.
      // We assume it's an object with a `typename` to determine the actual type.
      const entity = value;
      if (!entity) return <span className="text-gray-400 italic">None</span>;
      const entityType = entity.typename;
      const entityName = entity.bestName || entity.name || entity.id; // Fallback to common name fields
      const entityId = entity.id;

      const handleClick = () => {
        if (displayOptions.drawerEnabled && onAssociationClick && entityId && entityType) {
          onAssociationClick(entityType, entityId);
        } else if (displayOptions.stackedDrawerEnabled && onAssociationClick && entityId && entityType) {
          onAssociationClick(entityType, entityId); // Or a different handler for stacked
        }
      };
      const linkClasses = (displayOptions.drawerEnabled || displayOptions.stackedDrawerEnabled) ? "text-blue-600 hover:underline cursor-pointer" : "";
      return (
        <span className={linkClasses} onClick={handleClick}>
          {displayOptions.associationPrefix ? `${displayOptions.associationPrefix}: ` : ''}{entityName} ({entityType})
        </span>
      );
    }
    case 'AuditableJSONOption': {
      const auditableData = (data as any)[displayOptions.auditableFieldName];
      // In a real app, this would display the JSON with an "audit history" button
      return (
        <Tooltip content="Click to view audit history and details">
          <Button variant="ghost" className="text-blue-600 text-sm py-1 px-2" onClick={() => alert(`Showing audit for ${column.label}`)}>View JSON</Button>
        </Tooltip>
      );
    }
    case 'CountdownOption': {
      const targetDate = dayjs(value);
      if (!targetDate.isValid()) return <span className="text-gray-400 italic">Invalid Date</span>;
      const now = dayjs();
      if (targetDate.isBefore(now)) {
        return <span className="text-red-600">{targetDate.fromNow()} (Past)</span>;
      }
      return <span className="text-green-700">{targetDate.fromNow()}</span>;
    }
    case 'LabelWithCountOption': {
      const count = (data as any)[displayOptions.countField];
      const prettyCount = (data as any)[displayOptions.prettyCountField] || count;
      return (
        <span className="flex items-baseline">
          {displayOptions.truncateMiddle ? <Tooltip content={value}>{value}</Tooltip> : value}
          {count !== undefined && count !== null && <span className="ml-1 text-xs text-gray-500">({prettyCount})</span>}
        </span>
      );
    }
    case 'AmountDifferenceOption': {
      const differenceAmount = (data as any)[displayOptions.highlightAmountDifferenceField];
      if (typeof differenceAmount !== 'number') return <DefaultCellValue value={value} columnType={column.type} />;
      const colorClass = differenceAmount > 0 ? 'text-green-600' : (differenceAmount < 0 ? 'text-red-600' : 'text-gray-600');
      return <span className={colorClass}>{value} ({differenceAmount.toLocaleString('en-US', APP_CONFIG.CURRENCY_FORMAT_OPTIONS)})</span>;
    }
    case 'StatusIndicatorOption': {
      const status = (data as any)[displayOptions.statusIndicatorCurrentStatusField];
      const descriptor = (data as any)[displayOptions.statusIndicatorDescriptorField];
      const verbose = (data as any)[displayOptions.statusIndicatorVerboseField];
      let statusColor = 'gray'; // Default
      switch (status?.toUpperCase()) {
        case 'ACTIVE': statusColor = 'green'; break;
        case 'PENDING': statusColor = 'yellow'; break;
        case 'REJECTED': statusColor = 'red'; break;
        case 'INACTIVE': statusColor = 'red'; break;
        case 'COMPLETED': statusColor = 'blue'; break;
        // Add more statuses as needed
      }
      return (
        <Tooltip content={verbose || descriptor || status}>
          <Tag label={status || 'Unknown'} color={`bg-${statusColor}-100`} className={`text-${statusColor}-800 border border-${statusColor}-300`} />
        </Tooltip>
      );
    }
    case 'TagOption': {
      const tagColor = (data as any)[displayOptions.tagColorField];
      const tagIcon = (data as any)[displayOptions.tagIconField];
      return <Tag label={String(value)} color={tagColor} icon={tagIcon} />;
    }
    case 'TagButtonListOption': {
      const tags = Array.isArray(value) ? value : (value ? [value] : []);
      const colors = (data as any)[displayOptions.tagButtonColorsField] || [];
      const icons = (data as any)[displayOptions.tagButtonIconsField] || [];
      const hrefs = (data as any)[displayOptions.tagButtonHrefsField] || [];
      const tooltips = (data as any)[displayOptions.tagButtonTooltipsField] || [];

      return (
        <div className="flex flex-wrap gap-1">
          {tags.map((tag: string, index: number) => (
            <Tooltip key={index} content={tooltips[index] || tag}>
              <Button
                variant="ghost"
                className={`text-sm px-2 py-1 ${colors[index] || 'bg-gray-100 text-gray-800'}`}
                onClick={() => hrefs[index] && onLinkClick && onLinkClick(hrefs[index], true)}
              >
                {icons[index] && <i className={`${icons[index]} mr-1`}></i>}{tag}
              </Button>
            </Tooltip>
          ))}
        </div>
      );
    }
    case 'AuditableTextOption': {
      const fullText = (data as any)[displayOptions.fullField];
      const defaultText = (data as any)[displayOptions.fieldAsDefaultText] || value;
      const displayValue = defaultText; // Might truncate `fullText` for display
      return (
        <Tooltip content={fullText}>
          <span className={`${displayOptions.copyable ? 'cursor-pointer hover:bg-gray-100 rounded p-1' : ''}`}
                onClick={displayOptions.copyable ? () => navigator.clipboard.writeText(fullText || String(value)) : undefined}>
            {displayValue}
          </span>
        </Tooltip>
      );
    }
    case 'LinkOption': {
      const displayName = (data as any)[displayOptions.displayNameField] || value;
      const href = typeof value === 'string' ? value : (data as any)[column.id]; // Assume value or column.id is the href
      return href ? (
        <a href={href} target={displayOptions.openNewTab ? '_blank' : '_self'} rel="noopener noreferrer" className="text-blue-600 hover:underline" onClick={(e) => {
          if (onLinkClick) {
            e.preventDefault();
            onLinkClick(href, displayOptions.openNewTab);
          }
        }}>
          {displayName}
        </a>
      ) : <DefaultCellValue value={value} columnType={column.type} />;
    }
    case 'TagListOption': {
      const tags = Array.isArray(value) ? value : (value ? [value] : []);
      const colors = (data as any)[displayOptions.tagColorsField] || [];
      const icons = (data as any)[displayOptions.tagIconsField] || [];
      return (
        <div className="flex flex-wrap gap-1">
          {tags.map((tag: string, index: number) => (
            <Tag key={index} label={tag} color={colors[index]} icon={icons[index]} />
          ))}
        </div>
      );
    }
    case 'JSONOption': {
      return (
        <pre className="bg-gray-50 p-2 rounded text-xs overflow-auto max-h-40">
          {JSON.stringify(value, null, displayOptions.collapsed ? 0 : 2)}
        </pre>
      );
    }
    default:
      return <DefaultCellValue value={value} columnType={column.type} />;
  }
};

export const DefaultCellValue: React.FC<{ value: any; columnType: string }> = ({ value, columnType }) => {
  if (value === null || value === undefined) {
    return <span className="text-gray-400 italic">N/A</span>;
  }
  if (Array.isArray(value)) {
    return (
      <div className="flex flex-wrap gap-1">
        {value.map((item, index) => (
          <Tag key={index} label={String(item)} />
        ))}
      </div>
    );
  }
  switch (columnType.toLowerCase()) {
    case 'number':
    case 'integer':
      return <span className="font-mono">{Number(value).toLocaleString()}</span>;
    case 'currency':
      return <span className="font-mono">{Number(value).toLocaleString('en-US', APP_CONFIG.CURRENCY_FORMAT_OPTIONS)}</span>;
    case 'date':
      return dayjs(value).isValid() ? <span>{dayjs(value).format(APP_CONFIG.DATE_FORMAT)}</span> : <span>{String(value)}</span>;
    case 'datetime':
      return dayjs(value).isValid() ? <span>{dayjs(value).format(APP_CONFIG.DATETIME_FORMAT)}</span> : <span>{String(value)}</span>;
    case 'boolean':
      return value ? <span className="text-green-600">Yes</span> : <span className="text-red-600">No</span>;
    case 'object':
      return <Tooltip content={JSON.stringify(value, null, 2)}><span className="text-blue-600 cursor-pointer">View Object</span></Tooltip>;
    default:
      return <span className="text-gray-800 break-words">{String(value)}</span>;
  }
};


// --- Main Component: AccountCapabilityDetailsTable ---

export const AccountCapabilityDetailsTable: React.FC<{ capabilityId: string }> = ({ capabilityId }) => {
  const { loading, error, data } = useQuery<AccountCapabilityDetailsTableQueryResponse>(
    ACCOUNT_CAPABILITY_DETAILS_QUERY,
    {
      variables: { id: capabilityId },
      fetchPolicy: 'cache-and-network', // Always try network, but show cached data immediately
    }
  );

  const [activeDrawer, setActiveDrawer] = useState<{ entityType: string; id: string } | null>(null);

  const handleAssociationClick = useCallback((entityType: string, id: string) => {
    logger.info(`Opening drawer for ${entityType} with ID: ${id}`);
    setActiveDrawer({ entityType, id });
  }, []);

  const handleLinkClick = useCallback((href: string, openNewTab?: boolean) => {
    logger.info(`Navigating to link: ${href}, new tab: ${openNewTab}`);
    if (openNewTab) {
      window.open(href, '_blank');
    } else {
      // Use router for internal links if applicable
      // navigate(href);
      window.location.href = href; // Fallback for external or non-routed internal links
    }
  }, []);

  if (loading && !data) return <Spinner />;
  if (error) {
    logger.error('Error fetching account capability details', error, { capabilityId });
    return <Alert type="error" message={`Error: ${error.message}`} />;
  }
  if (!data?.accountCapability) {
    logger.warn('No account capability data found.', { capabilityId });
    return <Alert type="info" message="Account Capability not found." />;
  }

  const { accountCapability, displayColumns } = data;

  const filteredColumns = displayColumns.filter(col => col.viewOptions?.detailsTable?.default !== false);
  const sortedColumns = [...filteredColumns].sort((a, b) => {
    // Primary columns first, then by label
    if (a.viewOptions?.detailsTable?.primaryColumn && !b.viewOptions?.detailsTable?.primaryColumn) return -1;
    if (!a.viewOptions?.detailsTable?.primaryColumn && b.viewOptions?.detailsTable?.primaryColumn) return 1;
    return a.label.localeCompare(b.label);
  });

  return (
    <Card title={`Details for Capability: ${accountCapability.identifier || accountCapability.id}`}>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {sortedColumns.map((column) => (
          <div key={column.id} className="border-b border-gray-200 pb-2">
            <label className="block text-sm font-medium text-gray-500 mb-1">{column.label}</label>
            <div className="text-sm text-gray-900 break-words">
              <DynamicCellValue
                column={column}
                data={accountCapability}
                onAssociationClick={handleAssociationClick}
                onLinkClick={handleLinkClick}
              />
            </div>
            {column.viewOptions?.detailsTable?.copyable && (
              <Button
                variant="ghost"
                className="text-xs text-blue-500 hover:text-blue-700 p-0 mt-1"
                onClick={() => {
                  const valueToCopy = (accountCapability as any)[column.id];
                  if (valueToCopy) {
                    navigator.clipboard.writeText(String(valueToCopy));
                    logger.info(`Copied value for column ${column.label}`);
                    // Potentially show a toast notification
                  }
                }}
              >
                Copy
              </Button>
            )}
          </div>
        ))}
      </div>

      <Modal
        isOpen={!!activeDrawer}
        onClose={() => setActiveDrawer(null)}
        title={`Details for ${activeDrawer?.entityType || 'Entity'}`}
        size="lg"
      >
        {activeDrawer ? (
          <p>
            This would dynamically load details for <strong>{activeDrawer.entityType}</strong> with ID{' '}
            <strong>{activeDrawer.id}</strong>.
            <br />
            In a full application, this modal would render a specific component (e.g., `EntityDetailsDrawer`) that fetches and displays the related entity's data.
          </p>
        ) : (
          <p>No entity selected.</p>
        )}
      </Modal>
    </Card>
  );
};

// --- Transaction Management Features ---

export enum TransactionStatus {
  PENDING = 'PENDING',
  COMPLETED = 'COMPLETED',
  FAILED = 'FAILED',
  CANCELLED = 'CANCELLED',
  HOLD = 'HOLD',
  REVIEW = 'REVIEW',
}

export enum TransactionType {
  DEPOSIT = 'DEPOSIT',
  WITHDRAWAL = 'WITHDRAWAL',
  TRANSFER_INTERNAL = 'TRANSFER_INTERNAL',
  TRANSFER_EXTERNAL = 'TRANSFER_EXTERNAL',
  PAYMENT = 'PAYMENT',
  BILL_PAYMENT = 'BILL_PAYMENT',
  FEE = 'FEE',
  LOAN_PAYMENT = 'LOAN_PAYMENT',
  CURRENCY_EXCHANGE = 'CURRENCY_EXCHANGE',
}

export interface Transaction {
  id: string;
  accountId: string;
  capabilityId?: string; // Link to account capability
  type: TransactionType;
  status: TransactionStatus;
  amount: number;
  currency: string;
  description: string;
  initiationDate: string; // ISO 8601
  completionDate?: string; // ISO 8601
  senderName?: string;
  senderAccount?: string;
  receiverName?: string;
  receiverAccount?: string;
  referenceNumber: string;
  auditTrailId: string;
  relatedTransactionId?: string;
  requiresMFA: boolean;
  mfaCompleted?: boolean;
}

// Mock API for Transactions
export class TransactionService {
  private static transactions: Transaction[] = Array.from({ length: 50 }).map((_, i) => ({
    id: `txn-${uuidv4()}`,
    accountId: `acc-${Math.floor(Math.random() * 5) + 1}`, // Associate with mock accounts
    capabilityId: `cap-${Math.floor(Math.random() * 3) + 1}`,
    type: Object.values(TransactionType)[Math.floor(Math.random() * Object.values(TransactionType).length)],
    status: Object.values(TransactionStatus)[Math.floor(Math.random() * Object.values(TransactionStatus).length)],
    amount: parseFloat((Math.random() * 10000).toFixed(2)),
    currency: 'USD',
    description: `Transaction ${i + 1} for various services.`,
    initiationDate: dayjs().subtract(Math.random() * 30, 'days').toISOString(),
    completionDate: Math.random() > 0.2 ? dayjs().subtract(Math.random() * 20, 'days').toISOString() : undefined,
    senderName: Math.random() > 0.5 ? 'John Doe Inc.' : undefined,
    receiverName: Math.random() > 0.5 ? 'Jane Smith Ltd.' : undefined,
    referenceNumber: `REF${Math.floor(100000 + Math.random() * 900000)}`,
    auditTrailId: `AUDIT${Math.floor(100000 + Math.random() * 900000)}`,
    requiresMFA: Math.random() > 0.7,
    mfaCompleted: Math.random() > 0.8,
  }));

  static async getTransactions(
    filters: { accountId?: string; capabilityId?: string; status?: TransactionStatus; type?: TransactionType; startDate?: string; endDate?: string; searchText?: string; },
    pagination: { page: number; pageSize: number; sortBy?: string; sortDirection?: 'asc' | 'desc'; }
  ): Promise<{ transactions: Transaction[]; total: number }> {
    logger.debug('Fetching transactions with filters and pagination.', { filters, pagination });
    await new Promise(resolve => setTimeout(resolve, 500)); // Simulate API delay

    let filtered = TransactionService.transactions.filter(txn => {
      let matches = true;
      if (filters.accountId && txn.accountId !== filters.accountId) matches = false;
      if (filters.capabilityId && txn.capabilityId !== filters.capabilityId) matches = false;
      if (filters.status && txn.status !== filters.status) matches = false;
      if (filters.type && txn.type !== filters.type) matches = false;
      if (filters.startDate && dayjs(txn.initiationDate).isBefore(dayjs(filters.startDate))) matches = false;
      if (filters.endDate && dayjs(txn.initiationDate).isAfter(dayjs(filters.endDate))) matches = false;
      if (filters.searchText) {
        const searchLower = filters.searchText.toLowerCase();
        if (!Object.values(txn).some(val => String(val).toLowerCase().includes(searchLower))) matches = false;
      }
      return matches;
    });

    if (pagination.sortBy) {
      filtered.sort((a, b) => {
        const aVal = (a as any)[pagination.sortBy!];
        const bVal = (b as any)[pagination.sortBy!];
        if (typeof aVal === 'string') return pagination.sortDirection === 'asc' ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
        if (typeof aVal === 'number') return pagination.sortDirection === 'asc' ? aVal - bVal : bVal - aVal;
        return 0;
      });
    }

    const total = filtered.length;
    const start = (pagination.page - 1) * pagination.pageSize;
    const end = start + pagination.pageSize;
    const transactions = filtered.slice(start, end);

    logger.info(`Fetched ${transactions.length} transactions (total: ${total}).`);
    return { transactions, total };
  }

  static async getTransactionById(id: string): Promise<Transaction | null> {
    logger.debug(`Fetching transaction by ID: ${id}`);
    await new Promise(resolve => setTimeout(resolve, 300));
    const txn = TransactionService.transactions.find(t => t.id === id);
    if (txn) {
      logger.info(`Found transaction ${id}.`);
    } else {
      logger.warn(`Transaction ${id} not found.`);
    }
    return txn || null;
  }

  static async updateTransactionStatus(transactionId: string, newStatus: TransactionStatus, userId: string): Promise<Transaction | null> {
    logger.info(`Attempting to update status for transaction ${transactionId} to ${newStatus}.`, { userId });
    await new Promise(resolve => setTimeout(resolve, 500));
    const index = TransactionService.transactions.findIndex(t => t.id === transactionId);
    if (index > -1) {
      TransactionService.transactions = produce(TransactionService.transactions, draft => {
        draft[index].status = newStatus;
        draft[index].completionDate = newStatus === TransactionStatus.COMPLETED ? dayjs().toISOString() : draft[index].completionDate;
      });
      logger.info(`Transaction ${transactionId} status updated to ${newStatus}.`);
      // Simulate audit trail entry
      AuditService.addAuditEntry(AuditResourceType.TRANSACTION, transactionId, AuditEventType.UPDATE, userId, { oldStatus: TransactionService.transactions[index].status, newStatus });
      return TransactionService.transactions[index];
    }
    logger.error(`Failed to update transaction status: Transaction ${transactionId} not found.`);
    return null;
  }

  static async approveTransaction(transactionId: string, userId: string): Promise<Transaction | null> {
    logger.info(`Approving transaction ${transactionId}.`, { userId });
    return this.updateTransactionStatus(transactionId, TransactionStatus.COMPLETED, userId); // Or PENDING_APPROVAL -> COMPLETED
  }

  static async rejectTransaction(transactionId: string, userId: string): Promise<Transaction | null> {
    logger.info(`Rejecting transaction ${transactionId}.`, { userId });
    return this.updateTransactionStatus(transactionId, TransactionStatus.FAILED, userId); // Or REJECTED
  }

  static async initiateTransfer(details: Omit<Transaction, 'id' | 'status' | 'initiationDate' | 'completionDate' | 'auditTrailId'>, userId: string): Promise<Transaction> {
    logger.info('Initiating new transfer.', { userId, details });
    await new Promise(resolve => setTimeout(resolve, 1000));

    const newTransaction: Transaction = {
      ...details,
      id: `txn-${uuidv4()}`,
      status: details.requiresMFA ? TransactionStatus.PENDING : TransactionStatus.COMPLETED, // Mock MFA workflow
      initiationDate: dayjs().toISOString(),
      auditTrailId: `AUDIT${uuidv4().substring(0, 8).toUpperCase()}`,
    };
    TransactionService.transactions.unshift(newTransaction); // Add to beginning for visibility
    AuditService.addAuditEntry(AuditResourceType.TRANSACTION, newTransaction.id, AuditEventType.CREATE, userId, newTransaction);
    logger.info(`New transaction ${newTransaction.id} initiated. Status: ${newTransaction.status}`);
    return newTransaction;
  }
}

export const TransactionList: React.FC<{ capabilityId?: string; accountId?: string }> = ({ capabilityId, accountId }) => {
  const [transactions, setTransactions] = useState<Transaction[]>([]);
  const [totalTransactions, setTotalTransactions] = useState(0);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] = useState(APP_CONFIG.DEFAULT_PAGE_SIZE);
  const [filters, setFilters] = useState<{
    status?: TransactionStatus;
    type?: TransactionType;
    startDate?: string;
    endDate?: string;
    searchText?: string;
  }>({});
  const [sortBy, setSortBy] = useState<string>('initiationDate');
  const [sortDirection, setSortDirection] = useState<'asc' | 'desc'>('desc');

  const auth = useAuth();
  const userId = auth.state.user?.id || 'anonymous';

  const fetchTransactions = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const result = await TransactionService.getTransactions(
        { ...filters, capabilityId, accountId },
        { page, pageSize, sortBy, sortDirection }
      );
      setTransactions(result.transactions);
      setTotalTransactions(result.total);
      logger.debug('Transaction list updated.');
    } catch (err: any) {
      setError(err.message || 'Failed to fetch transactions.');
      logger.error('Failed to fetch transactions.', err, { capabilityId, accountId, filters, page, pageSize });
    } finally {
      setLoading(false);
    }
  }, [capabilityId, accountId, filters, page, pageSize, sortBy, sortDirection]);

  useEffect(() => {
    fetchTransactions();
  }, [fetchTransactions]);

  const handleFilterChange = (key: keyof typeof filters, value: any) => {
    setFilters(prev => ({ ...prev, [key]: value }));
    setPage(1); // Reset page on filter change
  };

  const handleSortChange = (column: string) => {
    if (sortBy === column) {
      setSortDirection(prev => (prev === 'asc' ? 'desc' : 'asc'));
    } else {
      setSortBy(column);
      setSortDirection('desc'); // Default sort for new column
    }
  };

  const handleApprove = async (txnId: string) => {
    if (!auth.hasPermission('transaction:approve')) {
      alert('You do not have permission to approve transactions.');
      logger.warn('Permission denied: transaction:approve', { userId });
      return;
    }
    try {
      await TransactionService.approveTransaction(txnId, userId);
      fetchTransactions();
      logger.info(`Transaction ${txnId} approved by user ${userId}.`);
      // Add notification
    } catch (err: any) {
      setError(err.message || 'Failed to approve transaction.');
      logger.error(`Failed to approve transaction ${txnId}.`, err, { userId });
    }
  };

  const handleReject = async (txnId: string) => {
    if (!auth.hasPermission('transaction:reject')) {
      alert('You do not have permission to reject transactions.');
      logger.warn('Permission denied: transaction:reject', { userId });
      return;
    }
    try {
      await TransactionService.rejectTransaction(txnId, userId);
      fetchTransactions();
      logger.info(`Transaction ${txnId} rejected by user ${userId}.`);
      // Add notification
    } catch (err: any) {
      setError(err.message || 'Failed to reject transaction.');
      logger.error(`Failed to reject transaction ${txnId}.`, err, { userId });
    }
  };

  const renderSortArrow = (column: string) => {
    if (sortBy === column) {
      return sortDirection === 'asc' ? ' ↑' : ' ↓';
    }
    return '';
  };

  return (
    <Card title="Transactions">
      <div className="flex flex-wrap gap-4 mb-4">
        <Input
          type="text"
          placeholder="Search..."
          value={filters.searchText || ''}
          onChange={(e) => handleFilterChange('searchText', e.target.value)}
          className="w-48"
        />
        <Select
          value={filters.status || ''}
          onChange={(e) => handleFilterChange('status', e.target.value as TransactionStatus)}
          className="w-48"
        >
          <option value="">All Statuses</option>
          {Object.values(TransactionStatus).map(status => <option key={status} value={status}>{status}</option>)}
        </Select>
        <Select
          value={filters.type || ''}
          onChange={(e) => handleFilterChange('type', e.target.value as TransactionType)}
          className="w-48"
        >
          <option value="">All Types</option>
          {Object.values(TransactionType).map(type => <option key={type} value={type}>{type}</option>)}
        </Select>
        <Input
          type="date"
          value={filters.startDate || ''}
          onChange={(e) => handleFilterChange('startDate', e.target.value)}
          title="Start Date"
          className="w-48"
        />
        <Input
          type="date"
          value={filters.endDate || ''}
          onChange={(e) => handleFilterChange('endDate', e.target.value)}
          title="End Date"
          className="w-48"
        />
      </div>

      {loading && <Spinner />}
      {error && <Alert type="error" message={error} className="mb-4" />}

      {!loading && transactions.length === 0 && <Alert type="info" message="No transactions found matching your criteria." />}

      {!loading && transactions.length > 0 && (
        <>
          <div className="overflow-x-auto">
            <table className="min-w-full divide-y divide-gray-200">
              <thead className="bg-gray-50">
                <tr>
                  {['Reference', 'Type', 'Amount', 'Status', 'Initiation Date', 'Sender', 'Receiver', 'MFA', 'Actions'].map(header => (
                    <th
                      key={header}
                      className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer"
                      onClick={() => handleSortChange(header.toLowerCase().replace(/ /g, ''))} // Simple heuristic for column ID
                    >
                      {header}{renderSortArrow(header.toLowerCase().replace(/ /g, ''))}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody className="bg-white divide-y divide-gray-200">
                {transactions.map(txn => (
                  <tr key={txn.id}>
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{txn.referenceNumber}</td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{txn.type}</td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-mono">{txn.amount.toLocaleString('en-US', APP_CONFIG.CURRENCY_FORMAT_OPTIONS)} {txn.currency}</td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm">
                      <Tag label={txn.status} color={
                        txn.status === TransactionStatus.COMPLETED ? 'bg-green-100 text-green-800' :
                        txn.status === TransactionStatus.PENDING ? 'bg-yellow-100 text-yellow-800' :
                        'bg-red-100 text-red-800'
                      } />
                    </td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{dayjs(txn.initiationDate).format(APP_CONFIG.DATETIME_FORMAT)}</td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{txn.senderName || 'N/A'}</td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{txn.receiverName || 'N/A'}</td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm">
                      {txn.requiresMFA ? (txn.mfaCompleted ? <Tag label="Complete" color="bg-green-100 text-green-800" /> : <Tag label="Required" color="bg-yellow-100 text-yellow-800" />) : 'N/A'}
                    </td>
                    <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                      {txn.status === TransactionStatus.PENDING && auth.hasPermission('transaction:approve') && (
                        <Button variant="primary" className="mr-2 text-xs py-1 px-2" onClick={() => handleApprove(txn.id)}>Approve</Button>
                      )}
                      {txn.status === TransactionStatus.PENDING && auth.hasPermission('transaction:reject') && (
                        <Button variant="danger" className="text-xs py-1 px-2" onClick={() => handleReject(txn.id)}>Reject</Button>
                      )}
                      <Link to={`/transactions/${txn.id}`} className="text-blue-600 hover:text-blue-900 ml-2">View</Link>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div className="flex justify-between items-center mt-4">
            <span className="text-sm text-gray-700">
              Showing {(page - 1) * pageSize + 1} to {Math.min(page * pageSize, totalTransactions)} of {totalTransactions} entries
            </span>
            <div className="flex space-x-2">
              <Button onClick={() => setPage(prev => Math.max(1, prev - 1))} disabled={page === 1} variant="secondary">Previous</Button>
              <Button onClick={() => setPage(prev => prev + 1)} disabled={page * pageSize >= totalTransactions} variant="secondary">Next</Button>
            </div>
          </div>
        </>
      )}
    </Card>
  );
};

export const TransactionDetails: React.FC = () => {
  const { transactionId } = useParams<{ transactionId: string }>();
  const [transaction, setTransaction] = useState<Transaction | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const auth = useAuth();
  const navigate = useNavigate();

  useEffect(() => {
    const fetchDetails = async () => {
      if (!transactionId) {
        setError("Transaction ID is missing.");
        setLoading(false);
        return;
      }
      setLoading(true);
      setError(null);
      try {
        const txn = await TransactionService.getTransactionById(transactionId);
        if (txn) {
          setTransaction(txn);
        } else {
          setError("Transaction not found.");
        }
      } catch (err: any) {
        setError(err.message || 'Failed to fetch transaction details.');
        logger.error(`Failed to fetch transaction details for ${transactionId}.`, err);
      } finally {
        setLoading(false);
      }
    };
    fetchDetails();
  }, [transactionId]);

  if (loading) return <Spinner />;
  if (error) return <Alert type="error" message={error} />;
  if (!transaction) return <Alert type="info" message="Transaction details could not be loaded." />;

  const handleApprove = async () => {
    if (!auth.hasPermission('transaction:approve')) {
      alert('You do not have permission to approve transactions.');
      logger.warn('Permission denied: transaction:approve', { userId: auth.state.user?.id });
      return;
    }
    if (window.confirm(`Are you sure you want to approve transaction ${transaction.referenceNumber}?`)) {
      try {
        const updatedTxn = await TransactionService.approveTransaction(transaction.id, auth.state.user?.id || 'unknown');
        if (updatedTxn) {
          setTransaction(updatedTxn);
          logger.info(`Transaction ${transaction.id} approved by user ${auth.state.user?.id}.`);
        }
      } catch (err: any) {
        setError(err.message || 'Failed to approve transaction.');
        logger.error(`Failed to approve transaction ${transaction.id}.`, err, { userId: auth.state.user?.id });
      }
    }
  };

  const handleReject = async () => {
    if (!auth.hasPermission('transaction:reject')) {
      alert('You do not have permission to reject transactions.');
      logger.warn('Permission denied: transaction:reject', { userId: auth.state.user?.id });
      return;
    }
    if (window.confirm(`Are you sure you want to reject transaction ${transaction.referenceNumber}? This action cannot be undone.`)) {
      try {
        const updatedTxn = await TransactionService.rejectTransaction(transaction.id, auth.state.user?.id || 'unknown');
        if (updatedTxn) {
          setTransaction(updatedTxn);
          logger.info(`Transaction ${transaction.id} rejected by user ${auth.state.user?.id}.`);
        }
      } catch (err: any) {
        setError(err.message || 'Failed to reject transaction.');
        logger.error(`Failed to reject transaction ${transaction.id}.`, err, { userId: auth.state.user?.id });
      }
    }
  };

  return (
    <Card title={`Transaction Details: ${transaction.referenceNumber}`}>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div>
          <p><span className="font-medium text-gray-600">ID:</span> {transaction.id}</p>
          <p><span className="font-medium text-gray-600">Account ID:</span> {transaction.accountId}</p>
          <p><span className="font-medium text-gray-600">Capability ID:</span> {transaction.capabilityId || 'N/A'}</p>
          <p><span className="font-medium text-gray-600">Type:</span> <Tag label={transaction.type} /></p>
          <p><span className="font-medium text-gray-600">Status:</span> <Tag label={transaction.status} color={
            transaction.status === TransactionStatus.COMPLETED ? 'bg-green-100 text-green-800' :
            transaction.status === TransactionStatus.PENDING ? 'bg-yellow-100 text-yellow-800' :
            'bg-red-100 text-red-800'
          }/></p>
          <p><span className="font-medium text-gray-600">Amount:</span> {transaction.amount.toLocaleString('en-US', APP_CONFIG.CURRENCY_FORMAT_OPTIONS)} {transaction.currency}</p>
          <p><span className="font-medium text-gray-600">Description:</span> {transaction.description}</p>
        </div>
        <div>
          <p><span className="font-medium text-gray-600">Initiation Date:</span> {dayjs(transaction.initiationDate).format(APP_CONFIG.DATETIME_FORMAT)}</p>
          <p><span className="font-medium text-gray-600">Completion Date:</span> {transaction.completionDate ? dayjs(transaction.completionDate).format(APP_CONFIG.DATETIME_FORMAT) : 'N/A'}</p>
          <p><span className="font-medium text-gray-600">Sender:</span> {transaction.senderName || 'N/A'} ({transaction.senderAccount || 'N/A'})</p>
          <p><span className="font-medium text-gray-600">Receiver:</span> {transaction.receiverName || 'N/A'} ({transaction.receiverAccount || 'N/A'})</p>
          <p><span className="font-medium text-gray-600">Reference:</span> {transaction.referenceNumber}</p>
          <p><span className="font-medium text-gray-600">Requires MFA:</span> <Tag label={transaction.requiresMFA ? 'Yes' : 'No'} color={transaction.requiresMFA ? 'bg-orange-100 text-orange-800' : 'bg-gray-100 text-gray-800'} /></p>
          <p><span className="font-medium text-gray-600">MFA Completed:</span> {transaction.mfaCompleted ? <Tag label="Yes" color="bg-green-100 text-green-800" /> : <Tag label="No" color="bg-red-100 text-red-800" />}</p>
          <p><span className="font-medium text-gray-600">Audit Trail ID:</span> <Link to={`/audit-logs/${transaction.auditTrailId}`} className="text-blue-600 hover:underline">{transaction.auditTrailId}</Link></p>
        </div>
      </div>

      <div className="mt-6 border-t border-gray-200 pt-4 flex space-x-3">
        {transaction.status === TransactionStatus.PENDING && auth.hasPermission('transaction:approve') && (
          <Button onClick={handleApprove} variant="primary">Approve Transaction</Button>
        )}
        {transaction.status === TransactionStatus.PENDING && auth.hasPermission('transaction:reject') && (
          <Button onClick={handleReject} variant="danger">Reject Transaction</Button>
        )}
        <Button onClick={() => navigate(-1)} variant="secondary">Back to List</Button>
      </div>
    </Card>
  );
};

export const InitiateTransferForm: React.FC<{ accountId?: string; onTransferSuccess?: () => void }> = ({ accountId, onTransferSuccess }) => {
  const [formData, setFormData] = useState({
    accountId: accountId || '',
    receiverName: '',
    receiverAccount: '',
    amount: '',
    currency: 'USD',
    description: '',
    type: TransactionType.TRANSFER_EXTERNAL,
    requiresMFA: false, // For demonstration, controlled by user
  });
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState<string | null>(null);
  const auth = useAuth();
  const userId = auth.state.user?.id || 'anonymous';
  const navigate = useNavigate();

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {
    const { name, value, type } = e.target;
    if (type === 'checkbox') {
      setFormData({ ...formData, [name]: (e.target as HTMLInputElement).checked });
    } else {
      setFormData({ ...formData, [name]: value });
    }
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!auth.hasPermission('transaction:create')) {
      setError('You do not have permission to initiate transfers.');
      logger.warn('Permission denied: transaction:create', { userId });
      return;
    }
    setLoading(true);
    setError(null);
    setSuccess(null);
    try {
      const newTransaction = await TransactionService.initiateTransfer(
        {
          accountId: formData.accountId,
          senderName: auth.state.user?.firstName + ' ' + auth.state.user?.lastName || 'N/A', // Mock sender
          senderAccount: formData.accountId, // Mock sender account
          receiverName: formData.receiverName,
          receiverAccount: formData.receiverAccount,
          amount: parseFloat(formData.amount),
          currency: formData.currency,
          description: formData.description,
          type: formData.type,
          requiresMFA: formData.requiresMFA || APP_CONFIG.MFA_REQUIRED_ACTIONS.includes('HIGH_VALUE_TRANSFER'), // Example logic
        },
        userId
      );
      setSuccess(`Transfer ${newTransaction.referenceNumber} initiated successfully. Status: ${newTransaction.status}`);
      logger.info(`Transfer ${newTransaction.id} initiated successfully.`, { userId });
      setFormData({ // Reset form
        accountId: accountId || '', receiverName: '', receiverAccount: '', amount: '', currency: 'USD', description: '', type: TransactionType.TRANSFER_EXTERNAL, requiresMFA: false,
      });
      if (onTransferSuccess) onTransferSuccess();
      navigate(`/transactions/${newTransaction.id}`);
    } catch (err: any) {
      setError(err.message || 'Failed to initiate transfer.');
      logger.error('Failed to initiate transfer.', err, { userId, formData });
    } finally {
      setLoading(false);
    }
  };

  return (
    <Card title="Initiate New Transfer">
      <form onSubmit={handleSubmit} className="space-y-4">
        <div>
          <label htmlFor="accountId" className="block text-sm font-medium text-gray-700">From Account ID</label>
          <Input id="accountId" name="accountId" value={formData.accountId} onChange={handleChange} required disabled={!!accountId} />
        </div>
        <div>
          <label htmlFor="receiverName" className="block text-sm font-medium text-gray-700">Receiver Name</label>
          <Input id="receiverName" name="receiverName" value={formData.receiverName} onChange={handleChange} required />
        </div>
        <div>
          <label htmlFor="receiverAccount" className="block text-sm font-medium text-gray-700">Receiver Account #</label>
          <Input id="receiverAccount" name="receiverAccount" value={formData.receiverAccount} onChange={handleChange} required />
        </div>
        <div className="grid grid-cols-2 gap-4">
          <div>
            <label htmlFor="amount" className="block text-sm font-medium text-gray-700">Amount</label>
            <Input id="amount" name="amount" type="number" step="0.01" value={formData.amount} onChange={handleChange} required />
          </div>
          <div>
            <label htmlFor="currency" className="block text-sm font-medium text-gray-700">Currency</label>
            <Select id="currency" name="currency" value={formData.currency} onChange={handleChange} required>
              <option value="USD">USD</option>
              <option value="EUR">EUR</option>
              <option value="GBP">GBP</option>
            </Select>
          </div>
        </div>
        <div>
          <label htmlFor="description" className="block text-sm font-medium text-gray-700">Description</label>
          <textarea
            id="description"
            name="description"
            value={formData.description}
            onChange={handleChange}
            rows={3}
            className="border border-gray-300 rounded-md p-2 w-full focus:ring-blue-500 focus:border-blue-500 transition-colors duration-150"
            required
          ></textarea>
        </div>
        <div className="flex items-center">
          <Checkbox id="requiresMFA" name="requiresMFA" checked={formData.requiresMFA} onChange={handleChange} />
          <label htmlFor="requiresMFA" className="