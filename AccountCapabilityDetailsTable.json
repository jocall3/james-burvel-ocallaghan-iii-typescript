// --- Core Application Utilities ---

export enum LogLevel {
  DEBUG = 'DEBUG',
  INFO = 'INFO',
  WARN = 'WARN',
  ERROR = 'ERROR',
}

export interface AppLogEntry {
  timestamp: string;
  level: LogLevel;
  message: string;
  context?: Record<string, any>;
  userId?: string;
  transactionId?: string;
}

export class AppLogger {
  private static instance: AppLogger;
  private logs: AppLogEntry[] = [];
  private maxLogs = 1000; // Keep a rolling buffer of logs

  private constructor() {}

  public static getInstance(): AppLogger {
    if (!AppLogger.instance) {
      AppLogger.instance = new AppLogger();
    }
    return AppLogger.instance;
  }

  public log(level: LogLevel, message: string, context?: Record<string, any>, userId?: string, transactionId?: string) {
    const entry: AppLogEntry = {
      timestamp: dayjs().toISOString(),
      level,
      message,
      context,
      userId,
      transactionId,
    };
    this.logs.push(entry);
    if (this.logs.length > this.maxLogs) {
      this.logs.shift(); // Remove oldest log
    }
    // In a real app, this would also send to a remote logging service
    if (process.env.NODE_ENV === 'development' || level === LogLevel.ERROR || level === LogLevel.WARN) {
      console.log(`[${entry.timestamp}] [${entry.level}] ${entry.message}`, entry.context);
    }
  }

  public debug(message: string, context?: Record<string, any>, userId?: string, transactionId?: string) {
    this.log(LogLevel.DEBUG, message, context, userId, transactionId);
  }

  public info(message: string, context?: Record<string, any>, userId?: string, transactionId?: string) {
    this.log(LogLevel.INFO, message, context, userId, transactionId);
  }

  public warn(message: string, context?: Record<string, any>, userId?: string, transactionId?: string) {
    this.log(LogLevel.WARN, message, context, userId, transactionId);
  }

  public error(message: string, error?: Error | unknown, context?: Record<string, any>, userId?: string, transactionId?: string) {
    const errorContext = error instanceof Error ? { error: error.message, stack: error.stack, ...context } : context;
    this.log(LogLevel.ERROR, message, errorContext, userId, transactionId);
  }

  public getLogs(): AppLogEntry[] {
    return [...this.logs];
  }
}

export const logger = AppLogger.getInstance();


