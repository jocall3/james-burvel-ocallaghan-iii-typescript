// --- Authentication Context & Types ---

export enum UserRole {
  ADMIN = 'ADMIN',
  MANAGER = 'MANAGER',
  ANALYST = 'ANALYST',
  SUPPORT = 'SUPPORT',
  CUSTOMER = 'CUSTOMER',
}

export interface UserProfile {
  id: string;
  username: string;
  email: string;
  firstName: string;
  lastName: string;
  roles: UserRole[];
  permissions: string[]; // Granular permissions
  lastLogin: string;
  isAuthenticated: boolean;
  mfaEnabled: boolean;
  preferredLanguage: string;
  timezone: string;
}

export interface AuthState {
  user: UserProfile | null;
  loading: boolean;
  error: string | null;
}

export type AuthAction =
  | { type: 'LOGIN_REQUEST' }
  | { type: 'LOGIN_SUCCESS'; payload: UserProfile }
  | { type: 'LOGIN_FAILURE'; payload: string }
  | { type: 'LOGOUT' }
  | { type: 'UPDATE_PROFILE'; payload: Partial<UserProfile> };

export const initialAuthState: AuthState = {
  user: null,
  loading: false,
  error: null,
};

export function authReducer(state: AuthState, action: AuthAction): AuthState {
  switch (action.type) {
    case 'LOGIN_REQUEST':
      return { ...state, loading: true, error: null };
    case 'LOGIN_SUCCESS':
      logger.info(`User ${action.payload.username} logged in successfully.`, { userId: action.payload.id });
      return { ...state, loading: false, user: action.payload, error: null };
    case 'LOGIN_FAILURE':
      logger.warn(`Login failed: ${action.payload}`);
      return { ...state, loading: false, user: null, error: action.payload };
    case 'LOGOUT':
      logger.info(`User ${state.user?.username} logged out.`, { userId: state.user?.id });
      return { ...initialAuthState };
    case 'UPDATE_PROFILE':
      if (!state.user) return state;
      logger.info(`User ${state.user.username} profile updated.`, { userId: state.user.id, changes: action.payload });
      return { ...state, user: { ...state.user, ...action.payload } };
    default:
      return state;
  }
}

export interface AuthContextType {
  state: AuthState;
  dispatch: React.Dispatch<AuthAction>;
  login: (credentials: { username: string; password: string }) => Promise<void>;
  logout: () => void;
  register: (userDetails: any) => Promise<void>; // Simplified for brevity
  updateProfile: (updates: Partial<UserProfile>) => Promise<void>;
  hasPermission: (permission: string) => boolean;
  hasRole: (role: UserRole) => boolean;
}

export const AuthContext = createContext<AuthContextType | undefined>(undefined);

export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [state, dispatch] = useReducer(authReducer, initialAuthState);
  const navigate = useNavigate();

  useEffect(() => {
    // Check for existing token/session on mount
    const token = localStorage.getItem(APP_CONFIG.AUTH_TOKEN_KEY);
    if (token) {
      // In a real app, this would validate the token with the backend
      // and fetch user profile. For demo, we'll mock a successful login.
      logger.debug("Found existing auth token, attempting auto-login.");
      setTimeout(() => {
        dispatch({
          type: 'LOGIN_SUCCESS',
          payload: {
            id: 'mock-user-123',
            username: 'demo_user',
            email: 'demo@citibankdemo.com',
            firstName: 'Demo',
            lastName: 'User',
            roles: [UserRole.CUSTOMER, UserRole.ANALYST],
            permissions: ['account:view', 'transaction:view', 'capability:view', 'report:generate'],
            lastLogin: dayjs().toISOString(),
            isAuthenticated: true,
            mfaEnabled: true,
            preferredLanguage: 'en-US',
            timezone: APP_CONFIG.DEFAULT_TIMEZONE,
          },
        });
        logger.info("Auto-login successful with mocked user profile.");
      }, 50); // Small delay to simulate async
    }
  }, []);

  const login = async (credentials: { username: string; password: string }) => {
    dispatch({ type: 'LOGIN_REQUEST' });
    try {
      // Simulate API call
      logger.debug("Attempting login via API...", { username: credentials.username });
      const response = await new Promise((resolve) => setTimeout(() => {
        if (credentials.username === 'admin' && credentials.password === 'password') {
          resolve({
            token: 'mock-admin-token',
            refreshToken: 'mock-admin-refresh',
            user: {
              id: 'mock-admin-456',
              username: 'admin',
              email: 'admin@citibankdemo.com',
              firstName: 'Super',
              lastName: 'Admin',
              roles: [UserRole.ADMIN, UserRole.MANAGER],
              permissions: ['account:*', 'transaction:*', 'capability:*', 'user:*', 'report:*', 'settings:*'],
              lastLogin: dayjs().toISOString(),
              isAuthenticated: true,
              mfaEnabled: true,
              preferredLanguage: 'en-US',
              timezone: APP_CONFIG.DEFAULT_TIMEZONE,
            },
          });
        } else if (credentials.username === 'demo' && credentials.password === 'password') {
            resolve({
              token: 'mock-demo-token',
              refreshToken: 'mock-demo-refresh',
              user: {
                id: 'mock-user-123',
                username: 'demo_user',
                email: 'demo@citibankdemo.com',
                firstName: 'Demo',
                lastName: 'User',
                roles: [UserRole.CUSTOMER, UserRole.ANALYST],
                permissions: ['account:view', 'transaction:view', 'capability:view', 'report:generate'],
                lastLogin: dayjs().toISOString(),
                isAuthenticated: true,
                mfaEnabled: true,
                preferredLanguage: 'en-US',
                timezone: APP_CONFIG.DEFAULT_TIMEZONE,
              },
            });
        } else {
          throw new Error('Invalid credentials');
        }
      }, 1000));

      const { token, refreshToken, user } = response as { token: string; refreshToken: string; user: UserProfile };
      localStorage.setItem(APP_CONFIG.AUTH_TOKEN_KEY, token);
      localStorage.setItem(APP_CONFIG.REFRESH_TOKEN_KEY, refreshToken);
      dispatch({ type: 'LOGIN_SUCCESS', payload: user });
      navigate('/dashboard');
      logger.info(`User ${user.username} successfully logged in.`);
    } catch (err: any) {
      dispatch({ type: 'LOGIN_FAILURE', payload: err.message || 'Login failed' });
      logger.error('Login process failed', err, { username: credentials.username });
    }
  };

  const logout = () => {
    localStorage.removeItem(APP_CONFIG.AUTH_TOKEN_KEY);
    localStorage.removeItem(APP_CONFIG.REFRESH_TOKEN_KEY);
    dispatch({ type: 'LOGOUT' });
    navigate('/login');
    logger.info('User logged out.');
  };

  const register = async (userDetails: any) => {
    logger.debug("Attempting user registration...", { email: userDetails.email });
    try {
      // Simulate API call
      await new Promise((resolve, reject) => setTimeout(() => {
        if (userDetails.email === 'existing@example.com') {
          reject(new Error('Email already registered'));
        } else {
          resolve({});
        }
      }, 1500));
      logger.info('User registration successful.', { email: userDetails.email });
      // After registration, might auto-login or redirect to login page
      navigate('/login');
    } catch (err: any) {
      logger.error('User registration failed.', err, { email: userDetails.email });
      throw err;
    }
  };

  const updateProfile = async (updates: Partial<UserProfile>) => {
    if (!state.user) {
      logger.warn('Attempted to update profile for a non-logged-in user.');
      return;
    }
    try {
      // Simulate API call
      logger.debug('Attempting to update user profile.', { userId: state.user.id, updates });
      await new Promise((resolve) => setTimeout(resolve, 500));
      dispatch({ type: 'UPDATE_PROFILE', payload: updates });
      logger.info('User profile updated successfully.', { userId: state.user.id, updates });
    } catch (err: any) {
      logger.error('Failed to update user profile.', err, { userId: state.user.id, updates });
      throw err;
    }
  };

  const hasPermission = useCallback((permission: string): boolean => {
    return state.user?.permissions?.includes(permission) || state.user?.roles?.includes(UserRole.ADMIN) || false;
  }, [state.user]);

  const hasRole = useCallback((role: UserRole): boolean => {
    return state.user?.roles?.includes(role) || false;
  }, [state.user]);

  const value = useMemo(() => ({
    state,
    dispatch,
    login,
    logout,
    register,
    updateProfile,
    hasPermission,
    hasRole,
  }), [state, login, logout, register, updateProfile, hasPermission, hasRole]);

  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
};

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (context === undefined) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
};

// --- GraphQL Setup ---

export const client: ApolloClient<NormalizedCacheObject> = new ApolloClient({
  link: new HttpLink({
    uri: APP_CONFIG.GRAPHQL_ENDPOINT,
    headers: {
      authorization: localStorage.getItem(APP_CONFIG.AUTH_TOKEN_KEY) ? `Bearer ${localStorage.getItem(APP_CONFIG.AUTH_TOKEN_KEY)}` : "",
      "x-timezone": dayjs.tz.guess(),
      "x-locale": navigator.language,
    }
  }),
  cache: new InMemoryCache(),
});

// --- GraphQL Schemas & Types (Derived from the original JSON query) ---

export const ACCOUNT_CAPABILITY_DETAILS_QUERY = gql`
  query AccountCapabilityDetailsTable($id: ID!) {
    accountCapability(id: $id) {
      id
      path
      prettyPaymentType
      prettyDirection
      identifier
      partyName
      currencies
      currencyTagColors
      anyCurrency
      prettyPaymentSubtypes
      paymentSubtypeTagColors
      connection {
        typename: __typename
        id
        bestName
        path
      }
      address {
        typename: __typename
        id
        full
      }
      discardedAt
      __typename
    }
    displayColumns(resource: account_capability, viewType: "details_table") {
      ...displayColumn
      __typename
    }
  }

  fragment displayColumn on DisplayColumn {
    viewOptions {
      detailsTable {
        hideIfNull
        copyable
        default
        primaryColumn
        __typename
      }
      listView {
        default
        label
        __typename
      }
      __typename
    }
    label
    id
    type
    resource
    sortColumn
    displayTypeOptions {
      ... on AssociationOption {
        typename: __typename
        associatedEntityLabelField
        associatedEntityLabelFieldType
        drawerEnabled
        linkEnabled
      }
      ... on AssociationListOption {
        typename: __typename
        associatedEntityLabelField
        associatedEntityLabelFieldType
        drawerEnabled
        linkEnabled
      }
      ... on PolymorphicAssociationOption {
        associationPrefix
        drawerEnabled
        stackedDrawerEnabled
        __typename
      }
      ... on AuditableJSONOption {
        auditableFieldName
        __typename
      }
      ... on CountdownOption {
        typename: __typename
        countdownType
      }
      ... on LabelWithCountOption {
        typename: __typename
        countField
        prettyCountField
        truncateMiddle
      }
      ... on AmountDifferenceOption {
        typename: __typename
        highlightAmountDifferenceField
      }
      ... on StatusIndicatorOption {
        typename: __typename
        statusIndicatorCurrentStatusField
        statusIndicatorDescriptorField
        statusIndicatorVerboseField
      }
      ... on TagOption {
        typename: __typename
        tagColorField
        tagIconField
      }
      ... on TagButtonListOption {
        typename: __typename
        tagButtonColorsField
        tagButtonIconsField
        tagButtonHrefsField
        tagButtonTooltipsField
      }
      ... on AuditableTextOption {
        typename: __typename
        fieldAsDefaultText
        fullField
        copyable
      }
      ... on LinkOption {
        typename: __typename
        displayNameField
        openNewTab
      }
      ... on TagListOption {
        typename: __typename
        tagColorsField
        tagIconsField
      }
      ... on JSONOption {
        typename: __typename
        collapsed
      }
      __typename
    }
    __typename
  }
`;

// TypeScript interfaces mirroring the GraphQL types
export interface Connection {
  typename: string;
  id: string;
  bestName: string;
  path: string;
}

export interface Address {
  typename: string;
  id: string;
  full: string;
}

export interface AccountCapability {
  id: string;
  path: string;
  prettyPaymentType: string;
  prettyDirection: 'INBOUND' | 'OUTBOUND' | 'BOTH';
  identifier: string;
  partyName: string;
  currencies: string[];
  currencyTagColors: string[];
  anyCurrency: boolean;
  prettyPaymentSubtypes: string[];
  paymentSubtypeTagColors: string[];
  connection?: Connection;
  address?: Address;
  discardedAt?: string; // ISO 8601 datetime string
  __typename: "AccountCapability";
}

export interface DisplayColumnViewOptionsDetailsTable {
  hideIfNull?: boolean;
  copyable?: boolean;
  default?: boolean;
  primaryColumn?: boolean;
  __typename: "DetailsTableColumnViewOptions";
}

export interface DisplayColumnViewOptionsListView {
  default?: boolean;
  label?: string;
  __typename: "ListViewColumnViewOptions";
}

export interface DisplayColumnViewOptions {
  detailsTable?: DisplayColumnViewOptionsDetailsTable;
  listView?: DisplayColumnViewOptionsListView;
  __typename: "ColumnViewOptions";
}

export interface AssociationOption {
  typename: "AssociationOption";
  associatedEntityLabelField: string;
  associatedEntityLabelFieldType: string;
  drawerEnabled: boolean;
  linkEnabled: boolean;
}

export interface AssociationListOption {
  typename: "AssociationListOption";
  associatedEntityLabelField: string;
  associatedEntityLabelFieldType: string;
  drawerEnabled: boolean;
  linkEnabled: boolean;
}

export interface PolymorphicAssociationOption {
  typename: "PolymorphicAssociationOption";
  associationPrefix: string;
  drawerEnabled: boolean;
  stackedDrawerEnabled: boolean;
}

export interface AuditableJSONOption {
  typename: "AuditableJSONOption";
  auditableFieldName: string;
}

export interface CountdownOption {
  typename: "CountdownOption";
  countdownType: 'DATE' | 'DATETIME' | 'DURATION'; // Example types
}

export interface LabelWithCountOption {
  typename: "LabelWithCountOption";
  countField: string;
  prettyCountField: string;
  truncateMiddle: boolean;
}

export interface AmountDifferenceOption {
  typename: "AmountDifferenceOption";
  highlightAmountDifferenceField: string;
}

export interface StatusIndicatorOption {
  typename: "StatusIndicatorOption";
  statusIndicatorCurrentStatusField: string;
  statusIndicatorDescriptorField: string;
  statusIndicatorVerboseField: string;
}

export interface TagOption {
  typename: "TagOption";
  tagColorField: string;
  tagIconField: string;
}

export interface TagButtonListOption {
  typename: "TagButtonListOption";
  tagButtonColorsField: string;
  tagButtonIconsField: string;
  tagButtonHrefsField: string;
  tagButtonTooltipsField: string;
}

export interface AuditableTextOption {
  typename: "AuditableTextOption";
  fieldAsDefaultText: string;
  fullField: string;
  copyable: boolean;
}

export interface LinkOption {
  typename: "LinkOption";
  displayNameField: string;
  openNewTab: boolean;
}

export interface TagListOption {
  typename: "TagListOption";
  tagColorsField: string;
  tagIconsField: string;
}

export interface JSONOption {
  typename: "JSONOption";
  collapsed: boolean;
}

export type DisplayTypeOptions =
  | AssociationOption
  | AssociationListOption
  | PolymorphicAssociationOption
  | AuditableJSONOption
  | CountdownOption
  | LabelWithCountOption
  | AmountDifferenceOption
  | StatusIndicatorOption
  | TagOption
  | TagButtonListOption
  | AuditableTextOption
  | LinkOption
  | TagListOption
  | JSONOption;

export interface DisplayColumn {
  viewOptions?: DisplayColumnViewOptions;
  label: string;
  id: string; // Corresponds to field name in AccountCapability
  type: string; // e.g., "STRING", "NUMBER", "DATE", "ASSOCIATION", "TAG_LIST"
  resource: string;
  sortColumn?: string;
  displayTypeOptions?: DisplayTypeOptions;
  __typename: "DisplayColumn";
}

export interface AccountCapabilityDetailsTableQueryResponse {
  accountCapability: AccountCapability;
  displayColumns: DisplayColumn[];
}

// --- Common UI Components (Mimicking a basic design system) ---

export const Card: React.FC<{ title?: string; children: React.ReactNode; className?: string }> = ({ title, children, className }) => (
  <div className={`bg-white shadow rounded-lg p-4 mb-4 ${className || ''}`}>
    {title && <h3 className="text-lg font-semibold mb-2 text-gray-800">{title}</h3>}
    {children}
  </div>
);

export const Button: React.FC<{ onClick?: () => void; children: React.ReactNode; variant?: 'primary' | 'secondary' | 'danger' | 'ghost'; className?: string; disabled?: boolean; type?: 'button' | 'submit' | 'reset' }> = ({ onClick, children, variant = 'primary', className, disabled, type = 'button' }) => {
  const baseStyle = "px-4 py-2 rounded transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2";
  let variantStyle = "";
  switch (variant) {
    case 'primary': variantStyle = "bg-blue-600 hover:bg-blue-700 text-white"; break;
    case 'secondary': variantStyle = "bg-gray-200 hover:bg-gray-300 text-gray-800"; break;
    case 'danger': variantStyle = "bg-red-600 hover:bg-red-700 text-white"; break;
    case 'ghost': variantStyle = "bg-transparent hover:bg-gray-100 text-gray-800"; break;
  }
  return (
    <button
      type={type}
      onClick={onClick}
      className={`${baseStyle} ${variantStyle} ${disabled ? 'opacity-50 cursor-not-allowed' : ''} ${className || ''}`}
      disabled={disabled}
    >
      {children}
    </button>
  );
};

