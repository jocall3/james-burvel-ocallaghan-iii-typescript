// --- ACH Settings Section (Expanded) ---

const ACH_SETTING_LIST_VIEW_QUERY = gql`
  query ACHSettingListView($id: ID, $showDeleted: String, $immediateOrigin: String, $immediateOriginName: String, $immediateDestination: String, $immediateDestinationName: String, $first: Int, $after: String, $last: Int, $before: String, $status: String, $searchQuery: String) {
    achSettings(
      id: $id
      showDeleted: $showDeleted
      immediateOrigin: $immediateOrigin
      immediateOriginName: $immediateOriginName
      immediateDestination: $immediateDestination
      immediateDestinationName: $immediateDestinationName
      first: $first
      after: $after
      last: $last
      before: $before
      status: $status # New filter
      searchQuery: $searchQuery # New filter
    ) {
      edges {
        node {
          id
          prettyImmediateOrigin
          immediateOriginName
          immediateDestination
          immediateDestinationName
          createdAt
          updatedAt # Added field
          discardedAt
          status # Added field: ACTIVE, PENDING, DISCARDED
          path
          __typename
        }
        __typename
      }
      pageInfo {
        startCursor
        endCursor
        hasNextPage
        hasPreviousPage
        __typename
      }
      __typename
    }
    abilities { # Added abilities for creation
      ACHSetting {
        canCreate
        canUpdate
        canDiscard
        __typename
      }
      __typename
    }
  }
`;

interface ACHSettingNode {
  id: string;
  prettyImmediateOrigin: string;
  immediateOriginName: string;
  immediateDestination: string;
  immediateDestinationName: string;
  createdAt: string;
  updatedAt: string;
  discardedAt: string | null;
  status: 'ACTIVE' | 'PENDING' | 'DISCARDED';
  path: string;
  __typename: string;
}

interface ACHSettingListViewData {
  achSettings: {
    edges: { node: ACHSettingNode; __typename: string }[];
    pageInfo: {
      startCursor: string | null;
      endCursor: string | null;
      hasNextPage: boolean;
      hasPreviousPage: boolean;
      __typename: string;
    };
    __typename: string;
  };
  abilities: {
    ACHSetting: {
      canCreate: boolean;
      canUpdate: boolean;
      canDiscard: boolean;
      __typename: string;
    };
    __typename: string;
  };
}

const DISCARD_ACH_SETTING_MUTATION = gql`
  mutation DiscardACHSetting($id: ID!) {
    discardAchSetting(input: { id: $id }) {
      achSetting {
        id
        discardedAt
        status
        __typename
      }
      errors
      __typename
    }
  }
`;

export const ACHSettingsList: React.FC = () => {
  const [filters, setFilters] = useState({
    searchQuery: '',
    status: '',
    showDeleted: 'false',
  });
  const { showNotification } = useAppContext();

  const variables = useMemo(() => ({
    first: 10,
    searchQuery: filters.searchQuery || null,
    status: filters.status || null,
    showDeleted: filters.showDeleted,
  }), [filters]);

  const { loading, error, data, fetchMore, refetch } = useQuery<ACHSettingListViewData>(ACH_SETTING_LIST_VIEW_QUERY, {
    variables,
    notifyOnNetworkStatusChange: true,
  });

  const [discardAchSetting, { loading: discarding }] = useMutation(DISCARD_ACH_SETTING_MUTATION, {
    onCompleted: (result) => {
      if (result.discardAchSetting.errors) {
        showNotification(`Error discarding ACH setting: ${result.discardAchSetting.errors.join(', ')}`, 'error');
      } else {
        showNotification(`ACH Setting ${result.discardAchSetting.achSetting.id} discarded successfully.`, 'success');
        refetch(); // Refetch the list to show updated status
      }
    },
    onError: (err) => {
      showNotification(`Error discarding ACH setting: ${err.message}`, 'error');
    },
  });

  const handleFilterChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setFilters(prev => ({ ...prev, [name]: value }));
  };

  const handleDiscard = async (id: string) => {
    if (window.confirm('Are you sure you want to discard this ACH setting? This action cannot be undone.')) {
      await discardAchSetting({ variables: { id } });
    }
  };

  const loadMore = useCallback(() => {
    if (data?.achSettings.pageInfo.hasNextPage && !loading) {
      fetchMore({
        variables: { after: data.achSettings.pageInfo.endCursor, ...variables },
        updateQuery: (prev, { fetchMoreResult }) => {
          if (!fetchMoreResult) return prev;
          return {
            achSettings: {
              ...fetchMoreResult.achSettings,
              edges: [
                ...prev.achSettings.edges,
                ...fetchMoreResult.achSettings.edges,
              ],
            },
            abilities: prev.abilities, // Preserve abilities
          };
        },
      });
    }
  }, [data, fetchMore, loading, variables]);

  if (loading && !data) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;

  const canCreate = data?.abilities.ACHSetting.canCreate;
  const canUpdate = data?.abilities.ACHSetting.canUpdate;
  const canDiscard = data?.abilities.ACHSetting.canDiscard;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">ACH Settings</h2>
      <div className="flex flex-wrap items-center gap-4 mb-6">
        <input
          type="text"
          name="searchQuery"
          placeholder="Search by Origin/Destination Name..."
          value={filters.searchQuery}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 flex-grow max-w-sm"
        />
        <select
          name="status"
          value={filters.status}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All Statuses</option>
          <option value="ACTIVE">Active</option>
          <option value="PENDING">Pending</option>
          <option value="DISCARDED">Discarded</option>
        </select>
        <select
          name="showDeleted"
          value={filters.showDeleted}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="false">Hide Discarded</option>
          <option value="true">Show All (Incl. Discarded)</option>
        </select>
        {canCreate && (
          <Link to="/ach-settings/new" className="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 transition duration-200 flex-shrink-0">
            <i className="fas fa-plus mr-2"></i> Create New ACH Setting
          </Link>
        )}
      </div>

      <div className="bg-white shadow-md rounded-lg overflow-hidden">
        <table className="min-w-full divide-y divide-gray-200">
          <thead className="bg-gray-50">
            <tr>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Origin</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Origin Name</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Destination</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created At</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody className="bg-white divide-y divide-gray-200">
            {data?.achSettings.edges.length === 0 ? (
              <tr>
                <td colSpan={7} className="px-6 py-4 text-center text-gray-500">No ACH settings found.</td>
              </tr>
            ) : (
              data?.achSettings.edges.map(({ node }) => (
                <tr key={node.id}>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.id}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.prettyImmediateOrigin}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.immediateOriginName}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.immediateDestination}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{new Date(node.createdAt).toLocaleDateString()}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm">
                    <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${node.status === 'DISCARDED' ? 'bg-red-100 text-red-800' : node.status === 'PENDING' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800'}`}>
                      {node.status}
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <Link to={`/ach-settings/${node.id}`} className="text-indigo-600 hover:text-indigo-900 mr-2">View</Link>
                    {canUpdate && node.status !== 'DISCARDED' && (
                      <Link to={`/ach-settings/${node.id}/edit`} className="text-yellow-600 hover:text-yellow-900 mr-2">Edit</Link>
                    )}
                    {canDiscard && node.status !== 'DISCARDED' && (
                      <button
                        onClick={() => handleDiscard(node.id)}
                        className="text-red-600 hover:text-red-900"
                        disabled={discarding}
                      >
                        {discarding ? 'Discarding...' : 'Discard'}
                      </button>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
        {data?.achSettings.pageInfo.hasNextPage && (
          <div className="p-4 text-center border-t border-gray-200">
            <button
              onClick={loadMore}
              className="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition duration-200"
              disabled={loading}
            >
              {loading ? 'Loading...' : 'Load More'}
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

// --- ACH Setting Details (Expanded) ---
const ACH_SETTING_DETAILS_QUERY = gql`
  query ACHSettingDetailsTable($id: ID!) {
    achSetting(id: $id) {
      id
      path
      prettyImmediateOrigin
      immediateOriginName
      immediateDestination
      immediateDestinationName
      createdAt
      updatedAt
      discardedAt
      status
      authorizationPolicy { # Added field
        id
        name
        description
        __typename
      }
      contactPerson { # Added field
        id
        name
        email
        phone
        __typename
      }
      riskScore # Added field
      __typename
    }
  }
`;

interface AuthorizationPolicy {
  id: string;
  name: string;
  description: string;
  __typename: string;
}

interface ContactPerson {
  id: string;
  name: string;
  email: string;
  phone: string;
  __typename: string;
}

interface ACHSettingNodeDetails extends ACHSettingNode {
  updatedAt: string;
  status: 'ACTIVE' | 'PENDING' | 'DISCARDED';
  authorizationPolicy: AuthorizationPolicy | null;
  contactPerson: ContactPerson | null;
  riskScore: number;
}

interface ACHSettingDetailsData {
  achSetting: ACHSettingNodeDetails;
}

export const ACHSettingDetails: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { loading, error, data } = useQuery<ACHSettingDetailsData>(ACH_SETTING_DETAILS_QUERY, {
    variables: { id },
  });

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;
  if (!data?.achSetting) return <p className="text-center p-4">ACH Setting not found.</p>;

  const setting = data.achSetting;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">ACH Setting Details: {setting.immediateOriginName}</h2>
      <div className="bg-white shadow-md rounded-lg p-6 max-w-3xl mx-auto">
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <DetailItem label="ID" value={setting.id} />
          <DetailItem label="Path" value={setting.path} />
          <DetailItem label="Immediate Origin" value={setting.prettyImmediateOrigin} />
          <DetailItem label="Origin Name" value={setting.immediateOriginName} />
          <DetailItem label="Immediate Destination" value={setting.immediateDestination} />
          <DetailItem label="Destination Name" value={setting.immediateDestinationName} />
          <DetailItem label="Created At" value={new Date(setting.createdAt).toLocaleString()} />
          <DetailItem label="Last Updated" value={new Date(setting.updatedAt).toLocaleString()} />
          <DetailItem label="Discarded At" value={setting.discardedAt ? new Date(setting.discardedAt).toLocaleString() : 'N/A'} />
          <DetailItem label="Status" value={
            <span className={`px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${setting.status === 'DISCARDED' ? 'bg-red-100 text-red-800' : setting.status === 'PENDING' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800'}`}>
              {setting.status}
            </span>
          } />
          <DetailItem label="Risk Score" value={setting.riskScore} className="col-span-2" />
        </div>

        {setting.authorizationPolicy && (
          <div className="mb-6 border-t pt-4">
            <h3 className="text-xl font-semibold text-gray-800 mb-2">Authorization Policy</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <DetailItem label="Policy Name" value={setting.authorizationPolicy.name} />
              <DetailItem label="Policy ID" value={setting.authorizationPolicy.id} />
              <DetailItem label="Description" value={setting.authorizationPolicy.description} className="md:col-span-2" />
            </div>
          </div>
        )}

        {setting.contactPerson && (
          <div className="mb-6 border-t pt-4">
            <h3 className="text-xl font-semibold text-gray-800 mb-2">Contact Person</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <DetailItem label="Name" value={setting.contactPerson.name} />
              <DetailItem label="Email" value={setting.contactPerson.email} />
              <DetailItem label="Phone" value={setting.contactPerson.phone} />
            </div>
          </div>
        )}

        <div className="flex justify-end space-x-2 mt-6">
          <button
            onClick={() => window.history.back()}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
          >
            Back
          </button>
          {authService.hasRole('Admin') && setting.status !== 'DISCARDED' && (
            <Link to={`/ach-settings/${setting.id}/edit`} className="bg-indigo-500 text-white px-4 py-2 rounded-md hover:bg-indigo-600 transition duration-200">
              Edit ACH Setting
            </Link>
          )}
        </div>
      </div>
    </div>
  );
};

const CREATE_ACH_SETTING_MUTATION = gql`
  mutation CreateACHSetting($input: CreateACHSettingInput!) {
    createAchSetting(input: $input) {
      achSetting {
        id
        immediateOriginName
        status
        __typename
      }
      errors
      __typename
    }
  }
`;

const UPDATE_ACH_SETTING_MUTATION = gql`
  mutation UpdateACHSetting($input: UpdateACHSettingInput!) {
    updateAchSetting(input: $input) {
      achSetting {
        id
        immediateOriginName
        immediateOrigin
        immediateDestination
        immediateDestinationName
        status
        updatedAt
        __typename
      }
      errors
      __typename
    }
  }
`;

// New: ACH Setting Form Component for Create/Edit
export const ACHSettingForm: React.FC = () => {
  const { id } = useParams<{ id?: string }>();
  const navigate = useNavigate();
  const { showNotification } = useAppContext();

  const isEditMode = !!id;

  const [formData, setFormData] = useState({
    immediateOrigin: '',
    immediateOriginName: '',
    immediateDestination: '',
    immediateDestinationName: '',
    authorizationPolicyId: '', // New field
    contactPersonId: '', // New field
    riskScore: 0, // New field
    notes: '', // New field
  });
  const [formErrors, setFormErrors] = useState<Record<string, string>>({});

  // Fetch initial data for edit mode
  const { data: achSettingData, loading: achSettingLoading, error: achSettingError } = useQuery<ACHSettingDetailsData>(ACH_SETTING_DETAILS_QUERY, {
    variables: { id: id! },
    skip: !isEditMode,
  });

  // Example query for Authorization Policies (simulated)
  const AUTHORIZATION_POLICIES_QUERY = gql`
    query AuthorizationPolicies {
      authorizationPolicies {
        id
        name
        description
        __typename
      }
    }
  `;
  const { data: policiesData, loading: policiesLoading } = useQuery<{ authorizationPolicies: AuthorizationPolicy[] }>(AUTHORIZATION_POLICIES_QUERY);
  const availablePolicies = policiesData?.authorizationPolicies || [];

  // Example query for Contact Persons (simulated)
  const CONTACT_PERSONS_QUERY = gql`
    query ContactPersons {
      contactPersons {
        id
        name
        email
        __typename
      }
    }
  `;
  const { data: contactsData, loading: contactsLoading } = useQuery<{ contactPersons: ContactPerson[] }>(CONTACT_PERSONS_QUERY);
  const availableContacts = contactsData?.contactPersons || [];


  useEffect(() => {
    if (isEditMode && achSettingData?.achSetting) {
      const setting = achSettingData.achSetting;
      setFormData({
        immediateOrigin: setting.prettyImmediateOrigin, // Assuming prettyImmediateOrigin can be used for input, or a separate field would exist
        immediateOriginName: setting.immediateOriginName,
        immediateDestination: setting.immediateDestination,
        immediateDestinationName: setting.immediateDestinationName,
        authorizationPolicyId: setting.authorizationPolicy?.id || '',
        contactPersonId: setting.contactPerson?.id || '',
        riskScore: setting.riskScore || 0,
        notes: '', // Placeholder, would fetch if available in schema
      });
    }
  }, [isEditMode, achSettingData]);

  const [createAchSetting, { loading: createLoading }] = useMutation(CREATE_ACH_SETTING_MUTATION, {
    onCompleted: (result) => {
      if (result.createAchSetting.errors && result.createAchSetting.errors.length > 0) {
        showNotification(`Error creating ACH setting: ${result.createAchSetting.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.createAchSetting.errors.join(', ') });
      } else {
        showNotification(`ACH Setting '${result.createAchSetting.achSetting.immediateOriginName}' created successfully!`, 'success');
        navigate(`/ach-settings/${result.createAchSetting.achSetting.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error creating ACH setting: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const [updateAchSetting, { loading: updateLoading }] = useMutation(UPDATE_ACH_SETTING_MUTATION, {
    onCompleted: (result) => {
      if (result.updateAchSetting.errors && result.updateAchSetting.errors.length > 0) {
        showNotification(`Error updating ACH setting: ${result.updateAchSetting.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.updateAchSetting.errors.join(', ') });
      } else {
        showNotification(`ACH Setting '${result.updateAchSetting.achSetting.immediateOriginName}' updated successfully!`, 'success');
        navigate(`/ach-settings/${result.updateAchSetting.achSetting.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error updating ACH setting: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const loading = createLoading || updateLoading || achSettingLoading || policiesLoading || contactsLoading;
  const error = achSettingError; // General error for fetching data

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value, type } = e.target;
    if (type === 'number') {
      setFormData({ ...formData, [name]: parseFloat(value) });
    } else {
      setFormData({ ...formData, [name]: value });
    }
    setFormErrors(prev => ({ ...prev, [name]: '' }));
  };

  const validateForm = () => {
    const errors: Record<string, string> = {};
    if (!formData.immediateOrigin.trim()) errors.immediateOrigin = 'Immediate Origin is required.';
    if (!formData.immediateOriginName.trim()) errors.immediateOriginName = 'Immediate Origin Name is required.';
    if (!formData.immediateDestination.trim()) errors.immediateDestination = 'Immediate Destination is required.';
    if (!formData.immediateDestinationName.trim()) errors.immediateDestinationName = 'Immediate Destination Name is required.';
    if (formData.riskScore < 0 || formData.riskScore > 100) errors.riskScore = 'Risk score must be between 0 and 100.';
    // Add more complex validation (e.g., regex for origin/destination codes)

    setFormErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormErrors({}); // Clear previous errors
    if (!validateForm()) {
      showNotification('Please correct the errors in the form.', 'error');
      return;
    }

    const input = {
      immediateOrigin: formData.immediateOrigin,
      immediateOriginName: formData.immediateOriginName,
      immediateDestination: formData.immediateDestination,
      immediateDestinationName: formData.immediateDestinationName,
      authorizationPolicyId: formData.authorizationPolicyId || null,
      contactPersonId: formData.contactPersonId || null,
      riskScore: formData.riskScore,
      notes: formData.notes,
      // Add other relevant fields
    };

    try {
      if (isEditMode) {
        await updateAchSetting({ variables: { input: { id: id!, ...input } } });
      } else {
        await createAchSetting({ variables: { input } });
      }
    } catch (err: any) {
      // Errors are handled by onError callback of useMutation
    }
  };

  if (isEditMode && achSettingLoading) return <LoadingSpinner />;
  if (isEditMode && error) return <ErrorMessage message={error.message} />;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">{isEditMode ? `Edit ACH Setting: ${achSettingData?.achSetting.immediateOriginName}` : 'Create New ACH Setting'}</h2>

      <form onSubmit={handleSubmit} className="bg-white shadow-md rounded-lg p-6 max-w-3xl mx-auto space-y-6">
        {formErrors.submit && <ErrorMessage message={formErrors.submit} />}
        {error && <ErrorMessage message={error.message} />}

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {/* Immediate Origin */}
          <div>
            <label htmlFor="immediateOrigin" className="block text-sm font-medium text-gray-700 mb-1">Immediate Origin <span className="text-red-500">*</span></label>
            <input
              type="text"
              id="immediateOrigin"
              name="immediateOrigin"
              value={formData.immediateOrigin}
              onChange={handleChange}
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.immediateOrigin ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
              required
              maxLength={10} // ACH specific field length
              placeholder="e.g., 123456789"
            />
            {formErrors.immediateOrigin && <p className="mt-1 text-sm text-red-600">{formErrors.immediateOrigin}</p>}
          </div>

          {/* Immediate Origin Name */}
          <div>
            <label htmlFor="immediateOriginName" className="block text-sm font-medium text-gray-700 mb-1">Immediate Origin Name <span className="text-red-500">*</span></label>
            <input
              type="text"
              id="immediateOriginName"
              name="immediateOriginName"
              value={formData.immediateOriginName}
              onChange={handleChange}
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.immediateOriginName ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
              required
              maxLength={23} // ACH specific field length
              placeholder="Your Company Name"
            />
            {formErrors.immediateOriginName && <p className="mt-1 text-sm text-red-600">{formErrors.immediateOriginName}</p>}
          </div>

          {/* Immediate Destination */}
          <div>
            <label htmlFor="immediateDestination" className="block text-sm font-medium text-gray-700 mb-1">Immediate Destination <span className="text-red-500">*</span></label>
            <input
              type="text"
              id="immediateDestination"
              name="immediateDestination"
              value={formData.immediateDestination}
              onChange={handleChange}
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.immediateDestination ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
              required
              maxLength={8} // ACH specific field length
              placeholder="e.g., 01234567"
            />
            {formErrors.immediateDestination && <p className="mt-1 text-sm text-red-600">{formErrors.immediateDestination}</p>}
          </div>

          {/* Immediate Destination Name */}
          <div>
            <label htmlFor="immediateDestinationName" className="block text-sm font-medium text-gray-700 mb-1">Immediate Destination Name <span className="text-red-500">*</span></label>
            <input
              type="text"
              id="immediateDestinationName"
              name="immediateDestinationName"
              value={formData.immediateDestinationName}
              onChange={handleChange}
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.immediateDestinationName ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
              required
              maxLength={23} // ACH specific field length
              placeholder="Destination Financial Institution"
            />
            {formErrors.immediateDestinationName && <p className="mt-1 text-sm text-red-600">{formErrors.immediateDestinationName}</p>}
          </div>

          {/* Authorization Policy Selector */}
          <div>
            <label htmlFor="authorizationPolicyId" className="block text-sm font-medium text-gray-700 mb-1">Authorization Policy</label>
            <select
              id="authorizationPolicyId"
              name="authorizationPolicyId"
              value={formData.authorizationPolicyId}
              onChange={handleChange}
              className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
            >
              <option value="">-- Select a policy --</option>
              {availablePolicies.map(policy => (
                <option key={policy.id} value={policy.id}>{policy.name}</option>
              ))}
            </select>
          </div>

          {/* Contact Person Selector */}
          <div>
            <label htmlFor="contactPersonId" className="block text-sm font-medium text-gray-700 mb-1">Contact Person</label>
            <select
              id="contactPersonId"
              name="contactPersonId"
              value={formData.contactPersonId}
              onChange={handleChange}
              className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
            >
              <option value="">-- Select a contact --</option>
              {availableContacts.map(contact => (
                <option key={contact.id} value={contact.id}>{contact.name} ({contact.email})</option>
              ))}
            </select>
          </div>
          {/* Risk Score Field */}
          <div>
            <label htmlFor="riskScore" className="block text-sm font-medium text-gray-700 mb-1">Risk Score (0-100)</label>
            <input
              type="number"
              id="riskScore"
              name="riskScore"
              value={formData.riskScore}
              onChange={handleChange}
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.riskScore ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
              min="0"
              max="100"
              placeholder="e.g., 50"
            />
            {formErrors.riskScore && <p className="mt-1 text-sm text-red-600">{formErrors.riskScore}</p>}
          </div>

          {/* Notes Textarea */}
          <div className="md:col-span-2">
            <label htmlFor="notes" className="block text-sm font-medium text-gray-700 mb-1">Notes</label>
            <textarea
              id="notes"
              name="notes"
              value={formData.notes}
              onChange={handleChange}
              rows={3}
              className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
              placeholder="Add any internal notes regarding this ACH setting..."
            ></textarea>
          </div>
        </div>


        <div className="flex justify-end space-x-2 mt-6">
          <button
            type="button"
            onClick={() => navigate('/ach-settings')}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
            disabled={loading}
          >
            Cancel
          </button>
          <button
            type="submit"
            className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition duration-200"
            disabled={loading}
          >
            {loading ? 'Saving...' : (isEditMode ? 'Update ACH Setting' : 'Create ACH Setting')}
          </button>
        </div>
      </form>
    </div>
  );
};

// --- API Keys Section (Expanded with Decommission Mutation) ---

const API_KEYS_HOME_QUERY = gql`
  query APIKeysHome($first: Int, $after: String, $last: Int, $before: String, $name: String, $showDecommissioned: Boolean, $liveMode: Boolean, $roleId: ID) { # Changed showDeleted to showDecommissioned and added liveMode, roleId filters
    apiKeys(
      first: $first
      after: $after
      last: $last
      before: $before
      name: $name
      showDecommissioned: $showDecommissioned # Updated field name
      liveMode: $liveMode # New filter
      roleId: $roleId # New filter
    ) {
      edges {
        node {
          id
          name
          prettyIpAllowlist
          createdAt
          decommissionedAt
          liveMode
          path
          rolesV2 { # Added roles to list view
            id
            name
            __typename
          }
          __typename
        }
        __typename
      }
      pageInfo {
        startCursor
        endCursor
        hasNextPage
        hasPreviousPage
        __typename
      }
      __typename
    }
    abilities {
      APIKey {
        canUpdate
        canCreate
        canDecommission # Added canDecommission
        __typename
      }
      __typename
    }
    rolesUnpaginated { # Fetch roles for filter dropdown
      id
      name
      __typename
    }
  }
`;

interface APIKeyNode {
  id: string;
  name: string;
  prettyIpAllowlist: string;
  createdAt: string;
  decommissionedAt: string | null;
  liveMode: boolean;
  path: string;
  rolesV2: { id: string; name: string; __typename: string }[]; // Added for list
  __typename: string;
}

interface APIKeysHomeData {
  apiKeys: {
    edges: { node: APIKeyNode; __typename: string }[];
    pageInfo: {
      startCursor: string | null;
      endCursor: string | null;
      hasNextPage: boolean;
      hasPreviousPage: boolean;
      __typename: string;
    };
    __typename: string;
  };
  abilities: {
    APIKey: {
      canUpdate: boolean;
      canCreate: boolean;
      canDecommission: boolean;
      __typename: string;
    };
    __typename: string;
  };
  rolesUnpaginated: Role[];
}

const DECOMMISSION_API_KEY_MUTATION = gql`
  mutation DecommissionAPIKey($id: ID!) {
    decommissionApiKey(input: { id: $id }) {
      apiKey {
        id
        decommissionedAt
        __typename
      }
      errors
      __typename
    }
  }
`;

export const APIKeysList: React.FC = () => {
  const [filters, setFilters] = useState({
    name: '',
    showDecommissioned: false,
    liveMode: '' as 'true' | 'false' | '', // Explicitly define type
    roleId: '',
  });
  const { showNotification } = useAppContext();

  const variables = useMemo(() => ({
    first: 10,
    name: filters.name || null,
    showDecommissioned: filters.showDecommissioned,
    liveMode: filters.liveMode === '' ? null : filters.liveMode === 'true',
    roleId: filters.roleId || null,
  }), [filters]);

  const { loading, error, data, fetchMore, refetch } = useQuery<APIKeysHomeData>(API_KEYS_HOME_QUERY, {
    variables,
    notifyOnNetworkStatusChange: true,
  });

  const [decommissionApiKey, { loading: decommissioning }] = useMutation(DECOMMISSION_API_KEY_MUTATION, {
    onCompleted: (result) => {
      if (result.decommissionApiKey.errors) {
        showNotification(`Error decommissioning API Key: ${result.decommissionApiKey.errors.join(', ')}`, 'error');
      } else {
        showNotification(`API Key ${result.decommissionApiKey.apiKey.id} decommissioned successfully.`, 'success');
        refetch(); // Refetch the list to show updated status
      }
    },
    onError: (err) => {
      showNotification(`Error decommissioning API Key: ${err.message}`, 'error');
    },
  });

  const handleFilterChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value, type } = e.target;
    if (type === 'checkbox') {
      setFilters(prev => ({ ...prev, [name]: (e.target as HTMLInputElement).checked }));
    } else {
      setFilters(prev => ({ ...prev, [name]: value }));
    }
  };

  const handleDecommission = async (id: string) => {
    if (window.confirm('Are you sure you want to decommission this API Key? It will no longer be usable.')) {
      await decommissionApiKey({ variables: { id } });
    }
  };

  const loadMore = useCallback(() => {
    if (data?.apiKeys.pageInfo.hasNextPage && !loading) {
      fetchMore({
        variables: { after: data.apiKeys.pageInfo.endCursor, ...variables },
        updateQuery: (prev, { fetchMoreResult }) => {
          if (!fetchMoreResult) return prev;
          return {
            apiKeys: {
              ...fetchMoreResult.apiKeys,
              edges: [
                ...prev.apiKeys.edges,
                ...fetchMoreResult.apiKeys.edges,
              ],
            },
            abilities: prev.abilities, // Preserve abilities
            rolesUnpaginated: prev.rolesUnpaginated, // Preserve roles
          };
        },
      });
    }
  }, [data, fetchMore, loading, variables]);

  if (loading && !data) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;

  const canCreate = data?.abilities.APIKey.canCreate;
  const canUpdate = data?.abilities.APIKey.canUpdate;
  const canDecommission = data?.abilities.APIKey.canDecommission;
  const availableRoles = data?.rolesUnpaginated || [];

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">API Keys Management</h2>

      <div className="flex flex-wrap items-center gap-4 mb-6">
        <input
          type="text"
          placeholder="Filter by Name..."
          className="p-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 flex-grow max-w-xs"
          value={filters.name}
          name="name"
          onChange={handleFilterChange}
        />
        <select
          className="p-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500"
          value={filters.liveMode}
          name="liveMode"
          onChange={handleFilterChange}
        >
          <option value="">All Modes</option>
          <option value="true">Live Mode</option>
          <option value="false">Sandbox Mode</option>
        </select>
        <select
          className="p-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500"
          value={filters.roleId}
          name="roleId"
          onChange={handleFilterChange}
        >
          <option value="">All Roles</option>
          {availableRoles.map(role => (
            <option key={role.id} value={role.id}>{role.name}</option>
          ))}
        </select>
        <div className="flex items-center">
          <input
            type="checkbox"
            id="showDecommissioned"
            name="showDecommissioned"
            checked={filters.showDecommissioned}
            onChange={handleFilterChange}
            className="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
          />
          <label htmlFor="showDecommissioned" className="ml-2 block text-sm text-gray-900">
            Show Decommissioned
          </label>
        </div>
        {canCreate && (
          <Link to="/api-keys/new" className="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 self-center transition duration-200 flex-shrink-0">
            <i className="fas fa-plus mr-2"></i> Create New API Key
          </Link>
        )}
      </div>

      <div className="bg-white shadow-md rounded-lg overflow-hidden">
        <table className="min-w-full divide-y divide-gray-200">
          <thead className="bg-gray-50">
            <tr>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Roles</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">IP Allowlist</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created At</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mode</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody className="bg-white divide-y divide-gray-200">
            {data?.apiKeys.edges.length === 0 ? (
              <tr>
                <td colSpan={8} className="px-6 py-4 text-center text-gray-500">No API keys found.</td>
              </tr>
            ) : (
              data?.apiKeys.edges.map(({ node }) => (
                <tr key={node.id}>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.id}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.name}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    {node.rolesV2.map(r => r.name).join(', ') || 'N/A'}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.prettyIpAllowlist}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{new Date(node.createdAt).toLocaleDateString()}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm">
                    <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${node.liveMode ? 'bg-blue-100 text-blue-800' : 'bg-purple-100 text-purple-800'}`}>
                      {node.liveMode ? 'Live' : 'Sandbox'}
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm">
                    <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${node.decommissionedAt ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`}>
                      {node.decommissionedAt ? 'Decommissioned' : 'Active'}
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <Link to={`/api-keys/${node.id}`} className="text-indigo-600 hover:text-indigo-900 mr-2">View</Link>
                    {canUpdate && (
                      <Link to={`/api-keys/${node.id}/edit`} className="text-yellow-600 hover:text-yellow-900 mr-2">Edit</Link>
                    )}
                    {canDecommission && !node.decommissionedAt && (
                      <button
                        onClick={() => handleDecommission(node.id)}
                        className="text-red-600 hover:text-red-900"
                        disabled={decommissioning}
                      >
                        {decommissioning ? 'Decommissioning...' : 'Decommission'}
                      </button>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
        {data?.apiKeys.pageInfo.hasNextPage && (
          <div className="p-4 text-center border-t border-gray-200">
            <button
              onClick={loadMore}
              className="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition duration-200"
              disabled={loading}
            >
              {loading ? 'Loading...' : 'Load More'}
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

// --- API Key Details (Expanded) ---
const API_KEY_VIEW_QUERY = gql`
  query ApiKeyView($id: ID!) {
    apiKey(id: $id) {
      id
      name
      roles
      default
      decommissionedAt
      ipAllowlist
      liveMode
      rateLimit
      createdAt
      updatedAt # Added field
      creator {
        id
        name
        path
        __typename
      }
      rolesV2 {
        name
        id
        roleType
        __typename
      }
      permissions {
        resource
        actions
        __typename
      }
      lastUsed # Added field (timestamp or date)
      expiresAt # Added field
      metadata { # Added generic metadata field
        key
        value
        __typename
      }
      __typename
    }
    abilities {
      APIKey {
        canUpdate
        canDecommission
        __typename
      }
      __typename
    }
  }
`;

interface MetadataItem {
  key: string;
  value: string;
  __typename: string;
}

interface ApiKeyViewData {
  apiKey: {
    id: string;
    name: string;
    roles: string[];
    default: boolean;
    decommissionedAt: string | null;
    ipAllowlist: string[];
    liveMode: boolean;
    rateLimit: number | null; // Can be null for unlimited
    createdAt: string;
    updatedAt: string;
    creator: {
      id: string;
      name: string;
      path: string;
      __typename: string;
    };
    rolesV2: {
      name: string;
      id: string;
      roleType: string;
      __typename: string;
    }[];
    permissions: {
      resource: string;
      actions: string[];
      __typename: string;
    }[];
    lastUsed: string | null;
    expiresAt: string | null;
    metadata: MetadataItem[];
    __typename: string;
  };
  abilities: {
    APIKey: {
      canUpdate: boolean;
      canDecommission: boolean;
      __typename: string;
    };
    __typename: string;
  };
}

export const APIKeyDetails: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { loading, error, data } = useQuery<ApiKeyViewData>(API_KEY_VIEW_QUERY, {
    variables: { id },
  });
  const navigate = useNavigate();
  const { showNotification } = useAppContext();

  const [decommissionApiKey, { loading: decommissioning }] = useMutation(DECOMMISSION_API_KEY_MUTATION, {
    onCompleted: (result) => {
      if (result.decommissionApiKey.errors) {
        showNotification(`Error decommissioning API Key: ${result.decommissionApiKey.errors.join(', ')}`, 'error');
      } else {
        showNotification(`API Key ${result.decommissionApiKey.apiKey.id} decommissioned successfully.`, 'success');
        navigate('/api-keys'); // Navigate back to list after decommissioning
      }
    },
    onError: (err) => {
      showNotification(`Error decommissioning API Key: ${err.message}`, 'error');
    },
  });

  const handleDecommission = async () => {
    if (window.confirm('Are you sure you want to decommission this API Key? It will no longer be usable.')) {
      await decommissionApiKey({ variables: { id: id! } });
    }
  };


  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;
  if (!data?.apiKey) return <p className="text-center p-4">API Key not found.</p>;

  const apiKey = data.apiKey;
  const canUpdate = data.abilities.APIKey.canUpdate;
  const canDecommission = data.abilities.APIKey.canDecommission;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">API Key Details: {apiKey.name}</h2>
      <div className="bg-white shadow-md rounded-lg p-6 max-w-4xl mx-auto">
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6 border-b pb-4">
          <DetailItem label="ID" value={apiKey.id} />
          <DetailItem label="Name" value={apiKey.name} />
          <DetailItem label="Live Mode" value={apiKey.liveMode ? 'Yes' : 'No'} />
          <DetailItem label="Default" value={apiKey.default ? 'Yes' : 'No'} />
          <DetailItem label="Rate Limit" value={apiKey.rateLimit ? `${apiKey.rateLimit} req/min` : 'Unlimited'} />
          <DetailItem label="Created At" value={new Date(apiKey.createdAt).toLocaleString()} />
          <DetailItem label="Last Updated" value={new Date(apiKey.updatedAt).toLocaleString()} />
          <DetailItem label="Last Used" value={apiKey.lastUsed ? new Date(apiKey.lastUsed).toLocaleString() : 'Never'} />
          <DetailItem label="Expires At" value={apiKey.expiresAt ? new Date(apiKey.expiresAt).toLocaleString() : 'Never'} />
          <DetailItem label="Creator" value={apiKey.creator?.name || 'N/A'} link={apiKey.creator?.path ? `/users/${apiKey.creator.id}` : undefined} />
          <DetailItem label="Status" value={
            <span className={`px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${apiKey.decommissionedAt ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`}>
              {apiKey.decommissionedAt ? 'Decommissioned' : 'Active'}
            </span>
          } />
        </div>

        <div className="mb-6 border-b pb-4">
          <h3 className="text-xl font-semibold text-gray-800 mb-2">IP Allowlist</h3>
          <ul className="list-disc list-inside text-gray-700 ml-4">
            {apiKey.ipAllowlist && apiKey.ipAllowlist.length > 0 ? (
              apiKey.ipAllowlist.map((ip, index) => <li key={index} className="py-1">{ip}</li>)
            ) : (
              <li className="text-gray-500">None specified (Any IP allowed)</li>
            )}
          </ul>
        </div>

        <div className="mb-6 border-b pb-4">
          <h3 className="text-xl font-semibold text-gray-800 mb-2">Assigned Roles</h3>
          <ul className="list-disc list-inside text-gray-700 ml-4">
            {apiKey.rolesV2 && apiKey.rolesV2.length > 0 ? (
              apiKey.rolesV2.map((role) => <li key={role.id} className="py-1">{role.name} (<span className="text-gray-500">{role.roleType}</span>)</li>)
            ) : (
              <li className="text-gray-500">No roles assigned</li>
            )}
          </ul>
        </div>

        <div className="mb-6 border-b pb-4">
          <h3 className="text-xl font-semibold text-gray-800 mb-2">Permissions Summary</h3>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {apiKey.permissions && apiKey.permissions.length > 0 ? (
              apiKey.permissions.map((perm, index) => (
                <div key={index} className="border border-gray-200 rounded-md p-3 bg-gray-50 hover:shadow-sm">
                  <p className="font-medium text-gray-800">{perm.resource}</p>
                  <p className="text-sm text-gray-600 mt-1">Actions: <span className="font-mono text-xs">{perm.actions.join(', ')}</span></p>
                </div>
              ))
            ) : (
              <p className="text-gray-700 col-span-2">No specific permissions configured.</p>
            )}
          </div>
        </div>

        {apiKey.metadata && apiKey.metadata.length > 0 && (
          <div className="mb-6 border-b pb-4">
            <h3 className="text-xl font-semibold text-gray-800 mb-2">Metadata</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {apiKey.metadata.map((item, index) => (
                <DetailItem key={index} label={item.key} value={item.value} />
              ))}
            </div>
          </div>
        )}

        <div className="flex justify-end space-x-2 mt-6">
          <button
            onClick={() => navigate('/api-keys')}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
          >
            Back to List
          </button>
          {canUpdate && (
            <Link to={`/api-keys/${apiKey.id}/edit`} className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition duration-200">
              Edit API Key
            </Link>
          )}
          {canDecommission && !apiKey.decommissionedAt && (
            <button
              onClick={handleDecommission}
              className="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 transition duration-200"
              disabled={decommissioning}
            >
              {decommissioning ? 'Decommissioning...' : 'Decommission API Key'}
            </button>
          )}
        </div>
      </div>
    </div>
  );
};

