        id
        name
        keySecret # Only returned on creation
        __typename
      }
      errors
      __typename
    }
  }
`;

export const UPDATE_API_KEY_MUTATION = gql`
  mutation UpdateAPIKey($input: UpdateAPIKeyInput!) {
    updateApiKey(input: $input) {
      apiKey {
        id
        name
        ipAllowlist
        liveMode
        rateLimit
        rolesV2 { # Return updated roles
          id
          name
          __typename
        }
