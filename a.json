// --- Utility Components & Hooks (Simulated) ---

// A simple simulated API for authentication
export const authService = { // Exported for potential external use
  getToken: () => localStorage.getItem('authToken'),
  setToken: (token: string) => localStorage.setItem('authToken', token),
  removeToken: () => localStorage.removeItem('authToken'),
  login: async (username: string, password: string) => {
    return new Promise<{ success: boolean; token?: string; error?: string }>((resolve) => {
      setTimeout(() => {
        if (username === 'admin' && password === 'adminpass') { // Added admin user
          const token = 'fake-admin-jwt-token';
          authService.setToken(token);
          resolve({ success: true, token });
        } else if (username === 'user' && password === 'password') {
          const token = 'fake-user-jwt-token';
          authService.setToken(token);
          resolve({ success: true, token });
        } else {
          resolve({ success: false, error: 'Invalid credentials' });
        }
      }, 500);
    });
  },
  logout: () => {
    authService.removeToken();
  },
  isAuthenticated: () => !!authService.getToken(),
  hasRole: (roleName: string) => {
    // In a real app, this would decode JWT or fetch user roles
    const token = authService.getToken();
    if (!token) return false;
    if (token.includes('admin') && roleName === 'Admin') return true;
    if (token.includes('user') && (roleName === 'User' || roleName === 'Viewer')) return true; // user is also a viewer
    return false;
  },
  getCurrentUser: () => {
    const token = authService.getToken();
    if (!token) return null;
    if (token.includes('admin')) return { id: 'admin1', username: 'admin', roles: ['Admin', 'Auditor', 'Developer'] };
    if (token.includes('user')) return { id: 'user1', username: 'user', roles: ['User', 'Viewer'] };
    return null;
  }
};

// Context for global state/notifications
interface AppContextType {
  showNotification: (message: string, type?: 'success' | 'error' | 'info') => void;
  currentUser: { id: string; username: string; roles: string[] } | null;
}

const AppContext = createContext<AppContextType | undefined>(undefined);

export const useAppContext = () => {
  const context = useContext(AppContext);
  if (!context) {
    throw new Error('useAppContext must be used within an AppProvider');
  }
  return context;
};

// Global Notification Component
export const Notification: React.FC<{ message: string | null; type: 'success' | 'error' | 'info'; onClose: () => void }> = ({ message, type, onClose }) => {
  if (!message) return null;

  const bgColor = {
    success: 'bg-green-100 border-green-400 text-green-700',
    error: 'bg-red-100 border-red-400 text-red-700',
    info: 'bg-blue-100 border-blue-400 text-blue-700',
  }[type];

  useEffect(() => {
    const timer = setTimeout(() => {
      onClose();
    }, 5000); // Auto-dismiss after 5 seconds
    return () => clearTimeout(timer);
  }, [message, onClose]);

  return (
    <div className={`fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg flex items-center justify-between ${bgColor}`}>
      <span>{message}</span>
      <button onClick={onClose} className="ml-4 font-bold">X</button>
    </div>
  );
};

// Simple Modal Component
interface ModalProps {
  isOpen: boolean;
  onClose: () => void;
  title: string;
  children: React.ReactNode;
  footer?: React.ReactNode;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

export const Modal: React.FC<ModalProps> = ({ isOpen, onClose, title, children, footer, size = 'md' }) => {
  if (!isOpen) return null;

  const maxWidth = {
    sm: 'max-w-sm',
    md: 'max-w-md',
    lg: 'max-w-lg',
    xl: 'max-w-xl',
  }[size];

  return (
    <div className="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full flex items-center justify-center z-50">
      <div className={`relative p-8 bg-white w-full ${maxWidth} mx-auto rounded-md shadow-lg`}>
        <div className="flex justify-between items-center mb-4">
          <h3 className="text-2xl font-bold">{title}</h3>
          <button onClick={onClose} className="text-gray-500 hover:text-gray-700 text-xl">&times;</button>
        </div>
        <div className="mb-4">
          {children}
        </div>
        {footer && <div className="border-t pt-4 flex justify-end space-x-2">{footer}</div>}
      </div>
    </div>
  );
};


// --- Apollo Client Setup ---
const httpLink = new HttpLink({ uri: '/graphql' }); // Replace with your actual GraphQL endpoint

const authLink = setContext((_, { headers }) => {
  const token = authService.getToken();
  return {
    headers: {
      ...headers,
      authorization: token ? `Bearer ${token}` : '',
    },
  };
});

const errorLink = onError(({ graphQLErrors, networkError }) => {
  if (graphQLErrors)
    graphQLErrors.forEach(({ message, locations, path }) =>
      console.error(
        `[GraphQL error]: Message: ${message}, Location: ${locations}, Path: ${path}`
      )
    );
  if (networkError) console.error(`[Network error]: ${networkError}`);
});

const client = new ApolloClient({
  link: concat(authLink, errorLink, httpLink),
  cache: new InMemoryCache(),
});

