// --- New Feature: User Management (Admin Only) ---
// Define new GraphQL queries and types for User and Role Management
const USERS_LIST_QUERY = gql`
  query UsersList($first: Int, $after: String, $searchQuery: String, $roleId: ID, $status: String) {
    users(first: $first, after: $after, searchQuery: $searchQuery, roleId: $roleId, status: $status) {
      edges {
        node {
          id
          username
          email
          firstName
          lastName
          isActive
          createdAt
          lastLoginAt
          rolesV2 {
            id
            name
            __typename
          }
          __typename
        }
      }
      pageInfo {
        startCursor
        endCursor
        hasNextPage
        hasPreviousPage
        __typename
      }
      __typename
    }
    rolesUnpaginated { # For filter dropdown
      id
      name
      __typename
    }
    abilities {
      User {
        canCreate
        canUpdate
        canDeactivate
        __typename
      }
    }
  }
`;

interface UserNode {
  id: string;
  username: string;
  email: string;
  firstName: string;
  lastName: string;
  isActive: boolean;
  createdAt: string;
  lastLoginAt: string | null;
  rolesV2: { id: string; name: string; __typename: string }[];
  __typename: string;
}

interface UsersListData {
  users: {
    edges: { node: UserNode }[];
    pageInfo: {
      startCursor: string | null;
      endCursor: string | null;
      hasNextPage: boolean;
      hasPreviousPage: boolean;
      __typename: string;
    };
  };
  rolesUnpaginated: Role[];
  abilities: {
    User: {
      canCreate: boolean;
      canUpdate: boolean;
      canDeactivate: boolean;
      __typename: string;
    };
  };
}

const DEACTIVATE_USER_MUTATION = gql`
  mutation DeactivateUser($id: ID!) {
    deactivateUser(input: { id: $id }) {
      user {
        id
        isActive
        __typename
      }
      errors
      __typename
    }
  }
`;

export const UserManagementPage: React.FC = () => {
  const { showNotification } = useAppContext();
  const [filters, setFilters] = useState({
    searchQuery: '',
    roleId: '',
    status: '', // 'active', 'inactive', 'all'
  });

  const variables = useMemo(() => ({
    first: 10,
    searchQuery: filters.searchQuery || null,
    roleId: filters.roleId || null,
    status: filters.status === 'active' ? 'ACTIVE' : filters.status === 'inactive' ? 'INACTIVE' : null,
  }), [filters]);

  const { loading, error, data, fetchMore, refetch } = useQuery<UsersListData>(USERS_LIST_QUERY, {
    variables,
    notifyOnNetworkStatusChange: true,
    skip: !authService.hasRole('Admin'),
  });

  const [deactivateUser, { loading: deactivating }] = useMutation(DEACTIVATE_USER_MUTATION, {
    onCompleted: (result) => {
      if (result.deactivateUser.errors) {
        showNotification(`Error deactivating user: ${result.deactivateUser.errors.join(', ')}`, 'error');
      } else {
        showNotification(`User ${result.deactivateUser.user.id} deactivated successfully.`, 'success');
        refetch();
      }
    },
    onError: (err) => {
      showNotification(`Error deactivating user: ${err.message}`, 'error');
    },
  });

  const handleFilterChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setFilters(prev => ({ ...prev, [name]: value }));
  };

  const handleDeactivate = async (id: string) => {
    if (window.confirm('Are you sure you want to deactivate this user? They will no longer be able to log in.')) {
      await deactivateUser({ variables: { id } });
    }
  };

  const loadMore = useCallback(() => {
    if (data?.users.pageInfo.hasNextPage && !loading) {
      fetchMore({
        variables: { after: data.users.pageInfo.endCursor, ...variables },
        updateQuery: (prev, { fetchMoreResult }) => {
          if (!fetchMoreResult) return prev;
          return {
            users: {
              ...fetchMoreResult.users,
              edges: [
                ...prev.users.edges,
                ...fetchMoreResult.users.edges,
              ],
            },
            rolesUnpaginated: prev.rolesUnpaginated,
            abilities: prev.abilities,
          };
        },
      });
    }
  }, [data, fetchMore, loading, variables]);

  if (!authService.hasRole('Admin')) return <ErrorMessage message="Access Denied: You do not have permission to view user management." />;
  if (loading && !data) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;

  const canCreateUser = data?.abilities.User.canCreate;
  const canUpdateUser = data?.abilities.User.canUpdate;
  const canDeactivateUser = data?.abilities.User.canDeactivate;
  const availableRoles = data?.rolesUnpaginated || [];

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">User Management</h2>

      <div className="flex flex-wrap items-center gap-4 mb-6 bg-gray-50 p-4 rounded-lg shadow-sm">
        <input
          type="text"
          name="searchQuery"
          placeholder="Search by Name or Email..."
          value={filters.searchQuery}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 flex-grow max-w-sm"
        />
        <select
          name="roleId"
          value={filters.roleId}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All Roles</option>
          {availableRoles.map(role => (
            <option key={role.id} value={role.id}>{role.name}</option>
          ))}
        </select>
        <select
          name="status"
          value={filters.status}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All Statuses</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
        {canCreateUser && (
          <Link to="/admin/users/new" className="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 transition duration-200 flex-shrink-0">
            <i className="fas fa-user-plus mr-2"></i> Create New User
          </Link>
        )}
      </div>

      <div className="bg-white shadow-md rounded-lg overflow-hidden">
        <table className="min-w-full divide-y divide-gray-200">
          <thead className="bg-gray-50">
            <tr>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Username</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Full Name</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Roles</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Login</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody className="bg-white divide-y divide-gray-200">
            {data?.users.edges.length === 0 ? (
              <tr>
                <td colSpan={7} className="px-6 py-4 text-center text-gray-500">No users found.</td>
              </tr>
            ) : (
              data?.users.edges.map(({ node }) => (
                <tr key={node.id}>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.username}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.firstName} {node.lastName}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.email}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    {node.rolesV2.map(r => r.name).join(', ') || 'None'}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm">
                    <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${node.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
                      {node.isActive ? 'Active' : 'Inactive'}
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.lastLoginAt ? new Date(node.lastLoginAt).toLocaleString() : 'Never'}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <Link to={`/admin/users/${node.id}`} className="text-indigo-600 hover:text-indigo-900 mr-2">View</Link>
                    {canUpdateUser && (
                      <Link to={`/admin/users/${node.id}/edit`} className="text-yellow-600 hover:text-yellow-900 mr-2">Edit</Link>
                    )}
                    {canDeactivateUser && node.isActive && (
                      <button
                        onClick={() => handleDeactivate(node.id)}
                        className="text-red-600 hover:text-red-900"
                        disabled={deactivating}
                      >
                        {deactivating ? 'Deactivating...' : 'Deactivate'}
                      </button>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
        {data?.users.pageInfo.hasNextPage && (
          <div className="p-4 text-center border-t border-gray-200">
            <button
              onClick={loadMore}
              className="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition duration-200"
              disabled={loading}
            >
              {loading ? 'Loading...' : 'Load More'}
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

// --- New Feature: User Details (Admin Only) ---
const USER_DETAILS_QUERY = gql`
  query UserDetails($id: ID!) {
    user(id: $id) {
      id
      username
      email
      firstName
      lastName
      phoneNumber
      address
      city
      state
      zipCode
      country
      isActive
      createdAt
      updatedAt
      lastLoginAt
      mfaEnabled
      rolesV2 {
        id
        name
        description
        roleType
        __typename
      }
      permissions { # User-specific permissions calculation
        resource
        actions
        __typename
      }
      __typename
    }
  }
`;

interface UserDetailsData {
  user: UserNode & {
    phoneNumber: string | null;
    address: string | null;
    city: string | null;
    state: string | null;
    zipCode: string | null;
    country: string | null;
    updatedAt: string;
    mfaEnabled: boolean;
    permissions: { resource: string; actions: string[]; __typename: string }[];
  };
}

export const UserDetailsPage: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { loading, error, data } = useQuery<UserDetailsData>(USER_DETAILS_QUERY, {
    variables: { id },
    skip: !authService.hasRole('Admin'),
  });
  const navigate = useNavigate();

  if (!authService.hasRole('Admin')) return <ErrorMessage message="Access Denied: You do not have permission to view user details." />;
  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;
  if (!data?.user) return <p className="text-center p-4">User not found.</p>;

  const user = data.user;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">User Details: {user.username}</h2>
      <div className="bg-white shadow-md rounded-lg p-6 max-w-4xl mx-auto">
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6 border-b pb-4">
          <DetailItem label="ID" value={user.id} />
          <DetailItem label="Username" value={user.username} />
          <DetailItem label="Full Name" value={`${user.firstName} ${user.lastName}`} />
          <DetailItem label="Email" value={user.email} />
          <DetailItem label="Phone Number" value={user.phoneNumber || 'N/A'} />
          <DetailItem label="Address" value={user.address || 'N/A'} />
          <DetailItem label="City" value={user.city || 'N/A'} />
          <DetailItem label="State" value={user.state || 'N/A'} />
          <DetailItem label="Zip Code" value={user.zipCode || 'N/A'} />
          <DetailItem label="Country" value={user.country || 'N/A'} />
          <DetailItem label="Created At" value={new Date(user.createdAt).toLocaleString()} />
          <DetailItem label="Last Updated" value={new Date(user.updatedAt).toLocaleString()} />
          <DetailItem label="Last Login" value={user.lastLoginAt ? new Date(user.lastLoginAt).toLocaleString() : 'Never'} />
          <DetailItem label="MFA Enabled" value={user.mfaEnabled ? 'Yes' : 'No'} />
          <DetailItem label="Status" value={
            <span className={`px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${user.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
              {user.isActive ? 'Active' : 'Inactive'}
            </span>
          } />
        </div>

        <div className="mb-6 border-b pb-4">
          <h3 className="text-xl font-semibold text-gray-800 mb-2">Assigned Roles</h3>
          <ul className="list-disc list-inside text-gray-700 ml-4">
            {user.rolesV2 && user.rolesV2.length > 0 ? (
              user.rolesV2.map((role) => <li key={role.id} className="py-1">{role.name} (<span className="text-gray-500">{role.roleType}</span>)</li>)
            ) : (
              <li className="text-gray-500">No roles assigned</li>
            )}
          </ul>
        </div>

        <div className="mb-6 border-b pb-4">
          <h3 className="text-xl font-semibold text-gray-800 mb-2">Effective Permissions</h3>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {user.permissions && user.permissions.length > 0 ? (
              user.permissions.map((perm, index) => (
                <div key={index} className="border border-gray-200 rounded-md p-3 bg-gray-50 hover:shadow-sm">
                  <p className="font-medium text-gray-800">{perm.resource}</p>
                  <p className="text-sm text-gray-600 mt-1">Actions: <span className="font-mono text-xs">{perm.actions.join(', ')}</span></p>
                </div>
              ))
            ) : (
              <p className="text-gray-700 col-span-2">No specific permissions configured.</p>
            )}
          </div>
        </div>

        <div className="flex justify-end space-x-2 mt-6">
          <button
            onClick={() => navigate('/admin/users')}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
          >
            Back to List
          </button>
          {authService.hasRole('Admin') && (
            <Link to={`/admin/users/${user.id}/edit`} className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition duration-200">
              Edit User
            </Link>
          )}
        </div>
      </div>
    </div>
  );
};

// --- New Feature: User Form (Create/Edit) ---
const CREATE_USER_MUTATION = gql`
  mutation CreateUser($input: CreateUserInput!) {
    createUser(input: $input) {
      user {
        id
        username
        email
        __typename
      }
      errors
      __typename
    }
  }
`;

const UPDATE_USER_MUTATION = gql`
  mutation UpdateUser($input: UpdateUserInput!) {
    updateUser(input: $input) {
      user {
        id
        username
        email
        firstName
        lastName
        isActive
        mfaEnabled
        rolesV2 {
          id
          name
          __typename
        }
        __typename
      }
      errors
      __typename
    }
  }
`;

export const UserForm: React.FC = () => {
  const { id } = useParams<{ id?: string }>();
  const navigate = useNavigate();
  const { showNotification } = useAppContext();

  const isEditMode = !!id;

  const [formData, setFormData] = useState({
    username: '',
    email: '',
    password: '', // Only for creation/password reset
    confirmPassword: '',
    firstName: '',
    lastName: '',
    phoneNumber: '',
    address: '',
    city: '',
    state: '',
    zipCode: '',
    country: '',
    isActive: true,
    mfaEnabled: false,
    roles: [] as string[],
  });
  const [formErrors, setFormErrors] = useState<Record<string, string>>({});

  // Fetch roles for the dropdown
  const { data: rolesData, loading: rolesLoading } = useQuery<RolesData>(ROLES_QUERY);
  const availableRoles = rolesData?.rolesUnpaginated || [];

  // Fetch user data in edit mode
  const { data: userData, loading: userLoading, error: userError } = useQuery<UserDetailsData>(USER_DETAILS_QUERY, {
    variables: { id: id! },
    skip: !isEditMode,
  });

  useEffect(() => {
    if (isEditMode && userData?.user) {
      const user = userData.user;
      setFormData({
        username: user.username,
        email: user.email,
        password: '', // Never pre-fill passwords
        confirmPassword: '',
        firstName: user.firstName,
        lastName: user.lastName,
        phoneNumber: user.phoneNumber || '',
        address: user.address || '',
        city: user.city || '',
        state: user.state || '',
        zipCode: user.zipCode || '',
        country: user.country || '',
        isActive: user.isActive,
        mfaEnabled: user.mfaEnabled,
        roles: user.rolesV2?.map(r => r.id) || [],
      });
    }
  }, [isEditMode, userData]);

  const [createUser, { loading: createLoading }] = useMutation(CREATE_USER_MUTATION, {
    onCompleted: (result) => {
      if (result.data.createUser.errors && result.data.createUser.errors.length > 0) {
        showNotification(`Error creating user: ${result.data.createUser.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.data.createUser.errors.join(', ') });
      } else {
        showNotification(`User '${result.data.createUser.user.username}' created successfully!`, 'success');
        navigate(`/admin/users/${result.data.createUser.user.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error creating user: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const [updateUser, { loading: updateLoading }] = useMutation(UPDATE_USER_MUTATION, {
    onCompleted: (result) => {
      if (result.data.updateUser.errors && result.data.updateUser.errors.length > 0) {
        showNotification(`Error updating user: ${result.data.updateUser.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.data.updateUser.errors.join(', ') });
      } else {
        showNotification(`User '${result.data.updateUser.user.username}' updated successfully!`, 'success');
        navigate(`/admin/users/${result.data.updateUser.user.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error updating user: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const loading = createLoading || updateLoading || (isEditMode && userLoading) || rolesLoading;
  const error = (isEditMode && userError);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value, type } = e.target;
    if (type === 'checkbox') {
      setFormData({ ...formData, [name]: (e.target as HTMLInputElement).checked });
    } else if (name === 'roles') {
      const selectedOptions = Array.from((e.target as HTMLSelectElement).options)
        .filter(option => option.selected)
        .map(option => option.value);
      setFormData({ ...formData, roles: selectedOptions });
    }
    else {
      setFormData({ ...formData, [name]: value });
    }
    setFormErrors(prev => ({ ...prev, [name]: '' }));
  };

  const validateForm = () => {
    const errors: Record<string, string> = {};
    if (!formData.username.trim()) errors.username = 'Username is required.';
    if (!formData.email.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(formData.email)) errors.email = 'Valid email is required.';
    if (!formData.firstName.trim()) errors.firstName = 'First Name is required.';
    if (!formData.lastName.trim()) errors.lastName = 'Last Name is required.';

    if (!isEditMode) { // Password required for new user
      if (!formData.password) errors.password = 'Password is required for new users.';
      if (formData.password !== formData.confirmPassword) errors.confirmPassword = 'Passwords do not match.';
      if (formData.password.length < 8) errors.password = 'Password must be at least 8 characters long.';
    }

    // Basic phone number validation (digits only, could be more complex)
    if (formData.phoneNumber && !/^\d{10,}$/.test(formData.phoneNumber.replace(/[\s()-]/g, ''))) errors.phoneNumber = 'Invalid phone number format.';
    // More address validation can be added

    setFormErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormErrors({});
    if (!validateForm()) {
      showNotification('Please correct the errors in the form.', 'error');
      return;
    }

    const baseInput = {
      username: formData.username,
      email: formData.email,
      firstName: formData.firstName,
      lastName: formData.lastName,
      phoneNumber: formData.phoneNumber || null,
      address: formData.address || null,
      city: formData.city || null,
      state: formData.state || null,
      zipCode: formData.zipCode || null,
      country: formData.country || null,
      isActive: formData.isActive,
      mfaEnabled: formData.mfaEnabled,
      roleIds: formData.roles,
    };

    try {
      if (isEditMode) {
        // For updates, password is only sent if changed
        const updateInput = {
          ...baseInput,
          ...(formData.password && { password: formData.password })
        };
        await updateUser({ variables: { input: { id: id!, ...updateInput } } });
      } else {
        await createUser({
          variables: {
            input: {
              ...baseInput,
              password: formData.password,
            }
          },
        });
      }
    } catch (err: any) {
      // Errors handled by onError callback
    }
  };

  if (!authService.hasRole('Admin')) return <ErrorMessage message="Access Denied: You do not have permission to manage users." />;
  if (isEditMode && userLoading) return <LoadingSpinner />;
  if (isEditMode && error) return <ErrorMessage message={error.message} />;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">{isEditMode ? `Edit User: ${userData?.user.username}` : 'Create New User'}</h2>

      <form onSubmit={handleSubmit} className="bg-white shadow-md rounded-lg p-6 max-w-3xl mx-auto space-y-6">
        {formErrors.submit && <ErrorMessage message={formErrors.submit} />}
        {error && <ErrorMessage message={error.message} />}

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {/* Username */}
          <div>
            <label htmlFor="username" className="block text-sm font-medium text-gray-700 mb-1">Username <span className="text-red-500">*</span></label>
            <input type="text" id="username" name="username" value={formData.username} onChange={handleChange} required
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.username ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`} />
            {formErrors.username && <p className="mt-1 text-sm text-red-600">{formErrors.username}</p>}
          </div>
          {/* Email */}
          <div>
            <label htmlFor="email" className="block text-sm font-medium text-gray-700 mb-1">Email <span className="text-red-500">*</span></label>
            <input type="email" id="email" name="email" value={formData.email} onChange={handleChange} required
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.email ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`} />
            {formErrors.email && <p className="mt-1 text-sm text-red-600">{formErrors.email}</p>}
          </div>
          {/* First Name */}
          <div>
            <label htmlFor="firstName" className="block text-sm font-medium text-gray-700 mb-1">First Name <span className="text-red-500">*</span></label>
            <input type="text" id="firstName" name="firstName" value={formData.firstName} onChange={handleChange} required
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.firstName ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`} />
            {formErrors.firstName && <p className="mt-1 text-sm text-red-600">{formErrors.firstName}</p>}
          </div>
          {/* Last Name */}
          <div>
            <label htmlFor="lastName" className="block text-sm font-medium text-gray-700 mb-1">Last Name <span className="text-red-500">*</span></label>
            <input type="text" id="lastName" name="lastName" value={formData.lastName} onChange={handleChange} required
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.lastName ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`} />
            {formErrors.lastName && <p className="mt-1 text-sm text-red-600">{formErrors.lastName}</p>}
          </div>
          {/* Password (for new user or reset) */}
          <div className="md:col-span-2">
            <label htmlFor="password" className="block text-sm font-medium text-gray-700 mb-1">{isEditMode ? 'New Password (leave blank to keep current)' : 'Password'} {isEditMode ? '' : <span className="text-red-500">*</span>}</label>
            <input type="password" id="password" name="password" value={formData.password} onChange={handleChange}
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.password ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`} />
            {formErrors.password && <p className="mt-1 text-sm text-red-600">{formErrors.password}</p>}
          </div>
          <div className="md:col-span-2">
            <label htmlFor="confirmPassword" className="block text-sm font-medium text-gray-700 mb-1">{isEditMode ? 'Confirm New Password' : 'Confirm Password'} {isEditMode ? '' : <span className="text-red-500">*</span>}</label>
            <input type="password" id="confirmPassword" name="confirmPassword" value={formData.confirmPassword} onChange={handleChange}
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.confirmPassword ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`} />
            {formErrors.confirmPassword && <p className="mt-1 text-sm text-red-600">{formErrors.confirmPassword}</p>}
          </div>

          {/* Phone Number */}
          <div>
            <label htmlFor="phoneNumber" className="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
            <input type="tel" id="phoneNumber" name="phoneNumber" value={formData.phoneNumber} onChange={handleChange}
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.phoneNumber ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`} />
            {formErrors.phoneNumber && <p className="mt-1 text-sm text-red-600">{formErrors.phoneNumber}</p>}
          </div>
          {/* Address */}
          <div>
            <label htmlFor="address" className="block text-sm font-medium text-gray-700 mb-1">Address</label>
            <input type="text" id="address" name="address" value={formData.address} onChange={handleChange}
              className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
          </div>
          {/* City */}
          <div>
            <label htmlFor="city" className="block text-sm font-medium text-gray-700 mb-1">City</label>
            <input type="text" id="city" name="city" value={formData.city} onChange={handleChange}
              className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
          </div>
          {/* State */}
          <div>
            <label htmlFor="state" className="block text-sm font-medium text-gray-700 mb-1">State/Province</label>
            <input type="text" id="state" name="state" value={formData.state} onChange={handleChange}
              className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
          </div>
          {/* Zip Code */}
          <div>
            <label htmlFor="zipCode" className="block text-sm font-medium text-gray-700 mb-1">Zip/Postal Code</label>
            <input type="text" id="zipCode" name="zipCode" value={formData.zipCode} onChange={handleChange}
              className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
          </div>
          {/* Country */}
          <div>
            <label htmlFor="country" className="block text-sm font-medium text-gray-700 mb-1">Country</label>
            <input type="text" id="country" name="country" value={formData.country} onChange={handleChange}
              className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
          </div>

          {/* Is Active */}
          <div className="flex items-center md:col-span-2">
            <input type="checkbox" id="isActive" name="isActive" checked={formData.isActive} onChange={handleChange}
              className="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" />
            <label htmlFor="isActive" className="ml-2 block text-sm text-gray-900">
              User is Active (Can Log In)
            </label>
          </div>
          {/* MFA Enabled */}
          <div className="flex items-center md:col-span-2">
            <input type="checkbox" id="mfaEnabled" name="mfaEnabled" checked={formData.mfaEnabled} onChange={handleChange}
              className="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" />
            <label htmlFor="mfaEnabled" className="ml-2 block text-sm text-gray-900">
              Multi-Factor Authentication Enabled
            </label>
          </div>
        </div>

        {/* Roles Multiselect */}
        <div className="pt-4 border-t border-gray-200">
          <label htmlFor="roles" className="block text-sm font-medium text-gray-700 mb-1">Assign Roles</label>
          <select
            multiple
            id="roles"
            name="roles"
            value={formData.roles}
            onChange={handleChange}
            className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 h-32"
          >
            {availableRoles.length === 0 && !rolesLoading && (
              <option disabled>No roles available</option>
            )}
            {rolesLoading ? (
              <option disabled>Loading roles...</option>
            ) : (
              availableRoles.map(role => (
                <option key={role.id} value={role.id} title={role.description}>{role.name} ({role.roleType})</option>
              ))
            )}
          </select>
          <p className="mt-1 text-xs text-gray-500">Hold Ctrl/Cmd to select multiple roles. Roles define permissions and access levels.</p>
        </div>

        <div className="flex justify-end space-x-2 mt-6">
          <button
            type="button"
            onClick={() => navigate('/admin/users')}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
            disabled={loading}
          >
            Cancel
          </button>
          <button
            type="submit"
            className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition duration-200"
            disabled={loading}
          >
            {loading ? 'Saving...' : (isEditMode ? 'Update User' : 'Create User')}
          </button>
        </div>
      </form>
    </div>
  );
};

// --- New Feature: Role Management (Admin Only) ---
const ROLES_LIST_QUERY = gql`
  query RolesList($first: Int, $after: String, $searchQuery: String, $roleType: String) {
    roles(first: $first, after: $after, searchQuery: $searchQuery, roleType: $roleType) {
      edges {
        node {
          id
          name
          description
          roleType
          createdAt
          updatedAt
          permissions {
            resource
            actions
            __typename
          }
          __typename
        }
      }
      pageInfo {
        startCursor
        endCursor
        hasNextPage
        hasPreviousPage
        __typename
      }
    }
    abilities {
      Role {
        canCreate
        canUpdate
        canDelete
        __typename
      }
    }
  }
`;

interface RoleNode extends Role { // Extending Role interface from above
  createdAt: string;
  updatedAt: string;
  permissions: { resource: string; actions: string[]; __typename: string }[];
}

interface RolesListData {
  roles: {
    edges: { node: RoleNode }[];
    pageInfo: {
      startCursor: string | null;
      endCursor: string | null;
      hasNextPage: boolean;
      hasPreviousPage: boolean;
      __typename: string;
    };
  };
  abilities: {
    Role: {
      canCreate: boolean;
      canUpdate: boolean;
      canDelete: boolean;
      __typename: string;
    };
  };
}

const DELETE_ROLE_MUTATION = gql`
  mutation DeleteRole($id: ID!) {
    deleteRole(input: { id: $id }) {
      success
      errors
      __typename
    }
  }
`;

export const RoleManagementPage: React.FC = () => {
  const { showNotification } = useAppContext();
  const [filters, setFilters] = useState({
    searchQuery: '',
    roleType: '',
  });

  const variables = useMemo(() => ({
    first: 10,
    searchQuery: filters.searchQuery || null,
    roleType: filters.roleType || null,
  }), [filters]);

  const { loading, error, data, fetchMore, refetch } = useQuery<RolesListData>(ROLES_LIST_QUERY, {
    variables,
    notifyOnNetworkStatusChange: true,
    skip: !authService.hasRole('Admin'),
  });

  const [deleteRole, { loading: deleting }] = useMutation(DELETE_ROLE_MUTATION, {
    onCompleted: (result) => {
      if (result.deleteRole.errors) {
        showNotification(`Error deleting role: ${result.deleteRole.errors.join(', ')}`, 'error');
      } else {
        showNotification('Role deleted successfully.', 'success');
        refetch();
      }
    },
    onError: (err) => {
      showNotification(`Error deleting role: ${err.message}`, 'error');
    },
  });

  const handleFilterChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setFilters(prev => ({ ...prev, [name]: value }));
  };

  const handleDelete = async (id: string) => {
    if (window.confirm('Are you sure you want to delete this role? This cannot be undone and will affect all assigned users.')) {
      await deleteRole({ variables: { id } });
    }
  };

  const loadMore = useCallback(() => {
    if (data?.roles.pageInfo.hasNextPage && !loading) {
      fetchMore({
        variables: { after: data.roles.pageInfo.endCursor, ...variables },
        updateQuery: (prev, { fetchMoreResult }) => {
          if (!fetchMoreResult) return prev;
          return {
            roles: {
              ...fetchMoreResult.roles,
              edges: [
                ...prev.roles.edges,
                ...fetchMoreResult.roles.edges,
              ],
            },
            abilities: prev.abilities,
          };
        },
      });
    }
  }, [data, fetchMore, loading, variables]);

  if (!authService.hasRole('Admin')) return <ErrorMessage message="Access Denied: You do not have permission to view role management." />;
  if (loading && !data) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;

  const canCreateRole = data?.abilities.Role.canCreate;
  const canUpdateRole = data?.abilities.Role.canUpdate;
  const canDeleteRole = data?.abilities.Role.canDelete;
  const roleTypes = ['System', 'Custom', 'Integration']; // Example role types

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">Role Management</h2>

      <div className="flex flex-wrap items-center gap-4 mb-6 bg-gray-50 p-4 rounded-lg shadow-sm">
        <input
          type="text"
          name="searchQuery"
          placeholder="Search by Role Name or Description..."
          value={filters.searchQuery}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 flex-grow max-w-sm"
        />
        <select
          name="roleType"
          value={filters.roleType}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All Role Types</option>
          {roleTypes.map(type => <option key={type} value={type}>{type}</option>)}
        </select>
        {canCreateRole && (
          <Link to="/admin/roles/new" className="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 transition duration-200 flex-shrink-0">
            <i className="fas fa-plus mr-2"></i> Create New Role
          </Link>
        )}
      </div>

      <div className="bg-white shadow-md rounded-lg overflow-hidden">
        <table className="min-w-full divide-y divide-gray-200">
          <thead className="bg-gray-50">
            <tr>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created At</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody className="bg-white divide-y divide-gray-200">
            {data?.roles.edges.length === 0 ? (
              <tr>
                <td colSpan={5} className="px-6 py-4 text-center text-gray-500">No roles found.</td>
              </tr>
            ) : (
              data?.roles.edges.map(({ node }) => (
                <tr key={node.id}>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.name}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.roleType}</td>
                  <td className="px-6 py-4 text-sm text-gray-900 truncate max-w-xs">{node.description || 'N/A'}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{new Date(node.createdAt).toLocaleDateString()}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <Link to={`/admin/roles/${node.id}`} className="text-indigo-600 hover:text-indigo-900 mr-2">View</Link>
                    {canUpdateRole && (
                      <Link to={`/admin/roles/${node.id}/edit`} className="text-yellow-600 hover:text-yellow-900 mr-2">Edit</Link>
                    )}
                    {canDeleteRole && (
                      <button
                        onClick={() => handleDelete(node.id)}
                        className="text-red-600 hover:text-red-900"
                        disabled={deleting}
                      >
                        {deleting ? 'Deleting...' : 'Delete'}
                      </button>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
        {data?.roles.pageInfo.hasNextPage && (
          <div className="p-4 text-center border-t border-gray-200">
            <button
              onClick={loadMore}
              className="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition duration-200"
              disabled={loading}
            >
              {loading ? 'Loading...' : 'Load More'}
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

// --- New Feature: Role Details (Admin Only) ---
const ROLE_DETAILS_QUERY = gql`
  query RoleDetails($id: ID!) {
    role(id: $id) {
      id
      name
      description
      roleType
      createdAt
      updatedAt
      permissions {
        resource
        actions
        __typename
      }
      # Also fetch users assigned to this role, if needed for display
      assignedUsers(first: 5) { # Paginated for large lists
        edges {
          node {
            id
            username
            email
            __typename
          }
        }
      }
      __typename
    }
  }
`;

interface AssignedUser {
  id: string;
  username: string;
  email: string;
  __typename: string;
}

interface RoleDetailsData {
  role: RoleNode & {
    assignedUsers: {
      edges: { node: AssignedUser }[];
    };
  };
}

export const RoleDetailsPage: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { loading, error, data } = useQuery<RoleDetailsData>(ROLE_DETAILS_QUERY, {
    variables: { id },
    skip: !authService.hasRole('Admin'),
  });
  const navigate = useNavigate();

  if (!authService.hasRole('Admin')) return <ErrorMessage message="Access Denied: You do not have permission to view role details." />;
  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;
  if (!data?.role) return <p className="text-center p-4">Role not found.</p>;

  const role = data.role;
  const permissions = useMemo(() => {
    // Group permissions by resource for better display
    const grouped: Record<string, string[]> = {};
    role.permissions.forEach(p => {
      if (!grouped[p.resource]) {
        grouped[p.resource] = [];
      }
      grouped[p.resource].push(...p.actions);
    });
    return Object.entries(grouped);
  }, [role.permissions]);

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">Role Details: {role.name}</h2>
      <div className="bg-white shadow-md rounded-lg p-6 max-w-4xl mx-auto">
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 border-b pb-4">
          <DetailItem label="ID" value={role.id} />
          <DetailItem label="Name" value={role.name} />
          <DetailItem label="Type" value={role.roleType} />
          <DetailItem label="Created At" value={new Date(role.createdAt).toLocaleString()} />
          <DetailItem label="Last Updated" value={new Date(role.updatedAt).toLocaleString()} />
          <DetailItem label="Description" value={role.description || 'N/A'} className="md:col-span-2" />
        </div>

        <div className="mb-6 border-b pb-4">
          <h3 className="text-xl font-semibold text-gray-800 mb-2">Assigned Permissions</h3>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {permissions.length > 0 ? (
              permissions.map(([resource, actions], index) => (
                <div key={index} className="border border-gray-200 rounded-md p-3 bg-gray-50 hover:shadow-sm">
                  <p className="font-medium text-gray-800">{resource}</p>
                  <p className="text-sm text-gray-600 mt-1">Actions: <span className="font-mono text-xs">{actions.join(', ')}</span></p>
                </div>
              ))
            ) : (
              <p className="text-gray-700 col-span-2">No permissions assigned.</p>
            )}
          </div>
        </div>

        {role.assignedUsers.edges.length > 0 && (
          <div className="mb-6 border-b pb-4">
            <h3 className="text-xl font-semibold text-gray-800 mb-2">Assigned Users (First 5)</h3>
            <ul className="list-disc list-inside text-gray-700 ml-4">
              {role.assignedUsers.edges.map(({ node }) => (
                <li key={node.id} className="py-1">
                  <Link to={`/admin/users/${node.id}`} className="text-blue-600 hover:underline">
                    {node.username} ({node.email})
                  </Link>
                </li>
              ))}
            </ul>
            {/* Add a "View All Users" link if there are more than 5, or integrate pagination/modal */}
          </div>
        )}

        <div className="flex justify-end space-x-2 mt-6">
          <button
            onClick={() => navigate('/admin/roles')}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
          >
            Back to List
          </button>
          {authService.hasRole('Admin') && (
            <Link to={`/admin/roles/${role.id}/edit`} className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition duration-200">
              Edit Role
            </Link>
          )}
        </div>
      </div>
    </div>
  );
};

// --- New Feature: Role Form (Create/Edit) ---
const CREATE_ROLE_MUTATION = gql`
  mutation CreateRole($input: CreateRoleInput!) {
    createRole(input: $input) {
      role {
        id
        name
        __typename
      }
      errors
      __typename
    }
  }
`;

const UPDATE_ROLE_MUTATION = gql`
  mutation UpdateRole($input: UpdateRoleInput!) {
    updateRole(input: $input) {
      role {
        id
        name
        description
        roleType
        permissions {
          resource
          actions
          __typename
        }
        __typename
      }
      errors
      __typename
    }
  }
`;

// Define all possible resources and actions for permission management
const ALL_RESOURCES = [
  'APIKey', 'ACHSetting', 'AccountGroup', 'User', 'Role', 'Account', 'Transaction',
  'LoanApplication', 'CreditCard', 'InvestmentPortfolio', 'Report', 'SystemConfig', 'FraudAlert',
  'ComplianceRule', 'Notification'
];
const ALL_ACTIONS = ['READ', 'CREATE', 'UPDATE', 'DELETE', 'APPROVE', 'VIEW_SECRET', 'EXECUTE', 'ARCHIVE', 'DECOMMISSION'];

export const RoleForm: React.FC = () => {
  const { id } = useParams<{ id?: string }>();
  const navigate = useNavigate();
  const { showNotification } = useAppContext();

  const isEditMode = !!id;

  const [formData, setFormData] = useState({
    name: '',
    description: '',
    roleType: 'Custom',
    permissions: [] as { resource: string; actions: string[] }[],
  });
  const [formErrors, setFormErrors] = useState<Record<string, string>>({});

  // Fetch role data in edit mode
  const { data: roleData, loading: roleLoading, error: roleError } = useQuery<RoleDetailsData>(ROLE_DETAILS_QUERY, {
    variables: { id: id! },
    skip: !isEditMode,
  });

  useEffect(() => {
    if (isEditMode && roleData?.role) {
      const role = roleData.role;
      setFormData({
        name: role.name,
        description: role.description || '',
        roleType: role.roleType,
        permissions: role.permissions || [],
      });
    }
  }, [isEditMode, roleData]);

  const [createRole, { loading: createLoading }] = useMutation(CREATE_ROLE_MUTATION, {
    onCompleted: (result) => {
      if (result.data.createRole.errors && result.data.createRole.errors.length > 0) {
        showNotification(`Error creating role: ${result.data.createRole.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.data.createRole.errors.join(', ') });
      } else {
        showNotification(`Role '${result.data.createRole.role.name}' created successfully!`, 'success');
        navigate(`/admin/roles/${result.data.createRole.role.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error creating role: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const [updateRole, { loading: updateLoading }] = useMutation(UPDATE_ROLE_MUTATION, {
    onCompleted: (result) => {
      if (result.data.updateRole.errors && result.data.updateRole.errors.length > 0) {
        showNotification(`Error updating role: ${result.data.updateRole.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.data.updateRole.errors.join(', ') });
      } else {
        showNotification(`Role '${result.data.updateRole.role.name}' updated successfully!`, 'success');
        navigate(`/admin/roles/${result.data.updateRole.role.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error updating role: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const loading = createLoading || updateLoading || (isEditMode && roleLoading);
  const error = (isEditMode && roleError);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setFormData({ ...formData, [name]: value });
    setFormErrors(prev => ({ ...prev, [name]: '' }));
  };

  const handlePermissionChange = (resource: string, action: string, isChecked: boolean) => {
    setFormData(prev => {
      const newPermissions = [...prev.permissions];
      let resourcePerm = newPermissions.find(p => p.resource === resource);

      if (!resourcePerm) {
        resourcePerm = { resource, actions: [] };
        newPermissions.push(resourcePerm);
      }

      if (isChecked) {
        if (!resourcePerm.actions.includes(action)) {
          resourcePerm.actions.push(action);
        }
      } else {
        resourcePerm.actions = resourcePerm.actions.filter(a => a !== action);
      }

      // Clean up empty resources
      return {
        ...prev,
        permissions: newPermissions.filter(p => p.actions.length > 0),
      };
    });
  };

  const isActionChecked = (resource: string, action: string) => {
    return formData.permissions.some(p => p.resource === resource && p.actions.includes(action));
  };

  const validateForm = () => {
    const errors: Record<string, string> = {};
    if (!formData.name.trim()) errors.name = 'Role Name is required.';
    if (!formData.roleType.trim()) errors.roleType = 'Role Type is required.';
    // Ensure at least one permission is set for custom roles, perhaps?

    setFormErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormErrors({});
    if (!validateForm()) {
      showNotification('Please correct the errors in the form.', 'error');
      return;
    }

    const input = {
      name: formData.name,
      description: formData.description,
      roleType: formData.roleType,
      permissions: formData.permissions,
    };

    try {
      if (isEditMode) {
        await updateRole({ variables: { input: { id: id!, ...input } } });
      } else {
        await createRole({ variables: { input } });
      }
    } catch (err: any) {
      // Errors handled by onError callback
    }
  };

  if (!authService.hasRole('Admin')) return <ErrorMessage message="Access Denied: You do not have permission to manage roles." />;
  if (isEditMode && roleLoading) return <LoadingSpinner />;
  if (isEditMode && error) return <ErrorMessage message={error.message} />;

  const roleTypes = ['System', 'Custom', 'Integration'];

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">{isEditMode ? `Edit Role: ${roleData?.role.name}` : 'Create New Role'}</h2>

      <form onSubmit={handleSubmit} className="bg-white shadow-md rounded-lg p-6 max-w-4xl mx-auto space-y-6">
        {formErrors.submit && <ErrorMessage message={formErrors.submit} />}
        {error && <ErrorMessage message={error.message} />}

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {/* Name */}
          <div>
            <label htmlFor="name" className="block text-sm font-medium text-gray-700 mb-1">Role Name <span className="text-red-500">*</span></label>
            <input type="text" id="name" name="name" value={formData.name} onChange={handleChange} required
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.name ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`} />
            {formErrors.name && <p className="mt-1 text-sm text-red-600">{formErrors.name}</p>}
          </div>
          {/* Role Type */}
          <div>
            <label htmlFor="roleType" className="block text-sm font-medium text-gray-700 mb-1">Role Type <span className="text-red-500">*</span></label>
            <select id="roleType" name="roleType" value={formData.roleType} onChange={handleChange} required
              className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.roleType ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}>
              {roleTypes.map(type => (
                <option key={type} value={type}>{type}</option>
              ))}
            </select>
            {formErrors.roleType && <p className="mt-1 text-sm text-red-600">{formErrors.roleType}</p>}
          </div>
          {/* Description */}
          <div className="md:col-span-2">
            <label htmlFor="description" className="block text-sm font-medium text-gray-700 mb-1">Description</label>
            <textarea id="description" name="description" value={formData.description} onChange={handleChange} rows={3}
              className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
              placeholder="A brief description of this role's purpose and scope."
            ></textarea>
          </div>
        </div>

        {/* Permissions Matrix */}
        <div className="pt-4 border-t border-gray-200">
          <h3 className="text-xl font-semibold text-gray-800 mb-2">Permissions Matrix</h3>
          <p className="text-sm text-gray-600 mb-4">Define which actions this role can perform on various resources.</p>

          <div className="overflow-x-auto">
            <table className="min-w-full divide-y divide-gray-200">
              <thead className="bg-gray-50">
                <tr>
                  <th className="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider sticky left-0 bg-gray-50 z-10">Resource</th>
                  {ALL_ACTIONS.map(action => (
                    <th key={action} className="px-4 py-2 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">{action}</th>
                  ))}
                </tr>
              </thead>
              <tbody className="bg-white divide-y divide-gray-200">
                {ALL_RESOURCES.map(resource => (
                  <tr key={resource}>
                    <td className="px-4 py-2 whitespace-nowrap text-sm font-medium text-gray-900 sticky left-0 bg-white border-r border-gray-200 z-10">{resource}</td>
                    {ALL_ACTIONS.map(action => (
                      <td key={`${resource}-${action}`} className="px-4 py-2 whitespace-nowrap text-center text-sm text-gray-900">
                        <input
                          type="checkbox"
                          checked={isActionChecked(resource, action)}
                          onChange={(e) => handlePermissionChange(resource, action, e.target.checked)}
                          className="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
                        />
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div className="flex justify-end space-x-2 mt-6">
          <button
            type="button"
            onClick={() => navigate('/admin/roles')}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
            disabled={loading}
          >
            Cancel
          </button>
          <button
            type="submit"
            className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition duration-200"
            disabled={loading}
          >
            {loading ? 'Saving...' : (isEditMode ? 'Update Role' : 'Create Role')}
          </button>
        </div>
      </form>
    </div>
  );
};

// --- New Feature: Accounts Overview (User & Admin) ---
const ACCOUNTS_OVERVIEW_QUERY = gql`
  query AccountsOverview($first: Int, $after: String, $searchQuery: String, $accountType: String, $currency: String, $minBalance: Float, $maxBalance: Float) {
    accounts(first: $first, after: $after, searchQuery: $searchQuery, accountType: $accountType, currency: $currency, minBalance: $minBalance, maxBalance: $maxBalance) {
      edges {
        node {
          id
          accountNumber
          accountType
          name
          balance {
            amount
            currency
            __typename
          }
          status
          createdAt
          isJointAccount
          primaryHolder {
            id
            username
            __typename
          }
          __typename
        }
      }
      pageInfo {
        startCursor
        endCursor
        hasNextPage
        hasPreviousPage
        __typename
      }
    }
  }
`;

interface Balance {
  amount: number;
  currency: string;
  __typename: string;
}

interface AccountNode {
  id: string;
  accountNumber: string;
  accountType: 'CHECKING' | 'SAVINGS' | 'LOAN' | 'CREDIT_CARD' | 'INVESTMENT';
  name: string;
  balance: Balance;
  status: 'ACTIVE' | 'FROZEN' | 'CLOSED';
  createdAt: string;
  isJointAccount: boolean;
  primaryHolder: {
    id: string;
    username: string;
    __typename: string;
  };
  __typename: string;
}

interface AccountsOverviewData {
  accounts: {
    edges: { node: AccountNode }[];
    pageInfo: {
      startCursor: string | null;
      endCursor: string | null;
      hasNextPage: boolean;
      hasPreviousPage: boolean;
      __typename: string;
    };
  };
}

export const AccountsOverviewPage: React.FC = () => {
  const [filters, setFilters] = useState({
    searchQuery: '',
    accountType: '',
    currency: '',
    minBalance: '',
    maxBalance: '',
  });

  const variables = useMemo(() => ({
    first: 10,
    searchQuery: filters.searchQuery || null,
    accountType: filters.accountType || null,
    currency: filters.currency || null,
    minBalance: filters.minBalance ? parseFloat(filters.minBalance) : null,
    maxBalance: filters.maxBalance ? parseFloat(filters.maxBalance) : null,
  }), [filters]);

  const { loading, error, data, fetchMore } = useQuery<AccountsOverviewData>(ACCOUNTS_OVERVIEW_QUERY, {
    variables,
    notifyOnNetworkStatusChange: true,
  });

  const handleFilterChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setFilters(prev => ({ ...prev, [name]: value }));
  };

  const loadMore = useCallback(() => {
    if (data?.accounts.pageInfo.hasNextPage && !loading) {
      fetchMore({
        variables: { after: data.accounts.pageInfo.endCursor, ...variables },
        updateQuery: (prev, { fetchMoreResult }) => {
          if (!fetchMoreResult) return prev;
          return {
            accounts: {
              ...fetchMoreResult.accounts,
              edges: [
                ...prev.accounts.edges,
                ...fetchMoreResult.accounts.edges,
              ],
            },
          };
        },
      });
    }
  }, [data, fetchMore, loading, variables]);

  const accountTypes = ['CHECKING', 'SAVINGS', 'LOAN', 'CREDIT_CARD', 'INVESTMENT'];
  const currencies = ['USD', 'EUR', 'GBP', 'JPY'];

  if (loading && !data) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">My Accounts Overview</h2>

      <div className="flex flex-wrap items-center gap-4 mb-6 bg-gray-50 p-4 rounded-lg shadow-sm">
        <input
          type="text"
          name="searchQuery"
          placeholder="Search by Account Name or Number..."
          value={filters.searchQuery}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 flex-grow max-w-sm"
        />
        <select
          name="accountType"
          value={filters.accountType}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All Account Types</option>
          {accountTypes.map(type => <option key={type} value={type}>{type.replace('_', ' ')}</option>)}
        </select>
        <select
          name="currency"
          value={filters.currency}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All Currencies</option>
          {currencies.map(c => <option key={c} value={c}>{c}</option>)}
        </select>
        <input
          type="number"
          name="minBalance"
          placeholder="Min Balance"
          value={filters.minBalance}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 w-32"
        />
        <input
          type="number"
          name="maxBalance"
          placeholder="Max Balance"
          value={filters.maxBalance}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 w-32"
        />
        <Link to="/accounts/new" className="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 transition duration-200 flex-shrink-0">
          <i className="fas fa-plus mr-2"></i> Open New Account
        </Link>
      </div>

      <div className="bg-white shadow-md rounded-lg overflow-hidden">
        <table className="min-w-full divide-y divide-gray-200">
          <thead className="bg-gray-50">
            <tr>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Account Number</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Account Name</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Balance</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created At</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody className="bg-white divide-y divide-gray-200">
            {data?.accounts.edges.length === 0 ? (
              <tr>
                <td colSpan={7} className="px-6 py-4 text-center text-gray-500">No accounts found.</td>
              </tr>
            ) : (
              data?.accounts.edges.map(({ node }) => (
                <tr key={node.id}>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{node.accountNumber}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.name}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.accountType.replace('_', ' ')}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    {new Intl.NumberFormat('en-US', { style: 'currency', currency: node.balance.currency }).format(node.balance.amount)}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm">
                    <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${node.status === 'ACTIVE' ? 'bg-green-100 text-green-800' : node.status === 'FROZEN' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800'}`}>
                      {node.status}
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{new Date(node.createdAt).toLocaleDateString()}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <Link to={`/accounts/${node.id}`} className="text-indigo-600 hover:text-indigo-900 mr-2">View Details</Link>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
        {data?.accounts.pageInfo.hasNextPage && (
          <div className="p-4 text-center border-t border-gray-200">
            <button
              onClick={loadMore}
              className="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition duration-200"
              disabled={loading}
            >
              {loading ? 'Loading...' : 'Load More'}
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

// --- New Feature: Account Details (User & Admin) ---
const ACCOUNT_DETAILS_QUERY = gql`
  query AccountDetails($id: ID!) {
    account(id: $id) {
      id
      accountNumber
      accountType
      name
      description
      balance {
        amount
        currency
        __typename
      }
      availableBalance {
        amount
        currency
        __typename
      }
      status
      createdAt
      updatedAt
      closedAt
      isJointAccount
      primaryHolder {
        id
        username
        email
        __typename
      }
      jointHolders { # If joint account
        id
        username
        email
        __typename
      }
      associatedAccountGroup { # Link to account group
        id
        name
        __typename
      }
      transactionHistory(first: 5, orderBy: {field: DATE, direction: DESC}) { # Recent transactions
        edges {
          node {
            id
            description
            amount {
              amount
              currency
              __typename
            }
            type
            status
            transactionDate
            __typename
          }
        }
      }
      __typename
    }
  }
`;

interface AccountDetailsData {
  account: AccountNode & {
    description: string | null;
    availableBalance: Balance;
    closedAt: string | null;
    jointHolders: { id: string; username: string; email: string; __typename: string }[];
    associatedAccountGroup: { id: string; name: string; __typename: string } | null;
    transactionHistory: {
      edges: { node: TransactionNode }[];
    };
  };
}

interface TransactionNode {
  id: string;
  description: string;
  amount: Balance;
  type: string;
  status: string;
  transactionDate: string;
  __typename: string;
}

export const AccountDetailsPage: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { loading, error, data } = useQuery<AccountDetailsData>(ACCOUNT_DETAILS_QUERY, {
    variables: { id },
  });
  const navigate = useNavigate();

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;
  if (!data?.account) return <p className="text-center p-4">Account not found.</p>;

  const account = data.account;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">Account Details: {account.name} ({account.accountNumber})</h2>
      <div className="bg-white shadow-md rounded-lg p-6 max-w-4xl mx-auto">
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6 border-b pb-4">
          <DetailItem label="Account Number" value={account.accountNumber} />
          <DetailItem label="Account Name" value={account.name} />
          <DetailItem label="Account Type" value={account.accountType.replace('_', ' ')} />
          <DetailItem label="Current Balance" value={new Intl.NumberFormat('en-US', { style: 'currency', currency: account.balance.currency }).format(account.balance.amount)} />
          <DetailItem label="Available Balance" value={new Intl.NumberFormat('en-US', { style: 'currency', currency: account.availableBalance.currency }).format(account.availableBalance.amount)} />
          <DetailItem label="Status" value={
            <span className={`px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${account.status === 'ACTIVE' ? 'bg-green-100 text-green-800' : account.status === 'FROZEN' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800'}`}>
              {account.status}
            </span>
          } />
          <DetailItem label="Primary Holder" value={account.primaryHolder?.username || 'N/A'} link={authService.hasRole('Admin') ? `/admin/users/${account.primaryHolder?.id}` : undefined} />
          <DetailItem label="Joint Account" value={account.isJointAccount ? 'Yes' : 'No'} />
          <DetailItem label="Created At" value={new Date(account.createdAt).toLocaleString()} />
          <DetailItem label="Last Updated" value={new Date(account.updatedAt).toLocaleString()} />
          <DetailItem label="Closed At" value={account.closedAt ? new Date(account.closedAt).toLocaleString() : 'N/A'} />
          {account.associatedAccountGroup && (
            <DetailItem label="Account Group" value={account.associatedAccountGroup.name} link={`/account-groups/${account.associatedAccountGroup.id}`} />
          )}
          <DetailItem label="Description" value={account.description || 'N/A'} className="lg:col-span-3" />
        </div>

        {account.isJointAccount && account.jointHolders && account.jointHolders.length > 0 && (
          <div className="mb-6 border-b pb-4">
            <h3 className="text-xl font-semibold text-gray-800 mb-2">Joint Holders</h3>
            <ul className="list-disc list-inside text-gray-700 ml-4">
              {account.jointHolders.map((holder) => (
                <li key={holder.id} className="py-1">
                  <Link to={authService.hasRole('Admin') ? `/admin/users/${holder.id}` : '#'} className="text-blue-600 hover:underline">
                    {holder.username} ({holder.email})
                  </Link>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div className="mb-6 border-b pb-4">
          <h3 className="text-xl font-semibold text-gray-800 mb-2">Recent Transactions</h3>
          {account.transactionHistory.edges.length > 0 ? (
            <div className="bg-gray-50 rounded-md overflow-hidden">
              <table className="min-w-full divide-y divide-gray-200">
                <thead className="bg-gray-100">
                  <tr>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                    <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {account.transactionHistory.edges.map(({ node }) => (
                    <tr key={node.id}>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{new Date(node.transactionDate).toLocaleDateString()}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.description}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.type}</td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-right font-medium text-gray-900">
                        {new Intl.NumberFormat('en-US', { style: 'currency', currency: node.amount.currency }).format(node.amount.amount)}
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm">
                        <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${node.status === 'COMPLETED' ? 'bg-green-100 text-green-800' : node.status === 'PENDING' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800'}`}>
                          {node.status}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p className="text-gray-700">No recent transactions for this account.</p>
          )}
          <div className="mt-4 text-center">
            <Link to={`/transactions?accountId=${account.id}`} className="text-blue-600 hover:underline">View All Transactions</Link>
          </div>
        </div>

        <div className="flex justify-end space-x-2 mt-6">
          <button
            onClick={() => navigate('/accounts')}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
          >
            Back to Accounts List
          </button>
          {authService.hasRole('Admin') || account.primaryHolder?.id === authService.getCurrentUser()?.id && account.status === 'ACTIVE' && (
            <Link to={`/accounts/${account.id}/transfer`} className="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 transition duration-200">
              Transfer Funds
            </Link>
          )}
          {authService.hasRole('Admin') && account.status === 'ACTIVE' && (
            <button className="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 transition duration-200">
              Freeze Account
            </button>
          )}
        </div>
      </div>
    </div>
  );
};

// --- New Feature: Open New Account Form (User & Admin) ---
const OPEN_ACCOUNT_MUTATION = gql`
  mutation OpenNewAccount($input: OpenNewAccountInput!) {
    openNewAccount(input: $input) {
      account {
        id
        accountNumber
        name
        __typename
      }
      errors
      __typename
    }
  }
`;

// Example query for available account types with their properties (min balance, interest rate, etc.)
const ACCOUNT_PRODUCT_TYPES_QUERY = gql`
  query AccountProductTypes {
    accountProductTypes {
      id
      name
      description
      type # e.g., CHECKING, SAVINGS, LOAN
      minOpeningBalance {
        amount
        currency
        __typename
      }
      interestRate
      monthlyFee {
        amount
        currency
        __typename
      }
      canBeJoint
      __typename
    }
  }
`;

interface AccountProductType {
  id: string;
  name: string;
  description: string;
  type: 'CHECKING' | 'SAVINGS' | 'LOAN' | 'CREDIT_CARD' | 'INVESTMENT';
  minOpeningBalance: Balance | null;
  interestRate: number | null;
  monthlyFee: Balance | null;
  canBeJoint: boolean;
  __typename: string;
}

interface AccountProductTypesData {
  accountProductTypes: AccountProductType[];
}

export const OpenNewAccountForm: React.FC = () => {
  const navigate = useNavigate();
  const { showNotification, currentUser } = useAppContext();

  const [formData, setFormData] = useState({
    accountProductId: '',
    accountName: '',
    initialDepositAmount: '',
    currency: 'USD',
    isJointAccount: false,
    jointHolderUsernames: '', // comma-separated usernames
    purpose: '',
  });
  const [formErrors, setFormErrors] = useState<Record<string, string>>({});

  const { data: productTypesData, loading: productsLoading } = useQuery<AccountProductTypesData>(ACCOUNT_PRODUCT_TYPES_QUERY);
  const availableProductTypes = productTypesData?.accountProductTypes || [];

  const selectedProduct = useMemo(() => {
    return availableProductTypes.find(p => p.id === formData.accountProductId);
  }, [availableProductTypes, formData.accountProductId]);

  const [openNewAccount, { loading: openingAccount }] = useMutation(OPEN_ACCOUNT_MUTATION, {
    onCompleted: (result) => {
      if (result.data.openNewAccount.errors && result.data.openNewAccount.errors.length > 0) {
        showNotification(`Error opening account: ${result.data.openNewAccount.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.data.openNewAccount.errors.join(', ') });
      } else {
        showNotification(`Account '${result.data.openNewAccount.account.name}' opened successfully!`, 'success');
        navigate(`/accounts/${result.data.openNewAccount.account.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error opening account: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const loading = openingAccount || productsLoading;

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value, type } = e.target;
    if (type === 'checkbox') {
      setFormData({ ...formData, [name]: (e.target as HTMLInputElement).checked });
    } else {
      setFormData({ ...formData, [name]: value });
    }
    setFormErrors(prev => ({ ...prev, [name]: '' }));
  };

  const validateForm = () => {
    const errors: Record<string, string> = {};
    if (!formData.accountProductId) errors.accountProductId = 'Please select an account type.';
    if (!formData.accountName.trim()) errors.accountName = 'Account Name is required.';
    if (!formData.initialDepositAmount.trim() || parseFloat(formData.initialDepositAmount) <= 0) {
      errors.initialDepositAmount = 'Initial deposit must be a positive number.';
    } else if (selectedProduct?.minOpeningBalance && parseFloat(formData.initialDepositAmount) < selectedProduct.minOpeningBalance.amount) {
      errors.initialDepositAmount = `Initial deposit must be at