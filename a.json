export const ROLES_QUERY = gql`
  query ApiKeyForm($roleType: [String!] = [], $actorSource: String) {
    rolesUnpaginated(roleType: $roleType, actorSource: $actorSource) {
      id
      name
      description
      roleType
      __typename
    }
  }
`;

interface Role {
  id: string;
  name: string;
  description: string;
  roleType: string;
  __typename: string;
}

interface RolesData {
  rolesUnpaginated: Role[];
}

export const APIKeyForm: React.FC = () => {
  const { id } = useParams<{ id?: string }>(); // Optional ID for edit mode
  const navigate = useNavigate();
  const { showNotification } = useAppContext();

  const isEditMode = !!id;

  const [formData, setFormData] = useState({
    name: '',
    ipAllowlist: '', // Comma-separated string
    liveMode: false,
    rateLimit: 0,
    roles: [] as string[], // Array of role IDs
    sendEmail: false, // Additional common form field
    notes: '', // Another example field
    expiresAt: '', // Date field
    metadata: [] as { key: string; value: string }[], // Dynamic metadata
  });
  const [formErrors, setFormErrors] = useState<Record<string, string>>({});
  const [secretKey, setSecretKey] = useState<string | null>(null);
  const [showSecretModal, setShowSecretModal] = useState(false);

  // Fetch roles for the dropdown
  const { data: rolesData, loading: rolesLoading } = useQuery<RolesData>(ROLES_QUERY);
  const availableRoles = rolesData?.rolesUnpaginated || [];

  // Fetch API Key data in edit mode
  const { data: apiKeyData, loading: apiKeyLoading, error: apiKeyError } = useQuery<ApiKeyViewData>(API_KEY_VIEW_QUERY, {
    variables: { id: id! },
    skip: !isEditMode,
  });

  useEffect(() => {
    if (isEditMode && apiKeyData?.apiKey) {
      const apiKey = apiKeyData.apiKey;
      setFormData({
        name: apiKey.name,
        ipAllowlist: apiKey.ipAllowlist ? apiKey.ipAllowlist.join(', ') : '',
        liveMode: apiKey.liveMode,
        rateLimit: apiKey.rateLimit || 0,
        roles: apiKey.rolesV2?.map(r => r.id) || [],
        sendEmail: false, // Default for non-existent field, or fetch if available
        notes: '', // Default for non-existent field, or fetch if available
        expiresAt: apiKey.expiresAt ? new Date(apiKey.expiresAt).toISOString().split('T')[0] : '', // Format for date input
        metadata: apiKey.metadata || [],
      });
    }
  }, [isEditMode, apiKeyData]);

  const [createApiKey, { loading: createLoading }] = useMutation(CREATE_API_KEY_MUTATION, {
    onCompleted: (result) => {
      if (result.data.createApiKey.errors && result.data.createApiKey.errors.length > 0) {
        showNotification(`Error creating API Key: ${result.data.createApiKey.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.data.createApiKey.errors.join(', ') });
      } else {
        showNotification(`API Key '${result.data.createApiKey.apiKey.name}' created successfully!`, 'success');
        setSecretKey(result.data.createApiKey.apiKey.keySecret);
        setShowSecretModal(true);
        // Optionally, reset form here or navigate
        // navigate(`/api-keys/${result.data.createApiKey.apiKey.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error creating API Key: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const [updateApiKey, { loading: updateLoading }] = useMutation(UPDATE_API_KEY_MUTATION, {
    onCompleted: (result) => {
      if (result.data.updateApiKey.errors && result.data.updateApiKey.errors.length > 0) {
        showNotification(`Error updating API Key: ${result.data.updateApiKey.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.data.updateApiKey.errors.join(', ') });
      } else {
        showNotification(`API Key '${result.data.updateApiKey.apiKey.name}' updated successfully!`, 'success');
        navigate(`/api-keys/${result.data.updateApiKey.apiKey.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error updating API Key: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const loading = createLoading || updateLoading || (isEditMode && apiKeyLoading) || rolesLoading;
  const error = (isEditMode && apiKeyError); // Only show fetch error for edit mode, mutation errors are handled separately

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value, type } = e.target;
    if (type === 'checkbox') {
      setFormData({ ...formData, [name]: (e.target as HTMLInputElement).checked });
    } else if (name === 'roles') {
      const selectedOptions = Array.from((e.target as HTMLSelectElement).options)
        .filter(option => option.selected)
        .map(option => option.value);
      setFormData({ ...formData, roles: selectedOptions });
    }
    else {
      setFormData({ ...formData, [name]: value });
    }
    setFormErrors(prev => ({ ...prev, [name]: '' }));
  };

  const handleMetadataChange = (index: number, field: 'key' | 'value', value: string) => {
    const newMetadata = [...formData.metadata];
    newMetadata[index] = { ...newMetadata[index], [field]: value };
    setFormData({ ...formData, metadata: newMetadata });
  };

  const addMetadataField = () => {
    setFormData({ ...formData, metadata: [...formData.metadata, { key: '', value: '' }] });
  };

  const removeMetadataField = (index: number) => {
    const newMetadata = formData.metadata.filter((_, i) => i !== index);
    setFormData({ ...formData, metadata: newMetadata });
  };

  const validateForm = () => {
    const errors: Record<string, string> = {};
    if (!formData.name.trim()) {
      errors.name = 'Name is required.';
    }
    if (formData.rateLimit < 0) {
      errors.rateLimit = 'Rate limit cannot be negative.';
    }
    if (formData.expiresAt) {
      const expiryDate = new Date(formData.expiresAt);
      const now = new Date();
      now.setHours(0, 0, 0, 0); // Compare dates only
      if (expiryDate < now) {
        errors.expiresAt = 'Expiration date cannot be in the past.';
      }
    }
    // Validate IP Allowlist format (simple regex, could be more robust)
    if (formData.ipAllowlist.trim()) {
      const ips = formData.ipAllowlist.split(',').map(s => s.trim()).filter(Boolean);
      const ipRegex = /^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\/(?:[0-2]?[0-9]|3[0-2]))?$/;
      for (const ip of ips) {
        if (!ipRegex.test(ip)) {
          errors.ipAllowlist = 'Invalid IP address or CIDR block in allowlist.';
          break;
        }
      }
    }

    setFormErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormErrors({}); // Clear previous errors
    if (!validateForm()) {
      showNotification('Please correct the errors in the form.', 'error');
      return;
    }

    const input = {
      name: formData.name,
      ipAllowlist: formData.ipAllowlist ? formData.ipAllowlist.split(',').map(s => s.trim()) : [],
      liveMode: formData.liveMode,
      rateLimit: formData.rateLimit > 0 ? formData.rateLimit : null,
      roleIds: formData.roles,
      expiresAt: formData.expiresAt ? new Date(formData.expiresAt).toISOString() : null,
      metadata: formData.metadata.filter(m => m.key.trim() && m.value.trim()), // Only send valid metadata
      // The sendEmail and notes fields are illustrative; they would need to be part of the GraphQL input type
      // notes: formData.notes,
      // sendEmail: formData.sendEmail,
    };

    try {
      if (isEditMode) {
        await updateApiKey({
          variables: {
            input: {
              id: id!,
              ...input
            },
          },
        });
      } else {
        await createApiKey({
          variables: { input },
        });
        // After creation, form is reset and secret key shown in modal
      }
    } catch (err: any) {
      // Errors are handled by onError callback of useMutation
    }
  };

  if (isEditMode && apiKeyLoading) return <LoadingSpinner />;
  if (isEditMode && error) return <ErrorMessage message={error.message} />;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">{isEditMode ? `Edit API Key: ${apiKeyData?.apiKey.name}` : 'Create New API Key'}</h2>

      <form onSubmit={handleSubmit} className="bg-white shadow-md rounded-lg p-6 max-w-2xl mx-auto space-y-6">
        {formErrors.submit && <ErrorMessage message={formErrors.submit} />}
        {error && <ErrorMessage message={error.message} />}

        {/* Name Field */}
        <div>
          <label htmlFor="name" className="block text-sm font-medium text-gray-700 mb-1">API Key Name <span className="text-red-500">*</span></label>
          <input
            type="text"
            id="name"
            name="name"
            value={formData.name}
            onChange={handleChange}
            className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.name ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
            required
            aria-invalid={!!formErrors.name}
            aria-describedby="name-error"
          />
          {formErrors.name && <p id="name-error" className="mt-1 text-sm text-red-600">{formErrors.name}</p>}
        </div>

        {/* IP Allowlist Field */}
        <div>
          <label htmlFor="ipAllowlist" className="block text-sm font-medium text-gray-700 mb-1">IP Allowlist (comma-separated)</label>
          <input
            type="text"
            id="ipAllowlist"
            name="ipAllowlist"
            value={formData.ipAllowlist}
            onChange={handleChange}
            className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.ipAllowlist ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
            placeholder="e.g., 192.168.1.1, 10.0.0.0/24"
            aria-invalid={!!formErrors.ipAllowlist}
            aria-describedby="ipAllowlist-error"
          />
          <p className="mt-1 text-xs text-gray-500">List of IP addresses or CIDR blocks allowed to use this key. Leave empty for unrestricted access.</p>
          {formErrors.ipAllowlist && <p id="ipAllowlist-error" className="mt-1 text-sm text-red-600">{formErrors.ipAllowlist}</p>}
        </div>

        {/* Live Mode Checkbox */}
        <div className="flex items-center">
          <input
            id="liveMode"
            name="liveMode"
            type="checkbox"
            checked={formData.liveMode}
            onChange={handleChange}
            className="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
          />
          <label htmlFor="liveMode" className="ml-2 block text-sm text-gray-900">
            Live Mode (check for production environment)
          </label>
        </div>

        {/* Rate Limit Field (Number Input) */}
        <div>
          <label htmlFor="rateLimit" className="block text-sm font-medium text-gray-700 mb-1">Rate Limit (requests/minute)</label>
          <input
            type="number"
            id="rateLimit"
            name="rateLimit"
            value={formData.rateLimit}
            onChange={handleChange}
            className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.rateLimit ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
            min="0"
            placeholder="0 for unlimited"
            aria-invalid={!!formErrors.rateLimit}
            aria-describedby="rateLimit-error"
          />
          {formErrors.rateLimit && <p id="rateLimit-error" className="mt-1 text-sm text-red-600">{formErrors.rateLimit}</p>}
        </div>

        {/* Roles Multiselect */}
        <div>
          <label htmlFor="roles" className="block text-sm font-medium text-gray-700 mb-1">Assign Roles</label>
          <select
            multiple
            id="roles"
            name="roles"
            value={formData.roles}
            onChange={handleChange}
            className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 h-32"
          >
            {availableRoles.length === 0 && !rolesLoading && (
              <option disabled>No roles available</option>
            )}
            {rolesLoading ? (
              <option disabled>Loading roles...</option>
            ) : (
              availableRoles.map(role => (
                <option key={role.id} value={role.id} title={role.description}>{role.name} ({role.roleType})</option>
              ))
            )}
          </select>
          <p className="mt-1 text-xs text-gray-500">Hold Ctrl/Cmd to select multiple roles. Roles define permissions.</p>
        </div>

        {/* Example: Expiration Date (Date Input) */}
        <div>
          <label htmlFor="expiresAt" className="block text-sm font-medium text-gray-700 mb-1">Expiration Date (Optional)</label>
          <input
            type="date"
            id="expiresAt"
            name="expiresAt"
            value={formData.expiresAt}
            onChange={handleChange}
            className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.expiresAt ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
            aria-invalid={!!formErrors.expiresAt}
            aria-describedby="expiresAt-error"
          />
          {formErrors.expiresAt && <p id="expiresAt-error" className="mt-1 text-sm text-red-600">{formErrors.expiresAt}</p>}
        </div>

        {/* Dynamic Metadata Fields */}
        <div>
          <h3 className="text-lg font-medium text-gray-700 mb-2">Metadata (Optional)</h3>
          {formData.metadata.map((meta, index) => (
            <div key={index} className="flex space-x-2 mb-2">
              <input
                type="text"
                placeholder="Key"
                value={meta.key}
                onChange={(e) => handleMetadataChange(index, 'key', e.target.value)}
                className="block w-1/3 px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
              />
              <input
                type="text"
                placeholder="Value"
                value={meta.value}
                onChange={(e) => handleMetadataChange(index, 'value', e.target.value)}
                className="block w-2/3 px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
              />
              <button
                type="button"
                onClick={() => removeMetadataField(index)}
                className="p-2 bg-red-500 text-white rounded-md hover:bg-red-600 transition duration-200"
              >
                <i className="fas fa-trash"></i>
              </button>
            </div>
          ))}
          <button
            type="button"
            onClick={addMetadataField}
            className="mt-2 text-indigo-600 hover:text-indigo-800 text-sm flex items-center"
          >
            <i className="fas fa-plus-circle mr-1"></i> Add Metadata Field
          </button>
          <p className="mt-1 text-xs text-gray-500">Arbitrary key-value pairs for internal use.</p>
        </div>


        {/* Example: Send Email Checkbox */}
        {!isEditMode && ( // Only show on creation
          <div className="flex items-center">
            <input
              id="sendEmail"
              name="sendEmail"
              type="checkbox"
              checked={formData.sendEmail}
              onChange={handleChange}
              className="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"
            />
            <label htmlFor="sendEmail" className="ml-2 block text-sm text-gray-900">
              Send Email Notification to Admins on Creation
            </label>
          </div>
        )}

        {/* Example: Notes Textarea */}
        <div>
          <label htmlFor="notes" className="block text-sm font-medium text-gray-700 mb-1">Internal Notes</label>
          <textarea
            id="notes"
            name="notes"
            value={formData.notes}
            onChange={handleChange}
            rows={3}
            className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
            placeholder="Add any internal notes about this API key, e.g., purpose, associated project, team contact..."
          ></textarea>
        </div>

        <div className="flex justify-end space-x-2 mt-6">
          <button
            type="button"
            onClick={() => navigate('/api-keys')}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
            disabled={loading}
          >
            Cancel
          </button>
          <button
            type="submit"
            className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition duration-200"
            disabled={loading}
          >
            {loading ? 'Saving...' : (isEditMode ? 'Update API Key' : 'Create API Key')}
          </button>
        </div>
      </form>

      {/* Secret Key Modal for New API Key */}
      <Modal isOpen={showSecretModal} onClose={() => { setShowSecretModal(false); setSecretKey(null); navigate('/api-keys'); }} title="API Key Secret Generated" size="md">
        <p className="text-gray-700 mb-4">Please copy your new API Key Secret. This will be the only time it is displayed.</p>
        <div className="bg-gray-100 p-3 rounded-md border border-gray-300 flex items-center justify-between">
          <code className="break-all font-mono text-sm text-gray-800">{secretKey}</code>
          <button
            onClick={() => { navigator.clipboard.writeText(secretKey || ''); showNotification('API Key Secret copied to clipboard!', 'info'); }}
            className="ml-4 px-3 py-1 bg-blue-500 text-white rounded-md hover:bg-blue-600 text-sm"
          >
            Copy
          </button>
        </div>
        <p className="mt-2 text-red-600 text-sm font-semibold">Store this secret securely. It cannot be retrieved again.</p>
        <div className="mt-6 flex justify-end">
          <button
            onClick={() => { setShowSecretModal(false); setSecretKey(null); navigate('/api-keys'); }}
            className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition duration-200"
          >
            Done
          </button>
        </div>
      </Modal>
    </div>
  );
};


// --- Account Groups Section (Expanded) ---

const ACCOUNT_GROUPS_HOME_QUERY = gql`
  query AccountGroupsHome($first: Int, $after: String, $last: Int, $before: String, $searchQuery: String, $currency: String, $minAccounts: Int) {
    accountGroups(
      first: $first
      after: $after
      last: $last
      before: $before
      searchQuery: $searchQuery # New filter
      currency: $currency # New filter
      minInternalAccountCount: $minAccounts # New filter parameter
    ) {
      edges {
        node {
          id
          name
          currency
          description
          internalAccountCount
          createdAt # Added field
          updatedAt # Added field
          status # Added field: ACTIVE, ARCHIVED
          path
          __typename
        }
        __typename
      }
      pageInfo {
        startCursor
        endCursor
        hasNextPage
        hasPreviousPage
        __typename
      }
      __typename
    }
    abilities { # Added abilities for creation
      AccountGroup {
        canCreate
        canUpdate
        canArchive
        __typename
      }
      __typename
    }
  }
`;

interface AccountGroupNode {
  id: string;
  name: string;
  currency: string;
  description: string | null;
  internalAccountCount: number;
  createdAt: string;
  updatedAt: string;
  status: 'ACTIVE' | 'ARCHIVED';
  path: string;
  __typename: string;
}

interface AccountGroupsHomeData {
  accountGroups: {
    edges: { node: AccountGroupNode; __typename: string }[];
    pageInfo: {
      startCursor: string | null;
      endCursor: string | null;
      hasNextPage: boolean;
      hasPreviousPage: boolean;
      __typename: string;
    };
    __typename: string;
  };
  abilities: {
    AccountGroup: {
      canCreate: boolean;
      canUpdate: boolean;
      canArchive: boolean;
      __typename: string;
    };
    __typename: string;
  };
}

const ARCHIVE_ACCOUNT_GROUP_MUTATION = gql`
  mutation ArchiveAccountGroup($id: ID!) {
    archiveAccountGroup(input: { id: $id }) {
      accountGroup {
        id
        status
        __typename
      }
      errors
      __typename
    }
  }
`;

export const AccountGroupsList: React.FC = () => {
  const [filters, setFilters] = useState({
    searchQuery: '',
    currency: '',
    minAccounts: 0,
  });
  const { showNotification } = useAppContext();

  const variables = useMemo(() => ({
    first: 10,
    searchQuery: filters.searchQuery || null,
    currency: filters.currency || null,
    minAccounts: filters.minAccounts > 0 ? filters.minAccounts : null,
  }), [filters]);

  const { loading, error, data, fetchMore, refetch } = useQuery<AccountGroupsHomeData>(ACCOUNT_GROUPS_HOME_QUERY, {
    variables,
    notifyOnNetworkStatusChange: true,
  });

  const [archiveAccountGroup, { loading: archiving }] = useMutation(ARCHIVE_ACCOUNT_GROUP_MUTATION, {
    onCompleted: (result) => {
      if (result.archiveAccountGroup.errors) {
        showNotification(`Error archiving account group: ${result.archiveAccountGroup.errors.join(', ')}`, 'error');
      } else {
        showNotification(`Account Group ${result.archiveAccountGroup.accountGroup.id} archived successfully.`, 'success');
        refetch();
      }
    },
    onError: (err) => {
      showNotification(`Error archiving account group: ${err.message}`, 'error');
    },
  });

  const handleFilterChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value, type } = e.target;
    setFilters(prev => ({ ...prev, [name]: type === 'number' ? parseFloat(value) : value }));
  };

  const handleArchive = async (id: string) => {
    if (window.confirm('Are you sure you want to archive this account group? All accounts within it will also be affected.')) {
      await archiveAccountGroup({ variables: { id } });
    }
  };

  const loadMore = useCallback(() => {
    if (data?.accountGroups.pageInfo.hasNextPage && !loading) {
      fetchMore({
        variables: { after: data.accountGroups.pageInfo.endCursor, ...variables },
        updateQuery: (prev, { fetchMoreResult }) => {
          if (!fetchMoreResult) return prev;
          return {
            accountGroups: {
              ...fetchMoreResult.accountGroups,
              edges: [
                ...prev.accountGroups.edges,
                ...fetchMoreResult.accountGroups.edges,
              ],
            },
            abilities: prev.abilities,
          };
        },
      });
    }
  }, [data, fetchMore, loading, variables]);

  if (loading && !data) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;

  const canCreate = data?.abilities.AccountGroup.canCreate;
  const canUpdate = data?.abilities.AccountGroup.canUpdate;
  const canArchive = data?.abilities.AccountGroup.canArchive;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">Account Groups</h2>

      <div className="flex flex-wrap items-center gap-4 mb-6">
        <input
          type="text"
          name="searchQuery"
          placeholder="Search by Name or Description..."
          value={filters.searchQuery}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 flex-grow max-w-sm"
        />
        <select
          name="currency"
          value={filters.currency}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All Currencies</option>
          <option value="USD">USD</option>
          <option value="EUR">EUR</option>
          <option value="GBP">GBP</option>
          <option value="JPY">JPY</option>
        </select>
        <input
          type="number"
          name="minAccounts"
          placeholder="Min. Accounts"
          value={filters.minAccounts}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 w-36"
        />
        {canCreate && (
          <Link to="/account-groups/new" className="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 transition duration-200 flex-shrink-0">
            <i className="fas fa-plus mr-2"></i> Create New Group
          </Link>
        )}
      </div>

      <div className="bg-white shadow-md rounded-lg overflow-hidden">
        <table className="min-w-full divide-y divide-gray-200">
          <thead className="bg-gray-50">
            <tr>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Currency</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Accounts</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody className="bg-white divide-y divide-gray-200">
            {data?.accountGroups.edges.length === 0 ? (
              <tr>
                <td colSpan={7} className="px-6 py-4 text-center text-gray-500">No account groups found.</td>
              </tr>
            ) : (
              data?.accountGroups.edges.map(({ node }) => (
                <tr key={node.id}>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.id}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.name}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.currency}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.description || 'N/A'}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.internalAccountCount}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm">
                    <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${node.status === 'ARCHIVED' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`}>
                      {node.status}
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <Link to={`/account-groups/${node.id}`} className="text-indigo-600 hover:text-indigo-900 mr-2">View</Link>
                    {canUpdate && node.status !== 'ARCHIVED' && (
                      <Link to={`/account-groups/${node.id}/edit`} className="text-yellow-600 hover:text-yellow-900 mr-2">Edit</Link>
                    )}
                    {canArchive && node.status !== 'ARCHIVED' && (
                      <button
                        onClick={() => handleArchive(node.id)}
                        className="text-red-600 hover:text-red-900"
                        disabled={archiving}
                      >
                        {archiving ? 'Archiving...' : 'Archive'}
                      </button>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
        {data?.accountGroups.pageInfo.hasNextPage && (
          <div className="p-4 text-center border-t border-gray-200">
            <button
              onClick={loadMore}
              className="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition duration-200"
              disabled={loading}
            >
              {loading ? 'Loading...' : 'Load More'}
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

// --- Account Group Details ---
const ACCOUNT_GROUP_DETAILS_QUERY = gql`
  query AccountGroupDetails($id: ID!) {
    accountGroup(id: $id) {
      id
      name
      currency
      description
      internalAccountCount
      createdAt
      updatedAt
      status
      path
      managedBy { # Added field for responsible user/team
        id
        name
        email
        __typename
      }
      associatedEntities { # Added linked entities
        id
        name
        type
        __typename
      }
      # Potentially add a sub-query for internalAccounts here if the UI needs to list them
      __typename
    }
  }
`;

interface ManagedBy {
  id: string;
  name: string;
  email: string;
  __typename: string;
}

interface AssociatedEntity {
  id: string;
  name: string;
  type: string; // e.g., 'Client', 'Project'
  __typename: string;
}

interface AccountGroupDetailsData {
  accountGroup: AccountGroupNode & {
    managedBy: ManagedBy | null;
    associatedEntities: AssociatedEntity[];
  };
}

export const AccountGroupDetails: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { loading, error, data } = useQuery<AccountGroupDetailsData>(ACCOUNT_GROUP_DETAILS_QUERY, {
    variables: { id },
  });
  const navigate = useNavigate();

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;
  if (!data?.accountGroup) return <p className="text-center p-4">Account Group not found.</p>;

  const group = data.accountGroup;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">Account Group Details: {group.name}</h2>
      <div className="bg-white shadow-md rounded-lg p-6 max-w-3xl mx-auto">
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <DetailItem label="ID" value={group.id} />
          <DetailItem label="Name" value={group.name} />
          <DetailItem label="Currency" value={group.currency} />
          <DetailItem label="Description" value={group.description || 'N/A'} className="md:col-span-2" />
          <DetailItem label="Internal Accounts" value={group.internalAccountCount} />
          <DetailItem label="Created At" value={new Date(group.createdAt).toLocaleString()} />
          <DetailItem label="Last Updated" value={new Date(group.updatedAt).toLocaleString()} />
          <DetailItem label="Status" value={
            <span className={`px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${group.status === 'ARCHIVED' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`}>
              {group.status}
            </span>
          } />
        </div>

        {group.managedBy && (
          <div className="mb-6 border-t pt-4">
            <h3 className="text-xl font-semibold text-gray-800 mb-2">Managed By</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <DetailItem label="Name" value={group.managedBy.name} />
              <DetailItem label="Email" value={group.managedBy.email} />
            </div>
          </div>
        )}

        {group.associatedEntities && group.associatedEntities.length > 0 && (
          <div className="mb-6 border-t pt-4">
            <h3 className="text-xl font-semibold text-gray-800 mb-2">Associated Entities</h3>
            <ul className="list-disc list-inside text-gray-700 ml-4">
              {group.associatedEntities.map((entity) => (
                <li key={entity.id} className="py-1">{entity.name} (<span className="font-semibold">{entity.type}</span>) - ID: {entity.id}</li>
              ))}
            </ul>
          </div>
        )}

        <div className="flex justify-end space-x-2 mt-6">
          <button
            onClick={() => navigate('/account-groups')}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
          >
            Back to List
          </button>
          {authService.hasRole('Admin') && group.status !== 'ARCHIVED' && (
            <Link to={`/account-groups/${group.id}/edit`} className="bg-indigo-500 text-white px-4 py-2 rounded-md hover:bg-indigo-600 transition duration-200">
              Edit Account Group
            </Link>
          )}
        </div>
      </div>
    </div>
  );
};

const CREATE_ACCOUNT_GROUP_MUTATION = gql`
  mutation CreateAccountGroup($input: CreateAccountGroupInput!) {
    createAccountGroup(input: $input) {
      accountGroup {
        id
        name
        __typename
      }
      errors
      __typename
    }
  }
`;

const UPDATE_ACCOUNT_GROUP_MUTATION = gql`
  mutation UpdateAccountGroup($input: UpdateAccountGroupInput!) {
    updateAccountGroup(input: $input) {
      accountGroup {
        id
        name
        description
        currency
        updatedAt
        __typename
      }
      errors
      __typename
    }
  }
`;

// New: Account Group Form Component
export const AccountGroupForm: React.FC = () => {
  const { id } = useParams<{ id?: string }>();
  const navigate = useNavigate();
  const { showNotification } = useAppContext();

  const isEditMode = !!id;

  const [formData, setFormData] = useState({
    name: '',
    description: '',
    currency: 'USD',
    managedById: '', // New field
    associatedEntityIds: [] as string[], // New field, assuming string IDs for entities
  });
  const [formErrors, setFormErrors] = useState<Record<string, string>>({});

  // Fetch initial data for edit mode
  const { data: accountGroupData, loading: accountGroupLoading, error: accountGroupError } = useQuery<AccountGroupDetailsData>(ACCOUNT_GROUP_DETAILS_QUERY, {
    variables: { id: id! },
    skip: !isEditMode,
  });

  // Example query for available managers (simulated)
  const MANAGERS_QUERY = gql`
    query Managers {
      users(roles: ["AccountManager"]) { # Filter users by role
        id
        name
        email
        __typename
      }
    }
  `;
  const { data: managersData, loading: managersLoading } = useQuery<{ users: ManagedBy[] }>(MANAGERS_QUERY);
  const availableManagers = managersData?.users || [];

  // Example query for available associated entities (simulated)
  const ENTITIES_QUERY = gql`
    query Entities {
      entities {
        id
        name
        type
        __typename
      }
    }
  `;
  const { data: entitiesData, loading: entitiesLoading } = useQuery<{ entities: AssociatedEntity[] }>(ENTITIES_QUERY);
  const availableEntities = entitiesData?.entities || [];

  useEffect(() => {
    if (isEditMode && accountGroupData?.accountGroup) {
      const group = accountGroupData.accountGroup;
      setFormData({
        name: group.name,
        description: group.description || '',
        currency: group.currency,
        managedById: group.managedBy?.id || '',
        associatedEntityIds: group.associatedEntities?.map(e => e.id) || [],
      });
    }
  }, [isEditMode, accountGroupData]);

  const [createAccountGroup, { loading: createLoading }] = useMutation(CREATE_ACCOUNT_GROUP_MUTATION, {
    onCompleted: (result) => {
      if (result.data.createAccountGroup.errors && result.data.createAccountGroup.errors.length > 0) {
        showNotification(`Error creating account group: ${result.data.createAccountGroup.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.data.createAccountGroup.errors.join(', ') });
      } else {
        showNotification(`Account Group '${result.data.createAccountGroup.accountGroup.name}' created successfully!`, 'success');
        navigate(`/account-groups/${result.data.createAccountGroup.accountGroup.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error creating account group: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const [updateAccountGroup, { loading: updateLoading }] = useMutation(UPDATE_ACCOUNT_GROUP_MUTATION, {
    onCompleted: (result) => {
      if (result.data.updateAccountGroup.errors && result.data.updateAccountGroup.errors.length > 0) {
        showNotification(`Error updating account group: ${result.data.updateAccountGroup.errors.join(', ')}`, 'error');
        setFormErrors({ submit: result.data.updateAccountGroup.errors.join(', ') });
      } else {
        showNotification(`Account Group '${result.data.updateAccountGroup.accountGroup.name}' updated successfully!`, 'success');
        navigate(`/account-groups/${result.data.updateAccountGroup.accountGroup.id}`);
      }
    },
    onError: (err) => {
      showNotification(`Error updating account group: ${err.message}`, 'error');
      setFormErrors({ submit: err.message });
    },
  });

  const loading = createLoading || updateLoading || accountGroupLoading || managersLoading || entitiesLoading;
  const error = accountGroupError;

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value, type } = e.target;
    if (name === 'associatedEntityIds') {
      const selectedOptions = Array.from((e.target as HTMLSelectElement).options)
        .filter(option => option.selected)
        .map(option => option.value);
      setFormData({ ...formData, associatedEntityIds: selectedOptions });
    } else {
      setFormData({ ...formData, [name]: value });
    }
    setFormErrors(prev => ({ ...prev, [name]: '' }));
  };

  const validateForm = () => {
    const errors: Record<string, string> = {};
    if (!formData.name.trim()) errors.name = 'Name is required.';
    if (!formData.currency.trim()) errors.currency = 'Currency is required.';
    if (formData.description.length > 255) errors.description = 'Description cannot exceed 255 characters.';

    setFormErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormErrors({});
    if (!validateForm()) {
      showNotification('Please correct the errors in the form.', 'error');
      return;
    }

    const input = {
      name: formData.name,
      description: formData.description,
      currency: formData.currency,
      managedById: formData.managedById || null,
      associatedEntityIds: formData.associatedEntityIds,
    };

    try {
      if (isEditMode) {
        await updateAccountGroup({ variables: { input: { id: id!, ...input } } });
      } else {
        await createAccountGroup({ variables: { input } });
      }
    } catch (err: any) {
      // Errors handled by mutation onError
    }
  };

  if (isEditMode && accountGroupLoading) return <LoadingSpinner />;
  if (isEditMode && error) return <ErrorMessage message={error.message} />;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">{isEditMode ? `Edit Account Group: ${accountGroupData?.accountGroup.name}` : 'Create New Account Group'}</h2>

      <form onSubmit={handleSubmit} className="bg-white shadow-md rounded-lg p-6 max-w-2xl mx-auto space-y-6">
        {formErrors.submit && <ErrorMessage message={formErrors.submit} />}
        {error && <ErrorMessage message={error.message} />}

        {/* Name Field */}
        <div>
          <label htmlFor="name" className="block text-sm font-medium text-gray-700 mb-1">Group Name <span className="text-red-500">*</span></label>
          <input
            type="text"
            id="name"
            name="name"
            value={formData.name}
            onChange={handleChange}
            className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.name ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
            required
          />
          {formErrors.name && <p className="mt-1 text-sm text-red-600">{formErrors.name}</p>}
        </div>

        {/* Description Field */}
        <div>
          <label htmlFor="description" className="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea
            id="description"
            name="description"
            value={formData.description}
            onChange={handleChange}
            rows={3}
            className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.description ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
            placeholder="A brief description of this account group's purpose or scope."
          ></textarea>
          {formErrors.description && <p className="mt-1 text-sm text-red-600">{formErrors.description}</p>}
        </div>

        {/* Currency Selector */}
        <div>
          <label htmlFor="currency" className="block text-sm font-medium text-gray-700 mb-1">Default Currency <span className="text-red-500">*</span></label>
          <select
            id="currency"
            name="currency"
            value={formData.currency}
            onChange={handleChange}
            className={`block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none ${formErrors.currency ? 'border-red-500' : 'border-gray-300 focus:ring-indigo-500 focus:border-indigo-500'}`}
            required
          >
            <option value="USD">USD - United States Dollar</option>
            <option value="EUR">EUR - Euro</option>
            <option value="GBP">GBP - British Pound Sterling</option>
            <option value="JPY">JPY - Japanese Yen</option>
            <option value="CAD">CAD - Canadian Dollar</option>
            <option value="AUD">AUD - Australian Dollar</option>
            {/* Add more currencies as needed */}
          </select>
          {formErrors.currency && <p className="mt-1 text-sm text-red-600">{formErrors.currency}</p>}
        </div>

        {/* Managed By Selector */}
        <div>
          <label htmlFor="managedById" className="block text-sm font-medium text-gray-700 mb-1">Managed By (Account Manager)</label>
          <select
            id="managedById"
            name="managedById"
            value={formData.managedById}
            onChange={handleChange}
            className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
          >
            <option value="">-- Select a manager --</option>
            {availableManagers.length === 0 && !managersLoading && (
              <option disabled>No managers available</option>
            )}
            {managersLoading ? (
              <option disabled>Loading managers...</option>
            ) : (
              availableManagers.map(manager => (
                <option key={manager.id} value={manager.id}>{manager.name} ({manager.email})</option>
              ))
            )}
          </select>
        </div>

        {/* Associated Entities Multiselect */}
        <div>
          <label htmlFor="associatedEntityIds" className="block text-sm font-medium text-gray-700 mb-1">Associated Entities</label>
          <select
            multiple
            id="associatedEntityIds"
            name="associatedEntityIds"
            value={formData.associatedEntityIds}
            onChange={handleChange}
            className="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 h-32"
          >
            {availableEntities.length === 0 && !entitiesLoading && (
              <option disabled>No entities available</option>
            )}
            {entitiesLoading ? (
              <option disabled>Loading entities...</option>
            ) : (
              availableEntities.map(entity => (
                <option key={entity.id} value={entity.id}>{entity.name} ({entity.type})</option>
              ))
            )}
          </select>
          <p className="mt-1 text-xs text-gray-500">Hold Ctrl/Cmd to select multiple entities related to this group.</p>
        </div>

        <div className="flex justify-end space-x-2 mt-6">
          <button
            type="button"
            onClick={() => navigate('/account-groups')}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
            disabled={loading}
          >
            Cancel
          </button>
          <button
            type="submit"
            className="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition duration-200"
            disabled={loading}
          >
            {loading ? 'Saving...' : (isEditMode ? 'Update Account Group' : 'Create Account Group')}
          </button>
        </div>
      </form>
    </div>
  );
};


// --- Audit Records Section (Expanded) ---

const AUDIT_RECORDS_HOME_QUERY = gql`
  query AuditRecordsHome($first: Int, $after: String, $last: Int, $before: String, $actorId: ID, $actorType: String, $entityId: ID, $entityType: String, $eventName: String, $eventTime: DateTimeFilterInput, $fuzzyEventName: String, $includeAssociations: Boolean, $includeAdminActions: Boolean, $skipRelatedRecordsCheck: Boolean = false, $ipAddress: String, $minRiskScore: Int, $maxRiskScore: Int) { # Added IP and Risk Score filters
    auditRecords(
      first: $first
      after: $after
      last: $last
      before: $before
      actorId: $actorId
      actorType: $actorType
      entityId: $entityId
      entityType: $entityType
      eventName: $eventName
      eventTime: $eventTime
      fuzzyEventName: $fuzzyEventName
      includeAssociations: $includeAssociations
      includeAdminActions: $includeAdminActions
      ipAddress: $ipAddress # New filter
      minRiskScore: $minRiskScore # New filter
      maxRiskScore: $maxRiskScore # New filter
    ) {
      edges {
        node {
          id
          eventTime
          actorId # Added field
          actorName
          actorType # Added field
          entityId # Added field
          entityType # Added field
          eventName # Added field
          prettyEvent
          ipAddress
          geoLocation
          riskScore # Added field
          path
          __typename
        }
        __typename
      }
      pageInfo {
        startCursor
        endCursor
        hasNextPage
        hasPreviousPage
        __typename
      }
      __typename
    }
    # Potentially add queries for available actor types, entity types for filter dropdowns
  }
`;

interface AuditRecordNode {
  id: string;
  eventTime: string;
  actorId: string;
  actorName: string;
  actorType: string;
  entityId: string;
  entityType: string;
  eventName: string;
  prettyEvent: string;
  ipAddress: string | null;
  geoLocation: string | null;
  riskScore: number;
  path: string;
  __typename: string;
}

interface AuditRecordsHomeData {
  auditRecords: {
    edges: { node: AuditRecordNode; __typename: string }[];
    pageInfo: {
      startCursor: string | null;
      endCursor: string | null;
      hasNextPage: boolean;
      hasPreviousPage: boolean;
      __typename: string;
    };
    __typename: string;
  };
}

export const AuditRecordsList: React.FC = () => {
  const [filters, setFilters] = useState({
    actorName: '',
    eventName: '',
    entityType: '',
    startDate: '',
    endDate: '',
    ipAddress: '',
    minRiskScore: '',
    maxRiskScore: '',
  });

  const variables = useMemo(() => {
    const eventTime: { gte?: string; lte?: string } = {};
    if (filters.startDate) eventTime.gte = new Date(filters.startDate).toISOString();
    if (filters.endDate) eventTime.lte = new Date(filters.endDate).toISOString();

    return {
      first: 20,
      fuzzyEventName: filters.eventName || null,
      actorName: filters.actorName || null, // Assuming backend can filter by actorName
      entityType: filters.entityType || null,
      eventTime: Object.keys(eventTime).length > 0 ? eventTime : null,
      ipAddress: filters.ipAddress || null,
      minRiskScore: filters.minRiskScore ? parseInt(filters.minRiskScore, 10) : null,
      maxRiskScore: filters.maxRiskScore ? parseInt(filters.maxRiskScore, 10) : null,
      includeAssociations: true,
      includeAdminActions: authService.hasRole('Admin') || authService.hasRole('Auditor'), // Only admins/auditors see admin actions
    };
  }, [filters]);

  const { loading, error, data, fetchMore } = useQuery<AuditRecordsHomeData>(AUDIT_RECORDS_HOME_QUERY, {
    variables,
    notifyOnNetworkStatusChange: true,
  });

  const handleFilterChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setFilters(prev => ({ ...prev, [name]: value }));
  };

  const loadMore = useCallback(() => {
    if (data?.auditRecords.pageInfo.hasNextPage && !loading) {
      fetchMore({
        variables: { ...variables, after: data.auditRecords.pageInfo.endCursor },
        updateQuery: (prev, { fetchMoreResult }) => {
          if (!fetchMoreResult) return prev;
          return {
            auditRecords: {
              ...fetchMoreResult.auditRecords,
              edges: [
                ...prev.auditRecords.edges,
                ...fetchMoreResult.auditRecords.edges,
              ],
            },
          };
        },
      });
    }
  }, [data, fetchMore, loading, variables]);

  if (loading && !data) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;

  const entityTypes = ['APIKey', 'ACHSetting', 'AccountGroup', 'User', 'Account', 'Transaction', 'Loan', 'Payment']; // Example types

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">Audit Records</h2>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-4 mb-6 bg-gray-50 p-4 rounded-lg shadow-sm">
        <input
          type="text"
          name="actorName"
          placeholder="Filter by Actor Name"
          value={filters.actorName}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
        <input
          type="text"
          name="eventName"
          placeholder="Filter by Event Name"
          value={filters.eventName}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
        <select
          name="entityType"
          value={filters.entityType}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">All Entity Types</option>
          {entityTypes.map(type => <option key={type} value={type}>{type}</option>)}
        </select>
        <input
          type="date"
          name="startDate"
          placeholder="Start Date"
          value={filters.startDate}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
        <input
          type="date"
          name="endDate"
          placeholder="End Date"
          value={filters.endDate}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
        <input
          type="text"
          name="ipAddress"
          placeholder="Filter by IP Address"
          value={filters.ipAddress}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
        <input
          type="number"
          name="minRiskScore"
          placeholder="Min Risk Score"
          value={filters.minRiskScore}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
          min="0" max="100"
        />
        <input
          type="number"
          name="maxRiskScore"
          placeholder="Max Risk Score"
          value={filters.maxRiskScore}
          onChange={handleFilterChange}
          className="p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
          min="0" max="100"
        />
      </div>

      <div className="bg-white shadow-md rounded-lg overflow-hidden">
        <table className="min-w-full divide-y divide-gray-200">
          <thead className="bg-gray-50">
            <tr>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event Time</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actor ({authService.getCurrentUser()?.username})</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Entity</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">IP Address</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Geo Location</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Risk Score</th>
              <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody className="bg-white divide-y divide-gray-200">
            {data?.auditRecords.edges.length === 0 ? (
              <tr>
                <td colSpan={8} className="px-6 py-4 text-center text-gray-500">No audit records found matching criteria.</td>
              </tr>
            ) : (
              data?.auditRecords.edges.map(({ node }) => (
                <tr key={node.id} className={node.riskScore > 70 ? 'bg-red-50/50' : node.riskScore > 40 ? 'bg-yellow-50/50' : ''}>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{new Date(node.eventTime).toLocaleString()}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.prettyEvent}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.actorName} ({node.actorType})</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.entityType} ({node.entityId.substring(0, 8)}...)</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.ipAddress || 'N/A'}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{node.geoLocation || 'N/A'}</td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm">
                    <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${node.riskScore > 70 ? 'bg-red-100 text-red-800' : node.riskScore > 40 ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800'}`}>
                      {node.riskScore}
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <Link to={`/audit-records/${node.id}`} className="text-indigo-600 hover:text-indigo-900">View Details</Link>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
        {data?.auditRecords.pageInfo.hasNextPage && (
          <div className="p-4 text-center border-t border-gray-200">
            <button
              onClick={loadMore}
              className="px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition duration-200"
              disabled={loading}
            >
              {loading ? 'Loading...' : 'Load More'}
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

// --- Audit Record Details ---
const AUDIT_RECORD_DETAILS_QUERY = gql`
  query AuditRecordDetails($id: ID!) {
    auditRecord(id: $id) {
      id
      eventTime
      eventName
      prettyEvent
      actorId
      actorName
      actorType
      entityId
      entityType
      ipAddress
      geoLocation
      riskScore
      detailsJson # New field: raw JSON details of the event
      path
      __typename
    }
  }
`;

interface AuditRecordDetailsData {
  auditRecord: AuditRecordNode & {
    detailsJson: string; // JSON string
  };
}

export const AuditRecordDetails: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { loading, error, data } = useQuery<AuditRecordDetailsData>(AUDIT_RECORD_DETAILS_QUERY, {
    variables: { id },
  });
  const [showRawDetails, setShowRawDetails] = useState(false);

  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={error.message} />;
  if (!data?.auditRecord) return <p className="text-center p-4">Audit Record not found.</p>;

  const record = data.auditRecord;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold text-gray-800 mb-6">Audit Record Details: {record.eventName}</h2>
      <div className="bg-white shadow-md rounded-lg p-6 max-w-4xl mx-auto">
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <DetailItem label="Event ID" value={record.id} />
          <DetailItem label="Event Time" value={new Date(record.eventTime).toLocaleString()} />
          <DetailItem label="Event Name" value={record.eventName} />
          <DetailItem label="Pretty Event" value={record.prettyEvent} />
          <DetailItem label="Actor ID" value={record.actorId} />
          <DetailItem label="Actor Name" value={record.actorName} />
          <DetailItem label="Actor Type" value={record.actorType} />
          <DetailItem label="Entity ID" value={record.entityId} />
          <DetailItem label="Entity Type" value={record.entityType} />
          <DetailItem label="IP Address" value={record.ipAddress || 'N/A'} />
          <DetailItem label="Geo Location" value={record.geoLocation || 'N/A'} />
          <DetailItem label="Risk Score" value={
            <span className={`px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full ${record.riskScore > 70 ? 'bg-red-100 text-red-800' : record.riskScore > 40 ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800'}`}>
              {record.riskScore}
            </span>
          } />
        </div>

        <div className="mb-6 border-t pt-4">
          <h3 className="text-xl font-semibold text-gray-800 mb-2">Event Data</h3>
          <button
            onClick={() => setShowRawDetails(!showRawDetails)}
            className="text-blue-600 hover:underline text-sm mb-2"
          >
            {showRawDetails ? 'Hide Raw JSON' : 'Show Raw JSON Details'}
          </button>
          {showRawDetails && (
            <pre className="bg-gray-100 p-4 rounded-md text-sm font-mono whitespace-pre-wrap break-all">
              {JSON.stringify(JSON.parse(record.detailsJson || '{}'), null, 2)}
            </pre>
          )}
        </div>

        <div className="flex justify-end mt-6">
          <button
            onClick={() => window.history.back()}
            className="bg-gray-300 text-gray-800 px-4 py-2 rounded-md hover:bg-gray-400 transition duration-200"
          >
            Back to List
          </button>
        </div>
      </div>
    </div>
  );
};

