// --- 0. Core Type Definitions (Based on GraphQL Schema) ---

/**
 * Represents a single internal account within an AccountGroup.
 */
export interface InternalAccount {
  typename: 'InternalAccount';
  id: string;
  bestName: string;
  path: string; // e.g., 'Bank/Branch/AccountType/AccountID'
  accountNumber: string; // Added for realism
  balance: number; // Added for realism
  currency: string; // Added for realism
  status: 'Active' | 'Inactive' | 'Pending' | 'Closed'; // Added for realism
  openingDate: string; // ISO Date String
  lastActivityDate: string; // ISO Date String
  type: 'Checking' | 'Savings' | 'Loan' | 'Credit Card' | 'Investment'; // Added for realism
  description?: string;
}

/**
 * Represents an Account Group, a collection of internal accounts.
 */
export interface AccountGroup {
  typename: 'AccountGroup';
  id: string;
  name: string;
  currency: string; // Primary currency for the group
  description?: string;
  internalAccountsUnpaginated: InternalAccount[];
  internalAccountCount: number;
  path: string; // Unique path for the group, e.g., 'Customer/Portfolio/WealthManagement'
  createdAt: string; // ISO Date String
  updatedAt: string; // ISO Date String
  ownerId: string; // User/Entity ID owning the group
  status: 'Active' | 'Archived' | 'PendingApproval'; // Added for realism
  riskLevel: 'Low' | 'Medium' | 'High'; // Added for realism
  associatedProducts: string[]; // e.g., ['Wealth Management', 'Corporate Lending']
  tags: string[]; // e.g., ['corporate', 'high-net-worth']
  permissions: { // Added for granular access control
    canView: string[];
    canEdit: string[];
    canApprove: string[];
  };
}

/**
 * Pagination information for a connection.
 */
export interface PageInfo {
  startCursor: string | null;
  endCursor: string | null;
  hasNextPage: boolean;
  hasPreviousPage: boolean;
  typename: 'PageInfo';
}

/**
 * An edge in a connection, wrapping a node.
 */
export interface AccountGroupEdge {
  node: AccountGroup;
  typename: 'AccountGroupEdge';
  cursor: string; // Added for mock pagination
}

/**
 * The connection type for AccountGroup.
 */
export interface AccountGroupConnection {
  edges: AccountGroupEdge[];
  pageInfo: PageInfo;
  typename: 'AccountGroupConnection';
}

/**
 * The overall query response structure for AccountGroupsHome.
 */
export interface AccountGroupsHomeQueryResponse {
  accountGroups: AccountGroupConnection;
}

// --- 1. Utility Functions ---

/**
 * Generates a unique ID (simple UUID-like for demo).
 * @returns {string} A unique identifier.
 */
export const generateUniqueId = (): string => {
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
    const r = Math.random() * 16 | 0,
      v = c === 'x' ? r : (r & 0x3 | 0x8);
    return v.toString(16);
  });
};

/**
 * Formats a number as currency.
 * @param {number} amount - The amount to format.
 * @param {string} currency - The currency code (e.g., 'USD', 'EUR').
 * @param {string} locale - The locale (e.g., 'en-US').
 * @returns {string} The formatted currency string.
 */
export const formatCurrency = (amount: number, currency: string = 'USD', locale: string = 'en-US'): string => {
  return new Intl.NumberFormat(locale, { style: 'currency', currency }).format(amount);
};

/**
 * Formats a date string.
 * @param {string} dateString - The date string (e.g., ISO format).
 * @param {string} locale - The locale.
 * @param {Intl.DateTimeFormatOptions} options - Formatting options.
 * @returns {string} The formatted date string.
 */
export const formatDate = (dateString: string, locale: string = 'en-US', options?: Intl.DateTimeFormatOptions): string => {
  if (!dateString) return '';
  const date = new Date(dateString);
  const defaultOptions: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
  return new Intl.DateTimeFormat(locale, options || defaultOptions).format(date);
};

/**
 * Debounces a function call.
 * @param {T} func - The function to debounce.
 * @param {number} delay - The delay in milliseconds.
 * @returns {T} The debounced function.
 */
export const debounce = <T extends (...args: any[]) => void>(func: T, delay: number): T => {
  let timeout: NodeJS.Timeout | null;
  return ((...args: any[]) => {
    const later = () => {
      timeout = null;
      func(...args);
    };
    clearTimeout(timeout!);
    timeout = setTimeout(later, delay);
  }) as T;
};

