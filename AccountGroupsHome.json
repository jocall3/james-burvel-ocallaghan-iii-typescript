export const LoginPage: React.FC = () => {
  const [username, setUsername] = useState('');
  const [password, setPassword] = useState('');
  const [loginError, setLoginError] = useState('');
  const { login, isAuthenticated } = useAuth();
  const navigate = useNavigate();

  useEffect(() => {
    if (isAuthenticated) {
      navigate('/');
    }
  }, [isAuthenticated, navigate]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoginError('');
    const success = await login(username, password);
    if (!success) {
      setLoginError('Invalid username or password.');
    }
  };

  return (
    <div style={{
      display: 'flex',
      justifyContent: 'center',
      alignItems: 'center',
      minHeight: '100vh',
      backgroundColor: '#f0f2f5',
      fontFamily: 'Arial, sans-serif'
    }}>
      <Card title="Citibank Corporate Login" style={{ width: '400px', padding: '40px', textAlign: 'center' }}>
        <form onSubmit={handleSubmit}>
          {loginError && <Alert type="error" message={loginError} />}
          <Input
            label="Username"
            type="text"
            value={username}
            onChange={(e) => setUsername(e.target.value)}
            required
            id="username"
            placeholder="e.g., admin, manager, viewer"
          />
          <Input
            label="Password"
            type="password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            required
            id="password"
            placeholder="password"
          />
          <Button type="submit" onClick={() => {}} style={{ width: '100%', marginTop: '20px' }}>
            Login
          </Button>
        </form>
        <p style={{ marginTop: '20px', fontSize: '12px', color: '#777' }}>
          Demo Credentials:<br/>
          Admin: admin / password<br/>
          Manager: manager / password<br/>
          Viewer: viewer / password
        </p>
      </Card>
    </div>
  );
};

export const DashboardHomePage: React.FC = () => {
  const { accountGroups, loading, error, fetchAccountGroups } = useAccountGroups();
  const { user, isAuthenticated } = useAuth();
  const navigate = useNavigate();

  const totalAccountGroups = accountGroups?.edges.length || 0;
  const totalInternalAccounts = accountGroups?.edges.reduce((sum, group) => sum + group.internalAccountCount, 0) || 0;

  const totalBalanceByCurrency: { [key: string]: number } = useMemo(() => {
    const balances: { [key: string]: number } = {};
    accountGroups?.edges.forEach(group => {
      group.internalAccountsUnpaginated.forEach(account => {
        const currency = account.currency || 'USD'; // Default to USD if not specified
        balances[currency] = (balances[currency] || 0) + account.balance;
      });
    });
    return balances;
  }, [accountGroups]);

  const accountGroupStatusCounts = useMemo(() => {
    const counts: { [key: string]: number } = { Active: 0, Archived: 0, PendingApproval: 0 };
    accountGroups?.edges.forEach(group => {
      counts[group.status] = (counts[group.status] || 0) + 1;
    });
    return counts;
  }, [accountGroups]);

  if (!isAuthenticated) {
    return (
      <Container>
        <Alert type="info" message="Please log in to view the dashboard." />
      </Container>
    );
  }

  if (loading) return <LoadingSpinner />;
  if (error) return <Alert type="error" message={`Error loading dashboard data: ${error}`} />;
  

  return (
    <Container>
      <h1 style={{ color: '#003366', marginBottom: '30px' }}>Dashboard Overview</h1>

      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(280px, 1fr))', gap: '20px', marginBottom: '30px' }}>
        <Card title="Total Account Groups">
          <p style={{ fontSize: '36px', fontWeight: 'bold', color: '#007bff' }}>{totalAccountGroups}</p>
        </Card>
        <Card title="Total Internal Accounts">
          <p style={{ fontSize: '36px', fontWeight: 'bold', color: '#28a745' }}>{totalInternalAccounts}</p>
        </Card>
        <Card title="Accounts Pending Approval">
          <p style={{ fontSize: '36px', fontWeight: 'bold', color: '#ffc107' }}>{accountGroupStatusCounts['PendingApproval'] || 0}</p>
        </Card>
        <Card title="Total Value by Currency">
          {Object.entries(totalBalanceByCurrency).length > 0 ? (
            <ul style={{ listStyle: 'none', padding: 0 }}>
              {Object.entries(totalBalanceByCurrency).map(([currency, balance]) => (
                <li key={currency} style={{ marginBottom: '5px', fontSize: '18px', display: 'flex', justifyContent: 'space-between' }}>
                  <span>{currency}:</span>
                  <span style={{ fontWeight: 'bold' }}>{formatCurrency(balance, currency)}</span>
                </li>
              ))}
            </ul>
          ) : <p style={{ color: '#777' }}>No financial data available.</p>}
        </Card>
      </div>

      <Card title="Quick Actions">
        <div style={{ display: 'flex', gap: '15px' }}>
          {user?.permissions.includes('can_create_group') && (
            <Button onClick={() => navigate('/account-groups/new')} variant="primary">
              Create New Account Group
            </Button>
          )}
          <Button onClick={() => navigate('/account-groups?filter=PendingApproval')} variant="secondary">
            View Pending Approvals
          </Button>
          {user?.permissions.includes('can_manage_users') && (
            <Button onClick={() => navigate('/user-management')} variant="secondary">
              Manage Users
            </Button>
          )}
        </div>
      </Card>

      <Card title="Recent Activity Feed (Simulated)" style={{ marginTop: '30px' }}>
        <ul style={{ listStyle: 'none', padding: 0 }}>
          <li style={{ marginBottom: '10px', borderBottom: '1px dotted #eee', paddingBottom: '10px' }}>
            <span style={{ fontWeight: 'bold', color: '#007bff' }}>[2023-10-26 15:30]</span> Account Group "Wealth Management Portfolio Alpha" updated.
          </li>
          <li style={{ marginBottom: '10px', borderBottom: '1px dotted #eee', paddingBottom: '10px' }}>
            <span style={{ fontWeight: 'bold', color: '#28a745' }}>[2023-10-26 10:15]</span> Internal Account "Payment Clearing Account" balance update.
          </li>
          <li style={{ marginBottom: '10px', borderBottom: '1px dotted #eee', paddingBottom: '10px' }}>
            <span style={{ fontWeight: 'bold', color: '#ffc107' }}>[2023-10-25 09:00]</span> New Account Group "Global Trade Finance" created, pending approval.
          </li>
          <li style={{ marginBottom: '10px', paddingBottom: '10px' }}>
            <span style={{ fontWeight: 'bold', color: '#dc3545' }}>[2023-10-24 11:45]</span> Critical alert: High-risk transaction detected in 'Corporate Lending Solutions Group'.
          </li>
        </ul>
      </Card>
    </Container>
  );
};

export const AccountGroupForm: React.FC<{
  initialData?: AccountGroup | null;
  onSave: (data: Omit<AccountGroup, 'id' | 'typename' | 'createdAt' | 'updatedAt' | 'internalAccountsUnpaginated' | 'internalAccountCount'>) => Promise<any>;
  onCancel: () => void;
  isLoading: boolean;
}> = ({ initialData, onSave, onCancel, isLoading }) => {
  const [formData, setFormData] = useState<Omit<AccountGroup, 'id' | 'typename' | 'createdAt' | 'updatedAt' | 'internalAccountsUnpaginated' | 'internalAccountCount'>>(
    initialData ?
      {
        name: initialData.name,
        currency: initialData.currency,
        description: initialData.description,
        path: initialData.path,
        ownerId: initialData.ownerId,
        status: initialData.status,
        riskLevel: initialData.riskLevel,
        associatedProducts: initialData.associatedProducts,
        tags: initialData.tags,
        permissions: initialData.permissions,
      } : {
        name: '',
        currency: 'USD',
        description: '',
        path: '',
        ownerId: '', // Should be filled by context or selected
        status: 'Active',
        riskLevel: 'Low',
        associatedProducts: [],
        tags: [],
        permissions: { canView: [], canEdit: [], canApprove: [] }
      }
  );
  const [errors, setErrors] = useState<Record<string, string>>({});
  const { user } = useAuth(); // To pre-fill ownerId for new groups or validate
  const { addNotification } = useNotifications();


  useEffect(() => {
    if (!initialData && user && !formData.ownerId) {
      setFormData(prev => ({ ...prev, ownerId: user.id }));
    }
  }, [initialData, user, formData.ownerId]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
    setErrors(prev => ({ ...prev, [name]: '' })); // Clear error on change
  };

  const handlePermissionsChange = (type: 'canView' | 'canEdit' | 'canApprove', value: string) => {
    setFormData(prev => ({
      ...prev,
      permissions: {
        ...prev.permissions,
        [type]: value.split(',').map(item => item.trim()).filter(item => item !== '')
      }
    }));
  };

  const handleArrayChange = (name: 'associatedProducts' | 'tags', value: string) => {
    setFormData(prev => ({
      ...prev,
      [name]: value.split(',').map(item => item.trim()).filter(item => item !== '')
    }));
  };


  const validate = (): boolean => {
    const newErrors: Record<string, string> = {};
    if (!formData.name.trim()) newErrors.name = 'Group Name is required.';
    if (!formData.currency.trim()) newErrors.currency = 'Currency is required.';
    if (!formData.path.trim()) newErrors.path = 'Path is required.';
    if (!formData.ownerId.trim()) newErrors.ownerId = 'Owner is required.';
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (validate()) {
      await onSave(formData);
    } else {
      addNotification('Please correct the form errors.', 'error');
    }
  };

  return (
    <Card title={initialData ? `Edit Account Group: ${initialData.name}` : 'Create New Account Group'} style={{ maxWidth: '800px', margin: '20px auto' }}>
      <form onSubmit={handleSubmit}>
        <Input
          label="Group Name"
          id="name"
          name="name"
          value={formData.name}
          onChange={handleChange}
          error={errors.name}
          required
        />
        <Select
          label="Primary Currency"
          id="currency"
          name="currency"
          value={formData.currency}
          onChange={handleChange}
          error={errors.currency}
          options={[{ value: 'USD', label: 'USD - United States Dollar' }, { value: 'EUR', label: 'EUR - Euro' }, { value: 'GBP', label: 'GBP - British Pound' }, { value: 'JPY', label: 'JPY - Japanese Yen' }]}
          required
        />
        <Textarea
          label="Description"
          id="description"
          name="description"
          value={formData.description || ''}
          onChange={handleChange}
        />
        <Input
          label="Path"
          id="path"
          name="path"
          value={formData.path}
          onChange={handleChange}
          error={errors.path}
          required
        />
        <Input
          label="Owner ID"
          id="ownerId"
          name="ownerId"
          value={formData.ownerId}
          onChange={handleChange}
          error={errors.ownerId}
          disabled={!!initialData && user?.role !== 'admin'} // Only admin can change owner of existing group
          placeholder="e.g., user-burvel, admin-fin"
          required
        />
        <Select
          label="Status"
          id="status"
          name="status"
          value={formData.status}
          onChange={handleChange}
          options={[{ value: 'Active', label: 'Active' }, { value: 'Archived', label: 'Archived' }, { value: 'PendingApproval', label: 'Pending Approval' }]}
        />
        <Select
          label="Risk Level"
          id="riskLevel"
          name="riskLevel"
          value={formData.riskLevel}
          onChange={handleChange}
          options={[{ value: 'Low', label: 'Low' }, { value: 'Medium', label: 'Medium' }, { value: 'High', label: 'High' }]}
        />
        <Input
          label="Associated Products (comma-separated)"
          id="associatedProducts"
          name="associatedProducts"
          value={formData.associatedProducts.join(', ')}
          onChange={(e) => handleArrayChange('associatedProducts', e.target.value)}
          placeholder="e.g., Wealth Management, Corporate Lending"
        />
        <Input
          label="Tags (comma-separated)"
          id="tags"
          name="tags"
          value={formData.tags.join(', ')}
          onChange={(e) => handleArrayChange('tags', e.target.value)}
          placeholder="e.g., HNW, investment, corporate"
        />

        <div style={{ marginBottom: '20px' }}>
          <label style={{ display: 'block', marginBottom: '10px', fontWeight: 'bold', color: '#555' }}>Permissions (User IDs who can access)</label>
          <Input
            label="Can View (comma-separated IDs)"
            value={formData.permissions.canView.join(', ')}
            onChange={(e) => handlePermissionsChange('canView', e.target.value)}
            placeholder="user-a, user-b, admin-x"
          />
          <Input
            label="Can Edit (comma-separated IDs)"
            value={formData.permissions.canEdit.join(', ')}
            onChange={(e) => handlePermissionsChange('canEdit', e.target.value)}
            placeholder="user-a, admin-x"
          />
          <Input
            label="Can Approve (comma-separated IDs)"
            value={formData.permissions.canApprove.join(', ')}
            onChange={(e) => handlePermissionsChange('canApprove', e.target.value)}
            placeholder="admin-risk, admin-legal"
          />
        </div>


        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '10px', marginTop: '20px' }}>
          <Button type="button" onClick={onCancel} variant="secondary" disabled={isLoading}>
            Cancel
          </Button>
          <Button type="submit" onClick={() => {}} variant="primary" disabled={isLoading}>
            {isLoading ? 'Saving...' : 'Save Account Group'}
          </Button>
        </div>
      </form>
    </Card>
  );
};


export const AccountGroupsOverviewPage: React.FC = () => {
  const { accountGroups, loading, error, fetchAccountGroups, deleteAccountGroup } = useAccountGroups();
  const { addNotification } = useNotifications();
  const { user, hasPermission, isAuthenticated } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();

  const [filterText, setFilterText] = useState('');
  const [sortBy, setSortBy] = useState('updatedAt');
  const [sortOrder, setSortOrder] = useState<'asc' | 'desc'>('desc');
  const [currentPageInfo, setCurrentPageInfo] = useState<PageInfo | null>(null);

  const [isEditModalOpen, setIsEditModalOpen] = useState(false);
  const [selectedGroupForEdit, setSelectedGroupForEdit] = useState<AccountGroup | null>(null);
  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);

  const [itemsPerPage, setItemsPerPage] = useState(10); // Number of items per page

  // Parse query params for initial state
  useEffect(() => {
    const params = new URLSearchParams(location.search);
    const initialFilter = params.get('filter') || '';
    const initialSortBy = params.get('sortBy') || 'updatedAt';
    const initialSortOrder = (params.get('sortOrder') as 'asc' | 'desc') || 'desc';
    const initialFirst = parseInt(params.get('first') || '10');

    setFilterText(initialFilter);
    setSortBy(initialSortBy);
    setSortOrder(initialSortOrder);
    setItemsPerPage(initialFirst);
  }, [location.search]);

  // Debounced fetch for filtering/sorting
  const debouncedFetch = useMemo(() => debounce((filter: string, sort: string, order: 'asc' | 'desc', first: number, after?: string) => {
    fetchAccountGroups({ first, after, filter, sortBy: sort, sortOrder: order });
  }, 500), [fetchAccountGroups]);

  useEffect(() => {
    if (user) {
      // Pass pagination and filter/sort to fetch
      debouncedFetch(filterText, sortBy, sortOrder, itemsPerPage, currentPageInfo?.endCursor || undefined);
    }
  }, [user, filterText, sortBy, sortOrder, itemsPerPage, debouncedFetch, currentPageInfo?.endCursor]);


  useEffect(() => {
    if (accountGroups) {
      setCurrentPageInfo(accountGroups.pageInfo);
    }
  }, [accountGroups]);

  const handleFilterChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    setFilterText(e.target.value);
    // Reset pagination when filter changes
    setCurrentPageInfo(null);
  };

  const handleSortChange = (newSortBy: string) => {
    if (sortBy === newSortBy) {
      setSortOrder(prev => (prev === 'asc' ? 'desc' : 'asc'));
    } else {
      setSortBy(newSortBy);
      setSortOrder('asc');
    }
    setCurrentPageInfo(null); // Reset pagination on sort change
  };

  const handleNextPage = () => {
    if (currentPageInfo?.hasNextPage) {
      fetchAccountGroups({ first: itemsPerPage, after: currentPageInfo.endCursor, filter: filterText, sortBy, sortOrder });
    }
  };

  const handlePreviousPage = () => {
    if (currentPageInfo?.hasPreviousPage) {
      fetchAccountGroups({ last: itemsPerPage, before: currentPageInfo.startCursor, filter: filterText, sortBy, sortOrder });
    }
  };

  const handleItemsPerPageChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    setItemsPerPage(parseInt(e.target.value));
    setCurrentPageInfo(null); // Reset pagination
  };

  const openEditModal = (group: AccountGroup) => {
    setSelectedGroupForEdit(group);
    setIsEditModalOpen(true);
  };

  const closeEditModal = () => {
    setIsEditModalOpen(false);
    setSelectedGroupForEdit(null);
  };

  const handleUpdateAccountGroup = async (formData: Omit<AccountGroup, 'id' | 'typename' | 'createdAt' | 'updatedAt' | 'internalAccountsUnpaginated' | 'internalAccountCount'>) => {
    if (!selectedGroupForEdit) return;
    const result = await updateAccountGroup(selectedGroupForEdit.id, formData);
    if (result) {
      closeEditModal();
    }
  };

  const handleCreateNewAccountGroup = async (formData: Omit<AccountGroup, 'id' | 'typename' | 'createdAt' | 'updatedAt' | 'internalAccountsUnpaginated' | 'internalAccountCount'>) => {
    const result = await createAccountGroup(formData);
    if (result) {
      setIsCreateModalOpen(false);
    }
  };

  const confirmDeleteGroup = async (groupId: string, groupName: string) => {
    if (window.confirm(`Are you sure you want to delete the account group "${groupName}"? This action cannot be undone.`)) {
      const success = await deleteAccountGroup(groupId);
      if (success) {
        // Notification handled by context
      } else {
        addNotification(`Failed to delete account group "${groupName}".`, 'error');
      }
    }
  };


  if (!isAuthenticated) {
    return (
      <Container>
        <Alert type="info" message="You must be logged in to view account groups." />
      </Container>
    );
  }

  return (
    <Container>
      <h1 style={{ color: '#003366', marginBottom: '30px' }}>Account Groups Management</h1>

      <Card>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '20px' }}>
          <Input
            type="text"
            placeholder="Search by name, description, tags..."
            value={filterText}
            onChange={handleFilterChange}
            style={{ flex: 1, marginRight: '15px' }}
          />
          <Select
            label="Items per page:"
            options={[{value: '5', label: '5'}, {value: '10', label: '10'}, {value: '25', label: '25'}, {value: '50', label: '50'}]}
            value={itemsPerPage.toString()}
            onChange={handleItemsPerPageChange}
            style={{width: '150px'}}
          />
          {hasPermission('can_create_group') && (
            <Button onClick={() => setIsCreateModalOpen(true)} variant="success" style={{ marginLeft: '15px' }}>
              Create New Group
            </Button>
          )}
        </div>

        {loading && <LoadingSpinner />}
        {!loading && error && <Alert type="error" message={`Error loading account groups: ${error}`} />}
        {!loading && !error && accountGroups?.edges.length === 0 && (
          <Alert type="info" message="No account groups found matching your criteria."></Alert>
        )}

        {accountGroups && accountGroups.edges.length > 0 && (
          <>
            <Table headers={[
              <span key="name-header" onClick={() => handleSortChange('name')} style={{ cursor: 'pointer' }}>Group Name {sortBy === 'name' && (sortOrder === 'asc' ? '⬆️' : '⬇️')}</span>,
              'Currency',
              'Internal Accounts',
              <span key="status-header" onClick={() => handleSortChange('status')} style={{ cursor: 'pointer' }}>Status {sortBy === 'status' && (sortOrder === 'asc' ? '⬆️' : '⬇️')}</span>,
              <span key="risk-header" onClick={() => handleSortChange('riskLevel')} style={{ cursor: 'pointer' }}>Risk Level {sortBy === 'riskLevel' && (sortOrder === 'asc' ? '⬆️' : '⬇️')}</span>,
              <span key="updatedAt-header" onClick={() => handleSortChange('updatedAt')} style={{ cursor: 'pointer' }}>Last Updated {sortBy === 'updatedAt' && (sortOrder === 'asc' ? '⬆️' : '⬇️')}</span>,
              'Actions'
            ]}>
              {accountGroups.edges.map((edge, index) => (
                <TableRow key={edge.node.id} isStriped={index % 2 === 0}>
                  <TableCell>
                    <Link to={`/account-groups/${edge.node.id}`} style={{ textDecoration: 'none', color: '#007bff', fontWeight: 'bold' }}>
                      {edge.node.name}
                    </Link>
                  </TableCell>
                  <TableCell>{edge.node.currency}</TableCell>
                  <TableCell>{edge.node.internalAccountCount}</TableCell>
                  <TableCell>
                    <span style={{
                      padding: '4px 8px',
                      borderRadius: '4px',
                      fontWeight: 'bold',
                      fontSize: '12px',
                      backgroundColor: edge.node.status === 'Active' ? '#d4edda' :
                        edge.node.status === 'PendingApproval' ? '#fff3cd' : '#f8d7da',
                      color: edge.node.status === 'Active' ? '#155724' :
                        edge.node.status === 'PendingApproval' ? '#856404' : '#721c24'
                    }}>
                      {edge.node.status}
                    </span>
                  </TableCell>
                  <TableCell>
                    <span style={{
                      padding: '4px 8px',
                      borderRadius: '4px',
                      fontWeight: 'bold',
                      fontSize: '12px',
                      backgroundColor: edge.node.riskLevel === 'Low' ? '#d4edda' :
                        edge.node.riskLevel === 'Medium' ? '#fff3cd' : '#f8d7da',
                      color: edge.node.riskLevel === 'Low' ? '#155724' :
                        edge.node.riskLevel === 'Medium' ? '#856404' : '#721c24'
                    }}>
                      {edge.node.riskLevel}
                    </span>
                  </TableCell>
                  <TableCell>{formatDate(edge.node.updatedAt, 'en-US', { dateStyle: 'medium', timeStyle: 'short' })}</TableCell>
                  <TableCell>
                    <div style={{ display: 'flex', gap: '5px' }}>
                      {hasPermission('can_edit_group', edge.node.id) && (
                        <Button onClick={() => openEditModal(edge.node)} variant="secondary" style={{ padding: '5px 10px', fontSize: '12px' }}>Edit</Button>
                      )}
                      {hasPermission('can_delete_group', edge.node.id) && (
                        <Button onClick={() => confirmDeleteGroup(edge.node.id, edge.node.name)} variant="danger" style={{ padding: '5px 10px', fontSize: '12px' }}>Delete</Button>
                      )}
                    </div>
                  </TableCell>
                </TableRow>
              ))}
            </Table>
            {currentPageInfo && (
              <PaginationControls
                pageInfo={currentPageInfo}
                onNext={handleNextPage}
                onPrevious={handlePreviousPage}
              />
            )}
          </>
        )}
      </Card>

      <Modal isOpen={isEditModalOpen} onClose={closeEditModal} title={`Edit ${selectedGroupForEdit?.name || 'Account Group'}`} size="large">
        {selectedGroupForEdit && (
          <AccountGroupForm
            initialData={selectedGroupForEdit}
            onSave={handleUpdateAccountGroup}
            onCancel={closeEditModal}
            isLoading={loading}
          />
        )}
      </Modal>

      <Modal isOpen={isCreateModalOpen} onClose={() => setIsCreateModalOpen(false)} title="Create New Account Group" size="large">
        <AccountGroupForm
          onSave={handleCreateNewAccountGroup}
          onCancel={() => setIsCreateModalOpen(false)}
          isLoading={loading}
        />
      </Modal>

    </Container>
  );
};


export const AccountGroupDetailPage: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { accountGroups, loading, error, updateAccountGroup, addInternalAccount, updateInternalAccount, deleteInternalAccount } = useAccountGroups();
  const { addNotification } = useNotifications();
  const { user, hasPermission, isAuthenticated } = useAuth();

  const group = useMemo(() => accountGroups?.edges.find(e => e.node.id === id)?.node, [accountGroups, id]);

  const [isAddingInternalAccount, setIsAddingInternalAccount] = useState(false);
  const [isEditingInternalAccount, setIsEditingInternalAccount] = useState(false);
  const [internalAccountToEdit, setInternalAccountToEdit] = useState<InternalAccount | null>(null);

  const canEditGroup = id ? hasPermission('can_edit_group', id) : false;

  const handleAddInternalAccount = async (newAccountData: Omit<InternalAccount, 'id' | 'typename'>) => {
    if (!id) return;
    const result = await addInternalAccount(id, newAccountData);
    if (result) {
      setIsAddingInternalAccount(false);
    }
  };

  const handleUpdateInternalAccount = async (updates: Partial<InternalAccount>) => {
    if (!id || !internalAccountToEdit) return;
    const result = await updateInternalAccount(id, internalAccountToEdit.id, updates);
    if (result) {
      setIsEditingInternalAccount(false);
      setInternalAccountToEdit(null);
    }
  };

  const handleDeleteInternalAccount = async (internalAccountId: string, internalAccountName: string) => {
    if (!id) return;
    if (window.confirm(`Are you sure you want to delete internal account "${internalAccountName}"?`)) {
      const success = await deleteInternalAccount(id, internalAccountId);
      if (success) {
        addNotification(`Internal account "${internalAccountName}" deleted successfully.`, 'success');
      } else {
        addNotification(`Failed to delete internal account "${internalAccountName}".`, 'error');
      }
    }
  };

  if (!isAuthenticated) {
    return (
      <Container>
        <Alert type="info" message="You must be logged in to view account groups." />
      </Container>
    );
  }

  if (loading) return <LoadingSpinner />;
  if (error) return <Alert type="error" message={`Error: ${error}`} />;
  if (!group) return <Alert type="warning" message="Account Group not found or you do not have permission to view it." />;
  if (!user || !hasPermission('can_view_group', group.id)) {
    return (
      <Container>
        <Alert type="error" message="Permission denied: You do not have access to view this account group." />
      </Container>
    );
  }

  const totalGroupBalance = group.internalAccountsUnpaginated.reduce((sum, acc) => sum + acc.balance, 0);

  return (
    <Container>
      <h1 style={{ color: '#003366', marginBottom: '15px' }}>Account Group: {group.name}</h1>
      <p style={{ color: '#666', marginBottom: '30px' }}>ID: {group.id} | Path: {group.path}</p>

      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(300px, 1fr))', gap: '20px', marginBottom: '30px' }}>
        <Card title="Summary">
          <p><strong>Description:</strong> {group.description || 'N/A'}</p>
          <p><strong>Primary Currency:</strong> {group.currency}</p>
          <p><strong>Total Internal Accounts:</strong> {group.internalAccountCount}</p>
          <p><strong>Combined Balance:</strong> <span style={{ fontWeight: 'bold', color: '#007bff' }}>{formatCurrency(totalGroupBalance, group.currency)}</span></p>
          <p><strong>Status:</strong> <span style={{ fontWeight: 'bold', color: group.status === 'Active' ? 'green' : group.status === 'PendingApproval' ? 'orange' : 'red' }}>{group.status}</span></p>
          <p><strong>Risk Level:</strong> <span style={{ fontWeight: 'bold', color: group.riskLevel === 'High' ? 'red' : group.riskLevel === 'Medium' ? 'orange' : 'green' }}>{group.riskLevel}</span></p>
          <p><strong>Owner:</strong> {group.ownerId}</p>
        </Card>

        <Card title="Metadata">
          <p><strong>Created At:</strong> {formatDate(group.createdAt, 'en-US', { dateStyle: 'full', timeStyle: 'short' })}</p>
          <p><strong>Last Updated:</strong> {formatDate(group.updatedAt, 'en-US', { dateStyle: 'full', timeStyle: 'short' })}</p>
          <p><strong>Associated Products:</strong> {group.associatedProducts.join(', ') || 'None'}</p>
          <p><strong>Tags:</strong> {group.tags.join(', ') || 'None'}</p>
        </Card>
      </div>

      <Card title="Internal Accounts">
        {canEditGroup && (
          <Button onClick={() => setIsAddingInternalAccount(true)} variant="success" style={{ marginBottom: '20px' }>
            Add New Internal Account
          </Button>
        )}
        {group.internalAccountsUnpaginated.length === 0 ? (
          <Alert type="info" message="No internal accounts in this group." />
        ) : (
          <Table headers={['Account Name', 'Type', 'Account Number', 'Currency', 'Balance', 'Status', 'Last Activity', 'Actions']}>
            {group.internalAccountsUnpaginated.map((account, index) => (
              <TableRow key={account.id} isStriped={index % 2 === 0}>
                <TableCell>{account.bestName}</TableCell>
                <TableCell>{account.type}</TableCell>
                <TableCell>{account.accountNumber}</TableCell>
                <TableCell>{account.currency}</TableCell>
                <TableCell>{formatCurrency(account.balance, account.currency)}</TableCell>
                <TableCell>{account.status}</TableCell>
                <TableCell>{formatDate(account.lastActivityDate, 'en-US', { dateStyle: 'medium' })}</TableCell>
                <TableCell>
                  {canEditGroup && (
                    <div style={{ display: 'flex', gap: '5px' }}>
                      <Button onClick={() => { setInternalAccountToEdit(account); setIsEditingInternalAccount(true); }} variant="secondary" style={{ padding: '5px 10px', fontSize: '12px' }}>Edit</Button>
                      <Button onClick={() => handleDeleteInternalAccount(account.id, account.bestName)} variant="danger" style={{ padding: '5px 10px', fontSize: '12px' }}>Delete</Button>
                    </div>
                  )}
                </TableCell>
              </TableRow>
            ))}
          </Table>
        )}
      </Card>

      <Modal isOpen={isAddingInternalAccount} onClose={() => setIsAddingInternalAccount(false)} title="Add New Internal Account">
        <InternalAccountForm onSave={handleAddInternalAccount} onCancel={() => setIsAddingInternalAccount(false)} isLoading={loading} />
      </Modal>

      <Modal isOpen={isEditingInternalAccount} onClose={() => { setIsEditingInternalAccount(false); setInternalAccountToEdit(null); }} title={`Edit Internal Account: ${internalAccountToEdit?.bestName || ''}`}>
        {internalAccountToEdit && (
          <InternalAccountForm initialData={internalAccountToEdit} onSave={handleUpdateInternalAccount} onCancel={() => { setIsEditingInternalAccount(false); setInternalAccountToEdit(null); }} isLoading={loading} />
        )}
      </Modal>
    </Container>
  );
};

export const InternalAccountForm: React.FC<{
  initialData?: InternalAccount | null;
  onSave: (data: Omit<InternalAccount, 'id' | 'typename'> | Partial<InternalAccount>) => Promise<any>;
  onCancel: () => void;
  isLoading: boolean;
}> = ({ initialData, onSave, onCancel, isLoading }) => {
  const [formData, setFormData] = useState<Omit<InternalAccount, 'id' | 'typename'> | Partial<InternalAccount>>(
    initialData ?
      {
        bestName: initialData.bestName,
        path: initialData.path,
        accountNumber: initialData.accountNumber,
        balance: initialData.balance,
        currency: initialData.currency,
        status: initialData.status,
        openingDate: initialData.openingDate.split('T')[0], // YYYY-MM-DD for date input
        lastActivityDate: initialData.lastActivityDate.split('T')[0],
        type: initialData.type,
        description: initialData.description
      } : {
        bestName: '',
        path: '',
        accountNumber: '',
        balance: 0,
        currency: 'USD',
        status: 'Active',
        openingDate: new Date().toISOString().split('T')[0],
        lastActivityDate: new Date().toISOString().split('T')[0],
        type: 'Checking',
        description: ''
      }
  );
  const [errors, setErrors] = useState<Record<string, string>>({});
  const { addNotification } = useNotifications();


  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
    setErrors(prev => ({ ...prev, [name]: '' }));
  };

  const validate = (): boolean => {
    const newErrors: Record<string, string> = {};
    if (!formData.bestName?.trim()) newErrors.bestName = 'Account Name is required.';
    if (!formData.accountNumber?.trim()) newErrors.accountNumber = 'Account Number is required.';
    if (!formData.path?.trim()) newErrors.path = 'Path is required.';
    if (formData.balance === undefined || isNaN(Number(formData.balance))) newErrors.balance = 'Balance must be a number.';
    if (!formData.currency?.trim()) newErrors.currency = 'Currency is required.';
    if (!formData.type?.trim()) newErrors.type = 'Account Type is required.';
    if (!formData.openingDate?.trim()) newErrors.openingDate = 'Opening Date is required.';
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (validate()) {
      // Reformat dates to ISO string before saving
      const dataToSave = {
        ...formData,
        balance: Number(formData.balance),
        openingDate: formData.openingDate ? new Date(formData.openingDate).toISOString() : new Date().toISOString(),
        lastActivityDate: formData.lastActivityDate ? new Date(formData.lastActivityDate).toISOString() : new Date().toISOString(),
      };
      await onSave(dataToSave);
    } else {
      addNotification('Please correct the form errors.', 'error');
    }
  };

  const accountTypes = [
    { value: 'Checking', label: 'Checking Account' },
    { value: 'Savings', label: 'Savings Account' },
    { value: 'Loan', label: 'Loan Account' },
    { value: 'Credit Card', label: 'Credit Card Account' },
    { value: 'Investment', label: 'Investment Account' }
  ];

  const statuses = [
    { value: 'Active', label: 'Active' },
    { value: 'Inactive', label: 'Inactive' },
    { value: 'Pending', label: 'Pending' },
    { value: 'Closed', label: 'Closed' }
  ];

  const currencies = [
    { value: 'USD', label: 'USD - United States Dollar' },
    { value: 'EUR', label: 'EUR - Euro' },
    { value: 'GBP', label: 'GBP - British Pound' },
    { value: 'JPY', label: 'JPY - Japanese Yen' },
  ];

  return (
    <form onSubmit={handleSubmit}>
      <Input
        label="Account Best Name"
        id="bestName"
        name="bestName"
        value={formData.bestName || ''}
        onChange={handleChange}
        error={errors.bestName}
        required
      />
      <Input
        label="Account Number"
        id="accountNumber"
        name="accountNumber"
        value={formData.accountNumber || ''}
        onChange={handleChange}
        error={errors.accountNumber}
        required
      />
      <Input
        label="Path"
        id="path"
        name="path"
        value={formData.path || ''}
        onChange={handleChange}
        error={errors.path}
        required
      />
      <Input
        label="Balance"
        id="balance"
        name="balance"
        type="number"
        step="0.01"
        value={formData.balance?.toString() || '0'}
        onChange={handleChange}
        error={errors.balance}
        required
      />
      <Select
        label="Currency"
        id="currency"
        name="currency"
        value={formData.currency || 'USD'}
        onChange={handleChange}
        error={errors.currency}
        options={currencies}
        required
      />
      <Select
        label="Account Type"
        id="type"
        name="type"
        value={formData.type || 'Checking'}
        onChange={handleChange}
        error={errors.type}
        options={accountTypes}
        required
      />
      <Select
        label="Status"
        id="status"
        name="status"
        value={formData.status || 'Active'}
        onChange={handleChange}
        options={statuses}
      />
      <Input
        label="Opening Date"
        id="openingDate"
        name="openingDate"
        type="date"
        value={formData.openingDate?.split('T')[0] || ''}
        onChange={handleChange}
        error={errors.openingDate}
        required
      />
      <Textarea
        label="Description"
        id="description"
        name="description"
        value={formData.description || ''}
        onChange={handleChange}
      />
      <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '10px', marginTop: '20px' }}>
        <Button type="button" onClick={onCancel} variant="secondary" disabled={isLoading}>
          Cancel
        </Button>
        <Button type="submit" onClick={() => {}} variant="primary" disabled={isLoading}>
          {isLoading ? 'Saving...' : 'Save Internal Account'}
        </Button>
      </div>
    </form>
  );
};


export const AuditLogsPage: React.FC = () => {
  const { hasPermission, isAuthenticated } = useAuth();
  const { addNotification } = useNotifications();
  const [logs, setLogs] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [filter, setFilter] = useState('');

  // Simulate fetching audit logs
  const fetchAuditLogs = useCallback(async () => {
    setLoading(true);
    // Simulate API call
    await new Promise(resolve => setTimeout(resolve, 800));
    const mockLogs = [
      { id: 'log1', timestamp: '2023-10-26T18:00:00Z', user: 'admin-user', action: 'CREATE_ACCOUNT_GROUP', target: 'Wealth Management Portfolio Delta', details: { groupId: generateUniqueId() }, ip: '192.168.1.1' },
      { id: 'log2', timestamp: '2023-10-26T17:45:00Z', user: 'manager-user', action: 'UPDATE_ACCOUNT_GROUP', target: 'Corporate Lending Solutions Group', details: { groupId: 'corplend-id', field: 'description' }, ip: '10.0.0.5' },
      { id: 'log3', timestamp: '2023-10-26T17:30:00Z', user: 'viewer-user', action: 'VIEW_ACCOUNT_GROUP', target: 'Retail Banking - Family Accounts', details: { groupId: 'retailfam-id' }, ip: '172.16.0.10' },
      { id: 'log4', timestamp: '2023-10-26T16:00:00Z', user: 'admin-user', action: 'DELETE_INTERNAL_ACCOUNT', target: 'Savings Account B', details: { groupId: 'corplend-id', accountId: generateUniqueId() }, ip: '192.168.1.1' },
      { id: 'log5', timestamp: '2023-10-26T15:00:00Z', user: 'manager-user', action: 'LOGIN_SUCCESS', target: 'manager-user', details: {}, ip: '10.0.0.5' },
    ];

    let filteredLogs = mockLogs;
    if (filter) {
      const lowerCaseFilter = filter.toLowerCase();
      filteredLogs = mockLogs.filter(log =>
        log.action.toLowerCase().includes(lowerCaseFilter) ||
        log.user.toLowerCase().includes(lowerCaseFilter) ||
        log.target.toLowerCase().includes(lowerCaseFilter) ||
        JSON.stringify(log.details).toLowerCase().includes(lowerCaseFilter)
      );
    }

    setLogs(filteredLogs.sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()));
    setLoading(false);
  }, [filter]);

  useEffect(() => {
    if (isAuthenticated && hasPermission('can_audit_logs')) {
      fetchAuditLogs();
    } else if (isAuthenticated) {
      addNotification('Permission denied: You cannot view audit logs.', 'error');
    }
  }, [isAuthenticated, hasPermission, fetchAuditLogs, addNotification]);

  if (!isAuthenticated) {
    return (
      <Container>
        <Alert type="info" message="You must be logged in to view audit logs." />
      </Container>
    );
  }

  if (!hasPermission('can_audit_logs')) {
    return (
      <Container>
        <Alert type="error" message="Permission denied: You do not have access to view audit logs." />
      </Container>
    );
  }

  return (
    <Container>
      <h1 style={{ color: '#003366', marginBottom: '30px' }}>Audit Logs</h1>
      <Card>
        <Input
          type="text"
          placeholder="Filter logs by user, action, target..."
          value={filter}
          onChange={(e) => setFilter(e.target.value)}
          style={{ marginBottom: '20px' }}
        />

        {loading && <LoadingSpinner />}
        {!loading && logs.length === 0 && <Alert type="info" message="No audit logs found." />}

        {!loading && logs.length > 0 && (
          <Table headers={['Timestamp', 'User', 'Action', 'Target', 'IP Address', 'Details']}>
            {logs.map((log, index) => (
              <TableRow key={log.id} isStriped={index % 2 === 0}>
                <TableCell>{formatDate(log.timestamp, 'en-US', { dateStyle: 'medium', timeStyle: 'medium' })}</TableCell>
                <TableCell>{log.user}</TableCell>
                <TableCell>{log.action}</TableCell>
                <TableCell>{log.target}</TableCell>
                <TableCell>{log.ip}</TableCell>
                <TableCell style={{ fontSize: '12px', color: '#666' }}>{JSON.stringify(log.details)}</TableCell>
              </TableRow>
            ))}
          </Table>
        )}
      </Card>
    </Container>
  );
};

export const UserManagementPage: React.FC = () => {
  const { hasPermission, user: currentUser, isAuthenticated } = useAuth();
  const { addNotification } = useNotifications();
  const [users, setUsers] = useState<AuthUser[]>([]);
  const [loading, setLoading] = useState(false);
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingUser, setEditingUser] = useState<AuthUser | null>(null);

  // Simulate user data
  const mockUsers: AuthUser[] = useMemo(() => [
    { id: 'user-admin', name: 'Admin User', role: 'admin', permissions: ['can_create_group', 'can_edit_group', 'can_delete_group', 'can_view_group_all', 'can_manage_users', 'can_audit_logs', 'can_manage_permissions', 'can_access_settings'] },
    { id: 'user-manager', name: 'Manager User', role: 'manager', permissions: ['can_create_group', 'can_edit_group', 'can_view_group_WM', 'can_view_group_CorporateLending', 'can_view_group_RetailBanking', 'can_access_settings'] },
    { id: 'user-viewer', name: 'Viewer User', role: 'viewer', permissions: ['can_view_group_WM', 'can_view_group_RetailBanking', 'can_access_settings'] },
    { id: 'user-corporate-lending', name: 'Corp Lending Specialist', role: 'manager', permissions: ['can_view_group_CorporateLending', 'can_edit_group_CorporateLending'] },
    { id: 'user-burvel', name: 'James Burvel', role: 'manager', permissions: ['can_view_group_WM', 'can_edit_group_WM'] }
  ], []);

  const fetchUsers = useCallback(async () => {
    setLoading(true);
    await new Promise(resolve => setTimeout(resolve, 600)); // Simulate API call
    setUsers(mockUsers);
    setLoading(false);
  }, [mockUsers]);

  useEffect(() => {
    if (isAuthenticated && hasPermission('can_manage_users')) {
      fetchUsers();
    } else if (isAuthenticated) {
      addNotification('Permission denied: You cannot manage users.', 'error');
    }
  }, [isAuthenticated, hasPermission, fetchUsers, addNotification]);

  const handleSaveUser = async (userData: AuthUser) => {
    setLoading(true);
    await new Promise(resolve => setTimeout(resolve, 500)); // Simulate save
    if (editingUser) {
      // Update existing
      setUsers(prev => prev.map(u => u.id === userData.id ? userData : u));
      addNotification(`User ${userData.name} updated successfully.`, 'success');
    } else {
      // Create new (simple append for demo)
      const newUser = { ...userData, id: generateUniqueId() };
      setUsers(prev => [...prev, newUser]);
      addNotification(`User ${newUser.name} created successfully.`, 'success');
    }
    setLoading(false);
    setIsModalOpen(false);
    setEditingUser(null);
  };

  const handleDeleteUser = async (userId: string, userName: string) => {
    if (userId === currentUser?.id) {
      addNotification("You cannot delete your own user account.", 'error');
      return;
    }
    if (window.confirm(`Are you sure you want to delete user "${userName}"?`)) {
      setLoading(true);
      await new Promise(resolve => setTimeout(resolve, 500)); // Simulate delete
      setUsers(prev => prev.filter(u => u.id !== userId));
      setLoading(false);
      addNotification(`User ${userName} deleted successfully.`, 'success');
    }
  };

  if (!isAuthenticated) {
    return (
      <Container>
        <Alert type="info" message="You must be logged in to manage users." />
      </Container>
    );
  }

  if (!hasPermission('can_manage_users')) {
    return (
      <Container>
        <Alert type="error" message="Permission denied: You do not have access to manage users." />
      </Container>
    );
  }

  return (
    <Container>
      <h1 style={{ color: '#003366', marginBottom: '30px' }}>User Management</h1>
      <Card>
        <Button onClick={() => { setEditingUser(null); setIsModalOpen(true); }} variant="success" style={{ marginBottom: '20px' }}>
          Add New User
        </Button>

        {loading && <LoadingSpinner />}
        {!loading && users.length === 0 && <Alert type="info" message="No users found." />}

        {!loading && users.length > 0 && (
          <Table headers={['ID', 'Name', 'Role', 'Permissions', 'Actions']}>
            {users.map((user, index) => (
              <TableRow key={user.id} isStriped={index % 2 === 0}>
                <TableCell>{user.id}</TableCell>
                <TableCell>{user.name}</TableCell>
                <TableCell>
                  <span style={{
                    padding: '4px 8px', borderRadius: '4px', fontSize: '12px', fontWeight: 'bold',
                    backgroundColor: user.role === 'admin' ? '#ffe0b2' : user.role === 'manager' ? '#e3f2fd' : '#e8f5e9',
                    color: user.role === 'admin' ? '#e65100' : user.role === 'manager' ? '#0d47a1' : '#2e7d32'
                  }}>
                    {user.role}
                  </span>
                </TableCell>
                <TableCell style={{ fontSize: '12px', color: '#666' }}>{user.permissions.join(', ')}</TableCell>
                <TableCell>
                  <div style={{ display: 'flex', gap: '5px' }}>
                    <Button onClick={() => { setEditingUser(user); setIsModalOpen(true); }} variant="secondary" style={{ padding: '5px 10px', fontSize: '12px' }}>Edit</Button>
                    {user.id !== currentUser?.id && ( // Prevent user from deleting themselves
                       <Button onClick={() => handleDeleteUser(user.id, user.name)} variant="danger" style={{ padding: '5px 10px', fontSize: '12px' }}>Delete</Button>
                    )}
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </Table>
        )}
      </Card>

      <Modal isOpen={isModalOpen} onClose={() => setIsModalOpen(false)} title={editingUser ? `Edit User: ${editingUser.name}` : 'Create New User'}>
        <UserForm initialData={editingUser} onSave={handleSaveUser} onCancel={() => setIsModalOpen(false)} isLoading={loading} />
      </Modal>
    </Container>
  );
};

export const UserForm: React.FC<{
  initialData?: AuthUser | null;
  onSave: (data: AuthUser) => Promise<any>;
  onCancel: () => void;
  isLoading: boolean;
}> = ({ initialData, onSave, onCancel, isLoading }) => {
  const [formData, setFormData] = useState<AuthUser>(
    initialData || { id: '', name: '', role: 'viewer', permissions: [] }
  );
  const [errors, setErrors] = useState<Record<string, string>>({});
  const { addNotification } = useNotifications();


  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
    setErrors(prev => ({ ...prev, [name]: '' }));
  };

  const handlePermissionsChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
    const permissionsArray = e.target.value.split(',').map(p => p.trim()).filter(p => p !== '');
    setFormData(prev => ({ ...prev, permissions: permissionsArray }));
  };

  const validate = (): boolean => {
    const newErrors: Record<string, string> = {};
    if (!formData.name.trim()) newErrors.name = 'User Name is required.';
    if (!formData.role.trim()) newErrors.role = 'Role is required.';
    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (validate()) {
      await onSave(formData);
    } else {
      addNotification('Please correct the form errors.', 'error');
    }
  };

  const roleOptions = [
    { value: 'admin', label: 'Administrator' },
    { value: 'manager', label: 'Manager' },
    { value: 'viewer', label: 'Viewer' },
  ];

  return (
    <form onSubmit={handleSubmit}>
      <Input
        label="User ID"
        id="id"
        name="id"
        value={formData.id}
        disabled={!!initialData} // ID cannot be changed for existing users
        readOnly={!!initialData}
        placeholder="Auto-generated for new users"
        style={{ color: '#888' }}
      />
      <Input
        label="User Name"
        id="name"
        name="name"
        value={formData.name}
        onChange={handleChange}
        error={errors.name}
        required
      />
      <Select
        label="Role"
        id="role"
        name="role"
        value={formData.role}
        onChange={handleChange}
        options={roleOptions}
        required
      />
      <Textarea
        label="Permissions (comma-separated)"
        id="permissions"
        name="permissions"
        value={formData.permissions.join(', ')}
        onChange={handlePermissionsChange}
        placeholder="e.g., can_create_group, can_view_group_WM"
      />
      <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '10px', marginTop: '20px' }}>
        <Button type="button" onClick={onCancel} variant="secondary" disabled={isLoading}>
          Cancel
        </Button>
        <Button type="submit" onClick={() => {}} variant="primary" disabled={isLoading}>
          {isLoading ? 'Saving...' : 'Save User'}
        </Button>
      </div>
    </form>
  );
};


export const SettingsPage: React.FC = () => {
  const { hasPermission, user, isAuthenticated } = useAuth();
  const { addNotification } = useNotifications();
  const [localSettings, setLocalSettings] = useState({
    theme: 'light',
    dateFormat: 'MM/DD/YYYY',
    currencyDisplay: 'symbol',
    notificationsEnabled: true,
  });
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    // Simulate loading user settings from backend/local storage
    setLoading(true);
    const savedSettings = localStorage.getItem(`userSettings_${user?.id}`);
    if (savedSettings) {
      setLocalSettings(JSON.parse(savedSettings));
    }
    setLoading(false);
  }, [user]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value, type, checked } = e.target as HTMLInputElement;
    setLocalSettings(prev => ({
      ...prev,
      [name]: type === 'checkbox' ? checked : value
    }));
  };

  const handleSaveSettings = async () => {
    setLoading(true);
    await new Promise(resolve => setTimeout(resolve, 700)); // Simulate API call
    localStorage.setItem(`userSettings_${user?.id}`, JSON.stringify(localSettings));
    addNotification('Settings saved successfully!', 'success');
    setLoading(false);
  };

  if (!isAuthenticated) {
    return (
      <Container>
        <Alert type="info" message="You must be logged in to view settings." />
      </Container>
    );
  }

  if (!hasPermission('can_access_settings')) { // Assuming a permission for settings
    return (
      <Container>
        <Alert type="error" message="Permission denied: You do not have access to settings." />
      </Container>
    );
  }

  return (
    <Container>
      <h1 style={{ color: '#003366', marginBottom: '30px' }}>User Settings</h1>
      <Card title="General Preferences">
        <Select
          label="Theme"
          id="theme"
          name="theme"
          value={localSettings.theme}
          onChange={handleChange}
          options={[{ value: 'light', label: 'Light' }, { value: 'dark', label: 'Dark (Coming Soon)' }]}
          disabled={loading}
        />
        <Select
          label="Date Format"
          id="dateFormat"
          name="dateFormat"
          value={localSettings.dateFormat}
          onChange={handleChange}
          options={[{ value: 'MM/DD/YYYY', label: 'MM/DD/YYYY' }, { value: 'DD/MM/YYYY', label: 'DD/MM/YYYY' }, { value: 'YYYY-MM-DD', label: 'YYYY-MM-DD' }]}
          disabled={loading}
        />
        <Select
          label="Currency Display"
          id="currencyDisplay"
          name="currencyDisplay"
          value={localSettings.currencyDisplay}
          onChange={handleChange}
          options={[{ value: 'symbol', label: 'Symbol ($)' }, { value: 'code', label: 'Code (USD)' }]}
          disabled={loading}
        />
        <div style={{ marginBottom: '15px', display: 'flex', alignItems: 'center' }}>
          <Input
            id="notificationsEnabled"
            name="notificationsEnabled"
            type="checkbox"
            checked={localSettings.notificationsEnabled}
            onChange={handleChange}
            disabled={loading}
            style={{ width: 'auto', marginRight: '10px' }}
          />
          <label htmlFor="notificationsEnabled" style={{ fontWeight: 'bold', color: '#555' }}>Enable Notifications</label>
        </div>
        <div style={{ display: 'flex', justifyContent: 'flex-end', marginTop: '20px' }}>
          <Button onClick={handleSaveSettings} variant="primary" disabled={loading}>
            {loading ? 'Saving...' : 'Save Settings'}
          </Button>
        </div>
      </Card>

      <Card title="Security Settings (Simulated)" style={{ marginTop: '30px' }}>
        <p>Password last changed: {formatDate(new Date().toISOString(), 'en-US', { dateStyle: 'long' })}</p>
        <Button onClick={() => addNotification('Password reset link sent to your email!', 'info')} variant="secondary">
          Change Password
        </Button>
        <div style={{ marginTop: '20px' }}>
          <p>Two-Factor Authentication: <span style={{ fontWeight: 'bold', color: 'green' }}>Enabled</span></p>
          <Button onClick={() => addNotification('TFA settings opened in new window!', 'info')} variant="secondary">
            Manage 2FA
          </Button>
        </div>
      </Card>
    </Container>
  );
};


