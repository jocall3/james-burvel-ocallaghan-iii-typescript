export const App: React.FC = () => {
  const { isAuthenticated } = useAuth();
  const accountGroupsContext = useAccountGroups(); // Use context hook here
  
  // Conditionally render AccountGroupForm's onSave/onCancel props
  const onNewGroupSave = useCallback(async (data: Omit<AccountGroup, 'id' | 'typename' | 'createdAt' | 'updatedAt' | 'internalAccountsUnpaginated' | 'internalAccountCount'>) => {
    return accountGroupsContext.createAccountGroup(data);
  }, [accountGroupsContext]);

  const navigate = useNavigate();
  const onNewGroupCancel = useCallback(() => {
    navigate('/account-groups'); // Navigate back to list view
  }, [navigate]);

  return (
    <Router>
      {isAuthenticated ? (
        <DashboardLayout>
          <Routes>
            <Route path="/" element={<DashboardHomePage />} />
            <Route path="/account-groups" element={<AccountGroupsOverviewPage />} />
            <Route path="/account-groups/:id" element={<AccountGroupDetailPage />} />
            <Route path="/account-groups/new" element={<AccountGroupForm onSave={onNewGroupSave} onCancel={onNewGroupCancel} isLoading={accountGroupsContext.loading} />} />
            <Route path="/audit-logs" element={<AuditLogsPage />} />
            <Route path="/user-management" element={<UserManagementPage />} />
            <Route path="/settings" element={<SettingsPage />} />
            <Route path="*" element={<NotFoundPage />} />
          </Routes>
        </DashboardLayout>
      ) : (
        <Routes>
          <Route path="/login" element={<LoginPage />} />
          <Route path="*" element={<LoginPage />} /> {/* Redirect all unauthenticated to login */}
        </Routes>
      )}
    </Router>
  );
};

