// Helper to paginate data
export const paginate = <T extends AccountGroup>(items: T[], first: number | undefined, after: string | undefined, last: number | undefined, before: string | undefined): AccountGroupConnection => {
  const allEdges = items.map((item, index) => ({
    node: item,
    typename: 'AccountGroupEdge' as const,
    cursor: btoa(String(index)) // Simple base64 encoding of index as cursor
  }));

  let filteredEdges = [...allEdges];

  if (after) {
    const afterIndex = allEdges.findIndex(edge => edge.cursor === after);
    if (afterIndex !== -1) {
      filteredEdges = filteredEdges.slice(afterIndex + 1);
    }
  }

  if (before) {
    const beforeIndex = allEdges.findIndex(edge => edge.cursor === before);
    if (beforeIndex !== -1) {
      filteredEdges = filteredEdges.slice(0, beforeIndex);
    }
  }

  let edgesToReturn: AccountGroupEdge[] = [];
  let hasNextPage = false;
  let hasPreviousPage = false;

  if (first !== undefined) {
    edgesToReturn = filteredEdges.slice(0, first);
    hasNextPage = filteredEdges.length > first;
    hasPreviousPage = (after !== undefined && after !== null); // More robust check needed for real app
  } else if (last !== undefined) {
    edgesToReturn = filteredEdges.slice(-last);
    hasPreviousPage = filteredEdges.length > last;
    hasNextPage = (before !== undefined && before !== null); // More robust check needed for real app
  } else {
    edgesToReturn = filteredEdges; // No pagination limits
  }

  const startCursor = edgesToReturn.length > 0 ? edgesToReturn[0].cursor : null;
  const endCursor = edgesToReturn.length > 0 ? edgesToReturn[edgesToReturn.length - 1].cursor : null;

  return {
    edges: edgesToReturn,
    pageInfo: {
      startCursor,
      endCursor,
      hasNextPage,
      hasPreviousPage,
      typename: 'PageInfo',
    },
    typename: 'AccountGroupConnection',
  };
};


/**
 * Mock GraphQL client for querying and mutating AccountGroup data.
 */
export const mockGraphQLClient = {
  query: async <TVariables extends {
    first?: number;
    after?: string;
    last?: number;
    before?: string;
    filter?: string; // Custom filter param
    sortBy?: string; // Custom sort param
    sortOrder?: 'asc' | 'desc'; // Custom sort param
  }>(
    queryName: 'AccountGroupsHome',
    variables: TVariables
  ): Promise<AccountGroupsHomeQueryResponse> => {
    return new Promise(resolve => {
      setTimeout(() => { // Simulate network delay
        let data = [...mockAccountGroupsData];

        // Apply filtering
        if (variables.filter) {
          const lowerCaseFilter = variables.filter.toLowerCase();
          data = data.filter(group =>
            group.name.toLowerCase().includes(lowerCaseFilter) ||
            group.description?.toLowerCase().includes(lowerCaseFilter) ||
            group.path.toLowerCase().includes(lowerCaseFilter) ||
            group.tags.some(tag => tag.toLowerCase().includes(lowerCaseFilter))
          );
        }

        // Apply sorting
        if (variables.sortBy) {
          data.sort((a, b) => {
            let valA: any, valB: any;
            switch (variables.sortBy) {
              case 'name':
                valA = a.name.toLowerCase();
                valB = b.name.toLowerCase();
                break;
              case 'createdAt':
                valA = new Date(a.createdAt).getTime();
                valB = new Date(b.createdAt).getTime();
                break;
              case 'updatedAt':
                valA = new Date(a.updatedAt).getTime();
                valB = new Date(b.updatedAt).getTime();
                break;
              case 'internalAccountCount':
                valA = a.internalAccountCount;
                valB = b.internalAccountCount;
                break;
              case 'status':
                valA = a.status.toLowerCase();
                valB = b.status.toLowerCase();
                break;
              case 'riskLevel':
                  const riskOrder = { 'Low': 0, 'Medium': 1, 'High': 2 };
                  valA = riskOrder[a.riskLevel];
                  valB = riskOrder[b.riskLevel];
                  break;
              default:
                valA = a.id;
                valB = b.id;
            }

            if (valA < valB) return variables.sortOrder === 'desc' ? 1 : -1;
            if (valA > valB) return variables.sortOrder === 'desc' ? -1 : 1;
            return 0;
          });
        }

        const connection = paginate(data, variables.first, variables.after, variables.last, variables.before);

        resolve({
          accountGroups: connection,
        });
      }, 500); // 500ms delay
    });
  },

  mutate: async <TResult, TVariables>(
    mutationName: string,
    variables: TVariables
  ): Promise<TResult> => {
    return new Promise((resolve, reject) => {
      setTimeout(() => { // Simulate network delay
        switch (mutationName) {
          case 'createAccountGroup':
            const newGroup = {
              id: generateUniqueId(),
              typename: 'AccountGroup',
              name: (variables as any).name,
              currency: (variables as any).currency,
              description: (variables as any).description,
              internalAccountsUnpaginated: [],
              internalAccountCount: 0,
              path: (variables as any).path || `Customers/NewGroup/${generateUniqueId().substring(0, 8)}`,
              createdAt: new Date().toISOString(),
              updatedAt: new Date().toISOString(),
              ownerId: (variables as any).ownerId || 'system-admin',
              status: (variables as any).status || 'Active',
              riskLevel: (variables as any).riskLevel || 'Low',
              associatedProducts: (variables as any).associatedProducts || [],
              tags: (variables as any).tags || [],
              permissions: (variables as any).permissions || { canView: [], canEdit: [], canApprove: [] }
            } as AccountGroup;
            mockAccountGroupsData.unshift(newGroup); // Add to beginning for freshness
            resolve({ createAccountGroup: newGroup } as TResult);
            break;
          case 'updateAccountGroup':
            const updatedGroupInput = variables as Partial<AccountGroup> & { id: string };
            const groupIndex = mockAccountGroupsData.findIndex(g => g.id === updatedGroupInput.id);
            if (groupIndex > -1) {
              const existingGroup = mockAccountGroupsData[groupIndex];
              const updatedGroup = {
                ...existingGroup,
                ...updatedGroupInput,
                updatedAt: new Date().toISOString(),
                // Ensure internalAccountsUnpaginated isn't accidentally overwritten from partial update
                internalAccountsUnpaginated: updatedGroupInput.internalAccountsUnpaginated || existingGroup.internalAccountsUnpaginated,
                internalAccountCount: updatedGroupInput.internalAccountCount !== undefined ? updatedGroupInput.internalAccountCount : existingGroup.internalAccountCount
              };
              mockAccountGroupsData[groupIndex] = updatedGroup;
              resolve({ updateAccountGroup: updatedGroup } as TResult);
            } else {
              reject(new Error('AccountGroup not found for update.'));
            }
            break;
          case 'deleteAccountGroup':
            const deleteId = (variables as any).id;
            const initialLength = mockAccountGroupsData.length;
            mockAccountGroupsData = mockAccountGroupsData.filter(g => g.id !== deleteId);
            if (mockAccountGroupsData.length < initialLength) {
              resolve({ deleteAccountGroup: { id: deleteId, success: true } } as TResult);
            } else {
              reject(new Error('AccountGroup not found for deletion.'));
            }
            break;
          case 'addInternalAccount':
            const { groupId: addIntAccGroupId, newInternalAccount: newIntAcc } = variables as { groupId: string, newInternalAccount: Omit<InternalAccount, 'id' | 'typename'> };
            const groupToAddIntAcc = mockAccountGroupsData.find(g => g.id === addIntAccGroupId);
            if (groupToAddIntAcc) {
              const fullNewIntAcc: InternalAccount = {
                ...newIntAcc,
                id: generateUniqueId(),
                typename: 'InternalAccount',
                balance: newIntAcc.balance || 0,
                currency: newIntAcc.currency || 'USD',
                status: newIntAcc.status || 'Active',
                openingDate: newIntAcc.openingDate || new Date().toISOString(),
                lastActivityDate: newIntAcc.lastActivityDate || new Date().toISOString(),
                type: newIntAcc.type || 'Checking'
              };
              groupToAddIntAcc.internalAccountsUnpaginated.push(fullNewIntAcc);
              groupToAddIntAcc.internalAccountCount = groupToAddIntAcc.internalAccountsUnpaginated.length;
              groupToAddIntAcc.updatedAt = new Date().toISOString();
              resolve({ addInternalAccount: fullNewIntAcc } as TResult);
            } else {
              reject(new Error('AccountGroup not found to add internal account.'));
            }
            break;
          case 'updateInternalAccount':
            const { groupId: updateIntAccGroupId, internalAccountId: updateIntAccId, updates: intAccUpdates } = variables as { groupId: string, internalAccountId: string, updates: Partial<InternalAccount> };
            const groupToUpdateIntAcc = mockAccountGroupsData.find(g => g.id === updateIntAccGroupId);
            if (groupToUpdateIntAcc) {
              const intAccIndex = groupToUpdateIntAcc.internalAccountsUnpaginated.findIndex(ia => ia.id === updateIntAccId);
              if (intAccIndex > -1) {
                const updatedIntAcc = {
                  ...groupToUpdateIntAcc.internalAccountsUnpaginated[intAccIndex],
                  ...intAccUpdates,
                  lastActivityDate: new Date().toISOString()
                };
                groupToUpdateIntAcc.internalAccountsUnpaginated[intAccIndex] = updatedIntAcc;
                groupToUpdateIntAcc.updatedAt = new Date().toISOString();
                resolve({ updateInternalAccount: updatedIntAcc } as TResult);
              } else {
                reject(new Error('Internal Account not found for update.'));
              }
            } else {
              reject(new Error('AccountGroup not found to update internal account.'));
            }
            break;
          case 'deleteInternalAccount':
            const { groupId: deleteIntAccGroupId, internalAccountId: deleteIntAccId } = variables as { groupId: string, internalAccountId: string };
            const groupToDeleteIntAcc = mockAccountGroupsData.find(g => g.id === deleteIntAccGroupId);
            if (groupToDeleteIntAcc) {
              const initialIntAccCount = groupToDeleteIntAcc.internalAccountsUnpaginated.length;
              groupToDeleteIntAcc.internalAccountsUnpaginated = groupToDeleteIntAcc.internalAccountsUnpaginated.filter(ia => ia.id !== deleteIntAccId);
              if (groupToDeleteIntAcc.internalAccountsUnpaginated.length < initialIntAccCount) {
                groupToDeleteIntAcc.internalAccountCount = groupToDeleteIntAcc.internalAccountsUnpaginated.length;
                groupToDeleteIntAcc.updatedAt = new Date().toISOString();
                resolve({ deleteInternalAccount: { id: deleteIntAccId, success: true } } as TResult);
              } else {
                reject(new Error('Internal Account not found for deletion.'));
              }
            } else {
              reject(new Error('AccountGroup not found to delete internal account.'));
            }
            break;
          default:
            reject(new Error(`Unknown mutation: ${mutationName}`));
        }
      }, 700); // 700ms delay for mutations
    });
  }
};


// --- 3. Context API for Global State Management ---

export interface AuthUser {
  id: string;
  name: string;
  role: 'admin' | 'manager' | 'viewer';
  permissions: string[]; // e.g., ['can_create_group', 'can_edit_group_WM']
}

export interface AuthContextType {
  user: AuthUser | null;
  isAuthenticated: boolean;
  login: (username: string, password: string) => Promise<boolean>;
  logout: () => void;
  hasPermission: (permission: string, targetId?: string) => boolean;
}

export const AuthContext = createContext<AuthContextType | undefined>(undefined);

export const AuthProvider: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
  const [user, setUser] = useState<AuthUser | null>(null);
  const [isAuthenticated, setIsAuthenticated] = useState(false);

  // Simulate user data from local storage or session
  useEffect(() => {
    const storedUser = localStorage.getItem('currentUser');
    if (storedUser) {
      setUser(JSON.parse(storedUser));
      setIsAuthenticated(true);
    }
  }, []);

  const login = useCallback(async (username, password) => {
    // Simulate API call for login
    await new Promise(resolve => setTimeout(resolve, 1000));
    if (username === 'admin' && password === 'password') {
      const authUser: AuthUser = {
        id: 'user-admin',
        name: 'Admin User',
        role: 'admin',
        permissions: ['can_create_group', 'can_edit_group', 'can_delete_group', 'can_view_group_all', 'can_manage_users', 'can_audit_logs', 'can_manage_permissions', 'can_access_settings']
      };
      setUser(authUser);
      setIsAuthenticated(true);
      localStorage.setItem('currentUser', JSON.stringify(authUser));
      return true;
    } else if (username === 'manager' && password === 'password') {
      const authUser: AuthUser = {
        id: 'user-manager',
        name: 'Manager User',
        role: 'manager',
        permissions: ['can_create_group', 'can_edit_group', 'can_view_group_WM', 'can_view_group_CorporateLending', 'can_view_group_RetailBanking', 'can_access_settings']
      };
      setUser(authUser);
      setIsAuthenticated(true);
      localStorage.setItem('currentUser', JSON.stringify(authUser));
      return true;
    } else if (username === 'viewer' && password === 'password') {
      const authUser: AuthUser = {
        id: 'user-viewer',
        name: 'Viewer User',
        role: 'viewer',
        permissions: ['can_view_group_WM', 'can_view_group_RetailBanking', 'can_access_settings']
      };
      setUser(authUser);
      setIsAuthenticated(true);
      localStorage.setItem('currentUser', JSON.stringify(authUser));
      return true;
    }
    return false;
  }, []);

  const logout = useCallback(() => {
    setUser(null);
    setIsAuthenticated(false);
    localStorage.removeItem('currentUser');
  }, []);

  const hasPermission = useCallback((permission: string, targetId?: string): boolean => {
    if (!user) return false;
    if (user.role === 'admin') return true; // Admins have all permissions

    // Specific permission checks for account groups
    if (permission.startsWith('can_view_group') && targetId) {
      const group = mockAccountGroupsData.find(g => g.id === targetId);
      if (group) {
        if (group.ownerId === user.id) return true;
        // Check general 'can_view_group' if it implies all (e.g., manager, admin) or specific by path
        if (user.permissions.includes('can_view_group_all')) return true;
        if (user.permissions.some(p => p === `can_view_group_${group.path.split('/')[1]}`)) return true; // e.g., WM for WealthManagement
        if (group.permissions.canView.includes(user.id)) return true;
      }
    }
    if (permission.startsWith('can_edit_group') && targetId) {
      const group = mockAccountGroupsData.find(g => g.id === targetId);
      if (group) {
        if (group.ownerId === user.id) return true; // Owner can edit their own group
        if (user.permissions.includes('can_edit_group_all')) return true;
        if (user.permissions.some(p => p === `can_edit_group_${group.path.split('/')[1]}`)) return true;
        if (group.permissions.canEdit.includes(user.id)) return true;
      }
    }
    if (permission.startsWith('can_delete_group') && targetId) {
      const group = mockAccountGroupsData.find(g => g.id === targetId);
      if (group && group.ownerId === user.id) return true; // Only owner or admin can delete
      if (user.permissions.includes('can_delete_group_all')) return true;
    }

    return user.permissions.includes(permission);
  }, [user]);

  const authContextValue = useMemo(() => ({
    user,
    isAuthenticated,
    login,
    logout,
    hasPermission,
  }), [user, isAuthenticated, login, logout, hasPermission]);

  return (
    <AuthContext.Provider value={authContextValue}>
      {children}
    </AuthContext.Provider>
  );
};

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (!context) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
};

// Notification Context for Toast Messages
export interface Notification {
  id: string;
  message: string;
  type: 'success' | 'error' | 'info' | 'warning';
  duration?: number; // in ms
}

export interface NotificationsContextType {
  addNotification: (message: string, type: Notification['type'], duration?: number) => void;
  removeNotification: (id: string) => void;
  notifications: Notification[];
}

export const NotificationsContext = createContext<NotificationsContextType | undefined>(undefined);

export const NotificationsProvider: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
  const [notifications, setNotifications] = useState<Notification[]>([]);

  const addNotification = useCallback((message: string, type: Notification['type'], duration: number = 5000) => {
    const id = generateUniqueId();
    const newNotification: Notification = { id, message, type, duration };
    setNotifications(prev => [...prev, newNotification]);

    setTimeout(() => {
      removeNotification(id);
    }, duration);
  }, []);

  const removeNotification = useCallback((id: string) => {
    setNotifications(prev => prev.filter(n => n.id !== id));
  }, []);

  const contextValue = useMemo(() => ({
    notifications,
    addNotification,
    removeNotification,
  }), [notifications, addNotification, removeNotification]);

  return (
    <NotificationsContext.Provider value={contextValue}>
      {children}
    </NotificationsContext.Provider>
  );
};

export const useNotifications = () => {
  const context = useContext(NotificationsContext);
  if (!context) {
    throw new Error('useNotifications must be used within a NotificationsProvider');
  }
  return context;
};

// Account Groups Context for global data and actions
export interface AccountGroupsContextType {
  accountGroups: AccountGroupConnection | null;
  loading: boolean;
  error: string | null;
  fetchAccountGroups: (variables?: ApolloClient.QueryVariables<any>) => Promise<void>;
  createAccountGroup: (input: Omit<AccountGroup, 'id' | 'typename' | 'createdAt' | 'updatedAt' | 'internalAccountsUnpaginated' | 'internalAccountCount'>) => Promise<AccountGroup | null>;
  updateAccountGroup: (id: string, updates: Partial<AccountGroup>) => Promise<AccountGroup | null>;
  deleteAccountGroup: (id: string) => Promise<boolean>;
  addInternalAccount: (groupId: string, newAccount: Omit<InternalAccount, 'id' | 'typename'>) => Promise<InternalAccount | null>;
  updateInternalAccount: (groupId: string, internalAccountId: string, updates: Partial<InternalAccount>) => Promise<InternalAccount | null>;
  deleteInternalAccount: (groupId: string, internalAccountId: string) => Promise<boolean>;
}

export const AccountGroupsContext = createContext<AccountGroupsContextType | undefined>(undefined);

export const AccountGroupsProvider: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
  const [accountGroups, setAccountGroups] = useState<AccountGroupConnection | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const { addNotification } = useNotifications();
  const { user, hasPermission } = useAuth(); // Access current user for permission checks

  const fetchAccountGroups = useCallback(async (variables: ApolloClient.QueryVariables<any> = {}) => {
    setLoading(true);
    setError(null);
    try {
      const response = await mockGraphQLClient.query('AccountGroupsHome', variables);
      // Filter based on user permissions
      const accessibleEdges = response.accountGroups.edges.filter(edge =>
        hasPermission('can_view_group', edge.node.id) // Use the granular permission check
      );

      // Redact sensitive data for viewers
      const processedEdges = accessibleEdges.map(edge => ({
        ...edge,
        node: {
          ...edge.node,
          internalAccountsUnpaginated: edge.node.internalAccountsUnpaginated.map(ia => {
            // If user can view the group but not explicitly manage it, and it's a sensitive account type like checking/loan, redact
            if (user?.role === 'viewer' && ia.type === 'Checking' && edge.node.ownerId !== user.id) {
              return { ...ia, balance: 0, accountNumber: 'XXXXX' };
            }
            return ia;
          })
        }
      }));

      setAccountGroups({
        ...response.accountGroups,
        edges: processedEdges
      });
    } catch (err: any) {
      setError(err.message);
      addNotification(`Failed to fetch account groups: ${err.message}`, 'error');
    } finally {
      setLoading(false);
    }
  }, [addNotification, user, hasPermission]); // Depend on user and hasPermission to re-evaluate permissions

  const createAccountGroup = useCallback(async (input: Omit<AccountGroup, 'id' | 'typename' | 'createdAt' | 'updatedAt' | 'internalAccountsUnpaginated' | 'internalAccountCount'>) => {
    if (!user || !hasPermission('can_create_group')) {
      addNotification('Permission denied: You cannot create account groups.', 'error');
      return null;
    }
    setLoading(true);
    setError(null);
    try {
      const result = await mockGraphQLClient.mutate<{ createAccountGroup: AccountGroup }, typeof input>('createAccountGroup', { ...input, ownerId: user.id });
      fetchAccountGroups(); // Refresh data after mutation
      addNotification(`Account Group "${result.createAccountGroup.name}" created successfully.`, 'success');
      return result.createAccountGroup;
    } catch (err: any) {
      setError(err.message);
      addNotification(`Failed to create account group: ${err.message}`, 'error');
      return null;
    } finally {
      setLoading(false);
    }
  }, [fetchAccountGroups, addNotification, user, hasPermission]);

  const updateAccountGroup = useCallback(async (id: string, updates: Partial<AccountGroup>) => {
    if (!id || !hasPermission('can_edit_group', id)) {
      addNotification('Permission denied: You cannot edit this account group.', 'error');
      return null;
    }
    setLoading(true);
    setError(null);
    try {
      const result = await mockGraphQLClient.mutate<{ updateAccountGroup: AccountGroup }, Partial<AccountGroup> & { id: string }>('updateAccountGroup', { id, ...updates });
      fetchAccountGroups(); // Refresh data
      addNotification(`Account Group "${result.updateAccountGroup.name}" updated successfully.`, 'success');
      return result.updateAccountGroup;
    } catch (err: any) {
      setError(err.message);
      addNotification(`Failed to update account group: ${err.message}`, 'error');
      return null;
    } finally {
      setLoading(false);
    }
  }, [fetchAccountGroups, addNotification, hasPermission]);

  const deleteAccountGroup = useCallback(async (id: string) => {
    if (!id || !hasPermission('can_delete_group', id)) {
      addNotification('Permission denied: You cannot delete this account group.', 'error');
      return false;
    }
    setLoading(true);
    setError(null);
    try {
      await mockGraphQLClient.mutate<{ deleteAccountGroup: { id: string, success: boolean } }, { id: string }>('deleteAccountGroup', { id });
      fetchAccountGroups(); // Refresh data
      addNotification('Account Group deleted successfully.', 'success');
      return true;
    } catch (err: any) {
      setError(err.message);
      addNotification(`Failed to delete account group: ${err.message}`, 'error');
      return false;
    } finally {
      setLoading(false);
    }
  }, [fetchAccountGroups, addNotification, hasPermission]);

  const addInternalAccount = useCallback(async (groupId: string, newAccount: Omit<InternalAccount, 'id' | 'typename'>) => {
    if (!groupId || !hasPermission('can_edit_group', groupId)) {
      addNotification('Permission denied: You cannot add internal accounts to this group.', 'error');
      return null;
    }
    setLoading(true);
    setError(null);
    try {
      const result = await mockGraphQLClient.mutate<{ addInternalAccount: InternalAccount }, { groupId: string, newInternalAccount: Omit<InternalAccount, 'id' | 'typename'> }>('addInternalAccount', { groupId, newInternalAccount: newAccount });
      fetchAccountGroups();
      addNotification(`Internal account "${newAccount.bestName}" added successfully.`, 'success');
      return result.addInternalAccount;
    } catch (err: any) {
      setError(err.message);
      addNotification(`Failed to add internal account: ${err.message}`, 'error');
      return null;
    } finally {
      setLoading(false);
    }
  }, [fetchAccountGroups, addNotification, hasPermission]);

  const updateInternalAccount = useCallback(async (groupId: string, internalAccountId: string, updates: Partial<InternalAccount>) => {
    if (!groupId || !internalAccountId || !hasPermission('can_edit_group', groupId)) {
      addNotification('Permission denied: You cannot update internal accounts in this group.', 'error');
      return null;
    }
    setLoading(true);
    setError(null);
    try {
      const result = await mockGraphQLClient.mutate<{ updateInternalAccount: InternalAccount }, { groupId: string, internalAccountId: string, updates: Partial<InternalAccount> }>('updateInternalAccount', { groupId, internalAccountId, updates });
      fetchAccountGroups();
      addNotification(`Internal account updated successfully.`, 'success');
      return result.updateInternalAccount;
    } catch (err: any) {
      setError(err.message);
      addNotification(`Failed to update internal account: ${err.message}`, 'error');
      return null;
    } finally {
      setLoading(false);
    }
  }, [fetchAccountGroups, addNotification, hasPermission]);

  const deleteInternalAccount = useCallback(async (groupId: string, internalAccountId: string) => {
    if (!groupId || !internalAccountId || !hasPermission('can_edit_group', groupId)) {
      addNotification('Permission denied: You cannot delete internal accounts from this group.', 'error');
      return false;
    }
    setLoading(true);
    setError(null);
    try {
      await mockGraphQLClient.mutate<{ deleteInternalAccount: { id: string, success: boolean } }, { groupId: string, internalAccountId: string }>('deleteInternalAccount', { groupId, internalAccountId });
      fetchAccountGroups();
      addNotification('Internal account deleted successfully.', 'success');
      return true;
    } catch (err: any) {
      setError(err.message);
      addNotification(`Failed to delete internal account: ${err.message}`, 'error');
      return false;
    } finally {
      setLoading(false);
    }
  }, [fetchAccountGroups, addNotification, hasPermission]);


  useEffect(() => {
    if (user) { // Fetch data only if user is authenticated
      fetchAccountGroups();
    } else {
      setAccountGroups(null); // Clear data if logged out
    }
  }, [user, fetchAccountGroups]); // Refetch when user changes or fetch function itself changes

  const contextValue = useMemo(() => ({
    accountGroups,
    loading,
    error,
    fetchAccountGroups,
    createAccountGroup,
    updateAccountGroup,
    deleteAccountGroup,
    addInternalAccount,
    updateInternalAccount,
    deleteInternalAccount,
  }), [
    accountGroups, loading, error, fetchAccountGroups,
    createAccountGroup, updateAccountGroup, deleteAccountGroup,
    addInternalAccount, updateInternalAccount, deleteInternalAccount
  ]);

  return (
    <AccountGroupsContext.Provider value={contextValue}>
      {children}
    </AccountGroupsContext.Provider>
  );
};

export const useAccountGroups = () => {
  const context = useContext(AccountGroupsContext);
  if (!context) {
    throw new Error('useAccountGroups must be used within an AccountGroupsProvider');
  }
  return context;
};


