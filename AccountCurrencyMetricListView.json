export const AppContent: React.FC = () => {
  const { isAuthenticated } = useAuth();
  const { t } = useI18n();
  const [currentView, setCurrentView] = useState("dashboard");

  if (!isAuthenticated) {
    return <AuthPage onLoginSuccess={() => setCurrentView("dashboard")} />;
  }

  return (
    <div className="flex flex-col min-h-screen bg-background-50 dark:bg-gray-800 text-text-primary">
      <Header />
      <div className="flex flex-1">
        <Sidebar currentView={currentView} setView={setCurrentView} />
        <main className="flex-1 p-8 overflow-auto">
          {currentView === "dashboard" && <Dashboard />}
          {currentView === "accounts" && <AccountCurrencyMetricTable />}
          {currentView === "reports" && <ReportingPanel />}
