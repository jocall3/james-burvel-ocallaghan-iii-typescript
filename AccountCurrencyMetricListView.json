export const Dashboard: React.FC = () => {
  const {
    data,
    loading,
    error,
    filterCurrency,
    setFilterCurrency,
  } = useAccountCurrencyMetrics();
  const { t } = useI18n();

  const summaryMetrics = useMemo(() => {
    if (loading || error || data.length === 0) {
      return {
        totalAvailable: 0,
        totalPriorDay: 0,
        totalVariance: 0,
        totalUnreconciled: 0,
        maxVariance: 0,
        currency: filterCurrency || CurrencyEnum.USD,
      };
    }

    const {
      totalAvailable,
      totalPriorDay,
      totalVariance,
      totalUnreconciled,
      maxVariance,
    } = data.reduce(
      (acc, curr) => {
        acc.totalAvailable += curr.rawAvailableBalance;
        acc.totalPriorDay += curr.rawPriorDayBalance;
        acc.totalVariance += curr.rawLedgerVariance;
        acc.totalUnreconciled += curr.rawUnreconciledAmount;
        acc.maxVariance = Math.max(acc.maxVariance, Math.abs(curr.rawLedgerVariance));
        return acc;
      },
      {
        totalAvailable: 0,
        totalPriorDay: 0,
        totalVariance: 0,
        totalUnreconciled: 0,
        maxVariance: 0,
      },
    );

    return {
      totalAvailable,
      totalPriorDay,
      totalVariance,
      totalUnreconciled,
      maxVariance,
      currency: filterCurrency || data[0].currency || CurrencyEnum.USD, // Use first available if filter not set
    };
  }, [data, loading, error, filterCurrency]);

  const {
    totalAvailable,
    totalPriorDay,
    totalVariance,
    totalUnreconciled,
    maxVariance,
    currency,
  } = summaryMetrics;

  return (
    <div className="p-6">
      <h2 className="text-3xl font-bold mb-6 text-text-primary">{t("nav.dashboard")}</h2>

      <div className="mb-6">
        <label htmlFor="dashboardCurrencyFilter" className="block text-text-secondary text-sm font-bold mb-2">
          View Dashboard for Currency:
        </label>
        <select
          id="dashboardCurrencyFilter"
          value={filterCurrency || ""}
          onChange={(e) => setFilterCurrency(e.target.value as CurrencyEnum | null)}
          className="p-2 border border-border-300 rounded-md bg-background-50 text-text-primary"
        >
          <option value="">All Currencies (Aggregated)</option>
          {Object.values(CurrencyEnum).map((curr) => (
            <option key={curr} value={curr}>
              {curr}
            </option>
          ))}
        </select>
      </div>

      {loading && <LoadingSpinner />}
      {error && <ErrorMessage message={t("error.fetch")} />}
      {!loading && !error && data.length === 0 && <p>{t("noData")}</p>}

      {!loading && !error && data.length > 0 && (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <MetricCard
            title={t("balance.available")}
            value={formatCurrency(totalAvailable, currency)}
            type="info"
          />
          <MetricCard
            title={t("balance.priorDay")}
            value={formatCurrency(totalPriorDay, currency)}
            type="info"
          />
          <MetricCard
            title={t("metric.ledgerVariance")}
            value={formatCurrency(totalVariance, currency)}
            type={totalVariance < 0 ? "danger" : totalVariance > 0 ? "success" : "info"}
            subValue={`Max single variance: ${formatCurrency(maxVariance, currency)}`}
          />
          <MetricCard
            title={t("metric.unreconciledAmount")}
            value={formatCurrency(totalUnreconciled, currency)}
            type={totalUnreconciled > 0 ? "warning" : "success"}
          />
        </div>
      )}

      {featureFlagService.isFeatureEnabled("enableAdvancedAnalytics") && (
        <section className="mt-8">
          <h3 className="text-2xl font-semibold mb-4 text-text-primary">Advanced Analytics</h3>
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div className="bg-background-200 p-6 rounded-lg shadow-lg">
              <h4 className="text-xl font-medium mb-3 text-text-primary">Variance Trend (Mock Chart)</h4>
              <div className="h-64 bg-gray-300 dark:bg-gray-700 flex items-center justify-center text-gray-500 rounded">
                (Chart Placeholder: Ledger Variance Over Time)
