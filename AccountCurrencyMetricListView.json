            </div>
            <div className="bg-background-200 p-6 rounded-lg shadow-lg">
              <h4 className="text-xl font-medium mb-3 text-text-primary">Unreconciled Breakdown (Mock Pie Chart)</h4>
              <div className="h-64 bg-gray-300 dark:bg-gray-700 flex items-center justify-center text-gray-500 rounded">
                (Chart Placeholder: Unreconciled Amounts by Category)
              </div>
            </div>
          </div>
        </section>
      )}

      <AccountCurrencyMetricTable />
    </div>
  );
};

export const AuthPage: React.FC<{ onLoginSuccess: () => void }> = ({
  onLoginSuccess,
}) => {
  const { login, isAuthenticated } = useAuth();
  const { addNotification } = useNotification();
  const { t } = useI18n();
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [loginLoading, setLoginLoading] = useState(false);

  useEffect(() => {
    if (isAuthenticated) {
      onLoginSuccess();
    }
  }, [isAuthenticated, onLoginSuccess]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoginLoading(true);
    try {
      await login(username, password);
      addNotification({ message: "Login successful!", type: "success" });
    } catch (error: any) {
      addNotification({
        message: error.message || "Login failed. Please try again.",
        type: "error",
      });
    } finally {
      setLoginLoading(false);
    }
  };

  return (
    <div className="flex items-center justify-center min-h-screen bg-background-50 dark:bg-gray-900">
      <form
        onSubmit={handleSubmit}
        className="bg-background-200 p-8 rounded-lg shadow-lg w-full max-w-sm"
      >
        <h2 className="text-3xl font-bold mb-6 text-center text-text-primary">
          Login to {t("app.title")}
        </h2>
        <div className="mb-4">
          <label
            htmlFor="username"
            className="block text-text-secondary text-sm font-bold mb-2"
          >
            Username:
          </label>
          <input
            type="text"
            id="username"
            className="shadow appearance-none border rounded w-full py-2 px-3 text-text-primary leading-tight focus:outline-none focus:shadow-outline bg-background-50"
            value={username}
            onChange={(e) => setUsername(e.target.value)}
            disabled={loginLoading}
          />
        </div>
        <div className="mb-6">
          <label
            htmlFor="password"
            className="block text-text-secondary text-sm font-bold mb-2"
          >
            Password:
          </label>
          <input
            type="password"
            id="password"
            className="shadow appearance-none border rounded w-full py-2 px-3 text-text-primary mb-3 leading-tight focus:outline-none focus:shadow-outline bg-background-50"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            disabled={loginLoading}
          />
        </div>
        <div className="flex items-center justify-between">
          <button
            type="submit"
            className="bg-primary-500 hover:bg-primary-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline w-full disabled:opacity-50"
            disabled={loginLoading}
          >
            {loginLoading ? "Logging in..." : t("button.login")}
          </button>
        </div>
      </form>
    </div>
  );
};

export const ReportingPanel: React.FC = () => {
  const { t } = useI18n();
  const { addNotification } = useNotification();
  const { hasPermission } = useAuth();
  const [reportType, setReportType] = useState("daily");
  const [currency, setCurrency] = useState(CurrencyEnum.USD);
  const [generating, setGenerating] = useState(false);

  const handleGenerateReport = async () => {
    if (!hasPermission("canExportReports")) {
      addNotification({ message: "You don't have permission to export reports.", type: "error" });
      return;
    }
    setGenerating(true);
    addNotification({ message: `Generating ${reportType} report for ${currency}...`, type: "info" });
    logger.info(`Report generation requested: ${reportType}, ${currency}`);
    await auditService.logAction("REPORT_GENERATION", "user123", {
      reportType,
      currency,
    });
    // Simulate API call to generate report
    await new Promise((resolve) => setTimeout(resolve, 3000));
    setGenerating(false);
    addNotification({ message: `Report for ${currency} (${reportType}) generated successfully!`, type: "success" });
    logger.info("Report generated successfully.");
  };

  return (
    <div className="p-6 bg-background-200 rounded-lg shadow-lg">
      <h2 className="text-2xl font-semibold mb-4 text-text-primary">
        {t("nav.reports")}
      </h2>
      <div className="mb-4">
        <label htmlFor="reportType" className="block text-text-secondary text-sm font-bold mb-2">
          Report Type:
        </label>
        <select
          id="reportType"
          value={reportType}
          onChange={(e) => setReportType(e.target.value)}
          className="p-2 border border-border-300 rounded-md bg-background-50 text-text-primary w-full"
        >
          <option value="daily">Daily Summary</option>
          <option value="monthly">Monthly Aggregate</option>
          <option value="variance">Ledger Variance Details</option>
          <option value="unreconciled">Unreconciled Items</option>
        </select>
      </div>
      <div className="mb-6">
        <label htmlFor="reportCurrency" className="block text-text-secondary text-sm font-bold mb-2">
          Currency:
        </label>
        <select
          id="reportCurrency"
          value={currency}
          onChange={(e) => setCurrency(e.target.value as CurrencyEnum)}
          className="p-2 border border-border-300 rounded-md bg-background-50 text-text-primary w-full"
        >
          {Object.values(CurrencyEnum).map((curr) => (
            <option key={curr} value={curr}>
              {curr}
            </option>
          ))}
        </select>
      </div>
      <button
        onClick={handleGenerateReport}
        className="bg-primary-500 hover:bg-primary-600 text-white font-bold py-2 px-4 rounded-md disabled:opacity-50"
        disabled={generating || !hasPermission("canExportReports")}
      >
        {generating ? "Generating..." : t("button.export")}
      </button>

      {generating && <LoadingSpinner />}
      <p className="text-text-secondary text-sm mt-4">
        Reports can take some time to generate depending on data volume.
      </p>
    </div>
  );
};

export const SettingsPanel: React.FC = () => {
  const { t, locale, setLocale } = useI18n();
  const { theme, toggleTheme } = useTheme();
  const { addNotification } = useNotification();
  const { hasPermission } = useAuth();

  const [itemsPerPage, setItemsPerPage] = useState(configService.get("itemsPerPage"));
  const [refreshInterval, setRefreshInterval] = useState(configService.get("refreshIntervalSeconds"));
  const [defaultCurrency, setDefaultCurrency] = useState(configService.get("defaultCurrency"));

  useEffect(() => {
    setItemsPerPage(configService.get("itemsPerPage"));
    setRefreshInterval(configService.get("refreshIntervalSeconds"));
    setDefaultCurrency(configService.get("defaultCurrency"));
  }, []);

  const handleSaveSettings = () => {
    if (!hasPermission("canConfigureSettings")) {
      addNotification({ message: "You don't have permission to configure settings.", type: "error" });
      return;
    }
    configService.set("itemsPerPage", itemsPerPage);
    configService.set("refreshIntervalSeconds", refreshInterval);
    configService.set("defaultCurrency", defaultCurrency);
    addNotification({ message: "Settings saved successfully!", type: "success" });
    logger.info("User settings updated.");
    auditService.logAction("USER_SETTINGS_UPDATE", "user123", { itemsPerPage, refreshInterval, defaultCurrency });
  };

  return (
    <div className="p-6 bg-background-200 rounded-lg shadow-lg">
      <h2 className="text-2xl font-semibold mb-4 text-text-primary">
        {t("nav.settings")}
      </h2>

      <div className="mb-6">
        <h3 className="text-xl font-medium mb-3 text-text-primary">User Interface</h3>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label htmlFor="language" className="block text-text-secondary text-sm font-bold mb-2">
              Language:
            </label>
            <select
              id="language"
              value={locale}
              onChange={(e) => setLocale(e.target.value as Locale)}
              className="p-2 border border-border-300 rounded-md bg-background-50 text-text-primary w-full"
              disabled={!hasPermission("canConfigureSettings")}
            >
              <option value="en-US">English (US)</option>
              <option value="es-ES">Español (ES)</option>
              <option value="fr-FR">Français (FR)</option>
            </select>
          </div>
          <div>
            <label className="block text-text-secondary text-sm font-bold mb-2">Theme:</label>
            <button
              onClick={toggleTheme}
              className="px-4 py-2 bg-primary-500 text-white rounded-md hover:bg-primary-600 disabled:opacity-50"
              disabled={!hasPermission("canConfigureSettings")}
            >
              Switch to {theme === "light" ? "Dark" : "Light"} Mode
            </button>
          </div>
        </div>
      </div>

      <div className="mb-6">
        <h3 className="text-xl font-medium mb-3 text-text-primary">Data & Display</h3>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label htmlFor="itemsPerPage" className="block text-text-secondary text-sm font-bold mb-2">
              Items Per Page:
            </label>
            <input
              type="number"
              id="itemsPerPage"
              value={itemsPerPage}
              onChange={(e) => setItemsPerPage(parseInt(e.target.value) || 1)}
              min="1"
              max="50"
              className="p-2 border border-border-300 rounded-md bg-background-50 text-text-primary w-full"
              disabled={!hasPermission("canConfigureSettings")}
            />
          </div>
          <div>
            <label htmlFor="refreshInterval" className="block text-text-secondary text-sm font-bold mb-2">
              Auto-Refresh Interval (seconds):
            </label>
            <input
              type="number"
              id="refreshInterval"
              value={refreshInterval}
              onChange={(e) => setRefreshInterval(parseInt(e.target.value) || 30)}
              min="30"
              className="p-2 border border-border-300 rounded-md bg-background-50 text-text-primary w-full"
              disabled={!hasPermission("canConfigureSettings")}
            />
          </div>
          <div>
            <label htmlFor="defaultCurrency" className="block text-text-secondary text-sm font-bold mb-2">
              Default Display Currency:
            </label>
            <select
              id="defaultCurrency"
              value={defaultCurrency}
              onChange={(e) => setDefaultCurrency(e.target.value as CurrencyEnum)}
              className="p-2 border border-border-300 rounded-md bg-background-50 text-text-primary w-full"
              disabled={!hasPermission("canConfigureSettings")}
            >
              {Object.values(CurrencyEnum).map((curr) => (
                <option key={curr} value={curr}>
                  {curr}
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <button
        onClick={handleSaveSettings}
        className="mt-6 bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded-md disabled:opacity-50"
        disabled={!hasPermission("canConfigureSettings")}
      >
        Save Settings
      </button>
      {!hasPermission("canConfigureSettings") && (
        <p className="text-red-500 text-sm mt-2">
          You do not have permission to modify settings.
        </p>
      )}
    </div>
  );
};

// Error Boundary for gracefully handling runtime errors
interface ErrorBoundaryProps {
  children: ReactNode;
}

interface ErrorBoundaryState {
  hasError: boolean;
  error: Error | null;
}

export class ErrorBoundary extends React.Component<
  ErrorBoundaryProps,
  ErrorBoundaryState
> {
  constructor(props: ErrorBoundaryProps) {
    super(props);
    this.state = { hasError: false, error: null };
  }

  static getDerivedStateFromError(error: Error): ErrorBoundaryState {
    // Update state so the next render will show the fallback UI.
    return { hasError: true, error };
  }

  componentDidCatch(error: Error, errorInfo: React.ErrorInfo) {
    // You can also log the error to an error reporting service
    logger.error("Caught an error in ErrorBoundary", error, errorInfo);
    // In a real app, send to Sentry, Bugsnag, etc.
  }

  render() {
    if (this.state.hasError) {
      // You can render any custom fallback UI
      return (
        <div className="flex flex-col items-center justify-center min-h-screen bg-red-100 text-red-800 p-8">
          <h1 className="text-3xl font-bold mb-4">
            Something went wrong.
          </h1>
          <p className="mb-4">We're working to fix the issue. Please try refreshing the page.</p>
          {this.state.error && (
            <details className="w-full max-w-lg p-4 bg-red-200 rounded-md text-sm whitespace-pre-wrap">
              <summary className="cursor-pointer font-semibold">Error Details</summary>
              {this.state.error.message}
              <br />
              {this.state.error.stack}
            </details>
          )}
          <button
            onClick={() => window.location.reload()}
            className="mt-8 px-6 py-3 bg-red-600 text-white rounded-md hover:bg-red-700"
          >
            Refresh Application
          </button>
        </div>
      );
    }

    return this.props.children;
  }
}

