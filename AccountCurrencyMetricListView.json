/**
 * Mocks a GraphQL API call.
 * In a real application, this would use Apollo Client, Relay, or a similar library.
 */
export const fetchGraphQL = async <T, V>(
  query: string,
  variables?: V,
  delay: number = 700,
): Promise<T> => {
  logger.debug("Mock GraphQL request", { query, variables });
  await new Promise((resolve) => setTimeout(resolve, delay));

  // Simulate different responses based on query or variables
  if (query.includes("AccountCurrencyMetricListView")) {
    const { currency, first = 10, after } = variables as AccountCurrencyMetricQueryVariables;
    const startIndex = after ? parseInt(after, 10) : 0;

    const mockMetrics: AccountCurrencyMetricNode[] = Array.from(
      { length: 50 },
      (_, i) => {
        const id = startIndex + i;
        const currentCurrency =
          currency ||
          [CurrencyEnum.USD, CurrencyEnum.EUR, CurrencyEnum.GBP][i % 3];
        const rawAvailableBalance =
          25000000 + i * 100000 - Math.random() * 500000;
        const rawPriorDayBalance =
          rawAvailableBalance + (Math.random() - 0.5) * 200000;
        const rawLedgerVariance = rawAvailableBalance - rawPriorDayBalance;
        const rawUnreconciledAmount = Math.random() * 15000;
        const rawUnreconciledPercent = (rawUnreconciledAmount / rawAvailableBalance) * 100;

        return {
          typename: "AccountCurrencyMetric",
          currency: currentCurrency,
          prettyPriorDayBalance: formatCurrency(
            rawPriorDayBalance,
            currentCurrency,
          ),
          prettyAvailableBalance: formatCurrency(
            rawAvailableBalance,
            currentCurrency,
          ),
          ledgerVariance: formatCurrency(
            rawLedgerVariance,
            currentCurrency,
          ),
          highlightLedgerVariance: Math.abs(rawLedgerVariance) > 50000,
          unreconciledAmount: formatCurrency(
            rawUnreconciledAmount,
            currentCurrency,
          ),
          unreconciledPercent: formatPercent(rawUnreconciledPercent),
          path: `/accounts/${currentCurrency.toLowerCase()}/details/${id}`,
          rawAvailableBalance,
          rawPriorDayBalance,
          rawLedgerVariance,
          rawUnreconciledAmount,
          rawUnreconciledPercent,
          lastUpdated: new Date(Date.now() - i * 3600000).toISOString(), // Simulate varying update times
        };
      },
    ).filter((metric) => (currency ? metric.currency === currency : true));

    const edges = mockMetrics.slice(startIndex, startIndex + first).map(
      (node, index) => ({
        node,
        __typename: "AccountCurrencyMetricEdge",
      }),
    );

    const hasNextPage = startIndex + first < mockMetrics.length;
    const hasPreviousPage = startIndex > 0;
    const endCursor = hasNextPage ? String(startIndex + first) : null;
    const startCursor = hasPreviousPage ? String(startIndex - first) : null;

    return {
      accountCurrencyMetrics: {
        edges,
        pageInfo: {
          startCursor,
          endCursor,
          hasNextPage,
          hasPreviousPage,
          __typename: "PageInfo",
        },
        __typename: "AccountCurrencyMetricConnection",
      },
    } as unknown as T;
  }

  // Fallback for unknown queries
  logger.error("Unknown GraphQL query mocked", new Error("Query not handled"), { query, variables });
  throw new Error("Unknown GraphQL query");
};

