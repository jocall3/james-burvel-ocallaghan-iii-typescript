export enum CurrencyEnum {
  USD = "USD",
  EUR = "EUR",
  GBP = "GBP",
  JPY = "JPY",
  CAD = "CAD",
  AUD = "AUD",
  CHF = "CHF",
  CNY = "CNY",
  SGD = "SGD",
  HKD = "HKD",
}

export interface PageInfo {
  startCursor: string | null;
  endCursor: string | null;
  hasNextPage: boolean;
  hasPreviousPage: boolean;
  __typename?: "PageInfo";
}

export interface AccountCurrencyMetricNode {
  typename?: string; // Mapped from __typename
  currency: CurrencyEnum;
  prettyPriorDayBalance: string; // Formatted string, e.g., "$1,234.56"
  prettyAvailableBalance: string; // Formatted string
  ledgerVariance: string; // Formatted string, e.g., "-$100.00"
  highlightLedgerVariance: boolean;
  unreconciledAmount: string; // Formatted string
  unreconciledPercent: string; // Formatted string, e.g., "5.25%"
  path: string; // A unique identifier or path for drilling down
  rawAvailableBalance: number; // Added for calculations
  rawPriorDayBalance: number; // Added for calculations
  rawLedgerVariance: number; // Added for calculations
  rawUnreconciledAmount: number; // Added for calculations
  rawUnreconciledPercent: number; // Added for calculations
  lastUpdated: string; // ISO string for last update timestamp
}

export interface AccountCurrencyMetricEdge {
  node: AccountCurrencyMetricNode;
  __typename?: "AccountCurrencyMetricEdge";
}

export interface AccountCurrencyMetricConnection {
  edges: AccountCurrencyMetricEdge[];
  pageInfo: PageInfo;
  __typename?: "AccountCurrencyMetricConnection";
}

export interface AccountCurrencyMetricQueryVariables {
  currency?: CurrencyEnum;
  first?: number;
  after?: string;
  last?: number;
  before?: string;
}

export interface AccountCurrencyMetricQueryResponse {
  accountCurrencyMetrics: AccountCurrencyMetricConnection;
}

/**
