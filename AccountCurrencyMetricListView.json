  const { t } = useI18n();
  const { hasPermission } = useAuth();
  const { addNotification } = useNotification();
  const { triggerRefetch } = useDataRefetch();

  const handleReconcile = useCallback(
    async (node: AccountCurrencyMetricNode) => {
      if (!hasPermission("canReconcile")) {
        addNotification({
          message: "You don't have permission to reconcile.",
          type: "error",
        });
        return;
      }
      logger.info(`Initiating reconciliation for ${node.currency} at ${node.path}`);
      addNotification({
        message: `Reconciling ${node.currency} (${node.unreconciledAmount})...`,
        type: "info",
      });
      await auditService.logAction("RECONCILE_INITIATED", "user123", {
        currency: node.currency,
        path: node.path,
      });
      // Simulate an async reconciliation process
      await new Promise((resolve) => setTimeout(resolve, 2000));
      addNotification({
        message: `${node.currency} reconciliation simulated successfully.`,
        type: "success",
      });
      triggerRefetch(); // Trigger a global refetch after action
      logger.info(`Reconciliation completed for ${node.currency}`);
    },
    [addNotification, hasPermission, triggerRefetch],
  );

  const getSortIndicator = (field: keyof AccountCurrencyMetricNode) => {
    if (sortField === field) {
      return sortDirection === "asc" ? " ▲" : " ▼";
