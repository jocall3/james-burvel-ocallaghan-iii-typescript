  const context = useContext(I18nContext);
  if (!context) {
    throw new Error("useI18n must be used within an I18nProvider");
  }
  return context;
};

// Notification Context
interface Notification {
  id: string;
  message: string;
  type: "info" | "warning" | "error" | "success";
  timeout?: number;
}

interface NotificationContextType {
  addNotification: (notification: Omit<Notification, "id">) => void;
  removeNotification: (id: string) => void;
  notifications: Notification[];
}

const NotificationContext = createContext<NotificationContextType | undefined>(
  undefined,
);

export const NotificationProvider: React.FC<{ children: ReactNode }> = ({
  children,
}) => {
  const [notifications, setNotifications] = useState<Notification[]>([]);

  const addNotification = useCallback(
    (notification: Omit<Notification, "id">) => {
      const id = Date.now().toString();
      const newNotification = { ...notification, id };
      setNotifications((prev) => [...prev, newNotification]);
      if (notification.timeout !== 0) {
        setTimeout(
          () => removeNotification(id),
          notification.timeout || 5000,
        );
      }
      logger.debug("Notification added", newNotification);
    },
    [],
  );

  const removeNotification = useCallback((id: string) => {
    setNotifications((prev) => prev.filter((n) => n.id !== id));
    logger.debug("Notification removed", { id });
  }, []);

  const contextValue = useMemo(
    () => ({ notifications, addNotification, removeNotification }),
    [notifications, addNotification, removeNotification],
  );

  return (
    <NotificationContext.Provider value={contextValue}>
      {children}
    </NotificationContext.Provider>
  );
};

export const useNotification = () => {
  const context = useContext(NotificationContext);
  if (!context) {
    throw new Error(
      "useNotification must be used within a NotificationProvider",
    );
  }
  return context;
};

// Data Refetch Context (for triggering global data refreshes)
interface DataRefetchContextType {
  refetchKey: number;
  triggerRefetch: () => void;
}

const DataRefetchContext = createContext<DataRefetchContextType | undefined>(
  undefined,
);

export const DataRefetchProvider: React.FC<{ children: ReactNode }> = ({
  children,
}) => {
  const [refetchKey, setRefetchKey] = useState(0);

  const triggerRefetch = useCallback(() => {
    setRefetchKey((prev) => prev + 1);
    logger.info("Global data refetch triggered.");
  }, []);

  const contextValue = useMemo(
    () => ({ refetchKey, triggerRefetch }),
    [refetchKey, triggerRefetch],
  );

  return (
    <DataRefetchContext.Provider value={contextValue}>
      {children}
    </DataRefetchContext.Provider>
  );
};

export const useDataRefetch = () => {
  const context = useContext(DataRefetchContext);
  if (!context) {
    throw new Error("useDataRefetch must be used within a DataRefetchProvider");
  }
  return context;
};

/**
 * ============================================================================
 * Custom Hooks for Data Management
 * ============================================================================
 */

export interface AccountCurrencyMetricsState {
  data: AccountCurrencyMetricNode[];
  loading: boolean;
  error: string | null;
  pageInfo: PageInfo | null;
  fetchMetrics: (
    variables?: AccountCurrencyMetricQueryVariables,
  ) => Promise<void>;
  currentPage: number;
  goToPage: (page: number) => void;
  nextPage: () => void;
  previousPage: () => void;
  sortField: keyof AccountCurrencyMetricNode | null;
  sortDirection: "asc" | "desc" | null;
  setSort: (field: keyof AccountCurrencyMetricNode) => void;
  filterCurrency: CurrencyEnum | null;
  setFilterCurrency: (currency: CurrencyEnum | null) => void;
  filterVarianceThreshold: number | null;
  setFilterVarianceThreshold: (threshold: number | null) => void;
}

const itemsPerPage = configService.get("itemsPerPage");

export const useAccountCurrencyMetrics = (): AccountCurrencyMetricsState => {
  const { addNotification } = useNotification();
  const { refetchKey } = useDataRefetch();
  const [data, setData] = useState<AccountCurrencyMetricNode[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [pageInfo, setPageInfo] = useState<PageInfo | null>(null);
  const [currentPage, setCurrentPage] = useState(1);
  const [sortField, setSortField] =
    useState<keyof AccountCurrencyMetricNode | null>("currency");
  const [sortDirection, setSortDirection] = useState<"asc" | "desc" | null>(
    "asc",
  );
  const [filterCurrency, setFilterCurrency] = useState<CurrencyEnum | null>(
    null,
  );
  const [filterVarianceThreshold, setFilterVarianceThreshold] =
    useState<number | null>(null);

  const fetchMetrics = useCallback(
    async (variables?: AccountCurrencyMetricQueryVariables) => {
      setLoading(true);
      setError(null);
      try {
        const response = await fetchGraphQL<
          AccountCurrencyMetricQueryResponse,
          AccountCurrencyMetricQueryVariables
        >(
          `query AccountCurrencyMetricListView($currency: CurrencyEnum, $first: Int, $after: String, $last: Int, $before: String) {
            accountCurrencyMetrics(
              currency: $currency
              first: $first
              after: $after
              last: $last
              before: $before
            ) {
              ...AccountCurrencyMetricList
              __typename
            }
          }

          fragment AccountCurrencyMetricList on AccountCurrencyMetricConnection {
            edges {
              node {
                typename: __typename
                currency
                prettyPriorDayBalance
                prettyAvailableBalance
                ledgerVariance
                highlightLedgerVariance
                unreconciledAmount
                unreconciledPercent
                path
                # Raw values added for client-side sorting/filtering
                rawAvailableBalance
                rawPriorDayBalance
                rawLedgerVariance
                rawUnreconciledAmount
                rawUnreconciledPercent
                lastUpdated
              }
              __typename
            }
            pageInfo {
              startCursor
              endCursor
              hasNextPage
              hasPreviousPage
              __typename
            }
            __typename
          }
          `,
          variables,
        );
        setData(response.accountCurrencyMetrics.edges.map((edge) => edge.node));
        setPageInfo(response.accountCurrencyMetrics.pageInfo);
        logger.info("Account currency metrics fetched successfully.");
      } catch (err: any) {
        logger.error("Error fetching account metrics", err);
        setError(addNotification({ message: err.message || "Failed to fetch data.", type: "error" }).message);
      } finally {
        setLoading(false);
      }
    },
    [addNotification],
  );

  const refreshData = useCallback(() => {
    fetchMetrics({
      first: itemsPerPage,
      after: String((currentPage - 1) * itemsPerPage),
      currency: filterCurrency || undefined,
    });
  }, [currentPage, filterCurrency, fetchMetrics]);

  useEffect(() => {
    refreshData();
    const intervalId = setInterval(
      refreshData,
      configService.get("refreshIntervalSeconds") * 1000,
    ); // Auto-refresh
    return () => clearInterval(intervalId);
  }, [currentPage, filterCurrency, refetchKey, refreshData]); // Depend on refetchKey for explicit refresh

  const goToPage = useCallback(
    (page: number) => {
      const newCursor = String((page - 1) * itemsPerPage);
      if (pageInfo?.endCursor !== newCursor) {
        setCurrentPage(page);
        fetchMetrics({
          first: itemsPerPage,
          after: newCursor,
          currency: filterCurrency || undefined,
        });
      }
    },
    [fetchMetrics, filterCurrency, pageInfo?.endCursor],
  );

  const nextPage = useCallback(() => {
    if (pageInfo?.hasNextPage) {
      setCurrentPage((prev) => prev + 1);
      fetchMetrics({
        first: itemsPerPage,
        after: pageInfo.endCursor || undefined,
        currency: filterCurrency || undefined,
      });
    }
  }, [fetchMetrics, filterCurrency, pageInfo]);

  const previousPage = useCallback(() => {
    if (pageInfo?.hasPreviousPage) {
      setCurrentPage((prev) => prev - 1);
      fetchMetrics({
        last: itemsPerPage,
        before: pageInfo.startCursor || undefined,
        currency: filterCurrency || undefined,
      });
    }
  }, [fetchMetrics, filterCurrency, pageInfo]);

  const setSort = useCallback(
    (field: keyof AccountCurrencyMetricNode) => {
      setSortField((prevField) => {
        if (prevField === field) {
          setSortDirection((prevDir) =>
            prevDir === "asc" ? "desc" : "asc",
          );
        } else {
          setSortDirection("asc");
        }
        return field;
      });
    },
    [],
  );

  const sortedAndFilteredData = useMemo(() => {
    let filtered = data;

    // Apply currency filter
    if (filterCurrency) {
      filtered = filtered.filter((item) => item.currency === filterCurrency);
    }

    // Apply variance threshold filter
    if (filterVarianceThreshold !== null) {
      filtered = filtered.filter(
        (item) => Math.abs(item.rawLedgerVariance) >= filterVarianceThreshold,
      );
    }

    // Apply sorting
    if (sortField && sortDirection) {
      filtered = [...filtered].sort((a, b) => {
        const valA = a[sortField];
        const valB = b[sortField];

        let comparison = 0;
        if (typeof valA === "number" && typeof valB === "number") {
          comparison = valA - valB;
        } else if (typeof valA === "string" && typeof valB === "string") {
          comparison = valA.localeCompare(valB);
        } else if (typeof valA === "boolean" && typeof valB === "boolean") {
          comparison = (valA === valB ? 0 : valA ? 1 : -1);
        }

        return sortDirection === "asc" ? comparison : -comparison;
      });
    }
    return filtered;
  }, [data, filterCurrency, filterVarianceThreshold, sortField, sortDirection]);

  return {
    data: sortedAndFilteredData,
    loading,
    error,
    pageInfo,
    fetchMetrics: refreshData, // Expose refresh as main fetch
    currentPage,
    goToPage,
    nextPage,
    previousPage,
    sortField,
    sortDirection,
    setSort,
    filterCurrency,
    setFilterCurrency,
    filterVarianceThreshold,
    setFilterVarianceThreshold,
  };
};

