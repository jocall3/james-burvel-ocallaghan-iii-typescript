                <td style={styles.td}>Pending Approval</td>
                <td style={styles.td}><button style={{ ...styles.button, backgroundColor: '#6c757d', fontSize: '0.8em', padding: '6px 10px' }}>Cancel</button></td>
              </tr>
              <tr>
                <td style={styles.td}>2024-07-19</td>
                <td style={styles.td}>Jane Doe (Payroll)</td>
                <td style={styles.td}>{formatCurrencyDisplay(500000, 'EUR')}</td>
                <td style={styles.td}>Processing</td>
                <td style={styles.td}><button style={{ ...styles.button, backgroundColor: '#0055aa', fontSize: '0.8em', padding: '6px 10px' }}>View Status</button></td>
              </tr>
              <tr>
                <td colSpan={5} style={{ ...styles.td, textAlign: 'center' }}>No other pending payments.</td>
              </tr>
            </tbody>
          </table>
          <button style={{ ...styles.button, marginTop: '20px', width: '100%', backgroundColor: '#0055aa' }}>View All Pending Payments</button>
        </div>
      )}

      {activeTab === 'scheduled' && (
        <div style={styles.card}>
          <h2>Scheduled & Recurring Payments</h2>
          {scheduledPaymentsLoading && <LoadingSpinner />}
          {scheduledPaymentsError && <ErrorDisplay error={scheduledPaymentsError.message} />}
          {!scheduledPaymentsLoading && scheduledPayments.length === 0 && <p>No scheduled payments found.</p>}
          {!scheduledPaymentsLoading && scheduledPayments.length > 0 && (
            <table style={styles.table}>
              <thead>
                <tr>
                  <th style={styles.th}>From Account</th>
                  <th style={styles.th}>Beneficiary</th>
                  <th style={styles.th}>Amount</th>
                  <th style={styles.th}>Frequency</th>
                  <th style={styles.th}>Next Payment</th>
                  <th style={styles.th}>Status</th>
                  <th style={styles.th}>Actions</th>
                </tr>
              </thead>
              <tbody>
                {scheduledPayments.map(sp => {
                  const bene = beneficiaries.find(b => b.id === sp.beneficiaryId);
                  return (
                    <tr key={sp.id}>
                      <td style={styles.td}>{sp.fromAccountId}</td>
                      <td style={styles.td}>{bene?.name || 'N/A'}</td>
                      <td style={styles.td}>{formatCurrencyDisplay(sp.amountCents, sp.currency)}</td>
                      <td style={styles.td}>{sp.frequency}</td>
                      <td style={styles.td}>{new Date(sp.nextPaymentDate).toLocaleDateString()}</td>
                      <td style={styles.td}>{sp.status}</td>
                      <td style={styles.td}>
                        <button style={{ ...styles.button, backgroundColor: '#0055aa', fontSize: '0.7em', padding: '4px 8px', marginRight: '5px' }}>Edit</button>
                        <button style={{ ...styles.button, backgroundColor: '#dc3545', fontSize: '0.7em', padding: '4px 8px' }}>Cancel</button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
          <button style={{ ...styles.button, marginTop: '20px', backgroundColor: '#28a745' }}>Schedule New Payment</button>
        </div>
      )}

      {activeTab === 'beneficiaries' && (
        <div style={styles.card}>
          <h2>Manage Beneficiaries</h2>
          <form onSubmit={handleBeneficiarySubmit} style={{ display: 'grid', gap: '15px', maxWidth: '500px', marginBottom: '30px' }}>
            <h3>Add New Beneficiary</h3>
            <div>
              <label style={styles.label} htmlFor="newBeneName">Beneficiary Name:</label>
              <input id="newBeneName" type="text" style={{ ...styles.input, width: '100%' }} value={recipient} onChange={(e) => setRecipient(e.target.value)} placeholder="e.g., Company Name" required />
            </div>
            <div>
              <label style={styles.label} htmlFor="newBeneCurrency">Currency:</label>
              <select id="newBeneCurrency" style={{ ...styles.select, width: '100%' }} value={paymentCurrency} onChange={(e) => setPaymentCurrency(e.target.value as CurrencyEnum)} required>
                {ALL_CURRENCIES.map(c => <option key={c} value={c}>{c}</option>)}
              </select>
            </div>
            {/* More fields like Account Number, Bank Name, SWIFT/IBAN would be here */}
            <button type="submit" style={{ ...styles.button, backgroundColor: '#28a745' }}>Add Beneficiary</button>
          </form>

          <h3>Existing Beneficiaries</h3>
          {beneficiariesLoading && <LoadingSpinner />}
          {beneficiariesError && <ErrorDisplay error={beneficiariesError.message} />}
          {!beneficiariesLoading && beneficiaries.length === 0 && <p>No beneficiaries added yet.</p>}
          {!beneficiariesLoading && beneficiaries.length > 0 && (
            <table style={styles.table}>
              <thead>
                <tr>
                  <th style={styles.th}>Name</th>
                  <th style={styles.th}>Account # (Mock)</th>
                  <th style={styles.th}>Bank</th>
                  <th style={styles.th}>Currency</th>
                  <th style={styles.th}>Type</th>
                  <th style={styles.th}>Actions</th>
                </tr>
              </thead>
              <tbody>
                {beneficiaries.map(bene => (
                  <tr key={bene.id}>
                    <td style={styles.td}>{bene.name}</td>
                    <td style={styles.td}>{bene.accountNumber}</td>
                    <td style={styles.td}>{bene.bankName}</td>
                    <td style={styles.td}>{bene.currency}</td>
                    <td style={styles.td}>{bene.isInternational ? 'International' : 'Local'}</td>
                    <td style={styles.td}>
                      <button style={{ ...styles.button, backgroundColor: '#ffc107', color: '#333', fontSize: '0.7em', padding: '4px 8px', marginRight: '5px' }}>Edit</button>
                      <button style={{ ...styles.button, backgroundColor: '#dc3545', fontSize: '0.7em', padding: '4px 8px' }}>Delete</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      )}

      {activeTab === 'history' && (
        <div style={styles.card}>
          <h2>Full Payment History</h2>
          <TransactionTable accountId={'all'} currency={preferredCurrency} /> {/* Mock for all payments */}
          <button style={{ ...styles.button, marginTop: '15px', width: '100%', backgroundColor: '#0055aa' }}>View Advanced Payment Analytics</button>
        </div>
      )}
    </div>
  );
};

// Component: Reports Page
export const ReportsPage: React.FC = () => {
  const { user } = useContext(AuthContext);
  const { preferredCurrency, formatCurrencyDisplay } = useContext(CurrencyPreferenceContext);
  const [reportType, setReportType] = useState<ReportConfiguration['reportType']>('BALANCE_SHEET');
  const [startDate, setStartDate] = useState('2024-01-01');
  const [endDate, setEndDate] = useState(new Date().toISOString().split('T')[0]);
  const [reportCurrency, setReportCurrency] = useState<CurrencyEnum>('USD');
  const [frequency, setFrequency] = useState<ReportConfiguration['frequency']>('ONCE');
  const [exportFormat, setExportFormat] = useState<ReportConfiguration['exportFormat']>('PDF');
  const [includeAccounts, setIncludeAccounts] = useState<string[]>([]);
  const [isGenerating, setIsGenerating] = useState(false);
  const [generatedReport, setGeneratedReport] = useState<ReportConfiguration | null>(null);

  const { data: budgetData, loading: budgetLoading, error: budgetError } = useQuery<{ budgets: Budget[] }>(GET_BUDGETS_QUERY);
  const budgets = budgetData?.budgets || [];

  const { data: accountsData } = useQuery<{ accountCurrencyMetrics: AccountCurrencyMetricConnection }>(ACCOUNT_CURRENCY_METRICS_HOME_QUERY, {
    variables: { first: 100 },
  });
  const allAccounts = useMemo(() => {
    const uniqueAccountIds = Array.from(new Set(accountsData?.accountCurrencyMetrics.edges.map(e => e.node.accountId) || []));
    return uniqueAccountIds.map(id => {
      const firstNode = accountsData?.accountCurrencyMetrics.edges.find(e => e.node.accountId === id)?.node;
      return {
        id: id,
        name: firstNode?.accountName || `Account ${id.split('-')[1]}`,
        currency: firstNode?.currency || 'USD',
      };
    });
  }, [accountsData]);

  const handleGenerateReport = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsGenerating(true);
    setGeneratedReport(null);
    await new Promise(resolve => setTimeout(resolve, 2500)); // Simulate generation time
    const newReport: ReportConfiguration = {
      id: generateRandomId(),
      name: `${reportType} Report`,
      reportType,
      currency: reportCurrency,
      startDate,
      endDate,
      frequency,
      includeAccounts,
      generatedAt: new Date().toISOString(),
      exportFormat,
      scheduledBy: user?.id || 'unknown',
      status: 'COMPLETED',
    };
    setGeneratedReport(newReport);
    setIsGenerating(false);
    alert(`Report "${newReport.name}" generated successfully!`);
  };

  const handleAccountSelection = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const options = Array.from(e.target.selectedOptions).map(o => o.value);
    setIncludeAccounts(options);
  };

  return (
    <div style={styles.container}>
      <h1 style={{ marginBottom: '20px', color: '#003366' }}>Financial Reports & Analytics</h1>

      <div style={styles.card}>
        <h2>Generate Custom Report</h2>
        <form onSubmit={handleGenerateReport} style={{ display: 'grid', gap: '15px', maxWidth: '600px' }}>
          <div>
            <label style={styles.label} htmlFor="reportType">Report Type:</label>
            <select id="reportType" style={{ ...styles.select, width: '100%' }} value={reportType} onChange={(e) => setReportType(e.target.value as ReportConfiguration['reportType'])} aria-label="Select report type">
              <option value="BALANCE_SHEET">Balance Sheet</option>
              <option value="INCOME_STATEMENT">Income Statement</option>
              <option value="CASH_FLOW">Cash Flow Statement</option>
              <option value="LEDGER_SUMMARY">General Ledger Summary</option>
              <option value="TRANSACTION_DETAIL">Transaction Detail Report</option>
              <option value="BUDGET_PERFORMANCE">Budget Performance Report</option>
              <option value="COMPLIANCE_REVIEW">Compliance Review Report</option>
            </select>
          </div>
          <div style={{ display: 'flex', gap: '10px' }}>
            <div style={{ flex: 1 }}>
              <label style={styles.label} htmlFor="startDate">Start Date:</label>
              <input id="startDate" type="date" style={{ ...styles.input, width: '100%' }} value={startDate} onChange={(e) => setStartDate(e.target.value)} aria-label="Report start date" />
            </div>
            <div style={{ flex: 1 }}>
              <label style={styles.label} htmlFor="endDate">End Date:</label>
              <input id="endDate" type="date" style={{ ...styles.input, width: '100%' }} value={endDate} onChange={(e) => setEndDate(e.target.value)} aria-label="Report end date" />
            </div>
          </div>
          <div>
            <label style={styles.label} htmlFor="reportCurrency">Report Currency:</label>
            <select id="reportCurrency" style={{ ...styles.select, width: '100%' }} value={reportCurrency} onChange={(e) => setReportCurrency(e.target.value as CurrencyEnum)} aria-label="Report currency">
              {ALL_CURRENCIES.map(c => <option key={c} value={c}>{c}</option>)}
            </select>
          </div>
          <div>
            <label style={styles.label} htmlFor="includeAccounts">Include Accounts:</label>
            <select id="includeAccounts" multiple style={{ ...styles.select, width: '100%', minHeight: '80px' }} value={includeAccounts} onChange={handleAccountSelection} aria-label="Select accounts to include">
              {allAccounts.map(account => (
                <option key={account.id} value={account.id}>{account.name} ({account.currency})</option>
              ))}
            </select>
            <p style={{ fontSize: '0.8em', color: 'gray', marginTop: '5px' }}>Hold Ctrl/Cmd to select multiple.</p>
          </div>
          <div>
            <label style={styles.label} htmlFor="frequency">Schedule Report:</label>
            <select id="frequency" style={{ ...styles.select, width: '100%' }} value={frequency} onChange={(e) => setFrequency(e.target.value as ReportConfiguration['frequency'])} aria-label="Report frequency">
              <option value="ONCE">Generate Once</option>
              <option value="DAILY">Daily</option>
              <option value="WEEKLY">Weekly</option>
              <option value="MONTHLY">Monthly</option>
              <option value="QUARTERLY">Quarterly</option>
              <option value="ANNUAL">Annually</option>
            </select>
          </div>
          <div>
            <label style={styles.label} htmlFor="exportFormat">Export Format:</label>
            <select id="exportFormat" style={{ ...styles.select, width: '100%' }} value={exportFormat} onChange={(e) => setExportFormat(e.target.value as ReportConfiguration['exportFormat'])} aria-label="Report export format">
              <option value="PDF">PDF</option>
              <option value="CSV">CSV</option>
              <option value="XLSX">Excel (XLSX)</option>
              <option value="JSON">JSON (for API integration)</option>
            </select>
          </div>
          <button type="submit" style={styles.button} disabled={isGenerating}>
            {isGenerating ? 'Generating...' : 'Generate Report'}
          </button>
        </form>

        {generatedReport && (
          <div style={{ marginTop: '20px', padding: '15px', border: '1px solid #28a745', borderRadius: '4px', backgroundColor: '#e6ffe6' }} role="status">
            <p style={styles.successText}>Report generated successfully!</p>
            <p><strong>Report Name:</strong> {generatedReport.name}</p>
            <p><strong>Period:</strong> {generatedReport.startDate} to {generatedReport.endDate}</p>
            <p><strong>Currency:</strong> {generatedReport.currency}</p>
            <p><strong>Accounts:</strong> {generatedReport.includeAccounts.length > 0 ? generatedReport.includeAccounts.join(', ') : 'All'}</p>
            <div style={{ marginTop: '10px' }}>
              <button style={{ ...styles.button, backgroundColor: '#0055aa', marginRight: '10px' }}>View Report ({generatedReport.exportFormat})</button>
              <button style={{ ...styles.button, backgroundColor: '#6c757d' }}>Download {generatedReport.exportFormat}</button>
            </div>
          </div>
        )}
      </div>

      <div style={{ ...styles.card, marginTop: '30px' }}>
        <h2>Budget Overview</h2>
        {budgetLoading && <LoadingSpinner />}
        {budgetError && <ErrorDisplay error={budgetError.message} />}
        {budgets.length === 0 && !budgetLoading && <p>No active budgets found.</p>}
        {!budgetLoading && budgets.length > 0 && (
          <table style={styles.table}>
            <thead>
              <tr>
                <th style={styles.th}>Budget Name</th>
                <th style={styles.th}>Period</th>
                <th style={styles.th}>Currency</th>
                <th style={styles.th}>Allocated ({preferredCurrency})</th>
                <th style={styles.th}>Used ({preferredCurrency})</th>
                <th style={styles.th}>Remaining ({preferredCurrency})</th>
                <th style={styles.th}>Progress</th>
                <th style={styles.th}>Status</th>
                <th style={styles.th}>Actions</th>
              </tr>
            </thead>
            <tbody>
              {budgets.map(budget => {
                const totalAllocated = getConvertedAmount(budget.totalAllocatedCents, budget.currency, preferredCurrency);
                const totalUsed = getConvertedAmount(budget.totalUsedCents, budget.currency, preferredCurrency);
                const remaining = totalAllocated - totalUsed;
                const progress = totalAllocated > 0 ? (totalUsed / totalAllocated) * 100 : 0;
                const progressColor = progress > budget.alertThresholdPercent ? 'red' : (progress > (budget.alertThresholdPercent * 0.75) ? 'orange' : 'green');
                return (
                  <tr key={budget.id}>
                    <td style={styles.td}>{budget.name}</td>
                    <td style={styles.td}>{budget.period}</td>
                    <td style={styles.td}>{budget.currency}</td>
                    <td style={styles.td}>{formatCurrencyDisplay(totalAllocated)}</td>
                    <td style={styles.td}>{formatCurrencyDisplay(totalUsed)}</td>
                    <td style={{ ...styles.td, color: remaining < 0 ? 'red' : 'inherit' }}>{formatCurrencyDisplay(remaining)}</td>
                    <td style={styles.td}>
                      <div style={{ height: '8px', backgroundColor: '#e0e0e0', borderRadius: '4px' }}>
                        <div style={{ width: `${Math.min(100, progress)}%`, height: '100%', backgroundColor: progressColor, borderRadius: '4px' }}></div>
                      </div>
                      <span style={{ fontSize: '0.8em', color: 'gray' }}>{progress.toFixed(1)}%</span>
                    </td>
                    <td style={styles.td}>{budget.status}</td>
                    <td style={styles.td}>
                      <button style={{ ...styles.button, backgroundColor: '#0055aa', fontSize: '0.7em', padding: '4px 8px' }}>View</button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )}
        <button style={{ ...styles.button, marginTop: '20px', backgroundColor: '#0055aa' }}>Manage Budgets</button>
      </div>

      <div style={{ ...styles.card, marginTop: '30px' }}>
        <h2>Pre-defined Reports & Templates</h2>
        <p>Quickly generate standard reports or customize templates for your specific needs.</p>
        <ul style={{ listStyleType: 'none', padding: 0, marginTop: '15px' }}>
          <li style={{ borderBottom: '1px solid #eee', padding: '8px 0' }}>
            <Link to="#" style={{ color: '#0055aa' }}>Monthly Balance Sheet (PDF)</Link>
            <span style={{ fontSize: '0.8em', color: 'gray', marginLeft: '10px' }}> - Standard template for current month.</span>
            <button style={{ ...styles.button, backgroundColor: '#0055aa', fontSize: '0.7em', padding: '4px 8px', marginLeft: '10px' }}>Generate</button>
          </li>
          <li style={{ borderBottom: '1px solid #eee', padding: '8px 0' }}>
            <Link to="#" style={{ color: '#0055aa' }}>Quarterly Income Statement (XLSX)</Link>
            <span style={{ fontSize: '0.8em', color: 'gray', marginLeft: '10px' }}> - Customizable for last fiscal quarter.</span>
            <button style={{ ...styles.button, backgroundColor: '#0055aa', fontSize: '0.7em', padding: '4px 8px', marginLeft: '10px' }}>Generate</button>
          </li>
          <li style={{ borderBottom: '1px solid #eee', padding: '8px 0' }}>
            <Link to="#" style={{ color: '#0055aa' }}>Annual Cash Flow Projection (PDF)</Link>
            <span style={{ fontSize: '0.8em', color: 'gray', marginLeft: '10px' }}> - Based on historical data and budgets.</span>
            <button style={{ ...styles.button, backgroundColor: '#0055aa', fontSize: '0.7em', padding: '4px 8px', marginLeft: '10px' }}>Generate</button>
          </li>
          <li style={{ borderBottom: '1px solid #eee', padding: '8px 0' }}>
            <Link to="#" style={{ color: '#0055aa' }}>Outstanding Payments Summary (CSV)</Link>
            <span style={{ fontSize: '0.8em', color: 'gray', marginLeft: '10px' }}> - All pending payments and transfers.</span>
            <button style={{ ...styles.button, backgroundColor: '#0055aa', fontSize: '0.7em', padding: '4px 8px', marginLeft: '10px' }}>Generate</button>
          </li>
        </ul>
        <button style={{ ...styles.button, marginTop: '20px', backgroundColor: '#0055aa' }}>View All Templates</button>
      </div>

      <div style={{ ...styles.card, marginTop: '30px' }}>
        <h2>Advanced Analytics & Forecasting Tools</h2>
        <p>Utilize advanced models to predict cash flow, identify trends, detect anomalies, and optimize your financial strategy.</p>
        <p style={{ fontSize: '0.9em', color: 'gray', marginTop: '10px' }}>
          Our AI-powered engine processes millions of data points to provide actionable insights, including:
        </p>
        <ul style={{ fontSize: '0.9em', color: '#555' }}>
          <li>Liquidity Risk Assessment</li>
          <li>Working Capital Optimization</li>
          <li>Fraud Detection Patterns</li>
          <li>Scenario Planning Simulators</li>
        </ul>
        <button style={{ ...styles.button, backgroundColor: '#0055aa' }}>Access Analytics Portal</button>
      </div>
    </div>
  );
};

// Component: Settings Page
export const SettingsPage: React.FC = () => {
  const { user, updateUserProfile } = useContext(AuthContext);
  const { preferredCurrency, setPreferredCurrency } = useContext(CurrencyPreferenceContext);
  const [name, setName] = useState(user?.name || '');
  const [email, setEmail] = useState(user?.email || '');
  const [notificationsEnabled, setNotificationsEnabled] = useState(user?.notificationsEnabled || false);
  const [twoFactorEnabled, setTwoFactorEnabled] = useState(user?.twoFactorEnabled || false);
  const [themePreference, setThemePreference] = useState(user?.themePreference || 'light');
  const [message, setMessage] = useState<{ type: 'success' | 'error', text: string } | null>(null);

  const handleProfileUpdate = async (e: React.FormEvent) => {
    e.preventDefault();
    setMessage(null);
    try {
      await new Promise(resolve => setTimeout(resolve, 1500)); // Simulate API call
      updateUserProfile({ name, email, notificationsEnabled, twoFactorEnabled, themePreference, preferredCurrency });
      setMessage({ type: 'success', text: 'Profile updated successfully!' });
    } catch (err) {
      setMessage({ type: 'error', text: 'Failed to update profile. Please try again.' });
    }
  };

  const handleCurrencyChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    setPreferredCurrency(e.target.value as CurrencyEnum);
  };

  return (
    <div style={styles.container}>
      <h1 style={{ marginBottom: '20px', color: '#003366' }}>User Settings & Preferences</h1>

      <div style={styles.card}>
        <h2>Personal Information</h2>
        <form onSubmit={handleProfileUpdate} style={{ display: 'grid', gap: '15px', maxWidth: '500px' }}>
          <div>
            <label style={styles.label} htmlFor="name">Full Name:</label>
            <input id="name" type="text" style={{ ...styles.input, width: '100%' }} value={name} onChange={(e) => setName(e.target.value)} required aria-label="Full Name" />
          </div>
          <div>
            <label style={styles.label} htmlFor="email">Email Address:</label>
            <input id="email" type="email" style={{ ...styles.input, width: '100%' }} value={email} onChange={(e) => setEmail(e.target.value)} required aria-label="Email Address" />
          </div>
          <button type="submit" style={styles.button}>Update Profile</button>
          {message && message.type === 'success' && <p style={styles.successText} aria-live="polite">{message.text}</p>}
          {message && message.type === 'error' && <p style={styles.errorText} aria-live="polite">{message.text}</p>}
        </form>
      </div>

      <div style={{ ...styles.card, marginTop: '30px' }}>
        <h2>Currency & Display Preferences</h2>
        <div style={{ display: 'grid', gap: '15px', maxWidth: '500px' }}>
          <div>
            <label style={styles.label} htmlFor="preferredCurrency">Preferred Display Currency:</label>
            <select
              id="preferredCurrency"
              style={{ ...styles.select, width: '100%' }}
              value={preferredCurrency}
              onChange={handleCurrencyChange}
              aria-label="Preferred Display Currency"
            >
              {ALL_CURRENCIES.map(c => (
                <option key={c} value={c}>{c}</option>
              ))}
            </select>
          </div>
          <div>
            <label style={styles.label} htmlFor="themePreference">Theme:</label>
            <select
              id="themePreference"
              style={{ ...styles.select, width: '100%' }}
              value={themePreference}
              onChange={(e) => setThemePreference(e.target.value as 'light' | 'dark')}
              aria-label="Theme Preference"
            >
              <option value="light">Light</option>
              <option value="dark">Dark (Coming Soon)</option>
            </select>
          </div>
          <button onClick={handleProfileUpdate} style={styles.button}>Save Display Preferences</button>
        </div>
      </div>

      <div style={{ ...styles.card, marginTop: '30px' }}>
        <h2>Security & Notifications</h2>
        <div style={{ display: 'grid', gap: '15px', maxWidth: '500px' }}>
          <div style={{ display: 'flex', alignItems: 'center' }}>
            <input
              type="checkbox"
              id="notificationsEnabled"
              checked={notificationsEnabled}
              onChange={(e) => setNotificationsEnabled(e.target.checked)}
              style={{ marginRight: '10px' }}
              aria-label="Enable Email Notifications"
            />
            <label htmlFor="notificationsEnabled">Enable Email Notifications</label>
          </div>
          <div style={{ display: 'flex', alignItems: 'center' }}>
            <input
              type="checkbox"
              id="twoFactorEnabled"
              checked={twoFactorEnabled}
              onChange={(e) => setTwoFactorEnabled(e.target.checked)}
              style={{ marginRight: '10px' }}
              aria-label="Enable Two-Factor Authentication"
            />
            <label htmlFor="twoFactorEnabled">Enable Two-Factor Authentication</label>
          </div>
          <button onClick={handleProfileUpdate} style={{ ...styles.button, backgroundColor: '#0055aa' }}>Update Security Settings</button>
        </div>
      </div>

      <div style={{ ...styles.card, marginTop: '30px' }}>
        <h2>Connected Devices & Sessions</h2>
        <p style={{ fontSize: '0.9em', color: 'gray' }}>Review and manage active sessions on your account.</p>
        <ul style={{ listStyleType: 'none', padding: 0, marginTop: '15px' }}>
          <li style={{ borderBottom: '1px solid #eee', padding: '8px 0', fontSize: '0.9em' }}>
            <strong>Current Session:</strong> Desktop, Chrome, New York, USA (IP: 192.168.1.100) - Active
          </li>
          <li style={{ borderBottom: '1px solid #eee', padding: '8px 0', fontSize: '0.9em' }}>
            <strong>Mobile Session:</strong> iPhone, Safari, Los Angeles, USA (Last Active: 2024-07-21 03:15 PM)
            <button style={{ ...styles.button, backgroundColor: '#dc3545', fontSize: '0.7em', padding: '4px 8px', marginLeft: '10px' }}>End Session</button>
          </li>
        </ul>
        <button style={{ ...styles.button, backgroundColor: '#0055aa', marginTop: '15px' }}>View All Sessions</button>
      </div>

      <div style={{ ...styles.card, marginTop: '30px' }}>
        <h2>Audit Log</h2>
        <p style={{ fontSize: '0.9em', color: 'gray' }}>Review your recent activities and security events.</p>
        <button style={{ ...styles.button, backgroundColor: '#6c757d' }}>View Full Audit Log</button>
        <ul style={{ listStyleType: 'none', padding: 0, marginTop: '15px' }}>
          <li style={{ borderBottom: '1px solid #eee', padding: '8px 0', fontSize: '0.9em' }}>
            <strong>2024-07-22 10:30 AM:</strong> Login successful (IP: 192.168.1.100)
          </li>
          <li style={{ borderBottom: '1px solid #eee', padding: '8px 0', fontSize: '0.9em' }}>
            <strong>2024-07-21 03:15 PM:</strong> Viewed Account Details for USD-123
          </li>
          <li style={{ borderBottom: '1px solid #eee', padding: '8px 0', fontSize: '0.9em' }}>
            <strong>2024-07-21 09:00 AM:</strong> Initiated Payment EUR-456 (Pending Approval)
          </li>
        </ul>
      </div>
    </div>
  );
};


