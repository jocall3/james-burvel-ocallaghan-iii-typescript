          </div>
          <div style={{ marginTop: '30px' }}>
            <h3>International Payments</h3>
            <p>Initiate SWIFT/IBAN payments to international beneficiaries with real-time exchange rates.</p>
            <button style={{ ...styles.button, backgroundColor: '#0055aa' }}>Go to International Payments</button>
          </div>
        </div>
      )}

      {activeTab === 'pending' && (
        <div style={styles.card}>
          <h2>Pending Payments & Approvals</h2>
          {user?.roles.includes('PAYMENT_APPROVER') ? (
            <div style={{ marginBottom: '20px' }}>
              <p style={mockPendingApprovals > 0 ? styles.warningText : styles.successText}>You have {mockPendingApprovals} payments awaiting your approval.</p>
