// --- GraphQL Query Definitions (from original JSON and expanded) ---

// Define fragments separately for reusability
export const ACCOUNT_CURRENCY_METRIC_LIST_FRAGMENT = gql`
  fragment AccountCurrencyMetricList on AccountCurrencyMetricConnection {
    edges {
      node {
        typename: __typename
        id
        accountId
        accountName
        currency
        priorDayBalanceCents
        availableBalanceCents
        prettyPriorDayBalance
        prettyAvailableBalance
        ledgerVarianceCents
        highlightLedgerVariance
        unreconciledAmountCents
        unreconciledPercent
        path
        lastUpdated
        potentialOverdraftRisk
        complianceStatus
        riskScore
        budgetAllocatedCents
        budgetUsedCents
        projectedBalanceCents
        associatedAccounts {
          id
          name
          type
          currentBalanceCents
          currency
          relationshipType
        }
        spendingCategories {
          category
          amountCents
          percentOfTotal
        }
        transactionCountLast30Days
        averageDailyBalanceCents
        netCashFlowLast30DaysCents
        pendingDepositsCents
        pendingWithdrawalsCents
        holdsCents
        lastStatementBalanceCents
        creditLimitCents
        interestRatePercent
        feesAndChargesLast30DaysCents
      }
      __typename
    }
    pageInfo {
      startCursor
      endCursor
      hasNextPage
      hasPreviousPage
      __typename
    }
    __typename
