// --- Global Type Definitions (Extracted from JSON and expanded for commercial application capability) ---

/**
 * Enumeration for supported currencies.
 * Expanded to include more real-world currencies.
 */
export type CurrencyEnum = 'USD' | 'EUR' | 'GBP' | 'JPY' | 'AUD' | 'CAD' | 'CHF' | 'CNY' | 'SEK' | 'NZD' | 'MXN' | 'SGD' | 'HKD' | 'INR' | 'BRL';

/**
 * Interface for the detailed information of an account currency metric.
 * This represents a specific currency view for a bank account.
 * Extensively expanded to cover many aspects of a commercial banking account.
 */
export interface AccountCurrencyMetricNode {
  typename: string; // __typename from GraphQL
  id: string; // Unique identifier for this currency-specific account view
  accountId: string; // The underlying primary account ID (e.g., 'ACC-001')
  accountName: string; // User-friendly name of the account (e.g., 'Main Operating Account')
  currency: CurrencyEnum;
  priorDayBalanceCents: number; // Balance at the end of the previous business day, in cents for precision
  availableBalanceCents: number; // Current available balance, considering pending transactions, in cents
  prettyPriorDayBalance: string; // Formatted string for display
  prettyAvailableBalance: string; // Formatted string for display
  ledgerVarianceCents: number; // Difference between ledger and available balance, in cents
  highlightLedgerVariance: boolean; // Flag to highlight significant variance
  unreconciledAmountCents: number; // Total amount of unreconciled items, in cents
  unreconciledPercent: number; // Percentage of available balance that is unreconciled (0-100%)
  path: string; // Internal path for deep linking (e.g., /accounts/details/USD/ACC-001)
  lastUpdated: string; // ISO string of when these metrics were last refreshed
  transactionsLast24H: Transaction[]; // A snapshot of recent transactions
  potentialOverdraftRisk: boolean; // Indicates if the account is at risk of overdraft
  complianceStatus: 'GREEN' | 'YELLOW' | 'RED' | 'REVIEW'; // Compliance health of the account
  riskScore: number; // Calculated risk score (e.g., 0-100) based on various factors
  budgetAllocatedCents: number; // Total budget allocated for this account/currency, in cents
  budgetUsedCents: number; // Total budget used for this account/currency, in cents
  projectedBalanceCents: number; // Future balance projection based on known upcoming transactions, in cents
  associatedAccounts: { // Linked or subsidiary accounts relevant to this metric
    id: string;
    name: string;
    type: string; // e.g., 'Checking', 'Savings', 'Investment', 'Loan'
    currentBalanceCents: number;
    currency: CurrencyEnum;
    relationshipType: 'PARENT' | 'CHILD' | 'RELATED';
  }[];
  spendingCategories: { // Breakdown of spending by categories
    category: string;
    amountCents: number;
    percentOfTotal: number;
  }[];
  transactionCountLast30Days: number; // Number of transactions in the last 30 days
  averageDailyBalanceCents: number; // Average daily balance over a period, in cents
  netCashFlowLast30DaysCents: number; // Net inflow/outflow over the last 30 days, in cents
  creditLimitCents?: number; // Applicable for credit facilities, in cents
  interestRatePercent?: number; // For interest-bearing accounts or loans
  feesAndChargesLast30DaysCents: number; // Total fees incurred in the last 30 days, in cents
  monthlyStatements?: { // List of available monthly statements
    id: string;
    period: string; // e.g., "JUL-2024"
    downloadUrl: string;
    status: 'AVAILABLE' | 'GENERATING' | 'ERROR';
  }[];
  authorizedUsers?: { // Users authorized to access this specific account metric
    userId: string;
    userName: string;
    permissions: string[]; // e.g., ['VIEW', 'TRANSACT', 'APPROVE']
  }[];
  pendingDepositsCents: number; // Sum of pending deposits
  pendingWithdrawalsCents: number; // Sum of pending withdrawals
  holdsCents: number; // Amount currently on hold, in cents
  lastStatementBalanceCents: number; // Balance from the last official statement
}

/**
 * Interface for an edge in a paginated connection of AccountCurrencyMetrics.
 */
export interface AccountCurrencyMetricEdge {
  node: AccountCurrencyMetricNode;
  typename: string; // __typename
}

/**
 * Interface for pagination information.
 */
export interface PageInfo {
  startCursor: string | null;
  endCursor: string | null;
  hasNextPage: boolean;
  hasPreviousPage: boolean;
  typename: string; // __typename
}

/**
 * Interface for the connection of AccountCurrencyMetrics, including edges and page info.
 */
export interface AccountCurrencyMetricConnection {
  edges: AccountCurrencyMetricEdge[];
  pageInfo: PageInfo;
  typename: string; // __typename
}

/**
 * Interface for a user profile in the banking application.
 * Extended with more banking-specific roles and preferences.
 */
export interface UserProfile {
  id: string;
  name: string;
  email: string;
  roles: ('ADMIN' | 'ACCOUNT_MANAGER' | 'VIEWER' | 'PAYMENT_APPROVER' | 'REPORT_ANALYST')[]; // Expanded roles
  preferredCurrency: CurrencyEnum;
  themePreference: 'light' | 'dark';
  notificationsEnabled: boolean;
  twoFactorEnabled: boolean;
  lastLogin: string; // ISO string
  branchId: string; // Associated bank branch
  securityLevel: 'LOW' | 'MEDIUM' | 'HIGH'; // Security level classification
  customDashboardLayout: string; // JSON string or ID of a custom layout
}

/**
 * Interface for a financial transaction.
 * Expanded with more real-world transaction details.
 */
export interface Transaction {
  id: string;
  accountId: string; // To link to an account currency metric
  date: string; // ISO string
  effectiveDate: string; // When the transaction actually impacts balance
  description: string;
  amountCents: number;
  currency: CurrencyEnum;
  type: 'DEBIT' | 'CREDIT' | 'TRANSFER' | 'FEE' | 'INTEREST'; // Expanded types
  status: 'PENDING' | 'CLEARED' | 'REVERSED' | 'FAILED' | 'VOIDED'; // Expanded statuses
  category: string; // e.g., 'Payroll', 'Supplies', 'Rent', 'Sales', 'Utilities', 'Software', 'Investments'
  subCategory?: string; // e.g., 'Office Supplies', 'Software Subscriptions'
  referenceNumber: string;
  counterparty: string; // Who the transaction is with
  counterpartyAccount?: string; // Counterparty bank account info
  isReconciled: boolean;
  isFlagged: boolean; // For manual review/suspicious activity
  attachmentUrl?: string; // URL to an attached invoice or receipt
  notes?: string; // User-added notes
}

/**
 * Interface for a budget definition.
 * Expanded for more robust budget tracking.
 */
export interface Budget {
  id: string;
  name: string;
  currency: CurrencyEnum;
  period: 'MONTHLY' | 'QUARTERLY' | 'ANNUAL' | 'CUSTOM';
  startDate: string; // ISO string
  endDate: string; // ISO string
  totalAllocatedCents: number;
  totalUsedCents: number;
  categories: {
    name: string;
    allocatedCents: number;
    usedCents: number;
    alertThresholdPercent: number; // Category-specific alert threshold
  }[];
  alertThresholdPercent: number; // Global budget alert threshold
  status: 'ACTIVE' | 'ARCHIVED' | 'EXPIRED' | 'DRAFT';
  associatedAccountIds: string[]; // Which accounts this budget applies to
  recurrence: 'NONE' | 'MONTHLY' | 'ANNUAL';
}

/**
 * Interface for an alert notification.
 * Expanded for more types and details.
 */
export interface AlertNotification {
  id: string;
  type: 'INFO' | 'WARNING' | 'CRITICAL' | 'SECURITY';
  message: string;
  timestamp: string; // ISO string
  isRead: boolean;
  accountId?: string; // Optional: Link to a specific account
  relatedMetric?: keyof AccountCurrencyMetricNode; // Optional: Link to a specific metric
  actionRequired: boolean; // Does this alert require user action?
  severity: 'LOW' | 'MEDIUM' | 'HIGH' | 'URGENT';
  link?: string; // A link to take action or view more details
}

/**
 * Interface for a generated or configured report.
 * Expanded with more report generation parameters.
 */
export interface ReportConfiguration {
  id: string;
  name: string;
  reportType: 'BALANCE_SHEET' | 'INCOME_STATEMENT' | 'CASH_FLOW' | 'LEDGER_SUMMARY' | 'TRANSACTION_DETAIL' | 'BUDGET_PERFORMANCE' | 'COMPLIANCE_REVIEW';
