              <input id="amount" type="number" step="0.01" style={{ ...styles.input, width: 'calc(100% - 80px)', display: 'inline-block' }} value={paymentAmount} onChange={(e) => setPaymentAmount(e.target.value)} placeholder="e.g., 123.45" required aria-label="Payment Amount" />
              <select style={{ ...styles.select, width: '70px', display: 'inline-block', marginLeft: '5px' }} value={paymentCurrency} onChange={(e) => setPaymentCurrency(e.target.value as CurrencyEnum)} aria-label="Payment Currency">
