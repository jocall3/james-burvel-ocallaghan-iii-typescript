// --- Apollo Client Setup ---
// In a real app, this would point to a real GraphQL endpoint.
// For this demo, we'll use a mock `execute` function for `ApolloLink`.
const MOCK_GRAPHQL_ENDPOINT = 'http://localhost:4000/graphql';

const mockLink = new ApolloLink((operation) => {
  const { operationName, variables } = operation;

  return new Promise((resolve) => {
    // Simulate network delay
    setTimeout(() => {
      let result: any = null;
      if (operationName === 'AccountCurrencyMetricsHome') {
        const { currency } = variables as { currency?: CurrencyEnum };
        const mockData = generateMockAccountCurrencyMetrics(10, currency);
        result = {
          data: {
            accountCurrencyMetrics: mockData,
          },
        };
      } else if (operationName === 'GetAccountDetails') {
        const { accountId, currency } = variables as { accountId: string, currency: CurrencyEnum };
        const allMockMetrics = generateMockAccountCurrencyMetrics(10);
        const account = allMockMetrics.edges.find(e => e.node.accountId === accountId && e.node.currency === currency)?.node;
        const accountTransactions = mockTransactions.filter(t => t.accountId === accountId && t.currency === currency);

        if (account) {
          result = {
            data: {
              accountDetails: {
                ...account,
                transactions: accountTransactions.slice(0, 50), // Return a subset for initial load
                recentActivity: accountTransactions.slice(0, 10).map(t => ({
                  ...t, // spreading here ensures all sub-fields of transaction are available
                  description: `${t.type === 'DEBIT' ? 'Payment to' : (t.type === 'CREDIT' ? 'Deposit from' : 'Transfer to')} ${t.counterparty}`,
                })),
              }
            }
          };
        } else {
          result = { errors: [{ message: `Account ${accountId} not found` }] };
        }
      } else if (operationName === 'GetTransactions') {
        const { accountId, currency, first, after, search, category, status, startDate, endDate } = variables as { accountId: string, currency: CurrencyEnum, first?: number, after?: string, search?: string, category?: string, status?: Transaction['status'], startDate?: string, endDate?: string };
        let filteredTransactions = mockTransactions.filter(t => t.accountId === accountId && t.currency === currency);

        if (search) {
          const lowerSearch = search.toLowerCase();
          filteredTransactions = filteredTransactions.filter(t =>
            t.description.toLowerCase().includes(lowerSearch) ||
            t.counterparty.toLowerCase().includes(lowerSearch) ||
            t.referenceNumber.toLowerCase().includes(lowerSearch)
          );
        }
        if (category) filteredTransactions = filteredTransactions.filter(t => t.category === category);
        if (status) filteredTransactions = filteredTransactions.filter(t => t.status === status);
        if (startDate) filteredTransactions = filteredTransactions.filter(t => new Date(t.date) >= new Date(startDate));
        if (endDate) filteredTransactions = filteredTransactions.filter(t => new Date(t.date) <= new Date(endDate));

        filteredTransactions.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

        const startIndex = after ? filteredTransactions.findIndex(t => t.id === after) + 1 : 0;
        const endIndex = Math.min(startIndex + (first || 10), filteredTransactions.length);
        const transactionsPage = filteredTransactions.slice(startIndex, endIndex);

        result = {
          data: {
            transactions: {
              edges: transactionsPage.map(t => ({ node: t, typename: 'TransactionEdge' })),
              pageInfo: {
                startCursor: transactionsPage[0]?.id || null,
                endCursor: transactionsPage[transactionsPage.length - 1]?.id || null,
                hasNextPage: endIndex < filteredTransactions.length,
                hasPreviousPage: startIndex > 0,
                typename: 'PageInfo'
              },
              typename: 'TransactionConnection'
            }
          }
        };
      } else if (operationName === 'GetBudgets') {
        result = { data: { budgets: mockBudgets } };
      } else if (operationName === 'GetNotifications') {
        const { isRead } = variables as { isRead?: boolean };
        const filteredAlerts = isRead === undefined ? mockAlerts : mockAlerts.filter(a => a.isRead === isRead);
        result = { data: { notifications: filteredAlerts } };
      } else if (operationName === 'GetUserProfile') {
        result = { data: { userProfile: mockUser } };
      } else if (operationName === 'GetBeneficiaries') {
        result = { data: { beneficiaries: mockBeneficiaries } };
      } else if (operationName === 'GetScheduledPayments') {
        result = { data: { scheduledPayments: mockScheduledPayments } };
      } else {
        result = { errors: [{ message: `Unknown operation: ${operationName}` }] };
      }
      resolve({ data: result?.data, errors: result?.errors });
    }, getRandomInt(200, 1000)); // Simulate network latency
  });
});

const errorLink = onError(({ graphQLErrors, networkError }) => {
  if (graphQLErrors) {
    graphQLErrors.forEach(({ message, locations, path }) =>
      console.error(
        `[GraphQL error]: Message: ${message}, Location: ${locations}, Path: ${path}`,
      ),
    );
  }
  if (networkError) console.error(`[Network error]: ${networkError}`);
});

export const client = new ApolloClient({
  link: ApolloLink.from([errorLink, mockLink]),
  cache: new InMemoryCache(),
});

// --- Contexts for Global State Management ---

/**
 * Authentication Context Type.
 * Provides user information, login/logout functions, and authentication status.
 */
export interface AuthContextType {
  user: UserProfile | null;
  isAuthenticated: boolean;
  login: (credentials: any) => Promise<void>;
  logout: () => void;
  isLoading: boolean;
  updateUserProfile: (profile: Partial<UserProfile>) => void; // Added for settings page
}

const defaultAuthContext: AuthContextType = {
  user: null,
  isAuthenticated: false,
  login: async () => { console.warn('AuthContext: Login not implemented'); },
  logout: () => { console.warn('AuthContext: Logout not implemented'); },
  isLoading: false,
  updateUserProfile: () => { console.warn('AuthContext: updateUserProfile not implemented'); },
};

export const AuthContext = createContext<AuthContextType>(defaultAuthContext);

/**
 * AuthProvider component. Manages user authentication state.
 */
export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [user, setUser] = useState<UserProfile | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    // Simulate checking for a session or token
    const storedUser = localStorage.getItem('user');
    if (storedUser) {
      setUser(JSON.parse(storedUser));
    }
    setIsLoading(false);
  }, []);

  const login = useCallback(async (credentials: any) => {
    setIsLoading(true);
    // Simulate API call for login
    await new Promise(resolve => setTimeout(resolve, 1000));
    if (credentials.username === 'demo' && credentials.password === 'password') {
      localStorage.setItem('user', JSON.stringify(mockUser));
      setUser(mockUser);
    } else {
      throw new Error('Invalid credentials');
    }
    setIsLoading(false);
  }, []);

  const logout = useCallback(() => {
    localStorage.removeItem('user');
    setUser(null);
  }, []);

  const updateUserProfile = useCallback((profile: Partial<UserProfile>) => {
    setUser(prevUser => {
      if (!prevUser) return null;
      const updated = { ...prevUser, ...profile };
      localStorage.setItem('user', JSON.stringify(updated)); // Persist mock user
      return updated;
    });
  }, []);

  const isAuthenticated = !!user;

  const contextValue = useMemo(() => ({
    user,
    isAuthenticated,
    login,
    logout,
    isLoading,
    updateUserProfile,
  }), [user, isAuthenticated, login, logout, isLoading, updateUserProfile]);

  return (
    <AuthContext.Provider value={contextValue}>
      {children}
    </AuthContext.Provider>
  );
};

/**
 * Currency Preference Context Type.
 * Manages the user's preferred display currency and provides conversion utilities.
 */
export interface CurrencyPreferenceContextType {
  preferredCurrency: CurrencyEnum;
  setPreferredCurrency: (currency: CurrencyEnum) => void;
  getConvertedAmount: (amountCents: number, fromCurrency: CurrencyEnum, toCurrency: CurrencyEnum) => number;
  formatCurrencyDisplay: (amountCents: number, currency?: CurrencyEnum) => string;
}

export const CurrencyPreferenceContext = createContext<CurrencyPreferenceContextType>({
  preferredCurrency: 'USD',
  setPreferredCurrency: () => {},
  getConvertedAmount: (amount, from, to) => {
    if (from === to) return amount;
    const rates: Record<CurrencyEnum, number> = {
      USD: 1, EUR: 1.08, GBP: 1.25, JPY: 0.0067, AUD: 0.65, CAD: 0.73, CHF: 1.10, CNY: 0.14, SEK: 0.092, NZD: 0.60, MXN: 0.059, SGD: 0.74, HKD: 0.13, INR: 0.012, BRL: 0.19,
    };
    return Math.round((amount / rates[from]) * rates[to]);
  },
  formatCurrencyDisplay: (amountCents, currency) => formatCentsToCurrency(amountCents, currency || 'USD'),
});

/**
 * CurrencyPreferenceProvider component. Manages preferred display currency.
 */
export const CurrencyPreferenceProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [preferredCurrency, setPreferredCurrencyState] = useState<CurrencyEnum>(() => {
    const savedCurrency = localStorage.getItem('preferredCurrency');
    return (savedCurrency as CurrencyEnum) || 'USD';
  });

  const setPreferredCurrency = useCallback((currency: CurrencyEnum) => {
    setPreferredCurrencyState(currency);
    localStorage.setItem('preferredCurrency', currency);
  }, []);

  const getConvertedAmount = useCallback((amountCents: number, fromCurrency: CurrencyEnum, toCurrency: CurrencyEnum) => {
    if (fromCurrency === toCurrency) return amountCents;
    // Mock conversion rates for demo. In real app, fetch from API and ensure refresh.
    const rates: Record<CurrencyEnum, number> = {
      USD: 1, EUR: 1.08, GBP: 1.25, JPY: 0.0067, AUD: 0.65, CAD: 0.73, CHF: 1.10, CNY: 0.14, SEK: 0.092, NZD: 0.60, MXN: 0.059, SGD: 0.74, HKD: 0.13, INR: 0.012, BRL: 0.19,
    };
    return Math.round((amountCents / rates[fromCurrency]) * rates[toCurrency]);
  }, []);

  const formatCurrencyDisplay = useCallback((amountCents: number, currency?: CurrencyEnum) => {
    return formatCentsToCurrency(amountCents, currency || preferredCurrency);
  }, [preferredCurrency]);

  const contextValue = useMemo(() => ({
    preferredCurrency,
    setPreferredCurrency,
    getConvertedAmount,
    formatCurrencyDisplay,
  }), [preferredCurrency, setPreferredCurrency, getConvertedAmount, formatCurrencyDisplay]);

  return (
    <CurrencyPreferenceContext.Provider value={contextValue}>
      {children}
    </CurrencyPreferenceContext.Provider>
  );
};


