  frequency: 'ONCE' | 'DAILY' | 'WEEKLY' | 'MONTHLY' | 'QUARTERLY' | 'ANNUAL';
  includeAccounts: string[]; // List of primary account IDs (e.g., 'ACC-001')
  generatedAt: string; // ISO string
  exportFormat: 'PDF' | 'CSV' | 'XLSX' | 'JSON';
  scheduledBy: string; // User ID who scheduled it
  status: 'COMPLETED' | 'PENDING' | 'FAILED' | 'SCHEDULED';
  recipients?: string[]; // Email addresses for scheduled reports
}

/**
 * Interface for an audit log entry.
