// --- Mock Data Generation Utilities ---
const generateRandomId = () => Math.random().toString(36).substr(2, 9).toUpperCase();
const getRandomDate = (start: Date, end: Date) => new Date(start.getTime() + Math.random() * (end.getTime() - start.getTime()));
const getRandomInt = (min: number, max: number) => Math.floor(Math.random() * (max - min + 1)) + min;
const getRandomFloat = (min: number, max: number) => parseFloat((Math.random() * (max - min) + min).toFixed(2));

const ALL_CURRENCIES: CurrencyEnum[] = ['USD', 'EUR', 'GBP', 'JPY', 'AUD', 'CAD', 'CHF', 'CNY', 'SEK', 'NZD', 'MXN', 'SGD', 'HKD', 'INR', 'BRL'];
const getRandomCurrency = (): CurrencyEnum => ALL_CURRENCIES[Math.floor(Math.random() * ALL_CURRENCIES.length)];

export const formatCentsToCurrency = (amountCents: number, currency: CurrencyEnum = 'USD'): string => {
  const formatter = new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: currency,
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
  return formatter.format(amountCents / 100);
};

// Generate a large set of mock transactions
const mockTransactions: Transaction[] = [];
for (let i = 0; i < 2000; i++) {
  const currency = getRandomCurrency();
  const amountCents = getRandomInt(1000, 50000000); // $10 to $500,000
  const type = ['DEBIT', 'CREDIT', 'TRANSFER', 'FEE', 'INTEREST'][getRandomInt(0, 4)];
  const status = ['PENDING', 'CLEARED', 'REVERSED', 'FAILED'][getRandomInt(0, 3)];
  const category = ['Payroll', 'Supplies', 'Rent', 'Sales', 'Utilities', 'Software', 'Investments', 'Taxes', 'Travel', 'Marketing', 'Legal Fees'][getRandomInt(0, 10)];
  const isReconciled = status === 'CLEARED' && Math.random() < 0.9;

  mockTransactions.push({
    id: generateRandomId(),
    accountId: `acc-${getRandomInt(1, 10)}`, // Link to 10 mock primary accounts
    date: getRandomDate(new Date(2023, 0, 1), new Date()).toISOString(),
    effectiveDate: getRandomDate(new Date(2023, 0, 1), new Date()).toISOString(),
    description: `${type === 'DEBIT' ? 'Payment to' : (type === 'CREDIT' ? 'Deposit from' : 'Transfer')}: ${category}`,
    amountCents: type === 'DEBIT' || type === 'FEE' ? -amountCents : amountCents,
    currency,
    type,
    status,
    category,
    subCategory: category === 'Supplies' ? 'Office Supplies' : (category === 'Software' ? 'Software Subscriptions' : undefined),
    referenceNumber: `REF-${generateRandomId()}`,
    counterparty: `Vendor/Client ${getRandomInt(1, 50)}`,
    counterpartyAccount: Math.random() > 0.5 ? `ACCT-${getRandomInt(10000, 99999)}` : undefined,
    isReconciled,
    isFlagged: Math.random() < 0.03, // 3% flagged transactions
    attachmentUrl: Math.random() < 0.1 ? `https://example.com/invoice-${generateRandomId()}.pdf` : undefined,
  });
}

const generateMockAccountCurrencyMetrics = (count: number = 10, currencyFilter?: CurrencyEnum): AccountCurrencyMetricConnection => {
  const nodes: AccountCurrencyMetricNode[] = [];
  const primaryAccountIds = Array.from({ length: 10 }, (_, i) => `acc-${i + 1}`);

  primaryAccountIds.forEach(primaryAccountId => {
    // Generate metrics for a few currencies per primary account
    const currenciesForAccount = Array.from(new Set([getRandomCurrency(), getRandomCurrency(), currencyFilter].filter(Boolean) as CurrencyEnum[]));
    currenciesForAccount.forEach(currency => {
      const priorDayBalanceCents = getRandomInt(10000000, 10000000000); // $100k to $100M
      const availableBalanceCents = priorDayBalanceCents + getRandomInt(-500000000, 500000000); // +/- $5M
      const ledgerVarianceCents = getRandomInt(-100000, 100000); // +/- $1k
      const unreconciledAmountCents = Math.abs(ledgerVarianceCents) + getRandomInt(0, 50000); // $0 to $500
      const unreconciledPercent = parseFloat(((unreconciledAmountCents / Math.max(1, availableBalanceCents)) * 100).toFixed(2));

      const accountTransactions = mockTransactions.filter(t => t.accountId === primaryAccountId && t.currency === currency);
      const budgetAllocatedCents = getRandomInt(1000000, 50000000);
      const budgetUsedCents = getRandomInt(500000, budgetAllocatedCents * 0.9);

      const transactionCountLast30Days = accountTransactions.filter(t => new Date(t.date) > new Date(Date.now() - 30 * 24 * 60 * 60 * 1000)).length;
      const averageDailyBalanceCents = getRandomInt(priorDayBalanceCents * 0.8, priorDayBalanceCents * 1.2);
      const netCashFlowLast30DaysCents = accountTransactions
        .filter(t => new Date(t.date) > new Date(Date.now() - 30 * 24 * 60 * 60 * 1000))
        .reduce((sum, t) => sum + t.amountCents, 0);

      const associatedAccounts = [
        { id: `linked-${generateRandomId()}`, name: `Subsidiary A ${currency}`, type: 'Checking', currentBalanceCents: getRandomInt(1000000, 10000000), currency, relationshipType: 'CHILD' as const },
        { id: `linked-${generateRandomId()}`, name: `Investment B ${currency}`, type: 'Investment', currentBalanceCents: getRandomInt(5000000, 50000000), currency, relationshipType: 'RELATED' as const },
      ];

      const spendingCategories: { category: string; amountCents: number; percentOfTotal: number; }[] = [
        { category: 'Payroll', amountCents: getRandomInt(1000000, 5000000), percentOfTotal: 0 },
        { category: 'Rent', amountCents: getRandomInt(500000, 2000000), percentOfTotal: 0 },
        { category: 'Supplies', amountCents: getRandomInt(100000, 1000000), percentOfTotal: 0 },
        { category: 'Utilities', amountCents: getRandomInt(50000, 500000), percentOfTotal: 0 },
      ];
      const totalSpending = spendingCategories.reduce((sum, cat) => sum + cat.amountCents, 0);
      spendingCategories.forEach(cat => cat.percentOfTotal = parseFloat(((cat.amountCents / totalSpending) * 100).toFixed(2)));

      const creditLimitCents = Math.random() < 0.3 ? getRandomInt(10000000, 100000000) : undefined;
      const interestRatePercent = Math.random() < 0.4 ? getRandomFloat(0.1, 5.0) : undefined;

      nodes.push({
        typename: 'AccountCurrencyMetric',
        id: `${primaryAccountId}-${currency}`,
        accountId: primaryAccountId,
        accountName: `Business Account ${primaryAccountId.split('-')[1]}`,
        currency,
        priorDayBalanceCents,
        availableBalanceCents,
        prettyPriorDayBalance: formatCentsToCurrency(priorDayBalanceCents, currency),
        prettyAvailableBalance: formatCentsToCurrency(availableBalanceCents, currency),
        ledgerVarianceCents,
        highlightLedgerVariance: Math.abs(ledgerVarianceCents) > 50000, // over $500 variance
        unreconciledAmountCents,
        unreconciledPercent,
        path: `/accounts/${primaryAccountId.split('-')[1]}/${currency}`,
        lastUpdated: getRandomDate(new Date(2024, 0, 1), new Date()).toISOString(),
        transactionsLast24H: accountTransactions.slice(0, 5), // limited for dashboard
        potentialOverdraftRisk: availableBalanceCents < 0 || availableBalanceCents < (priorDayBalanceCents * 0.05), // 5% buffer
        complianceStatus: Math.random() > 0.95 ? 'RED' : (Math.random() > 0.8 ? 'YELLOW' : 'GREEN'),
        riskScore: getRandomInt(10, 90),
        budgetAllocatedCents,
        budgetUsedCents,
        projectedBalanceCents: availableBalanceCents + getRandomInt(-10000000, 10000000), // simplistic projection
        associatedAccounts,
        spendingCategories,
        transactionCountLast30Days,
        averageDailyBalanceCents,
        netCashFlowLast30DaysCents,
        creditLimitCents,
        interestRatePercent,
        feesAndChargesLast30DaysCents: getRandomInt(0, 200000), // $0 to $2000
        monthlyStatements: [
          { id: generateRandomId(), period: 'JUL-2024', downloadUrl: '#', status: 'AVAILABLE' },
          { id: generateRandomId(), period: 'JUN-2024', downloadUrl: '#', status: 'AVAILABLE' },
        ],
        authorizedUsers: [
          { userId: 'usr-123', userName: 'James Burvel', permissions: ['VIEW', 'TRANSACT', 'APPROVE'] },
          { userId: 'usr-456', userName: 'Jane Doe', permissions: ['VIEW'] },
        ],
        pendingDepositsCents: getRandomInt(0, 500000),
        pendingWithdrawalsCents: getRandomInt(0, 300000),
        holdsCents: getRandomInt(0, 100000),
        lastStatementBalanceCents: getRandomInt(priorDayBalanceCents * 0.9, priorDayBalanceCents * 1.1),
      });
    });
  });

  // Apply currency filter at the end
  const filteredNodes = currencyFilter ? nodes.filter(node => node.currency === currencyFilter) : nodes;

  return {
    edges: filteredNodes.map(node => ({ node, typename: 'AccountCurrencyMetricEdge' })),
    pageInfo: {
      startCursor: 'cursor-1',
      endCursor: `cursor-${filteredNodes.length}`,
      hasNextPage: filteredNodes.length > count, // Simulate more data than shown
      hasPreviousPage: false,
      typename: 'PageInfo',
    },
    typename: 'AccountCurrencyMetricConnection',
  };
};

