            {message && (
              <p style={message.type === 'error' ? styles.errorText : styles.successText} aria-live="polite">
                {message.text}
              </p>
            )}
          </form>
          <div style={{ marginTop: '30px' }}>
            <h3>Bulk Payment Processing</h3>
            <p>Upload a file (CSV/XML) to process multiple payments simultaneously.</p>
            <input type="file" style={{ margin: '10px 0' }} aria-label="Upload bulk payment file" />
