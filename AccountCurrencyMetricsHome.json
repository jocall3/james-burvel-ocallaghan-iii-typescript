          <p><strong>Fees & Charges (30 Days):</strong> {displayFeesAndCharges}</p>
          <p><strong>Pending Deposits:</strong> {formatCurrencyDisplay(account.pendingDepositsCents, account.currency)}</p>
          <p><strong>Pending Withdrawals:</strong> {formatCurrencyDisplay(account.pendingWithdrawalsCents, account.currency)}</p>
          <p><strong>Holds:</strong> {formatCurrencyDisplay(account.holdsCents, account.currency)}</p>
        </div>
      </div>

      <div style={{ ...styles.card, marginBottom: '20px', display: 'flex', gap: '20px', flexWrap: 'wrap' }}>
        <div style={{ flex: 1, minWidth: '300px' }}>
          <h2>Budget Summary ({account.currency})</h2>
          <p><strong>Allocated:</strong> {displayBudgetAllocated}</p>
          <p><strong>Used:</strong> {displayBudgetUsed}</p>
          <p><strong>Remaining:</strong> {formatCurrencyDisplay(getConvertedAmount(account.budgetAllocatedCents - account.budgetUsedCents, account.currency, preferredCurrency))}</p>
          <div style={{ height: '10px', backgroundColor: '#e0e0e0', borderRadius: '5px', marginTop: '10px' }}>
            <div
              style={{
                width: `${budgetProgress}%`,
                height: '100%',
                backgroundColor: budgetColor,
                borderRadius: '5px',
                transition: 'width 0.5s ease-in-out',
              }}
              role="progressbar"
              aria-valuenow={budgetProgress}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-label={`Budget utilization: ${budgetProgress.toFixed(1)}%`}
            ></div>
          </div>
          <p style={{ fontSize: '0.9em', color: 'gray', marginTop: '5px' }}>{budgetProgress.toFixed(1)}% of budget used</p>
          <button style={{ ...styles.button, backgroundColor: '#0055aa', marginTop: '10px' }}>Manage Budget</button>
        </div>
        <div style={{ flex: 1, minWidth: '300px', borderLeft: '1px solid #eee', paddingLeft: '20px' }}>
          <h2>Unreconciled Items</h2>
          <p><strong>Amount:</strong> {formatCurrencyDisplay(getConvertedAmount(account.unreconciledAmountCents, account.currency, preferredCurrency))}</p>
          <p><strong>Percentage:</strong> {account.unreconciledPercent.toFixed(2)}%</p>
          {account.unreconciledAmountCents > 0 && (
            <button style={{ ...styles.button, backgroundColor: '#dc3545', marginTop: '10px' }}>Initiate Reconciliation Workflow</button>
          )}
          <p style={{ fontSize: '0.9em', color: 'gray', marginTop: '10px' }}>
            Flagged items: {account.transactions.filter(t => t.isFlagged && !t.isReconciled).length}
          </p>
        </div>
      </div>

      <div style={{ ...styles.card, marginBottom: '20px' }}>
        <h2>Transactions ({account.currency})</h2>
        <TransactionTable accountId={account.accountId} currency={account.currency} />
      </div>

      <div style={{ ...styles.card, marginBottom: '20px' }}>
        <h2>Associated Accounts</h2>
        <table style={styles.table}>
          <thead>
            <tr>
              <th style={styles.th}>Account Name</th>
              <th style={styles.th}>Type</th>
              <th style={styles.th}>Currency</th>
              <th style={styles.th}>Balance ({preferredCurrency})</th>
              <th style={styles.th}>Relationship</th>
              <th style={styles.th}>Actions</th>
            </tr>
          </thead>
          <tbody>
            {account.associatedAccounts.map((acc) => (
              <tr key={acc.id}>
                <td style={styles.td}>{acc.name}</td>
                <td style={styles.td}>{acc.type}</td>
                <td style={styles.td}>{acc.currency}</td>
                <td style={styles.td}>{formatCurrencyDisplay(getConvertedAmount(acc.currentBalanceCents, acc.currency, preferredCurrency))}</td>
                <td style={styles.td}>{acc.relationshipType}</td>
                <td style={styles.td}><button onClick={() => navigate(`/accounts/${acc.id.split('-')[1]}/${acc.currency}`)} style={{ ...styles.button, backgroundColor: '#0055aa', fontSize: '0.8em', padding: '6px 10px' }}>View</button></td>
              </tr>
            ))}
            {account.associatedAccounts.length === 0 && <tr><td colSpan={6} style={{ ...styles.td, textAlign: 'center' }}>No associated accounts.</td></tr>}
          </tbody>
        </table>
      </div>

      <div style={{ ...styles.card, marginBottom: '20px' }}>
        <h2>Spending Categories Analysis</h2>
        <table style={styles.table}>
          <thead>
            <tr>
              <th style={styles.th}>Category</th>
              <th style={styles.th}>Amount Spent ({preferredCurrency})</th>
              <th style={styles.th}>% of Total</th>
            </tr>
          </thead>
          <tbody>
            {account.spendingCategories.map((cat, index) => (
              <tr key={index}>
                <td style={styles.td}>{cat.category}</td>
                <td style={styles.td}>{formatCurrencyDisplay(getConvertedAmount(cat.amountCents, account.currency, preferredCurrency))}</td>
                <td style={styles.td}>{cat.percentOfTotal.toFixed(1)}%</td>
              </tr>
            ))}
            {account.spendingCategories.length === 0 && <tr><td colSpan={3} style={{ ...styles.td, textAlign: 'center' }}>No spending categories found.</td></tr>}
          </tbody>
        </table>
      </div>

      <div style={{ ...styles.card, marginBottom: '20px' }}>
        <h2>Monthly Statements</h2>
        <table style={styles.table}>
          <thead>
            <tr>
              <th style={styles.th}>Period</th>
              <th style={styles.th}>Status</th>
              <th style={styles.th}>Actions</th>
            </tr>
          </thead>
          <tbody>
            {account.monthlyStatements?.map((statement) => (
              <tr key={statement.id}>
                <td style={styles.td}>{statement.period}</td>
                <td style={styles.td}>{statement.status}</td>
                <td style={styles.td}>
                  {statement.status === 'AVAILABLE' ? (
                    <a href={statement.downloadUrl} target="_blank" rel="noopener noreferrer" style={{ ...styles.button, backgroundColor: '#0055aa', fontSize: '0.8em', padding: '6px 10px' }}>Download PDF</a>
                  ) : (
                    <span style={{ color: 'gray', fontSize: '0.8em' }}>{statement.status}</span>
                  )}
                </td>
              </tr>
            ))}
            {account.monthlyStatements?.length === 0 && <tr><td colSpan={3} style={{ ...styles.td, textAlign: 'center' }}>No statements available.</td></tr>}
          </tbody>
        </table>
        <button style={{ ...styles.button, marginTop: '15px', backgroundColor: '#0055aa' }}>Request New Statement</button>
      </div>

      <div style={{ ...styles.card, marginBottom: '20px' }}>
        <h2>Authorized Users for this Account</h2>
        <table style={styles.table}>
          <thead>
            <tr>
              <th style={styles.th}>User Name</th>
              <th style={styles.th}>Permissions</th>
              <th style={styles.th}>Actions</th>
            </tr>
          </thead>
          <tbody>
            {account.authorizedUsers?.map((userEntry, index) => (
              <tr key={userEntry.userId || index}>
                <td style={styles.td}>{userEntry.userName}</td>
                <td style={styles.td}>{userEntry.permissions.join(', ')}</td>
                <td style={styles.td}>
                  <button style={{ ...styles.button, backgroundColor: '#ffc107', color: '#333', fontSize: '0.8em', padding: '6px 10px', marginRight: '5px' }}>Edit Permissions</button>
                  <button style={{ ...styles.button, backgroundColor: '#dc3545', fontSize: '0.8em', padding: '6px 10px' }}>Remove</button>
                </td>
              </tr>
            ))}
            {account.authorizedUsers?.length === 0 && <tr><td colSpan={3} style={{ ...styles.td, textAlign: 'center' }}>No authorized users for this account.</td></tr>}
          </tbody>
        </table>
        <button style={{ ...styles.button, marginTop: '15px', backgroundColor: '#28a745' }}>Add New User Access</button>
      </div>

    </div>
  );
};

// Component: Transaction Table (Paginated, Filterable, Searchable)
export const TransactionTable: React.FC<{ accountId: string, currency: CurrencyEnum }> = ({ accountId, currency }) => {
  const { preferredCurrency, getConvertedAmount, formatCurrencyDisplay } = useContext(CurrencyPreferenceContext);
  const [filterText, setFilterText] = useState('');
  const [filterCategory, setFilterCategory] = useState<string>('');
  const [filterStatus, setFilterStatus] = useState<'ALL' | Transaction['status']>('ALL');
  const [startDate, setStartDate] = useState('');
  const [endDate, setEndDate] = useState('');

  const { data, loading, error, fetchMore, refetch } = useQuery<{ transactions: { edges: { node: Transaction }[], pageInfo: PageInfo } }>(
    GET_TRANSACTIONS_QUERY,
    {
      variables: {
        accountId,
        currency,
        first: 15,
        search: filterText,
        category: filterCategory === '' ? undefined : filterCategory,
        status: filterStatus === 'ALL' ? undefined : filterStatus,
        startDate: startDate === '' ? undefined : startDate,
        endDate: endDate === '' ? undefined : endDate,
      },
      fetchPolicy: 'cache-and-network',
    }
  );

  // Refetch when filters change
  useEffect(() => {
    refetch();
  }, [filterText, filterCategory, filterStatus, startDate, endDate, refetch]);

  const transactions = data?.transactions.edges.map(edge => edge.node) || [];
  const pageInfo = data?.transactions.pageInfo;

  const loadMoreTransactions = () => {
    if (pageInfo?.hasNextPage) {
      fetchMore({
        variables: {
          after: pageInfo.endCursor,
          first: 15,
          accountId,
          currency,
          search: filterText,
          category: filterCategory === '' ? undefined : filterCategory,
          status: filterStatus === 'ALL' ? undefined : filterStatus,
          startDate: startDate === '' ? undefined : startDate,
          endDate: endDate === '' ? undefined : endDate,
        },
        updateQuery: (prev, { fetchMoreResult }) => {
          if (!fetchMoreResult) return prev;
          return {
            transactions: {
              ...fetchMoreResult.transactions,
              edges: [
                ...prev.transactions.edges,
                ...fetchMoreResult.transactions.edges,
              ],
            },
          };
        },
      });
    }
  };

  const allCategories = Array.from(new Set(mockTransactions.map(t => t.category))).sort();
  const allStatuses = Array.from(new Set(mockTransactions.map(t => t.status))).sort();

  return (
    <div>
      <div style={{ display: 'flex', gap: '10px', marginBottom: '15px', flexWrap: 'wrap', alignItems: 'flex-end' }}>
        <div>
          <label htmlFor="transactionSearch" style={styles.label}>Search:</label>
          <input
            id="transactionSearch"
            type="text"
            style={{ ...styles.input, width: '200px' }}
            placeholder="Description, counterparty, ref #"
            value={filterText}
            onChange={(e) => setFilterText(e.target.value)}
          />
        </div>
        <div>
          <label htmlFor="categoryFilter" style={styles.label}>Category:</label>
          <select id="categoryFilter" style={styles.select} value={filterCategory} onChange={(e) => setFilterCategory(e.target.value)}>
            <option value="">All Categories</option>
            {allCategories.map(cat => <option key={cat} value={cat}>{cat}</option>)}
          </select>
        </div>
        <div>
          <label htmlFor="statusFilter" style={styles.label}>Status:</label>
          <select id="statusFilter" style={styles.select} value={filterStatus} onChange={(e) => setFilterStatus(e.target.value as 'ALL' | Transaction['status'])}>
            <option value="ALL">All Statuses</option>
            {allStatuses.map(status => <option key={status} value={status}>{status}</option>)}
          </select>
        </div>
        <div>
          <label htmlFor="startDateFilter" style={styles.label}>From Date:</label>
          <input id="startDateFilter" type="date" style={styles.input} value={startDate} onChange={(e) => setStartDate(e.target.value)} />
        </div>
        <div>
          <label htmlFor="endDateFilter" style={styles.label}>To Date:</label>
          <input id="endDateFilter" type="date" style={styles.input} value={endDate} onChange={(e) => setEndDate(e.target.value)} />
        </div>
        <button style={{ ...styles.button, backgroundColor: '#28a745' }}>Export CSV</button>
        <button style={{ ...styles.button, backgroundColor: '#ffc107', color: '#333' }}>New Transfer</button>
      </div>

      <table style={styles.table}>
        <thead>
          <tr>
            <th style={styles.th}>Date</th>
            <th style={styles.th}>Description</th>
            <th style={styles.th}>Counterparty</th>
            <th style={styles.th}>Category</th>
            <th style={styles.th}>Amount ({preferredCurrency})</th>
            <th style={styles.th}>Type</th>
            <th style={styles.th}>Status</th>
            <th style={styles.th}>Ref #</th>
            <th style={styles.th}>Reconciled</th>
            <th style={styles.th}>Flagged</th>
            <th style={styles.th}>Actions</th>
          </tr>
        </thead>
        <tbody>
          {loading && transactions.length === 0 ? (
            <tr><td colSpan={11}><LoadingSpinner /></td></tr>
          ) : (
            transactions.length === 0 ? (
              <tr><td colSpan={11} style={{ ...styles.td, textAlign: 'center' }}>No transactions found for the selected filters.</td></tr>
            ) : (
              transactions.map(tx => (
                <tr key={tx.id}>
                  <td style={styles.td}>{new Date(tx.date).toLocaleDateString()}</td>
                  <td style={styles.td}>{tx.description}</td>
                  <td style={styles.td}>{tx.counterparty}</td>
                  <td style={styles.td}>{tx.category} {tx.subCategory && `(${tx.subCategory})`}</td>
                  <td style={{ ...styles.td, color: tx.amountCents < 0 ? 'red' : 'green', fontWeight: 'bold' }}>
                    {formatCurrencyDisplay(getConvertedAmount(tx.amountCents, tx.currency, preferredCurrency))}
                  </td>
                  <td style={styles.td}>{tx.type}</td>
                  <td style={styles.td}>{tx.status}</td>
                  <td style={styles.td}>{tx.referenceNumber}</td>
                  <td style={styles.td}>{tx.isReconciled ? '✅' : '❌'}</td>
                  <td style={styles.td}>{tx.isFlagged ? '🚩' : ''}</td>
                  <td style={styles.td}>
                    {tx.attachmentUrl && <a href={tx.attachmentUrl} target="_blank" rel="noopener noreferrer" style={{ ...styles.button, backgroundColor: '#6c757d', fontSize: '0.7em', padding: '4px 8px', marginRight: '5px' }}>View Doc</a>}
                    {!tx.isReconciled && <button style={{ ...styles.button, backgroundColor: '#0055aa', fontSize: '0.7em', padding: '4px 8px' }}>Reconcile</button>}
                  </td>
                </tr>
              ))
            )
          )}
        </tbody>
      </table>
      {pageInfo?.hasNextPage && (
        <button onClick={loadMoreTransactions} style={{ ...styles.button, marginTop: '20px', width: '100%', backgroundColor: '#0055aa' }} disabled={loading}>
          {loading ? 'Loading More...' : 'Load More Transactions'}
        </button>
      )}
      {(loading && transactions.length > 0) && <LoadingSpinner />}
    </div>
  );
};

// Component: Payments Page
export const PaymentsPage: React.FC = () => {
  const { user } = useContext(AuthContext);
  const { preferredCurrency, formatCurrencyDisplay } = useContext(CurrencyPreferenceContext);
  const [activeTab, setActiveTab] = useState<'new' | 'pending' | 'scheduled' | 'beneficiaries' | 'history'>('new');
  const [paymentAmount, setPaymentAmount] = useState('');
  const [recipient, setRecipient] = useState('');
  const [paymentCurrency, setPaymentCurrency] = useState<CurrencyEnum>('USD');
  const [fromAccount, setFromAccount] = useState('');
  const [isProcessing, setIsProcessing] = useState(false);
  const [message, setMessage] = useState<{ type: 'success' | 'error', text: string } | null>(null);

  const { data: beneficiariesData, loading: beneficiariesLoading, error: beneficiariesError, refetch: refetchBeneficiaries } = useQuery<{ beneficiaries: Beneficiary[] }>(GET_BENEFICIARIES_QUERY);
  const beneficiaries = beneficiariesData?.beneficiaries || [];

  const { data: scheduledPaymentsData, loading: scheduledPaymentsLoading, error: scheduledPaymentsError, refetch: refetchScheduledPayments } = useQuery<{ scheduledPayments: ScheduledPayment[] }>(GET_SCHEDULED_PAYMENTS_QUERY);
  const scheduledPayments = scheduledPaymentsData?.scheduledPayments || [];

  const handlePaymentSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!paymentAmount || !recipient || !fromAccount) {
      setMessage({ type: 'error', text: 'Please fill all required fields.' });
      return;
    }
    setIsProcessing(true);
    setMessage(null);
    // Simulate API call for payment
    await new Promise(resolve => setTimeout(resolve, 2000));
    const success = Math.random() > 0.1; // 90% success rate
    if (success) {
      setMessage({ type: 'success', text: `Payment of ${formatCurrencyDisplay(parseFloat(paymentAmount) * 100, paymentCurrency)} to ${recipient} initiated successfully!` });
      setPaymentAmount('');
      setRecipient('');
    } else {
      setMessage({ type: 'error', text: 'Payment failed. Please try again or contact support.' });
    }
    setIsProcessing(false);
  };

  const handleBeneficiarySubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    // Simplified, more fields needed for real beneficiary
    const newBeneficiary: Beneficiary = {
      id: generateRandomId(),
      name: recipient,
      accountNumber: 'XXXXX' + getRandomInt(1000, 9999),
      bankName: 'Mock Bank Inc.',
      currency: paymentCurrency,
      isInternational: false,
      addedBy: user?.id || 'unknown',
      addedDate: new Date().toISOString(),
    };
    mockBeneficiaries.push(newBeneficiary);
    refetchBeneficiaries();
    alert('Beneficiary added successfully! (Mock action)');
  };

  const mockPendingApprovals = user?.roles.includes('PAYMENT_APPROVER') ? getRandomInt(0, 5) : 0;

  return (
    <div style={styles.container}>
      <h1 style={{ marginBottom: '20px', color: '#003366' }}>Payments & Transfers</h1>

      <div style={{ display: 'flex', borderBottom: '1px solid #e0e0e0', marginBottom: '20px' }}>
        <button style={{ ...styles.button, backgroundColor: activeTab === 'new' ? '#007bff' : '#f0f0f0', color: activeTab === 'new' ? 'white' : '#333', borderRadius: '4px 4px 0 0', border: 'none', marginRight: '5px' }} onClick={() => setActiveTab('new')}>New Payment</button>
        <button style={{ ...styles.button, backgroundColor: activeTab === 'pending' ? '#007bff' : '#f0f0f0', color: activeTab === 'pending' ? 'white' : '#333', borderRadius: '4px 4px 0 0', border: 'none', marginRight: '5px' }} onClick={() => setActiveTab('pending')}>Pending & Approvals {mockPendingApprovals > 0 && <span style={{ backgroundColor: 'orange', borderRadius: '50%', padding: '2px 7px', fontSize: '0.7em', marginLeft: '5px' }}>{mockPendingApprovals}</span>}</button>
        <button style={{ ...styles.button, backgroundColor: activeTab === 'scheduled' ? '#007bff' : '#f0f0f0', color: activeTab === 'scheduled' ? 'white' : '#333', borderRadius: '4px 4px 0 0', border: 'none', marginRight: '5px' }} onClick={() => setActiveTab('scheduled')}>Scheduled Payments</button>
        <button style={{ ...styles.button, backgroundColor: activeTab === 'beneficiaries' ? '#007bff' : '#f0f0f0', color: activeTab === 'beneficiaries' ? 'white' : '#333', borderRadius: '4px 4px 0 0', border: 'none', marginRight: '5px' }} onClick={() => setActiveTab('beneficiaries')}>Beneficiaries</button>
        <button style={{ ...styles.button, backgroundColor: activeTab === 'history' ? '#007bff' : '#f0f0f0', color: activeTab === 'history' ? 'white' : '#333', borderRadius: '4px 4px 0 0', border: 'none' }} onClick={() => setActiveTab('history')}>Payment History</button>
      </div>

      {activeTab === 'new' && (
        <div style={styles.card}>
          <h2>New Payment / Transfer</h2>
          <form onSubmit={handlePaymentSubmit} style={{ display: 'grid', gap: '15px', maxWidth: '500px' }}>
            <div>
              <label style={styles.label} htmlFor="fromAccount">From Account:</label>
              <select id="fromAccount" style={{ ...styles.select, width: '100%' }} value={fromAccount} onChange={(e) => setFromAccount(e.target.value)} required aria-label="Select source account">
                <option value="">Select Account</option>
                {/* This would be dynamically loaded from user's actual account metrics */}
                {generateMockAccountCurrencyMetrics(5).edges.map(edge => (
                  <option key={edge.node.id} value={edge.node.id}>{edge.node.accountName} ({edge.node.currency}) - {formatCurrencyDisplay(edge.node.availableBalanceCents, edge.node.currency)}</option>
                ))}
