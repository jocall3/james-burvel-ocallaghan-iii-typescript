    }
    return requests.sort((a, b) => new Date(b.requestedAt).getTime() - new Date(a.requestedAt).getTime());
  }

  // Simulate network latency
  private async simulateLatency(): Promise<void> {
    await new Promise(resolve => setTimeout(resolve, AppConfig.MOCK_API_LATENCY_MS));
  }

  // Auth Operations
  async login(username: string, password: string): Promise<LoginMutationResponse['login'] | null> {
    await this.simulateLatency();
    const user = this.users.find(u => u.username === username);
    if (user && password === 'password') { // Mock password check
      const token = `mock-jwt-token-for-${user.id}-${Date.now()}`;
      return { token, user: { ...user, lastLogin: new Date().toISOString() } };
    }
    throw new Error('Invalid credentials');
  }

  async fetchMe(userId: string): Promise<AuthUser | null> {
    await this.simulateLatency();
    const user = this.users.find(u => u.id === userId);
    return user || null;
  }

  // Account Group Operations
  async fetchAccountGroups(): Promise<AccountGroup[]> {
    await this.simulateLatency();
    return this.accountGroups;
  }

  async fetchAccountGroup(id: string, first?: number, after?: string): Promise<AccountGroup> {
    await this.simulateLatency();
    const group = this.accountGroups.find(g => g.id === id);
    if (!group) throw new Error(`Account Group with ID ${id} not found.`);

    // Simulate pagination for internal accounts
    let startIndex = 0;
    if (after) {
      const cursorIndex = group.internalAccounts.edges.findIndex(e => e.node.id === after);
      if (cursorIndex !== -1) {
        startIndex = cursorIndex + 1;
      }
    }
    const paginatedAccounts = group.internalAccounts.edges.slice(startIndex, startIndex + (first || AppConfig.PAGINATION_LIMIT_DEFAULT));

    return {
      ...group,
      internalAccounts: {
        pageInfo: {
          startCursor: paginatedAccounts.length > 0 ? paginatedAccounts[0].node.id : null,
          endCursor: paginatedAccounts.length > 0 ? paginatedAccounts[paginatedAccounts.length - 1].node.id : null,
          hasNextPage: (startIndex + (first || AppConfig.PAGINATION_LIMIT_DEFAULT)) < group.internalAccounts.edges.length,
          hasPreviousPage: startIndex > 0,
          __typename: 'PageInfo',
        },
        edges: paginatedAccounts,
      },
    };
  }

  async createAccountGroup(name: string, currency: string, description?: string, createdBy: AuthUser): Promise<AccountGroup> {
    await this.simulateLatency();
    const newGroup: AccountGroup = {
      id: this.generateId('grp'),
      name,
      currency,
      description: description || '',
      internalAccounts: { pageInfo: { hasNextPage: false, hasPreviousPage: false, startCursor: null, endCursor: null }, edges: [] },
      groupMembers: [],
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
      createdBy: { id: createdBy.id, username: createdBy.username },
      lastModifiedBy: { id: createdBy.id, username: createdBy.username },
      transactionSummary: { totalTransactions: 0, totalDebit: 0, totalCredit: 0, averageDailyBalance: 0 },
    };
    this.accountGroups.push(newGroup);
    this.auditLogs.push({
      id: this.generateId('aud'), userId: createdBy.id, action: 'CREATE_ACCOUNT_GROUP', entityType: 'ACCOUNT_GROUP', entityId: newGroup.id, timestamp: new Date().toISOString(), details: { name, currency, description }
    });
    return newGroup;
  }

  async updateAccountGroup(id: string, name?: string, currency?: string, description?: string, lastModifiedBy: AuthUser): Promise<AccountGroup> {
    await this.simulateLatency();
    const index = this.accountGroups.findIndex(g => g.id === id);
    if (index === -1) throw new Error(`Account Group with ID ${id} not found.`);

    const oldGroup = { ...this.accountGroups[index] };
    this.accountGroups[index] = {
      ...this.accountGroups[index],
      name: name ?? this.accountGroups[index].name,
      currency: currency ?? this.accountGroups[index].currency,
      description: description ?? this.accountGroups[index].description,
      updatedAt: new Date().toISOString(),
      lastModifiedBy: { id: lastModifiedBy.id, username: lastModifiedBy.username },
    };
    this.auditLogs.push({
      id: this.generateId('aud'), userId: lastModifiedBy.id, action: 'UPDATE_ACCOUNT_GROUP', entityType: 'ACCOUNT_GROUP', entityId: id, timestamp: new Date().toISOString(), details: { old: oldGroup, new: this.accountGroups[index] }
    });
    return this.accountGroups[index];
  }

  async deleteAccountGroup(id: string, deletedBy: AuthUser): Promise<{ id: string }> {
    await this.simulateLatency();
    const initialLength = this.accountGroups.length;
    this.accountGroups = this.accountGroups.filter(g => g.id !== id);
    if (this.accountGroups.length === initialLength) {
      throw new Error(`Account Group with ID ${id} not found.`);
    }
    this.auditLogs.push({
      id: this.generateId('aud'), userId: deletedBy.id, action: 'DELETE_ACCOUNT_GROUP', entityType: 'ACCOUNT_GROUP', entityId: id, timestamp: new Date().toISOString(), details: { id }
    });
    return { id };
  }

  // User Operations
  async fetchUsers(): Promise<AuthUser[]> {
    await this.simulateLatency();
    return this.users;
  }

  async updateUser(id: string, input: Partial<AuthUser>, modifiedBy: AuthUser): Promise<AuthUser> {
    await this.simulateLatency();
    const index = this.users.findIndex(u => u.id === id);
    if (index === -1) throw new Error(`User with ID ${id} not found.`);
    const oldUser = { ...this.users[index] };
    this.users[index] = {
      ...this.users[index],
      ...input,
      preferredLanguage: input.preferredLanguage || this.users[index].preferredLanguage,
    };
    this.auditLogs.push({
      id: this.generateId('aud'), userId: modifiedBy.id, action: 'UPDATE_USER', entityType: 'USER', entityId: id, timestamp: new Date().toISOString(), details: { old: oldUser, new: this.users[index] }
    });
    return this.users[index];
  }

  async createUser(input: Omit<AuthUser, 'id' | 'lastLogin'> & { password?: string }, createdBy: AuthUser): Promise<AuthUser> {
    await this.simulateLatency();
    const newUser: AuthUser = {
      id: this.generateId('usr'),
      lastLogin: new Date().toISOString(),
      twoFactorEnabled: false,
      ...input,
      preferredLanguage: input.preferredLanguage || 'en',
    };
    this.users.push(newUser);
    this.auditLogs.push({
      id: this.generateId('aud'), userId: createdBy.id, action: 'CREATE_USER', entityType: 'USER', entityId: newUser.id, timestamp: new Date().toISOString(), details: { username: newUser.username, email: newUser.email, roles: newUser.roles }
    });
    return newUser;
  }

  // Transaction Operations
  async fetchTransactions(accountId: string, first?: number, after?: string, startDate?: string, endDate?: string, type?: string, status?: string): Promise<TransactionHistoryQueryResponse['transactions']> {
    await this.simulateLatency();
    let filteredTransactions = this.transactions.filter(t => t.accountId === accountId);

    if (startDate) filteredTransactions = filteredTransactions.filter(t => new Date(t.date) >= new Date(startDate));
    if (endDate) filteredTransactions = filteredTransactions.filter(t => new Date(t.date) <= new Date(endDate));
    if (type) filteredTransactions = filteredTransactions.filter(t => t.type === type);
    if (status) filteredTransactions = filteredTransactions.filter(t => t.status === status);

    let startIndex = 0;
    if (after) {
      const cursorIndex = filteredTransactions.findIndex(t => t.id === after);
      if (cursorIndex !== -1) {
        startIndex = cursorIndex + 1;
      }
    }
    const paginatedTransactions = filteredTransactions.slice(startIndex, startIndex + (first || AppConfig.PAGINATION_LIMIT_DEFAULT));

    return {
      pageInfo: {
        startCursor: paginatedTransactions.length > 0 ? paginatedTransactions[0].id : null,
        endCursor: paginatedTransactions.length > 0 ? paginatedTransactions[paginatedTransactions.length - 1].id : null,
        hasNextPage: (startIndex + (first || AppConfig.PAGINATION_LIMIT_DEFAULT)) < filteredTransactions.length,
        hasPreviousPage: startIndex > 0,
        __typename: 'PageInfo',
      },
      edges: paginatedTransactions.map(node => ({ node })),
    };
  }

  // Audit Log Operations
  async fetchAuditLogs(first?: number, after?: string, userId?: string, action?: string, entityType?: string): Promise<AuditLogsQueryResponse['auditLogs']> {
    await this.simulateLatency();
    let filteredLogs = [...this.auditLogs];

    if (userId) filteredLogs = filteredLogs.filter(log => log.userId === userId);
    if (action) filteredLogs = filteredLogs.filter(log => log.action === action);
    if (entityType) filteredLogs = filteredLogs.filter(log => log.entityType === entityType);

    let startIndex = 0;
    if (after) {
      const cursorIndex = filteredLogs.findIndex(log => log.id === after);
      if (cursorIndex !== -1) {
        startIndex = cursorIndex + 1;
      }
    }
    const paginatedLogs = filteredLogs.slice(startIndex, startIndex + (first || AppConfig.PAGINATION_LIMIT_DEFAULT));

    return {
      pageInfo: {
        startCursor: paginatedLogs.length > 0 ? paginatedLogs[0].id : null,
        endCursor: paginatedLogs.length > 0 ? paginatedLogs[paginatedLogs.length - 1].id : null,
        hasNextPage: (startIndex + (first || AppConfig.PAGINATION_LIMIT_DEFAULT)) < filteredLogs.length,
        hasPreviousPage: startIndex > 0,
        __typename: 'PageInfo',
      },
      edges: paginatedLogs.map(node => ({ node })),
    };
  }

  // Approval Requests
  async fetchApprovalRequests(first?: number, after?: string, status?: ApprovalStatus): Promise<ApprovalRequestsQueryResponse['approvalRequests']> {
    await this.simulateLatency();
    let filteredRequests = [...this.approvalRequests];

    if (status) filteredRequests = filteredRequests.filter(req => req.status === status);

    let startIndex = 0;
    if (after) {
      const cursorIndex = filteredRequests.findIndex(req => req.id === after);
      if (cursorIndex !== -1) {
        startIndex = cursorIndex + 1;
      }
    }
    const paginatedRequests = filteredRequests.slice(startIndex, startIndex + (first || AppConfig.PAGINATION_LIMIT_DEFAULT));

    return {
      pageInfo: {
        startCursor: paginatedRequests.length > 0 ? paginatedRequests[0].id : null,
        endCursor: paginatedRequests.length > 0 ? paginatedRequests[paginatedRequests.length - 1].id : null,
        hasNextPage: (startIndex + (first || AppConfig.PAGINATION_LIMIT_DEFAULT)) < filteredRequests.length,
        hasPreviousPage: startIndex > 0,
        __typename: 'PageInfo',
      },
      edges: paginatedRequests.map(node => ({ node })),
    };
  }

  async approveRequest(id: string, approverId: string): Promise<ApprovalRequestNode> {
    await this.simulateLatency();
    const index = this.approvalRequests.findIndex(req => req.id === id);
    if (index === -1) throw new Error(`Approval Request with ID ${id} not found.`);
    this.approvalRequests[index] = {
      ...this.approvalRequests[index],
      status: 'APPROVED',
      approverId: approverId,
      approvedAt: new Date().toISOString(),
    };
    this.auditLogs.push({
      id: this.generateId('aud'), userId: approverId, action: 'APPROVE_REQUEST', entityType: 'APPROVAL_REQUEST', entityId: id, timestamp: new Date().toISOString(), details: { type: this.approvalRequests[index].type, entityId: this.approvalRequests[index].entityId }
    });
    return this.approvalRequests[index];
  }

  async rejectRequest(id: string, approverId: string, reason?: string): Promise<ApprovalRequestNode> {
    await this.simulateLatency();
    const index = this.approvalRequests.findIndex(req => req.id === id);
    if (index === -1) throw new Error(`Approval Request with ID ${id} not found.`);
    this.approvalRequests[index] = {
      ...this.approvalRequests[index],
      status: 'REJECTED',
      approverId: approverId,
      approvedAt: new Date().toISOString(),
      details: { ...this.approvalRequests[index].details, rejectionReason: reason },
    };
    this.auditLogs.push({
      id: this.generateId('aud'), userId: approverId, action: 'REJECT_REQUEST', entityType: 'APPROVAL_REQUEST', entityId: id, timestamp: new Date().toISOString(), details: { type: this.approvalRequests[index].type, entityId: this.approvalRequests[index].entityId, reason }
    });
    return this.approvalRequests[index];
  }

  // Reports
  async fetchReports(): Promise<Report[]> {
    await this.simulateLatency();
    return this.reports;
  }

  async generateReport(type: Report['type'], parameters: Record<string, any>, generatedBy: AuthUser): Promise<Report> {
    await this.simulateLatency();
    const newReport: Report = {
      id: this.generateId('rpt'),
      name: `${type} Report - ${new Date().toLocaleDateString()}`,
      type: type,
      generatedBy: { id: generatedBy.id, username: generatedBy.username },
      generatedAt: new Date().toISOString(),
      parameters: parameters,
      dataUrl: `/api/reports/${this.generateId('file')}.pdf`, // Mock URL
      status: 'GENERATING',
    };
    this.reports.push(newReport);

    // Simulate report generation process
    setTimeout(() => {
      const reportIndex = this.reports.findIndex(r => r.id === newReport.id);
      if (reportIndex !== -1) {
        this.reports[reportIndex].status = 'COMPLETED';
        this.auditLogs.push({
          id: this.generateId('aud'), userId: generatedBy.id, action: 'REPORT_GENERATED', entityType: 'REPORT', entityId: newReport.id, timestamp: new Date().toISOString(), details: { type, parameters }
        });
      }
    }, Math.random() * 5000 + 1000); // 1-6 seconds to generate

    return newReport;
  }

  // System Settings
  async fetchSystemSettings(): Promise<SystemSetting[]> {
    await this.simulateLatency();
    return this.systemSettings;
  }

  async updateSystemSetting(key: string, value: any, updatedBy: AuthUser): Promise<SystemSetting> {
    await this.simulateLatency();
    const index = this.systemSettings.findIndex(s => s.key === key);
    if (index === -1) throw new Error(`Setting with key ${key} not found.`);

    const oldSetting = { ...this.systemSettings[index] };
    this.systemSettings[index] = {
      ...this.systemSettings[index],
      value: value,
      lastUpdatedBy: updatedBy.id,
      lastUpdatedAt: new Date().toISOString(),
    };
    this.auditLogs.push({
      id: this.generateId('aud'), userId: updatedBy.id, action: 'UPDATE_SYSTEM_SETTING', entityType: 'SYSTEM_SETTING', entityId: key, timestamp: new Date().toISOString(), details: { old: oldSetting.value, new: this.systemSettings[index].value }
    });
    return this.systemSettings[index];
  }
}

export const mockApiService = new MockApiService(); // Export the mock service

// Apollo Client setup to use the mock service
const authLink = setContext((_, { headers }) => {
  // get the authentication token from local storage if it exists
  const token = localStorage.getItem('authToken');
  // return the headers to the context so httpLink can read them
  return {
    headers: {
      ...headers,
      authorization: token ? `Bearer ${token}` : "",
    }
  }
});

const errorLink = onError(({ graphQLErrors, networkError }) => {
  if (graphQLErrors)
    graphQLErrors.forEach(({ message, locations, path }) =>
      console.error(
        `[GraphQL error]: Message: ${message}, Location: ${locations}, Path: ${path}`
      )
    );
  if (networkError) console.error(`[Network error]: ${networkError}`);
});

// A custom ApolloLink that intercepts GraphQL operations and routes them to our mock service
export class MockLink extends ApolloLink {
  private mockApiService: MockApiService;
  private currentUser: AuthUser | null = null; // Stored here for mock backend logic

  constructor(service: MockApiService) {
    super();
    this.mockApiService = service;
    const userString = localStorage.getItem('currentUser');
    if (userString) {
      this.currentUser = JSON.parse(userString);
    }
  }

  public setCurrentUser(user: AuthUser | null) {
    this.currentUser = user;
    if (user) {
      localStorage.setItem('currentUser', JSON.stringify(user));
    } else {
      localStorage.removeItem('currentUser');
    }
  }

  request(operation: any) {
    return new Promise(async (resolve, reject) => {
      const { operationName, variables, query } = operation;

      try {
        let result: any;
        // console.log(`Mocking GraphQL operation: ${operationName}`, variables);

        if (this.systemSettings.find(s => s.key === 'maintenanceMode')?.value && operationName !== 'Login') {
          throw new Error(getTranslatedText('systemMaintenance', this.currentUser?.preferredLanguage || 'en'));
        }

        switch (operationName) {
          case 'Login':
            const loginResult = await this.mockApiService.login(variables.username, variables.password);
            this.setCurrentUser(loginResult?.user || null); // Update current user
            result = { data: { login: loginResult } };
            break;
          case 'Me':
            result = { data: { me: this.currentUser ? await this.mockApiService.fetchMe(this.currentUser.id) : null } };
            break;
          case 'AccountGroupView':
            result = { data: { accountGroup: await this.mockApiService.fetchAccountGroup(variables.id, variables.first, variables.after) } };
            break;
          case 'AllAccountGroups':
            result = { data: { accountGroups: await this.mockApiService.fetchAccountGroups() } };
            break;
          case 'CreateAccountGroup':
            if (!this.currentUser) throw new Error('Authentication required.');
            result = { data: { createAccountGroup: await this.mockApiService.createAccountGroup(variables.name, variables.currency, variables.description, this.currentUser) } };
            break;
          case 'UpdateAccountGroup':
            if (!this.currentUser) throw new Error('Authentication required.');
            result = { data: { updateAccountGroup: await this.mockApiService.updateAccountGroup(variables.id, variables.name, variables.currency, variables.description, this.currentUser) } };
            break;
          case 'DeleteAccountGroup':
            if (!this.currentUser) throw new Error('Authentication required.');
            result = { data: { deleteAccountGroup: await this.mockApiService.deleteAccountGroup(variables.id, this.currentUser) } };
            break;
          case 'AllUsers':
            result = { data: { users: await this.mockApiService.fetchUsers() } };
            break;
          case 'UpdateUser':
            if (!this.currentUser) throw new Error('Authentication required.');
            result = { data: { updateUser: await this.mockApiService.updateUser(variables.id, variables.input, this.currentUser) } };
            break;
          case 'CreateUser':
            if (!this.currentUser) throw new Error('Authentication required.');
            result = { data: { createUser: await this.mockApiService.createUser(variables.input, this.currentUser) } };
            break;
          case 'TransactionHistory':
            result = { data: { transactions: await this.mockApiService.fetchTransactions(variables.accountId, variables.first, variables.after, variables.startDate, variables.endDate, variables.type, variables.status) } };
            break;
          case 'AuditLogs':
            result = { data: { auditLogs: await this.mockApiService.fetchAuditLogs(variables.first, variables.after, variables.userId, variables.action, variables.entityType) } };
            break;
          case 'ApprovalRequests':
            result = { data: { approvalRequests: await this.mockApiService.fetchApprovalRequests(variables.first, variables.after, variables.status) } };
            break;
          case 'ApproveRequest':
            if (!this.currentUser) throw new Error('Authentication required.');
            result = { data: { approveRequest: await this.mockApiService.approveRequest(variables.id, this.currentUser.id) } };
            break;
          case 'RejectRequest':
            if (!this.currentUser) throw new Error('Authentication required.');
            result = { data: { rejectRequest: await this.mockApiService.rejectRequest(variables.id, this.currentUser.id, variables.reason) } };
            break;
          case 'AllReports':
            result = { data: { reports: await this.mockApiService.fetchReports() } };
            break;
          case 'GenerateReport':
            if (!this.currentUser) throw new Error('Authentication required.');
            result = { data: { generateReport: await this.mockApiService.generateReport(variables.type, variables.parameters, this.currentUser) } };
            break;
          case 'SystemSettings':
            result = { data: { systemSettings: await this.mockApiService.fetchSystemSettings() } };
            break;
          case 'UpdateSystemSetting':
            if (!this.currentUser) throw new Error('Authentication required.');
            result = { data: { updateSystemSetting: await this.mockApiService.updateSystemSetting(variables.key, variables.value, this.currentUser) } };
            break;
          default:
            // Fallback for actual HTTP link if the mock doesn't handle it
            // In a real dev environment, you'd chain to HttpLink.
            // For this exercise, we'll just throw if not mocked.
            console.warn(`Operation ${operationName} not mocked. Falling back to HTTP link.`);
            const httpLink = new HttpLink({ uri: AppConfig.GRAPHQL_ENDPOINT });
            return httpLink.request(operation).subscribe({
              next: resolve,
              error: reject,
              complete: () => {},
            });
        }
        resolve(result);
      } catch (error: any) {
        console.error('Mock API Error:', error);
        reject(error);
      }
    });
  }
  private systemSettings: SystemSetting[] = mockApiService.fetchSystemSettings(); // To access maintenance mode
}

export const mockLink = new MockLink(mockApiService);

export const apolloClient = new ApolloClient({
  link: ApolloLink.from([errorLink, authLink, mockLink]), // Use mockLink for local development/testing
  cache: new InMemoryCache(),
  defaultOptions: {
    watchQuery: {
      fetchPolicy: 'cache-and-network',
      errorPolicy: 'all',
    },
    query: {
      fetchPolicy: 'network-only', // Ensure fresh data for queries
      errorPolicy: 'all',
    },
    mutate: {
      errorPolicy: 'all',
    },
  },
});

