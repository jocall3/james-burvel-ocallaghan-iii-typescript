  ];

  private generateId(prefix: string): string {
    return `${prefix}-${Math.random().toString(36).substr(2, 9)}`;
  }

  private generateMockAccountGroups(count: number): AccountGroup[] {
    const groups: AccountGroup[] = [];
    const currencies = ['USD', 'EUR', 'GBP', 'JPY'];
    const users = this.users.map(u => ({ id: u.id, username: u.username }));

    for (let i = 1; i <= count; i++) {
      const groupId = this.generateId('grp');
      const currency = currencies[Math.floor(Math.random() * currencies.length)];
      const internalAccounts: InternalAccountNode[] = [];
      const numAccounts = Math.floor(Math.random() * 5) + 1; // 1-5 accounts per group

      for (let j = 1; j <= numAccounts; j++) {
        internalAccounts.push({
          id: this.generateId('acc'),
          longName: `Account ${j} for Group ${i}`,
          balance: parseFloat((Math.random() * 100000 + 1000).toFixed(2)),
          type: j % 2 === 0 ? 'CHECKING' : 'SAVINGS',
          status: 'ACTIVE',
          currency: currency,
        });
      }

      groups.push({
        id: groupId,
        name: `Account Group ${i}`,
        currency: currency,
        description: `Description for Account Group ${i}`,
        internalAccounts: {
          pageInfo: {
            startCursor: '1', endCursor: String(numAccounts), hasNextPage: false, hasPreviousPage: false,
          },
          edges: internalAccounts.map(node => ({ node })),
        },
        groupMembers: [users[0]],
        createdAt: new Date(Date.now() - Math.random() * 365 * 24 * 60 * 60 * 1000).toISOString(),
        updatedAt: new Date().toISOString(),
        createdBy: users[0],
        lastModifiedBy: users[0],
        transactionSummary: {
          totalTransactions: Math.floor(Math.random() * 500),
          totalDebit: parseFloat((Math.random() * 500000).toFixed(2)),
          totalCredit: parseFloat((Math.random() * 500000).toFixed(2)),
          averageDailyBalance: parseFloat((Math.random() * 100000).toFixed(2)),
        },
      });
    }
    return groups;
  }

  private generateMockTransactions(accountGroups: AccountGroup[]): Transaction[] {
    const transactions: Transaction[] = [];
    accountGroups.forEach(group => {
      group.internalAccounts.edges.forEach(accEdge => {
        const account = accEdge.node;
        for (let i = 0; i < 20; i++) { // 20 transactions per account
          const type = Math.random() > 0.5 ? 'DEBIT' : 'CREDIT';
          const amount = parseFloat((Math.random() * 5000 + 10).toFixed(2));
          const date = new Date(Date.now() - Math.random() * 30 * 24 * 60 * 60 * 1000).toISOString();
          const status = Math.random() > 0.9 ? 'FAILED' : (Math.random() > 0.1 ? 'COMPLETED' : 'PENDING');
          const category = ['Groceries', 'Salary', 'Rent', 'Utilities', 'Investment', 'Transfer'][Math.floor(Math.random() * 6)];
          const balanceAfter = account.balance + (type === 'CREDIT' ? amount : -amount) * (i % 2 === 0 ? 1 : -1); // Simplified
          transactions.push({
            id: this.generateId('trn'),
            accountId: account.id,
            date: date,
            description: `${type} transaction for ${category}`,
            amount: amount,
            currency: account.currency,
            type: type,
            status: status,
            category: category,
            balanceAfter: parseFloat(balanceAfter.toFixed(2)),
            initiatorId: this.users[0].id,
            approvalStatus: status === 'PENDING' ? 'PENDING' : 'APPROVED',
          });
        }
      });
    });
    return transactions.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
  }

  private generateMockAuditLogs(): AuditLog[] {
    const logs: AuditLog[] = [];
    const actions = ['LOGIN', 'CREATE_ACCOUNT_GROUP', 'UPDATE_ACCOUNT_GROUP', 'DELETE_ACCOUNT_GROUP', 'VIEW_TRANSACTIONS', 'REPORT_GENERATED'];
    const entityTypes = ['USER', 'ACCOUNT_GROUP', 'TRANSACTION', 'REPORT'];
    for (let i = 0; i < 50; i++) {
      const userId = this.users[Math.floor(Math.random() * this.users.length)].id;
      const action = actions[Math.floor(Math.random() * actions.length)];
      const entityType = entityTypes[Math.floor(Math.random() * entityTypes.length)];
      const entityId = this.generateId('ent');
      const timestamp = new Date(Date.now() - Math.random() * 365 * 24 * 60 * 60 * 1000).toISOString();
      logs.push({
        id: this.generateId('aud'),
        userId,
        action,
        entityType,
        entityId,
        timestamp,
        details: { oldValue: '...', newValue: '...' },
      });
    }
    return logs.sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());
  }

  private generateMockApprovalRequests(): ApprovalRequestNode[] {
    const requests: ApprovalRequestNode[] = [];
    const types: ApprovalType[] = ['ACCOUNT_EDIT', 'TRANSACTION', 'USER_ROLE_CHANGE', 'GROUP_CREATION'];
    const statuses: ApprovalStatus[] = ['PENDING', 'APPROVED', 'REJECTED'];
    for (let i = 0; i < 10; i++) {
      const requestedBy = this.users[Math.floor(Math.random() * this.users.length)];
      const type = types[Math.floor(Math.random() * types.length)];
      const status = statuses[Math.floor(Math.random() * statuses.length)];
      requests.push({
        id: this.generateId('apr'),
        type: type,
        entityId: this.generateId('ent'),
        requestedBy: { id: requestedBy.id, username: requestedBy.username },
        requestedAt: new Date(Date.now() - Math.random() * 7 * 24 * 60 * 60 * 1000).toISOString(),
