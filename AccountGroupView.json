class MockApiService {
  private users: AuthUser[] = [
    { id: 'usr-1', username: 'admin', firstName: 'Admin', lastName: 'User', email: 'admin@bank.com', roles: ['ADMIN', 'MANAGER'], preferredLanguage: 'en', lastLogin: new Date().toISOString(), twoFactorEnabled: true },
    { id: 'usr-2', username: 'john.doe', firstName: 'John', lastName: 'Doe', email: 'john.doe@bank.com', roles: ['ANALYST'], preferredLanguage: 'en', lastLogin: new Date().toISOString(), twoFactorEnabled: false },
    { id: 'usr-3', username: 'jane.smith', firstName: 'Jane', lastName: 'Smith', email: 'jane.smith@bank.com', roles: ['VIEWER'], preferredLanguage: 'es', lastLogin: new Date().toISOString(), twoFactorEnabled: true },
    { id: 'usr-4', username: 'manager', firstName: 'Mike', lastName: 'Manager', email: 'mike.m@bank.com', roles: ['MANAGER'], preferredLanguage: 'en', lastLogin: new Date().toISOString(), twoFactorEnabled: true },
  ];
  private accountGroups: AccountGroup[] = this.generateMockAccountGroups(5);
  private transactions: Transaction[] = this.generateMockTransactions(this.accountGroups);
  private auditLogs: AuditLog[] = this.generateMockAuditLogs();
