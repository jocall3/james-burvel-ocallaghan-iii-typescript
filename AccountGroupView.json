/**
 * Helper to get translated text.
 */
export const getTranslatedText = (key: keyof typeof i18n['en'], lang: keyof typeof Languages, replacements?: { [key: string]: string | number }) => {
  let text = i18n[lang]?.[key] || i18n.en[key] || key; // Fallback to English, then key itself
  if (replacements) {
    for (const placeholder in replacements) {
      text = text.replace(new RegExp(`{{${placeholder}}}`, 'g'), String(replacements[placeholder]));
    }
  }
  return text;
};

