export const AccountGroupsPage: React.FC = () => {
  const { t } = useLanguage();
  const { user } = useAuth();
  const navigate = useNavigate();
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [newGroupName, setNewGroupName] = useState('');
  const [newGroupCurrency, setNewGroupCurrency] = useState('USD');
  const [newGroupDescription, setNewGroupDescription] = useState('');
  const [formErrors, setFormErrors] = useState<{ [key: string]: string }>({});
  const [successMessage, setSuccessMessage] = useState<string | null>(null);

  const { data, loading, error, refetch } = useQuery<AllAccountGroupsResponse>(ALL_ACCOUNT_GROUPS_QUERY);
  const [createGroup, { loading: creatingGroup }] = useMutation(CREATE_ACCOUNT_GROUP_MUTATION, {
    onCompleted: () => {
      setSuccessMessage(t('groupCreatedSuccess', { name: newGroupName }));
      setNewGroupName('');
      setNewGroupCurrency('USD');
      setNewGroupDescription('');
      setIsModalOpen(false);
      refetch();
    },
    onError: (err) => setFormErrors({ submit: err.message }),
  });

  const validateForm = () => {
    const errors: { [key: string]: string } = {};
    if (!newGroupName.trim()) errors.name = t('fieldRequired');
    if (!newGroupCurrency.trim()) errors.currency = t('fieldRequired');
    else if (!/^[A-Z]{3}$/.test(newGroupCurrency.toUpperCase())) errors.currency = t('invalidCurrencyCode');
    setFormErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handleCreateGroup = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormErrors({});
    if (!validateForm()) return;

    try {
      if (!user) throw new Error("User not authenticated.");
      await createGroup({
        variables: {
          name: newGroupName,
          currency: newGroupCurrency.toUpperCase(),
          description: newGroupDescription,
        },
      });
    } catch (err: any) {
      setFormErrors({ submit: err.message });
    }
  };

  const accountGroups = data?.accountGroups || [];
  const { paginatedItems, currentPage, totalPages, goToNextPage, goToPreviousPage, canGoNext, canGoPrevious } = usePagination(accountGroups);

  if (loading) return <Spinner />;
  if (error) return <Alert type="error">{t('error')}: {error.message}</Alert>;

  const canCreate = hasAccess(user?.roles || [], ['ADMIN', 'MANAGER']);

  return (
    <Container>
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-3xl font-bold">{t('accountGroups')}</h1>
        {canCreate && (
          <Button onClick={() => setIsModalOpen(true)} variant="primary">
            {t('createAccountGroup')}
          </Button>
        )}
      </div>

      {successMessage && <Alert type="success" className="mb-4">{successMessage}</Alert>}

      {paginatedItems.length === 0 ? (
        <Alert type="info">{t('noAccountsFound')}</Alert>
      ) : (
        <>
          <Table>
            <TableHead>
              <TableHeader>{t('groupName')}</TableHeader>
              <TableHeader>{t('currency')}</TableHeader>
              <TableHeader>{t('description')}</TableHeader>
              <TableHeader># {t('internalAccounts')}</TableHeader>
              <TableHeader>{t('action')}</TableHeader>
            </TableHead>
            <TableBody>
              {paginatedItems.map((group) => (
                <TableRow key={group.id}>
                  <TableCell className="font-medium">{group.name}</TableCell>
                  <TableCell>{group.currency}</TableCell>
                  <TableCell>{group.description || '-'}</TableCell>
                  <TableCell>{group.internalAccounts.edges.length}</TableCell>
                  <TableCell>
                    <Link to={`/account-groups/${group.id}`} className="text-blue-600 hover:underline mr-2">
                      {t('viewDetails')}
                    </Link>
                    {hasAccess(user?.roles || [], ['ADMIN', 'MANAGER']) && (
                      <Link to={`/account-groups/${group.id}/edit`} className="text-green-600 hover:underline">
                        {t('editGroup')}
                      </Link>
                    )}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>

          <div className="flex justify-between items-center mt-6">
            <Button onClick={goToPreviousPage} disabled={!canGoPrevious} variant="secondary">
              {t('previous')}
            </Button>
            <span className="text-sm text-gray-700 dark:text-gray-300">
              {t('pagination', { currentPage, totalPages })}
            </span>
            <Button onClick={goToNextPage} disabled={!canGoNext} variant="secondary">
              {t('next')}
            </Button>
          </div>
        </>
      )}

      <Modal isOpen={isModalOpen} onClose={() => setIsModalOpen(false)} title={t('createAccountGroup')}>
        <form onSubmit={handleCreateGroup}>
          {formErrors.submit && <Alert type="error">{formErrors.submit}</Alert>}
          <FormField label={t('newGroupName')} htmlFor="newGroupName" error={formErrors.name}>
            <Input
              id="newGroupName"
              value={newGroupName}
              onChange={(e) => setNewGroupName(e.target.value)}
            />
          </FormField>
          <FormField label={t('newGroupCurrency')} htmlFor="newGroupCurrency" error={formErrors.currency}>
            <Input
              id="newGroupCurrency"
              value={newGroupCurrency}
              onChange={(e) => setNewGroupCurrency(e.target.value)}
              placeholder="USD, EUR, GBP"
            />
          </FormField>
          <FormField label={t('newGroupDescription')} htmlFor="newGroupDescription">
            <Textarea
              id="newGroupDescription"
              value={newGroupDescription}
              onChange={(e) => setNewGroupDescription(e.target.value)}
              rows={3}
            />
          </FormField>
          <div className="flex justify-end space-x-2 mt-4">
            <Button onClick={() => setIsModalOpen(false)} variant="secondary">
              {t('cancel')}
            </Button>
            <Button type="submit" variant="primary" disabled={creatingGroup}>
              {creatingGroup ? <Spinner className="h-5 w-5 border-white" /> : t('addGroup')}
            </Button>
          </div>
        </form>
      </Modal>
    </Container>
  );
};

export const AccountGroupDetailsPage: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const { t } = useLanguage();
  const navigate = useNavigate();
  const { user } = useAuth();
  const [currentPage, setCurrentPage] = useState(1);
  const itemsPerPage = AppConfig.PAGINATION_LIMIT_DEFAULT; // Hardcode for GraphQL paging
  const [afterCursor, setAfterCursor] = useState<string | null>(null);
  const [beforeCursor, setBeforeCursor] = useState<string | null>(null);
  const [deleteModalOpen, setDeleteModalOpen] = useState(false);
  const [deleteErrorMessage, setDeleteErrorMessage] = useState<string | null>(null);

  const { data, loading, error, fetchMore, refetch } = useQuery<
    AccountGroupViewQueryResponse,
    AccountGroupViewQueryVariables
  >(ACCOUNT_GROUP_VIEW_QUERY, {
    variables: { id: id!, first: itemsPerPage, after: afterCursor },
    skip: !id,
  });

  const [deleteGroupMutation, { loading: deletingGroup }] = useMutation(DELETE_ACCOUNT_GROUP_MUTATION, {
    onCompleted: () => {
      navigate('/account-groups', { state: { successMessage: t('groupDeletedSuccess', { name: data?.accountGroup.name || '' }) } });
    },
    onError: (err) => {
      setDeleteErrorMessage(err.message);
    },
  });

  const accountGroup = data?.accountGroup;
  const pageInfo = accountGroup?.internalAccounts.pageInfo;

  const handleNextPage = useCallback(() => {
    if (pageInfo?.hasNextPage) {
      setBeforeCursor(null); // Clear before cursor when moving forward
      setAfterCursor(pageInfo.endCursor);
      setCurrentPage(prev => prev + 1);
      fetchMore({
        variables: { id: id!, first: itemsPerPage, after: pageInfo.endCursor, before: undefined },
        updateQuery: (prev, { fetchMoreResult }) => {
          if (!fetchMoreResult) return prev;
          return fetchMoreResult;
        },
      });
    }
  }, [pageInfo, id, itemsPerPage, fetchMore]);

  const handlePreviousPage = useCallback(() => {
    // For simplicity, this mock setup doesn't fully support `before` cursor with `first`.
    // A real implementation would fetch `last` items `before` the `startCursor`.
    // Here, we'll just simulate a step back if possible or refetch first page.
    if (currentPage > 1) {
      setCurrentPage(prev => prev - 1);
      setAfterCursor(null);
      setBeforeCursor(pageInfo?.startCursor || null); // This is a simplification; a real API might require 'last'
      refetch({ first: itemsPerPage, after: null, before: pageInfo?.startCursor }); // This refetch logic is not ideal for true `before` pagination
    }
  }, [pageInfo, currentPage, itemsPerPage, refetch]);

  const handleDelete = async () => {
    if (!id || !user) return;
    try {
      await deleteGroupMutation({ variables: { id } });
    } catch (e) {
      console.error('Delete failed:', e);
    }
  };

  if (loading) return <Spinner />;
  if (error) return <Alert type="error">{t('error')}: {error.message}</Alert>;
  if (!accountGroup) return <Alert type="warning">{t('error')}: Account Group not found.</Alert>;

  const canEditOrDelete = hasAccess(user?.roles || [], ['ADMIN', 'MANAGER']);

  return (
    <Container>
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-3xl font-bold">{t('accountGroupDetails')}</h1>
        <div>
          {canEditOrDelete && (
            <>
              <Button onClick={() => navigate(`/account-groups/${id}/edit`)} variant="secondary" className="mr-2">
                {t('editGroup')}
              </Button>
              <Button onClick={() => setDeleteModalOpen(true)} variant="danger">
                {t('deleteGroup')}
              </Button>
            </>
          )}
        </div>
      </div>

      <Card>
        <h2 className="text-xl font-semibold mb-4">{accountGroup.name}</h2>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <p className="text-gray-600 dark:text-gray-400">{t('groupName')}:</p>
            <p className="font-medium">{accountGroup.name}</p>
          </div>
          <div>
            <p className="text-gray-600 dark:text-gray-400">{t('currency')}:</p>
            <p className="font-medium">{accountGroup.currency}</p>
          </div>
          <div className="md:col-span-2">
            <p className="text-gray-600 dark:text-gray-400">{t('description')}:</p>
            <p className="font-medium">{accountGroup.description || '-'}</p>
          </div>
          <div>
            <p className="text-gray-600 dark:text-gray-400">Created At:</p>
            <p className="font-medium">{formatDate(accountGroup.createdAt)} by {accountGroup.createdBy?.username || 'N/A'}</p>
          </div>
          <div>
            <p className="text-gray-600 dark:text-gray-400">Last Updated At:</p>
            <p className="font-medium">{formatDate(accountGroup.updatedAt)} by {accountGroup.lastModifiedBy?.username || 'N/A'}</p>
          </div>
        </div>
      </Card>

      <Card className="mt-6">
        <h2 className="text-xl font-semibold mb-4">{t('internalAccounts')}</h2>
        {accountGroup.internalAccounts.edges.length === 0 ? (
          <Alert type="info">{t('noAccountsFound')}</Alert>
        ) : (
          <>
            <Table>
              <TableHead>
                <TableHeader>{t('id')}</TableHeader>
                <TableHeader>{t('longName')}</TableHeader>
                <TableHeader>Balance</TableHeader>
                <TableHeader>{t('type')}</TableHeader>
                <TableHeader>{t('status')}</TableHeader>
                <TableHeader>{t('action')}</TableHeader>
              </TableHead>
              <TableBody>
                {accountGroup.internalAccounts.edges.map((edge) => (
                  <TableRow key={edge.node.id}>
                    <TableCell>{edge.node.id}</TableCell>
                    <TableCell>{edge.node.longName}</TableCell>
                    <TableCell className="font-mono">{formatCurrency(edge.node.balance, edge.node.currency)}</TableCell>
                    <TableCell>{edge.node.type}</TableCell>
                    <TableCell>{edge.node.status}</TableCell>
                    <TableCell>
                      <Link to={`/transactions?accountId=${edge.node.id}`} className="text-blue-600 hover:underline">
                        View Transactions
                      </Link>
                    </TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>

            <div className="flex justify-between items-center mt-6">
              <Button onClick={handlePreviousPage} disabled={!pageInfo?.hasPreviousPage} variant="secondary">
                {t('previous')}
              </Button>
              <span className="text-sm text-gray-700 dark:text-gray-300">
                Page {currentPage} of {pageInfo?.hasNextPage ? '...' : currentPage}
              </span>
              <Button onClick={handleNextPage} disabled={!pageInfo?.hasNextPage} variant="secondary">
                {t('next')}
              </Button>
            </div>
          </>
        )}
      </Card>

      <Modal isOpen={deleteModalOpen} onClose={() => setDeleteModalOpen(false)} title={t('confirmDelete', { name: accountGroup.name })}>
        {deleteErrorMessage && <Alert type="error">{deleteErrorMessage}</Alert>}
        <p className="mb-4">{t('confirmDelete', { name: accountGroup.name })}</p>
        <div className="flex justify-end space-x-2">
          <Button onClick={() => setDeleteModalOpen(false)} variant="secondary">
            {t('cancel')}
          </Button>
          <Button onClick={handleDelete} variant="danger" disabled={deletingGroup}>
            {deletingGroup ? <Spinner className="h-5 w-5 border-white" /> : t('deleteGroup')}
          </Button>
        </div>
      </Modal>
    </Container>
  );
};

export const EditAccountGroupPage: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const navigate = useNavigate();
  const { user } = useAuth();
  const { t } = useLanguage();

  const { data, loading, error } = useQuery<AccountGroupViewQueryResponse, AccountGroupViewQueryVariables>(
    ACCOUNT_GROUP_VIEW_QUERY,
    { variables: { id: id! }, skip: !id }
  );

  const [name, setName] = useState('');
  const [currency, setCurrency] = useState('');
  const [description, setDescription] = useState('');
  const [formErrors, setFormErrors] = useState<{ [key: string]: string }>({});
  const [successMessage, setSuccessMessage] = useState<string | null>(null);

  useEffect(() => {
    if (data?.accountGroup) {
      setName(data.accountGroup.name);
      setCurrency(data.accountGroup.currency);
      setDescription(data.accountGroup.description);
    }
  }, [data]);

  const [updateGroup, { loading: updatingGroup }] = useMutation(UPDATE_ACCOUNT_GROUP_MUTATION, {
    onCompleted: () => {
      setSuccessMessage(t('groupUpdatedSuccess', { name: name }));
      setTimeout(() => navigate(`/account-groups/${id}`), 2000);
    },
    onError: (err) => setFormErrors({ submit: err.message }),
  });

  const validateForm = () => {
    const errors: { [key: string]: string } = {};
    if (!name.trim()) errors.name = t('fieldRequired');
    if (!currency.trim()) errors.currency = t('fieldRequired');
    else if (!/^[A-Z]{3}$/.test(currency.toUpperCase())) errors.currency = t('invalidCurrencyCode');
    setFormErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormErrors({});
    if (!validateForm()) return;

    try {
      if (!user) throw new Error("User not authenticated.");
      await updateGroup({
        variables: { id: id!, name, currency: currency.toUpperCase(), description },
      });
    } catch (err: any) {
      setFormErrors({ submit: err.message });
    }
  };

  if (loading) return <Spinner />;
  if (error) return <Alert type="error">{t('error')}: {error.message}</Alert>;
  if (!data?.accountGroup) return <Alert type="warning">{t('error')}: Account Group not found.</Alert>;

  if (!hasAccess(user?.roles || [], ['ADMIN', 'MANAGER'])) {
    return <AccessDeniedPage />;
  }

  return (
    <Container>
      <h1 className="text-3xl font-bold mb-6">{t('editGroup')}: {data.accountGroup.name}</h1>
      <Card>
        {successMessage && <Alert type="success">{successMessage}</Alert>}
        {formErrors.submit && <Alert type="error">{formErrors.submit}</Alert>}
        <form onSubmit={handleSubmit}>
          <FormField label={t('groupName')} htmlFor="groupName" error={formErrors.name}>
            <Input id="groupName" value={name} onChange={(e) => setName(e.target.value)} />
          </FormField>
          <FormField label={t('currency')} htmlFor="currency" error={formErrors.currency}>
            <Input id="currency" value={currency} onChange={(e) => setCurrency(e.target.value)} />
          </FormField>
          <FormField label={t('description')} htmlFor="description">
            <Textarea id="description" value={description} onChange={(e) => setDescription(e.target.value)} rows={4} />
          </FormField>
          <div className="flex justify-end space-x-2 mt-6">
            <Button onClick={() => navigate(`/account-groups/${id}`)} variant="secondary">
              {t('cancel')}
            </Button>
            <Button type="submit" variant="primary" disabled={updatingGroup}>
              {updatingGroup ? <Spinner className="h-5 w-5 border-white" /> : t('saveChanges')}
            </Button>
          </div>
        </form>
      </Card>
    </Container>
  );
};

export const TransactionsPage: React.FC = () => {
  const { t } = useLanguage();
  const { user } = useAuth();
  const location = useLocation();
  const queryParams = new URLSearchParams(location.search);
  const initialAccountId = queryParams.get('accountId') || '';

  const [accountId, setAccountId] = useState(initialAccountId);
  const [startDate, setStartDate] = useState('');
  const [endDate, setEndDate] = useState('');
  const [transactionType, setTransactionType] = useState('');
  const [transactionStatus, setTransactionStatus] = useState('');

  const [currentPage, setCurrentPage] = useState(1);
  const itemsPerPage = AppConfig.PAGINATION_LIMIT_DEFAULT;
  const [afterCursor, setAfterCursor] = useState<string | null>(null);

  const { data: accountsData, loading: accountsLoading, error: accountsError } = useQuery<AllAccountGroupsResponse>(ALL_ACCOUNT_GROUPS_QUERY);
  const allInternalAccounts = useMemo(() => {
    if (!accountsData) return [];
    return accountsData.accountGroups.flatMap(group =>
      group.internalAccounts.edges.map(edge => ({ ...edge.node, groupName: group.name }))
    );
  }, [accountsData]);

  const { data: transactionsData, loading: transactionsLoading, error: transactionsError, fetchMore } = useQuery<
    TransactionHistoryQueryResponse,
    any // Variables are complex, using 'any' for brevity
  >(TRANSACTION_HISTORY_QUERY, {
    variables: {
      accountId: accountId || undefined,
      first: itemsPerPage,
      after: afterCursor,
      startDate: startDate || undefined,
      endDate: endDate || undefined,
      type: transactionType || undefined,
      status: transactionStatus || undefined,
    },
    skip: !accountId,
  });

  const transactions = transactionsData?.transactions.edges.map(e => e.node) || [];
  const pageInfo = transactionsData?.transactions.pageInfo;

  const handleApplyFilters = () => {
    setAfterCursor(null); // Reset pagination on filter change
    setCurrentPage(1);
    // Refetch is implicitly handled by `useQuery` when variables change
  };

  const handleClearFilters = () => {
    setAccountId('');
    setStartDate('');
    setEndDate('');
    setTransactionType('');
    setTransactionStatus('');
    setAfterCursor(null);
    setCurrentPage(1);
  };

  const handleNextPage = useCallback(() => {
    if (pageInfo?.hasNextPage) {
      setAfterCursor(pageInfo.endCursor);
      setCurrentPage(prev => prev + 1);
      fetchMore({
        variables: { first: itemsPerPage, after: pageInfo.endCursor },
        updateQuery: (prev, { fetchMoreResult }) => fetchMoreResult || prev,
      });
    }
  }, [pageInfo, itemsPerPage, fetchMore]);

  const handlePreviousPage = useCallback(() => {
    // GraphQL connections often make `before` pagination more complex than `after`.
    // For this mock, we'll simulate going back to the "previous page" by clearing `after` and letting the query refetch the first page (or previous if API supported `before` cursor with `last`).
    // A robust solution would involve storing a history of cursors or fetching `last` items `before` the current `startCursor`.
    if (currentPage > 1) {
      setCurrentPage(prev => prev - 1);
      setAfterCursor(null); // Simple reset, might refetch initial data and need to manually advance
      // In a real paginated system, `fetchMore` with `last` and `before` would be used here.
      // For now, it will fetch the first page again, which isn't true backward pagination but demonstrates the intent.
      fetchMore({
        variables: { first: itemsPerPage, after: null },
        updateQuery: (prev, { fetchMoreResult }) => fetchMoreResult || prev,
      });
    }
  }, [currentPage, itemsPerPage, fetchMore]);

  if (accountsLoading) return <Spinner />;
  if (accountsError) return <Alert type="error">{t('error')}: {accountsError.message}</Alert>;
  if (!user || !hasAccess(user.roles, ['VIEWER'])) {
    return <AccessDeniedPage />;
  }

  const exportToCSV = () => {
    if (transactions.length === 0) {
      alert('No transactions to export.');
      return;
    }
    const headers = [t('date'), t('description'), t('amount'), t('currency'), t('type'), t('status'), t('category'), t('balanceAfter')];
    const csvRows = transactions.map(t =>
      [
        `"${formatDate(t.date)}"`,
        `"${t.description.replace(/"/g, '""')}"`,
        t.amount,
        t.currency,
        t.type,
        t.status,
        `"${t.category.replace(/"/g, '""')}"`,
        t.balanceAfter,
      ].join(',')
    );
    const csvContent = [headers.join(','), ...csvRows].join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    if (link.download !== undefined) {
      const url = URL.createObjectURL(blob);
      link.setAttribute('href', url);
      link.setAttribute('download', `transactions_${new Date().toISOString().slice(0, 10)}.csv`);
      link.style.visibility = 'hidden';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  };

  return (
    <Container>
      <h1 className="text-3xl font-bold mb-6">{t('transactionHistory')}</h1>

      <Card className="mb-6">
        <h2 className="text-xl font-semibold mb-4">Filters</h2>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <FormField label={t('filterByAccount')} htmlFor="filterAccount">
            <Select id="filterAccount" value={accountId} onChange={(e) => setAccountId(e.target.value)}>
              <option value="">{t('allAccounts')}</option>
              {allInternalAccounts.map(account => (
                <option key={account.id} value={account.id}>
                  {account.longName} ({account.groupName})
                </option>
              ))}
            </Select>
          </FormField>
          <FormField label="Start Date" htmlFor="startDate">
            <Input id="startDate" type="date" value={startDate} onChange={(e) => setStartDate(e.target.value)} />
          </FormField>
          <FormField label="End Date" htmlFor="endDate">
            <Input id="endDate" type="date" value={endDate} onChange={(e) => setEndDate(e.target.value)} />
          </FormField>
          <FormField label={t('filterByType')} htmlFor="filterType">
            <Select id="filterType" value={transactionType} onChange={(e) => setTransactionType(e.target.value)}>
              <option value="">All Types</option>
              <option value="DEBIT">Debit</option>
              <option value="CREDIT">Credit</option>
            </Select>
          </FormField>
          <FormField label={t('filterByStatus')} htmlFor="filterStatus">
            <Select id="filterStatus" value={transactionStatus} onChange={(e) => setTransactionStatus(e.target.value)}>
              <option value="">All Statuses</option>
              <option value="PENDING">Pending</option>
              <option value="COMPLETED">Completed</option>
              <option value="FAILED">Failed</option>
            </Select>
          </FormField>
        </div>
        <div className="flex justify-end space-x-2 mt-4">
          <Button onClick={handleClearFilters} variant="secondary">{t('clearFilters')}</Button>
          <Button onClick={handleApplyFilters} variant="primary">{t('applyFilters')}</Button>
        </div>
      </Card>

      {transactionsLoading && <Spinner />}
      {transactionsError && <Alert type="error">{t('error')}: {transactionsError.message}</Alert>}

      {!accountId && <Alert type="info">Please select an account to view transactions.</Alert>}

      {accountId && !transactionsLoading && !transactionsError && transactions.length === 0 ? (
        <Alert type="info">{t('noTransactionsFound')}</Alert>
      ) : (
        accountId && (
          <>
            <Table className="mb-6">
              <TableHead>
                <TableHeader>{t('date')}</TableHeader>
                <TableHeader>{t('description')}</TableHeader>
                <TableHeader>{t('amount')}</TableHeader>
                <TableHeader>{t('type')}</TableHeader>
                <TableHeader>{t('status')}</TableHeader>
                <TableHeader>{t('category')}</TableHeader>
                <TableHeader>{t('balanceAfter')}</TableHeader>
              </TableHead>
              <TableBody>
                {transactions.map(tx => (
                  <TableRow key={tx.id}>
                    <TableCell>{formatDate(tx.date)}</TableCell>
                    <TableCell className="max-w-xs truncate">{tx.description}</TableCell>
                    <TableCell className={tx.type === 'DEBIT' ? 'text-red-600' : 'text-green-600'}>
                      {formatCurrency(tx.amount, tx.currency)}
                    </TableCell>
                    <TableCell>{tx.type}</TableCell>
                    <TableCell>{tx.status}</TableCell>
                    <TableCell>{tx.category}</TableCell>
                    <TableCell>{formatCurrency(tx.balanceAfter, tx.currency)}</TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>

            <div className="flex justify-between items-center mt-6">
              <Button onClick={handlePreviousPage} disabled={!pageInfo?.hasPreviousPage || transactionsLoading} variant="secondary">
                {t('previous')}
              </Button>
              <span className="text-sm text-gray-700 dark:text-gray-300">
                Page {currentPage} of {pageInfo?.hasNextPage ? '...' : currentPage}
              </span>
              <Button onClick={handleNextPage} disabled={!pageInfo?.hasNextPage || transactionsLoading} variant="secondary">
                {t('next')}
              </Button>
            </div>

            <div className="mt-6 text-right">
              <Button onClick={exportToCSV} variant="outline">{t('exportTransactions')}</Button>
            </div>
          </>
        )
      )}
    </Container>
  );
};

export const ReportsPage: React.FC = () => {
  const { t } = useLanguage();
  const { user } = useAuth();
  const [reportType, setReportType] = useState<Report['type']>('TRANSACTION_SUMMARY');
  const [reportParams, setReportParams] = useState<Record<string, any>>({});
  const [formErrors, setFormErrors] = useState<{ [key: string]: string }>({});
  const [successMessage, setSuccessMessage] = useState<string | null>(null);

  const { data, loading, error, refetch } = useQuery<AllReportsQueryResponse>(ALL_REPORTS_QUERY);
  const [generateReport, { loading: generatingReport }] = useMutation(GENERATE_REPORT_MUTATION, {
    onCompleted: () => {
      setSuccessMessage('Report generation initiated successfully!');
      setReportParams({});
      refetch(); // Refetch reports list
    },
    onError: (err) => setFormErrors({ submit: err.message }),
  });

  if (loading) return <Spinner />;
  if (error) return <Alert type="error">{t('error')}: {error.message}</Alert>;

  if (!user || !hasAccess(user.roles, ['ANALYST', 'MANAGER', 'ADMIN'])) {
    return <AccessDeniedPage />;
  }

  const reports = data?.reports || [];

  const handleGenerateReport = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormErrors({});
    setSuccessMessage(null);

    // Basic validation for report parameters
    if (reportType === 'TRANSACTION_SUMMARY' && (!reportParams.startDate || !reportParams.endDate)) {
      setFormErrors({ dates: 'Start and End dates are required for Transaction Summary reports.' });
      return;
    }

    try {
      if (!user) throw new Error("User not authenticated.");
      await generateReport({
        variables: {
          type: reportType,
          parameters: reportParams,
        },
      });
    } catch (err: any) {
      setFormErrors({ submit: err.message });
    }
  };

  const handleDownload = (dataUrl: string, reportName: string) => {
    window.open(dataUrl, '_blank');
  };

  return (
    <Container>
      <h1 className="text-3xl font-bold mb-6">{t('reportGenerator')}</h1>

      <Card className="mb-6">
        <h2 className="text-xl font-semibold mb-4">Generate New Report</h2>
        {successMessage && <Alert type="success">{successMessage}</Alert>}
        {formErrors.submit && <Alert type="error">{formErrors.submit}</Alert>}
        <form onSubmit={handleGenerateReport}>
          <FormField label={t('reportType')} htmlFor="reportType">
            <Select
              id="reportType"
              value={reportType}
              onChange={(e) => setReportType(e.target.value as Report['type'])}
            >
              <option value="TRANSACTION_SUMMARY">Transaction Summary</option>
              <option value="BALANCE_OVERVIEW">Balance Overview</option>
              <option value="AUDIT_TRAIL">Audit Trail</option>
              <option value="USER_ACTIVITY">User Activity</option>
            </Select>
          </FormField>

          <h3 className="text-lg font-semibold mt-4 mb-2">{t('reportParameters')}</h3>
          {formErrors.dates && <Alert type="error">{formErrors.dates}</Alert>}
          {reportType === 'TRANSACTION_SUMMARY' && (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <FormField label="Start Date" htmlFor="paramStartDate">
                <Input
                  id="paramStartDate"
                  type="date"
                  value={reportParams.startDate || ''}
                  onChange={(e) => setReportParams({ ...reportParams, startDate: e.target.value })}
                />
              </FormField>
              <FormField label="End Date" htmlFor="paramEndDate">
                <Input
                  id="paramEndDate"
                  type="date"
                  value={reportParams.endDate || ''}
                  onChange={(e) => setReportParams({ ...reportParams, endDate: e.target.value })}
                />
              </FormField>
              {/* Add more parameters as needed */}
            </div>
          )}
          {reportType === 'AUDIT_TRAIL' && (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <FormField label="User ID (Optional)" htmlFor="paramUserId">
                <Input
                  id="paramUserId"
                  type="text"
                  value={reportParams.userId || ''}
                  onChange={(e) => setReportParams({ ...reportParams, userId: e.target.value })}
                  placeholder="e.g., usr-123"
                />
              </FormField>
              <FormField label="Action Type (Optional)" htmlFor="paramAction">
                <Input
                  id="paramAction"
                  type="text"
                  value={reportParams.action || ''}
                  onChange={(e) => setReportParams({ ...reportParams, action: e.target.value })}
                  placeholder="e.g., LOGIN, CREATE_ACCOUNT_GROUP"
                />
              </FormField>
            </div>
          )}
          {/* Add parameter inputs for other report types */}

          <div className="flex justify-end mt-4">
            <Button type="submit" variant="primary" disabled={generatingReport}>
              {generatingReport ? <Spinner className="h-5 w-5 border-white" /> : t('generateReport')}
            </Button>
          </div>
        </form>
      </Card>

      <Card>
        <h2 className="text-xl font-semibold mb-4">Generated Reports</h2>
        {reports.length === 0 ? (
          <Alert type="info">No reports generated yet.</Alert>
        ) : (
          <Table>
            <TableHead>
              <TableHeader>{t('name')}</TableHeader>
              <TableHeader>{t('reportType')}</TableHeader>
              <TableHeader>{t('reportStatus')}</TableHeader>
              <TableHeader>{t('generatedAt')}</TableHeader>
              <TableHeader>{t('generatedBy')}</TableHeader>
              <TableHeader>{t('action')}</TableHeader>
            </TableHead>
            <TableBody>
              {reports.map((report) => (
                <TableRow key={report.id}>
                  <TableCell>{report.name}</TableCell>
                  <TableCell>{report.type}</TableCell>
                  <TableCell>
                    <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
                      report.status === 'COMPLETED' ? 'bg-green-100 text-green-800' :
                      report.status === 'GENERATING' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-red-100 text-red-800'
                    }`}>
                      {report.status}
                    </span>
                  </TableCell>
                  <TableCell>{formatDate(report.generatedAt)}</TableCell>
                  <TableCell>{report.generatedBy.username}</TableCell>
                  <TableCell>
                    {report.status === 'COMPLETED' && (
                      <Button onClick={() => handleDownload(report.dataUrl, report.name)} variant="outline" className="text-sm">
                        {t('download')}
                      </Button>
                    )}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        )}
      </Card>
    </Container>
  );
};

export const AuditLogsPage: React.FC = () => {
  const { t } = useLanguage();
  const { user } = useAuth();
  const [filterUserId, setFilterUserId] = useState('');
  const [filterAction, setFilterAction] = useState('');
  const [filterEntityType, setFilterEntityType] = useState('');
  const [currentPage, setCurrentPage] = useState(1);
  const itemsPerPage = AppConfig.PAGINATION_LIMIT_DEFAULT;
  const [afterCursor, setAfterCursor] = useState<string | null>(null);

  const { data, loading, error, fetchMore } = useQuery<AuditLogsQueryResponse>(AUDIT_LOGS_QUERY, {
    variables: {
      first: itemsPerPage,
      after: afterCursor,
      userId: filterUserId || undefined,
      action: filterAction || undefined,
      entityType: filterEntityType || undefined,
    },
  });

  const auditLogs = data?.auditLogs.edges.map(e => e.node) || [];
  const pageInfo = data?.auditLogs.pageInfo;

  const handleApplyFilters = () => {
    setAfterCursor(null);
    setCurrentPage(1);
  };

  const handleClearFilters = () => {
    setFilterUserId('');
    setFilterAction('');
    setFilterEntityType('');
    setAfterCursor(null);
    setCurrentPage(1);
  };

  const handleNextPage = useCallback(() => {
    if (pageInfo?.hasNextPage) {
      setAfterCursor(pageInfo.endCursor);
      setCurrentPage(prev => prev + 1);
      fetchMore({
        variables: { first: itemsPerPage, after: pageInfo.endCursor },
        updateQuery: (prev, { fetchMoreResult }) => fetchMoreResult || prev,
      });
    }
  }, [pageInfo, itemsPerPage, fetchMore]);

  const handlePreviousPage = useCallback(() => {
    if (currentPage > 1) {
      setCurrentPage(prev => prev - 1);
      setAfterCursor(null); // Simple reset, similar to transactions page
      fetchMore({
        variables: { first: itemsPerPage, after: null },
        updateQuery: (prev, { fetchMoreResult }) => fetchMoreResult || prev,
      });
    }
  }, [currentPage, itemsPerPage, fetchMore]);

  if (loading) return <Spinner />;
  if (error) return <Alert type="error">{t('error')}: {error.message}</Alert>;

  if (!user || !hasAccess(user.roles, ['ADMIN', 'MANAGER'])) {
    return <AccessDeniedPage />;
  }

  return (
    <Container>
      <h1 className="text-3xl font-bold mb-6">{t('auditTrail')}</h1>

      <Card className="mb-6">
        <h2 className="text-xl font-semibold mb-4">Filters</h2>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <FormField label="User ID" htmlFor="filterUserId">
            <Input id="filterUserId" value={filterUserId} onChange={(e) => setFilterUserId(e.target.value)} placeholder="e.g., usr-1" />
          </FormField>
          <FormField label={t('action')} htmlFor="filterAction">
            <Input id="filterAction" value={filterAction} onChange={(e) => setFilterAction(e.target.value)} placeholder="e.g., LOGIN, CREATE_ACCOUNT_GROUP" />
          </FormField>
          <FormField label={t('entityType')} htmlFor="filterEntityType">
            <Input id="filterEntityType" value={filterEntityType} onChange={(e) => setFilterEntityType(e.target.value)} placeholder="e.g., USER, ACCOUNT_GROUP" />
          </FormField>
        </div>
        <div className="flex justify-end space-x-2 mt-4">
          <Button onClick={handleClearFilters} variant="secondary">{t('clearFilters')}</Button>
          <Button onClick={handleApplyFilters} variant="primary">{t('applyFilters')}</Button>
        </div>
      </Card>

      {auditLogs.length === 0 ? (
        <Alert type="info">No audit logs found.</Alert>
      ) : (
        <>
          <Table>
            <TableHead>
              <TableHeader>{t('timestamp')}</TableHeader>
              <TableHeader>User ID</TableHeader>
              <TableHeader>{t('action')}</TableHeader>
              <TableHeader>{t('entityType')}</TableHeader>
              <TableHeader>{t('entityId')}</TableHeader>
              <TableHeader>{t('details')}</TableHeader>
            </TableHead>
            <TableBody>
              {auditLogs.map((log) => (
                <TableRow key={log.id}>
                  <TableCell>{formatDate(log.timestamp)}</TableCell>
                  <TableCell>{log.userId}</TableCell>
                  <TableCell>{log.action}</TableCell>
                  <TableCell>{log.entityType}</TableCell>
                  <TableCell>{log.entityId}</TableCell>
