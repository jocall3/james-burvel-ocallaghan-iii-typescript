            <span className="text-sm text-gray-700 dark:text-gray-300">
              Page {currentPage} of {pageInfo?.hasNextPage ? '...' : currentPage}
            </span>
            <Button onClick={handleNextPage} disabled={!pageInfo?.hasNextPage || loading} variant="secondary">
              {t('next')}
            </Button>
          </div>
        </>
      )}
    </Container>
  );
};

export const ApprovalsPage: React.FC = () => {
  const { t } = useLanguage();
  const { user } = useAuth();
  const [filterStatus, setFilterStatus] = useState<ApprovalStatus | ''>('PENDING');
  const [currentPage, setCurrentPage] = useState(1);
  const itemsPerPage = AppConfig.PAGINATION_LIMIT_DEFAULT;
  const [afterCursor, setAfterCursor] = useState<string | null>(null);
  const [viewRequestModalOpen, setViewRequestModalOpen] = useState(false);
  const [selectedRequest, setSelectedRequest] = useState<ApprovalRequestNode | null>(null);
  const [rejectionReason, setRejectionReason] = useState('');
  const [modalErrorMessage, setModalErrorMessage] = useState<string | null>(null);

  const { data, loading, error, refetch, fetchMore } = useQuery<ApprovalRequestsQueryResponse>(APPROVAL_REQUESTS_QUERY, {
    variables: {
      first: itemsPerPage,
      after: afterCursor,
      status: filterStatus || undefined,
    },
  });

  const [approveRequestMutation, { loading: approving }] = useMutation(APPROVE_REQUEST_MUTATION, {
    onCompleted: () => {
      refetch();
      setViewRequestModalOpen(false);
      setModalErrorMessage(null);
    },
    onError: (err) => setModalErrorMessage(err.message),
  });

  const [rejectRequestMutation, { loading: rejecting }] = useMutation(REJECT_REQUEST_MUTATION, {
    onCompleted: () => {
      refetch();
      setViewRequestModalOpen(false);
      setModalErrorMessage(null);
    },
    onError: (err) => setModalErrorMessage(err.message),
  });

  const approvalRequests = data?.approvalRequests.edges.map(e => e.node) || [];
  const pageInfo = data?.approvalRequests.pageInfo;

  const handleNextPage = useCallback(() => {
    if (pageInfo?.hasNextPage) {
      setAfterCursor(pageInfo.endCursor);
      setCurrentPage(prev => prev + 1);
      fetchMore({
        variables: { first: itemsPerPage, after: pageInfo.endCursor },
        updateQuery: (prev, { fetchMoreResult }) => fetchMoreResult || prev,
      });
    }
  }, [pageInfo, itemsPerPage, fetchMore]);

  const handlePreviousPage = useCallback(() => {
    if (currentPage > 1) {
      setCurrentPage(prev => prev - 1);
      setAfterCursor(null); // Simple reset
      fetchMore({
        variables: { first: itemsPerPage, after: null },
        updateQuery: (prev, { fetchMoreResult }) => fetchMoreResult || prev,
      });
    }
  }, [currentPage, itemsPerPage, fetchMore]);

  const handleViewRequest = (request: ApprovalRequestNode) => {
    setSelectedRequest(request);
    setViewRequestModalOpen(true);
    setRejectionReason('');
    setModalErrorMessage(null);
  };

  const handleApprove = async () => {
    if (!selectedRequest || !user) return;
    try {
      await approveRequestMutation({ variables: { id: selectedRequest.id } });
    } catch (e) { /* handled by onError */ }
  };

  const handleReject = async () => {
    if (!selectedRequest || !user) return;
    if (!rejectionReason.trim()) {
      setModalErrorMessage('Rejection reason is required.');
      return;
    }
    try {
      await rejectRequestMutation({ variables: { id: selectedRequest.id, reason: rejectionReason } });
    } catch (e) { /* handled by onError */ }
  };

  if (loading) return <Spinner />;
  if (error) return <Alert type="error">{t('error')}: {error.message}</Alert>;

  if (!user || !hasAccess(user.roles, ['MANAGER', 'ADMIN'])) {
    return <AccessDeniedPage />;
  }

  return (
    <Container>
      <h1 className="text-3xl font-bold mb-6">{t('approvalRequests')}</h1>

      <Card className="mb-6">
        <h2 className="text-xl font-semibold mb-4">Filters</h2>
        <FormField label={t('filterByStatus')} htmlFor="filterStatus">
          <Select id="filterStatus" value={filterStatus} onChange={(e) => setFilterStatus(e.target.value as ApprovalStatus | '')}>
            <option value="PENDING">Pending</option>
            <option value="APPROVED">Approved</option>
            <option value="REJECTED">Rejected</option>
            <option value="">All Statuses</option>
          </Select>
        </FormField>
      </Card>

      {approvalRequests.length === 0 ? (
        <Alert type="info">{t('noApprovalRequests')}</Alert>
      ) : (
        <>
          <Table>
            <TableHead>
              <TableHeader>{t('type')}</TableHeader>
              <TableHeader>{t('entityId')}</TableHeader>
              <TableHeader>{t('requestedBy')}</TableHeader>
              <TableHeader>{t('requestedAt')}</TableHeader>
              <TableHeader>{t('status')}</TableHeader>
              <TableHeader>{t('action')}</TableHeader>
            </TableHead>
            <TableBody>
              {approvalRequests.map((req) => (
                <TableRow key={req.id}>
                  <TableCell>{req.type}</TableCell>
                  <TableCell>{req.entityId}</TableCell>
                  <TableCell>{req.requestedBy.username}</TableCell>
                  <TableCell>{formatDate(req.requestedAt)}</TableCell>
                  <TableCell>
                    <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
                      req.status === 'APPROVED' ? 'bg-green-100 text-green-800' :
                      req.status === 'PENDING' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-red-100 text-red-800'
                    }`}>
                      {req.status}
                    </span>
                  </TableCell>
                  <TableCell>
                    <Button onClick={() => handleViewRequest(req)} variant="outline" className="text-sm">
                      {t('viewRequest')}
                    </Button>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>

          <div className="flex justify-between items-center mt-6">
            <Button onClick={handlePreviousPage} disabled={!pageInfo?.hasPreviousPage || loading} variant="secondary">
              {t('previous')}
            </Button>
            <span className="text-sm text-gray-700 dark:text-gray-300">
              Page {currentPage} of {pageInfo?.hasNextPage ? '...' : currentPage}
            </span>
            <Button onClick={handleNextPage} disabled={!pageInfo?.hasNextPage || loading} variant="secondary">
              {t('next')}
            </Button>
          </div>
        </>
      )}

      <Modal isOpen={viewRequestModalOpen} onClose={() => setViewRequestModalOpen(false)} title="Approval Request Details">
        {selectedRequest && (
          <>
            {modalErrorMessage && <Alert type="error">{modalErrorMessage}</Alert>}
            <div className="grid grid-cols-1 gap-3 mb-4">
              <p><strong>{t('id')}:</strong> {selectedRequest.id}</p>
              <p><strong>{t('type')}:</strong> {selectedRequest.type}</p>
              <p><strong>{t('entityId')}:</strong> {selectedRequest.entityId}</p>
              <p><strong>{t('requestedBy')}:</strong> {selectedRequest.requestedBy.username}</p>
              <p><strong>{t('requestedAt')}:</strong> {formatDate(selectedRequest.requestedAt)}</p>
              <p><strong>{t('status')}:</strong> {selectedRequest.status}</p>
              <p><strong>Details:</strong> <pre className="bg-gray-100 dark:bg-gray-700 p-2 rounded-md text-xs whitespace-pre-wrap">{JSON.stringify(selectedRequest.details, null, 2)}</pre></p>
            </div>
            {selectedRequest.status === 'PENDING' && (
              <>
                <FormField label="Rejection Reason (Optional)" htmlFor="rejectionReason">
                  <Textarea
                    id="rejectionReason"
                    value={rejectionReason}
                    onChange={(e) => setRejectionReason(e.target.value)}
                    rows={3}
                  />
                </FormField>
                <div className="flex justify-end space-x-2 mt-4">
                  <Button onClick={handleReject} variant="danger" disabled={rejecting}>
                    {rejecting ? <Spinner className="h-5 w-5 border-white" /> : t('reject')}
                  </Button>
                  <Button onClick={handleApprove} variant="primary" disabled={approving}>
                    {approving ? <Spinner className="h-5 w-5 border-white" /> : t('approve')}
                  </Button>
                </div>
              </>
            )}
          </>
        )}
      </Modal>
    </Container>
  );
};

export const UsersPage: React.FC = () => {
  const { t } = useLanguage();
  const { user } = useAuth();
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingUser, setEditingUser] = useState<AuthUser | null>(null);
  const [username, setUsername] = useState('');
  const [firstName, setFirstName] = useState('');
  const [lastName, setLastName] = useState('');
  const [email, setEmail] = useState('');
  const [roles, setRoles] = useState<string[]>([]);
  const [password, setPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [twoFactorEnabled, setTwoFactorEnabled] = useState(false);
  const [formErrors, setFormErrors] = useState<{ [key: string]: string }>({});
  const [successMessage, setSuccessMessage] = useState<string | null>(null);

  const { data, loading, error, refetch } = useQuery<AllUsersQueryResponse>(ALL_USERS_QUERY);
  const [updateUserMutation, { loading: updatingUser }] = useMutation(UPDATE_USER_MUTATION, {
    onCompleted: () => {
      setSuccessMessage(t('userUpdatedSuccess', { username: editingUser?.username || username }));
      resetForm();
      refetch();
    },
    onError: (err) => setFormErrors({ submit: err.message }),
  });
  const [createUserMutation, { loading: creatingUser }] = useMutation(CREATE_USER_MUTATION, {
    onCompleted: () => {
      setSuccessMessage(t('userAddedSuccess', { username }));
      resetForm();
      refetch();
    },
    onError: (err) => setFormErrors({ submit: err.message }),
  });

  const allRoles = ['VIEWER', 'ANALYST', 'MANAGER', 'ADMIN'];

  const resetForm = () => {
    setEditingUser(null);
    setUsername('');
    setFirstName('');
    setLastName('');
    setEmail('');
    setRoles(['VIEWER']);
    setPassword('');
    setConfirmPassword('');
    setTwoFactorEnabled(false);
    setFormErrors({});
    setSuccessMessage(null);
    setIsModalOpen(false);
  };

  const handleEditUser = (userToEdit: AuthUser) => {
    setEditingUser(userToEdit);
    setUsername(userToEdit.username);
    setFirstName(userToEdit.firstName);
    setLastName(userToEdit.lastName);
    setEmail(userToEdit.email);
    setRoles(userToEdit.roles);
    setTwoFactorEnabled(userToEdit.twoFactorEnabled);
    setIsModalOpen(true);
  };

  const handleRoleChange = (role: string, checked: boolean) => {
    setRoles(prev => checked ? [...prev, role] : prev.filter(r => r !== role));
  };

  const validateForm = () => {
    const errors: { [key: string]: string } = {};
    if (!username.trim()) errors.username = t('fieldRequired');
    if (!firstName.trim()) errors.firstName = t('fieldRequired');
    if (!lastName.trim()) errors.lastName = t('fieldRequired');
    if (!email.trim()) errors.email = t('fieldRequired');
    else if (!isValidEmail(email)) errors.email = 'Invalid email format.';
    if (roles.length === 0) errors.roles = 'At least one role is required.';

    if (!editingUser) { // Only for creating a new user
      if (!password.trim()) errors.password = t('passwordRequired');
      if (password !== confirmPassword) errors.confirmPassword = t('passwordMismatch');
    } else { // For editing, password fields are optional
      if (password && password !== confirmPassword) errors.confirmPassword = t('passwordMismatch');
    }
    setFormErrors(errors);
    return Object.keys(errors).length === 0;
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormErrors({});
    if (!validateForm()) return;

    try {
      if (!user) throw new Error("Current user not authenticated.");
      if (editingUser) {
        await updateUserMutation({
          variables: {
            id: editingUser.id,
            input: {
              firstName,
              lastName,
              email,
              roles,
              twoFactorEnabled,
              password: password || undefined, // Only send if provided
            },
          },
        });
      } else {
        await createUserMutation({
          variables: {
            input: {
              username,
              firstName,
              lastName,
              email,
              roles,
              password,
            },
          },
        });
      }
    } catch (err: any) {
      setFormErrors({ submit: err.message });
    }
  };

  if (loading) return <Spinner />;
  if (error) return <Alert type="error">{t('error')}: {error.message}</Alert>;

  if (!user || !hasAccess(user.roles, ['ADMIN', 'MANAGER'])) {
    return <AccessDeniedPage />;
  }

  const users = data?.users || [];

  return (
    <Container>
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-3xl font-bold">{t('userManagement')}</h1>
        <Button onClick={() => setIsModalOpen(true)} variant="primary">
          {t('addUser')}
        </Button>
      </div>

      {successMessage && <Alert type="success" className="mb-4">{successMessage}</Alert>}

      {users.length === 0 ? (
        <Alert type="info">No users found.</Alert>
      ) : (
        <Table>
          <TableHead>
            <TableHeader>{t('username')}</TableHeader>
            <TableHeader>{t('firstName')}</TableHeader>
            <TableHeader>{t('lastName')}</TableHeader>
            <TableHeader>{t('email')}</TableHeader>
            <TableHeader>{t('roles')}</TableHeader>
            <TableHeader>{t('lastLogin')}</TableHeader>
            <TableHeader>{t('twoFactorEnabled')}</TableHeader>
            <TableHeader>{t('action')}</TableHeader>
          </TableHead>
          <TableBody>
            {users.map((u) => (
              <TableRow key={u.id}>
                <TableCell className="font-medium">{u.username}</TableCell>
                <TableCell>{u.firstName}</TableCell>
                <TableCell>{u.lastName}</TableCell>
                <TableCell>{u.email}</TableCell>
                <TableCell>{u.roles.join(', ')}</TableCell>
                <TableCell>{formatDate(u.lastLogin)}</TableCell>
                <TableCell>
                  <span className={`inline-block w-4 h-4 rounded-full ${u.twoFactorEnabled ? 'bg-green-500' : 'bg-red-500'}`}></span>
                </TableCell>
                <TableCell>
                  <Button onClick={() => handleEditUser(u)} variant="outline" className="text-sm">
                    {t('updateUser')}
                  </Button>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      )}

      <Modal isOpen={isModalOpen} onClose={resetForm} title={editingUser ? t('updateUser') : t('addUser')}>
        <form onSubmit={handleSubmit}>
          {formErrors.submit && <Alert type="error">{formErrors.submit}</Alert>}
          <FormField label={t('username')} htmlFor="username" error={formErrors.username}>
            <Input id="username" value={username} onChange={(e) => setUsername(e.target.value)} disabled={!!editingUser} />
          </FormField>
          <FormField label={t('firstName')} htmlFor="firstName" error={formErrors.firstName}>
            <Input id="firstName" value={firstName} onChange={(e) => setFirstName(e.target.value)} />
          </FormField>
          <FormField label={t('lastName')} htmlFor="lastName" error={formErrors.lastName}>
            <Input id="lastName" value={lastName} onChange={(e) => setLastName(e.target.value)} />
          </FormField>
          <FormField label={t('email')} htmlFor="email" error={formErrors.email}>
            <Input id="email" type="email" value={email} onChange={(e) => setEmail(e.target.value)} />
          </FormField>
          <FormField label={t('roles')} htmlFor="roles" error={formErrors.roles}>
            <div className="flex flex-wrap gap-2">
              {allRoles.map(role => (
                <label key={role} className="inline-flex items-center">
                  <input
                    type="checkbox"
                    checked={roles.includes(role)}
                    onChange={(e) => handleRoleChange(role, e.target.checked)}
                    className="form-checkbox h-4 w-4 text-blue-600"
                  />
                  <span className="ml-2 text-gray-700 dark:text-gray-300">{role}</span>
                </label>
              ))}
            </div>
          </FormField>
          <FormField label={t('twoFactorEnabled')} htmlFor="twoFactorEnabled">
            <label className="inline-flex items-center">
              <input
                type="checkbox"
                checked={twoFactorEnabled}
                onChange={(e) => setTwoFactorEnabled(e.target.checked)}
                className="form-checkbox h-4 w-4 text-blue-600"
              />
              <span className="ml-2 text-gray-700 dark:text-gray-300">Enable 2FA</span>
            </label>
          </FormField>
          <FormField label={t('password')} htmlFor="password" error={formErrors.password}>
            <Input id="password" type="password" value={password} onChange={(e) => setPassword(e.target.value)} placeholder={editingUser ? 'Leave blank to keep current' : t('password')} />
          </FormField>
          <FormField label={t('confirmPassword')} htmlFor="confirmPassword" error={formErrors.confirmPassword}>
            <Input id="confirmPassword" type="password" value={confirmPassword} onChange={(e) => setConfirmPassword(e.target.value)} />
          </FormField>
          <div className="flex justify-end space-x-2 mt-4">
            <Button onClick={resetForm} variant="secondary">
              {t('cancel')}
            </Button>
            <Button type="submit" variant="primary" disabled={updatingUser || creatingUser}>
              {(updatingUser || creatingUser) ? <Spinner className="h-5 w-5 border-white" /> : (editingUser ? t('updateUser') : t('addUser'))}
            </Button>
          </div>
        </form>
      </Modal>
    </Container>
  );
};

export const SettingsPage: React.FC = () => {
  const { t, language, setLanguage } = useLanguage();
  const { theme, toggleTheme } = useTheme();
  const { user, updateUserPreferences } = useAuth();
  const [successMessage, setSuccessMessage] = useState<string | null>(null);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  const { data, loading, error, refetch } = useQuery<{ systemSettings: SystemSetting[] }>(gql`
    query SystemSettings {
      systemSettings {
        key
        value
        description
      }
    }
  `);
  const [updateSystemSettingMutation, { loading: updatingSetting }] = useMutation(gql`
    mutation UpdateSystemSetting($key: String!, $value: JSON!) {
      updateSystemSetting(key: $key, value: $value) {
        key
        value
      }
    }
  `, {
    onCompleted: () => {
      setSuccessMessage('Setting updated successfully!');
      refetch();
    },
    onError: (err) => setErrorMessage(err.message),
  });

  if (loading) return <Spinner />;
  if (error) return <Alert type="error">{t('error')}: {error.message}</Alert>;

  if (!user || !hasAccess(user.roles, ['ADMIN', 'MANAGER'])) {
    return <AccessDeniedPage />;
  }

  const systemSettings = data?.systemSettings || [];
  const maintenanceModeSetting = systemSettings.find(s => s.key === 'maintenanceMode');

  const handleToggleMaintenanceMode = async (enabled: boolean) => {
    if (!user) { setErrorMessage("User not authenticated."); return; }
    setErrorMessage(null);
    setSuccessMessage(null);
    try {
      await updateSystemSettingMutation({
        variables: { key: 'maintenanceMode', value: enabled },
      });
    } catch (e) {
      console.error('Failed to update maintenance mode:', e);
    }
  };

  const handleLanguageChange = async (e: React.ChangeEvent<HTMLSelectElement>) => {
    const newLang = e.target.value as keyof typeof Languages;
    await setLanguage(newLang); // This also updates user preferences via AuthProvider
    setSuccessMessage('Language preference updated.');
    setErrorMessage(null);
  };

  return (
    <Container>
      <h1 className="text-3xl font-bold mb-6">{t('systemSettings')}</h1>

      {successMessage && <Alert type="success">{successMessage}</Alert>}
      {errorMessage && <Alert type="error">{errorMessage}</Alert>}

      <Card className="mb-6">
        <h2 className="text-xl font-semibold mb-4">{t('generalSettings')}</h2>
        <FormField label={t('language')} htmlFor="languageSetting">
          <Select id="languageSetting" value={language} onChange={handleLanguageChange}>
            {Object.entries(Languages).map(([code, langData]) => (
              <option key={code} value={code}>{langData.name}</option>
            ))}
          </Select>
        </FormField>
        <div className="flex items-center justify-between mt-4">
          <Label htmlFor="themeSetting">{t('theme')}</Label>
          <Button onClick={toggleTheme} variant="secondary">
            {theme === 'dark' ? `🌙 ${t('dark')}` : `☀️ ${t('light')}`}
          </Button>
        </div>
      </Card>

      {hasAccess(user?.roles || [], ['ADMIN']) && (
        <Card className="mb-6">
          <h2 className="text-xl font-semibold mb-4">{t('securitySettings')}</h2>
          <div className="flex items-center justify-between">
            <Label htmlFor="maintenanceMode">System Maintenance Mode</Label>
            <Button
              onClick={() => handleToggleMaintenanceMode(!(maintenanceModeSetting?.value === true))}
              variant={maintenanceModeSetting?.value === true ? 'danger' : 'primary'}
              disabled={updatingSetting}
            >
              {updatingSetting ? <Spinner className="h-5 w-5 border-white" /> :
                (maintenanceModeSetting?.value === true ? 'Disable Maintenance' : 'Enable Maintenance')}
            </Button>
          </div>
          <p className="text-sm text-gray-500 dark:text-gray-400 mt-2">
            {maintenanceModeSetting?.description} (Current: {maintenanceModeSetting?.value === true ? 'Enabled' : 'Disabled'})
          </p>
        </Card>
      )}

      <Card className="mb-6">
        <h2 className="text-xl font-semibold mb-4">Notification Settings</h2>
        {/* Placeholder for notification settings like email/SMS preferences */}
        <p className="text-gray-600 dark:text-gray-400">Manage your notification preferences here.</p>
        <Button variant="secondary" className="mt-4">Update Preferences</Button>
      </Card>
    </Container>
  );
};

export const ProfilePage: React.FC = () => {
  const { t } = useLanguage();
  const { user, updateUserPreferences, refreshUser } = useAuth();
  const [currentPassword, setCurrentPassword] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [confirmNewPassword, setConfirmNewPassword] = useState('');
  const [successMessage, setSuccessMessage] = useState<string | null>(null);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);

  // Use a mock mutation for password change
  const handleChangePassword = async (e: React.FormEvent) => {
    e.preventDefault();
    setSuccessMessage(null);
    setErrorMessage(null);
    setLoading(true);

    if (!currentPassword || !newPassword || !confirmNewPassword) {
      setErrorMessage(t('fieldRequired'));
      setLoading(false);
      return;
    }

    if (newPassword !== confirmNewPassword) {
      setErrorMessage(t('passwordMismatch'));
      setLoading(false);
      return;
    }

    if (newPassword.length < 8) { // Basic validation
      setErrorMessage('New password must be at least 8 characters long.');
      setLoading(false);
      return;
    }

    try {
      // Simulate API call for password change
      await mockApiService.updateUser(user!.id, { password: newPassword }, user!); // Mock update
      setSuccessMessage(t('passwordChangeSuccess'));
      setCurrentPassword('');
      setNewPassword('');
      setConfirmNewPassword('');
    } catch (err: any) {
      setErrorMessage(err.message || 'Failed to change password.');
    } finally {
      setLoading(false);
    }
  };

  const handleUpdateLanguage = async (e: React.ChangeEvent<HTMLSelectElement>) => {
    const newLang = e.target.value as keyof typeof Languages;
    if (user?.preferredLanguage === newLang) return;
    setSuccessMessage(null);
    setErrorMessage(null);
    try {
      await updateUserPreferences({ preferredLanguage: newLang });
      setSuccessMessage('Language preference updated successfully!');
    } catch (err: any) {
      setErrorMessage(err.message || 'Failed to update language preference.');
    }
  };

  if (!user) return <Spinner />;

  return (
    <Container>
      <h1 className="text-3xl font-bold mb-6">{t('profileSettings')}</h1>

      {successMessage && <Alert type="success">{successMessage}</Alert>}
      {errorMessage && <Alert type="error">{errorMessage}</Alert>}

      <Card className="mb-6">
        <h2 className="text-xl font-semibold mb-4">Personal Information</h2>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <p><strong>{t('username')}:</strong> {user.username}</p>
          <p><strong>{t('firstName')}:</strong> {user.firstName}</p>
          <p><strong>{t('lastName')}:</strong> {user.lastName}</p>
          <p><strong>{t('email')}:</strong> {user.email}</p>
          <p><strong>{t('roles')}:</strong> {user.roles.join(', ')}</p>
          <p><strong>{t('lastLogin')}:</strong> {formatDate(user.lastLogin)}</p>
          <p><strong>{t('twoFactorEnabled')}:</strong> {user.twoFactorEnabled ? 'Yes' : 'No'}</p>
        </div>
        <div className="mt-4">
          <FormField label={t('language')} htmlFor="profileLanguage">
            <Select id="profileLanguage" value={user.preferredLanguage} onChange={handleUpdateLanguage}>
              {Object.entries(Languages).map(([code, langData]) => (
                <option key={code} value={code}>{langData.name}</option>
              ))}
            </Select>
          </FormField>
        </div>
      </Card>

      <Card className="mb-6">
        <h2 className="text-xl font-semibold mb-4">Change Password</h2>
        <form onSubmit={handleChangePassword}>
          <FormField label={t('currentPassword')} htmlFor="currentPassword">
            <Input
              id="currentPassword"
              type="password"
              value={currentPassword}
              onChange={(e) => setCurrentPassword(e.target.value)}
            />
          </FormField>
          <FormField label={t('newPassword')} htmlFor="newPassword">
            <Input
              id="newPassword"
              type="password"
              value={newPassword}
              onChange={(e) => setNewPassword(e.target.value)}
            />
          </FormField>
          <FormField label={t('confirmPassword')} htmlFor="confirmNewPassword">
            <Input
              id="confirmNewPassword"
              type="password"
              value={confirmNewPassword}
              onChange={(e) => setConfirmNewPassword(e.target.value)}
            />
          </FormField>
          <div className="flex justify-end mt-4">
            <Button type="submit" variant="primary" disabled={loading}>
              {loading ? <Spinner className="h-5 w-5 border-white" /> : t('updatePassword')}
            </Button>
          </div>
        </form>
      </Card>
      
      <Card>
        <h2 className="text-xl font-semibold mb-4">{t('securityWarning')}</h2>
        <p className="text-gray-600 dark:text-gray-400">Review your recent login activity and security preferences.</p>
        <Button variant="secondary" className="mt-4">View Security Log</Button>
      </Card>
    </Container>
  );
};


