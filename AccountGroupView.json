export const ACCOUNT_GROUP_VIEW_QUERY = gql`
  query AccountGroupView($id: ID!, $first: Int, $after: String, $last: Int, $before: String) {
    accountGroup(id: $id) {
      id
      name
      currency
      description
      internalAccounts(first: $first, after: $after, last: $last, before: $before) {
        pageInfo {
          startCursor
          endCursor
          hasNextPage
          hasPreviousPage
          __typename
        }
        edges {
          node {
            id
            longName
            balance
            type
            status
            currency
            __typename
          }
          __typename
        }
        __typename
      }
      groupMembers { # Extended: to manage users linked to an account group
        id
        username
        firstName
        lastName
      }
      createdAt # Extended
      updatedAt # Extended
      createdBy { # Extended
        id
        username
      }
      lastModifiedBy { # Extended
        id
        username
      }
      transactionSummary { # Extended: quick stats for dashboard
        totalTransactions
        totalDebit
        totalCredit
        averageDailyBalance
      }
      __typename
    }
  }
`;

