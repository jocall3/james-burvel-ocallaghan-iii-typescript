/**
 * Global Authentication Context.
 */
export interface AuthContextType {
  user: AuthUser | null;
  authToken: string | null;
  login: (token: string, userData: AuthUser) => void;
  logout: () => void;
  isLoadingAuth: boolean;
  isAuthenticated: boolean;
  refreshUser: () => Promise<void>;
  updateUserPreferences: (prefs: { preferredLanguage?: keyof typeof Languages }) => Promise<void>;
  checkSession: () => void;
}

export const AuthContext = createContext<AuthContextType | undefined>(undefined);

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (!context) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
};

export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [user, setUser] = useState<AuthUser | null>(null);
  const [authToken, setAuthToken] = useState<string | null>(localStorage.getItem('authToken'));
  const [isLoadingAuth, setIsLoadingAuth] = useState(true);
  const navigate = useNavigate();
  const sessionTimerRef = useRef<number | null>(null);

  // Directly update mockLink's user state
  useEffect(() => {
    mockLink.setCurrentUser(user);
  }, [user]);

  const startSessionTimer = useCallback(() => {
    if (sessionTimerRef.current) {
      clearTimeout(sessionTimerRef.current);
    }
    sessionTimerRef.current = window.setTimeout(() => {
      console.log('Session expired due to inactivity.');
      logout(true); // Logout due to session expiry
    }, AppConfig.SESSION_TIMEOUT_MINUTES * 60 * 1000);
  }, []);

  const resetSessionTimer = useCallback(() => {
    if (isAuthenticated) {
      startSessionTimer();
    }
  }, [isAuthenticated, startSessionTimer]);

  useEffect(() => {
    const activityEvents = ['mousemove', 'keydown', 'click', 'scroll'];
    if (isAuthenticated) {
      activityEvents.forEach(event => window.addEventListener(event, resetSessionTimer));
      startSessionTimer();
    } else {
      if (sessionTimerRef.current) {
        clearTimeout(sessionTimerRef.current);
      }
      activityEvents.forEach(event => window.removeEventListener(event, resetSessionTimer));
    }
    return () => {
      if (sessionTimerRef.current) {
        clearTimeout(sessionTimerRef.current);
      }
      activityEvents.forEach(event => window.removeEventListener(event, resetSessionTimer));
    };
  }, [isAuthenticated, resetSessionTimer, startSessionTimer]);

  const login = useCallback((token: string, userData: AuthUser) => {
    localStorage.setItem('authToken', token);
    localStorage.setItem('currentUser', JSON.stringify(userData));
    setAuthToken(token);
    setUser(userData);
    startSessionTimer();
  }, [startSessionTimer]);

  const logout = useCallback((sessionExpired: boolean = false) => {
    localStorage.removeItem('authToken');
    localStorage.removeItem('currentUser');
    setAuthToken(null);
    setUser(null);
    if (sessionTimerRef.current) {
      clearTimeout(sessionTimerRef.current);
    }
    apolloClient.clearStore();
    navigate(sessionExpired ? '/login?sessionExpired=true' : '/login');
  }, [navigate]);

  const refreshUser = useCallback(async () => {
    if (authToken) {
      try {
        const { data } = await apolloClient.query<MeQueryResponse>({ query: ME_QUERY });
        if (data?.me) {
          setUser(data.me);
          localStorage.setItem('currentUser', JSON.stringify(data.me));
        } else {
          logout();
        }
      } catch (error) {
        console.error('Failed to refresh user:', error);
        logout();
      } finally {
        setIsLoadingAuth(false);
      }
    } else {
      setIsLoadingAuth(false);
    }
  }, [authToken, logout]);

  const updateUserPreferences = useCallback(async (prefs: { preferredLanguage?: keyof typeof Languages }) => {
    if (!user) return;
    try {
      // In a real app, this would be a mutation to update user profile
      const updatedUser = { ...user, ...prefs };
      setUser(updatedUser);
      localStorage.setItem('currentUser', JSON.stringify(updatedUser));
      // Simulate API call
      await mockApiService.updateUser(user.id, prefs, user);
      // For language, immediately update UI
      if (prefs.preferredLanguage) {
        localStorage.setItem('preferredLanguage', prefs.preferredLanguage);
      }
    } catch (error) {
      console.error('Failed to update user preferences:', error);
    }
  }, [user]);

  useEffect(() => {
    const storedUser = localStorage.getItem('currentUser');
    if (authToken && storedUser) {
      try {
        setUser(JSON.parse(storedUser));
        setIsLoadingAuth(false);
        startSessionTimer(); // Start timer if user already logged in
      } catch (e) {
        console.error('Failed to parse stored user, logging out.', e);
        logout();
      }
    } else if (authToken) {
      // Token exists but user data is missing, fetch user data
      refreshUser();
    } else {
      setIsLoadingAuth(false);
    }
  }, [authToken, refreshUser, startSessionTimer, logout]);

  const isAuthenticated = !!user && !!authToken;

  const checkSession = useCallback(() => {
    // This function is called by the protected routes to ensure session validity
    if (!isAuthenticated && !isLoadingAuth) {
      navigate('/login?sessionExpired=true');
    }
  }, [isAuthenticated, isLoadingAuth, navigate]);

  return (
    <AuthContext.Provider value={{ user, authToken, login, logout, isLoadingAuth, isAuthenticated, refreshUser, updateUserPreferences, checkSession }}>
      {children}
    </AuthContext.Provider>
  );
};

/**
 * Theme Context for dark/light mode.
 */
export type Theme = 'light' | 'dark';

export interface ThemeContextType {
  theme: Theme;
  toggleTheme: () => void;
}

export const ThemeContext = createContext<ThemeContextType | undefined>(undefined);

export const useTheme = () => {
  const context = useContext(ThemeContext);
  if (!context) {
    throw new Error('useTheme must be used within a ThemeProvider');
  }
  return context;
};

export const ThemeProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [theme, setTheme] = useState<Theme>(() => (localStorage.getItem('theme') as Theme) || 'light');

  const toggleTheme = useCallback(() => {
    setTheme(prevTheme => {
      const newTheme = prevTheme === 'light' ? 'dark' : 'light';
      localStorage.setItem('theme', newTheme);
      return newTheme;
    });
  }, []);

  useEffect(() => {
    document.documentElement.setAttribute('data-theme', theme);
  }, [theme]);

  return (
    <ThemeContext.Provider value={{ theme, toggleTheme }}>
      {children}
    </ThemeContext.Provider>
  );
};

/**
 * Language Context for i18n.
 */
export interface LanguageContextType {
  language: keyof typeof Languages;
  setLanguage: (lang: keyof typeof Languages) => void;
  t: (key: keyof typeof i18n['en'], replacements?: { [key: string]: string | number }) => string;
}

export const LanguageContext = createContext<LanguageContextType | undefined>(undefined);

export const useLanguage = () => {
  const context = useContext(LanguageContext);
  if (!context) {
    throw new Error('useLanguage must be used within a LanguageProvider');
  }
  return context;
};

export const LanguageProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const { user, updateUserPreferences } = useAuth();
  const [language, setLanguageState] = useState<keyof typeof Languages>(
    () => (localStorage.getItem('preferredLanguage') as keyof typeof Languages) || 'en'
  );

  useEffect(() => {
    if (user && user.preferredLanguage !== language) {
      setLanguageState(user.preferredLanguage);
      localStorage.setItem('preferredLanguage', user.preferredLanguage);
    }
  }, [user, language]);

  const setLanguage = useCallback(async (lang: keyof typeof Languages) => {
    setLanguageState(lang);
    localStorage.setItem('preferredLanguage', lang);
    if (user) {
      await updateUserPreferences({ preferredLanguage: lang });
    }
  }, [user, updateUserPreferences]);

  const t = useCallback((key: keyof typeof i18n['en'], replacements?: { [key: string]: string | number }) => {
    return getTranslatedText(key, language, replacements);
  }, [language]);

  return (
    <LanguageContext.Provider value={{ language, setLanguage, t }}>
      {children}
    </LanguageContext.Provider>
  );
};

/**
 * Custom hook for client-side pagination.
 */
export const usePagination = <T extends { id: string }>(items: T[], itemsPerPage: number = AppConfig.PAGINATION_LIMIT_DEFAULT) => {
  const [currentPage, setCurrentPage] = useState(1);
  const totalPages = Math.ceil(items.length / itemsPerPage);

  const paginatedItems = useMemo(() => {
    const startIndex = (currentPage - 1) * itemsPerPage;
    return items.slice(startIndex, startIndex + itemsPerPage);
  }, [items, currentPage, itemsPerPage]);

  const goToNextPage = useCallback(() => {
    setCurrentPage(prev => Math.min(prev + 1, totalPages));
  }, [totalPages]);

  const goToPreviousPage = useCallback(() => {
    setCurrentPage(prev => Math.max(prev - 1, 1));
  }, []);

  const goToPage = useCallback((page: number) => {
    setCurrentPage(Math.max(1, Math.min(page, totalPages)));
  }, [totalPages]);

  useEffect(() => {
    // Reset to first page if items change or page becomes invalid
    if (currentPage > totalPages && totalPages > 0) {
      setCurrentPage(totalPages);
    } else if (currentPage === 0 && totalPages > 0) {
      setCurrentPage(1);
    }
    if (items.length === 0) {
      setCurrentPage(1);
    }
  }, [items, totalPages, currentPage]);

  return {
    currentPage,
    totalPages,
    paginatedItems,
    goToNextPage,
    goToPreviousPage,
    goToPage,
    canGoNext: currentPage < totalPages,
    canGoPrevious: currentPage > 1,
  };
};

