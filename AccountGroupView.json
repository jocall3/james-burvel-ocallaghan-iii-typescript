//region -- Utility Functions & Mock API --

/**
 * Formats a number as currency.
 * @param amount - The numerical amount.
 * @param currencyCode - The 3-letter currency code (e.g., 'USD', 'EUR').
 * @param locale - The locale string (e.g., 'en-US').
 */
export const formatCurrency = (amount: number, currencyCode: string, locale: string = AppConfig.CURRENCY_LOCALE): string => {
  return new Intl.NumberFormat(locale, {
    style: AppConfig.CURRENCY_STYLE,
    currency: currencyCode,
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(amount);
};

/**
 * Formats a date string.
 * @param dateString - The ISO date string.
 * @param locale - The locale string.
 * @param options - Intl.DateTimeFormatOptions.
 */
export const formatDate = (dateString: string, locale: string = AppConfig.CURRENCY_LOCALE, options: Intl.DateTimeFormatOptions = AppConfig.DATE_FORMAT_OPTIONS): string => {
  if (!dateString) return '';
  try {
    return new Date(dateString).toLocaleString(locale, options);
  } catch (e) {
    console.error('Invalid date string:', dateString, e);
    return dateString;
  }
};

/**
 * Simple email validation.
 */
export const isValidEmail = (email: string): boolean => {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
};

/**
 * Role-Based Access Control (RBAC) helper.
 * @param userRoles - Array of roles for the current user.
 * @param requiredRoles - Array of roles required for access.
 * @returns true if user has at least one of the required roles.
 */
export const hasAccess = (userRoles: string[], requiredRoles: string[]): boolean => {
  if (!requiredRoles || requiredRoles.length === 0) return true; // No roles required, access granted
  if (!userRoles || userRoles.length === 0) return false; // No user roles, no access
  return userRoles.some(role => requiredRoles.includes(role));
};

/**
