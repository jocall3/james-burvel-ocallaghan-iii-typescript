};

export const Layout: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const { isAuthenticated, isLoadingAuth, checkSession } = useAuth();
  const { t } = useLanguage();
  const [maintenanceMode, setMaintenanceMode] = useState(false);
  const { data: settingsData, loading: settingsLoading } = useQuery<{ systemSettings: SystemSetting[] }>(gql`
    query SystemSettings {
      systemSettings {
        key
        value
      }
    }
  `);

  useEffect(() => {
    if (settingsData) {
      const maintenanceSetting = settingsData.systemSettings.find(s => s.key === 'maintenanceMode');
      setMaintenanceMode(maintenanceSetting?.value === true);
    }
  }, [settingsData]);

  useEffect(() => {
    // Only check session if auth is loaded and user is expected to be authenticated
    if (!isLoadingAuth && isAuthenticated) {
      checkSession();
    }
  }, [isAuthenticated, isLoadingAuth, checkSession]);

  if (isLoadingAuth || settingsLoading) {
    return (
      <div className="flex flex-col min-h-screen bg-gray-50 dark:bg-gray-900 items-center justify-center">
        <Spinner />
        <p className="mt-4 text-gray-700 dark:text-gray-300">{t('loading')}</p>
      </div>
    );
  }

  if (maintenanceMode && !window.location.pathname.startsWith('/maintenance')) {
    return <MaintenancePage />;
  }

  return (
    <div className="flex flex-col min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100">
      <Header />
      <div className="flex flex-1">
        {isAuthenticated && <Sidebar />}
        <main className="flex-1 p-6 overflow-auto">
          {children}
        </main>
      </div>
    </div>
  );
};

