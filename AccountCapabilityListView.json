export const NotificationToast: React.FC<{ notification: Notification; onClose: () => void }> = memo(({ notification, onClose }) => {
    const themeContext = useContext(ThemeContext);
    const theme = themeContext?.theme || 'light';

    let IconComponent;
    switch (notification.type) {
        case 'success': IconComponent = MdCheckCircle; break;
        case 'error': IconComponent = MdCancel; break;
        case 'warning': IconComponent = MdWarning; break;
        case 'info': IconComponent = MdInfo; break;
        default: IconComponent = MdInfo;
    }

    return (
        <motion.div
            initial={{ opacity: 0, x: 100 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: 100 }}
            layout
            style={styles.notificationItem(notification.type, theme)}
        >
            <IconComponent size={24} color={styles.badge(notification.type).color} />
            <div style={{ flexGrow: 1 }}>
                <div style={{ fontWeight: 'bold' }}>{capitalize(notification.type)}</div>
                <div>{notification.message}</div>
                {notification.action && (
                    <Button onClick={notification.action.callback} type="text" size="small" style={{ marginTop: '5px', textDecoration: 'underline' }}>
                        {notification.action.label}
                    </Button>
                )}
            </div>
            <Button onClick={onClose} type="text" size="small"><MdClose /></Button>
        </motion.div>
    );
});


