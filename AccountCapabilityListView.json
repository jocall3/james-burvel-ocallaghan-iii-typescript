export const AccountCapabilityPage: React.FC = () => {
  const authContext = useContext(AuthContext);
  const notificationContext = useContext(NotificationContext);
  const themeContext = useContext(ThemeContext);
  const configContext = useContext(AppConfigContext);
  const theme = themeContext?.theme || 'light';

  const [filterCriteria, setFilterCriteria] = useState<CapabilityFilterCriteria>({
    searchQuery: '',
    showDeleted: false,
    status: [],
  });
  const [sortCriteria, setSortCriteria] = useState<CapabilitySortCriteria>({ field: 'createdAt', direction: 'DESC' });
  const [paginationVariables, setPaginationVariables] = useState({
    first: DEFAULT_ITEMS_PER_PAGE,
    after: '',
    before: '',
    currentPage: 1,
  });
  const [selectedCapability, setSelectedCapability] = useState<AccountCapabilityNode | null>(null);
  const [isDetailPanelOpen, setIsDetailPanelOpen] = useState(false);
  const [isEditModalOpen, setIsEditModalOpen] = useState(false);
  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);
  const [tempCapabilityData, setTempCapabilityData] = useState<CapabilityFormValues | null>(null);
  const [formErrors, setFormErrors] = useState<Record<string, string>>({});

  const { loading, error, data, fetchMore, networkStatus, refetch } = useQuery<AccountCapabilityListViewData>(
    ACCOUNT_CAPABILITY_LIST_QUERY,
    {
      variables: {
        showDeleted: filterCriteria.showDeleted ? 'true' : 'false',
        first: paginationVariables.first,
        after: paginationVariables.after,
        before: paginationVariables.before,
      },
      fetchPolicy: 'cache-and-network',
      notifyOnNetworkStatusChange: true,
    }
  );

  const capabilities = useMemo(() => {
    // Apply client-side filters and sorting that aren't part of GraphQL variables
    let filtered = (data?.accountCapabilities.edges || [])
      .map(edge => edge.node)
      .filter(cap => {
        // GraphQL `showDeleted` handles the primary filter, but secondary filtering happens here
        // This is a simplification; in a real app, all filtering would be server-side
        const matchPaymentType = filterCriteria.paymentType ? cap.prettyPaymentType === filterCriteria.paymentType : true;
        const matchDirection = filterCriteria.direction ? cap.prettyDirection === filterCriteria.direction : true;
        const matchCurrency = filterCriteria.currency ? cap.currencies.includes(filterCriteria.currency) : true;
        const matchStatus = filterCriteria.status?.length ? filterCriteria.status.includes(cap._metadata.status) : true;
        const matchPartyName = filterCriteria.partyName ? cap.partyName.toLowerCase().includes(filterCriteria.partyName.toLowerCase()) : true;
        const matchSearch = filterCriteria.searchQuery
            ? (cap.prettyPaymentType.toLowerCase().includes(filterCriteria.searchQuery.toLowerCase()) ||
              cap.identifier.toLowerCase().includes(filterCriteria.searchQuery.toLowerCase()) ||
              cap.partyName.toLowerCase().includes(filterCriteria.searchQuery.toLowerCase()) ||
              cap.currencies.some(c => c.toLowerCase().includes(filterCriteria.searchQuery.toLowerCase())) ||
              cap.prettyPaymentSubtypes.some(s => s.toLowerCase().includes(filterCriteria.searchQuery.toLowerCase())))
            : true;

        return matchPaymentType && matchDirection && matchCurrency && matchStatus && matchPartyName && matchSearch;
      });

    filtered.sort((a, b) => {
        const valA = sortCriteria.field === 'status' ? a._metadata.status : a[sortCriteria.field as keyof AccountCapabilityNode] || a._metadata[sortCriteria.field as keyof AccountCapabilityMetadata];
        const valB = sortCriteria.field === 'status' ? b._metadata.status : b[sortCriteria.field as keyof AccountCapabilityNode] || b._metadata[sortCriteria.field as keyof AccountCapabilityMetadata];

        if (typeof valA === 'string' && typeof valB === 'string') {
            return sortCriteria.direction === 'ASC' ? valA.localeCompare(valB) : valB.localeCompare(valA);
        }
        if (typeof valA === 'number' && typeof valB === 'number') {
            return sortCriteria.direction === 'ASC' ? valA - valB : valB - valA;
        }
        // Fallback for other types or null/undefined
        if (valA === undefined && valB !== undefined) return sortCriteria.direction === 'ASC' ? 1 : -1;
        if (valA !== undefined && valB === undefined) return sortCriteria.direction === 'ASC' ? -1 : 1;
        return 0;
    });

    return filtered;
  }, [data, filterCriteria, sortCriteria]);

  const pageInfo = data?.accountCapabilities.pageInfo;

  const handleFilterChange = useCallback((newFilters: Partial<CapabilityFilterCriteria>) => {
    setFilterCriteria(prev => ({ ...prev, ...newFilters }));
    // Reset pagination when filters change to fetch from start
    setPaginationVariables({ first: DEFAULT_ITEMS_PER_PAGE, after: '', before: '', currentPage: 1 });
    refetch(); // Trigger refetch with new filters
  }, [refetch]);

  const handleSortChange = useCallback((field: CapabilitySortCriteria['field']) => {
    setSortCriteria(prev => ({
      field,
      direction: prev.field === field && prev.direction === 'ASC' ? 'DESC' : 'ASC',
    }));
  }, []);

  const handlePageChange = useCallback((direction: 'next' | 'prev' | 'first' | 'last') => {
    if (direction === 'next' && pageInfo?.hasNextPage) {
      setPaginationVariables(prev => ({ ...prev, after: pageInfo.endCursor, before: '', currentPage: prev.currentPage + 1 }));
    } else if (direction === 'prev' && pageInfo?.hasPreviousPage) {
      setPaginationVariables(prev => ({ ...prev, before: pageInfo.startCursor, after: '', currentPage: prev.currentPage - 1 }));
    } else if (direction === 'first') {
        setPaginationVariables(prev => ({ ...prev, after: '', before: '', currentPage: 1 }));
    }
  }, [pageInfo]);

  const handleItemsPerPageChange = useCallback((e: React.ChangeEvent<HTMLSelectElement>) => {
    setPaginationVariables(prev => ({ ...prev, first: parseInt(e.target.value, 10), after: '', before: '', currentPage: 1 }));
  }, []);

  const handleViewDetails = useCallback((capability: AccountCapabilityNode) => {
    setSelectedCapability(capability);
    setIsDetailPanelOpen(true);
  }, []);

  const handleCloseDetailPanel = useCallback(() => {
    setIsDetailPanelOpen(false);
    setSelectedCapability(null);
  }, []);

  const handleEditCapability = useCallback((capability: AccountCapabilityNode) => {
    setSelectedCapability(capability);
    setTempCapabilityData({
        prettyPaymentType: capability.prettyPaymentType,
        prettyDirection: capability.prettyDirection,
        identifier: capability.identifier,
        partyName: capability.partyName,
        currencies: capability.currencies,
        anyCurrency: capability.anyCurrency,
        prettyPaymentSubtypes: capability.prettyPaymentSubtypes,
        // _metadata status can be modified in form
        statusOverride: capability._metadata.status,
    });
    setIsEditModalOpen(true);
  }, []);

  const handleCreateNewCapability = useCallback(() => {
    setTempCapabilityData({
        prettyPaymentType: '',
        prettyDirection: 'BOTH',
        identifier: '',
        partyName: '',
        currencies: [],
        anyCurrency: false,
        prettyPaymentSubtypes: [],
        newConnectionName: '',
        newAddressFull: '',
        statusOverride: 'PENDING_APPROVAL',
    });
    setFormErrors({});
    setIsCreateModalOpen(true);
  }, []);

  const handleSubmitCapability = useCallback(async (formValues: CapabilityFormValues) => {
    if (!authContext?.user) {
        notificationContext?.addNotification({ type: 'error', message: 'Authentication required to perform this action.' });
        return;
    }

    const errors = validateCapabilityForm(formValues);
    if (Object.keys(errors).length > 0) {
        setFormErrors(errors);
        notificationContext?.addNotification({ type: 'error', message: 'Please correct the form errors.' });
        return;
    }
    setFormErrors({});

    try {
      if (selectedCapability && isEditModalOpen) {
        // Update existing
        await mockGraphQLService.updateAccountCapability(selectedCapability.id, formValues, authContext.user);
        notificationContext?.addNotification({ type: 'success', message: `Capability ${selectedCapability.identifier} updated successfully.` });
      } else if (isCreateModalOpen) {
        // Create new
        await mockGraphQLService.createAccountCapability(formValues, authContext.user);
        notificationContext?.addNotification({ type: 'success', message: `New capability created and submitted for approval.` });
      }
      refetch(); // Re-fetch data to reflect changes
      setIsEditModalOpen(false);
      setIsCreateModalOpen(false);
      setSelectedCapability(null);
      setTempCapabilityData(null);
    } catch (e: any) {
      notificationContext?.addNotification({ type: 'error', message: `Failed to save capability: ${e.message}` });
    }
  }, [selectedCapability, isEditModalOpen, isCreateModalOpen, authContext?.user, notificationContext, refetch]);


  const handleDeleteCapability = useCallback(async (capabilityId: string) => {
    if (!authContext?.hasRole('ADMIN') && !authContext?.hasRole('EDITOR')) {
      notificationContext?.addNotification({ type: 'error', message: 'You do not have permission to delete capabilities.' });
      return;
    }
    if (!window.confirm('Are you sure you want to permanently delete (archive) this capability? This action cannot be undone easily.')) {
        return;
    }
    try {
      if (authContext?.user) {
        await mockGraphQLService.deleteAccountCapability(capabilityId, authContext.user);
        notificationContext?.addNotification({ type: 'success', message: 'Capability archived successfully.' });
        refetch();
        handleCloseDetailPanel();
      }
    } catch (e: any) {
      notificationContext?.addNotification({ type: 'error', message: `Failed to delete capability: ${e.message}` });
    }
  }, [authContext, notificationContext, refetch, handleCloseDetailPanel]);

  const handleRestoreCapability = useCallback(async (capabilityId: string) => {
    if (!authContext?.hasRole('ADMIN') && !authContext?.hasRole('EDITOR')) {
      notificationContext?.addNotification({ type: 'error', message: 'You do not have permission to restore capabilities.' });
      return;
    }
    if (!window.confirm('Are you sure you want to restore this capability? It will be set to PENDING_APPROVAL status.')) {
        return;
    }
    try {
      if (authContext?.user) {
        await mockGraphQLService.restoreAccountCapability(capabilityId, authContext.user);
        notificationContext?.addNotification({ type: 'success', message: 'Capability restored successfully and is now PENDING_APPROVAL.' });
        refetch();
        handleCloseDetailPanel();
      }
    } catch (e: any) {
      notificationContext?.addNotification({ type: 'error', message: `Failed to restore capability: ${e.message}` });
    }
  }, [authContext, notificationContext, refetch, handleCloseDetailPanel]);


  if (error && networkStatus !== NetworkStatus.refetch) return <div style={{ color: themeContext?.colors.text }}>Error: {error.message}</div>;

  return (
    <div style={{ color: themeContext?.colors.text }}>
      <h2 style={{ color: themeContext?.colors.text }}>Account Capabilities Management</h2>
      <p style={{ color: themeContext?.colors.subtext }}>View, filter, and manage payment and transaction capabilities across accounts.</p>

      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '20px' }}>
        <Button onClick={handleCreateNewCapability} type="primary" icon={<MdAdd />} disabled={!authContext?.hasRole('EDITOR')}>
          Create New Capability
        </Button>
        <div style={{ display: 'flex', gap: '10px' }}>
          <Input
            name="search"
            value={filterCriteria.searchQuery || ''}
            onChange={(e) => handleFilterChange({ searchQuery: e.target.value })}
            placeholder="Search capabilities..."
            theme={theme}
            style={{ width: '250px' }}
          />
          <Button onClick={() => refetch()} type="secondary" icon={<MdRefresh />}>Refresh</Button>
          <Button onClick={() => setFilterCriteria({})} type="secondary" icon={<MdClear />}>Clear Filters</Button>
        </div>
      </div>

      <AccountCapabilityFilterBar
        filters={filterCriteria}
        onFilterChange={handleFilterChange}
        theme={theme}
        config={configContext}
      />

      <div style={styles.card(theme)}>
        <AccountCapabilityTable
          capabilities={capabilities}
          loading={loading && networkStatus !== NetworkStatus.fetchMore} // Only show loader for initial load/refetch, not fetchMore
          onViewDetails={handleViewDetails}
          onEdit={handleEditCapability}
          onDelete={handleDeleteCapability}
          onRestore={handleRestoreCapability}
          sortCriteria={sortCriteria}
          onSortChange={handleSortChange}
          theme={theme}
          authContext={authContext}
        />

        <PaginationControls
          pageInfo={pageInfo}
          onPageChange={handlePageChange}
          onItemsPerPageChange={handleItemsPerPageChange}
          itemsPerPage={paginationVariables.first}
          currentPage={paginationVariables.currentPage}
          loading={loading}
          theme={theme}
        />
      </div>

      {isDetailPanelOpen && selectedCapability && (
        <AccountCapabilityDetailPanel
          capability={selectedCapability}
          onClose={handleCloseDetailPanel}
          onEdit={() => handleEditCapability(selectedCapability)}
          onDelete={() => handleDeleteCapability(selectedCapability.id)}
          onRestore={() => handleRestoreCapability(selectedCapability.id)}
          theme={theme}
          authContext={authContext}
        />
      )}

      {(isEditModalOpen || isCreateModalOpen) && (
        <CapabilityEditorModal
          isOpen={isEditModalOpen || isCreateModalOpen}
          onClose={() => { setIsEditModalOpen(false); setIsCreateModalOpen(false); setTempCapabilityData(null); setFormErrors({}); }}
          onSubmit={handleSubmitCapability}
          initialData={tempCapabilityData}
          isEditMode={isEditModalOpen}
          formErrors={formErrors}
          theme={theme}
          config={configContext}
          currentUser={authContext?.user}
          addNotification={notificationContext?.addNotification}
        />
      )}
    </div>
  );
};


export const AccountCapabilityFilterBar: React.FC<{
  filters: CapabilityFilterCriteria;
  onFilterChange: (newFilters: Partial<CapabilityFilterCriteria>) => void;
  theme: 'light' | 'dark';
  config?: AppConfigContextType;
}> = memo(({ filters, onFilterChange, theme, config }) => {
  const handleSelectChange = (name: keyof CapabilityFilterCriteria) => (e: React.ChangeEvent<HTMLSelectElement>) => {
    onFilterChange({ [name]: e.target.value || undefined });
  };

  const handleMultiSelectChange = (name: keyof CapabilityFilterCriteria) => (e: React.ChangeEvent<HTMLSelectElement>) => {
    const selectedOptions = Array.from(e.target.options).filter(option => option.selected).map(option => option.value);
    onFilterChange({ [name]: selectedOptions.length > 0 ? selectedOptions : undefined });
  };

  const handleCheckboxChange = (name: keyof CapabilityFilterCriteria) => (e: React.ChangeEvent<HTMLInputElement>) => {
    onFilterChange({ [name]: e.target.checked });
  };

  return (
    <div style={{ ...styles.card(theme), marginBottom: '20px', padding: '15px 20px' }}>
      <h3 style={{ marginTop: 0, marginBottom: '15px', display: 'flex', alignItems: 'center', gap: '10px', color: theme === 'light' ? '#333' : '#eee' }}>
        <MdFilterList /> Advanced Filters
      </h3>
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: '15px' }}>
        <Select
          label="Payment Type"
          name="paymentType"
          value={filters.paymentType || ''}
          onChange={handleSelectChange('paymentType')}
          options={config?.paymentTypes.map(type => ({ value: type, label: type })) || []}
          theme={theme}
        />
        <Select
          label="Direction"
          name="direction"
          value={filters.direction || ''}
          onChange={handleSelectChange('direction')}
          options={config?.directions.map(dir => ({ value: dir, label: capitalize(dir) })) || []}
          theme={theme}
        />
        <Select
          label="Currency"
          name="currency"
          value={filters.currency || ''}
          onChange={handleSelectChange('currency')}
          options={config?.currencies.map(curr => ({ value: curr, label: curr })) || []}
          theme={theme}
        />
        <Select
            label="Status"
            name="status"
            value={Array.isArray(filters.status) ? filters.status.join(',') : ''} // This is a simplification for select. Actual multi-select needs custom rendering or component
            onChange={handleMultiSelectChange('status')}
            options={config?.statuses.map(status => ({ value: status, label: capitalize(status.replace('_', ' ')) })) || []}
            theme={theme}
            multiple={true}
        />
        <Input
          label="Party Name"
          name="partyName"
          value={filters.partyName || ''}
          onChange={(e) => onFilterChange({ partyName: e.target.value })}
          placeholder="Filter by Party Name"
          theme={theme}
        />
        <Checkbox
          label="Show Archived"
          name="showDeleted"
          checked={filters.showDeleted || false}
          onChange={handleCheckboxChange('showDeleted')}
          theme={theme}
        />
      </div>
    </div>
  );
});

export const AccountCapabilityTable: React.FC<{
  capabilities: AccountCapabilityNode[];
  loading: boolean;
  onViewDetails: (capability: AccountCapabilityNode) => void;
  onEdit: (capability: AccountCapabilityNode) => void;
  onDelete: (id: string) => void;
  onRestore: (id: string) => void;
  sortCriteria: CapabilitySortCriteria;
  onSortChange: (field: CapabilitySortCriteria['field']) => void;
  theme: 'light' | 'dark';
  authContext?: AuthContextType;
}> = memo(({ capabilities, loading, onViewDetails, onEdit, onDelete, onRestore, sortCriteria, onSortChange, theme, authContext }) => {
  const columns: { label: string; field: keyof AccountCapabilityNode | keyof AccountCapabilityMetadata | 'status'; sortable?: boolean }[] = useMemo(() => [
    { label: 'Identifier', field: 'identifier', sortable: true },
    { label: 'Party Name', field: 'partyName', sortable: true },
    { label: 'Payment Type', field: 'prettyPaymentType', sortable: true },
    { label: 'Direction', field: 'prettyDirection', sortable: true },
    { label: 'Currencies', field: 'currencies' },
    { label: 'Connection', field: 'connection' },
    { label: 'Status', field: 'status', sortable: true },
    { label: 'Last Updated', field: 'updatedAt', sortable: true },
    { label: 'Actions', field: 'id' },
  ], []);

  const getSortIcon = (field: string) => {
    if (sortCriteria.field === field) {
      return sortCriteria.direction === 'ASC' ? <MdSort style={{ transform: 'rotate(180deg)' }} /> : <MdSort />;
    }
    return null;
  };

  return (
    <div style={{ overflowX: 'auto' }}>
      <table style={styles.table(theme)}>
        <thead>
          <tr>
            {columns.map((col) => (
              <th
                key={col.label}
                style={styles.th(theme)}
                onClick={col.sortable ? () => onSortChange(col.field) : undefined}
              >
                <div style={{ display: 'flex', alignItems: 'center', gap: '5px' }}>
                  {col.label} {getSortIcon(col.field as string)}
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {loading ? (
            Array.from({ length: DEFAULT_ITEMS_PER_PAGE }).map((_, i) => (
              <tr key={i}>
                {columns.map((col, j) => (
                  <td key={j} style={styles.td(theme)}>
                    <SkeletonLoader theme={theme} width={j === 0 ? '120px' : '80px'} height="16px" />
                  </td>
                ))}
              </tr>
            ))
          ) : (
            capabilities.map((cap) => (
              <tr key={cap.id}>
                <td style={styles.td(theme)}>{cap.identifier}</td>
                <td style={styles.td(theme)}>{cap.partyName}</td>
                <td style={styles.td(theme)}>{cap.prettyPaymentType}</td>
                <td style={styles.td(theme)}>{capitalize(cap.prettyDirection)}</td>
                <td style={styles.td(theme)}>
                  {cap.anyCurrency ? (
                    <span style={styles.tag(cap.currencyTagColors[0] || '#607D8B')}>ANY</span>
                  ) : (
                    cap.currencies.map((curr, i) => (
                      <span key={i} style={styles.tag(cap.currencyTagColors[i] || '#2196F3')}>
                        {curr}
                      </span>
                    ))
                  )}
                </td>
                <td style={styles.td(theme)}>{cap.connection.bestName}</td>
                <td style={styles.td(theme)}>
                    <span style={styles.badge(cap._metadata.status === 'ACTIVE' ? 'success' : cap._metadata.status === 'REJECTED' ? 'error' : 'info')}>
                        {capitalize(cap._metadata.status.replace('_', ' '))}
                    </span>
                    {cap.discardedAt && (
                        <span style={{...styles.badge('warning'), marginLeft: '5px'}}>
                            <MdDelete /> Archived
                        </span>
                    )}
                </td>
                <td style={styles.td(theme)}>{formatDateTime(cap._metadata.updatedAt, 'YYYY-MM-DD')}</td>
                <td style={styles.td(theme)}>
                  <div style={{ display: 'flex', gap: '5px' }}>
                    <Button onClick={() => onViewDetails(cap)} type="info" size="small" icon={<MdInfo />}>Details</Button>
                    {(authContext?.hasRole('EDITOR') || authContext?.hasRole('ADMIN')) && !cap.discardedAt && (
                        <Button onClick={() => onEdit(cap)} type="primary" size="small" icon={<MdEdit />}>Edit</Button>
                    )}
                    {(authContext?.hasRole('ADMIN')) && !cap.discardedAt && (
                        <Button onClick={() => onDelete(cap.id)} type="danger" size="small" icon={<MdDelete />}>Archive</Button>
                    )}
                    {(authContext?.hasRole('ADMIN') || authContext?.hasRole('EDITOR')) && cap.discardedAt && (
                        <Button onClick={() => onRestore(cap.id)} type="success" size="small" icon={<MdRestore />}>Restore</Button>
                    )}
                  </div>
                </td>
              </tr>
            ))
          )}
          {capabilities.length === 0 && !loading && (
            <tr>
              <td colSpan={columns.length} style={{ ...styles.td(theme), textAlign: 'center' }}>No capabilities found matching your criteria.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  );
});

// Import MdRefresh and MdRestore for use above
const MdRefresh = MdRefresh;
const MdRestore = MdHistory; // Using history icon for restore for now


export const PaginationControls: React.FC<{
  pageInfo?: PageInfo;
  onPageChange: (direction: 'next' | 'prev' | 'first' | 'last') => void;
  onItemsPerPageChange: (e: React.ChangeEvent<HTMLSelectElement>) => void;
  itemsPerPage: number;
  currentPage: number;
  loading: boolean;
  theme: 'light' | 'dark';
}> = memo(({ pageInfo, onPageChange, onItemsPerPageChange, itemsPerPage, currentPage, loading, theme }) => {
  return (
    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginTop: '20px', padding: '10px 0', borderTop: `1px solid ${theme === 'light' ? '#eee' : '#444'}` }}>
      <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
        <span style={{ color: theme === 'light' ? '#555' : '#ccc' }}>Items per page:</span>
        <select value={itemsPerPage} onChange={onItemsPerPageChange} disabled={loading} style={styles.select(theme)}>
          {ITEMS_PER_PAGE_OPTIONS.map(option => (
            <option key={option} value={option}>{option}</option>
          ))}
        </select>
      </div>
      <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
        <span style={{ color: theme === 'light' ? '#555' : '#ccc' }}>Page {currentPage}</span>
        <Button onClick={() => onPageChange('first')} disabled={loading || !pageInfo?.hasPreviousPage} type="secondary" size="small" icon={<MdFirstPage />} />
        <Button onClick={() => onPageChange('prev')} disabled={loading || !pageInfo?.hasPreviousPage} type="secondary" size="small" icon={<MdNavigateBefore />} />
        <Button onClick={() => onPageChange('next')} disabled={loading || !pageInfo?.hasNextPage} type="secondary" size="small" icon={<MdNavigateNext />} />
        {/* No 'last' page button for cursor-based pagination unless total count is known */}
      </div>
    </div>
  );
});


export const AccountCapabilityDetailPanel: React.FC<{
  capability: AccountCapabilityNode;
  onClose: () => void;
  onEdit: () => void;
  onDelete: () => void;
  onRestore: () => void;
  theme: 'light' | 'dark';
  authContext?: AuthContextType;
}> = memo(({ capability, onClose, onEdit, onDelete, onRestore, theme, authContext }) => {
    const [auditLogs, setAuditLogs] = useState<AuditEvent[]>([]);
    const [loadingAudit, setLoadingAudit] = useState(true);

    useEffect(() => {
        setLoadingAudit(true);
        mockAuditService.getEvents(capability.id, 'AccountCapability').then(logs => {
            setAuditLogs(logs);
            setLoadingAudit(false);
        }).catch(() => {
            setAuditLogs([]);
            setLoadingAudit(false);
        });
    }, [capability.id]);


    return ReactDOM.createPortal(
        <motion.div
            initial={{ x: '100%' }}
            animate={{ x: '0%' }}
            exit={{ x: '100%' }}
            transition={{ duration: 0.3 }}
            style={{
                position: 'fixed',
                top: 0,
                right: 0,
                height: '100vh',
                width: '450px',
                backgroundColor: theme === 'light' ? '#fff' : '#222',
                boxShadow: '-4px 0 12px rgba(0,0,0,0.15)',
                zIndex: 2000,
                padding: '20px',
                overflowY: 'auto',
                color: theme === 'light' ? '#333' : '#eee',
                display: 'flex',
                flexDirection: 'column',
            }}
        >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderBottom: `1px solid ${theme === 'light' ? '#eee' : '#444'}`, paddingBottom: '15px', marginBottom: '20px' }}>
                <h3 style={{ margin: 0, color: theme === 'light' ? '#333' : '#eee' }}>Capability Details: {capability.identifier}</h3>
                <Button onClick={onClose} type="text" size="small" icon={<MdClose />} />
            </div>

            <div style={{ flexGrow: 1, overflowY: 'auto' }}>
                <DetailRow label="ID" value={capability.id} theme={theme} />
                <DetailRow label="Payment Type" value={capability.prettyPaymentType} theme={theme} />
                <DetailRow label="Direction" value={capitalize(capability.prettyDirection)} theme={theme} />
                <DetailRow label="Party Name" value={capability.partyName} theme={theme} />
                <DetailRow label="Currencies" theme={theme}>
                    {capability.anyCurrency ? (
                        <span style={styles.tag(capability.currencyTagColors[0] || '#607D8B')}>ANY</span>
                    ) : (
                        capability.currencies.map((curr, i) => (
                            <span key={i} style={styles.tag(capability.currencyTagColors[i] || '#2196F3')}>
                                {curr}
                            </span>
                        ))
                    )}
                </DetailRow>
                <DetailRow label="Subtypes" theme={theme}>
                    {capability.prettyPaymentSubtypes.map((subtype, i) => (
                        <span key={i} style={styles.tag(capability.paymentSubtypeTagColors[i] || '#795548')}>
                            {subtype}
                        </span>
                    ))}
                </DetailRow>
                <DetailRow label="Connection" value={capability.connection.bestName} theme={theme} />
                <DetailRow label="Connection ID" value={capability.connection.id} theme={theme} />
                <DetailRow label="Address" value={capability.address.full} theme={theme} />
                <DetailRow label="Status" theme={theme}>
                    <span style={styles.badge(capability._metadata.status === 'ACTIVE' ? 'success' : capability._metadata.status === 'REJECTED' ? 'error' : 'info')}>
                        {capitalize(capability._metadata.status.replace('_', ' '))}
                    </span>
                </DetailRow>
                <DetailRow label="Created At" value={formatDateTime(capability._metadata.createdAt)} theme={theme} />
                <DetailRow label="Created By" value={capability._metadata.createdBy} theme={theme} />
                <DetailRow label="Last Updated" value={formatDateTime(capability._metadata.updatedAt)} theme={theme} />
                <DetailRow label="Updated By" value={capability._metadata.updatedBy} theme={theme} />
                {capability._metadata.approvedAt && <DetailRow label="Approved At" value={formatDateTime(capability._metadata.approvedAt)} theme={theme} />}
                {capability._metadata.approverId && <DetailRow label="Approved By" value={MOCK_USERS.find(u => u.id === capability._metadata.approverId)?.name || 'N/A'} theme={theme} />}
                {capability._metadata.reviewNotes && <DetailRow label="Review Notes" value={capability._metadata.reviewNotes} theme={theme} />}
                {capability.discardedAt && <DetailRow label="Archived At" value={formatDateTime(capability.discardedAt)} theme={theme} isWarning={true} />}

                <h4 style={{ borderTop: `1px solid ${theme === 'light' ? '#eee' : '#444'}`, paddingTop: '15px', marginTop: '20px', color: theme === 'light' ? '#333' : '#eee' }}>Audit History</h4>
                {loadingAudit ? (
                    <div style={{ padding: '10px 0' }}>
                        <SkeletonLoader theme={theme} height="16px" width="90%" /><br/>
                        <SkeletonLoader theme={theme} height="16px" width="80%" /><br/>
                        <SkeletonLoader theme={theme} height="16px" width="95%" />
                    </div>
                ) : auditLogs.length === 0 ? (
                    <p style={{ color: theme === 'light' ? '#555' : '#ccc' }}>No audit events for this capability.</p>
                ) : (
                    <ul style={{ listStyle: 'none', padding: 0 }}>
                        {auditLogs.map(log => (
                            <li key={log.id} style={{ borderBottom: `1px dashed ${theme === 'light' ? '#f0f0f0' : '#333'}`, padding: '8px 0', fontSize: '0.9em' }}>
                                <span style={{ fontWeight: 'bold' }}>{log.actor}</span> {log.action.replace(/_/g, ' ').toLowerCase()}
                                <div style={{ color: theme === 'light' ? '#777' : '#999', fontSize: '0.8em' }}>{formatDateTime(log.timestamp)}</div>
                            </li>
                        ))}
                    </ul>
                )}
            </div>

            <div style={{ borderTop: `1px solid ${theme === 'light' ? '#eee' : '#444'}`, paddingTop: '15px', marginTop: '20px', display: 'flex', gap: '10px' }}>
                {(authContext?.hasRole('EDITOR') || authContext?.hasRole('ADMIN')) && !capability.discardedAt && (
                    <Button onClick={onEdit} type="primary" icon={<MdEdit />}>Edit Capability</Button>
                )}
                {(authContext?.hasRole('ADMIN')) && !capability.discardedAt && (
                    <Button onClick={onDelete} type="danger" icon={<MdDelete />}>Archive Capability</Button>
                )}
                {(authContext?.hasRole('ADMIN') || authContext?.hasRole('EDITOR')) && capability.discardedAt && (
                    <Button onClick={onRestore} type="success" icon={<MdRestore />}>Restore Capability</Button>
                )}
            </div>
        </motion.div>,
        document.body
    );
});

const DetailRow: React.FC<React.PropsWithChildren<{ label: string; value?: string | React.ReactNode; theme: 'light' | 'dark'; isWarning?: boolean }>> = ({ label, value, children, theme, isWarning }) => (
    <div style={{ marginBottom: '10px', paddingBottom: '10px', borderBottom: `1px dashed ${theme === 'light' ? '#f0f0f0' : '#333'}` }}>
        <div style={{ fontWeight: 'bold', color: theme === 'light' ? '#555' : '#ccc', fontSize: '0.9em', marginBottom: '3px' }}>{label}:</div>
        <div style={{ color: isWarning ? '#F44336' : (theme === 'light' ? '#333' : '#eee'), fontSize: '1em' }}>
            {children || value || 'N/A'}
        </div>
    </div>
);


export const CapabilityEditorModal: React.FC<{
  isOpen: boolean;
  onClose: () => void;
  onSubmit: (values: CapabilityFormValues) => void;
  initialData: CapabilityFormValues | null;
  isEditMode: boolean;
  formErrors: Record<string, string>;
  theme: 'light' | 'dark';
  config?: AppConfigContextType;
  currentUser?: User | null;
  addNotification?: (notification: Omit<Notification, 'id' | 'timestamp' | 'read'>) => void;
}> = memo(({ isOpen, onClose, onSubmit, initialData, isEditMode, formErrors, theme, config, currentUser, addNotification }) => {
  const [formData, setFormData] = useState<CapabilityFormValues>(initialData || {
    prettyPaymentType: '',
    prettyDirection: 'BOTH',
    identifier: '',
    partyName: '',
    currencies: [],
    anyCurrency: false,
    prettyPaymentSubtypes: [],
    newConnectionName: '',
    newAddressFull: '',
    statusOverride: 'PENDING_APPROVAL',
  });
  const [internalErrors, setInternalErrors] = useState<Record<string, string>>({});

  useEffect(() => {
    if (isOpen && initialData) {
      setFormData(initialData);
    } else if (isOpen) { // Reset for create mode
        setFormData({
            prettyPaymentType: '',
            prettyDirection: 'BOTH',
            identifier: '',
            partyName: '',
            currencies: [],
            anyCurrency: false,
            prettyPaymentSubtypes: [],
            newConnectionName: '',
            newAddressFull: '',
            statusOverride: 'PENDING_APPROVAL',
        });
    }
    setInternalErrors({}); // Clear errors on modal open/close
  }, [isOpen, initialData]);

  const handleChange = useCallback((e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {
    const { name, value, type } = e.target;
    if (type === 'checkbox') {
        setFormData(prev => ({ ...prev, [name]: (e.target as HTMLInputElement).checked }));
    } else if (name === 'currencies' || name === 'prettyPaymentSubtypes') {
        const selectElement = e.target as HTMLSelectElement;
        const selectedValues = Array.from(selectElement.options).filter(option => option.selected).map(option => option.value);
        setFormData(prev => ({ ...prev, [name]: selectedValues }));
    } else {
        setFormData(prev => ({ ...prev, [name]: value }));
    }
  }, []);

  const handleStatusChange = useCallback((e: React.ChangeEvent<HTMLSelectElement>) => {
    setFormData(prev => ({ ...prev, statusOverride: e.target.value as AccountCapabilityMetadata['status'] }));
  }, []);


  const handleSubmit = useCallback(async (e: React.FormEvent) => {
    e.preventDefault();
    const validationErrors = validateCapabilityForm(formData);
    setInternalErrors(validationErrors);
    if (Object.keys(validationErrors).length > 0) {
        addNotification?.({ type: 'error', message: 'Please correct the highlighted form errors.' });
        return;
    }
    onSubmit(formData);
  }, [formData, onSubmit, addNotification]);

  const allErrors = { ...formErrors, ...internalErrors };

  const canChangeStatus = currentUser?.hasRole('APPROVER') || currentUser?.hasRole('ADMIN');

  return (
    <Modal isOpen={isOpen} onClose={onClose} title={isEditMode ? 'Edit Account Capability' : 'Create New Account Capability'}>
      <form onSubmit={handleSubmit}>
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '20px' }}>
          <Input
            label="Payment Type"
            name="prettyPaymentType"
            value={formData.prettyPaymentType}
            onChange={handleChange}
            error={allErrors.prettyPaymentType}
            theme={theme}
            placeholder="e.g., Transfer, Payroll"
          />
          <Select
            label="Direction"
            name="prettyDirection"
            value={formData.prettyDirection}
            onChange={handleChange}
            error={allErrors.prettyDirection}
            options={config?.directions.map(d => ({ value: d, label: capitalize(d) })) || []}
            theme={theme}
          />
          <Input
            label="Identifier"
            name="identifier"
            value={formData.identifier}
            onChange={handleChange}
            error={allErrors.identifier}
            theme={theme}
            placeholder="Unique identifier for the capability"
          />
          <Input
            label="Party Name"
            name="partyName"
            value={formData.partyName}
            onChange={handleChange}
            error={allErrors.partyName}
            theme={theme}
            placeholder="e.g., Acme Corp"
          />
          <Select
            label="Currencies (Multi-select)"
            name="currencies"
            value={formData.currencies}
            onChange={handleChange}
            error={allErrors.currencies}
            options={config?.currencies.map(c => ({ value: c, label: c })) || []}
            theme={theme}
            multiple={true}
          />
          <Checkbox
            label="Any Currency"
            name="anyCurrency"
            checked={formData.anyCurrency}
            onChange={handleChange}
            theme={theme}
          />
          <Select
            label="Payment Subtypes (Multi-select)"
            name="prettyPaymentSubtypes"
            value={formData.prettyPaymentSubtypes}
            onChange={handleChange}
            options={['Domestic', 'International', 'SWIFT', 'ACH', 'SEPA', 'RTGS'].map(s => ({ value: s, label: s }))} // Mock common subtypes
            theme={theme}
            multiple={true}
          />
          <Input
            label="New Connection Name (Optional)"
            name="newConnectionName"
            value={formData.newConnectionName || ''}
            onChange={handleChange}
            error={allErrors.newConnectionName}
            theme={theme}
            placeholder="e.g., Global Treasury Desk"
          />
          <Input
            label="New Address Full (Optional)"
            name="newAddressFull"
            value={formData.newAddressFull || ''}
            onChange={handleChange}
            error={allErrors.newAddressFull}
            theme={theme}
            placeholder="e.g., 100 Main Street, New York, NY 10001"
          />
          {isEditMode && canChangeStatus && (
              <Select
                label="Capability Status"
                name="statusOverride"
                value={formData.statusOverride || 'PENDING_APPROVAL'}
                onChange={handleStatusChange}
                options={config?.statuses.map(s => ({ value: s, label: capitalize(s.replace('_', ' ')) })) || []}
                theme={theme}
                error={allErrors.statusOverride}
              />
          )}
          {isEditMode && !canChangeStatus && (
              <Input
                label="Capability Status"
                name="statusOverride"
                value={capitalize(formData.statusOverride?.replace('_', ' ') || 'PENDING_APPROVAL')}
                onChange={() => {}} // Read-only
                theme={theme}
                readOnly={true}
              />
          )}
        </div>
        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '10px', marginTop: '30px' }}>
          <Button onClick={onClose} type="secondary" icon={<MdCancel />}>Cancel</Button>
          <Button type="primary" icon={<MdSave />}>
            {isEditMode ? 'Save Changes' : 'Create Capability'}
          </Button>
        </div>
      </form>
    </Modal>
  );
});


export const ConfigurationPage: React.FC = () => {
    const themeContext = useContext(ThemeContext);
    const authContext = useContext(AuthContext);
    const notificationContext = useContext(NotificationContext);
    const theme = themeContext?.theme || 'light';

    const [settings, setSettings] = useState({
        enableAuditLogging: true,
        maxCapabilities: 500,
        defaultItemsPerPage: DEFAULT_ITEMS_PER_PAGE,
        autoApproveMinorChanges: false,
        paymentGatewayTimeout: 30000, // in ms
    });
    const [isSaving, setIsSaving] = useState(false);

    useEffect(() => {
        // Simulate fetching settings
        setTimeout(() => {
            // This would be from a backend API
        }, 500);
    }, []);

    const handleChange = useCallback((e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
        const { name, value, type } = e.target;
        setSettings(prev => ({
            ...prev,
            [name]: type === 'checkbox' ? (e.target as HTMLInputElement).checked : value,
        }));
    }, []);

    const handleSaveSettings = useCallback(async () => {
        if (!authContext?.hasRole('ADMIN')) {
            notificationContext?.addNotification({ type: 'error', message: 'You do not have permission to modify configurations.' });
            return;
        }
        setIsSaving(true);
        try {
            // Simulate API call to save settings
            await new Promise(resolve => setTimeout(resolve, 1000));
            notificationContext?.addNotification({ type: 'success', message: 'Application settings saved successfully.' });
        } catch (error) {
            notificationContext?.addNotification({ type: 'error', message: 'Failed to save settings.' });
        } finally {
            setIsSaving(false);
        }
    }, [authContext, notificationContext]);

    const canEdit = authContext?.hasRole('ADMIN');

    return (
        <div style={{ color: themeContext?.colors.text }}>
            <h2 style={{ color: themeContext?.colors.text }}>Application Configuration</h2>
            <p style={{ color: themeContext?.colors.subtext }}>Manage global settings for the Account Capabilities Manager.</p>

            <div style={styles.card(theme)}>
                <h3 style={{ marginTop: 0, color: themeContext?.colors.text }}>General Settings</h3>
                <div style={{ display: 'grid', gridTemplateColumns: '1fr', gap: '15px' }}>
                    <Checkbox
                        label="Enable detailed audit logging"
                        name="enableAuditLogging"
                        checked={settings.enableAuditLogging}
                        onChange={handleChange}
                        theme={theme}
                    />
                    <Input
                        label="Maximum Capabilities Limit"
                        name="maxCapabilities"
                        type="number"
                        value={settings.maxCapabilities}
                        onChange={handleChange}
                        theme={theme}
                        readOnly={!canEdit}
                        placeholder="e.g., 500"
                    />
                    <Select
                        label="Default Items per Page in Lists"
                        name="defaultItemsPerPage"
                        value={settings.defaultItemsPerPage.toString()}
                        onChange={handleChange}
                        options={ITEMS_PER_PAGE_OPTIONS.map(num => ({ value: num.toString(), label: num.toString() }))}
                        theme={theme}
                        readOnly={!canEdit}
                    />
                    <Checkbox
                        label="Auto-approve minor capability changes"
                        name="autoApproveMinorChanges"
                        checked={settings.autoApproveMinorChanges}
                        onChange={handleChange}
                        theme={theme}
                        // Note: A real banking app might have more granular approval workflows
                    />
                    <Input
                        label="Payment Gateway Timeout (ms)"
                        name="paymentGatewayTimeout"
                        type="number"
                        value={settings.paymentGatewayTimeout}
                        onChange={handleChange}
                        theme={theme}
                        readOnly={!canEdit}
                    />
                </div>
                <div style={{ marginTop: '30px', textAlign: 'right' }}>
                    <Button onClick={handleSaveSettings} disabled={isSaving || !canEdit} type="primary" icon={<MdSave />}>
                        {isSaving ? 'Saving...' : 'Save Settings'}
                    </Button>
                </div>
            </div>

            <div style={styles.card(theme)}>
                <h3 style={{ marginTop: 0, color: themeContext?.colors.text }}>Compliance & Security</h3>
                <p style={{ color: themeContext?.colors.subtext }}>These settings require higher level approval and may impact regulatory compliance.</p>
                <div style={{ display: 'flex', justifyContent: 'flex-end', marginTop: '20px' }}>
                    <Button type="secondary" icon={<MdLock />}>Request Compliance Review</Button>
                </div>
            </div>
        </div>
    );
};

export const UserManagementPage: React.FC = () => {
  const themeContext = useContext(ThemeContext);
  const authContext = useContext(AuthContext);
  const notificationContext = useContext(NotificationContext);
  const theme = themeContext?.theme || 'light';

  const [users, setUsers] = useState<User[]>(MOCK_USERS);
  const [editingUser, setEditingUser] = useState<User | null>(null);
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [formValues, setFormValues] = useState<Partial<User>>({});
  const [formErrors, setFormErrors] = useState<Record<string, string>>({});

  const canManageUsers = authContext?.hasRole('ADMIN');

  const handleEdit = (user: User) => {
    if (!canManageUsers) {
        notificationContext?.addNotification({ type: 'error', message: 'You do not have permission to edit users.' });
        return;
    }
    setEditingUser(user);
    setFormValues({ ...user, roles: [...user.roles] }); // Ensure roles is a new array for multi-select
    setIsModalOpen(true);
  };

  const handleCreate = () => {
    if (!canManageUsers) {
        notificationContext?.addNotification({ type: 'error', message: 'You do not have permission to create users.' });
        return;
    }
    setEditingUser(null);
    setFormValues({
      id: generateId(),
      name: '',
      email: '',
      roles: ['VIEWER'],
      lastLogin: moment().toISOString(),
      preferences: { theme: 'light', language: 'en', notificationsEnabled: true },
    });
    setIsModalOpen(true);
  };

  const handleChange = useCallback((e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value, type } = e.target;
    if (name === 'roles') {
        const selectElement = e.target as HTMLSelectElement;
        const selectedRoles = Array.from(selectElement.options).filter(option => option.selected).map(option => option.value as UserRole);
        setFormValues(prev => ({ ...prev, roles: selectedRoles }));
    } else {
        setFormValues(prev => ({ ...prev, [name]: value }));
    }
  }, []);

  const handleSubmit = useCallback(async (e: React.FormEvent) => {
    e.preventDefault();
    setFormErrors({});
    if (!formValues.name) setFormErrors(prev => ({ ...prev, name: 'Name is required.' }));
    if (!formValues.email) setFormErrors(prev => ({ ...prev, email: 'Email is required.' }));
    if (!formValues.roles || formValues.roles.length === 0) setFormErrors(prev => ({ ...prev, roles: 'At least one role is required.' }));

    if (Object.keys(formErrors).length > 0) {
        notificationContext?.addNotification({ type: 'error', message: 'Please correct the form errors.' });
        return;
    }

    try {
        await new Promise(resolve => setTimeout(resolve, 500)); // Simulate API call
        if (editingUser) {
            setUsers(prev => prev.map(u => u.id === editingUser.id ? { ...u, ...formValues as User } : u));
            notificationContext?.addNotification({ type: 'success', message: `User ${formValues.name} updated.` });
            mockAuditService.logEvent({
                id: uuidv4(),
                timestamp: moment().toISOString(),
                actor: authContext?.user?.name || 'Unknown',
                action: 'UPDATE_USER',
                entityId: editingUser.id,
                entityType: 'User',
                details: { old: editingUser, new: formValues },
            });
        } else {
            const newUser: User = { ...formValues as User, id: generateId(), lastLogin: moment().toISOString(), preferences: { theme: 'light', language: 'en', notificationsEnabled: true } };
            setUsers(prev => [...prev, newUser]);
            notificationContext?.addNotification({ type: 'success', message: `User ${formValues.name} created.` });
            mockAuditService.logEvent({
                id: uuidv4(),
                timestamp: moment().toISOString(),
                actor: authContext?.user?.name || 'Unknown',
                action: 'CREATE_USER',
                entityId: newUser.id,
                entityType: 'User',
                details: { new: newUser },
            });
        }
        setIsModalOpen(false);
        setEditingUser(null);
        setFormValues({});
    } catch (e: any) {
        notificationContext?.addNotification({ type: 'error', message: `Failed to save user: ${e.message}` });
    }
  }, [formValues, editingUser, notificationContext, authContext, formErrors]);

  const handleDelete = useCallback(async (id: string) => {
    if (!canManageUsers) {
        notificationContext?.addNotification({ type: 'error', message: 'You do not have permission to delete users.' });
        return;
    }
    if (!window.confirm('Are you sure you want to delete this user?')) return;
    try {
        await new Promise(resolve => setTimeout(resolve, 500)); // Simulate API call
        setUsers(prev => prev.filter(u => u.id !== id));
        notificationContext?.addNotification({ type: 'success', message: 'User deleted.' });
        mockAuditService.logEvent({
            id: uuidv4(),
            timestamp: moment().toISOString(),
            actor: authContext?.user?.name || 'Unknown',
            action: 'DELETE_USER',
            entityId: id,
            entityType: 'User',
            details: { userId: id },
        });
    } catch (e: any) {
        notificationContext?.addNotification({ type: 'error', message: `Failed to delete user: ${e.message}` });
    }
  }, [notificationContext, authContext, canManageUsers]);

  const allRoles: UserRole[] = useMemo(() => ['ADMIN', 'MANAGER', 'VIEWER', 'APPROVER', 'EDITOR'], []);

  return (
    <div style={{ color: themeContext?.colors.text }}>
      <h2 style={{ color: themeContext?.colors.text }}>User Management</h2>
      <p style={{ color: themeContext?.colors.subtext }}>Manage user accounts and their assigned roles within the application.</p>

      <div style={{ marginBottom: '20px', textAlign: 'right' }}>
        <Button onClick={handleCreate} type="primary" icon={<MdAdd />} disabled={!canManageUsers}>
          Add New User
        </Button>
      </div>

      <div style={styles.card(theme)}>
        <table style={styles.table(theme)}>
          <thead>
            <tr>
              <th style={styles.th(theme)}>Name</th>
              <th style={styles.th(theme)}>Email</th>
              <th style={styles.th(theme)}>Roles</th>
              <th style={styles.th(theme)}>Last Login</th>
              <th style={styles.th(theme)}>Actions</th>
            </tr>
          </thead>
          <tbody>
            {users.map((user) => (
              <tr key={user.id}>
                <td style={styles.td(theme)}>{user.name}</td>
                <td style={styles.td(theme)}>{user.email}</td>
                <td style={styles.td(theme)}>
                  {user.roles.map((role, i) => (
                    <span key={i} style={{ ...styles.tag('#6a1b9a'), marginRight: '5px', marginBottom: '3px' }}>
                      {capitalize(role)}
                    </span>
                  ))}
                </td>
                <td style={styles.td(theme)}>{formatDateTime(user.lastLogin)}</td>
                <td style={styles.td(theme)}>
                  <div style={{ display: 'flex', gap: '5px' }}>
                    <Button onClick={() => handleEdit(user)} type="primary" size="small" icon={<MdEdit />} disabled={!canManageUsers}>Edit</Button>
                    <Button onClick={() => handleDelete(user.id)} type="danger" size="small" icon={<MdDelete />} disabled={!canManageUsers || user.id === authContext?.user?.id}>Delete</Button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <Modal isOpen={isModalOpen} onClose={() => { setIsModalOpen(false); setFormErrors({}); }} title={editingUser ? 'Edit User' : 'Create User'}>
        <form onSubmit={handleSubmit}>
          <Input
            label="Name"
            name="name"
            value={formValues.name || ''}
            onChange={handleChange}
            error={formErrors.name}
            theme={theme}
          />
          <Input
            label="Email"
            name="email"
            type="email"
            value={formValues.email || ''}
            onChange={handleChange}
            error={formErrors.email}
            theme={theme}
          />
          <Select
            label="Roles (Multi-select)"
            name="roles"
            value={Array.isArray(formValues.roles) ? formValues.roles : []}
            onChange={handleChange}
            error={formErrors.roles}
            options={allRoles.map(role => ({ value: role, label: capitalize(role) }))}
            theme={theme}
            multiple={true}
          />
          <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '10px', marginTop: '20px' }}>
            <Button onClick={() => { setIsModalOpen(false); setFormErrors({}); }} type="secondary">Cancel</Button>
            <Button type="primary">Save User</Button>
          </div>
        </form>
      </Modal>
    </div>
  );
};


export const NotificationPage: React.FC = () => {
    const notificationContext = useContext(NotificationContext);
    const themeContext = useContext(ThemeContext);
    const theme = themeContext?.theme || 'light';

    const notifications = notificationContext?.notifications || [];

    const handleMarkAsRead = useCallback((id: string) => {
        // In a real app, update backend state
        console.log(`Notification ${id} marked as read.`);
        notificationContext?.removeNotification(id); // For mock, just remove it
    }, [notificationContext]);

    const handleClearAll = useCallback(() => {
        // In a real app, clear all from backend
        notifications.forEach(n => notificationContext?.removeNotification(n.id));
    }, [notifications, notificationContext]);

    return (
        <div style={{ color: themeContext?.colors.text }}>
            <h2 style={{ color: themeContext?.colors.text }}>Notifications</h2>
            <p style={{ color: themeContext?.colors.subtext }}>Your recent system alerts and updates.</p>

            <div style={{ marginBottom: '20px', textAlign: 'right' }}>
                <Button onClick={handleClearAll} type="secondary" icon={<MdClear />} disabled={notifications.length === 0}>
                    Clear All Notifications
                </Button>
            </div>

            <div style={styles.card(theme)}>
                {notifications.length === 0 ? (
                    <p style={{ textAlign: 'center', color: themeContext?.colors.subtext }}>You have no new notifications.</p>
                ) : (
                    <ul style={{ listStyle: 'none', padding: 0 }}>
                        {notifications.map((notification) => (
                            <li key={notification.id} style={{
                                display: 'flex',
                                alignItems: 'center',
                                justifyContent: 'space-between',
                                borderBottom: `1px solid ${theme === 'light' ? '#eee' : '#444'}`,
                                padding: '10px 0',
                                '&:last-child': { borderBottom: 'none' },
                            }}>
                                <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
                                    <span style={styles.badge(notification.type)}>{capitalize(notification.type)}</span>
                                    <span style={{ color: themeContext?.colors.text }}>{notification.message}</span>
                                    <span style={{ fontSize: '0.8em', color: themeContext?.colors.subtext }}>{formatDateTime(notification.timestamp)}</span>
                                </div>
                                <Button onClick={() => handleMarkAsRead(notification.id)} type="text" size="small">Mark as Read</Button>
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </div>
    );
};


export const AuditTrailPage: React.FC = () => {
    const themeContext = useContext(ThemeContext);
    const authContext = useContext(AuthContext);
    const theme = themeContext?.theme || 'light';

    const [auditEvents, setAuditEvents] = useState<AuditEvent[]>([]);
    const [loading, setLoading] = useState(true);
    const [filters, setFilters] = useState<{ actor?: string; action?: string; entityType?: string; entityId?: string }>({});

    useEffect(() => {
        setLoading(true);
        mockAuditService.getEvents().then(events => {
            let filteredEvents = events;
            if (filters.actor) filteredEvents = filteredEvents.filter(e => e.actor.toLowerCase().includes(filters.actor!.toLowerCase()));
            if (filters.action) filteredEvents = filteredEvents.filter(e => e.action === filters.action);
            if (filters.entityType) filteredEvents = filteredEvents.filter(e => e.entityType === filters.entityType);
            if (filters.entityId) filteredEvents = filteredEvents.filter(e => e.entityId.toLowerCase().includes(filters.entityId!.toLowerCase()));
            setAuditEvents(filteredEvents);
            setLoading(false);
        });
    }, [filters]);

    const handleFilterChange = useCallback((name: string, value: string) => {
        setFilters(prev => ({ ...prev, [name]: value || undefined }));
    }, []);

    const allActions = useMemo(() => Array.from(new Set(mockAuditService.events.map(e => e.action))), [mockAuditService.events.length]);
    const allEntityTypes = useMemo(() => Array.from(new Set(mockAuditService.events.map(e => e.entityType))), [mockAuditService.events.length]);


    if (!authContext?.hasRole('ADMIN') && !authContext?.hasRole('MANAGER')) {
        return <div style={{ color: themeContext?.colors.text }}>You do not have permission to view the audit trail.</div>;
    }

    return (
        <div style={{ color: themeContext?.colors.text }}>
            <h2 style={{ color: themeContext?.colors.text }}>Audit Trail</h2>
            <p style={{ color: themeContext?.colors.subtext }}>Review all system activities and changes for compliance and security monitoring.</p>

            <div style={{ ...styles.card(theme), marginBottom: '20px' }}>
                <h3 style={{ marginTop: 0, color: themeContext?.colors.text }}>Filter Audit Logs</h3>
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: '15px' }}>
                    <Input
                        label="Actor Name"
                        name="actor"
                        value={filters.actor || ''}
                        onChange={(e) => handleFilterChange(e.target.name, e.target.value)}
                        placeholder="e.g., Alice Admin"
                        theme={theme}
                    />
                    <Select
                        label="Action Type"
                        name="action"
                        value={filters.action || ''}
                        onChange={(e) => handleFilterChange(e.target.name, e.target.value)}
                        options={allActions.map(action => ({ value: action, label: capitalize(action.replace(/_/g, ' ')) }))}
                        theme={theme}
                    />
                    <Select
                        label="Entity Type"
                        name="entityType"
                        value={filters.entityType || ''}
                        onChange={(e) => handleFilterChange(e.target.name, e.target.value)}
                        options={allEntityTypes.map(type => ({ value: type, label: capitalize(type) }))}
                        theme={theme}
                    />
                    <Input
                        label="Entity ID"
                        name="entityId"
                        value={filters.entityId || ''}
                        onChange={(e) => handleFilterChange(e.target.name, e.target.value)}
                        placeholder="e.g., acc-cap-1234abcd"
                        theme={theme}
                    />
                </div>
            </div>

            <div style={styles.card(theme)}>
                <table style={styles.table(theme)}>
                    <thead>
                        <tr>
                            <th style={styles.th(theme)}>Timestamp</th>
                            <th style={styles.th(theme)}>Actor</th>
                            <th style={styles.th(theme)}>Action</th>
                            <th style={styles.th(theme)}>Entity Type</th>
                            <th style={styles.th(theme)}>Entity ID</th>
                            <th style={styles.th(theme)}>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        {loading ? (
                            Array.from({ length: 10 }).map((_, i) => (
                                <tr key={i}>
                                    <td style={styles.td(theme)}><SkeletonLoader theme={theme} width="150px" /></td>
                                    <td style={styles.td(theme)}><SkeletonLoader theme={theme} width="100px" /></td>
                                    <td style={styles.td(theme)}><SkeletonLoader theme={theme} width="120px" /></td>
                                    <td style={styles.td(theme)}><SkeletonLoader theme={theme} width="80px" /></td>
                                    <td style={styles.td(theme)}><SkeletonLoader theme={theme} width="180px" /></td>
                                    <td style={styles.td(theme)}><SkeletonLoader theme={theme} width="200px" /></td>
                                </tr>
                            ))
                        ) : auditEvents.length === 0 ? (
                            <tr>
                                <td colSpan={6} style={{ ...styles.td(theme), textAlign: 'center' }}>No audit events found.</td>
                            </tr>
                        ) : (
                            auditEvents.map((event) => (
                                <tr key={event.id}>
                                    <td style={styles.td(theme)}>{formatDateTime(event.timestamp)}</td>
                                    <td style={styles.td(theme)}>{event.actor}</td>
                                    <td style={styles.td(theme)}>{capitalize(event.action.replace(/_/g, ' '))}</td>
                                    <td style={styles.td(theme)}>{event.entityType}</td>
                                    <td style={styles.td(theme)}>{event.entityId}</td>
                                    <td style={styles.td(theme)}>
                                        <details style={{ cursor: 'pointer', color: theme === 'light' ? '#3f51b5' : '#9fa8da' }}>
                                            <summary>View Details</summary>
                                            <pre style={{
                                                backgroundColor: theme === 'light' ? '#f5f5f5' : '#333',
                                                padding: '10px',
                                                borderRadius: '4px',
                                                marginTop: '5px',
                                                fontSize: '0.8em',
                                                overflowX: 'auto',
                                                color: theme === 'light' ? '#333' : '#eee',
                                            }}>
                                                {JSON.stringify(event.details, null, 2)}
                                            </pre>
                                        </details>
                                    </td>
                                </tr>
                            ))
                        )}
                    </tbody>
                </table>
            </div>
        </div>
    );
};


