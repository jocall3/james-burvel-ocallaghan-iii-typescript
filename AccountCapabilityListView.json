// --- 2. GraphQL Query and Fragment Definitions ---
const ACCOUNT_CAPABILITY_LIST_QUERY = gql`
  query AccountCapabilityListView($showDeleted: String, $first: Int, $after: String, $last: Int, $before: String) {
    accountCapabilities(
      showDeleted: $showDeleted
      first: $first
      after: $after
      last: $last
      before: $before
    ) {
      ...AccountCapabilityList
      __typename
    }
  }

  fragment AccountCapabilityList on AccountCapabilityConnection {
    edges {
      node {
        typename: __typename
        id
        prettyPaymentType
        prettyDirection
        identifier
        partyName
        currencies
        currencyTagColors
        anyCurrency
        prettyPaymentSubtypes
        paymentSubtypeTagColors
        connection {
          typename: __typename
          id
          bestName
          path
        }
        address {
          typename: __typename
          id
          full
        }
        discardedAt
        path
        _metadata { # Adding mock metadata for extended functionality
            createdAt
            createdBy
            updatedAt
            updatedBy
            status
            approverId
            approvedAt
            reviewNotes
        }
      }
      __typename
    }
    pageInfo {
      startCursor
      endCursor
      hasNextPage
      hasPreviousPage
      __typename
    }
    __typename
  }
`;

// --- 3. Apollo Client Setup ---
const apolloClient = new ApolloClient({
  uri: API_BASE_URL,
  cache: new InMemoryCache({
    typePolicies: {
      Query: {
        fields: {
          accountCapabilities: {
            keyArgs: ['showDeleted'],
            merge(existing = { edges: [], pageInfo: {} }, incoming) {
              return {
                ...incoming,
                edges: [...existing.edges, ...incoming.edges],
              };
            },
          },
        },
      },
    },
  }),
  headers: {
    authorization: `Bearer ${localStorage.getItem(ACCESS_TOKEN_KEY) || ''}`,
  },
});

// --- 4. Type Definitions ---

// Core GraphQL Types
interface ConnectionDetails {
  typename: string;
  id: string;
  bestName: string;
  path: string;
}

interface AddressDetails {
  typename: string;
  id: string;
  full: string;
}

interface AccountCapabilityMetadata {
  createdAt: string;
  createdBy: string;
  updatedAt: string;
  updatedBy: string;
  status: 'ACTIVE' | 'PENDING_APPROVAL' | 'REJECTED' | 'INACTIVE' | 'ARCHIVED';
  approverId?: string;
  approvedAt?: string;
  reviewNotes?: string;
}

export interface AccountCapabilityNode {
  typename: string;
  id: string;
  prettyPaymentType: string;
  prettyDirection: 'INCOMING' | 'OUTGOING' | 'BOTH';
  identifier: string;
  partyName: string;
  currencies: string[];
  currencyTagColors: string[];
  anyCurrency: boolean;
  prettyPaymentSubtypes: string[];
  paymentSubtypeTagColors: string[];
  connection: ConnectionDetails;
  address: AddressDetails;
  discardedAt?: string; // ISO string for Date
  path: string;
  _metadata: AccountCapabilityMetadata;
}

interface PageInfo {
  startCursor: string;
  endCursor: string;
  hasNextPage: boolean;
  hasPreviousPage: boolean;
  typename: string;
}

interface AccountCapabilityConnection {
  edges: { node: AccountCapabilityNode; typename: string }[];
  pageInfo: PageInfo;
  typename: string;
}

interface AccountCapabilityListViewData {
  accountCapabilities: AccountCapabilityConnection;
}

// UI State & Domain Types
