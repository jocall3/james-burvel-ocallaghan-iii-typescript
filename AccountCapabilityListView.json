      </div>
      <div style={{ display: 'flex', alignItems: 'center', gap: '20px' }}>
        <Button onClick={themeContext?.toggleTheme} type="text" size="small" icon={theme === 'light' ? <MdVisibilityOff size={20} /> : <MdVisibility size={20} />} style={{ color: themeContext?.colors.text }}>
          {theme === 'light' ? 'Dark Mode' : 'Light Mode'}
        </Button>
        <span style={{ color: themeContext?.colors.subtext }}>Hello, {user?.name || 'Guest'}</span>
        <Button onClick={authContext?.logout} type="secondary" size="small">
          Logout
        </Button>
      </div>
    </div>
  );
};

export const Sidebar: React.FC<{ activeTab: string; onSelectTab: (tab: string) => void; isOpen: boolean; onToggleSidebar: () => void }> = ({ activeTab, onSelectTab, isOpen, onToggleSidebar }) => {
  const themeContext = useContext(ThemeContext);
  const theme = themeContext?.theme || 'light';

  const navItems = [
    { id: 'dashboard', label: 'Dashboard', icon: <MdDashboard size={20} /> },
    { id: 'capabilities', label: 'Account Capabilities', icon: <MdAccountBalance size={20} /> },
    { id: 'configuration', label: 'Configuration', icon: <MdSettings size={20} /> },
    { id: 'users', label: 'User Management', icon: <MdPeople size={20} /> },
    { id: 'notifications', label: 'Notifications', icon: <MdNotifications size={20} /> },
    { id: 'audit', label: 'Audit Trail', icon: <MdHistory size={20} /> },
  ];

  if (!isOpen) return null;

  return ReactDOM.createPortal(
    <motion.div
        initial={{ x: '-100%' }}
        animate={{ x: '0%' }}
        exit={{ x: '-100%' }}
        transition={{ duration: 0.2 }}
        style={{
            ...styles.sidebar(theme),
            position: 'fixed',
            height: '100vh',
            top: 0,
            left: 0,
            zIndex: 1001,
        }}
    >
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '0 20px 20px 20px', borderBottom: `1px solid ${theme === 'light' ? '#eee' : '#444'}` }}>
            <h2 style={{ margin: 0, color: themeContext?.colors.primary, fontSize: '1.2em' }}>Navigation</h2>
            <Button onClick={onToggleSidebar} type="text" size="small" style={{ color: themeContext?.colors.text }}><MdClose size={24} /></Button>
        </div>
        <nav>
            {navItems.map(item => (
                <div
                    key={item.id}
                    onClick={() => { onSelectTab(item.id); onToggleSidebar(); }}
                    style={styles.sidebarItem(activeTab === item.id, theme)}
                >
                    {item.icon}
                    <span>{item.label}</span>
                </div>
            ))}
        </nav>
    </motion.div>,
    document.body
  );
};

export const Layout: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
  const [activeTab, setActiveTab] = useState('dashboard');
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);
  const themeContext = useContext(ThemeContext);
  const theme = themeContext?.theme || 'light';

  const handleToggleSidebar = useCallback(() => {
    setIsSidebarOpen(prev => !prev);
  }, []);

  return (
    <div style={{ ...styles.container, backgroundColor: themeContext?.colors.background }}>
      <Header onToggleSidebar={handleToggleSidebar} />
      <div style={{ display: 'flex', flexGrow: 1 }}>
        <AnimatePresence>
            {isSidebarOpen && <Sidebar activeTab={activeTab} onSelectTab={setActiveTab} isOpen={isSidebarOpen} onToggleSidebar={handleToggleSidebar} />}
        </AnimatePresence>
        <div style={{
            ...styles.mainContent,
            marginLeft: isSidebarOpen ? '240px' : '0', // Simulate shifting content, or overlay
            transition: 'margin-left 0.2s ease',
            backgroundColor: themeContext?.colors.background,
            color: themeContext?.colors.text,
        }}>
          {activeTab === 'dashboard' && <DashboardPage />}
          {activeTab === 'capabilities' && <AccountCapabilityPage />}
          {activeTab === 'configuration' && <ConfigurationPage />}
          {activeTab === 'users' && <UserManagementPage />}
          {activeTab === 'notifications' && <NotificationPage />}
          {activeTab === 'audit' && <AuditTrailPage />}
        </div>
      </div>
    </div>
  );
};

