if (rootElement) {
  const root = ReactDOM.createRoot(rootElement);
  root.render(
    <React.StrictMode>
      <App />
    </React.StrictMode>
  );
} else {
  console.error('Root element #root not found. Please ensure it exists in your index.html.');
  // Dynamically create a root element for demonstration purposes if running standalone
  const div = document.createElement('div');
  div.id = 'root';
  document.body.appendChild(div);
  const root = ReactDOM.createRoot(div);
  root.render(
    <React.StrictMode>
      <App />
    </React.StrictMode>
  );
}

