}

export interface Notification {
  id: string;
  type: 'success' | 'error' | 'warning' | 'info';
  message: string;
  timestamp: string;
  read: boolean;
  action?: {
    label: string;
    callback: () => void;
  };
}

export interface AuditEvent {
  id: string;
  timestamp: string;
  actor: string;
  action: string; // e.g., 'CREATE_CAPABILITY', 'UPDATE_CAPABILITY', 'APPROVE_CAPABILITY'
  entityId: string; // ID of the capability or other entity
  entityType: string;
  details: Record<string, any>;
}

export interface DashboardWidgetData {
  title: string;
  value: string | number;
  description: string;
  icon: React.ReactNode;
  trend?: 'up' | 'down' | 'stable';
  trendValue?: string;
}

export type CapabilityFilterCriteria = {
  searchQuery?: string;
  paymentType?: string;
  direction?: 'INCOMING' | 'OUTGOING' | 'BOTH';
  currency?: string;
  status?: AccountCapabilityMetadata['status'][];
  showDeleted?: boolean;
  partyName?: string;
};

export type CapabilitySortCriteria = {
  field: keyof AccountCapabilityNode | keyof AccountCapabilityMetadata | 'status';
  direction: 'ASC' | 'DESC';
};

export interface CapabilityFormValues extends Omit<AccountCapabilityNode, 'id' | '_metadata' | 'connection' | 'address' | 'path' | 'typename'> {
    // Omitting read-only or derived fields
    newConnectionName?: string; // For creating a new connection
    newAddressFull?: string; // For creating a new address
    statusOverride?: AccountCapabilityMetadata['status']; // For status change actions
}


