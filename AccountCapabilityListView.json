const mockGraphQLService = {
  queryAccountCapabilities: async (
    variables: {
      showDeleted?: string;
      first?: number;
      after?: string;
      last?: number;
      before?: string;
    },
    filters: CapabilityFilterCriteria,
    sort: CapabilitySortCriteria,
  ): Promise<AccountCapabilityListViewData> => {
    return new Promise((resolve) => {
      setTimeout(() => {
        let filteredCapabilities = MOCK_ACCOUNT_CAPABILITIES.filter((cap) => {
          const matchSearch = filters.searchQuery
            ? (cap.prettyPaymentType.toLowerCase().includes(filters.searchQuery.toLowerCase()) ||
              cap.identifier.toLowerCase().includes(filters.searchQuery.toLowerCase()) ||
              cap.partyName.toLowerCase().includes(filters.searchQuery.toLowerCase()) ||
              cap.currencies.some(c => c.toLowerCase().includes(filters.searchQuery.toLowerCase())) ||
              cap.prettyPaymentSubtypes.some(s => s.toLowerCase().includes(filters.searchQuery.toLowerCase())))
            : true;
          const matchPaymentType = filters.paymentType ? cap.prettyPaymentType === filters.paymentType : true;
          const matchDirection = filters.direction ? cap.prettyDirection === filters.direction : true;
          const matchCurrency = filters.currency ? cap.currencies.includes(filters.currency) : true;
          const matchStatus = filters.status?.length ? filters.status.includes(cap._metadata.status) : true;
          const matchPartyName = filters.partyName ? cap.partyName.toLowerCase().includes(filters.partyName.toLowerCase()) : true;
          const matchDeleted = filters.showDeleted === true || variables.showDeleted === 'true' ? true : !cap.discardedAt;

          return matchSearch && matchPaymentType && matchDirection && matchCurrency && matchStatus && matchPartyName && matchDeleted;
        });

        // Apply sorting
        filteredCapabilities.sort((a, b) => {
          const valA = sort.field === 'status' ? a._metadata.status : a[sort.field as keyof AccountCapabilityNode] || a._metadata[sort.field as keyof AccountCapabilityMetadata];
          const valB = sort.field === 'status' ? b._metadata.status : b[sort.field as keyof AccountCapabilityNode] || b._metadata[sort.field as keyof AccountCapabilityMetadata];

          if (typeof valA === 'string' && typeof valB === 'string') {
            return sort.direction === 'ASC' ? valA.localeCompare(valB) : valB.localeCompare(valA);
          }
          if (typeof valA === 'number' && typeof valB === 'number') {
            return sort.direction === 'ASC' ? valA - valB : valB - valA;
          }
          // Fallback for other types or null/undefined
          if (valA === undefined && valB !== undefined) return sort.direction === 'ASC' ? 1 : -1;
          if (valA !== undefined && valB === undefined) return sort.direction === 'ASC' ? -1 : 1;
          return 0;
        });


        // Apply pagination logic
        const allEdges = filteredCapabilities.map((node) => ({ node, typename: 'AccountCapabilityEdge' }));
        const totalItems = allEdges.length;

        let startIdx = 0;
        let endIdx = totalItems;

        if (variables.after) {
          const cursorIndex = allEdges.findIndex(edge => edge.node.id === variables.after);
          if (cursorIndex !== -1) {
            startIdx = cursorIndex + 1;
          }
        } else if (variables.before) {
          const cursorIndex = allEdges.findIndex(edge => edge.node.id === variables.before);
          if (cursorIndex !== -1) {
            endIdx = cursorIndex;
          }
        }

        let paginatedEdges = allEdges.slice(startIdx, endIdx);

        if (variables.first) {
          paginatedEdges = paginatedEdges.slice(0, variables.first);
        } else if (variables.last) {
          paginatedEdges = paginatedEdges.slice(-variables.last);
        }

        const hasNextPage = (startIdx + paginatedEdges.length) < totalItems;
        const hasPreviousPage = startIdx > 0;

        const startCursor = paginatedEdges.length > 0 ? paginatedEdges[0].node.id : null;
        const endCursor = paginatedEdges.length > 0 ? paginatedEdges[paginatedEdges.length - 1].node.id : null;

        resolve({
          accountCapabilities: {
            edges: paginatedEdges,
            pageInfo: {
              startCursor: startCursor || '',
              endCursor: endCursor || '',
              hasNextPage: hasNextPage,
              hasPreviousPage: hasPreviousPage,
              typename: 'PageInfo',
            },
            typename: 'AccountCapabilityConnection',
          },
        });
      }, 500); // Simulate network delay
    });
  },

  // Mock mutation for updating a capability
  updateAccountCapability: async (id: string, updates: Partial<CapabilityFormValues>, currentUser: User): Promise<AccountCapabilityNode> => {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        const capabilityIndex = MOCK_ACCOUNT_CAPABILITIES.findIndex(cap => cap.id === id);
        if (capabilityIndex === -1) {
          return reject(new Error('Capability not found.'));
        }

        const original = MOCK_ACCOUNT_CAPABILITIES[capabilityIndex];
        const updatedCap: AccountCapabilityNode = {
          ...original,
          ...updates,
          _metadata: {
            ...original._metadata,
            updatedAt: moment().toISOString(),
            updatedBy: currentUser.name,
            status: updates.statusOverride || original._metadata.status,
            approverId: updates.statusOverride === 'ACTIVE' ? currentUser.id : original._metadata.approverId,
            approvedAt: updates.statusOverride === 'ACTIVE' ? moment().toISOString() : original._metadata.approvedAt,
          },
        };
        MOCK_ACCOUNT_CAPABILITIES[capabilityIndex] = updatedCap;
        mockAuditService.logEvent({
          id: uuidv4(),
          timestamp: moment().toISOString(),
          actor: currentUser.name,
          action: 'UPDATE_CAPABILITY',
          entityId: id,
          entityType: 'AccountCapability',
          details: { old: original, new: updatedCap },
        });
        resolve(updatedCap);
      }, 300);
    });
  },

  createAccountCapability: async (newCap: CapabilityFormValues, currentUser: User): Promise<AccountCapabilityNode> => {
    return new Promise((resolve) => {
      setTimeout(() => {
        const id = `acc-cap-${uuidv4().substring(0, 8)}`;
        const now = moment().toISOString();
        const newConnectionId = newCap.newConnectionName ? `conn-${uuidv4().substring(0, 8)}` : `conn-${uuidv4().substring(0, 8)}`; // Mock new vs existing
        const newAddressId = newCap.newAddressFull ? `addr-${uuidv4().substring(0, 8)}` : `addr-${uuidv4().substring(0, 8)}`;

        const createdCap: AccountCapabilityNode = {
          typename: 'AccountCapability',
          id: id,
          prettyPaymentType: newCap.prettyPaymentType || 'Transfer',
          prettyDirection: newCap.prettyDirection || 'BOTH',
          identifier: newCap.identifier || `NEW-${Math.floor(1000 + Math.random() * 9000)}`,
          partyName: newCap.partyName || 'New Party',
          currencies: newCap.currencies || ['USD'],
          currencyTagColors: ['#FFC107'],
          anyCurrency: newCap.anyCurrency || false,
          prettyPaymentSubtypes: newCap.prettyPaymentSubtypes || ['Domestic'],
          paymentSubtypeTagColors: ['#607D8B'],
          connection: {
            typename: 'ConnectionDetails',
            id: newConnectionId,
            bestName: newCap.newConnectionName || `Default Connection ${newConnectionId.substring(5)}`,
            path: `/connections/${newConnectionId.substring(5)}`,
          },
          address: {
            typename: 'AddressDetails',
            id: newAddressId,
            full: newCap.newAddressFull || `Default Address ${newAddressId.substring(5)}`,
          },
          discardedAt: undefined,
          path: `/capabilities/${id.substring(8)}`,
          _metadata: {
            createdAt: now,
            createdBy: currentUser.name,
            updatedAt: now,
            updatedBy: currentUser.name,
            status: newCap.statusOverride || 'PENDING_APPROVAL',
          },
        };
        MOCK_ACCOUNT_CAPABILITIES.unshift(createdCap); // Add to beginning
        mockAuditService.logEvent({
          id: uuidv4(),
          timestamp: now,
          actor: currentUser.name,
          action: 'CREATE_CAPABILITY',
          entityId: createdCap.id,
          entityType: 'AccountCapability',
          details: { new: createdCap },
        });
        resolve(createdCap);
      }, 300);
    });
  },

  deleteAccountCapability: async (id: string, currentUser: User): Promise<boolean> => {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        const capabilityIndex = MOCK_ACCOUNT_CAPABILITIES.findIndex(cap => cap.id === id);
        if (capabilityIndex === -1) {
          return reject(new Error('Capability not found.'));
        }
        const original = MOCK_ACCOUNT_CAPABILITIES[capabilityIndex];
        MOCK_ACCOUNT_CAPABILITIES[capabilityIndex] = {
          ...original,
          discardedAt: moment().toISOString(),
          _metadata: {
            ...original._metadata,
            updatedAt: moment().toISOString(),
            updatedBy: currentUser.name,
            status: 'ARCHIVED',
          },
        };
        mockAuditService.logEvent({
          id: uuidv4(),
          timestamp: moment().toISOString(),
          actor: currentUser.name,
          action: 'DELETE_CAPABILITY',
          entityId: id,
          entityType: 'AccountCapability',
          details: { capabilityId: id, reason: 'Soft delete' },
        });
        resolve(true);
      }, 300);
    });
  },

  restoreAccountCapability: async (id: string, currentUser: User): Promise<boolean> => {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        const capabilityIndex = MOCK_ACCOUNT_CAPABILITIES.findIndex(cap => cap.id === id);
        if (capabilityIndex === -1) {
          return reject(new Error('Capability not found.'));
        }
        const original = MOCK_ACCOUNT_CAPABILITIES[capabilityIndex];
        MOCK_ACCOUNT_CAPABILITIES[capabilityIndex] = {
          ...original,
          discardedAt: undefined,
          _metadata: {
            ...original._metadata,
            updatedAt: moment().toISOString(),
            updatedBy: currentUser.name,
            status: 'PENDING_APPROVAL', // Restore to pending approval state
          },
        };
        mockAuditService.logEvent({
          id: uuidv4(),
          timestamp: moment().toISOString(),
          actor: currentUser.name,
          action: 'RESTORE_CAPABILITY',
          entityId: id,
          entityType: 'AccountCapability',
          details: { capabilityId: id, reason: 'Restored from archive' },
        });
        resolve(true);
      }, 300);
    });
  },
};

const mockAuditService = {
  events: [] as AuditEvent[],
  logEvent(event: AuditEvent) {
    this.events.unshift(event); // Add to beginning
  },
  getEvents: async (entityId?: string, entityType?: string): Promise<AuditEvent[]> => {
    return new Promise(resolve => {
      setTimeout(() => {
        let result = mockAuditService.events;
        if (entityId) {
          result = result.filter(e => e.entityId === entityId);
        }
        if (entityType) {
          result = result.filter(e => e.entityType === entityType);
        }
        resolve([...result]); // Return a copy
      }, 200);
    });
  },
};


