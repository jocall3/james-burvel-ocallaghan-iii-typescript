// --- 7. Utility Functions ---

export const formatDateTime = (isoString?: string | null, format = 'YYYY-MM-DD HH:mm:ss'): string => {
  if (!isoString) return 'N/A';
  return moment(isoString).format(format);
};

export const capitalize = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();

export const getStatusColor = (status: AccountCapabilityMetadata['status']): string => {
  switch (status) {
    case 'ACTIVE':
      return '#4CAF50'; // Green
    case 'PENDING_APPROVAL':
      return '#FFC107'; // Amber
    case 'REJECTED':
      return '#F44336'; // Red
    case 'INACTIVE':
      return '#9E9E9E'; // Gray
    case 'ARCHIVED':
      return '#607D8B'; // Blue-Gray
    default:
      return '#2196F3'; // Blue
  }
};

export const generateId = (): string => uuidv4();

export const validateCapabilityForm = (values: CapabilityFormValues): Record<string, string> => {
    const errors: Record<string, string> = {};
    if (!values.prettyPaymentType) errors.prettyPaymentType = 'Payment Type is required.';
    if (!values.identifier) errors.identifier = 'Identifier is required.';
    if (!values.partyName) errors.partyName = 'Party Name is required.';
    if (!values.currencies || values.currencies.length === 0) errors.currencies = 'At least one currency is required.';
    if (values.newConnectionName && values.newConnectionName.length < 3) errors.newConnectionName = 'Connection name must be at least 3 characters.';
    if (values.newAddressFull && values.newAddressFull.length < 5) errors.newAddressFull = 'Address must be at least 5 characters.';
    return errors;
};

