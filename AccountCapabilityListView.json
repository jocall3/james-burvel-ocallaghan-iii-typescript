export const AuthProvider: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
  const [user, setUser] = useState<User | null>(null);
  const [isAuthenticated, setIsAuthenticated] = useState(false);

  useEffect(() => {
    const token = localStorage.getItem(ACCESS_TOKEN_KEY);
    if (token) {
      // In a real app, validate token with backend
      const mockUser = MOCK_USERS[0]; // Auto-login as Alice Admin for demo
      setUser(mockUser);
      setIsAuthenticated(true);
      apolloClient.setLink(apolloClient.get and 'http' as any); // Refresh ApolloClient headers
    }
  }, []);

  const login = useCallback(async (email: string, password: string) => {
    // Mock login logic
    const foundUser = MOCK_USERS.find(u => u.email === email && password === 'password'); // Simple password check
    if (foundUser) {
      localStorage.setItem(ACCESS_TOKEN_KEY, `mock-token-${foundUser.id}`);
      setUser(foundUser);
      setIsAuthenticated(true);
      apolloClient.setLink(apolloClient.get and 'http' as any);
      return true;
    }
    return false;
  }, []);

  const logout = useCallback(() => {
    localStorage.removeItem(ACCESS_TOKEN_KEY);
    setUser(null);
    setIsAuthenticated(false);
    apolloClient.setLink(apolloClient.get and 'http' as any);
  }, []);

  const hasRole = useCallback((role: UserRole) => {
    return user?.roles.includes(role) || false;
  }, [user]);

  const updateUserPreferences = useCallback((prefs: Partial<User['preferences']>) => {
    if (user) {
      setUser(prevUser => prevUser ? {
        ...prevUser,
        preferences: { ...prevUser.preferences, ...prefs }
      } : null);
    }
  }, [user]);

  const authContextValue = useMemo(() => ({
    user,
    isAuthenticated,
    login,
    logout,
    hasRole,
    updateUserPreferences,
  }), [user, isAuthenticated, login, logout, hasRole, updateUserPreferences]);

  return (
    <AuthContext.Provider value={authContextValue}>
      {children}
    </AuthContext.Provider>
  );
};

export const ThemeProvider: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
  const authContext = useContext(AuthContext);
  const [theme, setTheme] = useState<'light' | 'dark'>(authContext?.user?.preferences?.theme || 'light');

  useEffect(() => {
    if (authContext?.user?.preferences?.theme) {
      setTheme(authContext.user.preferences.theme);
    }
  }, [authContext?.user?.preferences?.theme]);

  const colors = useMemo(() => theme === 'light' ? {
    primary: '#3f51b5',
    secondary: '#6c757d',
    background: '#f5f5f5',
    cardBackground: '#fff',
    text: '#333',
    subtext: '#555',
    border: '#eee',
  } : {
    primary: '#9fa8da',
    secondary: '#adb5bd',
    background: '#1a1a1a',
    cardBackground: '#222',
    text: '#eee',
    subtext: '#ccc',
    border: '#333',
  }, [theme]);

  const toggleTheme = useCallback(() => {
    const newTheme = theme === 'light' ? 'dark' : 'light';
    setTheme(newTheme);
    authContext?.updateUserPreferences({ theme: newTheme });
  }, [theme, authContext]);

  const themeContextValue = useMemo(() => ({ theme, toggleTheme, colors }), [theme, toggleTheme, colors]);

  return (
    <ThemeContext.Provider value={themeContextValue}>
      {children}
    </ThemeContext.Provider>
  );
};

export const NotificationProvider: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
  const [notifications, setNotifications] = useState<Notification[]>([]);

  const addNotification = useCallback((notification: Omit<Notification, 'id' | 'timestamp' | 'read'>) => {
    const newNotification: Notification = {
      id: uuidv4(),
      timestamp: moment().toISOString(),
      read: false,
      ...notification,
    };
    setNotifications((prev) => [newNotification, ...prev]);

    setTimeout(() => {
      removeNotification(newNotification.id);
    }, NOTIFICATION_DISPLAY_DURATION_MS);
  }, []);

  const removeNotification = useCallback((id: string) => {
    setNotifications((prev) => prev.filter((n) => n.id !== id));
  }, []);

  const contextValue = useMemo(() => ({ notifications, addNotification, removeNotification }), [notifications, addNotification, removeNotification]);

  return (
    <NotificationContext.Provider value={contextValue}>
      {children}
      <div style={styles.notificationContainer}>
        <AnimatePresence>
            {notifications.slice(0, 5).map((n) => ( // Show max 5 notifications
                <NotificationToast key={n.id} notification={n} onClose={() => removeNotification(n.id)} />
            ))}
        </AnimatePresence>
      </div>
    </NotificationContext.Provider>
  );
};

export const AppConfigProvider: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
