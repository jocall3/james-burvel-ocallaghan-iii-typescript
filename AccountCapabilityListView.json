export const Authenticator: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
  const authContext = useContext(AuthContext);
  const themeContext = useContext(ThemeContext);
  const notificationContext = useContext(NotificationContext);
  const theme = themeContext?.theme || 'light';

  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setError('');
    setLoading(true);
    if (authContext) {
      const success = await authContext.login(email, password);
      if (!success) {
        setError('Invalid credentials. Try alice.admin@citibank.com/password.');
        notificationContext?.addNotification({
            type: 'error',
            message: 'Login failed. Please check your credentials.',
        });
      } else {
        notificationContext?.addNotification({
            type: 'success',
            message: `Welcome back, ${authContext.user?.name}!`,
        });
      }
    }
    setLoading(false);
  };

  if (!authContext || !authContext.isAuthenticated) {
    return (
      <div style={{ ...styles.container, justifyContent: 'center', alignItems: 'center', backgroundColor: themeContext?.colors.background }}>
        <div style={{ ...styles.card(theme), width: '400px', padding: '40px', textAlign: 'center' }}>
          <h1 style={{ color: themeContext?.colors.primary, marginBottom: '20px' }}>{APP_NAME}</h1>
          <h2 style={{ color: themeContext?.colors.text, marginBottom: '30px', fontSize: '1.5em' }}>Login</h2>
          <form onSubmit={handleLogin}>
            <Input
              label="Email"
              name="email"
              type="email"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              placeholder="Enter your email"
              theme={theme}
            />
            <Input
              label="Password"
              name="password"
              type="password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              placeholder="Enter your password"
              theme={theme}
              style={{ marginBottom: '20px' }}
            />
            {error && <div style={{ ...styles.errorMessage, marginBottom: '15px' }}>{error}</div>}
            <Button type="primary" size="large" onClick={handleLogin} disabled={loading} style={{ width: '100%' }}>
              {loading ? 'Logging in...' : 'Login'}
            </Button>
            <p style={{ marginTop: '20px', fontSize: '0.9em', color: themeContext?.colors.subtext }}>
                Hint: Try <code style={{ backgroundColor: theme === 'light' ? '#f0f0f0' : '#444', padding: '2px 4px', borderRadius: '3px' }}>alice.admin@citibank.com</code> with password <code style={{ backgroundColor: theme === 'light' ? '#f0f0f0' : '#444', padding: '2px 4px', borderRadius: '3px' }}>password</code>
            </p>
          </form>
        </div>
      </div>
    );
  }

  return <>{children}</>;
};

