  useEffect(() => {
    if (isAuthenticated) {
      onLoginSuccess(); // Redirect if already authenticated
    }
  }, [isAuthenticated, onLoginSuccess]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    const success = await login(username, 'mocked_hash'); // Use a mock hash for this demo
    if (success) {
      addNotification({ type: 'success', message: `Welcome, ${username}!` });
