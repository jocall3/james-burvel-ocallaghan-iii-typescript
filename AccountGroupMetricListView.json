// Tooltip (conceptual)
interface TooltipProps {
  children: React.ReactNode;
  content: React.ReactNode;
  position?: 'top' | 'bottom' | 'left' | 'right';
}

export const Tooltip: React.FC<TooltipProps> = ({ children, content, position = 'top' }) => {
  const [show, setShow] = useState(false);
  const { theme } = useTheme();

  const containerStyle: React.CSSProperties = {
    position: 'relative',
    display: 'inline-block',
  };

  const tooltipStyle: React.CSSProperties = {
    position: 'absolute',
    padding: '0.5rem',
    borderRadius: '0.25rem',
    backgroundColor: theme.text, // Invert colors for tooltip
    color: theme.background,
    fontSize: '0.8rem',
    zIndex: 1001,
    whiteSpace: 'nowrap',
    pointerEvents: 'none',
    opacity: show ? 1 : 0,
    transition: 'opacity 0.2s',
  };

  let positionStyles: React.CSSProperties = {};
  switch (position) {
    case 'top':
      positionStyles = { bottom: '120%', left: '50%', transform: 'translateX(-50%)' };
      break;
    case 'bottom':
      positionStyles = { top: '120%', left: '50%', transform: 'translateX(-50%)' };
      break;
    case 'left':
      positionStyles = { top: '50%', right: '120%', transform: 'translateY(-50%)' };
      break;
    case 'right':
      positionStyles = { top: '50%', left: '120%', transform: 'translateY(-50%)' };
      break;
  }

  return (
    <div
      style={containerStyle}
      onMouseEnter={() => setShow(true)}
      onMouseLeave={() => setShow(false)}
    >
      {children}
      {show && (
        <div style={{ ...tooltipStyle, ...positionStyles }}>
          {content}
        </div>
      )}
    </div>
  );
};

