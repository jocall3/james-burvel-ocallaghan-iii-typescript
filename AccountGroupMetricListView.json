    notification.read = true;
    return { ...notification };
  }

  // --- Account Group Metrics ---
  async fetchAccountGroupMetrics(options: MockApiOptions = {}): Promise<AccountGroupMetricConnection> {
    await new Promise(resolve => setTimeout(resolve, 750)); // Simulate network latency

    let filteredMetrics = [...this.metrics];

    // Apply name filter
    if (options.name) {
      const lowerCaseName = options.name.toLowerCase();
      filteredMetrics = filteredMetrics.filter(m => m.bestName.toLowerCase().includes(lowerCaseName));
    }

    // Apply currency filter
    if (options.currency) {
      filteredMetrics = filteredMetrics.filter(m => m.currency === options.currency);
    }

    // Apply advanced filters
    if (options.filters) {
      const {
        status, minBalance, maxBalance, minVariance, maxVariance,
        tags, riskScoreRange, dateRange
      } = options.filters;

      if (status && status.length > 0) {
        filteredMetrics = filteredMetrics.filter(m => status.includes(m.status));
      }
      if (minBalance !== undefined) {
        filteredMetrics = filteredMetrics.filter(m => m.availableBalance >= minBalance);
      }
      if (maxBalance !== undefined) {
        filteredMetrics = filteredMetrics.filter(m => m.availableBalance <= maxBalance);
      }
      if (minVariance !== undefined) {
        filteredMetrics = filteredMetrics.filter(m => m.ledgerVariance >= minVariance);
      }
      if (maxVariance !== undefined) {
        filteredMetrics = filteredMetrics.filter(m => m.ledgerVariance <= maxVariance);
      }
      if (tags && tags.length > 0) {
        filteredMetrics = filteredMetrics.filter(m => tags.some(tag => m.tags.includes(tag)));
      }
      if (riskScoreRange && riskScoreRange.length === 2) {
        filteredMetrics = filteredMetrics.filter(m => m.riskScore >= riskScoreRange[0] && m.riskScore <= riskScoreRange[1]);
      }
      if (dateRange && dateRange.length === 2) {
        const [startDate, endDate] = dateRange.map(d => new Date(d));
        filteredMetrics = filteredMetrics.filter(m => {
          const lastUpdatedDate = new Date(m.lastUpdated);
          return lastUpdatedDate >= startDate && lastUpdatedDate <= endDate;
        });
      }
    }

    // Apply sorting
    if (options.sort) {
      const { field, direction } = options.sort;
      filteredMetrics.sort((a, b) => {
        const valA = a[field as keyof AccountGroupMetric];
        const valB = b[field as keyof AccountGroupMetric];

        if (typeof valA === 'string' && typeof valB === 'string') {
          return direction === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
        }
        if (typeof valA === 'number' && typeof valB === 'number') {
          return direction === 'asc' ? valA - valB : valB - valA;
        }
        if (field === 'lastUpdated') {
          const dateA = new Date(a.lastUpdated).getTime();
          const dateB = new Date(b.lastUpdated).getTime();
          return direction === 'asc' ? dateA - dateB : dateB - dateA;
        }
        return 0;
      });
    }

    // Simulate cursor-based pagination
    const pageSize = options.first || options.last || DEFAULT_PAGE_SIZE;
    let startIndex = 0;
    let endIndex = filteredMetrics.length;

    if (options.after) {
      const afterIndex = filteredMetrics.findIndex(m => m.id === options.after);
      if (afterIndex !== -1) startIndex = afterIndex + 1;
    } else if (options.before) {
      const beforeIndex = filteredMetrics.findIndex(m => m.id === options.before);
      if (beforeIndex !== -1) endIndex = beforeIndex;
    }

    let pagedMetrics = filteredMetrics.slice(startIndex, endIndex);

    if (options.first) {
      pagedMetrics = pagedMetrics.slice(0, options.first);
    } else if (options.last) {
      pagedMetrics = pagedMetrics.slice(-options.last);
    }

    const startCursor = pagedMetrics.length > 0 ? pagedMetrics[0].id : null;
    const endCursor = pagedMetrics.length > 0 ? pagedMetrics[pagedMetrics.length - 1].id : null;

    const hasNextPage = endCursor ? filteredMetrics.indexOf(pagedMetrics[pagedMetrics.length - 1]) < filteredMetrics.length - 1 : false;
    const hasPreviousPage = startCursor ? filteredMetrics.indexOf(pagedMetrics[0]) > 0 : false;

    return {
      edges: pagedMetrics.map(node => ({ node, __typename: 'AccountGroupMetricEdge' })),
      pageInfo: {
        startCursor,
        endCursor,
        hasNextPage,
        hasPreviousPage,
        __typename: 'PageInfo',
      },
      totalCount: filteredMetrics.length,
      __typename: 'AccountGroupMetricConnection',
    };
  }

  async fetchAccountGroupMetricById(id: string): Promise<AccountGroupMetric | null> {
    await new Promise(resolve => setTimeout(resolve, 300));
    return this.metrics.find(m => m.id === id) || null;
  }

  async updateAccountGroupMetric(id: string, updates: Partial<AccountGroupMetric>): Promise<AccountGroupMetric> {
    await new Promise(resolve => setTimeout(resolve, 400));
    const index = this.metrics.findIndex(m => m.id === id);
    if (index === -1) throw new Error('Account Group Metric not found');

    const updatedMetric = {
      ...this.metrics[index],
      ...updates,
      lastUpdated: new Date().toISOString(),
      // Recalculate pretty values and highlights if raw values change
      ...(updates.priorDayBalance !== undefined && { prettyPriorDayBalance: formatCurrency(updates.priorDayBalance, updates.currency || this.metrics[index].currency) }),
      ...(updates.availableBalance !== undefined && { prettyAvailableBalance: formatCurrency(updates.availableBalance, updates.currency || this.metrics[index].currency) }),
      ...(updates.budgetedBalance !== undefined && { prettyBudgetedBalance: formatCurrency(updates.budgetedBalance, updates.currency || this.metrics[index].currency) }),
      ...(updates.ledgerVariance !== undefined && { highlightLedgerVariance: Math.abs(updates.ledgerVariance) >= LEDGER_VARIANCE_WARNING_THRESHOLD }),
      ...(updates.budgetVariance !== undefined && { highlightBudgetVariance: Math.abs(updates.budgetVariance) >= LEDGER_VARIANCE_WARNING_THRESHOLD }),
    };
    this.metrics[index] = updatedMetric;
    return { ...updatedMetric };
  }

  async addCommentToMetric(metricId: string, userId: string, username: string, text: string): Promise<Comment> {
    await new Promise(resolve => setTimeout(resolve, 200));
    const metric = this.metrics.find(m => m.id === metricId);
    if (!metric) throw new Error('Metric not found');
    const newComment: Comment = {
      id: generateUUID(),
      userId,
      username,
      timestamp: new Date().toISOString(),
      text,
      resolved: false,
    };
    metric.comments.push(newComment);
    metric.auditHistory.push({
      id: generateUUID(), timestamp: new Date().toISOString(), userId, action: 'ADD_COMMENT', details: { commentId: newComment.id, text: newComment.text }
    });
    return newComment;
  }

  async resolveComment(metricId: string, commentId: string, userId: string): Promise<Comment> {
    await new Promise(resolve => setTimeout(resolve, 200));
    const metric = this.metrics.find(m => m.id === metricId);
    if (!metric) throw new Error('Metric not found');
    const comment = metric.comments.find(c => c.id === commentId);
    if (!comment) throw new Error('Comment not found');
    comment.resolved = true;
    metric.auditHistory.push({
      id: generateUUID(), timestamp: new Date().toISOString(), userId, action: 'RESOLVE_COMMENT', details: { commentId: comment.id }
    });
    return { ...comment };
  }

  // --- Reconciliation Cases ---
  async fetchReconciliationCases(accountGroupId?: string, status?: ReconciliationCase['status'][], assignedTo?: string): Promise<ReconciliationCase[]> {
    await new Promise(resolve => setTimeout(resolve, 600));
    let filtered = [...this.reconciliations];
    if (accountGroupId) {
      filtered = filtered.filter(rc => rc.accountGroupId === accountGroupId);
    }
    if (status && status.length > 0) {
      filtered = filtered.filter(rc => status.includes(rc.status));
    }
    if (assignedTo) {
      filtered = filtered.filter(rc => rc.assignedTo === assignedTo);
    }
    return filtered.sort((a, b) => new Date(b.lastUpdated).getTime() - new Date(a.lastUpdated).getTime());
  }

  async fetchReconciliationCaseById(id: string): Promise<ReconciliationCase | null> {
    await new Promise(resolve => setTimeout(resolve, 300));
    return this.reconciliations.find(rc => rc.id === id) || null;
  }

  async createReconciliationCase(accountGroupId: string, openedByUserId: string, initialDiscrepancy: number): Promise<ReconciliationCase> {
    await new Promise(resolve => setTimeout(resolve, 500));
    const newCase: ReconciliationCase = {
      id: `RECON-${generateUUID().substring(0, 8).toUpperCase()}`,
      accountGroupId,
      status: 'OPEN',
      openedBy: openedByUserId,
      assignedTo: null,
      openedDate: new Date().toISOString(),
      lastUpdated: new Date().toISOString(),
      initialDiscrepancy,
      currentDiscrepancy: initialDiscrepancy,
      transactions: [],
      comments: [],
      approvalHistory: [],
      documents: [],
    };
    this.reconciliations.push(newCase);
    const metric = this.metrics.find(m => m.id === accountGroupId);
    if (metric) {
      metric.reconciliationId = newCase.id;
      metric.status = AccountGroupMetricStatus.RECONCILIATION_NEEDED; // Update metric status
    }
    return { ...newCase };
  }

  async updateReconciliationCase(caseId: string, updates: Partial<ReconciliationCase>, userId: string): Promise<ReconciliationCase> {
    await new Promise(resolve => setTimeout(resolve, 400));
    const index = this.reconciliations.findIndex(rc => rc.id === caseId);
    if (index === -1) throw new Error('Reconciliation case not found');

    const originalCase = this.reconciliations[index];
    const updatedCase = {
      ...originalCase,
      ...updates,
      lastUpdated: new Date().toISOString(),
    };

    if (updates.status && updates.status !== originalCase.status) {
      updatedCase.approvalHistory.push({
        userId,
        timestamp: new Date().toISOString(),
        action: `STATUS_CHANGE_TO_${updates.status}`,
        comment: `Status changed from ${originalCase.status} to ${updates.status}`,
      });
    }

    this.reconciliations[index] = updatedCase;

    // Update associated metric status if reconciliation case status changes to CLOSED
    if (updates.status === 'CLOSED') {
      const metric = this.metrics.find(m => m.id === originalCase.accountGroupId);
      if (metric && metric.reconciliationId === caseId) {
        metric.status = AccountGroupMetricStatus.ACTIVE; // Or some other appropriate status
        metric.reconciliationId = null;
      }
    }
    return { ...updatedCase };
  }

  async addTransactionToReconciliation(caseId: string, transaction: ReconciliationTransaction, userId: string): Promise<ReconciliationCase> {
    await new Promise(resolve => setTimeout(resolve, 200));
    const recCase = this.reconciliations.find(rc => rc.id === caseId);
    if (!recCase) throw new Error('Reconciliation case not found');
    recCase.transactions.push({ ...transaction, id: generateUUID() });
    recCase.currentDiscrepancy += transaction.amount; // Adjust discrepancy
    recCase.lastUpdated = new Date().toISOString();
    recCase.comments.push({
      id: generateUUID(),
      userId,
      username: this.currentUser.username,
      timestamp: new Date().toISOString(),
      text: `Added transaction ${transaction.description} with amount ${transaction.amount}.`,
      resolved: false,
    });
    return { ...recCase };
  }

  async addApprovalToReconciliation(caseId: string, userId: string, action: 'APPROVE' | 'REJECT', comment?: string): Promise<ReconciliationCase> {
    await new Promise(resolve => setTimeout(resolve, 300));
    const recCase = this.reconciliations.find(rc => rc.id === caseId);
    if (!recCase) throw new Error('Reconciliation case not found');

    recCase.approvalHistory.push({ userId, timestamp: new Date().toISOString(), action, comment });
    if (action === 'APPROVE') {
      recCase.status = 'CLOSED'; // Simplified: approval closes the case
    } else {
      recCase.status = 'IN_PROGRESS'; // Simplified: rejection reverts to in progress
    }
    recCase.lastUpdated = new Date().toISOString();
    return { ...recCase };
  }

  // --- Audit Logs (Application-wide) ---
  async fetchAppAuditLogs(startDate?: string, endDate?: string, userId?: string, actionType?: string, limit: number = 50): Promise<AuditLogEntry[]> {
    await new Promise(resolve => setTimeout(resolve, 500));
    let allLogs: AuditLogEntry[] = [];
    this.metrics.forEach(m => allLogs = allLogs.concat(m.auditHistory));
    this.reconciliations.forEach(rc => {
      // Simulate audit logs for reconciliation actions
      rc.approvalHistory.forEach(a => allLogs.push({
        id: generateUUID(),
        timestamp: a.timestamp,
        userId: a.userId,
        action: `RECONCILIATION_${a.action}`,
        details: { caseId: rc.id, accountGroupId: rc.accountGroupId, comment: a.comment }
      }));
      rc.comments.forEach(c => allLogs.push({
        id: generateUUID(),
        timestamp: c.timestamp,
        userId: c.userId,
        action: 'ADD_COMMENT_TO_RECONCILIATION',
        details: { caseId: rc.id, commentId: c.id, text: c.text }
      }));
    });

    let filteredLogs = allLogs.sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());

    if (startDate) filteredLogs = filteredLogs.filter(log => new Date(log.timestamp) >= new Date(startDate));
    if (endDate) filteredLogs = filteredLogs.filter(log => new Date(log.timestamp) <= new Date(endDate));
    if (userId) filteredLogs = filteredLogs.filter(log => log.userId === userId);
    if (actionType) filteredLogs = filteredLogs.filter(log => log.action.includes(actionType));

    return filteredLogs.slice(0, limit);
  }
}

export const mockAPIService = new MockAPIService(); // Exported for broader usage if needed

/**
 * ----------------------------------------------------------------------------------------------------
 * GLOBAL CONTEXTS (THEME, AUTH, NOTIFICATIONS, APP SETTINGS)
