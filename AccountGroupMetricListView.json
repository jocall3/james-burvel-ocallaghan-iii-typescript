// Mock Reconciliation Cases
const generateMockReconciliationCases = (metrics: AccountGroupMetric[]): ReconciliationCase[] => {
  const cases: ReconciliationCase[] = [];
  metrics.filter(m => m.reconciliationId).forEach(metric => {
    const id = metric.reconciliationId!;
    const transactions: ReconciliationTransaction[] = Array.from({ length: Math.floor(Math.random() * 10) + 2 }, (_, j) => {
      const amount = Math.floor(Math.random() * 5000) - 2500;
      const statusOptions: ReconciliationTransaction['status'][] = ['PENDING', 'MATCHED', 'REVIEW', 'ADJUSTED'];
      return {
        id: generateUUID(),
        accountId: metric.associatedAccounts[0] || 'N/A',
        description: `Transaction ${j + 1} for ${metric.bestName}`,
        amount,
        currency: metric.currency,
        transactionDate: new Date(new Date(metric.lastUpdated).getTime() - Math.floor(Math.random() * 7 * 24 * 60 * 60 * 1000)).toISOString(),
        status: statusOptions[Math.floor(Math.random() * statusOptions.length)],
      };
    });
    const initialDiscrepancy = transactions.reduce((sum, t) => sum + t.amount, 0);
    const currentDiscrepancy = initialDiscrepancy * (Math.random() * 0.5 + 0.5); // reduced by 0-50%

    cases.push({
      id,
      accountGroupId: metric.id,
      status: Math.random() > 0.8 ? 'CLOSED' : Math.random() > 0.5 ? 'IN_PROGRESS' : 'PENDING_APPROVAL',
      openedBy: 'analyst.one',
      assignedTo: Math.random() > 0.5 ? 'manager.alpha' : null,
      openedDate: metric.lastUpdated,
      lastUpdated: new Date().toISOString(),
      initialDiscrepancy,
      currentDiscrepancy,
      transactions,
      comments: [{
        id: generateUUID(),
        userId: 'analyst.one',
        username: 'analyst.one',
        timestamp: new Date().toISOString(),
        text: 'Started investigation into significant ledger variance. Identified several unmatched transactions.',
        resolved: false,
      }],
      approvalHistory: [],
      documents: [],
    });
  });
  return cases;
};
const ALL_MOCK_RECONCILIATION_CASES: ReconciliationCase[] = generateMockReconciliationCases(ALL_MOCK_ACCOUNT_GROUP_METRICS);

