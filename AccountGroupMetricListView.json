interface TableProps extends React.TableHTMLAttributes<HTMLTableElement> {
  headers: { key: string; label: string; sortable?: boolean; render?: (item: any) => React.ReactNode }[];
  data: any[];
  onSort?: (sortField: string) => void;
  currentSort?: SortOption;
  rowKey?: string;
}

export const Table: React.FC<TableProps> = ({ headers, data, onSort, currentSort, rowKey = 'id', style, ...props }) => {
  const { theme } = useTheme();
  const tableStyle: React.CSSProperties = {
    width: '100%',
    borderCollapse: 'collapse',
    marginBottom: '1rem',
    ...style,
  };
  const thStyle: React.CSSProperties = {
    padding: '0.75rem',
    borderBottom: `2px solid ${theme.border}`,
    textAlign: 'left',
    backgroundColor: theme.background,
    color: theme.text,
    cursor: 'pointer',
  };
  const tdStyle: React.CSSProperties = {
    padding: '0.75rem',
    borderBottom: `1px solid ${theme.border}`,
    color: theme.text,
  };

  return (
    <div style={{ overflowX: 'auto', backgroundColor: theme.background, borderRadius: '0.25rem' }}>
      <table style={tableStyle} {...props}>
        <thead>
          <tr>
            {headers.map(header => (
              <th
                key={header.key}
                style={thStyle}
                onClick={() => header.sortable && onSort && onSort(header.key)}
              >
                {header.label}
                {header.sortable && currentSort?.field === header.key && (
                  <span style={{ marginLeft: '0.5rem' }}>{currentSort.direction === 'asc' ? '▲' : '▼'}</span>
                )}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {data.length === 0 ? (
            <tr>
              <td colSpan={headers.length} style={{ ...tdStyle, textAlign: 'center' }}>
                No data available.
              </td>
            </tr>
          ) : (
            data.map(item => (
              <tr key={item[rowKey]}>
                {headers.map(header => (
                  <td key={header.key} style={tdStyle}>
                    {header.render ? header.render(item) : item[header.key]}
                  </td>
                ))}
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  );
};

interface PaginationProps {
  currentPage: number;
  totalPages: number;
  onPageChange: (page: number) => void;
  canNextPage: boolean;
  canPreviousPage: boolean;
}

export const Pagination: React.FC<PaginationProps> = ({
  currentPage,
  totalPages,
  onPageChange,
  canNextPage,
  canPreviousPage,
}) => {
  const { theme } = useTheme();
  const buttonStyle: React.CSSProperties = {
    backgroundColor: theme.primary,
    color: 'white',
    border: 'none',
    padding: '0.5rem 1rem',
    margin: '0 0.2rem',
    borderRadius: '0.25rem',
    cursor: 'pointer',
  };
  const disabledButtonStyle: React.CSSProperties = {
    ...buttonStyle,
    backgroundColor: theme.secondary,
    cursor: 'not-allowed',
    opacity: 0.6,
  };

  const getPageNumbers = () => {
    const pageNumbers = [];
    let startPage = Math.max(1, currentPage - 2);
    let endPage = Math.min(totalPages, currentPage + 2);

    if (startPage === 1 && endPage < totalPages) {
      endPage = Math.min(totalPages, startPage + 4);
    }
    if (endPage === totalPages && startPage > 1) {
      startPage = Math.max(1, endPage - 4);
    }

    for (let i = startPage; i <= endPage; i++) {
      pageNumbers.push(i);
    }
    return pageNumbers;
  };

  const pageNumbers = getPageNumbers();

  return (
    <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', marginTop: '1rem' }}>
      <Button
        onClick={() => onPageChange(currentPage - 1)}
        disabled={!canPreviousPage}
        style={!canPreviousPage ? disabledButtonStyle : buttonStyle}
        size="small"
      >
        Previous
      </Button>
      {pageNumbers[0] > 1 && (
        <>
          <Button onClick={() => onPageChange(1)} size="small" style={buttonStyle}>1</Button>
          {pageNumbers[0] > 2 && <span style={{ color: theme.text, margin: '0 0.5rem' }}>...</span>}
        </>
      )}
      {pageNumbers.map(page => (
        <Button
          key={page}
          onClick={() => onPageChange(page)}
          style={page === currentPage ? { ...buttonStyle, backgroundColor: theme.info } : buttonStyle}
          size="small"
        >
          {page}
        </Button>
      ))}
      {pageNumbers[pageNumbers.length - 1] < totalPages && (
        <>
          {pageNumbers[pageNumbers.length - 1] < totalPages - 1 && <span style={{ color: theme.text, margin: '0 0.5rem' }}>...</span>}
          <Button onClick={() => onPageChange(totalPages)} size="small" style={buttonStyle}>{totalPages}</Button>
        </>
      )}
      <Button
        onClick={() => onPageChange(currentPage + 1)}
        disabled={!canNextPage}
        style={!canNextPage ? disabledButtonStyle : buttonStyle}
        size="small"
      >
        Next
      </Button>
    </div>
  );
};

