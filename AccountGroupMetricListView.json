export const AccountGroupMetricListPage: React.FC<{
  onViewDetails: (id: string) => void;
  currentPage: number;
  totalPages: number;
  onPageChange: (page: number) => void;
  canNextPage: boolean;
  canPreviousPage: boolean;
  totalItems: number;
  currentSort: SortOption;
  onSort: (field: string) => void;
  currentFilters: DataFilter;
  onFilterChange: (filters: DataFilter) => void;
  onApplyFilters: () => void;
  onClearFilters: () => void;
}> = ({
  onViewDetails, currentPage, totalPages, onPageChange, canNextPage, canPreviousPage, totalItems,
  currentSort, onSort, currentFilters, onFilterChange, onApplyFilters, onClearFilters
}) => {
  const { theme } = useTheme();
  const { isAuthenticated } = useAuth();
  const { addNotification } = useNotifications();

  const [metrics, setMetrics] = useState<AccountGroupMetric[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [availableTags, setAvailableTags] = useState<string[]>([]); // For filter dropdown

  const fetchMetrics = useCallback(async () => {
    setIsLoading(true);
    setError(null);
    try {
      if (!isAuthenticated) {
        setMetrics([]);
        return;
      }

      // Determine cursor for pagination
      let afterCursor: string | undefined;
      let beforeCursor: string | undefined;
      if (currentPage > 1 && metrics.length > 0) {
        afterCursor = metrics[metrics.length - 1].id;
      }
      // Note: Full cursor-based pagination with 'before' and 'last' is more complex.
      // This simulation simplifies to 'first' and 'after' for forward pagination.

      const result = await mockAPIService.fetchAccountGroupMetrics({
        filters: currentFilters,
        sort: currentSort,
        first: DEFAULT_PAGE_SIZE,
        after: afterCursor, // This simple 'after' will not truly work for jumping pages, only next.
                            // A robust cursor system would require the actual cursor string.
                            // For simplicity, we are implicitly using page number in the parent.
      });
      setMetrics(result.edges.map(edge => edge.node));

      // Collect all unique tags for filter options
      const allTags = new Set<string>();
      ALL_MOCK_ACCOUNT_GROUP_METRICS.forEach(m => m.tags.forEach(tag => allTags.add(tag)));
      setAvailableTags(Array.from(allTags));

    } catch (e: any) {
      setError(`Failed to load account group metrics: ${e.message}`);
      addNotification({ type: 'error', message: `Failed to load metrics: ${e.message}` });
    } finally {
      setIsLoading(false);
    }
  }, [currentFilters, currentSort, isAuthenticated, addNotification, currentPage, metrics]); // Dependency on metrics itself for cursor simulation

  useEffect(() => {
    fetchMetrics();
  }, [fetchMetrics]);

  if (!isAuthenticated) {
    return <Alert type="info" message="Please log in to view account group metrics." />;
  }

  return (
    <div style={{ padding: '2rem', backgroundColor: theme.background, borderRadius: '0.5rem' }}>
      <h1 style={{ color: theme.text, marginBottom: '1.5rem' }}>Account Group Metrics Overview</h1>

      <AccountGroupMetricFilters
        currentFilters={currentFilters}
        onFilterChange={onFilterChange}
        onApplyFilters={onApplyFilters}
        onClearFilters={onClearFilters}
        availableTags={availableTags}
      />

      {error && <Alert type="error" message={error} />}

      <div style={{ marginBottom: '1rem', color: theme.text }}>
        Displaying {metrics.length} of {totalItems} total items.
      </div>

      <AccountGroupMetricListTable
        metrics={metrics}
        onSort={onSort}
        currentSort={currentSort}
        onViewDetails={onViewDetails}
        isLoading={isLoading}
      />

      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        onPageChange={onPageChange}
        canNextPage={canNextPage}
        canPreviousPage={canPreviousPage}
      />
    </div>
  );
};

