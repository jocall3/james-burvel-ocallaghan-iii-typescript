export const formatCurrency = (amount: number, currency: CurrencyEnum = CurrencyEnum.USD, locale: string = 'en-US'): string => {
  try {
    return new Intl.NumberFormat(locale, { style: 'currency', currency }).format(amount);
  } catch (error) {
    console.error('Error formatting currency:', error);
    return `${currency} ${amount.toFixed(2)}`;
  }
};

export const formatDate = (dateString: string, locale: string = 'en-US'): string => {
  try {
    return new Date(dateString).toLocaleDateString(locale, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch (error) {
    console.error('Error formatting date:', error);
    return dateString;
  }
};

export const generateUUID = (): string => {
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
    const r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);
    return v.toString(16);
  });
};

export const calculatePercentage = (part: number, total: number): number => {
  if (total === 0) return 0;
  return (part / total) * 100;
};

export const getVarianceClass = (variance: number, highlight: boolean): string => {
  if (!highlight) return '';
  if (Math.abs(variance) >= LEDGER_VARIANCE_CRITICAL_THRESHOLD) return 'text-red-500 font-bold';
  if (Math.abs(variance) >= LEDGER_VARIANCE_WARNING_THRESHOLD) return 'text-yellow-500';
  return 'text-green-500';
};

export const getUnreconciledClass = (amount: number, percent: number): string => {
  if (amount > UNRECONCILED_AMOUNT_WARNING_THRESHOLD && percent > UNRECONCILED_PERCENT_CRITICAL_THRESHOLD) {
    return 'text-red-500 font-bold';
  }
  if (amount > UNRECONCILED_AMOUNT_WARNING_THRESHOLD || percent > UNRECONCILED_PERCENT_CRITICAL_THRESHOLD) {
    return 'text-yellow-500';
  }
  return '';
};

export const debounce = <T extends (...args: any[]) => void>(func: T, delay: number) => {
  let timeout: NodeJS.Timeout;
  return function(this: any, ...args: Parameters<T>) {
    clearTimeout(timeout);
    timeout = setTimeout(() => func.apply(this, args), delay);
  };
};

export const throttle = <T extends (...args: any[]) => void>(func: T, delay: number) => {
  let inThrottle: boolean;
  let lastFn: NodeJS.Timeout;
  let lastTime: number;
  return function(this: any, ...args: Parameters<T>) {
    if (!inThrottle) {
      func.apply(this, args);
      lastTime = Date.now();
      inThrottle = true;
    } else {
      clearTimeout(lastFn);
      lastFn = setTimeout(() => {
        if (Date.now() - lastTime >= delay) {
          func.apply(this, args);
          lastTime = Date.now();
        }
      }, Math.max(delay - (Date.now() - lastTime), 0));
    }
  };
};

export const generateRandomBalance = (): number => Math.floor(Math.random() * 1_000_000_000) - 50_000_000;
export const generateRandomVariance = (): number => (Math.random() * 0.1) - 0.05; // -5% to +5%
export const generateRandomUnreconciled = (): number => Math.floor(Math.random() * 200_000); // 0 to 200k

