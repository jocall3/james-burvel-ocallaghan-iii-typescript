export const AccountGroupMetricApp: React.FC = () => {
  const { theme, themeKey } = useTheme();
  const { isAuthenticated, isLoading: authLoading } = useAuth();
  const [currentPath, setCurrentPath] = useState(window.location.hash);
  const [isSidebarOpen, setIsSidebarOpen] = useState(true);

  // Pagination state for AccountGroupMetricListPage
  const [currentPage, setCurrentPage] = useState(1);
  const [totalPages, setTotalPages] = useState(1);
  const [totalItems, setTotalItems] = useState(0);
  const [canNextPage, setCanNextPage] = useState(false);
  const [canPreviousPage, setCanPreviousPage] = useState(false);
  const [currentFilters, setCurrentFilters] = useState<DataFilter>({});
  const [currentSort, setCurrentSort] = useState<SortOption>({ field: 'bestName', direction: 'asc' });
  const [reconciliationCasesCurrentPage, setReconciliationCasesCurrentPage] = useState(1); // For reconciliation cases if they were paginated too

  // Debounced filter/sort application
  const applyFiltersDebounced = useRef(
    debounce((filters: DataFilter, sort: SortOption, page: number) => {
      fetchAndPaginateMetrics(filters, sort, page);
    }, THROTTLE_DEBOUNCE_TIME)
  ).current;

  const fetchAndPaginateMetrics = useCallback(async (filters: DataFilter, sort: SortOption, page: number) => {
    try {
      const response = await mockAPIService.fetchAccountGroupMetrics({
        filters,
        sort,
        first: DEFAULT_PAGE_SIZE,
        // In a real cursor system, we'd pass 'after'/'before' cursors.
        // For this page-based simulation, we assume `first` acts with an offset conceptually.
        // The mock API `fetchAccountGroupMetrics` is simplified to work with page number implicitly.
        // Here, we re-fetch all data and slice it, which is inefficient but demonstrates logic.
        // A better mock would internally handle pages.
      });

      const totalCount = response.totalCount;
      const calculatedTotalPages = Math.ceil(totalCount / DEFAULT_PAGE_SIZE);
      setTotalPages(calculatedTotalPages);
      setTotalItems(totalCount);
      setCanNextPage(page < calculatedTotalPages);
      setCanPreviousPage(page > 1);
    } catch (e) {
      console.error("Error fetching metrics for pagination:", e);
    }
  }, []);

  useEffect(() => {
    if (isAuthenticated) {
      // Initialize pagination data after login or app load
      fetchAndPaginateMetrics(currentFilters, currentSort, currentPage);
    }
  }, [isAuthenticated, currentFilters, currentSort, currentPage, fetchAndPaginateMetrics]);


  useEffect(() => {
    const handleHashChange = () => {
      setCurrentPath(window.location.hash);
    };
    window.addEventListener('hashchange', handleHashChange);
    if (!window.location.hash) {
      window.location.hash = '#/dashboard';
    }
    return () => {
      window.removeEventListener('hashchange', handleHashChange);
    };
  }, []);

  const handleLoginSuccess = useCallback(() => {
    window.location.hash = '#/dashboard';
  }, []);

  const handlePageChange = useCallback((page: number) => {
    setCurrentPage(page);
    // When page changes, refetch with current filters/sort
    // The fetchAndPaginateMetrics logic inside AccountGroupMetricListPage needs to handle this.
    // For this pagination simulation, it means a full re-render/re-fetch will happen with the new `currentPage` prop.
  }, []);

  const handleSort = useCallback((field: string) => {
    setCurrentSort(prev => ({
      field: field as keyof AccountGroupMetric,
      direction: prev.field === field && prev.direction === 'asc' ? 'desc' : 'asc',
    }));
    setCurrentPage(1); // Reset to first page on sort change
  }, []);

  const handleFilterChange = useCallback((newFilters: DataFilter) => {
    setCurrentFilters(newFilters);
  }, []);

  const handleApplyFilters = useCallback(() => {
    setCurrentPage(1); // Reset to first page on filter apply
    applyFiltersDebounced(currentFilters, currentSort, 1); // Apply debounce for better UX
  }, [currentFilters, currentSort, applyFiltersDebounced]);

  const handleClearFilters = useCallback(() => {
    setCurrentFilters({});
    setCurrentSort({ field: 'bestName', direction: 'asc' });
    setCurrentPage(1);
    applyFiltersDebounced({}, { field: 'bestName', direction: 'asc' }, 1); // Apply immediately with cleared filters
  }, [applyFiltersDebounced]);

  const toggleSidebar = useCallback(() => setIsSidebarOpen(prev => !prev), []);

  if (authLoading) {
    return (
      <div style={{
        display: 'flex', justifyContent: 'center', alignItems: 'center', minHeight: '100vh',
        backgroundColor: theme.background, color: theme.text,
      }}>
        <LoadingSpinner />
        <p style={{ marginLeft: '1rem' }}>Initializing application...</p>
      </div>
    );
  }

  const renderContent = () => {
    if (!isAuthenticated) {
      return <LoginPage onLoginSuccess={handleLoginSuccess} />;
    }

    const pathSegments = currentPath.split('/');
    const baseRoute = pathSegments[0];
    const detailId = pathSegments[2]; // e.g., #/account-groups/some-id

    switch (baseRoute) {
      case '#/dashboard':
        return <DashboardPage />;
      case '#/account-groups':
        if (detailId) {
          return <AccountGroupMetricDetailView metricId={detailId} onClose={() => window.location.hash = '#/account-groups'} />;
        }
        return (
          <AccountGroupMetricListPage
            currentPage={currentPage}
            totalPages={totalPages}
            onPageChange={handlePageChange}
            canNextPage={canNextPage}
            canPreviousPage={canPreviousPage}
            totalItems={totalItems}
            currentSort={currentSort}
            onSort={handleSort}
            currentFilters={currentFilters}
            onFilterChange={handleFilterChange}
            onApplyFilters={handleApplyFilters}
            onClearFilters={handleClearFilters}
            onViewDetails={(id) => window.location.hash = `#/account-groups/${id}`}
          />
        );
      case '#/reconciliation':
        if (detailId) {
          return <ReconciliationCaseDetailView caseId={detailId} onClose={() => window.location.hash = '#/reconciliation'} />;
        }
        return <ReconciliationCenter onViewCaseDetails={(id) => window.location.hash = `#/reconciliation/${id}`} />;
      case '#/risk-management':
        return <DashboardPage />; // Re-use dashboard, or create a dedicated risk page
      case '#/forecasting':
        return <ForecastingTool />;
      case '#/admin':
        return <AdminPage />;
      case '#/audit':
        return <AuditLogViewer />;
      case '#/profile':
        return <UserProfileView />;
      case '#/settings':
        return <AppSettingsView />;
      default:
        return <NotFoundPage />;
    }
  };

  return (
    <div style={{
      display: 'flex', flexDirection: 'column', minHeight: '100vh',
      backgroundColor: theme.background, color: theme.text,
    }}>
      <Header />
      <div style={{ display: 'flex', flexGrow: 1 }}>
        {isAuthenticated && <Sidebar isOpen={isSidebarOpen} toggleSidebar={toggleSidebar} />}
        <main style={{
          flexGrow: 1, padding: '1rem',
          backgroundColor: theme.background, color: theme.text,
          transition: 'margin-left 0.3s ease-in-out',
          marginLeft: isAuthenticated && isSidebarOpen ? '250px' : '0',
        }}>
          {isAuthenticated && !isSidebarOpen && (
            <Button variant="secondary" size="small" onClick={toggleSidebar} style={{ marginBottom: '1rem' }}>
              ☰ Menu
            </Button>
          )}
          {renderContent()}
        </main>
      </div>
      <Footer />
    </div>
  );
};

/**
 * ----------------------------------------------------------------------------------------------------
 * APP ENTRY POINT
 * This is the final wrapper for the React application, providing all necessary contexts.
 * ----------------------------------------------------------------------------------------------------
 */

export const App: React.FC = () => {
  return (
    <ThemeProvider>
      <AuthProvider>
        <NotificationsProvider>
          <AccountGroupMetricApp />
        </NotificationsProvider>
      </AuthProvider>
    </ThemeProvider>
  );
};

