// Extensive Mock Data Generation
const generateMockAccountGroupMetrics = (count: number = 1000): AccountGroupMetric[] => {
  const mockMetrics: AccountGroupMetric[] = [];
  const currencies = Object.values(CurrencyEnum);
  const statuses = Object.values(AccountGroupMetricStatus);
  const paths = [
    'North America/Wholesale Banking',
    'North America/Retail Banking',
    'Europe/Investment Banking',
    'Asia Pacific/Corporate Treasury',
    'Latin America/Private Wealth',
    'Africa/Commercial Banking',
  ];
  const tags = ['High Volume', 'Critical', 'Reviewed', 'New Client', 'FX Exposure', 'Regulatory Sensitive'];

  for (let i = 0; i < count; i++) {
    const id = generateUUID();
    const bestName = `Account Group ${String(i + 1).padStart(4, '0')} - Client ${String(Math.floor(i / 10) + 1).padStart(3, '0')}`;
    const currency = currencies[Math.floor(Math.random() * currencies.length)];
    const priorDayBalance = generateRandomBalance();
    const availableBalance = priorDayBalance + (Math.random() * 100_000 - 50_000); // +/- 50k from prior day
    const ledgerVariance = generateRandomVariance();
    const unreconciledAmount = generateRandomUnreconciled();
    const unreconciledPercent = calculatePercentage(unreconciledAmount, Math.abs(availableBalance));
    const status = statuses[Math.floor(Math.random() * statuses.length)];
    const riskScore = Math.floor(Math.random() * 100);
    const lastUpdated = new Date(Date.now() - Math.floor(Math.random() * 30 * 24 * 60 * 60 * 1000)).toISOString(); // Last 30 days
    const associatedAccounts = Array.from({ length: Math.floor(Math.random() * 5) + 1 }, () => `ACC-${generateUUID().substring(0, 8).toUpperCase()}`);
    const selectedTags = Array.from({ length: Math.floor(Math.random() * 3) }, () => tags[Math.floor(Math.random() * tags.length)]);
    const reconciliationId = Math.random() > 0.7 ? `RECON-${generateUUID().substring(0, 8).toUpperCase()}` : null;
    const budgetedBalance = priorDayBalance * (1 + (Math.random() * 0.05 - 0.025)); // +/- 2.5% of prior day
    const budgetVariance = (availableBalance - budgetedBalance) / budgetedBalance;

    const forecastedBalances = Array.from({ length: 12 }, (_, month) => {
      const forecastDate = new Date();
      forecastDate.setMonth(forecastDate.getMonth() + month);
      return {
        date: forecastDate.toISOString().split('T')[0],
        amount: availableBalance * (1 + (Math.random() * 0.03 - 0.015) * month), // Small drift over time
      };
    });

    const comments: Comment[] = Math.random() > 0.5 ? [{
      id: generateUUID(),
      userId: 'user123',
      username: 'analyst.one',
      timestamp: new Date().toISOString(),
      text: 'Initial review completed, variance noted. Follow up required.',
      resolved: false,
    }] : [];

    const auditHistory: AuditLogEntry[] = [
      {
        id: generateUUID(),
        timestamp: new Date(new Date().getTime() - 24 * 60 * 60 * 1000).toISOString(),
        userId: 'admin.user',
        action: 'CREATED_ACCOUNT_GROUP',
        details: { initialBalance: priorDayBalance },
      },
      {
        id: generateUUID(),
        timestamp: new Date(new Date().getTime() - 12 * 60 * 60 * 1000).toISOString(),
        userId: 'analyst.one',
        action: 'UPDATE_METRICS',
        details: { oldBalance: priorDayBalance, newBalance: availableBalance, changedFields: ['availableBalance', 'ledgerVariance'] },
      },
    ];

    mockMetrics.push({
      id,
      typename: 'AccountGroupMetric',
      bestName,
      currency,
      priorDayBalance,
      prettyPriorDayBalance: formatCurrency(priorDayBalance, currency),
      availableBalance,
      prettyAvailableBalance: formatCurrency(availableBalance, currency),
      ledgerVariance,
      highlightLedgerVariance: Math.abs(ledgerVariance) >= LEDGER_VARIANCE_WARNING_THRESHOLD,
      unreconciledAmount,
      unreconciledPercent,
      path: paths[Math.floor(Math.random() * paths.length)],
      lastUpdated,
      status,
      riskScore,
      associatedAccounts,
      tags: selectedTags,
      comments,
      auditHistory,
      forecastedBalances,
      reconciliationId,
      budgetedBalance,
      prettyBudgetedBalance: formatCurrency(budgetedBalance, currency),
      budgetVariance,
      highlightBudgetVariance: Math.abs(budgetVariance) >= LEDGER_VARIANCE_WARNING_THRESHOLD,
    });
  }
  return mockMetrics;
};

// Larger data set for "1000 times longer"
