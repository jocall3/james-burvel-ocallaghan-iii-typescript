interface ButtonProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {
  variant?: 'primary' | 'secondary' | 'success' | 'danger' | 'warning' | 'info';
  size?: 'small' | 'medium' | 'large';
  children: React.ReactNode;
}

export const Button: React.FC<ButtonProps> = ({ variant = 'primary', size = 'medium', children, style, ...props }) => {
  const { theme } = useTheme();
  const baseStyle: React.CSSProperties = {
    padding: size === 'small' ? '0.25rem 0.5rem' : size === 'large' ? '0.75rem 1.5rem' : '0.5rem 1rem',
    borderRadius: '0.25rem',
    border: '1px solid transparent',
    cursor: 'pointer',
    fontSize: size === 'small' ? '0.8rem' : size === 'large' ? '1.1rem' : '1rem',
    transition: 'background-color 0.2s, border-color 0.2s, color 0.2s',
    ...style,
  };

  const variantStyles = {
    primary: {
      backgroundColor: theme.primary,
      color: 'white',
      borderColor: theme.primary,
      '&:hover': { opacity: 0.9 },
    },
    secondary: {
      backgroundColor: theme.secondary,
      color: 'white',
      borderColor: theme.secondary,
      '&:hover': { opacity: 0.9 },
    },
    success: {
      backgroundColor: theme.success,
      color: 'white',
      borderColor: theme.success,
      '&:hover': { opacity: 0.9 },
    },
    danger: {
      backgroundColor: theme.error,
      color: 'white',
      borderColor: theme.error,
      '&:hover': { opacity: 0.9 },
    },
    warning: {
      backgroundColor: theme.warning,
      color: theme.text,
      borderColor: theme.warning,
      '&:hover': { opacity: 0.9 },
    },
    info: {
      backgroundColor: theme.info,
      color: 'white',
      borderColor: theme.info,
      '&:hover': { opacity: 0.9 },
    },
  };

  return (
    <button
      style={{ ...baseStyle, ...variantStyles[variant] }}
      {...props}
    >
      {children}
    </button>
  );
};

