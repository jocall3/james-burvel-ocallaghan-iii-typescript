  {
    "id": "REDACTED",
    "name": "DailyBillingMetrics",
    "type": "query",
    "body": "query DailyBillingMetrics($dateRange: DateFilterInput!, $metricName: BillingMetricNameEnum!) {\\n  dailyBillingMetrics(dateRange: $dateRange, metricName: $metricName) {\\n    date\\n    metricName\\n    metricValue\\n    __typename\\n  }\\n}\\n",
    "gemini_tool_definition": {
      "name": "DailyBillingMetrics",
      "description": "Retrieves daily billing metrics, such as revenue, expenses, or profit, for a specified date range. This tool is essential for financial reporting and performance analysis.",
      "parameters": {
        "type": "OBJECT",
        "properties": {
          "dateRange": {
            "type": "OBJECT",
            "description": "The inclusive date range for which to retrieve billing metrics.",
            "properties": {
              "startDate": { "type": "STRING", "format": "date", "description": "The start date in YYYY-MM-DD format (e.g., '2023-01-01')." },
              "endDate": { "type": "STRING", "format": "date", "description": "The end date in YYYY-MM-DD format (e.g., '2023-01-31')." }
            },
            "required": ["startDate", "endDate"]
          },
          "metricName": {
            "type": "STRING",
            "enum": ["REVENUE", "EXPENSES", "PROFIT", "TRANSACTIONS", "CUSTOMERS", "PAYOUTS", "TRANSFERS", "FEES", "BALANCES"],
            "description": "The specific billing metric to query. Examples: 'REVENUE', 'EXPENSES', 'PROFIT', 'TRANSACTIONS'."
          }
        },
        "required": ["dateRange", "metricName"]
      },
      "authentication_required": true,
      "response_schema": {
        "type": "OBJECT",
        "description": "Contains an array of daily billing metric entries.",
        "properties": {
          "dailyBillingMetrics": {
            "type": "ARRAY",
            "description": "A list of daily billing metric entries.",
            "items": {
              "type": "OBJECT",
              "properties": {
                "date": { "type": "STRING", "format": "date", "description": "The date of the metric entry." },
                "metricName": { "type": "STRING", "description": "The name of the metric." },
                "metricValue": { "type": "NUMBER", "description": "The numeric value of the metric." }
              }
            }
          }
        }
      }
    }
  },
