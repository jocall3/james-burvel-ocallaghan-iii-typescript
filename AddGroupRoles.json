import React, { useState, useEffect, useCallback, createContext, useContext, useMemo, useRef } from 'react';

// =====================================================================================================
// SECTION 1: CORE INFRASTRUCTURE - Type Definitions, Interfaces, Enums
// This section defines the foundational data structures for the entire banking application.
// It covers users, roles, permissions, audit events, and various system configurations.
// =====================================================================================================

/**
 * Global application configuration and constants.
 */
export enum AppConstants {
  MIN_PASSWORD_LENGTH = 12,
  MAX_SESSION_DURATION_MINUTES = 60,
  AUDIT_LOG_RETENTION_DAYS = 365,
  MAX_CONCURRENT_SESSIONS = 5,
  PAGINATION_LIMIT = 25,
  DEFAULT_DATE_FORMAT = 'YYYY-MM-DD HH:mm:ss',
  API_BASE_URL = '/api/v1',
  SUPPORT_EMAIL = 'support@citibankdemo.com',
  BANK_NAME = 'Citibank Demo Business Inc.',
  CURRENCY_CODE = 'USD',
}

/**
 * Represents a unique identifier used across the system.
 */
export type UUID = string;

/**
 * Defines the structure for an error response from an API or internal operation.
 */
export interface AppError {
  code: string;
  message: string;
  details?: string;
  timestamp?: string;
}

/**
 * Standard pagination metadata for lists of resources.
 */
export interface PaginationMeta {
  totalItems: number;
  currentPage: number;
  itemsPerPage: number;
  totalPages: number;
  hasNextPage: boolean;
  hasPreviousPage: boolean;
}

/**
 * Base interface for all entities in the system.
 */
export interface BaseEntity {
  id: UUID;
  createdAt: string; // ISO 8601 string
  updatedAt: string; // ISO 8601 string
}

/**
 * Represents an individual user within the banking system.
 */
export interface User extends BaseEntity {
  firstName: string;
  lastName: string;
  email: string;
  username: string;
  status: 'ACTIVE' | 'INACTIVE' | 'PENDING_APPROVAL' | 'LOCKED';
  employeeId: string;
  branchId?: UUID;
  departmentId?: UUID;
  lastLoginAt?: string;
  mfaEnabled: boolean;
  requiresPasswordReset: boolean;
}

/**
 * Represents a department within the bank.
 */
export interface Department extends BaseEntity {
  name: string;
  description: string;
  headOfDepartmentUserId?: UUID;
}

/**
 * Represents a branch of the bank.
 */
export interface Branch extends BaseEntity {
  name: string;
  address: string;
  city: string;
  state: string;
  zipCode: string;
  country: string;
  managerUserId?: UUID;
}

/**
 * Defines a specific permission that can be granted.
 * Permissions are granular operations (e.g., 'CREATE_USER', 'APPROVE_TRANSACTION', 'VIEW_ACCOUNT_BALANCE').
 */
export interface Permission extends BaseEntity {
  name: string; // Unique identifier for the permission (e.g., 'USER_MANAGEMENT:CREATE_USER')
  description: string;
  category: string; // e.g., 'User Management', 'Account Operations', 'Compliance'
  resourceScope?: string; // e.g., 'BRANCH', 'GLOBAL', 'OWN_DEPARTMENT'
}

/**
 * Defines a role, which is a collection of permissions.
 * Roles are assigned to users.
 */
export interface Role extends BaseEntity {
  name: string; // e.g., 'Teller', 'Branch Manager', 'Risk Analyst', 'Compliance Officer'
  description: string;
  permissions: Permission[];
  type: 'GLOBAL' | 'BRANCH_SPECIFIC' | 'DEPARTMENT_SPECIFIC';
  isActive: boolean;
  requiresMFA: boolean;
  reviewFrequencyDays?: number; // How often this role needs to be reviewed
}

/**
 * Input structure for adding new group roles.
 * This directly maps to the original JSON's GraphQL mutation input.
 */
export interface AddGroupRolesInput {
  groupId: UUID; // Assuming "Group" is another entity, or this is a collection of user IDs
  roleIds: UUID[];
  assignedByUserId: UUID;
  effectiveDate: string; // ISO 8601
  expirationDate?: string; // ISO 8601
  reason: string;
  requiresApproval: boolean;
}

/**
 * Represents the assignment of a role to a user.
 */
export interface UserRoleAssignment extends BaseEntity {
  userId: UUID;
  roleId: UUID;
  assignedByUserId: UUID;
  effectiveDate: string;
  expirationDate?: string;
  status: 'ACTIVE' | 'PENDING_APPROVAL' | 'REVOKED' | 'EXPIRED';
  approvalWorkflowId?: UUID;
  notes?: string;
}

/**
 * Represents an audit event, logging changes and critical actions.
 */
export interface AuditEvent extends BaseEntity {
  eventType: string; // e.g., 'USER_CREATED', 'ROLE_ASSIGNED', 'PASSWORD_CHANGED', 'TRANSACTION_APPROVED'
  entityType: string; // e.g., 'User', 'Role', 'Account', 'Transaction'
  entityId: UUID;
  userId: UUID; // User who performed the action
  timestamp: string;
  details: {
    oldValue?: any;
    newValue?: any;
    ipAddress?: string;
    userAgent?: string;
    description: string;
  };
  severity: 'INFO' | 'WARNING' | 'CRITICAL';
}

/**
 * Represents a multi-stage approval workflow.
 */
export interface ApprovalWorkflow extends BaseEntity {
  entityType: string; // e.g., 'UserRoleAssignment', 'NewAccount', 'HighValueTransaction'
  entityId: UUID;
  initiatorUserId: UUID;
  status: 'PENDING' | 'APPROVED' | 'REJECTED' | 'CANCELED';
  currentStage: number;
  stages: ApprovalStage[];
  notes?: string;
}

/**
 * Represents a single stage in an approval workflow.
 */
export interface ApprovalStage {
  stageNumber: number;
  approverUserId?: UUID; // Specific user or role ID (if role-based)
  approverRoleId?: UUID;
  status: 'PENDING' | 'APPROVED' | 'REJECTED';
  approvedAt?: string;
  rejectedAt?: string;
  comments?: string;
  dueDate?: string;
}

/**
 * Represents a system-wide policy.
 */
export interface Policy extends BaseEntity {
  name: string;
  description: string;
  policyType: 'ACCESS_CONTROL' | 'PASSWORD_COMPLEXITY' | 'SESSION_MANAGEMENT' | 'DATA_RETENTION';
  rules: string[]; // JSON string or array of rule definitions
  isActive: boolean;
}

/**
 * Represents a notification sent to a user.
 */
export interface Notification extends BaseEntity {
  userId: UUID;
  type: 'INFO' | 'WARNING' | 'ERROR' | 'ALERT' | 'APPROVAL_REQUEST';
  message: string;
  isRead: boolean;
  link?: string; // URL to navigate to when clicking the notification
  icon?: string; // Icon identifier
}

/**
 * Represents a report definition.
 */
export interface ReportDefinition extends BaseEntity {
  name: string;
  description: string;
  reportType: 'USER_ROLES' | 'AUDIT_LOGS' | 'TRANSACTION_SUMMARY' | 'BRANCH_PERFORMANCE';
  parametersSchema: any; // JSON schema for report parameters
  lastRunAt?: string;
  lastGeneratedByUserId?: UUID;
}

/**
 * Represents a generated report instance.
 */
export interface ReportInstance extends BaseEntity {
  reportDefinitionId: UUID;
  generatedByUserId: UUID;
  generationStatus: 'PENDING' | 'COMPLETED' | 'FAILED';
  filePath?: string; // S3 bucket path or similar
  parameters: any; // Actual parameters used for generation
  startDate: string;
  endDate: string;
}

/**
 * Represents a secure configuration parameter.
 */
export interface SystemConfiguration extends BaseEntity {
  key: string;
  value: string; // Encrypted or sensitive value
  description: string;
  isSensitive: boolean;
  lastUpdatedByUserId: UUID;
}

/**
 * Context type for authentication and user information.
 */
export interface AuthContextType {
  currentUser: User | null;
  isAuthenticated: boolean;
  login: (username: string, password: string) => Promise<void>;
  logout: () => void;
  isLoading: boolean;
  error: AppError | null;
  checkSession: () => Promise<void>;
}

/**
 * Represents data for a login attempt.
 */
export interface LoginPayload {
  username: string;
  passwordHash: string;
}

/**
 * Represents a login response, including token and user info.
 */
export interface LoginResponse {
  token: string;
  user: User;
  expiresIn: number; // seconds
}

/**
 * Represents different dashboards available based on user roles.
 */
export enum DashboardType {
  ADMIN = 'AdminDashboard',
  BRANCH_MANAGER = 'BranchManagerDashboard',
  COMPLIANCE = 'ComplianceDashboard',
  RISK_ANALYST = 'RiskAnalystDashboard',
  TELLER = 'TellerDashboard',
  CUSTOMER_SERVICE = 'CustomerServiceDashboard',
  USER = 'UserDashboard', // Generic user
}

