    },
    meta: {
        graph: {}
    }
};

const setLoading = (s, a_t, val) => {
    const n_s = deepClone(s);
    n_s.sys.loading[a_t] = val;
    return n_s;
};

const setError = (s, a_t, err) => {
    const n_s = deepClone(s);
    n_s.sys.errors[a_t] = err;
    n_s.sys.loading[a_t] = false;
    return n_s;
};

export const mainReducer = (s = i_s, a) => {
    switch (a.type) {
        case A_T.SYS_LOADING:
            return setLoading(s, a.payload.type, a.payload.isLoading);
        case A_T.SYS_ERROR:
            return setError(s, a.payload.type, a.payload.error);
        case A_T.GMN_QUERY:
            {
                const n_s = deepClone(s);
                n_s.gmn.isThinking = true;
                n_s.gmn.history.push({
                    q: a.payload,
                    ts: new Date().toISOString()
                });
                return n_s;
            }
        case A_T.GMN_RESP:
            {
                const n_s = deepClone(s);
                n_s.gmn.isThinking = false;
                n_s.gmn.lastResp = a.payload;
                n_s.gmn.history[n_s.gmn.history.length - 1].a = a.payload;
                return n_s;
            }
        case A_T.PLD_GET_LINK_OK:
            {
                const n_s = deepClone(s);
                n_s.pld.linkToken = a.payload.link_token;
                return n_s;
            }
        case A_T.PLD_XCHG_TOKEN_OK:
            {
                const n_s = deepClone(s);
                n_s.pld.accessToken = a.payload.access_token;
                n_s.pld.items.push({
                    id: a.payload.item_id,
                    token: a.payload.access_token
                });
                return n_s;
            }
        case A_T.GHB_FETCH_REPOS_OK:
            {
                const n_s = deepClone(s);
                n_s.ghb.repos = a.payload;
                return n_s;
            }
        case A_T.GDRV_LIST_FILES_OK:
            {
                const n_s = deepClone(s);
                n_s.gdrv.files = a.payload.files;
                return n_s;
            }
        case A_T.GDRV_UPLD_FILE_OK:
            {
                const n_s = deepClone(s);
                n_s.gdrv.files.push(a.payload);
                return n_s;
            }
        case A_T.SFC_QUERY_OK:
            {
                const n_s = deepClone(s);
                const q_key = b64enc(a.meta.query);
                n_s.sfc.records[q_key] = a.payload.records;
                return n_s;
            }
        case A_T.SFC_CREATE_OK:
            {
                const n_s = deepClone(s);
                const q_key = 'all_new_records';
                if (!n_s.sfc.records[q_key]) {
                    n_s.sfc.records[q_key] = [];
                }
                n_s.sfc.records[q_key].push({
                    id: a.payload.id,
                    success: a.payload.success,
                    type: a.meta.sobject
                });
                return n_s;
            }
        case A_T.SHOP_GET_PRODS_OK:
            {
                const n_s = deepClone(s);
                n_s.shop.products = a.payload.products;
                return n_s;
            }
        case A_T.SHOP_CREATE_PROD_OK:
            {
                const n_s = deepClone(s);
                n_s.shop.products.push(a.payload.product);
                return n_s;
            }
        case A_T.TWL_SEND_SMS_OK:
            {
                const n_s = deepClone(s);
                n_s.twl.sentMessages.push(a.payload);
                return n_s;
            }
        case A_T.MDT_GET_POS_OK:
            {
                const n_s = deepClone(s);
                n_s.mdt.paymentOrders = a.payload;
                return n_s;
            }
        case A_T.SPB_RES:
            {
                const n_s = deepClone(s);
                if (!n_s.spb.tables[a.meta.table]) {
                    n_s.spb.tables[a.meta.table] = [];
                }
                if (a.meta.op === 'select') {
                    n_s.spb.tables[a.meta.table] = a.payload;
                }
                if (a.meta.op === 'insert') {
                    n_s.spb.tables[a.meta.table].push(...a.payload);
                }
                return n_s;
            }
        case A_T.AWS_S3_LIST:
            {
                const n_s = deepClone(s);
                const bucket = a.payload.bucket;
                if (!n_s.aws.s3[bucket]) n_s.aws.s3[bucket] = {};
                n_s.aws.s3[bucket].files = a.payload.data;
                n_s.aws.s3[bucket].lastUpdated = new Date().toISOString();
                return n_s;
            }
        case A_T.AWS_EC2_START:
            {
                const n_s = deepClone(s);
                n_s.aws.ec2.push({
                    id: a.payload.id,
                    status: 'running',
                    startTime: new Date().toISOString()
                });
                return n_s;
            }
        case A_T.VRL_DEPLOY_OK:
            {
                const n_s = deepClone(s);
                n_s.vrl.deployments.push(a.payload);
                return n_s;
            }
        case A_T.OKT_AUTH:
            {
                const n_s = deepClone(s);
                n_s.okt.user = { ...a.payload,
                    isAuthenticated: true
                };
                return n_s;
            }
        case A_T.SNY_REP_ERR:
            {
                const n_s = deepClone(s);
                n_s.sny.errors.push({ ...a.payload,
                    ts: new Date().toISOString()
                });
                return n_s;
            }
        default:
            return s;
    }
};

export const a_c = {
    sys_loading: (type, isLoading) => ({
        type: A_T.SYS_LOADING,
        payload: {
            type,
            isLoading
        }
    }),
    sys_error: (type, error) => ({
        type: A_T.SYS_ERROR,
        payload: {
            type,
            error
        }
    }),
    gmn_query: (prompt) => ({
        type: A_T.GMN_QUERY,
        payload: prompt
    }),
    gmn_resp: (response) => ({
        type: A_T.GMN_RESP,
        payload: response
    }),
    pld_get_link_ok: (data) => ({
        type: A_T.PLD_GET_LINK_OK,
        payload: data
    }),
    pld_xchg_token_ok: (data) => ({
        type: A_T.PLD_XCHG_TOKEN_OK,
        payload: data
    }),
    ghb_fetch_repos_ok: (data) => ({
        type: A_T.GHB_FETCH_REPOS_OK,
        payload: data
    }),
    gdrv_list_files_ok: (data) => ({
        type: A_T.GDRV_LIST_FILES_OK,
        payload: data
    }),
    gdrv_upld_file_ok: (data) => ({
        type: A_T.GDRV_UPLD_FILE_OK,
        payload: data
    }),
    sfc_query_ok: (data, query) => ({
        type: A_T.SFC_QUERY_OK,
        payload: data,
        meta: {
            query
        }
    }),
    sfc_create_ok: (data, sobject) => ({
        type: A_T.SFC_CREATE_OK,
        payload: data,
        meta: {
            sobject
        }
    }),
    shop_get_prods_ok: (data) => ({
        type: A_T.SHOP_GET_PRODS_OK,
        payload: data
    }),
    shop_create_prod_ok: (data) => ({
        type: A_T.SHOP_CREATE_PROD_OK,
        payload: data
    }),
    twl_send_sms_ok: (data) => ({
        type: A_T.TWL_SEND_SMS_OK,
        payload: data
    }),
    mdt_get_pos_ok: (data) => ({
        type: A_T.MDT_GET_POS_OK,
        payload: data
    }),
    spb_res: (data, table, op) => ({
        type: A_T.SPB_RES,
        payload: data,
        meta: {
            table,
            op
        }
    }),
    aws_s3_list: (bucket, data) => ({
        type: A_T.AWS_S3_LIST,
        payload: {
            bucket,
            data
        }
    }),
    aws_ec2_start: (id) => ({
        type: A_T.AWS_EC2_START,
        payload: {
            id
        }
    }),
    vrl_deploy_ok: (deploymentInfo) => ({
        type: A_T.VRL_DEPLOY_OK,
        payload: deploymentInfo
    }),
    okt_auth: (userInfo) => ({
        type: A_T.OKT_AUTH,
        payload: userInfo
    }),
    sny_rep_err: (error) => ({
        type: A_T.SNY_REP_ERR,
        payload: error
    }),
};

export const thunks = {
    fetchPlaidLinkToken: (user) => async (dispatch, getState) => {
        dispatch(a_c.sys_loading(A_T.PLD_GET_LINK, true));
        try {
            const pld_h = new PlaidHlpr({
                cid: 'client_id_from_env',
                s: 'secret_from_env'
            });
            const resp = await pld_h.createLink(user);
            dispatch(a_c.pld_get_link_ok(resp.data));
        } catch (e) {
            dispatch(a_c.sys_error(A_T.PLD_GET_LINK, e.message));
        } finally {
            dispatch(a_c.sys_loading(A_T.PLD_GET_LINK, false));
        }
    },
    exchangePlaidPublicToken: (publicToken) => async (dispatch, getState) => {
        dispatch(a_c.sys_loading(A_T.PLD_XCHG_TOKEN, true));
        try {
            const pld_h = new PlaidHlpr({
                cid: 'client_id_from_env',
                s: 'secret_from_env'
            });
            const resp = await pld_h.xchgPub(publicToken);
            dispatch(a_c.pld_xchg_token_ok(resp.data));
        } catch (e) {
            dispatch(a_c.sys_error(A_T.PLD_XCHG_TOKEN, e.message));
        } finally {
            dispatch(a_c.sys_loading(A_T.PLD_XCHG_TOKEN, false));
        }
    },
    fetchGithubRepos: (username) => async (dispatch) => {
        dispatch(a_c.sys_loading(A_T.GHB_FETCH_REPOS, true));
        try {
            const ghb_h = new GitHubHlpr({});
            const resp = await ghb_h.getRepos(username);
            dispatch(a_c.ghb_fetch_repos_ok(resp.data));
        } catch (e) {
            dispatch(a_c.sys_error(A_T.GHB_FETCH_REPOS, e.message));
        } finally {
            dispatch(a_c.sys_loading(A_T.GHB_FETCH_REPOS, false));
        }
    },
    listDriveFiles: () => async (dispatch, getState) => {
        dispatch(a_c.sys_loading(A_T.GDRV_LIST_FILES, true));
        try {
            const token = getState().gdrv.token;
            const gdrv_h = new GDriveHlpr({
                t: token
            });
            if (!token) {
                await gdrv_h.auth({});
                // In a real app, you'd save this token back to state
            }
            const resp = await gdrv_h.list();
            dispatch(a_c.gdrv_list_files_ok(resp));
        } catch (e) {
            dispatch(a_c.sys_error(A_T.GDRV_LIST_FILES, e.message));
        } finally {
            dispatch(a_c.sys_loading(A_T.GDRV_LIST_FILES, false));
        }
    },
    uploadToDrive: (file, metadata) => async (dispatch, getState) => {
        dispatch(a_c.sys_loading(A_T.GDRV_UPLD_FILE, true));
        try {
            const token = getState().gdrv.token;
            const gdrv_h = new GDriveHlpr({
                t: token
            });
            const resp = await gdrv_h.upld(file, metadata);
            dispatch(a_c.gdrv_upld_file_ok(resp.data));
        } catch (e) {
            dispatch(a_c.sys_error(A_T.GDRV_UPLD_FILE, e.message));
        } finally {
            dispatch(a_c.sys_loading(A_T.GDRV_UPLD_FILE, false));
        }
    },
    querySalesforce: (soqlQuery) => async (dispatch, getState) => {
        dispatch(a_c.sys_loading(A_T.SFC_QUERY, true));
        try {
            const {
                instanceUrl,
                token
            } = getState().sfc;
            const sfc_h = new SalesforceHlpr(instanceUrl, token);
            const resp = await sfc_h.query(soqlQuery);
            dispatch(a_c.sfc_query_ok(resp.data, soqlQuery));
        } catch (e) {
            dispatch(a_c.sys_error(A_T.SFC_QUERY, e.message));
        } finally {
            dispatch(a_c.sys_loading(A_T.SFC_QUERY, false));
        }
    },
    createSalesforceRecord: (sobject, data) => async (dispatch, getState) => {
        dispatch(a_c.sys_loading(A_T.SFC_CREATE, true));
        try {
            const {
                instanceUrl,
                token
            } = getState().sfc;
            const sfc_h = new SalesforceHlpr(instanceUrl, token);
            const resp = await sfc_h.create(sobject, data);
            dispatch(a_c.sfc_create_ok(resp.data, sobject));
        } catch (e) {
            dispatch(a_c.sys_error(A_T.SFC_CREATE, e.message));
        } finally {
            dispatch(a_c.sys_loading(A_T.SFC_CREATE, false));
        }
