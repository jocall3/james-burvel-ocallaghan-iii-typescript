};
export const extendedReducer = (s = i_s, a) => {
    let n_s = mainReducer(s, a);
    if (n_s !== s) return n_s;
    switch (a.type) {
        case 'AZR_BLOB_LIST_OK':
            {
                const s_c = deepClone(s);
                s_c.azr.blobs = a.payload;
                return s_c;
            }
        case 'VRL_DEPLOY_OK':
            {
                const s_c = deepClone(s);
                s_c.vrl.deployments.push(a.payload);
                return s_c;
            }
        case 'STRP_PAY_INTENT_OK':
            {
                const s_c = deepClone(s);
                s_c.strp.lastIntent = a.payload;
                return s_c;
            }
        default:
            return s;
    }
};

