        } finally {
            dispatch(a_c.sys_loading(A_T.SHOP_GET_PRODS, false));
        }
    },
    sendTwilioSms: (from, to, body) => async (dispatch, getState) => {
        dispatch(a_c.sys_loading(A_T.TWL_SEND_SMS, true));
        try {
            const {
                sid,
                token
            } = getState().twl.credentials;
            const twl_h = new TwilioHlpr({
                sid,
                tok: token
            });
            const resp = await twl_h.sendSMS(from, to, body);
            dispatch(a_c.twl_send_sms_ok(resp.data));
        } catch (e) {
            dispatch(a_c.sys_error(A_T.TWL_SEND_SMS, e.message));
        } finally {
            dispatch(a_c.sys_loading(A_T.TWL_SEND_SMS, false));
        }
    },
    fetchSupabaseTable: (table) => async (dispatch, getState) => {
        dispatch(a_c.sys_loading(A_T.SPB_FETCH, true));
        try {
            const {
                url,
                key
            } = getState().spb.config;
            const spb_h = new SupaHlpr(url, key);
            const resp = await spb_h.from(table).select();
            dispatch(a_c.spb_res(resp.data, table, 'select'));
        } catch (e) {
            dispatch(a_c.sys_error(A_T.SPB_FETCH, e.message));
        } finally {
            dispatch(a_c.sys_loading(A_T.SPB_FETCH, false));
        }
    },
    insertSupabaseRow: (table, data) => async (dispatch, getState) => {
        dispatch(a_c.sys_loading(A_T.SPB_INSERT, true));
        try {
            const {
                url,
                key
            } = getState().spb.config;
            const spb_h = new SupaHlpr(url, key);
            const resp = await spb_h.from(table).insert(data);
            dispatch(a_c.spb_res(resp.data, table, 'insert'));
        } catch (e) {
            dispatch(a_c.sys_error(A_T.SPB_INSERT, e.message));
        } finally {
            dispatch(a_c.sys_loading(A_T.SPB_INSERT, false));
        }
    }
};

export const selectors = {
    isSysLoading: (state, actionType) => state.sys.loading[actionType] || false,
    getSysError: (state, actionType) => state.sys.errors[actionType] || null,
    getGeminiHistory: (state) => state.gmn.history,
    isGeminiThinking: (state) => state.gmn.isThinking,
    getPlaidLinkToken: (state) => state.pld.linkToken,
    getPlaidItems: (state) => state.pld.items,
    getGithubRepos: (state) => state.ghb.repos,
    getDriveFiles: (state) => state.gdrv.files,
    getSalesforceRecords: (state, query) => state.sfc.records[b64enc(query)] || [],
    getShopifyProducts: (state) => state.shop.products,
    getSentTwilioMessages: (state) => state.twl.sentMessages,
    getSupabaseTableData: (state, table) => state.spb.tables[table] || [],
    getAwsS3BucketFiles: (state, bucket) => state.aws.s3[bucket]?.files || [],
    getVercelDeployments: (state) => state.vrl.deployments,
    getAuthenticatedOktaUser: (state) => state.okt.user,
    getSentryErrors: (state) => state.sny.errors,
};

