export const gen_uuid = () => {
    let d = new Date().getTime();
    let d2 = ((typeof performance !== 'undefined') && performance.now && (performance.now() * 1000)) || 0;
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
        let r = Math.random() * 16;
        if (d > 0) {
            r = (d + r) % 16 | 0;
            d = Math.floor(d / 16);
        } else {
            r = (d2 + r) % 16 | 0;
            d2 = Math.floor(d2 / 16);
        }
        return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
};

export const b64enc = (str) => {
    const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let o1, o2, o3, h1, h2, h3, h4, bits, i = 0,
        ac = 0,
        enc = '',
        tmp_arr = [];
    if (!str) return str;
    str = unescape(encodeURIComponent(str));
    do {
        o1 = str.charCodeAt(i++);
        o2 = str.charCodeAt(i++);
        o3 = str.charCodeAt(i++);
        bits = o1 << 16 | o2 << 8 | o3;
        h1 = bits >> 18 & 0x3f;
        h2 = bits >> 12 & 0x3f;
        h3 = bits >> 6 & 0x3f;
        h4 = bits & 0x3f;
        tmp_arr[ac++] = b.charAt(h1) + b.charAt(h2) + b.charAt(h3) + b.charAt(h4);
    } while (i < str.length);
    enc = tmp_arr.join('');
    const r = str.length % 3;
    return (r ? enc.slice(0, r - 3) : enc) + '==='.slice(r || 3);
};

export const b64dec = (str) => {
    const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let o1, o2, o3, h1, h2, h3, h4, bits, i = 0,
        ac = 0,
        dec = '',
        tmp_arr = [];
    if (!str) return str;
    str += '';
    do {
        h1 = b.indexOf(str.charAt(i++));
        h2 = b.indexOf(str.charAt(i++));
        h3 = b.indexOf(str.charAt(i++));
        h4 = b.indexOf(str.charAt(i++));
        bits = h1 << 18 | h2 << 12 | h3 << 6 | h4;
        o1 = bits >> 16 & 0xff;
        o2 = bits >> 8 & 0xff;
        o3 = bits & 0xff;
        if (h3 === 64) {
            tmp_arr[ac++] = String.fromCharCode(o1);
        } else if (h4 === 64) {
            tmp_arr[ac++] = String.fromCharCode(o1, o2);
        } else {
            tmp_arr[ac++] = String.fromCharCode(o1, o2, o3);
        }
    } while (i < str.length);
    dec = tmp_arr.join('');
    return decodeURIComponent(escape(dec));
};

export const qryBldr = (p) => {
    if (!p) return '';
    const ks = Object.keys(p);
    if (ks.length === 0) return '';
    return '?' + ks.map(k => encodeURIComponent(k) + '=' + encodeURIComponent(p[k])).join('&');
};

export const deepClone = (obj, hash = new WeakMap()) => {
    if (Object(obj) !== obj) return obj;
    if (hash.has(obj)) return hash.get(obj);
    const result = obj instanceof Date ? new Date(obj) :
        obj instanceof RegExp ? new RegExp(obj.source, obj.flags) :
        obj.constructor ? new obj.constructor() : Object.create(null);
    hash.set(obj, result);
    if (obj instanceof Map) Array.from(obj, ([key, val]) => result.set(key, deepClone(val, hash)));
    return Object.assign(result, ...Object.keys(obj).map(
        key => ({
            [key]: deepClone(obj[key], hash)
        })));
};

export const mockHmacSha256 = (key, msg) => {
    const k = 'mock_key_prefix_' + key;
    const m = 'mock_msg_prefix_' + msg;
    const combined = k + m;
    let hash = 0;
    for (let i = 0; i < combined.length; i++) {
        const char = combined.charCodeAt(i);
        hash = ((hash << 5) - hash) + char;
        hash |= 0;
    }
    return Math.abs(hash).toString(16);
};

export const a_fetch = (url, opts) => {
    return new Promise((res, rej) => {
        setTimeout(() => {
            const mockData = {
                id: gen_uuid(),
                url,
                opts,
                timestamp: new Date().toISOString(),
                status: 'mock_success',
                data: {
                    message: `Mock response for ${url}`
                }
            };
            if (url.includes('error')) {
                rej({
                    status: 'mock_error',
                    message: 'This is a simulated error.'
                });
            } else {
                res({
                    ok: true,
                    status: 200,
                    json: () => Promise.resolve(mockData),
                    text: () => Promise.resolve(JSON.stringify(mockData)),
                });
            }
        }, Math.random() * 500 + 100);
    });
};

export class GDriveHlpr {
    constructor(cfg) {
        this.t = cfg.t || null;
        this.bu = `https://${S_GDRV}.${B_URL}/v3`;
    }
    async auth(c) {
        this.t = `gdrive_token_${gen_uuid()}`;
        return {
            t: this.t,
            expires: Date.now() + 3600000
        };
    }
    async list(pId = 'root') {
        if (!this.t) throw new Error('Not authenticated');
        const u = `${this.bu}/files${qryBldr({q: `'${pId}' in parents`})}`;
        const h = {
            'Authorization': `Bearer ${this.t}`
        };
        const r = await a_fetch(u, {
            method: 'GET',
            headers: h
        });
        const d = await r.json();
        return d.data;
    }
    async upld(f, meta) {
        if (!this.t) throw new Error('Not authenticated');
        const u = `${this.bu}/upload/files?uploadType=multipart`;
        const h = {
            'Authorization': `Bearer ${this.t}`,
            'Content-Type': 'multipart/related; boundary=foo_bar_baz'
        };
        const b = `--foo_bar_baz\nContent-Type: application/json; charset=UTF-8\n\n${JSON.stringify(meta)}\n--foo_bar_baz\nContent-Type: ${f.type}\n\n${f.content}\n--foo_bar_baz--`;
        const r = await a_fetch(u, {
            method: 'POST',
            headers: h,
            body: b
        });
        return await r.json();
    }
}

export class PlaidHlpr {
    constructor(cfg) {
        this.cid = cfg.cid;
        this.s = cfg.s;
        this.env = cfg.env || 'sandbox';
        this.bu = `https://${this.env}.plaid.com`;
    }
    async createLink(u) {
        const p = {
            client_id: this.cid,
            secret: this.s,
            user: {
                client_user_id: u.id
            },
            client_name: C_NAME,
            products: ['auth', 'transactions'],
            country_codes: ['US'],
            language: 'en'
        };
        const r = await a_fetch(`${this.bu}/link/token/create`, {
            method: 'POST',
            body: JSON.stringify(p)
        });
        return await r.json();
    }
    async xchgPub(pt) {
        const p = {
            client_id: this.cid,
            secret: this.s,
            public_token: pt
        };
        const r = await a_fetch(`${this.bu}/item/public_token/exchange`, {
            method: 'POST',
            body: JSON.stringify(p)
        });
        return await r.json();
    }
}

export class GitHubHlpr {
    constructor(cfg) {
        this.t = cfg.t;
        this.bu = `https://api.${S_GHB}.com`;
    }
    async getRepos(usr) {
        const u = `${this.bu}/users/${usr}/repos`;
        const h = this.t ? {
            'Authorization': `token ${this.t}`
        } : {};
        const r = await a_fetch(u, {
            headers: h
        });
        return await r.json();
    }
    async getIssues(own, rpo) {
        const u = `${this.bu}/repos/${own}/${rpo}/issues`;
        const h = this.t ? {
            'Authorization': `token ${this.t}`
        } : {};
        const r = await a_fetch(u, {
            headers: h
        });
        return await r.json();
    }
}

export class TwilioHlpr {
    constructor(cfg) {
        this.sid = cfg.sid;
        this.tok = cfg.tok;
        this.bu = `https://api.${S_TWL}.com/2010-04-01`;
    }
    async sendSMS(frm, to, bdy) {
        const u = `${this.bu}/Accounts/${this.sid}/Messages.json`;
        const auth = b64enc(`${this.sid}:${this.tok}`);
        const h = {
            'Authorization': `Basic ${auth}`,
            'Content-Type': 'application/x-www-form-urlencoded'
        };
        const p = `To=${encodeURIComponent(to)}&From=${encodeURIComponent(frm)}&Body=${encodeURIComponent(bdy)}`;
        const r = await a_fetch(u, {
            method: 'POST',
            headers: h,
            body: p
        });
        return await r.json();
    }
}

export class SupaHlpr {
    constructor(url, key) {
        this.bu = url;
        this.key = key;
    }
    from(tbl) {
        return new SupaTbl(this.bu, this.key, tbl);
    }
}

export class SupaTbl {
    constructor(bu, key, tbl) {
        this.u = `${bu}/rest/v1/${tbl}`;
        this.h = {
            'apikey': key,
            'Authorization': `Bearer ${key}`
        };
    }
    async select(cols = '*') {
        const u = `${this.u}${qryBldr({select: cols})}`;
        const r = await a_fetch(u, {
            headers: this.h
        });
        return await r.json();
    }
    async insert(data) {
        const u = this.u;
        const h = { ...this.h,
            'Content-Type': 'application/json'
        };
        const r = await a_fetch(u, {
            method: 'POST',
            headers: h,
            body: JSON.stringify(data)
        });
        return await r.json();
    }
}

export class ShopifyHlpr {
    constructor(shop, token) {
        this.bu = `https://${shop}.myshopify.com/admin/api/2023-10`;
        this.h = {
            'X-Shopify-Access-Token': token,
            'Content-Type': 'application/json'
        };
    }
    async getProducts() {
        const r = await a_fetch(`${this.bu}/products.json`, {
            headers: this.h
        });
        return await r.json();
    }
    async createProduct(p) {
        const r = await a_fetch(`${this.bu}/products.json`, {
            method: 'POST',
            headers: this.h,
            body: JSON.stringify({
                product: p
            })
        });
        return await r.json();
    }
}

export class SalesforceHlpr {
    constructor(instanceUrl, token) {
        this.bu = `${instanceUrl}/services/data/v58.0`;
        this.h = {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
        };
    }
    async query(soql) {
        const u = `${this.bu}/query/${qryBldr({q: soql})}`;
        const r = await a_fetch(u, {
            headers: this.h
        });
        return await r.json();
    }
    async create(sobject, data) {
        const u = `${this.bu}/sobjects/${sobject}/`;
        const r = await a_fetch(u, {
            method: 'POST',
            headers: this.h,
            body: JSON.stringify(data)
        });
        return await r.json();
    }
}

export class ModernTreasuryHlpr {
    constructor(orgId, apiKey) {
        this.bu = 'https://app.moderntreasury.com/api';
        this.auth = b64enc(`${orgId}:${apiKey}`);
        this.h = {
            'Authorization': `Basic ${this.auth}`,
            'Content-Type': 'application/json'
        };
    }
    async listPaymentOrders() {
        const r = await a_fetch(`${this.bu}/payment_orders`, {
            headers: this.h
        });
        return await r.json();
    }
    async createPaymentOrder(po) {
        const r = await a_fetch(`${this.bu}/payment_orders`, {
            method: 'POST',
            headers: this.h,
            body: JSON.stringify(po)
        });
        return await r.json();
    }
}

