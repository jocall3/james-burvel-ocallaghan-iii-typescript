export class AzureBlobHlpr {
    constructor(acct, key) {
        this.acct = acct;
        this.key = key;
        this.bu = `https://${acct}.blob.core.windows.net`;
    }
    async listBlobs(container) {
        const d = new Date().toUTCString();
        const strToSign = `GET\n\n\n\n\n\n\n\n\n\n\n\nx-ms-date:${d}\nx-ms-version:2020-10-02\n/${this.acct}/${container}\ncomp:list\nrestype:container`;
        const sig = mockHmacSha256(b64dec(this.key), strToSign);
        const authHdr = `SharedKey ${this.acct}:${sig}`;
        const h = {
            'Authorization': authHdr,
            'x-ms-date': d,
            'x-ms-version': '2020-10-02'
        };
        const u = `${this.bu}/${container}?restype=container&comp=list`;
        const r = await a_fetch(u, {
            headers: h
        });
        return r.text();
    }
}
export class VercelHlpr {
    constructor(token) {
        this.t = token;
        this.bu = 'https://api.vercel.com';
    }
    async createDeploy(teamId) {
        const u = `${this.bu}/v13/deployments` + (teamId ? `?teamId=${teamId}` : '');
        const h = {
            'Authorization': `Bearer ${this.t}`
        };
        const r = await a_fetch(u, {
            method: 'POST',
            headers: h,
            body: JSON.stringify({
                name: 'citibank-demo-project'
            })
        });
        return await r.json();
    }
}
export class StripeHlpr {
    constructor(key) {
        this.key = key;
        this.bu = 'https://api.stripe.com/v1';
    }
    async createPaymentIntent(amt, cur) {
        const h = {
            'Authorization': `Bearer ${this.key}`,
            'Content-Type': 'application/x-www-form-urlencoded'
        };
        const p = `amount=${amt}&currency=${cur}`;
        const r = await a_fetch(`${this.bu}/payment_intents`, {
            method: 'POST',
            headers: h,
            body: p
        });
        return await r.json();
    }
}
