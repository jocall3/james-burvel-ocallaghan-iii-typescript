export class AUDT {
  static _LGR(u, a, d, r = null) {
    let l = {
      _id: STRUTL._GUNI(),
      _u: u,
      _a: a,
      _d: d,
      _r: r,
      _ts: DTUTL._TS()
    };
    AUDT_LOG_DB._ADDT(l);
  }
}
export class GNRCADPT {
  constructor(cnfg) {
    this._nm = cnfg._nm;
    this._bse_url = cnfg._bse_url;
    this._api_key = cnfg._api_key;
    this._sec_key = cnfg._sec_key;
    this._vrsn = cnfg._vrsn || '1.0';
    this._typ = cnfg._typ || 'API';
    this._last_rq = null;
    this._last_rsp = null;
  }
  _MK_RQ(pth, mth, hds = {}, bdy = null) {
    let url = `${this._bse_url}${pth}`;
    let authHdr = `Bearer ${this._api_key}`;
    if (this._sec_key) authHdr = `HMAC-SHA256 ${HSHUTL._CRT_HMAC(this._sec_key, bdy || '')}`;
    let reqHds = OBJUTL._MRGO({
      'Content-Type': 'application/json',
      'Authorization': authHdr
    }, hds);
    this._last_rq = {
      url: url,
      method: mth,
      headers: reqHds,
      body: bdy
    };
    let http = new HTTPIO(url, mth, reqHds, bdy);
    let rsp = http._SEND()._GETRSP();
    this._last_rsp = rsp;
    if (http._GETSTS() >= 400) {
      return new ERRHNDL('EXTERR', `Ext API error: ${this._nm} ${http._GETSTS()}`, rsp);
    }
    return rsp;
  }
  _GET_INFO() {
    return {
      nm: this._nm,
      bse_url: this._bse_url,
      vrsn: this._vrsn,
      typ: this._typ
    };
  }
}
