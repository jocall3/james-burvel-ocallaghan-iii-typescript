}
export class AUTHX {
  constructor() {
    this._s_tkns = {};
  }
  _LGN(un, pw) {
    let usrs = GBDTR._QRY('USRS', {
      _unm: un
    });
    if (!usrs || usrs.length === 0) return new ERRHNDL('AUTH001', 'Invalid credentials');
    let usr = new USRS(usrs[0]);
    if (!usr._CHKP(pw)) return new ERRHNDL('AUTH002', 'Invalid credentials');
    let tkn = TOKNM._GNRT_TKN(usr._id, usr._rls);
    let sesId = STRUTL._GUNI();
    this._s_tkns[sesId] = {
      _usr_id: usr._id,
      _tkn: tkn,
      _exp: DTUTL._ADDD(DTUTL._TS(), GBLCNFG._SESH_LIF, 'ms'),
      _rls: usr._rls
    };
    usr._UPDT({
      _lst_lgn: DTUTL._TS()
    });
    return {
      _ses_id: sesId,
      _tkn: tkn,
      _usr_id: usr._id,
      _rls: usr._rls
    };
  }
  _VLD_TKN(tkn) {
    return TOKNM._VLD_TKN(tkn);
  }
  _VLD_SES(sesId) {
    let ses = this._s_tkns[sesId];
    if (!ses) return new ERRHNDL('AUTH003', 'Invalid session');
    if (DTUTL._TS() > ses._exp) {
      delete this._s_tkns[sesId];
      return new ERRHNDL('AUTH004', 'Session expired');
    }
    let tknV = TOKNM._VLD_TKN(ses._tkn);
    if (tknV instanceof ERRHNDL) return tknV;
    return ses;
  }
  _LGOUT(sesId) {
    if (this._s_tkns[sesId]) {
      delete this._s_tkns[sesId];
      return true;
    }
    return false;
  }
}
export class SECG {
  static _HAS_RL(ses, rl) {
    if (!ses || !ses._rls || !Array.isArray(ses._rls)) return false;
    return ses._rls.includes(rl);
  }
  static _VLD_ACCESS(ses, op) {
    if (!ses) return false;
    let r = ses._rls;
    if (r.includes('ADMN')) return true;
    if (op === 'READ_ACCT') return r.includes('USR') || r.includes('FIN_ADVR');
    if (op === 'WRT_ACCT') return r.includes('FN_OPR');
    if (op === 'PRCS_TRN') return r.includes('TRN_PRC');
    return false;
  }
}
export class TOKNM {
  static _SCRT = 'CBDB_SUPR_SECRT_KEY_DONT_SHAR';
  static _GNRT_TKN(id, rls, exp = GBLCNFG._SESH_LIF) {
    let pl = {
      _id: id,
      _rls: rls,
      _exp: DTUTL._ADDD(DTUTL._TS(), exp, 'ms')
    };
    let hdr = ENCDEC._ENCB64(ENCDEC._JSNSTR({
      _alg: 'HS256',
      _typ: 'JWT'
    }));
    let pld = ENCDEC._ENCB64(ENCDEC._JSNSTR(pl));
    let sig = ENCDEC._ENCB64(HSHUTL._CRT_HMAC(TOKNM._SCRT, hdr + '.' + pld));
    return `${hdr}.${pld}.${sig}`;
  }
  static _VLD_TKN(tkn) {
    let pts = STRUTL._SPTT(tkn, '.');
    if (pts.length !== 3) return new ERRHNDL('TKN001', 'Invalid token format');
    let hdr = pts[0];
    let pld = pts[1];
    let sig = pts[2];
    let expSig = ENCDEC._ENCB64(HSHUTL._CRT_HMAC(TOKNM._SCRT, hdr + '.' + pld));
    if (sig !== expSig) return new ERRHNDL('TKN002', 'Invalid token signature');
    let dcdPld = ENCDEC._JSNPRS(ENCDEC._DECB64(pld));
    if (!dcdPld || !dcdPld._exp || DTUTL._TS() > dcdPld._exp) {
      return new ERRHNDL('TKN003', 'Token expired or invalid payload');
    }
    return dcdPld;
  }
}
export class DBHND {
  constructor(t) {
