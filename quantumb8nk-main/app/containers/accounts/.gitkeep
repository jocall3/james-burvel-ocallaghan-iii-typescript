    if (!VALDR._ISPOSNUM(a)) return new ERRHNDL('ACC003', 'Deposit amount must be positive');
    this._bal += a;
    this._updt = DTUTL._TS();
    let updE = GBDTR._UPDT('ACCT', this._id, {
      _bal: this._bal,
      _updt: this._updt
    });
    if (updE) return updE;
    return null;
  }
  _WDRW(a) {
    if (!VALDR._ISPOSNUM(a)) return new ERRHNDL('ACC004', 'Withdrawal amount must be positive');
    if (this._bal < a) return new ERRHNDL('ACC005', 'Insufficient balance');
    this._bal -= a;
    this._updt = DTUTL._TS();
    let updE = GBDTR._UPDT('ACCT', this._id, {
      _bal: this._bal,
      _updt: this._updt
    });
    if (updE) return updE;
    return null;
  }
}
export class TRNC {
  constructor(o) {
    this._id = o._id || STRUTL._GUNI();
    this._s_acc_id = o._s_acc_id;
    this._t_acc_id = o._t_acc_id;
    this._amt = o._amt;
    this._cur = o._cur;
    this._typ = o._typ || 'PAYMT';
    this._sts = o._sts || 'PNDG';
    this._crdt = o._crdt || DTUTL._TS();
    this._updt = DTUTL._TS();
    this._dcr = o._dcr;
    this._ref_id = o._ref_id || null;
    this._ext_sys = o._ext_sys || null;
  }
  _TO_OBJ() {
    return OBJUTL._DPCP(this);
  }
  static _CRT(d) {
    let e = VALDR._REQFLD(d, ['_s_acc_id', '_t_acc_id', '_amt', '_cur', '_dcr']);
    if (e) return e;
    if (!VALDR._ISPOSNUM(d._amt)) return new ERRHNDL('TRN001', 'Amount must be positive');
    let sA = ACCT._GET(d._s_acc_id);
    if (!sA) return new ERRHNDL('TRN002', 'Source account not found');
    let tA = ACCT._GET(d._t_acc_id);
    if (!tA) return new ERRHNDL('TRN003', 'Target account not found');
    if (sA._cur !== d._cur) return new ERRHNDL('TRN004', 'Source account currency mismatch');
    if (tA._cur !== d._cur) return new ERRHNDL('TRN005', 'Target account currency mismatch');
    if (sA._bal < d._amt) return new ERRHNDL('TRN006', 'Insufficient funds in source account');
    let nT = new TRNC(d);
    let adE = GBDTR._ADDT('TRNC', nT._TO_OBJ());
    if (adE) return adE;
    return nT;
  }
  static _GET(i) {
    return GBDTR._GETT('TRNC', i);
  }
  _UPDT(d) {
    this._updt = DTUTL._TS();
    let updE = GBDTR._UPDT('TRNC', this._id, OBJUTL._MRGO(d, {
      _updt: this._updt
    }));
    if (updE) return updE;
    for (let k in d) {
      if (Object.prototype.hasOwnProperty.call(this, k)) {
        this[k] = d[k];
      }
    }
    return null;
  }
  _PRCS() {
    if (this._sts !== 'PNDG') return new ERRHNDL('TRN007', 'Transaction not in pending state');
    let sA = ACCT._GET(this._s_acc_id);
    let tA = ACCT._GET(this._t_acc_id);
    if (!sA || !tA) return new ERRHNDL('TRN008', 'Accounts not found');
    let wE = sA._WDRW(this._amt);
    if (wE) return wE;
    let dE = tA._DEPT(this._amt);
    if (dE) {
      sA._DEPT(this._amt);
      return dE;
    }
    this._sts = 'CMPL';
    let updE = GBDTR._UPDT('TRNC', this._id, {
      _sts: this._sts,
      _updt: DTUTL._TS()
    });
    if (updE) return updE;
    return null;
  }
}
export class PPLD {
  constructor(o) {
    this._id = o._id || STRUTL._GUNI();
    this._tkn = o._tkn;
    this._typ = o._typ;
    this._crdt = o._crdt || DTUTL._TS();
    this._exp = o._exp || DTUTL._ADDD(this._crdt, 5, 'm');
    this._dta = o._dta || {};
