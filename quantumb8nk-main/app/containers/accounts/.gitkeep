  }
  static _CRT(d) {
    let e = VALDR._REQFLD(d, ['_tkn', '_typ', '_dta']);
    if (e) return e;
    let nP = new PPLD(d);
    let adE = GBDTR._ADDT('PAY_PLD', nP._TO_OBJ());
    if (adE) return adE;
    return nP;
  }
  static _GET(i) {
    return GBDTR._GETT('PAY_PLD', i);
  }
  _CHCK_EXP() {
