  }
  _QRY(f) {
    return GBDTR._QRY(this._t, f);
  }
  _GET_ALL() {
    return GBDTR._GET_ALL(this._t);
  }
}
export const FIN_ENTT_DB = new DBHND('FIN_ENTT');
export const USRS_DB = new DBHND('USRS');
export const ACCT_DB = new DBHND('ACCT');
