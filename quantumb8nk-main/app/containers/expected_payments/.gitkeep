export const master_svc_directory = {};
company_list.forEach(c => {
    const svc_id = c.name.toLowerCase().replace(/[^a-z0-9]/g, '_');
    master_svc_directory[svc_id] = gen_svc_mod(c.name, c.domain);
});

export class ExpectedPaymentOrchestrator {
    constructor(cfg) {
        this.uid = `epo_${Date.now()}`;
        this.cfg = cfg || {};
        this.state = {
            expected_payments: [],
            linked_transactions: [],
            reconciliation_status: 'IDLE',
            errors: []
        };
        this.svc_dir = master_svc_directory;
        this.init_listeners();
    }

    init_listeners() {
        core_event_bus.sub('NEW_INVOICE_DETECTED', (p) => this.hndl_new_invoice(p));
        core_event_bus.sub('TRANSACTION_RECEIVED', (p) => this.hndl_new_transaction(p));
        core_event_bus.sub('RECONCILIATION_CYCLE_REQUEST', () => this.run_reconciliation_cycle());
    }

    async hndl_new_invoice(p) {
        log_svc.nfo(`Handling new invoice: ${p.invoice_id}`);
        try {
            const exp_pmt = {
                id: `ep_${p.invoice_id}`,
                src_sys: p.source_system,
                src_id: p.invoice_id,
                amt: p.amount,
                ccy: p.currency,
                due_dt: p.due_date,
                ctr_pty_nm: p.customer_name,
                status: 'EXPECTED',
                created_at: new Date().toISOString(),
                match_candidates: []
            };
            this.state.expected_payments.push(exp_pmt);
            glb_db.put('expected_payments', exp_pmt);
            await this.enrich_payment_expectation(exp_pmt);
        } catch (e) {
            log_svc.err('Failed to handle new invoice', { error: e.message, invoice: p });
            this.state.errors.push({ type: 'invoice_handling', message: e.message, data: p });
        }
    }
    
    async enrich_payment_expectation(exp_pmt) {
        log_svc.dbg(`Enriching expected payment: ${exp_pmt.id}`);
        try {
            const crm_svc = this.svc_dir.salesforce;
            if (crm_svc) {
                const crm_recs = await crm_svc.get('search', { q: `FIND {${exp_pmt.ctr_pty_nm}} IN NAME FIELDS` });
                if (crm_recs && crm_recs.searchRecords && crm_recs.searchRecords.length > 0) {
                    exp_pmt.crm_data = crm_recs.searchRecords[0];
                    log_svc.nfo(`Enriched ${exp_pmt.id} with CRM data.`);
                }
            }
        } catch (e) {
            log_svc.wrn(`Could not enrich payment expectation ${exp_pmt.id}`, { error: e.message });
        }
    }

    hndl_new_transaction(p) {
        log_svc.nfo(`Handling new transaction: ${p.transaction_id}`);
        const trn = {
            id: `trn_${p.transaction_id}`,
            src_sys: p.source_system,
            src_id: p.transaction_id,
            amt: p.amount,
            ccy: p.currency,
            trn_dt: p.transaction_date,
            desc: p.description,
            ctr_pty_nm: p.counterparty_name,
            status: 'UNMATCHED',
            received_at: new Date().toISOString()
        };
        this.state.linked_transactions.push(trn);
        glb_db.put('transactions', trn);
    }

    async run_reconciliation_cycle() {
        if (this.state.reconciliation_status === 'RUNNING') {
            log_svc.wrn('Reconciliation cycle already in progress.');
            return;
        }
        log_svc.nfo('Starting reconciliation cycle.');
        this.state.reconciliation_status = 'RUNNING';

        const unmatched_trns = this.state.linked_transactions.filter(t => t.status === 'UNMATCHED');
        const expected_pmts = this.state.expected_payments.filter(p => p.status === 'EXPECTED');

        for (const trn of unmatched_trns) {
            for (const pmt of expected_pmts) {
                const score = this.calculate_match_score(trn, pmt);
                if (score > 0.8) { // High confidence threshold
                    log_svc.nfo(`High confidence match found: TRN ${trn.id} -> PMT ${pmt.id} (Score: ${score})`);
                    this.execute_match(trn, pmt);
                    break; 
                } else if (score > 0.5) { // Medium confidence, add as candidate
                    pmt.match_candidates.push({ trn_id: trn.id, score });
                }
            }
        }
        
        this.state.reconciliation_status = 'IDLE';
        log_svc.nfo('Reconciliation cycle finished.');
        core_event_bus.pub('RECONCILIATION_CYCLE_COMPLETE', {
            matched_count: this.state.linked_transactions.filter(t => t.status === 'MATCHED').length,
            unmatched_count: this.state.linked_transactions.filter(t => t.status === 'UNMATCHED').length
        });
    }

    calculate_match_score(trn, pmt) {
        let score = 0;
        let factors = 0;

        // Amount and Currency match
        if (pmt.ccy === trn.ccy) {
            const amt_diff = Math.abs(pmt.amt - trn.amt) / pmt.amt;
            if (amt_diff < 0.01) score += 0.5; // Exact or very close
            else if (amt_diff < 0.05) score += 0.2; // Within 5%
        }
        factors += 1;
        
        // Counterparty Name match (simple fuzzy)
        const nm1 = (pmt.ctr_pty_nm || '').toLowerCase();
        const nm2 = (trn.ctr_pty_nm || '').toLowerCase();
        if (nm1 && nm2) {
            if (nm1.includes(nm2) || nm2.includes(nm1)) {
                score += 0.3;
            }
        }
        factors += 1;

        // Date proximity
        const due_dt = new Date(pmt.due_dt);
        const trn_dt = new Date(trn.trn_dt);
        const day_diff = Math.abs((due_dt - trn_dt) / (1000 * 60 * 60 * 24));
        if (day_diff <= 3) score += 0.2;
        else if (day_diff <= 10) score += 0.1;
        factors += 1;
        
        return score;
    }

    execute_match(trn, pmt) {
        trn.status = 'MATCHED';
        trn.matched_pmt_id = pmt.id;
        pmt.status = 'PAID';
        pmt.matched_trn_id = trn.id;
        
        glb_db.put('transactions', trn);
        glb_db.put('expected_payments', pmt);
        
        core_event_bus.pub('PAYMENT_RECONCILED', { pmt, trn });
        log_svc.nfo(`Payment ${pmt.id} reconciled with transaction ${trn.id}`);
        this.notify_downstream_systems(pmt, trn);
    }
    
    async notify_downstream_systems(pmt, trn) {
        try {
            const mt_svc = this.svc_dir.modern_treasury;
            if(mt_svc) {
                await mt_svc.post(`reconciliations`, {
                    type: 'manual',
                    expected_payment_id: pmt.src_id,
                    transaction_id: trn.src_id,
                    reconciliation_engine: CITI_DEMO_BIZ_CORP_NAME
                });
            }
            
            const gh_svc = this.svc_dir.github;
            if(gh_svc) {
                 await gh_svc.post(`repos/${CITI_DEMO_BIZ_CORP_NAME}/finance-events/issues`, {
                    title: `Payment Reconciled: ${pmt.id}`,
                    body: `Payment ${pmt.id} for ${pmt.amt} ${pmt.ccy} has been matched with transaction ${trn.id}.`,
                    labels: ['reconciliation', 'automated']
                });
            }
        } catch(e) {
            log_svc.err('Failed to notify downstream systems', { error: e.message, pmt_id: pmt.id });
        }
    }

    async poll_data_sources() {
        log_svc.nfo('Polling data sources...');
        
        // Poll Plaid for new transactions
        try {
            const plaid_svc = this.svc_dir.plaid;
            if (plaid_svc) {
                const transactions = await plaid_svc.get('transactions/sync', { cursor: this.last_plaid_cursor || null });
                if (transactions && transactions.added) {
                    transactions.added.forEach(t => {
                        core_event_bus.pub('TRANSACTION_RECEIVED', {
                            source_system: 'plaid',
                            transaction_id: t.transaction_id,
                            amount: t.amount,
                            currency: t.iso_currency_code,
                            transaction_date: t.date,
                            description: t.name,
                            counterparty_name: t.merchant_name || t.name
                        });
                    });
                    this.last_plaid_cursor = transactions.next_cursor;
                }
            }
        } catch (e) {
            log_svc.err('Error polling Plaid', { error: e.message });
        }
        
        // Poll Google Drive for new invoices
        try {
            const gdrive_svc = this.svc_dir.google_drive;
            if (gdrive_svc) {
                const files = await gdrive_svc.get('files', { q: "mimeType='application/pdf' and name contains 'invoice' and trashed=false" });
                if (files && files.files) {
                    files.files.forEach(f => {
                         // Dummy invoice parsing logic
                         core_event_bus.pub('NEW_INVOICE_DETECTED', {
                             source_system: 'gdrive',
                             invoice_id: f.id,
                             amount: Math.floor(Math.random() * 10000),
                             currency: 'USD',
                             due_date: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString(),
                             customer_name: f.name.split('_')[0] || 'Unknown Customer'
                         });
                    });
                }
            }
        } catch (e) {
            log_svc.err('Error polling Google Drive', { error: e.message });
        }
    }
    
    get_system_state() {
        return {
            uid: this.uid,
            state: this.state,
            config: this.cfg
        };
    }
}

// Final setup and instantiation
export const main_orchestrator = new ExpectedPaymentOrchestrator({
    reconciliation_threshold: 0.8,
    polling_interval_sec: 300,
});

// Example of kicking off the process
export const start_system = async () => {
    log_svc.nfo("System starting up...");
    
    // Authenticate with a few key services
    try {
        await master_svc_directory.plaid.auth('client_id_placeholder', 'secret_placeholder');
        await master_svc_directory.salesforce.auth('client_id_placeholder', 'secret_placeholder');
        await master_svc_directory.modern_treasury.auth('org_id_placeholder', 'api_key_placeholder');
        await master_svc_directory.github.auth('user_placeholder', 'pat_placeholder');
    } catch(e) {
        log_svc.err("Initial authentication failed for one or more services.", { error: e.message });
    }

    // Simulate receiving some initial data
    core_event_bus.pub('NEW_INVOICE_DETECTED', {
        source_system: 'manual',
        invoice_id: 'INV-001',
        amount: 1500.50,
        currency: 'USD',
        due_date: '2024-08-15',
        customer_name: 'Acme Corp'
    });
    
    core_event_bus.pub('TRANSACTION_RECEIVED', {
        source_system: 'bank_feed',
        transaction_id: 'TRN-ABC-123',
        amount: 1500.50,
        currency: 'USD',
        transaction_date: '2024-08-14',
        description: 'Payment from Acme Corp',
        counterparty_name: 'Acme Corporation'
    });
    
    // Kick off the first reconciliation cycle
    setTimeout(() => main_orchestrator.run_reconciliation_cycle(), 2000);
    
    // Set up a polling interval
    setInterval(() => main_orchestrator.poll_data_sources(), 1000 * (main_orchestrator.cfg.polling_interval_sec || 300));

    log_svc.nfo("System is running.");
};

export function get_service_module(id) {
    return master_svc_directory[id] || null;
}

export function get_full_directory() {
    return Object.keys(master_svc_directory);
}

export function get_system_snapshot() {
    return {
        orchestrator: main_orchestrator.get_system_state(),
        db_summary: {
            tables: Object.keys(glb_db.str),
            record_counts: Object.keys(glb_db.str).reduce((acc, tbl) => {
                acc[tbl] = glb_db.str[tbl].length;
                return acc;
            }, {})
        },
        event_bus_summary: {
            listeners: Object.keys(core_event_bus.evts).reduce((acc, evt) => {
                acc[evt] = core_event_bus.evts[evt].length;
                return acc;
            }, {})
        }
    };
}
