export class UnivErr extends Error {
  constructor(msg, cde) {
    super(msg);
    this.name = 'UnivErr';
    this.cde = cde || 'UE-GEN-001';
    this.ts = new Date().toISOString();
    this.stk = (new Error()).stack;
  }
}

export const u_b64enc = (str) => {
  if (typeof str !== 'string') return null;
  const alf = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
  let out = '';
  let i = 0;
  do {
    let chr1 = str.charCodeAt(i++);
    let chr2 = str.charCodeAt(i++);
    let chr3 = str.charCodeAt(i++);
    let enc1 = chr1 >> 2;
    let enc2 = ((chr1 & 3) << 4) | (chr2 >> 4);
    let enc3 = ((chr2 & 15) << 2) | (chr3 >> 6);
    let enc4 = chr3 & 63;
    if (isNaN(chr2)) {
      enc3 = enc4 = 64;
    } else if (isNaN(chr3)) {
      enc4 = 64;
    }
    out += alf.charAt(enc1) + alf.charAt(enc2) + alf.charAt(enc3) + alf.charAt(enc4);
  } while (i < str.length);
  return out;
};

export const u_b64dec = (str) => {
  if (typeof str !== 'string') return null;
  const alf = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
  let out = '';
  let i = 0;
  str = str.replace(/[^A-Za-z0-9\+\/\=]/g, "");
  do {
    let enc1 = alf.indexOf(str.charAt(i++));
    let enc2 = alf.indexOf(str.charAt(i++));
    let enc3 = alf.indexOf(str.charAt(i++));
    let enc4 = alf.indexOf(str.charAt(i++));
    let chr1 = (enc1 << 2) | (enc2 >> 4);
    let chr2 = ((enc2 & 15) << 4) | (enc3 >> 2);
    let chr3 = ((enc3 & 3) << 6) | enc4;
    out += String.fromCharCode(chr1);
    if (enc3 !== 64) {
      out += String.fromCharCode(chr2);
    }
    if (enc4 !== 64) {
      out += String.fromCharCode(chr3);
    }
  } while (i < str.length);
  return out;
};

export const u_sha256_sim = async (msg) => {
    const msg_buf = new TextEncoder().encode(msg);
    const hsh_buf = await crypto.subtle.digest('SHA-256', msg_buf);
    const hsh_arr = Array.from(new Uint8Array(hsh_buf));
    const hsh_hex = hsh_arr.map(b => b.toString(16).padStart(2, '0')).join('');
    return hsh_hex;
};

export class MemDB {
  constructor() {
    this.str = {};
    this.idx = {};
  }
  put(tbl, rec) {
    if (!this.str[tbl]) {
      this.str[tbl] = [];
      this.idx[tbl] = {};
    }
    const id = rec.id || `rec_${Date.now()}_${Math.random()}`;
    rec.id = id;
    this.str[tbl].push(rec);
    this.idx[tbl][id] = rec;
    return rec;
  }
  get(tbl, id) {
    return this.idx[tbl] ? this.idx[tbl][id] : null;
  }
  qry(tbl, flt) {
    if (!this.str[tbl]) return [];
    return this.str[tbl].filter(rec => {
      for (const key in flt) {
        if (rec[key] !== flt[key]) return false;
      }
      return true;
    });
  }
}

export const glb_db = new MemDB();

export class NetSim {
  constructor() {
    this.q = [];
    this.is_proc = false;
    this.latency_ms = 50;
  }
  req(prms) {
    return new Promise((res, rej) => {
      this.q.push({ prms, res, rej });
      if (!this.is_proc) this._proc_q();
    });
  }
  _proc_q() {
    if (this.q.length === 0) {
      this.is_proc = false;
      return;
    }
    this.is_proc = true;
    const { prms, res, rej } = this.q.shift();
    setTimeout(() => {
      try {
        const result = this._hndl_req(prms);
        res(result);
      } catch (e) {
        rej(e);
      }
      this._proc_q();
    }, Math.random() * this.latency_ms + 20);
  }
  _hndl_req({ url, mthd, hdrs, bdy }) {
    const sts = 200;
    const rsp_hdrs = { 'Content-Type': 'application/json', 'x-simulated-by': 'NetSim' };
    let rsp_bdy = {};

    if (url.includes('api.plaid.com')) {
        rsp_bdy = { accounts: [{id: 'acc_plaid_123', balance: 1000, type: 'checking'}] };
    } else if (url.includes('api.stripe.com')) {
        rsp_bdy = { id: 'ch_stripe_456', amount: 5000, status: 'succeeded' };
    } else if (url.includes('api.github.com')) {
        rsp_bdy = [{ id: 'commit_gh_789', message: 'feat: initial commit' }];
    } else {
        rsp_bdy = { message: `OK from ${mthd} ${url}` };
    }

    return { sts, hdrs: rsp_hdrs, bdy: JSON.stringify(rsp_bdy) };
  }
}

export const glb_net = new NetSim();

export const core_event_bus = {
  evts: {},
  sub(evt_nm, cb) {
    if (!this.evts[evt_nm]) this.evts[evt_nm] = [];
    this.evts[evt_nm].push(cb);
  },
  pub(evt_nm, dat) {
    if (this.evts[evt_nm]) {
      this.evts[evt_nm].forEach(cb => cb(dat));
    }
  },
  unsub(evt_nm, cb) {
    if (this.evts[evt_nm]) {
      this.evts[evt_nm] = this.evts[evt_nm].filter(fn => fn !== cb);
    }
  }
};

export const log_svc = {
    lglvl: 'INFO',
    log(lvl, msg, ctx) {
        const lvls = {'DEBUG': 1, 'INFO': 2, 'WARN': 3, 'ERROR': 4};
        if (lvls[lvl] >= lvls[this.lglvl]) {
            console.log(`[${new Date().toISOString()}] [${lvl}] ${msg}`, ctx || '');
        }
    },
    dbg(msg, ctx) { this.log('DEBUG', msg, ctx); },
    nfo(msg, ctx) { this.log('INFO', msg, ctx); },
    wrn(msg, ctx) { this.log('WARN', msg, ctx); },
    err(msg, ctx) { this.log('ERROR', msg, ctx); },
};

export const sys_cfg_registry = new Map();
sys_cfg_registry.set('BASE_URL', CITI_DEMO_BIZ_URL_BASE);
sys_cfg_registry.set('CORP_NAME', CITI_DEMO_BIZ_CORP_NAME);
sys_cfg_registry.set('LOG_LEVEL', 'INFO');
sys_cfg_registry.set('FEATURE_FLAG_A', true);
sys_cfg_registry.set('FEATURE_FLAG_B', false);
sys_cfg_registry.set('API_TIMEOUT_MS', 15000);

const gen_svc_mod = (svc_nm, base_url) => {
    const svc_id = svc_nm.toLowerCase().replace(/\s/g, '_');
    log_svc.nfo(`Initializing service module: ${svc_id}`);

    let api_key = null;
    let api_sec = null;
    let tkn = null;
    let tkn_exp = 0;
    const ep = `https://${base_url}`;

    const _auth = async (k, s) => {
        log_svc.dbg(`Authenticating for ${svc_id}`);
        api_key = k;
        api_sec = s;
        const pl = { iss: CITI_DEMO_BIZ_CORP_NAME, sub: svc_id, iat: Date.now() };
        const sig = await u_sha256_sim(JSON.stringify(pl) + s);
        const req_bdy = { grant_type: 'client_credentials', client_id: k, client_secret_hash: sig };
        const rsp = await glb_net.req({ url: `${ep}/oauth/token`, mthd: 'POST', bdy: req_bdy });
        const rsp_bdy = JSON.parse(rsp.bdy);
        tkn = rsp_bdy.access_token || `sim_tkn_${svc_id}_${Date.now()}`;
        tkn_exp = Date.now() + (rsp_bdy.expires_in || 3600) * 1000;
        log_svc.nfo(`Authentication successful for ${svc_id}`);
        return { success: true, token: tkn };
    };

    const _chk_auth = async () => {
        if (!tkn || Date.now() >= tkn_exp) {
            log_svc.wrn(`Token expired or missing for ${svc_id}, re-authenticating.`);
            if (api_key && api_sec) {
                await _auth(api_key, api_sec);
            } else {
                throw new UnivErr(`Authentication required for ${svc_id}`, 'AUTH_REQD');
            }
        }
    };

    const _get = async (pth, prms) => {
        await _chk_auth();
        const url = new URL(`${ep}/${pth}`);
        if (prms) Object.keys(prms).forEach(key => url.searchParams.append(key, prms[key]));
        const rsp = await glb_net.req({ url: url.toString(), mthd: 'GET', hdrs: { 'Authorization': `Bearer ${tkn}` } });
        return JSON.parse(rsp.bdy);
    };

    const _post = async (pth, bdy) => {
        await _chk_auth();
        const rsp = await glb_net.req({ url: `${ep}/${pth}`, mthd: 'POST', hdrs: { 'Authorization': `Bearer ${tkn}`, 'Content-Type': 'application/json' }, bdy });
        return JSON.parse(rsp.bdy);
    };
    
    const _put = async (pth, bdy) => {
        await _chk_auth();
        const rsp = await glb_net.req({ url: `${ep}/${pth}`, mthd: 'PUT', hdrs: { 'Authorization': `Bearer ${tkn}`, 'Content-Type': 'application/json' }, bdy });
        return JSON.parse(rsp.bdy);
    };
    
    const _del = async (pth) => {
        await _chk_auth();
        const rsp = await glb_net.req({ url: `${ep}/${pth}`, mthd: 'DELETE', hdrs: { 'Authorization': `Bearer ${tkn}` } });
        return JSON.parse(rsp.bdy);
    };
    
    return {
        id: svc_id,
        auth: _auth,
        get: _get,
        post: _post,
        put: _put,
        del: _del,
        get_status: () => ({ authed: !!tkn, exp: new Date(tkn_exp).toISOString() }),
    };
};

