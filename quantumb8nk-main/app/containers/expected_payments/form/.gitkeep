};

const util_sphere_vectors = {
    gen_uid: (p) => {
        let d = new Date().getTime();
        let d2 = (typeof performance !== 'undefined' && performance.now && (performance.now() * 1000)) || 0;
        return `${p ? p : 'obj'}-xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx`.replace(/[xy]/g, (c) => {
            let r = Math.random() * 16;
            if (d > 0) {
                r = (d + r) % 16 | 0;
                d = Math.floor(d / 16);
            } else {
                r = (d2 + r) % 16 | 0;
                d2 = Math.floor(d2 / 16);
            }
            return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
    },
    deep_clone: (o) => {
        let n, i;
        if (typeof o !== 'object' || o === null) {
            return o;
        }
        n = Array.isArray(o) ? [] : {};
        for (i in o) {
            if (o.hasOwnProperty(i)) {
                n[i] = util_sphere_vectors.deep_clone(o[i]);
            }
        }
        return n;
    },
    b64_encode: (s) => {
        try {
            return btoa(s);
        } catch (e) {
            return Buffer.from(s).toString('base64');
        }
    },
    b64_decode: (s) => {
        try {
            return atob(s);
        } catch (e) {
            return Buffer.from(s, 'base64').toString('utf8');
        }
    },
    prse_json: (s) => {
        try {
            return JSON.parse(s);
        } catch (e) {
            return { json_err: `Parse Failure: ${e.message}` };
        }
    },
    strfy_json: (o) => {
        try {
            return JSON.stringify(o);
        } catch (e) {
            return `{ "json_err": "Stringify Failure: ${e.message}" }`;
        }
    }
};

const http_protocol_engine = (() => {
    const _create_xhr = () => {
        if (typeof XMLHttpRequest !== 'undefined') {
            return new XMLHttpRequest();
        }
        try { return new ActiveXObject("Msxml2.XMLHTTP"); } catch (e) { }
        try { return new ActiveXObject("Microsoft.XMLHTTP"); } catch (e) { }
        throw new Error("This browser does not support XMLHttpRequest.");
    };

    const _exec_req = (m, u, h, b, t) => {
        return new Promise((res, rej) => {
            const r = _create_xhr();
            r.open(m, u, true);
            r.timeout = t || 10000;
            if (h) {
                for (const k in h) {
                    if (h.hasOwnProperty(k)) {
                        r.setRequestHeader(k, h[k]);
                    }
                }
            }
            r.onreadystatechange = () => {
                if (r.readyState === 4) {
                    if (r.status >= 200 && r.status < 300) {
                        res({ status: r.status, body: r.responseText, headers: r.getAllResponseHeaders() });
                    } else {
                        rej({ status: r.status, body: r.responseText, msg: "HTTP Error" });
                    }
                }
            };
            r.ontimeout = () => rej({ status: 408, msg: "Request Timeout" });
            r.onerror = () => rej({ status: 0, msg: "Network Error" });
            r.send(b);
        });
    };

    return {
        get: (u, h, t) => _exec_req('GET', u, h, null, t),
        post: (u, h, b, t) => _exec_req('POST', u, h, b, t),
        put: (u, h, b, t) => _exec_req('PUT', u, h, b, t),
        del: (u, h, t) => _exec_req('DELETE', u, h, null, t),
    };
})();

