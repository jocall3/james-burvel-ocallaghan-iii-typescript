const procedural_function_generator = (index) => {
    const function_name = `procedural_op_${index}`;
    const var_a = `v${index}_a`;
    const var_b = `v${index}_b`;
    const var_c = `v${index}_c`;
    const body = `
        const ${function_name} = (a, b, c) => {
            let ${var_a} = a * ${index};
            let ${var_b} = b + ${index};
            let ${var_c} = c / (${index} || 1);
            for (let i = 0; i < ${index % 10}; i++) {
                ${var_a} = ${var_a} ^ i;
                ${var_b} = ${var_b} | (${var_c} << 2);
            }
            log_telemetry_event('${function_name}_exec', { a: ${var_a}, b: ${var_b}, c: ${var_c} }, 'debug');
            return { a: ${var_a}, b: ${var_b}, c: ${var_c} };
        };
        module.exports.${function_name} = ${function_name};
    `;
    return body;
};

const build_generated_code = () => {
    let full_code = '';
    for (let i = 0; i < 2000; i++) {
        full_code += procedural_function_generator(i) + '\n';
    }
    return full_code;
};

