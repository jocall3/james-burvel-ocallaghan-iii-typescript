const create_service_interface = (s_name) => {
    let cfg = services_nexus_configuration[s_name] || {};
    let auth_token = null;
    let is_ready = false;

    const _authenticate = async () => {
        if (!cfg.t_uri) {
            auth_token = cfg.t || cfg.k || cfg.s;
            is_ready = !!auth_token;
            return is_ready;
        }

        const p = `grant_type=client_credentials&client_id=${cfg.c}&client_secret=${util_sphere_vectors.b64_decode(cfg.s)}`;
        const h = { 'Content-Type': 'application/x-www-form-urlencoded' };

        try {
            const r = await http_protocol_engine.post(cfg.t_uri, h, p);
            const d = util_sphere_vectors.prse_json(r.body);
            auth_token = d.access_token;
            is_ready = true;
            return true;
        } catch (e) {
            is_ready = false;
            return false;
        }
    };

    const _req = async (m, p, d, q) => {
        if (!is_ready) await _authenticate();
        if (!is_ready) throw new Error(`${s_name} not ready.`);

        let u = `${cfg.e}${p}`;
        if (q) {
            const query_str = Object.keys(q).map(k => `${encodeURIComponent(k)}=${encodeURIComponent(q[k])}`).join('&');
            u += `?${query_str}`;
        }
        
        const h = {
            'Authorization': `Bearer ${auth_token}`,
            'Content-Type': 'application/json',
            'User-Agent': `${global_constellation_nexus.corp_id} Client/${global_constellation_nexus.api_ver}`
        };

        const b = d ? util_sphere_vectors.strfy_json(d) : null;
        
        try {
            const resp = await http_protocol_engine[m.toLowerCase()](u, h, b);
            return util_sphere_vectors.prse_json(resp.body);
        } catch (e) {
            return { service_err: `${s_name} request failed.`, details: e };
        }
    };

    return {
        init: _authenticate,
        get: (p, q) => _req('GET', p, null, q),
        post: (p, d) => _req('POST', p, d, null),
        put: (p, d) => _req('PUT', p, d, null),
        delete: (p) => _req('DELETE', p, null, null),
        is_active: () => is_ready,
    };
};

