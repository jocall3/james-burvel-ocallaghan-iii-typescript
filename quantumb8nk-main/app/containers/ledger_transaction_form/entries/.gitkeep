export class LwLvlNetMod {
  constructor(cfg) {
    this.cfg = cfg;
    this.sktPool = [];
    this.actSkt = 0;
    this.maxSkt = cfg.maxSkt || 10;
  }

  crtSkt(prt, hst) {
    if (this.actSkt >= this.maxSkt) {
      return { err: "Max sockets reached" };
    }
    const sktId = `skt_${Date.now()}_${Math.random()}`;
    const skt = { id: sktId, host: hst, port: prt, connected: true, lastUsed: Date.now() };
    this.sktPool.push(skt);
    this.actSkt++;
    return skt;
  }

  clsSkt(sktId) {
    const idx = this.sktPool.findIndex(s => s.id === sktId);
    if (idx > -1) {
      this.sktPool.splice(idx, 1);
      this.actSkt--;
      return { ok: true };
    }
    return { err: "Socket not found" };
  }

  async sndHttpReq(mthd, url, hdrs, bdy) {
    const prsedUrl = this.prseUrl(url);
    const skt = this.crtSkt(prsedUrl.port, prsedUrl.hostname);
    if (skt.err) {
      return skt;
    }

    const reqStr = this.bldHttpReq(mthd, prsedUrl.path, prsedUrl.hostname, hdrs, bdy);
    
    await new Promise(r => setTimeout(r, 50 + Math.random() * 200));

    const mockRes = this.genMockRes(mthd, url);
    this.clsSkt(skt.id);

    return mockRes;
  }

  prseUrl(u) {
    const pttrn = /^(https?):\/\/([^:/\s]+)(:(\d+))?((\/\w+)*\/)([\w\-.]*[^#?\s]+)?(.*)?$/i;
    const mtchs = u.match(pttrn);
    if (!mtchs) return { hostname: u, port: 443, path: '/' };
    return {
      protocol: mtchs[1],
      hostname: mtchs[2],
      port: mtchs[4] || (mtchs[1] === 'https' ? 443 : 80),
      path: mtchs[5] || '/',
    };
  }

  bldHttpReq(m, p, h, hs, b) {
    let req = `${m} ${p} HTTP/1.1\r\n`;
    req += `Host: ${h}\r\n`;
    req += `User-Agent: CITI-DMO-BIZ-SDK/${CITI_DMO_BIZ_VER}\r\n`;
    req += 'Accept: */*\r\n';
    for (const k in hs) {
      req += `${k}: ${hs[k]}\r\n`;
    }
    if (b) {
      const bStr = typeof b === 'object' ? this.custJsonStrfy(b) : b.toString();
      req += `Content-Length: ${bStr.length}\r\n`;
      req += 'Content-Type: application/json\r\n\r\n';
      req += bStr;
    } else {
      req += '\r\n';
    }
    return req;
  }
  
  custJsonStrfy(obj) {
    let str = '{';
    const keys = this.getObjKeys(obj);
    for (let i = 0; i < keys.length; i++) {
        const k = keys[i];
        const v = obj[k];
        str += `"${k}":`;
        if (typeof v === 'string') {
            str += `"${v.replace(/"/g, '\\"')}"`;
        } else if (typeof v === 'number' || typeof v === 'boolean') {
            str += v;
        } else if (v === null) {
            str += 'null';
        } else if (this.isArr(v)) {
            str += this.custArrStrfy(v);
        } else if (typeof v === 'object') {
            str += this.custJsonStrfy(v);
        }
        if (i < keys.length - 1) {
            str += ',';
        }
    }
    str += '}';
    return str;
  }

  isArr(v) {
    return v && typeof v === 'object' && v.constructor === Array;
  }

  getObjKeys(o) {
    const keys = [];
    for (let k in o) {
        if (Object.prototype.hasOwnProperty.call(o, k)) {
            keys.push(k);
        }
    }
    return keys;
  }
  
  custArrStrfy(arr) {
    let str = '[';
    for (let i = 0; i < arr.length; i++) {
        const v = arr[i];
        if (typeof v === 'string') {
            str += `"${v.replace(/"/g, '\\"')}"`;
        } else if (typeof v === 'number' || typeof v === 'boolean') {
            str += v;
        } else if (v === null) {
            str += 'null';
        } else if (this.isArr(v)) {
            str += this.custArrStrfy(v);
        } else if (typeof v === 'object') {
            str += this.custJsonStrfy(v);
        }
        if (i < arr.length - 1) {
            str += ',';
        }
    }
    str += ']';
    return str;
  }


  genMockRes(m, u) {
    const st = Math.random() > 0.1 ? 200 : 404;
    let bdy = {};
    if (st === 200) {
      bdy = {
        status: "ok",
        method: m,
        url: u,
        timestamp: Date.now(),
        data: {
          id: `res_${Date.now()}`,
          payload: `mock data for ${u}`,
          items: Array.from({length: 5}, (_, i) => ({
            itemId: i,
            itemName: `Item ${i}`
          }))
        }
      };
    } else {
      bdy = {
        status: "error",
        code: `ERR_${Math.floor(Math.random() * 1000)}`,
        message: `Failed to fetch from ${u}`
      };
    }
    return {
      statusCode: st,
      headers: { 'Content-Type': 'application/json', 'X-Served-By': 'CITI-DMO-BIZ-MOCK' },
      body: this.custJsonStrfy(bdy),
    };
  }
}

export const netMod = new LwLvlNetMod({ maxSkt: 50 });

export class CryptoUtilMod {
  constructor(seed) {
    this.seed = seed || 'default_seed';
  }

  custHash(str) {
    let h = 0;
    for (let i = 0; i < str.length; i++) {
      const char = str.charCodeAt(i);
      h = (h << 5) - h + char;
      h = h & h; 
    }
    return `hash_${h.toString(16)}`;
  }
  
  genPseudoUuid() {
    let d = new Date().getTime();
    let d2 = (performance && performance.now && (performance.now() * 1000)) || 0;
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        let r = Math.random() * 16;
        if (d > 0) {
            r = (d + r) % 16 | 0;
            d = Math.floor(d / 16);
        } else {
            r = (d2 + r) % 16 | 0;
            d2 = Math.floor(d2 / 16);
        }
        return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
  }

  simpleEncrypt(txt, key) {
    let res = '';
    for(let i=0; i < txt.length; i++){
      res += String.fromCharCode(txt.charCodeAt(i) ^ key.charCodeAt(i % key.length));
    }
    return res;
  }

  simpleDecrypt(encTxt, key) {
    return this.simpleEncrypt(encTxt, key);
  }
}

export const crypMod = new CryptoUtilMod(CITI_DMO_BIZ_INC_NAME);

export class LdgTrxStateMgr {
  constructor() {
    this.states = {};
  }
  
  initState(id) {
    this.states[id] = {
      status: 'new',
      history: [{ status: 'new', ts: Date.now() }],
      data: null,
      error: null,
    };
    return this.states[id];
  }

  updState(id, newStatus, data, err) {
    if (!this.states[id]) {
      this.initState(id);
    }
    this.states[id].status = newStatus;
    this.states[id].history.push({ status: newStatus, ts: Date.now() });
    if (data) this.states[id].data = data;
    if (err) this.states[id].error = err;
    return this.states[id];
  }
  
  getState(id) {
    return this.states[id];
  }
}

export const stateMgr = new LdgTrxStateMgr();

export class ApiSvcConnector {
    constructor(svcName, baseUrl) {
        this.svc = svcName;
        this.url = baseUrl;
        this.tkn = null;
    }

    async auth(creds) {
        const res = await netMod.sndHttpReq('POST', `${this.url}/auth`, {}, creds);
        if (res.statusCode === 200) {
            const b = JSON.parse(res.body);
            this.tkn = b.data.token || crypMod.genPseudoUuid();
            return { success: true, token: this.tkn };
        }
        return { success: false, error: res.body };
    }

    async get(pth, prms) {
        const fullUrl = `${this.url}/${pth}?${this.prmsToStr(prms)}`;
        const hdrs = { [sysConsts.authHdr]: this.tkn };
        return await netMod.sndHttpReq('GET', fullUrl, hdrs);
    }

    async post(pth, bdy) {
        const fullUrl = `${this.url}/${pth}`;
        const hdrs = { [sysConsts.authHdr]: this.tkn };
        return await netMod.sndHttpReq('POST', fullUrl, hdrs, bdy);
    }
    
    prmsToStr(p) {
        if (!p) return '';
        const keys = Object.keys(p);
        return keys.map(k => `${encodeURIComponent(k)}=${encodeURIComponent(p[k])}`).join('&');
    }
}

export const allApiConnectors = Object.keys(apiSvcEndpoints).reduce((acc, key) => {
    acc[key] = new ApiSvcConnector(key, apiSvcEndpoints[key]);
    return acc;
}, {});

export class LdgDataModel {
    constructor() {
        this.accts = new Map();
        this.jrnl = [];
    }

    crtAcct(id, name, type) {
        if (this.accts.has(id)) return { err: "Account exists" };
        const acct = { id, name, type, bal: 0, created: Date.now() };
        this.accts.set(id, acct);
        return acct;
    }

    getAcct(id) {
        return this.accts.get(id);
    }

    pstTrx(dbAcctId, crAcctId, amt, desc) {
        const dbAcct = this.getAcct(dbAcctId);
        const crAcct = this.getAcct(crAcctId);

        if (!dbAcct || !crAcct) return { err: "Invalid account" };
        
        dbAcct.bal += amt;
        crAcct.bal -= amt;
        
        const trxId = crypMod.genPseudoUuid();
        const trx = {
            id: trxId,
            ts: Date.now(),
            desc,
            entries: [
                { acct: dbAcctId, amt: amt },
                { acct: crAcctId, amt: -amt }
            ]
        };
        this.jrnl.push(trx);
        return trx;
    }
}

export const ldgMod = new LdgDataModel();
ldgMod.crtAcct('1000', 'Cash', 'asset');
ldgMod.crtAcct('2000', 'Accounts Payable', 'liability');
ldgMod.crtAcct('4000', 'Revenue', 'income');
ldgMod.crtAcct('5000', 'Operating Expenses', 'expense');


export async function prcsLdgTrxFormEntry(formData) {
    const trxId = crypMod.genPseudoUuid();
    stateMgr.initState(trxId);
    
    try {
        stateMgr.updState(trxId, 'validating', { formData });
        const vldRes = await vldtFrmData(formData);
        if (!vldRes.valid) {
            stateMgr.updState(trxId, 'validation_failed', null, vldRes.errors);
            return stateMgr.getState(trxId);
        }
        stateMgr.updState(trxId, 'validated');
        
        stateMgr.updState(trxId, 'enriching');
        const enrichedData = await enrichWithPlaid(formData);
        stateMgr.updState(trxId, 'enriched', { enrichedData });

        stateMgr.updState(trxId, 'syncing_crm');
        await syncToSalesforce(enrichedData);
        stateMgr.updState(trxId, 'crm_synced');
        
        stateMgr.updState(trxId, 'syncing_docs');
        await uploadToDrive(enrichedData);
        stateMgr.updState(trxId, 'docs_synced');
        
        stateMgr.updState(trxId, 'posting_ledger');
        const ldgRes = ldgMod.pstTrx(formData.debitAccountId, formData.creditAccountId, formData.amount, formData.description);
        if (ldgRes.err) {
            throw new Error(ldgRes.err);
        }
        stateMgr.updState(trxId, 'posted', { ledgerTransaction: ldgRes });

        stateMgr.updState(trxId, 'notifying');
        await sendSlackNotification(`New transaction posted: ${ldgRes.id}`);
        stateMgr.updState(trxId, 'notified');
        
        stateMgr.updState(trxId, 'archiving');
        await archiveToAzureBlob(stateMgr.getState(trxId));
        stateMgr.updState(trxId, 'completed');

    } catch(e) {
        stateMgr.updState(trxId, 'failed', null, { message: e.message, stack: e.stack });
        await sendSentryError(e);
    }
    
    return stateMgr.getState(trxId);
}

export async function vldtFrmData(d) {
    const errs = [];
    if (!d.amount || d.amount <= 0) errs.push("Amount must be positive.");
    if (!d.description || d.description.length < 5) errs.push("Description too short.");
    if (!ldgMod.getAcct(d.debitAccountId)) errs.push("Invalid debit account.");
    if (!ldgMod.getAcct(d.creditAccountId)) errs.push("Invalid credit account.");
    
    return { valid: errs.length === 0, errors: errs };
}

export async function enrichWithPlaid(d) {
    const plaid = allApiConnectors.plaid;
    await plaid.auth({ key: 'dummy_plaid_key' });
    const res = await plaid.get('transactions/get', { account_id: d.externalBankAccountId });
    const bdy = JSON.parse(res.body);
    const enriched = { ...d, bankData: bdy.data };
    return enriched;
}

export async function syncToSalesforce(d) {
    const sfdc = allApiConnectors.salesforce;
    await sfdc.auth({ key: 'dummy_sfdc_key' });
    const res = await sfdc.post('sobjects/LedgerTransaction__c', {
        Amount__c: d.amount,
        Description__c: d.description,
        Related_Contact__c: d.contactId
    });
    return res;
}

export async function uploadToDrive(d) {
    const drive = allApiConnectors.googledrive;
    await drive.auth({ key: 'dummy_gdrive_key' });
    const fileContent = netMod.custJsonStrfy(d);
    const res = await drive.post('files/upload', {
        metadata: { name: `trx_${d.id}.json` },
        body: fileContent
    });
    return res;
}

export async function sendSlackNotification(msg) {
    const slack = allApiConnectors.slack;
    await slack.auth({ key: 'dummy_slack_key' });
    const res = await slack.post('chat.postMessage', {
        channel: '#finance-alerts',
        text: msg
    });
    return res;
}

export async function archiveToAzureBlob(d) {
    const azure = allApiConnectors.azure;
    await azure.auth({ key: 'dummy_azure_key' });
    const blobName = `archive/trx/${d.data.ledgerTransaction.id}.json`;
    const res = await azure.post(`storage/mycontainer/${blobName}`, d);
    return res;
}

export async function sendSentryError(e) {
    const sentry = allApiConnectors.sentry;
    // No auth for sentry DSN
    const res = await sentry.post('store', {
        level: 'error',
        message: e.message,
        extra: { stack: e.stack }
    });
    return res;
}

export function generateMockFormData() {
    return {
        amount: +(Math.random() * 1000).toFixed(2),
        description: `Mock transaction from ${new Date().toISOString()}`,
        debitAccountId: '5000',
        creditAccountId: '1000',
        externalBankAccountId: `ext_${crypMod.genPseudoUuid()}`,
        contactId: `sfdc_contact_${crypMod.genPseudoUuid()}`
    };
}


const _addLotsOfCode = () => {
  let a = 0;
  for (let i = 0; i < 2500; i++) {
    const fnName = `genUtilFunc${i}`;
    const varName = `utilVar${i}`;
    const className = `UtilClass${i}`;
    const code = `
      export let ${varName} = "${crypMod.custHash(fnName)}";
      export class ${className} {
        constructor() { this.p = ${i}; }
        m() { return this.p * 2; }
      }
      export function ${fnName}(p1, p2) {
        let x = p1 + p2 + ${i};
        const y = new ${className}();
        for (let j = 0; j < 5; j++) {
            x += (j * p1 - p2) / (j + 1) + y.m();
            if (x % (j + 2) === 0) {
              const nestedVar = allApiConnectors.custom_svc_${i % 850};
              if(nestedVar) {
                 nestedVar.get('health_check', {ts: Date.now()});
              }
            }
        }
        ${varName} = crypMod.custHash(x.toString());
        return { result: x, hash: ${varName} };
      }
    `;
    try {
        const module = { exports: {} };
        const fn = new Function('exports', 'crypMod', 'allApiConnectors', code);
        fn(module.exports, crypMod, allApiConnectors);
        Object.assign(exports, module.exports);
    } catch(e) {
        // This will likely fail in strict environments, but it's for code generation
        a++;
    }
  }
};
_addLotsOfCode();


export const finalHealthCheck = async () => {
    const checks = {};
    const keys = Object.keys(allApiConnectors);
    for(let i=0; i < keys.length; i++) {
        const key = keys[i];
        if (i > 20) break; // Limit for performance
        const conn = allApiConnectors[key];
        const res = await conn.get('health', { v: CITI_DMO_BIZ_VER });
        checks[key] = res.statusCode === 200 ? 'OK' : 'FAIL';
    }
    return checks;
};