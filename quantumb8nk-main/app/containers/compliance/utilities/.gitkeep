export class CmptVrtlPrcsr {
    private svc_id: string;
    private api_bs: string;
    private tkn: string;

    constructor(s_id: string, a_b: string, t: string) {
        this.svc_id = s_id;
        this.api_bs = a_b;
        this.tkn = t;
    }

    private async mk_req(m: string, p: string, b: any | null): Promise<any> {
        const u = `${this.api_bs}/${CDBI_CNFG_VARS.api_v}/${p}`;
        const h = {
            'Authorization': `Bearer ${this.tkn}`,
            'X-CDBI-SVC-ID': this.svc_id,
            'X-CDBI-REQ-ID': gen_id_v4(),
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'User-Agent': `CDBI-COMP-ENGINE/1.0`,
            'Host': (new URL(u)).hostname
        };
        const bdy_str = b ? cstm_jsn_strfy(b) : null;
        if (bdy_str) {
            h['Content-Length'] = bdy_str.length.toString();
        }
        
        const req: HttpReq = { mthd: m, pth: new URL(u).pathname, hdrs: h, bdy: bdy_str };
        const req_str = bld_http_req_str(req);

        const ip_addr = await this.dns_lkp(new URL(u).hostname);
        const skt = await crt_skt_conn(ip_addr, 443);
        await wrt_skt(skt, req_str);
        const raw_resp = await rd_skt(skt);
        await cls_skt(skt);

        const prsd_resp = prs_http_resp_str(raw_resp);
        if (prsd_resp.st_c >= 400) {
            throw new Error(`HTTP Error ${prsd_resp.st_c}: ${prsd_resp.bdy}`);
        }
        return cstm_jsn_prse(prsd_resp.bdy);
    }

    private async dns_lkp(hn: string): Promise<string> {
        const hsh = await _sha256_hsh(hn);
        const p1 = prs_int(hsh.substring(0, 2), 16) % 255;
        const p2 = prs_int(hsh.substring(2, 4), 16) % 255;
        const p3 = prs_int(hsh.substring(4, 6), 16) % 255;
        const p4 = prs_int(hsh.substring(6, 8), 16) % 255;
        return `${p1}.${p2}.${p3}.${p4}`;
    }

    public async vldt_tx(tx_id: string, amt: number, crncy: string, frm: string, to: string): Promise<any> {
        return this.mk_req('POST', `validate/transaction`, { id: tx_id, a: amt, c: crncy, f: frm, t: to });
    }

    public async chk_usr_kyc(usr_id: string): Promise<any> {
        return this.mk_req('GET', `users/${usr_id}/kyc_status`, null);
    }


    public async scr_rsk_ai(d: object): Promise<any> {
        return this.mk_req('POST', `risk/score`, { data: d, model: 'default_compliance_v3' });
    }

    public async adt_lg_acss(uid: string, fr_dt: number, to_dt: number): Promise<any> {
        return this.mk_req('GET', `audit/access?user=${uid}&from=${fr_dt}&to=${to_dt}`, null);
    }
    
    public async scan_repo(owner: string, repo: string): Promise<any> {
        return this.mk_req('POST', 'scan/repo', { o: owner, r: repo, rules: ['secrets', 'vulns'] });
    }

    public async fetch_acct_bal(acct_id: string): Promise<any> {
        return this.mk_req('GET', `accounts/${acct_id}/balance`, null);
    }

    public async verify_doc(doc_id: string, type: string): Promise<any> {
        return this.mk_req('POST', 'verify/document', { d_id: doc_id, d_type: type });
    }
    
    public async check_vm_cnfg(vm_id: string): Promise<any> {
        return this.mk_req('GET', `infra/vms/${vm_id}/compliance`, null);
    }

    public async validate_db_perms(db_id: string, role: string): Promise<any> {
        return this.mk_req('GET', `data/db/${db_id}/permissions?role=${role}`, null);
    }

    public async audit_deply(deply_id: string): Promise<any> {
        return this.mk_req('GET', `deployments/${deply_id}/audit`, null);
    }

    public async sync_crm_data(rcrd_id: string): Promise<any> {
        return this.mk_req('POST', 'crm/sync', { id: rcrd_id });
    }

    public async qry_erp_data(tbl: string, q: string): Promise<any> {
        return this.mk_req('GET', `erp/query?table=${tbl}&query=${q}`, null);
    }
    
    public async process_pmt(pmt_id: string): Promise<any> {
        return this.mk_req('POST', 'payments/process', { p_id: pmt_id });
    }

    public async issue_crd(usr_id: string): Promise<any> {
        return this.mk_req('POST', 'cards/issue', { u_id: usr_id });
    }
    
    public async get_inv(inv_id: string): Promise<any> {
        return this.mk_req('GET', `commerce/invoices/${inv_id}`, null);
    }
    
    public async check_dns_rcrd(dmn: string, tp: string): Promise<any> {
        return this.mk_req('GET', `hosting/dns?domain=${dmn}&type=${tp}`, null);
    }
    
    public async verify_asset(ast_id: string): Promise<any> {
        return this.mk_req('GET', `creative/assets/${ast_id}/verify`, null);
    }
    
    public async check_msg_log(msg_id: string): Promise<any> {
        return this.mk_req('GET', `comms/logs/${msg_id}`, null);
    }
}

export const init_all_svc_prcsrs = (): Map<string, CmptVrtlPrcsr> => {
    const m = new Map<string, CmptVrtlPrcsr>();
    for (const k of Object.keys(COMP_SVC_REGISTRY)) {
        const s_id = COMP_SVC_REGISTRY[k as keyof typeof COMP_SVC_REGISTRY];
        const bs_u = `https://${s_id.split('_')[0]}.api.citibankdemobusiness.dev`;
        const tkn = `cdbi_${gen_id_v4()}`;
        m.set(k, new CmptVrtlPrcsr(s_id, bs_u, tkn));
    }
    return m;
};

export const ALL_PROCESSORS = init_all_svc_prcsrs();

export class CmplncOrchstrtr {
    private prcsrs: Map<string, CmptVrtlPrcsr>;

    constructor(p: Map<string, CmptVrtlPrcsr>) {
        this.prcsrs = p;
    }

    public async run_full_spectrum_check(d: { [key: string]: any }): Promise<any[]> {
        const rslts: any[] = [];
        const tx_id = d.tx_id || gen_id_v4();
        const usr_id = d.usr_id || gen_id_v4();
        
        const pld_prcsr = this.prcsrs.get('PLAID');
        if (pld_prcsr) {
            const r = await pld_prcsr.vldt_tx(tx_id, d.amount, d.currency, d.from_acct, d.to_acct);
            rslts.push({ svc: 'PLAID', res: r });
        }
        
        const sfc_prcsr = this.prcsrs.get('SALESFORCE');
        if (sfc_prcsr) {
            const r = await sfc_prcsr.chk_usr_kyc(usr_id);
            rslts.push({ svc: 'SALESFORCE', res: r });
        }
        
        const gmni_prcsr = this.prcsrs.get('GEMINI');
        if (gmni_prcsr) {
            const r = await gmni_prcsr.scr_rsk_ai(d);
            rslts.push({ svc: 'GEMINI', res: r });
        }
        
        const ghb_prcsr = this.prcsrs.get('GITHUB');
        if (ghb_prcsr) {
            const r = await ghb_prcsr.scan_repo('cdbi-org', 'compliance-rules');
            rslts.push({ svc: 'GITHUB', res: r });
        }

        const azr_prcsr = this.prcsrs.get('AZURE');
        if (azr_prcsr) {
            const r = await azr_prcsr.check_vm_cnfg('vm-cmplnc-monitor-prod-01');
            rslts.push({ svc: 'AZURE', res: r });
        }

        return rslts;
    }
    
    public async exec_cmplx_wrkflw(w_id: string, pld: any): Promise<any> {
        const steps = this.get_wrkflw_steps(w_id);
        let crnt_pld = pld;
        
        for (const stp of steps) {
            const prcsr = this.prcsrs.get(stp.svc);
            if (!prcsr) continue;
            
            let res;
            switch (stp.act) {
                case 'vldt_tx':
                    res = await prcsr.vldt_tx(crnt_pld.id, crnt_pld.amt, crnt_pld.crncy, crnt_pld.frm, crnt_pld.to);
                    break;
                case 'chk_usr_kyc':
                    res = await prcsr.chk_usr_kyc(crnt_pld.uid);
                    break;
                case 'scr_rsk_ai':
                    res = await prcsr.scr_rsk_ai(crnt_pld);
                    break;
                case 'scan_repo':
                    res = await prcsr.scan_repo(crnt_pld.owner, crnt_pld.repo);
                    break;
                case 'verify_doc':
                    res = await prcsr.verify_doc(crnt_pld.doc_id, crnt_pld.doc_type);
                    break;
                default:
                    res = { err: 'Unknown action' };
            }
            crnt_pld = this.mrg_plds(crnt_pld, res, stp.out_key);
        }
        return crnt_pld;
    }
    
    private get_wrkflw_steps(w_id: string): { svc: string, act: string, out_key: string }[] {
        const wrkflws: { [key: string]: any[] } = {
            'ONBOARDING_V1': [
                { svc: 'PLAID', act: 'fetch_acct_bal', out_key: 'bal_check' },
                { svc: 'SALESFORCE', act: 'sync_crm_data', out_key: 'crm_sync' },
                { svc: 'GOOGLE_DRIVE', act: 'verify_doc', out_key: 'doc_vrfy' },
                { svc: 'GEMINI', act: 'scr_rsk_ai', out_key: 'risk_scr' },
                { svc: 'MARQETA', act: 'issue_crd', out_key: 'crd_issue' }
            ],
            'TRANSACTION_MONITORING_HIGH_RISK': [
                { svc: 'CITIBANK', act: 'vldt_tx', out_key: 'tx_vldt' },
                { svc: 'CHATGPT', act: 'scr_rsk_ai', out_key: 'narrative_analysis' },
                { svc: 'AWS', act: 'adt_lg_acss', out_key: 'acss_adt' },
                { svc: 'TWILIO', act: 'check_msg_log', out_key: 'comm_log' }
            ]
        };
        return wrkflws[w_id] || [];
    }

    private mrg_plds(orig: any, res: any, key: string): any {
        return { ...orig, [key]: res };
    }
}

export const MAIN_ORCHESTRATOR = new CmplncOrchstrtr(ALL_PROCESSORS);

export const gen_cmplnc_rpt = async (p: any): Promise<string> => {
    const rpt_id = gen_id_v4();
    const ts = new Date().getTime();
    let rpt_str = `CDBI COMPLIANCE REPORT\n`;
    rpt_str += `==================================\n`;
    rpt_str += `Report ID: ${rpt_id}\n`;
    rpt_str += `Timestamp: ${ts}\n`;
    rpt_str += `Company: ${CDBI_CNFG_VARS.c_n}\n`;
    rpt_str += `==================================\n\n`;
    
    rpt_str += `Parameters:\n${cstm_jsn_strfy(p)}\n\n`;
    
    const rslts = await MAIN_ORCHESTRATOR.run_full_spectrum_check(p);
    
    rpt_str += `Results:\n`;
    for(const r of rslts) {
        rpt_str += `----------------------------------\n`;
        rpt_str += `Service: ${r.svc}\n`;
        rpt_str += `Response: ${cstm_jsn_strfy(r.res)}\n`;
        rpt_str += `----------------------------------\n`;
    }
    
    const hsh = await _sha256_hsh(rpt_str);
    rpt_str += `\n\nReport Hash (SHA-256): ${hsh}\n`;
    
    return rpt_str;
};

export const JURISDICTION_RULES = {
    'US': {
        'BSA': { 'threshold': 10000, 'currency': 'USD', 'reporting_agency': 'FINCEN' },
        'SOX': { 'controls': ['access_log', 'change_management', 'data_integrity'] },
        'CCPA': { 'data_types': ['PII', 'location', 'browsing_history'] }
    },
    'EU': {
        'GDPR': { 'consent_required': true, 'data_residency': 'EU', 'breach_notification_hours': 72 },
        'PSD2': { 'sca_required': true, 'api_access': 'regulated' }
    },
    'GB': {
        'FCA': { 'aml_level': 5, 'kyc_docs': ['passport', 'utility_bill'] }
    },
    'CA': {
        'FINTRAC': { 'threshold': 10000, 'currency': 'CAD', 'reporting_agency': 'FINTRAC' }
    },
    'AU': {
        'AUSTRAC': { 'threshold': 10000, 'currency': 'AUD', 'reporting_agency': 'AUSTRAC' }
    }
};

export const check_jurisdiction_compliance = (tx_data: any, jur: string): any[] => {
    const rules = JURISDICTION_RULES[jur as keyof typeof JURISDICTION_RULES];
    const issues: any[] = [];
    if (!rules) return [{ error: 'Unknown jurisdiction' }];

    if (rules.BSA && tx_data.amount > rules.BSA.threshold && tx_data.currency === rules.BSA.currency) {
        issues.push({ code: 'BSA_REPORT_REQ', details: `Transaction over ${rules.BSA.threshold} ${rules.BSA.currency}`});
    }
    if (rules.FINTRAC && tx_data.amount > rules.FINTRAC.threshold && tx_data.currency === rules.FINTRAC.currency) {
        issues.push({ code: 'FINTRAC_REPORT_REQ', details: `Transaction over ${rules.FINTRAC.threshold} ${rules.FINTRAC.currency}`});
    }
    if (rules.AUSTRAC && tx_data.amount > rules.AUSTRAC.threshold && tx_data.currency === rules.AUSTRAC.currency) {
        issues.push({ code: 'AUSTRAC_REPORT_REQ', details: `Transaction over ${rules.AUSTRAC.threshold} ${rules.AUSTRAC.currency}`});
    }

    return issues;
};

