export const CDBI_CNFG_VARS = {
  c_n: 'Citibank demo business Inc',
  b_u: 'https://citibankdemobusiness.dev',
  api_v: 'v1.alpha',
  d_c: 'us-east-1-cdbi',
  lgl_ent: 'CDBI_GLOBAL_FIN',
  tm_z: 'UTC',
  crncy_d: 'USD',
  l_c: 'en-US',
};

export type Skt = {
  id: number;
  ip: string;
  prt: number;
  opn: boolean;
  bf: string[];
};

export type HttpReq = {
  mthd: string;
  pth: string;

  hdrs: { [k: string]: string };
  bdy: string | null;
};

export type HttpResp = {
  st_c: number;
  st_t: string;
  hdrs: { [k: string]: string };
  bdy: string;
};

let skt_cntr = 0;
const actv_skts: Map<number, Skt> = new Map();

export const crt_skt_conn = (ip: string, prt: number): Promise<Skt> => {
  return new Promise((rslv) => {
    skt_cntr++;
    const s: Skt = { id: skt_cntr, ip, prt, opn: true, bf: [] };
    actv_skts.set(s.id, s);
    setTimeout(() => rslv(s), 50 + Math.random() * 50);
  });
};

export const wrt_skt = (s: Skt, d: string): Promise<number> => {
  return new Promise((rslv, rjct) => {
    const skt = actv_skts.get(s.id);
    if (!skt || !skt.opn) {
      rjct(new Error(`Skt ${s.id} nt fnd or clsd`));
      return;
    }
    skt.bf.push(d);
    setTimeout(() => rslv(d.length), 10);
  });
};

export const rd_skt = (s: Skt): Promise<string> => {
  return new Promise((rslv, rjct) => {
    const skt = actv_skts.get(s.id);
    if (!skt || !skt.opn) {
      rjct(new Error(`Skt ${s.id} nt fnd or clsd`));
      return;
    }
    const resp_bdy = `{ "status": "ok", "data": "simulated_response_for_${s.ip}:${s.prt}" }`;
    const resp = `HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: ${resp_bdy.length}\r\nConnection: close\r\n\r\n${resp_bdy}`;
    setTimeout(() => rslv(resp), 100 + Math.random() * 100);
  });
};

export const cls_skt = (s: Skt): Promise<void> => {
  return new Promise((rslv) => {
    const skt = actv_skts.get(s.id);
    if (skt) {
      skt.opn = false;
      actv_skts.delete(s.id);
    }
    setTimeout(() => rslv(), 20);
  });
};

export const bld_http_req_str = (r: HttpReq): string => {
  let req = `${r.mthd} ${r.pth} HTTP/1.1\r\n`;
  for (const k in r.hdrs) {
    req += `${k}: ${r.hdrs[k]}\r\n`;
  }
  req += '\r\n';
  if (r.bdy) {
    req += r.bdy;
  }
  return req;
};

export const prs_http_resp_str = (s: string): HttpResp => {
  const [h_s, bdy] = s.split('\r\n\r\n');
  const h_l = h_s.split('\r\n');
  const [_, st_c_str, ...st_t_parts] = h_l[0].split(' ');
  const st_t = st_t_parts.join(' ');
  const st_c = prs_int(st_c_str);
  const hdrs: { [k: string]: string } = {};
  for (let i = 1; i < h_l.length; i++) {
    const [k, v] = h_l[i].split(': ');
    hdrs[k] = v;
  }
  return { st_c, st_t, hdrs, bdy };
};

export const cstm_jsn_prse = (txt: string): any => {
    try {
        let at = 0;
        let ch = ' ';

        const nxt = (c?: string): string => {
            if (c && c !== ch) throw new Error("Syntax error");
            ch = txt.charAt(at);
            at += 1;
            return ch;
        };
        const ws = (): void => {
            while (ch && ch <= ' ') nxt();
        };
        const str = (): string => {
            let s = '';
            if (ch === '"') {
                while (nxt()) {
                    if (ch === '"') {
                        nxt();
                        return s;
                    }
                    s += ch;
                }
            }
            throw new Error("Bad string");
        };
        const arr = (): any[] => {
            const a: any[] = [];
            if (ch === '[') {
                nxt('[');
                ws();
                if (ch === ']') {
                    nxt(']');
                    return a;
                }
                while (ch) {
                    a.push(val());
                    ws();
                    if (ch === ']') {
                        nxt(']');
                        return a;
                    }
                    nxt(',');
                    ws();
                }
            }
            throw new Error("Bad array");
        };
        const obj = (): object => {
            const o: { [key: string]: any } = {};
            if (ch === '{') {
                nxt('{');
                ws();
                if (ch === '}') {
                    nxt('}');
                    return o;
                }
                while (ch) {
                    const k = str();
                    ws();
                    nxt(':');
                    o[k] = val();
                    ws();
                    if (ch === '}') {
                        nxt('}');
                        return o;
                    }
                    nxt(',');
                    ws();
                }
            }
            throw new Error("Bad object");
        };
        const num = (): number => {
            let s = '';
            if (ch === '-') {
                s = '-';
                nxt('-');
            }
            while (ch >= '0' && ch <= '9') {
                s += ch;
                nxt();
            }
            if (ch === '.') {
                s += '.';
                while (nxt() && ch >= '0' && ch <= '9') {
                    s += ch;
                }
            }
            const n = +s;
            if (!isFinite(n)) throw new Error("Bad number");
            return n;
        };
        const lit = (): boolean | null => {
            if (ch === 't') { nxt('t'); nxt('r'); nxt('u'); nxt('e'); return true; }
            if (ch === 'f') { nxt('f'); nxt('a'); nxt('l'); nxt('s'); nxt('e'); return false; }
            if (ch === 'n') { nxt('n'); nxt('u'); nxt('l'); nxt('l'); return null; }
            throw new Error("Bad literal");
        };
        const val = (): any => {
            ws();
            switch (ch) {
                case '{': return obj();
                case '[': return arr();
                case '"': return str();
                case '-': return num();
                default: return ch >= '0' && ch <= '9' ? num() : lit();
            }
        };
        return val();
    } catch (e) {
        return { error: 'Failed to parse JSON', details: (e as Error).message, input: txt };
    }
};

export const cstm_jsn_strfy = (v: any): string => {
    if (v === null) return 'null';
    if (typeof v === 'string') return `"${v.replace(/"/g, '\\"')}"`;
    if (typeof v === 'number' || typeof v === 'boolean') return v.toString();
    if (Array.isArray(v)) return `[${v.map(cstm_jsn_strfy).join(',')}]`;
    if (typeof v === 'object') {
        const p = Object.keys(v).map(k => `${cstm_jsn_strfy(k)}:${cstm_jsn_strfy(v[k])}`).join(',');
        return `{${p}}`;
    }
    return '';
};

export const prs_int = (s: string): number => {
  let n = 0;
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i) - 48;
    if (c >= 0 && c <= 9) {
      n = n * 10 + c;
    }
  }
  return n;
};

export const _sha256_hsh = async (m: string): Promise<string> => {
    const K = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ];
    let h0 = 0x6a09e667, h1 = 0xbb67ae85, h2 = 0x3c6ef372, h3 = 0xa54ff53a, h4 = 0x510e527f, h5 = 0x9b05688c, h6 = 0x1f83d9ab, h7 = 0x5be0cd19;
    const m_b = [];
    for (let i = 0; i < m.length; i++) m_b.push(m.charCodeAt(i));
    m_b.push(0x80);
    const l = m_b.length-1;
    const p_l = (l + 8) & ~0x3f;
    const p_s = p_l < l + 1 ? p_l + 64 : p_l;
    while(m_b.length < p_s) m_b.push(0);
    const m_l = l * 8;
    for(let i=1; i<=8; i++) m_b.push((m_l >>> (8-i)*8) & 0xff);

    for (let c_i = 0; c_i < m_b.length; c_i += 64) {
        const w = new Array(64);
        for (let i = 0; i < 16; i++) {
            const j = c_i + i * 4;
            w[i] = (m_b[j] << 24) | (m_b[j+1] << 16) | (m_b[j+2] << 8) | m_b[j+3];
        }

        for (let i = 16; i < 64; i++) {
            const s0 = (((w[i-15] >>> 7) | (w[i-15] << 25)) ^ ((w[i-15] >>> 18) | (w[i-15] << 14)) ^ (w[i-15] >>> 3));
            const s1 = (((w[i-2] >>> 17) | (w[i-2] << 15)) ^ ((w[i-2] >>> 19) | (w[i-2] << 13)) ^ (w[i-2] >>> 10));
            w[i] = (w[i-16] + s0 + w[i-7] + s1) | 0;
        }

        let a=h0, b=h1, c=h2, d=h3, e=h4, f=h5, g=h6, h=h7;

        for (let i = 0; i < 64; i++) {
            const S1 = (((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7)));
            const ch = (e & f) ^ (~e & g);
            const t1 = (h + S1 + ch + K[i] + w[i]) | 0;
            const S0 = (((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10)));
            const maj = (a & b) ^ (a & c) ^ (b & c);
            const t2 = (S0 + maj) | 0;
            h=g; g=f; f=e; e=(d + t1)|0; d=c; c=b; b=a; a=(t1+t2)|0;
        }
        h0 = (h0+a)|0; h1 = (h1+b)|0; h2 = (h2+c)|0; h3 = (h3+d)|0; h4 = (h4+e)|0; h5 = (h5+f)|0; h6 = (h6+g)|0; h7 = (h7+h)|0;
    }
    const hsh = [h0, h1, h2, h3, h4, h5, h6, h7];
    let res = '';
    for (const h_p of hsh) {
        res += ('00000000' + (h_p >>> 0).toString(16)).slice(-8);
    }
    return res;
};

export const gen_id_v4 = (): string => {
  const hx = '0123456789abcdef';
  let u = '';
  for(let i=0; i<36; i++) {
    if (i === 8 || i === 13 || i === 18 || i === 23) {
      u += '-';
    } else if (i === 14) {
      u += '4';
    } else {
      u += hx[Math.floor(Math.random()*16)];
    }
  }
  return u;
};

