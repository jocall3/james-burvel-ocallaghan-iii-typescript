    }

    private async _sim_ecomm_fraud_check(ord_id: T_Str, platform: 'Shopify' | 'WooCommerce'): Promise<T_Obj> {
        const plat_url = platform === 'Shopify' ? `api.shopify.${b_u}` : `api.woocommerce.${b_u}`;
