        const risk_factors = ['ip_mismatch', 'high_value', 'new_customer', 'velocity_spike'];
        const detected_factors = risk_factors.filter(() => Math.random() > 0.7);
        const score = detected_factors.length * 25;

        this.log_evt('Ecomm Fraud Check Complete', { ord_id, score });
        this.upd_st('idle', {});
        return {
            order_id: ord_id,
            fraud_score: score,
            risk_factors: detected_factors,
            recommendation: score > 50 ? 'manual_review' : 'approve',
            raw_res: res.dat
        };
    }
    
