    private async _sim_ai_model_gov(model_id: T_Str, provider: 'Hugging Face' | 'ChatHot'): Promise<T_Obj> {
        const provider_url = provider === 'Hugging Face' ? `api.huggingface.${b_u}` : `api.chathot.${b_u}`;
