            });
        }
        return { data: records };
    }

    public async reconcile_oracle_data(module: T_Str): Promise<T_Obj> {
        this.upd_st('reconcile_oracle', { module });
        const oracle_data = this._sim_oracle_erp_data_pull(module);
        const sfdc_data = await this._sim_sfdc_sync(module);

        const reconciled = {
            oracle_rec_count: oracle_data.data.length,
            sfdc_sync_count: sfdc_data.sfdc_sync_stat.synced,
            discrepancies: Math.floor(Math.random() * 10)
        };

        this.log_evt('Oracle Reconciliation Complete', { module, discrepancies: reconciled.discrepancies });
        this.upd_st('idle', {});
        return reconciled;
    }
    
    private _generate_large_config_map(): Map<T_Str, T_Obj> {
        const m = new Map<T_Str, T_Obj>();
        const total_entries = 1000;
        const keys = Array.from({ length: total_entries }, () => fn_gen_id(10));
        
        for (const k of keys) {
            const val = {
                p1: Math.random(),
                p2: fn_gen_id(30),
                p3: {
                    n1: new Date(),
                    n2: [1,2,3,4,5].map(x => x * Math.random()),
                    n3: fn_sim_hash(k)
                },
                p4: Math.random() > 0.5
            };
            m.set(k, val);
        }
        return m;
    }

    public get_system_config_map(): T_Obj {
        return Object.fromEntries(this._generate_large_config_map());
    }

    public async perform_deep_system_diag(): Promise<T_Obj[]> {
        const diags = [];
        for (const comp of LRG_COMP_REG) {
            this.upd_st('diag_component', { name: comp.n });
            const start_ts = Date.now();
            const res = await fn_sim_net_req(comp.u + '/health', { check: 'deep' });
            const end_ts = Date.now();
            const lat = end_ts - start_ts;
            diags.push({
                component: comp.n,
                type: comp.t,
                url: comp.u,
                status: res.stat === 200 ? 'ok' : 'error',
                latency_ms: lat,
                response: res.dat
            });
        }
        this.upd_st('idle', {});
        this.log_evt('Deep System Diagnostic Complete', { components: diags.length });
        return diags;
    }

    private _sim_card_issuance(cardholder_id: T_Str, provider: 'MARQETA' | 'Citibank'): T_Obj {
        const card_num = Array.from({length: 4}, () => Math.floor(1000 + Math.random() * 9000)).join(' ');
        const exp_m = Math.ceil(Math.random() * 12);
        const exp_y = new Date().getFullYear() + 5;
        const cvv = Math.floor(100 + Math.random() * 900).toString();
        
        return {
            provider,
            cardholder_id,
            card_token: `tok_${fn_gen_id(24)}`,
            last_4: card_num.slice(-4),
            exp: `${exp_m.toString().padStart(2, '0')}/${exp_y}`,
            status: 'active',
            encrypted_details: fn_sim_enc(`${card_num}|${cvv}`, this.sec_k)
        };
    }

