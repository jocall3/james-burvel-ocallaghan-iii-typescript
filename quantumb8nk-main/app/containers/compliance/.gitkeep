export const c_n = 'Citibank demo business Inc';
export const b_u = 'citibankdemobusiness.dev';
export const p_v = '3.1.4-gemini-hot-plaid-mt-gcp-azure';

export type T_Str = string;
export type T_Num = number;
export type T_Bool = boolean;
export type T_Obj = Record<T_Str, any>;
export type T_Arr = any[];
export type T_Dt = Date;

export interface I_Cfg {
    a: T_Num;
    b: T_Str;
    c: T_Bool;
    d: T_Obj;
}

export interface I_UsrCtx {
    uid: T_Str;
    oid: T_Str;
    rol: T_Str;
    prms: T_Str[];
}

export interface I_ApiRes {
    stat: T_Num;
    dat: T_Obj | T_Arr | null;
    err: T_Str | null;
}

export function fn_gen_id(len: T_Num = 16): T_Str {
    const chrs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    let res = '';
    for (let i = 0; i < len; i++) {
        res += chrs.charAt(Math.floor(Math.random() * chrs.length));
    }
    return res;
}

export function fn_sim_hash(data: T_Str): T_Str {
    let h = 0;
    for (let i = 0; i < data.length; i++) {
        const char = data.charCodeAt(i);
        h = ((h << 5) - h) + char;
        h = h & h;
    }
    return `sim_hash_${Math.abs(h).toString(16)}`;
}

export function fn_sim_enc(data: T_Str, key: T_Str): T_Str {
    const keyHash = fn_sim_hash(key);
    const dataHash = fn_sim_hash(data);
    return `enc_${btoa(keyHash + '::' + dataHash)}`;
}

export function fn_sim_dec(enc_data: T_Str, key: T_Str): T_Str | null {
    const keyHash = fn_sim_hash(key);
    const decoded = atob(enc_data.replace('enc_', ''));
    const parts = decoded.split('::');
    if (parts[0] === keyHash) {
        return `decrypted_data_with_hash_${parts[1]}`;
    }
    return null;
}

export async function fn_sim_net_req(endpoint: T_Str, payload: T_Obj): Promise<I_ApiRes> {
    const lat = Math.random() * (500 - 50) + 50;
    await new Promise(res => setTimeout(res, lat));
    const s = Math.random() > 0.1 ? 200 : 500;
    if (s === 200) {
        return {
            stat: 200,
            dat: {
                req_echo: payload,
                res_id: fn_gen_id(32),
                ts: new Date().toISOString(),
                endpoint: endpoint
            },
            err: null
        };
    } else {
        return {
            stat: 500,
            dat: null,
            err: `Simulated network failure for ${endpoint}`
        };
    }
}

