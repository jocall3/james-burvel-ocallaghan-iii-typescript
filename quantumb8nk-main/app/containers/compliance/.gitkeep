    private _generate_complex_ruleset(domain: T_Str): T_Arr {
        const rules = [];
        const num_rules = 50 + Math.floor(Math.random() * 50);
        for (let i = 0; i < num_rules; i++) {
            const rule = {
                id: `RULE-${domain.toUpperCase()}-${fn_gen_id(8)}`,
                active: Math.random() > 0.1,
                priority: Math.ceil(Math.random() * 10),
                conditions: [],
                action: {
                    type: ['flag', 'block', 'alert'][Math.floor(Math.random() * 3)],
                    params: {
                        notify_list: [`sec-ops@${b_u}`, `compliance-team@${b_u}`]
                    }
                }
            };
            const num_conds = 1 + Math.floor(Math.random() * 4);
            for (let j = 0; j < num_conds; j++) {
                rule.conditions.push({
                    fact: ['amount', 'location', 'user_role', 'data_sensitivity'][Math.floor(Math.random() * 4)],
                    op: ['greaterThan', 'equals', 'in', 'contains'][Math.floor(Math.random() * 4)],
                    val: fn_gen_id(6)
                });
            }
            rules.push(rule);
        }
        return rules;
    }
    
    public load_all_domain_rules(): T_Obj {
        this.upd_st('load_rules', {});
        const all_rules = {
            fintech: this._generate_complex_ruleset('fintech'),
            cloud: this._generate_complex_ruleset('cloud'),
            datagov: this._generate_complex_ruleset('datagov'),
            ai: this._generate_complex_ruleset('ai'),
            devops: this._generate_complex_ruleset('devops'),
        };
        this.log_evt('All Domain Rules Loaded', { counts: Object.keys(all_rules).map(k => ({ d: k, c: all_rules[k].length }))});
        this.upd_st('idle', {});
        return all_rules;
    }

    public async run_batch_compliance_process(uids: T_Str[]): Promise<T_Obj[]> {
        this.upd_st('batch_process', { count: uids.length });
        const results = [];
        for (const uid of uids) {
            const mock_prof = { uid, country: ['US', 'GB', 'PA'][Math.floor(Math.random() * 3)] };
            const mock_ctx: I_UsrCtx = { 
                uid,
                oid: fn_gen_id(),
                rol: ['admin', 'user', 'external_contractor'][Math.floor(Math.random() * 3)],
                prms: Math.random() > 0.5 ? ['view:all', 'view:pii'] : ['view:basic']
            };
            const res = await this.run_full_usr_compliance_check(uid, mock_prof, mock_ctx);
            results.push(res);
        }
        this.upd_st('idle', {});
        return results;
    }

    private _sim_oracle_erp_data_pull(module: T_Str): T_Obj {
