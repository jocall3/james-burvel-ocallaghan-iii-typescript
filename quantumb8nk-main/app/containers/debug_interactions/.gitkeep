// Complex Orchestration Logic
export namespace orch_s {
    export type Cfg_Map = {
        shpfy: shpfy_s.Cfg;
        sfrc: sfrc_s.Cfg;
        twl: twl_s.Cfg;
        gcp: gcp_s.Cfg;
    }

    export class New_Ord_Flow {
        private shpfy: shpfy_s.Shpfy_Cl;
        private sfrc: sfrc_s.Sfrc_Cl;
        private twl: twl_s.Twl_Cl;
        private gcp: gcp_s.Gcp_Cl;

        constructor(c: Cfg_Map) {
            this.shpfy = new shpfy_s.Shpfy_Cl(c.shpfy);
            this.sfrc = new sfrc_s.Sfrc_Cl(c.sfrc);
            this.twl = new twl_s.Twl_Cl(c.twl);
            this.gcp = new gcp_s.Gcp_Cl(c.gcp);
        }

        public proc_ord(ord_id: i_num): Ftr<i_obj> {
            let ord_d: shpfy_s.Ord;
            let acct_id: i_str;
            let cntct_id: i_str;
            let opp_id: i_str;
            let file_url: i_str;
            let sms_sid: i_str;
            
            return this.shpfy.g_ords().thn(r => {
                const ord = r.orders.find(o => o.id === ord_id);
                if (!ord) throw new Error(`ord_${ord_id}_nf`);
                ord_d = ord;
                const soql_acct = `SELECT Id FROM Account WHERE Name = '${ord_d.customer.company}' LIMIT 1`;
                return this.sfrc.q(soql_acct);
            }).thn(acct_res => {
                if (acct_res.records.length > 0) {
                    acct_id = acct_res.records[0].Id;
                    return new Ftr(rs => rs({id: acct_id, success: true}));
                } else {
                    return this.sfrc.cr_rec<sfrc_s.Acct>('Account', { Name: ord_d.customer.company, Industry: 'Retail' });
                }
            }).thn(acct_cr => {
                acct_id = acct_cr.id;
                const soql_cntct = `SELECT Id FROM Contact WHERE Email = '${ord_d.email}' LIMIT 1`;
                return this.sfrc.q(soql_cntct);
            }).thn(cntct_res => {
                if (cntct_res.records.length > 0) {
                    cntct_id = cntct_res.records[0].Id;
                    return new Ftr(rs => rs({id: cntct_id, success: true}));
                } else {
                    return this.sfrc.cr_rec<sfrc_s.Cntct>('Contact', {
                        FirstName: ord_d.customer.first_name,
                        LastName: ord_d.customer.last_name,
                        Email: ord_d.email,
                        AccountId: acct_id
                    });
                }
            }).thn(cntct_cr => {
                cntct_id = cntct_cr.id;
                return this.sfrc.cr_rec<sfrc_s.Opp>('Opportunity', {
                    Name: `Order ${ord_d.id} - ${ord_d.line_items[0].name}`,
                    StageName: 'Closed Won',
                    Amount: parseFloat(ord_d.total_price),
                    AccountId: acct_id,
                    CloseDate: new Date().toISOString().split('T')[0]
                });
            }).thn(opp_cr => {
                opp_id = opp_cr.id;
                const inv = { order: ord_d, salesforce: { acct_id, cntct_id, opp_id } };
                const gcs = this.gcp.g_strg();
                return gcs.up_o('invoices-citibank', `inv_${ord_id}.json`, JSON.stringify(inv));
            }).thn(f_url => {
                file_url = f_url;
                return this.twl.snd_sms(ord_d.customer.phone, '+15005550006', `Thx for order ${ord_id}!`);
            }).thn(sms => {
                sms_sid = sms.sid;
                return new Ftr(rs => rs({
                    shpfy_ord_id: ord_id,
                    sfrc_acct_id: acct_id,
                    sfrc_cntct_id: cntct_id,
                    sfrc_opp_id: opp_id,
                    gcs_inv_url: file_url,
                    twl_sms_sid: sms_sid,
                    st: 'complete'
                }));
            });
        }
    }
}

