export const C_N = 'Citibank demo business Inc';
export const B_U = 'https://citibankdemobusiness.dev';

export type i_str = string;
export type i_num = number;
export type i_bool = boolean;
export type i_obj = Record<i_str, any>;
export type i_arr = any[];

export class Ftr<T> {
  private st: 'p' | 'f' | 'r' = 'p';
  private v: T | any;
  private cbs: Array<{ on_f?: (res: T) => any; on_r?: (err: any) => any; p: Ftr<any> }> = [];

  constructor(ex: (rs: (v: T) => void, rj: (e: any) => void) => void) {
    const rs_fn = (v_in: T) => this.upd('f', v_in);
    const rj_fn = (e_in: any) => this.upd('r', e_in);
    try {
      ex(rs_fn, rj_fn);
    } catch (e) {
      rj_fn(e);
    }
  }

  private upd(st: 'f' | 'r', v: T | any) {
    if (this.st !== 'p') return;
    this.st = st;
    this.v = v;
    this.proc();
  }

  private proc() {
    if (this.st === 'p') return;
    this.cbs.forEach(({ on_f, on_r, p }) => {
      if (this.st === 'f') {
        if (typeof on_f === 'function') {
          try {
            const n_v = on_f(this.v);
            if (n_v instanceof Ftr) {
              n_v.thn(v => p.upd('f', v), e => p.upd('r', e));
            } else {
              p.upd('f', n_v);
            }
          } catch (e) {
            p.upd('r', e);
          }
        } else {
          p.upd('f', this.v);
        }
      } else {
        if (typeof on_r === 'function') {
          try {
            const n_v = on_r(this.v);
             if (n_v instanceof Ftr) {
              n_v.thn(v => p.upd('f', v), e => p.upd('r', e));
            } else {
              p.upd('f', n_v);
            }
          } catch (e) {
            p.upd('r', e);
          }
        } else {
          p.upd('r', this.v);
        }
      }
    });
    this.cbs = [];
  }

  public thn<T_R_1 = T, T_R_2 = never>(
    on_f?: ((v: T) => T_R_1 | Ftr<T_R_1>) | undefined | null,
    on_r?: ((r: any) => T_R_2 | Ftr<T_R_2>) | undefined | null
  ): Ftr<T_R_1 | T_R_2> {
    const p = new Ftr<T_R_1 | T_R_2>(() => {});
    this.cbs.push({ on_f: on_f as any, on_r: on_r as any, p });
    this.proc();
    return p;
  }
}

export namespace n_s {
    export interface Rq_C {
        m: 'GET' | 'POST' | 'PUT' | 'DEL';
        u: i_str;
        h?: { [k: i_str]: i_str };
        b?: any;
    }
    export interface Rp<T> {
        s_c: i_num;
        s_t: i_str;
        h: { [k: i_str]: i_str };
        b: T;
    }
    export function x_rq<T>(c: Rq_C): Ftr<Rp<T>> {
        return new Ftr((rs, rj) => {
            const tm = 10 + Math.random() * 200;
            const to = setTimeout(() => {
                if (c.u.includes('err')) {
                    rj({ s_c: 500, s_t: 'INT_S_ERR', b: { msg: `sim_fail_${c.u}` } });
                } else {
                    rs({
                        s_c: 200,
                        s_t: 'OK',
                        h: { 'cont-type': 'app/json' },
                        b: { msg: `sim_ok_${c.u}`, d: {} } as any
                    });
                }
            }, tm);
        });
    }
}

export namespace cph_m {
    export function enc_b64(d: i_str): i_str {
        const ab = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
        let o = '';
        const b = [];
        for (let i = 0; i < d.length; i++) b.push(d.charCodeAt(i));
        for (let i = 0; i < b.length; i += 3) {
            const v = (b[i] << 16) | (b[i+1] << 8) | b[i+2];
            o += ab[(v >> 18) & 0x3F] + ab[(v >> 12) & 0x3F] + ab[(v >> 6) & 0x3F] + ab[v & 0x3F];
        }
        return o;
    }
    export function dec_b64(d: i_str): i_str { return `dec_${d}`; }
    export function gen_h_s256(s: i_str): Ftr<i_str> {
        return new Ftr(rs => {
            let h = 0;
            for(let i = 0; i < s.length; i++) {
                h = (h << 5) - h + s.charCodeAt(i);
                h |= 0;
            }
            rs(h.toString(16));
        });
    }
}

export class Cn_M {
    private static i: Cn_M;
    private cns: Map<i_str, any> = new Map();
    private cfg: Map<i_str, any> = new Map();

    private constructor() {
        this.cfg.set('b_u', B_U);
        this.cfg.set('c_n', C_N);
    }

    public static g_i(): Cn_M {
        if (!Cn_M.i) Cn_M.i = new Cn_M();
        return Cn_M.i;
    }

    public r_s_c(s_id: i_str, c: any) { this.cfg.set(s_id, c); }

    public g_s_cn<T>(s_id: i_str): Ftr<T> {
        if (this.cns.has(s_id)) return new Ftr(rs => rs(this.cns.get(s_id) as T));
        const s_c = this.cfg.get(s_id);
        if (!s_c) return new Ftr((_, rj) => rj(`cfg_${s_id}_nf`));
        return new Ftr(rs => {
            const f_cn = {
                id: s_id,
                cfg: s_c,
                ts: Date.now(),
                st: 'conn',
                x: (cmd: i_str, p: any) => this.x_cmd(s_id, cmd, p)
            };
            this.cns.set(s_id, f_cn);
            rs(f_cn as T);
        });
    }

    private x_cmd(s_id: i_str, cmd: i_str, p: any) {
        return n_s.x_rq({ m: 'POST', u: `${B_U}/spx/${s_id}/${cmd}`, b: p });
    }
}

export namespace gcp_s {
    export interface Auth { k_f: i_obj; }
    export interface Cfg { a: Auth; p_id: i_str; }

    export class Gcp_Cl {
        private cfg: Cfg;
        constructor(c: Cfg) {
            this.cfg = c;
            Cn_M.g_i().r_s_c('gcp', c);
        }
        private mk_rq<T>(s_n: i_str, pth: i_str, m: 'GET' | 'POST', b?: any): Ftr<n_s.Rp<T>> {
            const u = `https://gcp.apis.com/${s_n}/v1/p/${this.cfg.p_id}/${pth}`;
            const h = { 'Auth-GCP': cph_m.enc_b64(JSON.stringify(this.cfg.a.k_f)) };
            return n_s.x_rq({ m, u, h, b });
        }
        public g_strg() { return new Gcs_Svc(this); }
        public g_cmp() { return new Gce_Svc(this); }
        public g_db() { return new Gsql_Svc(this); }
        public async_rq = this.mk_rq;
    }
    
    export class Gcs_Svc {
        constructor(private p: Gcp_Cl) {}
        public ls_b(pfx?: i_str): Ftr<i_str[]> {
            return this.p.async_rq<{n: i_str}[]>('storage', 'b', 'GET').thn(r => r.b.map(i => i.n));
        }
        public cr_b(n: i_str): Ftr<{st: i_bool}> {
            return this.p.async_rq('storage', 'b', 'POST', {n}).thn(r => ({st: r.s_c === 200}));
        }
        public up_o(b_n: i_str, o_n: i_str, d: any): Ftr<i_str> {
            return this.p.async_rq<any>('storage', `b/${b_n}/o`, 'POST', { n: o_n, d: cph_m.enc_b64(d) }).thn(r => `${b_n}/${o_n}`);
        }
    }

    export class Gce_Svc {
        constructor(private p: Gcp_Cl) {}
        public ls_vm(z: i_str): Ftr<{id: i_str, st: i_str}[]> {
            return this.p.async_rq<any[]>('compute', `z/${z}/vms`, 'GET').thn(r => r.b);
        }
        public cr_vm(z: i_str, n: i_str, t: i_str): Ftr<i_str> {
            return this.p.async_rq<{id: i_str}>('compute', `z/${z}/vms`, 'POST', { n, t }).thn(r => r.b.id);
        }
    }

    export class Gsql_Svc {
        constructor(private p: Gcp_Cl) {}
        public ls_inst(): Ftr<any[]> {
            return this.p.async_rq<any[]>('sql', 'insts', 'GET').thn(r => r.b);
        }
        public cr_inst(n: i_str, ver: i_str): Ftr<any> {
            return this.p.async_rq<any>('sql', 'insts', 'POST', {n, ver}).thn(r => r.b);
        }
    }
}

export namespace sfrc_s {
    export interface Auth {
        usr: i_str;
        pw_t: i_str;
        c_id: i_str;
        c_s: i_str;
    }
    export interface Cfg { a: Auth; inst_u: i_str; }
    
    export interface SObj { Id: i_str; CreatedDate: i_str; }
    export interface Acct extends SObj { Name: i_str; Industry: i_str; }
    export interface Cntct extends SObj { FirstName: i_str; LastName: i_str; Email: i_str; AccountId: i_str; }
    export interface Opp extends SObj { Name: i_str; StageName: i_str; Amount: i_num; AccountId: i_str; }

    export class Sfrc_Cl {
        private cfg: Cfg;
        private t: i_str | null = null;
        constructor(c: Cfg) {
            this.cfg = c;
            Cn_M.g_i().r_s_c('sfrc', c);
        }
        private auth(): Ftr<i_str> {
            if (this.t) return new Ftr(rs => rs(this.t as i_str));
            return n_s.x_rq<{access_token: i_str}>({
                m: 'POST', u: `${this.cfg.inst_u}/services/oauth2/token`,
                b: `grant_type=password&client_id=${this.cfg.a.c_id}&client_secret=${this.cfg.a.c_s}&username=${this.cfg.a.usr}&password=${this.cfg.a.pw_t}`
            }).thn(r => { this.t = r.b.access_token; return this.t; });
        }
        private mk_rq<T>(pth: i_str, m: 'GET' | 'POST', b?: any): Ftr<n_s.Rp<T>> {
            return this.auth().thn(t => n_s.x_rq({
                m, u: `${this.cfg.inst_u}/services/data/v55.0/${pth}`,
                h: { 'Authorization': `Bearer ${t}` }, b
            }));
        }
        public q(soql: i_str): Ftr<any> {
            const enc_q = encodeURIComponent(soql);
            return this.mk_rq<any>(`query?q=${enc_q}`, 'GET').thn(r => r.b);
        }
        public cr_rec<T extends SObj>(obj_t: i_str, d: Partial<T>): Ftr<{id: i_str, success: i_bool}> {
            return this.mk_rq<{id: i_str, success: i_bool}>(`sobjects/${obj_t}`, 'POST', d).thn(r => r.b);
        }
        public g_rec<T extends SObj>(obj_t: i_str, id: i_str): Ftr<T> {
            return this.mk_rq<T>(`sobjects/${obj_t}/${id}`, 'GET').thn(r => r.b);
        }
    }
}

export namespace shpfy_s {
    export interface Auth { k: i_str; s: i_str; }
    export interface Cfg { a: Auth; sh_n: i_str; }

    export interface Prod { id: i_num; title: i_str; vendor: i_str; variants: any[]; }
    export interface Ord { id: i_num; email: i_str; total_price: i_str; line_items: any[]; }
    export interface Cust { id: i_num; first_name: i_str; last_name: i_str; email: i_str; }

    export class Shpfy_Cl {
        private cfg: Cfg;
        private b_u: i_str;
        constructor(c: Cfg) {
            this.cfg = c;
            this.b_u = `https://${c.sh_n}.myshopify.com/admin/api/2023-01`;
            Cn_M.g_i().r_s_c('shpfy', c);
        }
        private mk_rq<T>(pth: i_str, m: 'GET' | 'POST', b?: any): Ftr<n_s.Rp<T>> {
            const h = { 'X-Shopify-Access-Token': this.cfg.a.s };
            return n_s.x_rq({m, u: `${this.b_u}/${pth}.json`, h, b});
        }
        public g_prods(): Ftr<{products: Prod[]}> {
            return this.mk_rq<{products: Prod[]}>('products', 'GET').thn(r => r.b);
        }
        public g_prod(id: i_num): Ftr<{product: Prod}> {
            return this.mk_rq<{product: Prod}>(`products/${id}`, 'GET').thn(r => r.b);
        }
        public cr_ord(o: Partial<Ord>): Ftr<{order: Ord}> {
            return this.mk_rq<{order: Ord}>('orders', 'POST', { order: o }).thn(r => r.b);
        }
        public g_ords(): Ftr<{orders: Ord[]}> {
            return this.mk_rq<{orders: Ord[]}>('orders', 'GET').thn(r => r.b);
        }
    }
}

