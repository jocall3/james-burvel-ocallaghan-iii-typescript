export namespace pld_s {
    export interface Cfg { c_id: i_str; s: i_str; env: 'dev' | 'prod'; }
    export interface Itm { id: i_str; inst_id: i_str; }
    export interface Acct { id: i_str; name: i_str; bal: i_num; }
    export class Pld_Cl {
        private cfg: Cfg; private u: i_str;
        constructor(c: Cfg) {
            this.cfg = c;
            this.u = `https://api.plaid.com`;
            Cn_M.g_i().r_s_c('pld', c);
        }
        private mk_rq<T>(p: i_str, b: any): Ftr<T> {
            b.client_id = this.cfg.c_id;
            b.secret = this.cfg.s;
            return n_s.x_rq<T>({ m: 'POST', u: `${this.u}/${p}`, b: b }).thn(r => r.b);
        }
        public g_accts(tok: i_str): Ftr<{accounts: Acct[]}> { return this.mk_rq('accounts/balance/get', { access_token: tok }); }
        public g_trans(tok: i_str, s_d: i_str, e_d: i_str): Ftr<any> { return this.mk_rq('transactions/get', { access_token: tok, start_date: s_d, end_date: e_d }); }
    }
}

export namespace twl_s {
    export interface Cfg { acct_sid: i_str; auth_tok: i_str; }
    export interface Msg { sid: i_str; st: i_str; }
    export class Twl_Cl {
        private cfg: Cfg; private u: i_str;
        constructor(c: Cfg) { this.cfg = c; this.u = `https://api.twilio.com/2010-04-01`; Cn_M.g_i().r_s_c('twl', c); }
        private mk_rq<T>(p: i_str, b: any): Ftr<T> {
            const h = { 'Authorization': `Basic ${cph_m.enc_b64(`${this.cfg.acct_sid}:${this.cfg.auth_tok}`)}` };
            return n_s.x_rq<T>({ m: 'POST', u: `${this.u}/Accounts/${this.cfg.acct_sid}/${p}.json`, b, h }).thn(r => r.b);
        }
        public snd_sms(to: i_str, from: i_str, body: i_str): Ftr<Msg> { return this.mk_rq('Messages', { To: to, From: from, Body: body }); }
        public mk_call(to: i_str, from: i_str, u: i_str): Ftr<any> { return this.mk_rq('Calls', { To: to, From: from, Url: u }); }
    }
}

export namespace strp_s {
    export interface Cfg { s_k: i_str; }
    export interface Chrg { id: i_str; amt: i_num; curr: i_str; status: i_str; }
    export class Strp_Cl {
        private cfg: Cfg; private u: i_str;
        constructor(c: Cfg) { this.cfg = c; this.u = 'https://api.stripe.com/v1'; Cn_M.g_i().r_s_c('strp', c); }
        private mk_rq<T>(p: i_str, m: 'GET' | 'POST', b?: any): Ftr<T> {
            const h = { 'Authorization': `Bearer ${this.cfg.s_k}` };
            return n_s.x_rq<T>({ m, u: `${this.u}/${p}`, h, b }).thn(r => r.b);
        }
        public cr_chrg(amt: i_num, curr: i_str, src: i_str): Ftr<Chrg> { return this.mk_rq('charges', 'POST', { amount: amt, currency: curr, source: src }); }
        public g_chrg(id: i_str): Ftr<Chrg> { return this.mk_rq(`charges/${id}`, 'GET'); }
    }
}

