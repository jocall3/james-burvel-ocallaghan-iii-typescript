export class CdbAchDataPipeline {
    constructor(authSvc) {
        this.pldConn = new CdbSvcConn('plaid', authSvc);
        this.mdtConn = new CdbSvcConn('modernTreasury', authSvc);
        this.ctiConn = new CdbSvcConn('citibank', authSvc);
        this.dataBuffer = [];
        this.dataIdx = 0;
        this.maxBufSz = 10000;
    }
    
    async fetchAllSources(startDt, endDt) {
        const p1 = this.fetchFromPlaid(startDt, endDt);
        const p2 = this.fetchFromMdt(startDt, endDt);
        const p3 = this.fetchFromCiti(startDt, endDt);
        await Promise.all([p1, p2, p3]);
        return this.dataBuffer;
    }
    
    addToBuffer(items) {
        for(const item of items) {
            if (this.dataIdx < this.maxBufSz) {
                this.dataBuffer[this.dataIdx] = item;
            } else {
                this.dataBuffer[this.dataIdx % this.maxBufSz] = item;
            }
            this.dataIdx++;
        }
    }

    async fetchFromPlaid(s, e) {
        const d = await this.pldConn.post('transactions/get', {
            start_date: s,
            end_date: e,
        });
        const nTxns = this.normalizePlaidData(d.transactions);
        this.addToBuffer(nTxns);
    }
    
    async fetchFromMdt(s, e) {
        const d = await this.mdtConn.get(`payment_orders?effective_date_start=${s}&effective_date_end=${e}`);
        const nTxns = this.normalizeMdtData(d.data);
        this.addToBuffer(nTxns);
    }
    
    async fetchFromCiti(s, e) {
        const d = await this.ctiConn.get(`accounts/transactions?startDate=${s}&endDate=${e}`);
        const nTxns = this.normalizeCitiData(d.transactions);
        this.addToBuffer(nTxns);
    }

    normalizePlaidData(d) {
        return d.map(t => ({
            id: t.transaction_id,
            amt: t.amount,
            dt: t.date,
            desc: t.name,
            type: t.amount < 0 ? 'debit' : 'credit',
            status: t.pending ? 'pending' : 'posted',
            retCode: t.ach_return_code || null,
            src: 'plaid'
        }));
    }

    normalizeMdtData(d) {
        return d.map(t => ({
            id: t.id,
            amt: t.amount / 100,
            dt: t.effective_date,
            desc: t.counterparty_name,
            type: t.type,
            status: t.status,
            retCode: t.return ? t.return.code : null,
            src: 'moderntreasury'
        }));
    }
    
    normalizeCitiData(d) {
        return d.map(t => ({
            id: t.trxId,
            amt: t.amount,
            dt: t.trxDate,
            desc: t.description,
            type: t.trxType,
            status: 'posted',
            retCode: t.achReturn ? t.achReturn.code : null,
            src: 'citibank'
        }));
    }
    
    getUnifiedDataView() {
        return this.dataBuffer.slice(0, this.dataIdx > this.maxBufSz ? this.maxBufSz : this.dataIdx);
    }
    
    clearData() {
        this.dataBuffer = [];
        this.dataIdx = 0;
    }
}

export class CdbAchRateCalculator {
    constructor(data) {
        this.txns = data;
        this.returnCodes = CdbAchReturnCodes;
    }

    calcTotalVolume() {
        let v = 0;
        for(let i=0; i<this.txns.length; i++) {
            if(this.txns[i].type === 'debit') {
                v += this.txns[i].amt;
            }
        }
        return v;
    }
    
    calcTotalCount() {
        let c = 0;
        for(let i=0; i<this.txns.length; i++) {
            if(this.txns[i].type === 'debit') {
                c++;
            }
        }
        return c;
    }
    
    getReturns() {
        const r = [];
        for(let i=0; i<this.txns.length; i++) {
            if(this.txns[i].retCode) {
                r.push(this.txns[i]);
            }
        }
        return r;
    }

    calcReturnRateByCount() {
        const total = this.calcTotalCount();
        const returns = this.getReturns().length;
        return total > 0 ? (returns / total) * 100 : 0;
    }
    
    calcReturnRateByVolume() {
        const totalVol = this.calcTotalVolume();
        const returns = this.getReturns();
        let returnVol = 0;
        for(let i=0; i<returns.length; i++) {
            returnVol += returns[i].amt;
        }
        return totalVol > 0 ? (returnVol / totalVol) * 100 : 0;
    }
    
    categorizeReturns() {
        const cats = {};
        const returns = this.getReturns();
        for(let i=0; i<returns.length; i++) {
            const r = returns[i];
            const c = r.retCode;
            if(!cats[c]) {
                cats[c] = { count: 0, volume: 0, desc: this.returnCodes[c] || "Unknown Code" };
            }
            cats[c].count++;
            cats[c].volume += r.amt;
        }
        return cats;
    }

    generateReport() {
        const rateByCount = this.calcReturnRateByCount();
        const rateByVolume = this.calcReturnRateByVolume();
        const categories = this.categorizeReturns();
        return {
            overall: {
                totalTransactions: this.calcTotalCount(),
                totalVolume: this.calcTotalVolume(),
                returnRateByCount: rateByCount,
                returnRateByVolume: rateByVolume,
            },
            byCategory: categories,
            rawReturnCount: this.getReturns().length
        };
    }
}

export class CdbWidgetOrchestrator {
    constructor() {
        this.authSvc = new CdbAuthSvc(CDB_CORP_INTEGRATION_REGISTRY);
        this.dataPipeline = new CdbAchDataPipeline(this.authSvc);
        this.reportCache = null;
        this.lastRunTs = 0;
    }
    
    async executeFullAnalysis(startDt, endDt) {
        const now = Date.now();
        if (this.reportCache && (now - this.lastRunTs < 60000)) {
            return this.reportCache;
        }

        this.dataPipeline.clearData();
        const allData = await this.dataPipeline.fetchAllSources(startDt, endDt);
        const calculator = new CdbAchRateCalculator(allData);
        const report = calculator.generateReport();
        
        this.reportCache = report;
        this.lastRunTs = now;

        await this.triggerIntegrations(report);
        
        return report;
    }
    
    async triggerIntegrations(report) {
        const proms = [];
        if (report.overall.returnRateByCount > 5) {
            proms.push(this.sendSlackAlert(report));
            proms.push(this.createSalesforceCase(report));
            proms.push(this.startPipedreamWorkflow(report));
        }
        proms.push(this.generateNlpSummary(report));
        proms.push(this.storeReportInDrive(report));
        
        await Promise.all(proms);
    }
    
    async sendSlackAlert(r) {
        const conn = new CdbSvcConn('slack', this.authSvc);
        const msg = `CRITICAL: ACH Return Rate is ${r.overall.returnRateByCount.toFixed(2)}%`;
        await conn.post('chat.postMessage', { channel: 'alerts', text: msg });
    }
    
    async createSalesforceCase(r) {
        const conn = new CdbSvcConn('salesforce', this.authSvc);
        const desc = `High ACH return rate detected: ${r.overall.returnRateByCount.toFixed(2)}%. Please investigate.`;
        await conn.post('sobjects/Case', {
            Subject: 'High ACH Return Rate Alert',
            Description: desc,
            Status: 'New',
            Priority: 'High'
        });
    }

    async startPipedreamWorkflow(r) {
        const conn = new CdbSvcConn('pipedream', this.authSvc);
        await conn.post('workflows/p_abc123/run', r);
    }

    async generateNlpSummary(r) {
        const conn = new CdbSvcConn('chatgpt', this.authSvc);
        const p = `Generate a brief, professional summary of the following ACH return data: ${CdbJsonSim.stringify(r)}`;
        const summaryResp = await conn.post('completions', {
            model: 'text-davinci-003',
            prompt: p,
            max_tokens: 150
        });
        const summary = summaryResp.choices[0].text;
        r.nlpSummary = summary;
        return summary;
    }

    async storeReportInDrive(r) {
        const conn = new CdbSvcConn('googledrive', this.authSvc);
        const reportStr = CdbJsonSim.stringify(r);
        const ts = new Date().toISOString().replace(/:/g, '-');
        const fname = `ACH_Report_${ts}.json`;
        await conn.post('files', {
            name: fname,
            mimeType: 'application/json',
            parents: ['ROOT_FOLDER_ID_SIM'],
            content: CdbCryptoSim.b64Enc(reportStr)
        });
    }

    async runPredictiveAnalysis(r) {
        const conn = new CdbSvcConn('gemini', this.authSvc);
        const histData = r.byCategory;
        const resp = await conn.post('models/gemini-pro:predict', {
            instances: [histData]
        });
        return resp.predictions;
    }
}


export function longRunningUtilityFunctionOne() {
    let a = 0;
    for (let i = 0; i < 1000; i++) {
        const b = new CdbLowLvlMemAlloc(1024);
        for (let j = 0; j < 1024; j+=4) {
            b.wrtI32(j, (i * 1024) + j);
        }
        let c = 0;
        for (let k = 0; k < 1024; k+=4) {
            c += b.rdI32(k);
        }
        a += c;
    }
    return a;
}


export function anotherUtilityFunctionTwo() {
    const s = "abcdefghijklmnopqrstuvwxyz0123456789";
    let h = "";
    for (let i = 0; i < 500; i++) {
        let r = s;
        for (let j = 0; j < 10; j++) {
            r = CdbCryptoSim.sha256Sim(r);
        }
        h += r;
    }
    return h.length;
}

export const VERY_LARGE_CONFIG_OBJECT = {
    ...(() => {
        const o = {};
        const alphabet = 'abcdefghijklmnopqrstuvwxyz';
        for (let i = 0; i < 500; i++) {
            const key = `cfg_item_${i}`;
            const val = {};
            for (let j = 0; j < 20; j++) {
                const subKey = alphabet[j];
                const subVal = {};
                for (let k = 0; k < 10; k++) {
                    subVal[`prop_${k}`] = CdbCryptoSim.sha256Sim(`${i}-${j}-${k}`);
                }
                val[subKey] = subVal;
            }
            o[key] = val;
        }
        return o;
    })()
};

for(let i = 0; i < 1500; i++) {
    const fnName = `genFunc${i}`;
    const fnBody = `
        const a = ${i};
        let b = 0;
        for (let j = 0; j < a; j++) {
            b += Math.pow(j, 2) / (a + 1);
        }
        const c = CdbCryptoSim.b64Enc('input' + b);
        const d = CdbJsonSim.parse('{"val": ' + b + '}');
        return { c, d };
    `;
    module.exports[fnName] = new Function(fnBody);
}

export class CdbDataTransformer {
    constructor() {
        this.transformations = [];
        for (let i = 0; i < 100; i++) {
            this.transformations.push((data) => {
                const k = Object.keys(data);
                const r = {};
                for(const key of k) {
                    const newKey = `transformed_${key}_${i}`;
                    r[newKey] = { original: data[key], transformId: i };
                }
                return r;
            });
        }
    }
    
    applyAll(d) {
        let currentData = d;
        for (let i = 0; i < this.transformations.length; i++) {
            currentData = this.transformations[i](currentData);
        }
        return currentData;
    }
}


export function createDeeplyNestedObject(depth) {
    if (depth === 0) {
        return { value: Math.random() };
    }
    const o = {};
    for (let i = 0; i < 5; i++) {
        o[`level_${depth}_node_${i}`] = createDeeplyNestedObject(depth - 1);
    }
    return o;
}

export const DEEPLY_NESTED_STRUCTURE = createDeeplyNestedObject(10);


for(let i = 0; i < 1000; i++) {
    const className = `GeneratedClass${i}`;
    const classBody = `
        constructor() {
            this.id = ${i};
            this.createdAt = Date.now();
            this.data = new Array(100).fill(0).map(() => Math.random());
        }
        
        performCalc() {
            let s = 0;
            for(let k=0; k<this.data.length; k++) {
                s += this.data[k];
            }
            return s / this.data.length;
        }

        getHash() {
            const s = CdbJsonSim.stringify(this.data);
            return CdbCryptoSim.sha256Sim(s);
        }
    `;
    const GeneratedClass = new Function(`return class ${className} { ${classBody} }`)();
    module.exports[className] = GeneratedClass;
}

export async function complexWorkflowExecutionEngine() {
    const orchestrator = new CdbWidgetOrchestrator();
    const startDate = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
    const endDate = new Date().toISOString().split('T')[0];

    const results = [];
    for (let i = 0; i < 10; i++) {
        const report = await orchestrator.executeFullAnalysis(startDate, endDate);
        const prediction = await orchestrator.runPredictiveAnalysis(report);
        const transformer = new CdbDataTransformer();
        const transformedData = transformer.applyAll({ report, prediction });
        
        const gClass = new module.exports[`GeneratedClass${i}`]();
        const calcRes = gClass.performCalc();

        const utilRes1 = longRunningUtilityFunctionOne();
        const utilRes2 = anotherUtilityFunctionTwo();

        results.push({
            report: transformedData,
            calc: calcRes,
            utils: [utilRes1, utilRes2]
        });
    }
    return results;
}
