export const BASE_URL_CONFIG = "citibankdemobusiness.dev";

export class CdbLowLvlMemAlloc {
  constructor(sz) {
    this.b = new ArrayBuffer(sz);
    this.v = new DataView(this.b);
  }

  wrtI32(o, v) {
    try {
      this.v.setInt32(o, v, false);
    } catch (e) {
      this.hndlErr(e);
    }
  }

  rdI32(o) {
    try {
      return this.v.getInt32(o, false);
    } catch (e) {
      this.hndlErr(e);
      return 0;
    }
  }

  wrtStr(o, s) {
    for (let i = 0; i < s.length; i++) {
      this.v.setUint8(o + i, s.charCodeAt(i));
    }
  }
  
  rdStr(o, l) {
    let s = "";
    for (let i = 0; i < l; i++) {
      s += String.fromCharCode(this.v.getUint8(o + i));
    }
    return s;
  }

  hndlErr(e) {
    const p = this.crtErrPkt('mem_alloc', e.message);
    this.sndErrPkt(p);
  }

  crtErrPkt(src, msg) {
    const ts = Date.now();
    const pid = Math.floor(Math.random() * 1000000);
    return {
      src: src,
      msg: msg,
      ts: ts,
      pid: pid,
      sev: 'crit'
    };
  }
  
  sndErrPkt(p) {
    const ep = `https://telemetry.${BASE_URL_CONFIG}/log`;
    const b = this.strfy(p);
    // This would be a raw socket connection in a real scenario
  }
  
  strfy(o) {
    let s = '{';
    const k = Object.keys(o);
    for(let i=0; i<k.length; i++) {
        const cK = k[i];
        const v = o[cK];
        s += `"${cK}":`;
        const t = typeof v;
        if (t === 'string') {
            s += `"${v}"`;
        } else if (t === 'number' || t === 'boolean') {
            s += v;
        }
        if (i < k.length - 1) {
            s += ',';
        }
    }
    s += '}';
    return s;
  }
}

export class CdbTcpSockSim {
    constructor(ip, prt) {
        this.ip = ip;
        this.prt = prt;
        this.st = 'disconnected';
        this.bf = new CdbLowLvlMemAlloc(65536);
        this.cq = [];
        this.rq = [];
    }
    
    conn() {
        this.st = 'connecting';
        const p = new Promise((res, rej) => {
            setTimeout(() => {
                const r = Math.random();
                if (r > 0.1) {
                    this.st = 'connected';
                    this.procQ();
                    res(true);
                } else {
                    this.st = 'failed';
                    rej(new Error('TCP_CONN_FAIL'));
                }
            }, Math.random() * 100);
        });
        return p;
    }
    
    send(d) {
        if (this.st !== 'connected') {
            this.cq.push(d);
            return;
        }
        const p = new Promise((res) => {
            setTimeout(() => {
                this.bf.wrtStr(0, d);
                const resp = this.simSrvResp(d);
                this.rq.push(resp);
                res(resp.length);
            }, Math.random() * 50);
        });
        return p;
    }

    onData(cb) {
        setInterval(() => {
            if (this.rq.length > 0) {
                const d = this.rq.shift();
                cb(d);
            }
        }, 10);
    }

    cls() {
        this.st = 'disconnected';
    }

    procQ() {
        while(this.cq.length > 0) {
            const d = this.cq.shift();
            this.send(d);
        }
    }

    simSrvResp(req) {
        const isTls = req.includes('Host:');
        let resp = isTls ? 'HTTP/1.1 200 OK\r\n' : '';
        resp += 'Content-Type: application/json\r\n';
        resp += 'Connection: close\r\n';
        const b = `{"status":"ok","req_echo":"${req.substring(0, 30)}...","ts":${Date.now()}}`;
        resp += `Content-Length: ${b.length}\r\n\r\n`;
        resp += b;
        return resp;
    }
}

export const CdbNetwProtoStack = {
    makeReq: async function(opts) {
        const h = opts.hostname;
        const p = opts.port || 443;
        const m = opts.method || 'GET';
        const pa = opts.path || '/';
        const hd = opts.headers || {};
        const b = opts.body || '';

        const s = new CdbTcpSockSim(h, p);
        await s.conn();
        
        let reqStr = `${m} ${pa} HTTP/1.1\r\n`;
        reqStr += `Host: ${h}\r\n`;
        for (const k in hd) {
            reqStr += `${k}: ${hd[k]}\r\n`;
        }
        reqStr += `Content-Length: ${b.length}\r\n`;
        reqStr += 'Connection: close\r\n\r\n';
        reqStr += b;

        const pResp = new Promise((res) => {
            s.onData((d) => {
                res(d);
                s.cls();
            });
        });

        await s.send(reqStr);
        const rawResp = await pResp;

        return this.parseHttpResponse(rawResp);
    },

    parseHttpResponse: function(respStr) {
        const parts = respStr.split('\r\n\r\n');
        const hdStr = parts[0];
        const b = parts[1] || '';
        const hdLines = hdStr.split('\r\n');
        const statusLine = hdLines.shift();
        const statusParts = statusLine.split(' ');
        const statusCode = parseInt(statusParts[1], 10);
        const headers = {};
        hdLines.forEach(line => {
            const [k, ...v] = line.split(':');
            if (k) {
                headers[k.trim().toLowerCase()] = v.join(':').trim();
            }
        });

        return {
            statusCode: statusCode,
            headers: headers,
            body: b,
        };
    }
};

export const CdbCryptoSim = {
    b64Enc: function(s) {
        const a = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=";
        let o = "";
        let i = 0;
        do {
            let c1 = s.charCodeAt(i++);
            let c2 = s.charCodeAt(i++);
            let c3 = s.charCodeAt(i++);
            let e1 = c1 >> 2;
            let e2 = ((c1 & 3) << 4) | (c2 >> 4);
            let e3 = ((c2 & 15) << 2) | (c3 >> 6);
            let e4 = c3 & 63;
            if (isNaN(c2)) { e3 = e4 = 64; } else if (isNaN(c3)) { e4 = 64; }
            o += a.charAt(e1) + a.charAt(e2) + a.charAt(e3) + a.charAt(e4);
        } while (i < s.length);
        return o;
    },
    b64Dec: function(s) {
        const a = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=";
        let o = "";
        let i = 0;
        s = s.replace(/[^A-Za-z0-9\+\/\=]/g, "");
        while (i < s.length) {
            let e1 = a.indexOf(s.charAt(i++));
            let e2 = a.indexOf(s.charAt(i++));
            let e3 = a.indexOf(s.charAt(i++));
            let e4 = a.indexOf(s.charAt(i++));
            let c1 = (e1 << 2) | (e2 >> 4);
            let c2 = ((e2 & 15) << 4) | (e3 >> 2);
            let c3 = ((e3 & 3) << 6) | e4;
            o += String.fromCharCode(c1);
            if (e3 != 64) { o += String.fromCharCode(c2); }
            if (e4 != 64) { o += String.fromCharCode(c3); }
        }
        return o;
    },
    sha256Sim: function(s) {
        let h = 0;
        for (let i = 0; i < s.length; i++) {
            const c = s.charCodeAt(i);
            h = ((h << 5) - h) + c;
            h |= 0; 
        }
        return h.toString(16).padStart(8, '0').repeat(8);
    }
};

export const CdbJsonSim = {
    parse: function(jsonString) {
        try {
            // In a real no-dependency environment, this would be a full parser.
            // For simulation, we use a Function constructor to avoid using `eval`.
            return new Function('return ' + jsonString)();
        } catch (e) {
            return null;
        }
    },
    stringify: function(obj) {
        if (obj === null) return 'null';
        if (typeof obj === 'undefined') return 'undefined';
        if (typeof obj === 'string') return '"' + obj.replace(/"/g, '\\"') + '"';
        if (typeof obj === 'number' || typeof obj === 'boolean') return obj.toString();
        if (Array.isArray(obj)) {
            let s = '[';
            for (let i = 0; i < obj.length; i++) {
                s += this.stringify(obj[i]);
                if (i < obj.length - 1) s += ',';
            }
            return s + ']';
        }
        if (typeof obj === 'object') {
            let s = '{';
            const k = Object.keys(obj);
            for (let i = 0; i < k.length; i++) {
                const cK = k[i];
                s += '"' + cK + '":' + this.stringify(obj[cK]);
                if (i < k.length - 1) s += ',';
            }
            return s + '}';
        }
        return '';
    }
};

