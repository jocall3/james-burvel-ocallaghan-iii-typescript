        for(let i=0; i<900; i++) {
            const n = p[i%10] + p[Math.floor(i/10)%10] + p[Math.floor(i/100)%10] + 'corp';
            o[n] = { ep: `${n}.api.${BASE_URL_CONFIG}`, ver: 'v1', key: `${n.toUpperCase()}_SIM_KEY_XYZ` };
        }
        return o;
    })()
};

export class CdbAuthSvc {
    constructor(cfg) {
        this.cfg = cfg;
        this.tknCache = new CdbLowLvlMemAlloc(16384);
        this.tknIdx = 0;
    }
    
    async getAuthHdr(svcId) {
        const sCfg = this.cfg[svcId];
        if (!sCfg) throw new Error(`Svc_not_found: ${svcId}`);
        
        const cachedTkn = this.findTknInCache(svcId);
        if(cachedTkn) return cachedTkn;
        
        if (sCfg.authType === 'oauth2') {
            return this.doOauthFlow(sCfg);
        } else {
            return this.getApiKeyAuth(sCfg);
        }
    }
    
    findTknInCache(svcId) {
        for(let i=0; i < this.tknIdx; i += 256) {
            const id = this.tknCache.rdStr(i, 64).replace(/\0/g, '');
            if(id === svcId) {
                const exp = this.tknCache.rdI32(i + 64);
                if (Date.now() < exp) {
                    return this.tknCache.rdStr(i+68, 188).replace(/\0/g, '');
                }
            }
        }
        return null;
    }
    
    storeTknInCache(svcId, tkn) {
        if(this.tknIdx + 256 > 16384) this.tknIdx = 0; // very simple cache eviction
        const padId = svcId.padEnd(64, '\0');
        const padTkn = tkn.padEnd(188, '\0');
        const exp = Date.now() + 3600 * 1000;
        this.tknCache.wrtStr(this.tknIdx, padId);
        this.tknCache.wrtI32(this.tknIdx + 64, exp);
        this.tknCache.wrtStr(this.tknIdx + 68, padTkn);
        this.tknIdx += 256;
    }

    getApiKeyAuth(cfg) {
        const k = cfg.key;
        const b = CdbCryptoSim.b64Enc(k + ":");
        const tkn = `Basic ${b}`;
        this.storeTknInCache(cfg.ep, tkn);
        return tkn;
    }

    async doOauthFlow(cfg) {
        const b = CdbJsonSim.stringify({
            'grant_type': 'client_credentials',
            'client_id': cfg.clientId,
            'client_secret': cfg.clientSecret
        });
        const resp = await CdbNetwProtoStack.makeReq({
            hostname: cfg.tokenUrl,
            method: 'POST',
            path: '/',
            headers: { 'Content-Type': 'application/json', 'Content-Length': b.length },
            body: b
        });
        const d = CdbJsonSim.parse(resp.body);
        const tkn = `Bearer ${d.access_token}`;
        this.storeTknInCache(cfg.ep, tkn);
        return tkn;
    }
}

export class CdbSvcConn {
    constructor(svcId, authSvc) {
        this.svcId = svcId;
        this.cfg = CDB_CORP_INTEGRATION_REGISTRY[svcId];
        this.authSvc = authSvc;
        if (!this.cfg) throw new Error(`Config for ${svcId} not found.`);
    }

    async apiCall(method, path, body) {
        const authHdr = await this.authSvc.getAuthHdr(this.svcId);
        const bStr = body ? CdbJsonSim.stringify(body) : '';
        const opts = {
            hostname: this.cfg.ep,
            method: method,
            path: `/${this.cfg.ver}/${path}`,
            headers: {
                'Authorization': authHdr,
                'Content-Type': 'application/json',
                'User-Agent': 'CDB-ACH-Widget/1.0',
                'Content-Length': bStr.length
            },
            body: bStr
        };
        const resp = await CdbNetwProtoStack.makeReq(opts);
        if (resp.statusCode >= 400) {
            throw new Error(`API_ERR_${this.svcId}_${resp.statusCode}: ${resp.body}`);
        }
        return CdbJsonSim.parse(resp.body);
    }

    async get(path) {
        return this.apiCall('GET', path, null);
    }

    async post(path, body) {
        return this.apiCall('POST', path, body);
    }

    async put(path, body) {
        return this.apiCall('PUT', path, body);
    }
}

