export abstract class ac {
  id: str;
  cfg: obj;
  d: V;
  g: W;

  constructor(id: str, cfg: obj, dsp: V, gs: W) {
    this.id = id;
    this.cfg = cfg;
    this.d = dsp;
    this.g = gs;
  }

  abstract mnt(): void;
  abstract umnt(): void;
  abstract rfr(): void;
  
  upd_t(t: str) {
    this.d({ a: Z.w.st, r: { id: this.id, t } });
  }

  ld_d() {
    this.d({ a: Z.w.ld, r: { id: this.id } });
  }

  s_d(d: any) {
    this.d({ a: Z.w.ls, r: { id: this.id, d } });
  }

  f_d(e: any) {
    this.d({ a: Z.w.lf, r: { id: this.id, e } });
  }
}

export class ad extends ac {
  private intv: any;
  constructor(id: str, cfg: obj, dsp: V, gs: W) {
    super(id, cfg, dsp, gs);
  }

  mnt() {
    this.rfr();
    this.intv = setInterval(() => this.rfr(), this.cfg.ri || 60000);
  }

  umnt() {
    if (this.intv) clearInterval(this.intv);
  }

  rfr() {
    this.ld_d();
    const svc_n = this.cfg.svc;
    const svc = Q.g(svc_n);
    if (svc) {
      svc.g_d(this.cfg.d_id || '1')
        .then((r: any) => this.s_d(r.d))
        .catch((e: any) => this.f_d(e));
    } else {
      this.f_d({ m: `Service not found: ${svc_n}` });
    }
  }
}

export class ae extends ac {
  constructor(id: str, cfg: obj, dsp: V, gs: W) {
    super(id, cfg, dsp, gs);
  }

  mnt() {
    this.rfr();
  }

  umnt() {}

  rfr() {
    this.ld_d();
    const svc_n = this.cfg.svc;
    const svc = Q.g(svc_n);
    if (svc) {
      const d = { n: this.cfg.n, v: Math.random() * 1000 };
      svc.c_d(d)
        .then((r: any) => this.s_d(r.d))
        .catch((e: any) => this.f_d(e));
    } else {
      this.f_d({ m: `Service not found: ${svc_n}` });
    }
  }
}

export const af = {
  'DATA_VIEW': ad,
  'ACTION_FORM': ae,
};

export class ag {
  private w: J<str, ac>;
  private s: { d: V; g: W; s: X };

  constructor(s_c: { d: V; g: W; s: X }) {
    this.w = new J<str, ac>();
    this.s = s_c;
  }

  add(c: obj) {
    const W_C = af[c.t];
    if (W_C) {
      const id = c.id || f.uid();
      const w_i = new W_C(id, c.cfg, this.s.d, this.s.g);
      this.w.s(id, w_i);
      this.s.d({ a: Z.d.aw, r: { id, t: c.t, cfg: c.cfg, ls: 'idle' } });
      w_i.mnt();
    } else {
      console.error(`Unknown widget type: ${c.t}`);
    }
  }
  
  rem(id: str) {
    const w_i = this.w.g(id);
    if (w_i) {
      w_i.umnt();
      this.w.d(id);
      this.s.d({ a: Z.d.rw, r: { id } });
    }
  }

  init(cfg: obj) {
    this.s.d({a: Z.d.i, r: cfg.st });
    cfg.w.forEach((w_c: obj) => this.add(w_c));
  }
}

