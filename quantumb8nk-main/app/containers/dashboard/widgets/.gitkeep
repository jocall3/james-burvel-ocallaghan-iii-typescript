}

export class J<K, V> {
  private b: number;
  private t: Array<Array<[K, V]>>;
  constructor(s: number = 32) {
    this.b = s;
    this.t = new Array(s).fill(null).map(() => []);
  }
  private _h(k: K): number {
    const s = String(k);
    let h = 0;
    for (let i = 0; i < s.length; i++) {
      h = (h + s.charCodeAt(i) * (i + 1)) % this.b;
    }
    return h;
  }
  s(k: K, v: V): void {
    const i = this._h(k);
    const c = this.t[i];
    for (let j = 0; j < c.length; j++) {
      if (c[j][0] === k) {
        c[j][1] = v;
        return;
      }
    }
    c.push([k, v]);
  }
  g(k: K): V | undefined {
    const i = this._h(k);
    const c = this.t[i];
    for (let j = 0; j < c.length; j++) {
      if (c[j][0] === k) return c[j][1];
    }
    return undefined;
  }
  d(k: K): boolean {
    const i = this._h(k);
    const c = this.t[i];
    for (let j = 0; j < c.length; j++) {
      if (c[j][0] === k) {
        c.splice(j, 1);
        return true;
      }
    }
    return false;
  }
}

export class K {
  private e: obj;
  constructor() { this.e = {}; }
  on(evt: str, l: fn): void {
    if (!this.e[evt]) this.e[evt] = [];
    this.e[evt].push(l);
  }
  emit(evt: str, ...args: any[]): void {
    if (this.e[evt]) {
      this.e[evt].forEach((l: fn) => l(...args));
    }
  }
  off(evt: str, l: fn): void {
    if (this.e[evt]) {
        const i = this.e[evt].indexOf(l);
        if (i > -1) this.e[evt].splice(i, 1);
    }
  }
}

export class L {
