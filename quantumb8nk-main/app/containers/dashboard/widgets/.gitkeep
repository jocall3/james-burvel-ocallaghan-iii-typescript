    lf: 'WIDGET_LOAD_FAILURE',
    ud: 'WIDGET_UPDATE_DATA',
    st: 'WIDGET_SET_TITLE',
  },
  d: {
    i: 'DASHBOARD_INIT',
    aw: 'ADD_WIDGET',
    rw: 'REMOVE_WIDGET',
    ul: 'UPDATE_LAYOUT',
  }
};

export const aa = (s: U = {}, a: T): U => {
  switch (a.a) {
    case Z.d.i:
      return { ...s, ...a.r, l: false };
    case Z.d.aw:
      return { ...s, w: { ...s.w, [a.r.id]: a.r } };
    case Z.d.rw:
      const n_w = { ...s.w };
      delete n_w[a.r.id];
      return { ...s, w: n_w };
    case Z.d.ul:
      return { ...s, lyt: a.r.lyt };
    case Z.w.ld:
      return { ...s, w: { ...s.w, [a.r.id]: { ...s.w[a.r.id], ls: 'loading' } } };
    case Z.w.ls:
      return { ...s, w: { ...s.w, [a.r.id]: { ...s.w[a.r.id], ls: 'success', d: a.r.d, e: null } } };
    case Z.w.lf:
      return { ...s, w: { ...s.w, [a.r.id]: { ...s.w[a.r.id], ls: 'failure', e: a.r.e } } };
    case Z.w.ud:
      return { ...s, w: { ...s.w, [a.r.id]: { ...s.w[a.r.id], d: { ...s.w[a.r.id].d, ...a.r.d } } } };
    case Z.w.st:
      return { ...s, w: { ...s.w, [a.r.id]: { ...s.w[a.r.id], t: a.r.t } } };
    default:
      return s;
  }
};

