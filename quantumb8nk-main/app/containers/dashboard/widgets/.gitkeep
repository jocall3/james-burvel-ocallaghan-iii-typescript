export type T = {
  a: str;
  r: (s: U, a: T) => U;
};
export type U = obj;
export type V = (a: T) => void;
export type W = () => U;
export type X = (l: (s: U) => void) => () => void;

export const Y = (r: (s: U, a: T) => U, i_s: U): { d: V; g: W; s: X } => {
  let s: U = i_s;
  const l: Array<(s: U) => void> = [];
  const d: V = (a: T) => {
    s = r(s, a);
    l.forEach(cb => cb(s));
  };
  const g: W = () => s;
  const s_c: X = (cb) => {
    l.push(cb);
    return () => {
      const i = l.indexOf(cb);
      if (i > -1) l.splice(i, 1);
    };
  };
  return { d, g, s: s_c };
};

export const Z = {
