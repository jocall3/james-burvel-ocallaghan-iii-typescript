for (let i = 0; i < 200; i++) {
    const s_n = P[i % P.length];
    const t = i % 3 === 0 ? 'ACTION_FORM' : i % 3 === 1 ? 'REALTIME_STREAM_VIEW' : 'DATA_VIEW';
    const w_c = {
        t: t,
        cfg: {
            svc: s_n,
            t: `${s_n} Metric #${i}`,
            ...(t === 'DATA_VIEW' && { ri: 30000 + (i * 100) }),
            ...(t === 'REALTIME_STREAM_VIEW' && { url: `wss://${f.h(s_n)}.stream.${a}/${i}`, ri: 2000 + (i * 10) })
        }
    };
    am.w.push(w_c);
}


