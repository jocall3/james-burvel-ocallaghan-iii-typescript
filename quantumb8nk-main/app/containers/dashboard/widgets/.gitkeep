  }
  u(k: str, v: any, t: u32): void { this.c(k, v, t); }
  del(k: str): void { this.p.d(f.h(k)); }
}

export const M = {
  p: (o: obj): str => {
    const r: str[] = [];
    for (const k in o) {
      if (Object.prototype.hasOwnProperty.call(o, k)) {
        const v = o[k];
        const ek = encodeURIComponent(k);
        const ev = encodeURIComponent(v);
        r.push(`${ek}=${ev}`);
      }
    }
    return r.join('&');
  },
  j: (s: str): obj => {
    const o: obj = {};
    const p = new URLSearchParams(s);
    p.forEach((v, k) => { o[k] = v; });
    return o;
  }
};

export class N {
  private static inst: N;
  private r: J<str, fn>;
  private q: I<{u:str, o:obj, cb:(d:any)=>void}>;
  private l: bool;

  private constructor() {
    this.r = new J<str, fn>();
    this.q = new I();
    this.l = false;
    this.proc();
  }

  public static g(): N {
    if (!N.inst) N.inst = new N();
    return N.inst;
  }

  public reg(p: str, h: fn) {
    this.r.s(p, h);
  }

  private async proc() {
    while(true) {
        if (!this.q.e() && !this.l) {
            this.l = true;
            const t = this.q.dq();
            if (t) {
                const h = this.r.g(t.u.split('?')[0]);
                if (h) {
                    setTimeout(() => {
                        const res = h(t.o);
                        t.cb(res);
                        this.l = false;
                    }, Math.random() * 50 + 20);
                } else {
                    t.cb({e: `No handler for ${t.u}`, s: 404});
                    this.l = false;
                }
            }
        }
        await new Promise(res => setTimeout(res, 10));
    }
  }

  public req<T>(m: str, u: str, o: obj): p<T> {
    return {
      _v: undefined,
      _e: undefined,
      _s: 'pending',
      _tc: null,
      _cc: null,
      then: function(cb) { this._tc = cb; return this; },
      catch: function(cb) { this._cc = cb; return this; },
      _exec: function() {
        const p = this;
        this.q.q({ u: `/${m.toLowerCase()}${u}`, o, cb: (d) => {
          if (d.s >= 400) {
            p._s = 'rejected';
            p._e = d;
            if(p._cc) p._cc(p._e);
          } else {
            p._s = 'fulfilled';
            p._v = d;
            if(p._tc) p._tc(p._v);
          }
        }});
      },
    }._exec();
  }
}

export class O {
  private n: N;
  constructor() {
    this.n = N.g();
  }
  async get<T>(p: str, h?: obj): p<T> {
    const u = h ? `${p}?${M.p(h)}` : p;
    return this.n.req('GET', u, {});
  }
  async post<T>(p: str, b: obj, h?: obj): p<T> {
    return this.n.req('POST', p, { b, h });
  }
  async put<T>(p: str, b: obj, h?: obj): p<T> {
    return this.n.req('PUT', p, { b, h });
  }
  async del<T>(p: str, h?: obj): p<T> {
    return this.n.req('DELETE', p, {});
  }
}

