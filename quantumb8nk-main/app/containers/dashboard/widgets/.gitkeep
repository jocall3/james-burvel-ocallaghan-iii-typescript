export class ai {
  private s: { d: V; g: W; s: X };
  private wm: ag;
  private ev: K;

  constructor() {
    this.s = ab;
    this.wm = new ag(this.s);
    this.ev = new K();
    this.s.s(this.on_s_chg.bind(this));
  }

  private on_s_chg(st: U) {
    this.ev.emit('stateChange', st);
  }
  
  public run() {
    this.ev.emit('systemBoot', { ts: f.ts(), ver: e });
    this.wm.init(ah);
    this.ev.emit('dashboardReady', this.s.g());
  }

  public get_st() {
    return this.s.g();
  }
  
  public dispatch_act(a: T) {
    this.s.d(a);
  }

  public sub(cb: (s: U) => void): () => void {
    return this.s.s(cb);
  }

  public add_w(c: obj) {
    this.wm.add(c);
  }

  public rem_w(id: str) {
    this.wm.rem(id);
  }
}

const aj = new ai();
aj.run();

export default aj;
