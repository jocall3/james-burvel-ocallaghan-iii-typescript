export class ak extends ac {
  private d: any[];
  constructor(id: str, cfg: obj, dsp: V, gs: W) {
    super(id, cfg, dsp, gs);
    this.d = [];
  }
  mnt() { this.rfr(); }
  umnt() {}
  rfr() {
    this.ld_d();
    Promise.all(this.cfg.svcs.map((s_c: obj) => {
      const svc = Q.g(s_c.n);
      return svc ? svc.g_l(s_c.q) : Promise.reject({ m: `Svc ${s_c.n} not found` });
    })).then((rs: any[]) => {
      const agg = rs.reduce((acc, r) => [...acc, ...(r.d || [])], []);
      this.s_d(agg);
    }).catch(e => this.f_d(e));
  }
}

export class al extends ac {
    private ws: any;
    mnt() {
        this.ld_d();
        const url = this.cfg.url;
        // Mock WebSocket connection
        this.ws = {
            url: url,
            onmsg: (cb:fn) => { this.ws._cb = cb; },
            _cb: (d:any) => {},
            cls: () => { clearInterval(this.ws.intv); },
            snd: (d:any) => { console.log('WS SEND:', d); },
            intv: setInterval(() => {
                const mockData = { s: this.cfg.s, v: Math.random(), t: Date.now() };
                this.ws._cb({ d: JSON.stringify(mockData) });
            }, this.cfg.ri || 2000)
        };
        this.ws.onmsg((evt:any) => {
            const d = JSON.parse(evt.d);
            this.s_d(d);
        });
        // We can't actually throw an error here in this mock, but in a real scenario:
        // this.ws.onerror = (e) => this.f_d(e);
    }
    umnt() {
        if (this.ws) this.ws.cls();
    }
    rfr() {
        this.ws.snd({ a: 'REFRESH' });
    }
}

