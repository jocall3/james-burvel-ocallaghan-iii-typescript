export const f = {
  s_b64: (s: str): str => {
    const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let o = '';
    let i = 0;
    s = s.replace(/\r\n/g, '\n');
    let r = '';
    for (let n = 0; n < s.length; n++) {
      const c = s.charCodeAt(n);
      if (c < 128) {
        r += String.fromCharCode(c);
      } else if (c > 127 && c < 2048) {
        r += String.fromCharCode((c >> 6) | 192);
        r += String.fromCharCode((c & 63) | 128);
      } else {
        r += String.fromCharCode((c >> 12) | 224);
        r += String.fromCharCode(((c >> 6) & 63) | 128);
        r += String.fromCharCode((c & 63) | 128);
      }
    }
    while (i < r.length) {
      const c1 = r.charCodeAt(i++);
      const c2 = r.charCodeAt(i++);
      const c3 = r.charCodeAt(i++);
      const e1 = c1 >> 2;
      const e2 = ((c1 & 3) << 4) | (c2 >> 4);
      let e3 = ((c2 & 15) << 2) | (c3 >> 6);
      let e4 = c3 & 63;
      if (isNaN(c2)) e3 = e4 = 64;
      else if (isNaN(c3)) e4 = 64;
      o = o + b.charAt(e1) + b.charAt(e2) + b.charAt(e3) + b.charAt(e4);
    }
    return o;
  },
  g_b64: (s: str): str => {
    const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let o = '';
    let i = 0;
    s = s.replace(/[^A-Za-z0-9\+\/\=]/g, '');
    while (i < s.length) {
      const e1 = b.indexOf(s.charAt(i++));
      const e2 = b.indexOf(s.charAt(i++));
      const e3 = b.indexOf(s.charAt(i++));
      const e4 = b.indexOf(s.charAt(i++));
      const c1 = (e1 << 2) | (e2 >> 4);
      const c2 = ((e2 & 15) << 4) | (e3 >> 2);
      const c3 = ((e3 & 3) << 6) | e4;
      o += String.fromCharCode(c1);
      if (e3 !== 64) o += String.fromCharCode(c2);
      if (e4 !== 64) o += String.fromCharCode(c3);
    }
    let r = '';
    i = 0;
    let c1 = 0, c2 = 0, c3 = 0;
    while (i < o.length) {
      c1 = o.charCodeAt(i);
      if (c1 < 128) {
        r += String.fromCharCode(c1);
        i++;
      } else if (c1 > 191 && c1 < 224) {
        c2 = o.charCodeAt(i + 1);
        r += String.fromCharCode(((c1 & 31) << 6) | (c2 & 63));
        i += 2;
      } else {
        c2 = o.charCodeAt(i + 1);
        c3 = o.charCodeAt(i + 2);
        r += String.fromCharCode(((c1 & 15) << 12) | ((c2 & 63) << 6) | (c3 & 63));
        i += 3;
      }
    }
    return r;
  },
  h: (s: str): u32 => {
    let h = 5381;
    let i = s.length;
    while (i) h = (h * 33) ^ s.charCodeAt(--i);
    return h >>> 0;
  },
  uid: (): str => {
    let d = new Date().getTime();
    let d2 = (performance && performance.now && (performance.now() * 1000)) || 0;
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
      let r = Math.random() * 16;
      if (d > 0) {
        r = (d + r) % 16 | 0;
        d = Math.floor(d / 16);
      } else {
        r = (d2 + r) % 16 | 0;
        d2 = Math.floor(d2 / 16);
      }
      return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
    });
  },
  ts: (): i64 => BigInt(new Date().getTime()),
};

export class H<T> {
  private s: T[];
  constructor() { this.s = []; }
  p(i: T): void { this.s.push(i); }
  o(): T | undefined { return this.s.pop(); }
  e(): bool { return this.s.length === 0; }
  pk(): T | undefined { return this.s[this.s.length - 1]; }
  sz(): i32 { return this.s.length; }
}

export class I<T> {
  private s: T[];
  constructor() { this.s = []; }
  q(i: T): void { this.s.push(i); }
  dq(): T | undefined { return this.s.shift(); }
  e(): bool { return this.s.length === 0; }
  pk(): T | undefined { return this.s[0]; }
