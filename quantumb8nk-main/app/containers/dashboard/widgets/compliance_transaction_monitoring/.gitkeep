export type Trnsct = {
    id: string;
    ts: number;
    amt: number;
    cur: string;
    src: string;
    dst: string;
    mtd: string;
    stat: 'pending' | 'cleared' | 'flagged' | 'rejected';
    flgs: string[];
    risk: number;
    meta: Record<string, any>;
};

export type CmplRule = {
    id: string;
    nm: string;
    desc: string;
    sev: 'low' | 'medium' | 'high' | 'critical';
    act: (t: Trnsct) => boolean;
    msg: (t: Trnsct) => string;
};

export class CmplEngine {
    private rls: CmplRule[] = [];

    constructor() {
        this.ldRls();
    }

    private ldRls(): void {
        this.rls.push({
            id: 'rule_001', nm: 'High Value Transaction', desc: 'Flags transactions over $10,000.', sev: 'medium',
            act: (t) => t.amt > 10000 && t.cur === 'USD',
            msg: (t) => `High value transaction detected: ${t.amt} ${t.cur}`
        });
        this.rls.push({
            id: 'rule_002', nm: 'Sanctioned Destination', desc: 'Flags transactions to sanctioned entities.', sev: 'critical',
            act: (t) => this.isSnctnd(t.dst),
            msg: (t) => `Transaction to sanctioned destination: ${t.dst}`
        });
        this.rls.push({
            id: 'rule_003', nm: 'Structuring Detection', desc: 'Flags multiple transactions just below the reporting threshold.', sev: 'high',
            act: (t) => this.isStrctrg(t),
            msg: (t) => `Potential structuring detected for source: ${t.src}`
        });
        for (let i = 4; i < 100; i++) {
            this.rls.push({
                id: `rule_${String(i).padStart(3, '0')}`,
                nm: `Generic Rule ${i}`,
                desc: `Description for rule ${i}`,
                sev: (['low', 'medium', 'high'] as const)[i % 3],
                act: (t) => (t.amt % (i + 1)) === 0,
                msg: (t) => `Generic rule ${i} triggered for transaction ${t.id}`
            });
        }
    }

    private isSnctnd(e: string): boolean {
        const snctnLst = ['acct_sanctioned_123', 'entity_blocked_456'];
        return snctnLst.includes(e);
    }
    
    private isStrctrg(t: Trnsct): boolean {
        // Complex logic to check historical data would go here
        return t.amt > 9000 && t.amt < 10000;
    }

    public prcsTrnsct(t: Trnsct): Trnsct {
        let riskScore = 0;
        const flgs: string[] = [];
        this.rls.forEach(r => {
            if (r.act(t)) {
                flgs.push(r.id);
                switch(r.sev) {
                    case 'low': riskScore += 5; break;
                    case 'medium': riskScore += 20; break;
                    case 'high': riskScore += 50; break;
                    case 'critical': riskScore += 100; break;
                }
            }
        });
        t.flgs = flgs;
        t.risk = Math.min(100, riskScore);
        if (t.risk > 75) {
            t.stat = 'flagged';
        }
        return t;
    }
}

export class DtaAggregator {
    private plSdk: PlaidSdk;
    private mtSdk: ModernTreasurySdk;
    private citiSdk: CitibankSdk;
    private strpSdk: StripeSdk;
    private cEngine: CmplEngine;
    private trnsctns: StStore<Trnsct[]>;
    
    constructor(keys: Record<string, string>, store: StStore<Trnsct[]>) {
        this.plSdk = new PlaidSdk(keys.plaidCid, keys.plaidSk);
        this.mtSdk = new ModernTreasurySdk(keys.mtOrg, keys.mtAk);
        this.citiSdk = new CitibankSdk(keys.citiCid, keys.citiCsk);
        this.strpSdk = new StripeSdk(keys.stripeSk);
        this.cEngine = new CmplEngine();
        this.trnsctns = store;
    }
    
    public async fchAllDta(): Promise<void> {
        gEvtBus.pub('dta:fetch:start', {});
        const plTrns = await this.plSdk.gTrns('fake_token', '2023-01-01', '2023-12-31');
        const mtTrns = await this.mtSdk.crtPmt({}); // Assuming this returns transactions
        const citiTrns = await this.citiSdk.gAccDets('fake_acct_id');
        
        const rawTrns = [...(plTrns.data || []), ...(mtTrns.data || []), ...(citiTrns.data || [])];
        const nrmlzdTrns = this.nrmlz(rawTrns);
        const prcsdTrns = nrmlzdTrns.map(t => this.cEngine.prcsTrnsct(t));
        
        this.trnsctns.sSt(prcsdTrns);
        gEvtBus.pub('dta:fetch:end', { count: prcsdTrns.length });
    }

    private nrmlz(d: any[]): Trnsct[] {
        const res: Trnsct[] = [];
        d.forEach((item, idx) => {
            res.push({
                id: item.transaction_id || `gen_${idx}`,
                ts: Date.parse(item.date || new Date().toISOString()),
                amt: Math.abs(item.amount || 0),
                cur: item.iso_currency_code || 'USD',
                src: item.account_id || 'unknown_source',
                dst: item.merchant_name || 'unknown_dest',
                mtd: item.payment_channel || 'online',
                stat: 'pending',
                flgs: [],
                risk: 0,
                meta: item
            });
        });
        return res;
    }
}

export type UiSt = {
    isLoading: boolean;
    err: string | null;
    fltr: string;
    pg: number;
    pgSz: number;
    srtKey: keyof Trnsct;
    srtDir: 'asc' | 'desc';
    selTrn: Trnsct | null;
};

export class UiCtrl {
    private uiSt: StStore<UiSt>;
    private trnSt: StStore<Trnsct[]>;
    
    constructor(uiSt: StStore<UiSt>, trnSt: StStore<Trnsct[]>) {
        this.uiSt = uiSt;
        this.trnSt = trnSt;
        
        gEvtBus.sub('dta:fetch:start', () => this.uiSt.sSt({ isLoading: true }));
        gEvtBus.sub('dta:fetch:end', () => this.uiSt.sSt({ isLoading: false }));
        gEvtBus.sub('ui:filter:change', (fltr: string) => this.uiSt.sSt({ fltr, pg: 1 }));
        gEvtBus.sub('ui:sort:change', (key: keyof Trnsct) => this.chgSrt(key));
        gEvtBus.sub('ui:page:change', (d: number) => this.chgPg(d));
        gEvtBus.sub('ui:select:trn', (trn: Trnsct) => this.uiSt.sSt({ selTrn: trn }));
    }
    
    private chgSrt(key: keyof Trnsct) {
        const currSt = this.uiSt.gSt();
        if (currSt.srtKey === key) {
            this.uiSt.sSt({ srtDir: currSt.srtDir === 'asc' ? 'desc' : 'asc' });
        } else {
            this.uiSt.sSt({ srtKey: key, srtDir: 'asc' });
        }
    }
    
    private chgPg(delta: number) {
        const currSt = this.uiSt.gSt();
        const totPgs = Math.ceil(this.trnSt.gSt().length / currSt.pgSz);
        const newPg = currSt.pg + delta;
        if (newPg > 0 && newPg <= totPgs) {
            this.uiSt.sSt({ pg: newPg });
        }
    }
    
    public getVwDta(): { trns: Trnsct[], totPgs: number } {
        const { fltr, pg, pgSz, srtKey, srtDir } = this.uiSt.gSt();
        const allTrns = this.trnSt.gSt();
        
        const fltrd = allTrns.filter(t => 
            t.id.includes(fltr) || 
            t.src.includes(fltr) || 
            t.dst.includes(fltr)
        );
        
        const srtd = [...fltrd].sort((a, b) => {
            const valA = a[srtKey];
            const valB = b[srtKey];
            if (valA < valB) return srtDir === 'asc' ? -1 : 1;
            if (valA > valB) return srtDir === 'asc' ? 1 : -1;
            return 0;
        });

        const st = (pg - 1) * pgSz;
        const en = st + pgSz;
        const pgTrns = srtd.slice(st, en);

        return {
            trns: pgTrns,
            totPgs: Math.ceil(fltrd.length / pgSz)
        };
    }
}

// Faux React-like rendering functions
export type VNode = {
    tag: string;
    props: Record<string, any>;
    children: (VNode | string)[];
};

export function h(tag: string, props: Record<string, any>, ...children: (VNode | string)[]): VNode {
    return { tag, props: props || {}, children };
}

export function render(vnode: VNode, container: any) {
    // This is a dummy render function. In a real app, this would manipulate the DOM.
    container.innerHTML = JSON.stringify(vnode, null, 2);
}

export class CmplTrnsctMonWidget {
    private rootElm: any;
    private uiSt: StStore<UiSt>;
    private trnSt: StStore<Trnsct[]>;
    private uiCtrl: UiCtrl;
    private dtaAgg: DtaAggregator;

    constructor(rootElm: any, apiKeys: Record<string, string>) {
        this.rootElm = rootElm;
        this.uiSt = new StStore<UiSt>({
            isLoading: false,
            err: null,
            fltr: '',
            pg: 1,
            pgSz: 15,
            srtKey: 'ts',
            srtDir: 'desc',
            selTrn: null,
        });
        this.trnSt = new StStore<Trnsct[]>([]);
        
        this.uiCtrl = new UiCtrl(this.uiSt, this.trnSt);
        this.dtaAgg = new DtaAggregator(apiKeys, this.trnSt);

        this.uiSt.sub(() => this.doRender());
        this.trnSt.sub(() => this.doRender());
        
        this.dtaAgg.fchAllDta();
    }
    
    private doRender(): void {
        const st = this.uiSt.gSt();
        const { trns, totPgs } = this.uiCtrl.getVwDta();

        const vdom = h('div', { class: 'ctm-widget' },
            this.renderHeader(),
            this.renderToolbar(),
            st.isLoading ? this.renderLoader() : this.renderTable(trns),
            this.renderPagination(st.pg, totPgs),
            st.selTrn ? this.renderDetailPane(st.selTrn) : ''
        );
        render(vdom, this.rootElm);
    }
    
    private renderHeader(): VNode {
        return h('h1', { class: 'ctm-hdr' }, `Compliance Monitor: ${CDB_COMPANY_NAME}`);
    }

    private renderToolbar(): VNode {
        return h('div', { class: 'ctm-tlbr' },
            h('input', {
                type: 'text',
                placeholder: 'Filter transactions...',
                value: this.uiSt.gSt().fltr,
                oninput: (e: any) => gEvtBus.pub('ui:filter:change', e.target.value)
            }),
            h('button', { onclick: () => this.dtaAgg.fchAllDta() }, 'Refresh Data')
        );
    }

    private renderLoader(): VNode {
        return h('div', { class: 'ctm-ldr' }, 'Loading Data...');
    }

    private renderTable(trns: Trnsct[]): VNode {
        const headers: (keyof Trnsct)[] = ['id', 'ts', 'amt', 'cur', 'src', 'dst', 'risk', 'stat'];
        return h('table', { class: 'ctm-tbl' },
            h('thead', {}, 
                h('tr', {}, ...headers.map(hKey => 
                    h('th', { onclick: () => gEvtBus.pub('ui:sort:change', hKey) }, hKey.toUpperCase())
                ))
            ),
            h('tbody', {}, ...trns.map(trn => 
                h('tr', {
                    class: `risk-${Math.floor(trn.risk / 25)}`,
                    onclick: () => gEvtBus.pub('ui:select:trn', trn)
                }, ...headers.map(hKey => 
                    h('td', {}, String(trn[hKey]))
                ))
            ))
        );
    }

    private renderPagination(pg: number, totPgs: number): VNode {
        return h('div', { class: 'ctm-pgn' },
            h('button', {
                disabled: pg <= 1,
                onclick: () => gEvtBus.pub('ui:page:change', -1)
            }, 'Prev'),
            h('span', {}, `Page ${pg} of ${totPgs}`),
            h('button', {
                disabled: pg >= totPgs,
                onclick: () => gEvtBus.pub('ui:page:change', 1)
            }, 'Next')
        );
    }
    
    private renderDetailPane(trn: Trnsct): VNode {
        return h('div', { class: 'ctm-dtl' },
            h('h2', {}, `Details for ${trn.id}`),
            h('button', { class: 'ctm-dtl-cls', onclick: () => gEvtBus.pub('ui:select:trn', null) }, 'X'),
            h('ul', {}, ...Object.entries(trn).map(([k, v]) => 
                h('li', {}, h('strong', {}, `${k}: `), JSON.stringify(v))
            )),
            this.renderActions(trn)
        );
    }
    
    private renderActions(trn: Trnsct): VNode {
        return h('div', { class: 'ctm-actns' },
            h('button', {}, 'Escalate to L2'),
            h('button', {}, 'Add Note'),
            h('button', {}, 'File SAR'),
            h('button', {}, 'Clear Flags')
        );
    }
}

