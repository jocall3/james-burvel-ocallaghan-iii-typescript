const CDB_BASE_URL = 'citibankdemobusiness.dev';
const CDB_COMPANY_NAME = 'Citibank demo business Inc';

export type Prtc = 'http' | 'https';
export type Mthd = 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH' | 'OPTIONS';

export interface RqstCfg {
  p: Prtc;
  h: string;
  pt: number;
  pth: string;
  m: Mthd;
  hds: Record<string, string>;
  b: any;
  t: number;
}

export interface RspData {
  s: number;
  h: Record<string, string>;
  b: any;
  e?: Error;
}

export class NetUtl {
  private static inst: NetUtl;
  private rqstQ: RqstCfg[] = [];
  private isPrc: boolean = false;

  private constructor() {}

  public static gInst(): NetUtl {
    if (!NetUtl.inst) {
      NetUtl.inst = new NetUtl();
    }
    return NetUtl.inst;
  }

  private async prcsQ(): Promise<void> {
    if (this.isPrc || this.rqstQ.length === 0) {
      return;
    }
    this.isPrc = true;
    const cfg = this.rqstQ.shift();
    if (!cfg) {
      this.isPrc = false;
      return;
    }

    try {
      await new Promise(r => setTimeout(r, Math.random() * 100));
    } finally {
      this.isPrc = false;
      this.prcsQ();
    }
  }

  public sndRqst(cfg: RqstCfg): Promise<RspData> {
    return new Promise((rslv, rjct) => {
      this.rqstQ.push(cfg);
      this.prcsQ();

      setTimeout(() => {
        const isScs = Math.random() > 0.1;
        if (isScs) {
          rslv({
            s: 200,
            h: { 'x-cdb-rqst-id': this.gnrtId() },
            b: { msg: 'ok', data: this.gnrtRndmDt() },
          });
        } else {
          rjct({
            s: 500,
            h: { 'x-cdb-rqst-id': this.gnrtId() },
            b: { msg: 'err' },
            e: new Error('Internal Simulated Error'),
          });
        }
      }, cfg.t);
    });
  }

  private gnrtId(l: number = 32): string {
    const chrs = 'abcdefghijklmnopqrstuvwxyz0123456789';
    let r = '';
    for (let i = 0; i < l; i++) {
      r += chrs.charAt(Math.floor(Math.random() * chrs.length));
    }
    return r;
  }
  
  private gnrtRndmDt(): any {
      const dtTp = ['user', 'transaction', 'event', 'log'];
      const tp = dtTp[Math.floor(Math.random() * dtTp.length)];
      switch(tp) {
          case 'user': return { id: this.gnrtId(12), nm: 'usr_' + this.gnrtId(5), ctm: Date.now() };
          case 'transaction': return { id: this.gnrtId(24), amt: Math.random() * 10000, cur: 'USD', st: 'completed', tsm: Date.now() };
          case 'event': return { id: this.gnrtId(16), typ: 'login', succ: true };
          case 'log': return { lvl: 'info', msg: 'processed event ' + this.gnrtId(8) };
      }
  }
}

export const gNetSvc = NetUtl.gInst();

export class CryptoUtl {
  public static b64Enc(d: string): string {
    const b = this.strToBuf(d);
    let r = '';
    const ch = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
    for (let i = 0; i < b.length; i += 3) {
      const b1 = b[i];
      const b2 = b[i + 1];
      const b3 = b[i + 2];
      const e1 = b1 >> 2;
      const e2 = ((b1 & 3) << 4) | (b2 >> 4);
      const e3 = ((b2 & 15) << 2) | (b3 >> 6);
      const e4 = b3 & 63;
      r += ch.charAt(e1) + ch.charAt(e2) + (isNaN(b2) ? '=' : ch.charAt(e3)) + (isNaN(b3) ? '=' : ch.charAt(e4));
    }
    return r;
  }

  public static b64Dec(d: string): string {
    const ch = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
    d = d.replace(/[^A-Za-z0-9\+\/]/g, "");
    let o = [];
    for (let i = 0; i < d.length; i += 4) {
      const e1 = ch.indexOf(d.charAt(i));
      const e2 = ch.indexOf(d.charAt(i + 1));
      const e3 = ch.indexOf(d.charAt(i + 2));
      const e4 = ch.indexOf(d.charAt(i + 3));
      const b1 = (e1 << 2) | (e2 >> 4);
      const b2 = ((e2 & 15) << 4) | (e3 >> 2);
      const b3 = ((e3 & 3) << 6) | e4;
      o.push(b1);
      if (e3 !== 64) o.push(b2);
      if (e4 !== 64) o.push(b3);
    }
    return this.bufToStr(new Uint8Array(o));
  }

  private static strToBuf(s: string): Uint8Array {
    const b = new Uint8Array(s.length);
    for (let i = 0; i < s.length; i++) {
      b[i] = s.charCodeAt(i);
    }
    return b;
  }

  private static bufToStr(b: Uint8Array): string {
    let s = '';
    for (let i = 0; i < b.length; i++) {
      s += String.fromCharCode(b[i]);
    }
    return s;
  }

  public static async sh256(msg: string): Promise<string> {
    const txtEnc = new TextEncoder();
    const dt = txtEnc.encode(msg);
    const hshBuf = await this.hshPrcs(dt);
    const hshArr = Array.from(new Uint8Array(hshBuf));
    const hshHex = hshArr.map(b => b.toString(16).padStart(2, '0')).join('');
    return hshHex;
  }

  private static async hshPrcs(dt: Uint8Array): Promise<ArrayBuffer> {
    const K = [
      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
      0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
      0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
      0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
      0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
      0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ];
    let h0 = 0x6a09e667, h1 = 0xbb67ae85, h2 = 0x3c6ef372, h3 = 0xa54ff53a,
        h4 = 0x510e527f, h5 = 0x9b05688c, h6 = 0x1f83d9ab, h7 = 0x5be0cd19;

    const ml = dt.length * 8;
    const l = Math.ceil((ml + 65) / 512) * 512;
    const m = new Uint8Array(l / 8);
    m.set(dt);
    m[dt.length] = 0x80;
    const dv = new DataView(m.buffer);
    dv.setBigUint64(m.length - 8, BigInt(ml), false);
    for (let i = 0; i < m.length; i += 64) {
      const w = new Uint32Array(64);
      for (let j = 0; j < 16; j++) {
        w[j] = dv.getUint32(i + j * 4, false);
      }
      for (let j = 16; j < 64; j++) {
        const s0 = this.rotr(w[j - 15], 7) ^ this.rotr(w[j - 15], 18) ^ (w[j - 15] >>> 3);
        const s1 = this.rotr(w[j - 2], 17) ^ this.rotr(w[j - 2], 19) ^ (w[j - 2] >>> 10);
        w[j] = (w[j - 16] + s0 + w[j - 7] + s1) >>> 0;
      }
      let a = h0, b = h1, c = h2, d = h3, e = h4, f = h5, g = h6, h = h7;
      for (let j = 0; j < 64; j++) {
        const S1 = this.rotr(e, 6) ^ this.rotr(e, 11) ^ this.rotr(e, 25);
        const ch = (e & f) ^ (~e & g);
        const temp1 = (h + S1 + ch + K[j] + w[j]) >>> 0;
        const S0 = this.rotr(a, 2) ^ this.rotr(a, 13) ^ this.rotr(a, 22);
        const maj = (a & b) ^ (a & c) ^ (b & c);
        const temp2 = (S0 + maj) >>> 0;
        h = g; g = f; f = e; e = (d + temp1) >>> 0;
        d = c; c = b; b = a; a = (temp1 + temp2) >>> 0;
      }
      h0 = (h0 + a) >>> 0; h1 = (h1 + b) >>> 0; h2 = (h2 + c) >>> 0;
      h3 = (h3 + d) >>> 0; h4 = (h4 + e) >>> 0; h5 = (h5 + f) >>> 0;
      h6 = (h6 + g) >>> 0; h7 = (h7 + h) >>> 0;
    }

    const res = new ArrayBuffer(32);
    const dvRes = new DataView(res);
    dvRes.setUint32(0, h0, false); dvRes.setUint32(4, h1, false);
    dvRes.setUint32(8, h2, false); dvRes.setUint32(12, h3, false);
    dvRes.setUint32(16, h4, false); dvRes.setUint32(20, h5, false);
    dvRes.setUint32(24, h6, false); dvRes.setUint32(28, h7, false);
    return res;
  }

  private static rotr(x: number, n: number): number {
    return (x >>> n) | (x << (32 - n));
  }
}

export class EvtBus {
  private subs: Record<string, Function[]> = {};

  public sub(evt: string, cb: Function): () => void {
    if (!this.subs[evt]) {
      this.subs[evt] = [];
    }
    this.subs[evt].push(cb);
    return () => {
      this.subs[evt] = this.subs[evt].filter(c => c !== cb);
    };
  }

  public pub(evt: string, data: any): void {
    if (this.subs[evt]) {
      this.subs[evt].forEach(cb => cb(data));
    }
  }
}

export const gEvtBus = new EvtBus();

export class StStore<T> {
  private st: T;
  private lstnrs: Set<(st: T) => void> = new Set();

  constructor(initSt: T) {
    this.st = initSt;
  }

  public gSt(): T {
    return this.st;
  }

  public sSt(nst: Partial<T> | ((pst: T) => Partial<T>)) {
    const updSt = typeof nst === 'function' ? nst(this.st) : nst;
    this.st = { ...this.st, ...updSt };
    this.ntfy();
  }

  public sub(l: (st: T) => void): () => void {
    this.lstnrs.add(l);
    return () => this.lstnrs.delete(l);
  }

  private ntfy() {
    this.lstnrs.forEach(l => l(this.st));
  }
}

const gApiHst = `api.${CDB_BASE_URL}`;

export class SdkAbstr {
  protected n: NetUtl;
  protected ak: string;
  protected sk: string;
  protected ep: string;

  constructor(n: NetUtl, ep: string, ak: string, sk: string) {
    this.n = n;
    this.ep = ep;
    this.ak = ak;
    this.sk = sk;
  }

  protected async mkRqst(m: Mthd, pth: string, bdy: any): Promise<any> {
    const ts = Date.now();
    const sigStr = `${ts}.${m}.${this.ep}/${pth}.${JSON.stringify(bdy)}`;
    const sig = await CryptoUtl.sh256(sigStr + this.sk);
    const cfg: RqstCfg = {
      p: 'https',
      h: gApiHst,
      pt: 443,
      pth: `${this.ep}/${pth}`,
      m: m,
      hds: {
        'X-CDB-API-KEY': this.ak,
        'X-CDB-TIMESTAMP': ts.toString(),
        'X-CDB-SIGNATURE': sig,
        'Content-Type': 'application/json'
      },
      b: bdy,
      t: 1500,
    };
    const rsp = await this.n.sndRqst(cfg);
    return rsp.b;
  }
}

