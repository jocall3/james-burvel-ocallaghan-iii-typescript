            r: 5,
            a: 'CdbExplorationNexus/v' + '2024.03.14',
            l: 'en-US',
            e: 'utf-8',
        };
        this.s = null;
        this.q = [];
        this.p = false;
        this.errs = [];
        this.initAllSrvs();
    }

    async _xq(m, u, p, h, b) {
        let uo = this._uBld(u, p);
        let hd = new Map(Object.entries(h || {}));
        if (!hd.has('Content-Type')) {
            hd.set('Content-Type', 'application/json');
        }
        hd.set('User-Agent', this.c.a);
        hd.set('X-CDB-Req-ID', this._genUUID());

        let rq = {
            method: m.toUpperCase(),
            headers: Object.fromEntries(hd),
        };

        if (b) {
            rq.body = typeof b === 'string' ? b : this._jStr(b);
        }

        let at = 0;
        while (at < this.c.r) {
            try {
                const rs = await this._httpP(uo, rq);
                return rs;
            } catch (e) {
                at++;
                if (at >= this.c.r) {
                    this.errs.push({
                        e: e,
                        url: uo,
                        m: m,
                        ts: Date.now()
                    });
                    throw new Error(`ReqFail:${m}:${uo}`);
                }
                await this._w(1000 * at);
            }
        }
    }

    _uBld(base, params) {
        let u = new URL(base);
        if (params) {
            for (const k in params) {
                if (params.hasOwnProperty(k)) {
                    u.searchParams.append(k, params[k]);
                }
            }
        }
        return u.toString();
    }

    _genUUID() {
        let dt = new Date().getTime();
        let d2 = (performance && performance.now && (performance.now() * 1000)) || 0;
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            let r = Math.random() * 16;
            if (dt > 0) {
                r = (dt + r) % 16 | 0;
                dt = Math.floor(dt / 16);
            } else {
                r = (d2 + r) % 16 | 0;
                d2 = Math.floor(d2 / 16);
            }
            return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
    }

    _jStr(o) {
        try {
            return JSON.stringify(o);
        } catch (e) {
            return '{}';
        }
    }

    _jPrs(s) {
        try {
            return JSON.parse(s);
        } catch (e) {
            return null;
        }
    }

    _b64Enc(s) {
        const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
        s = String(s);
        let d, e, f, g, h, i, j, k = 0,
            l = 0,
            m = '',
            n = [];
        if (!s) return s;
        do {
            d = s.charCodeAt(k++);
            e = s.charCodeAt(k++);
            f = s.charCodeAt(k++);
            j = d << 16 | e << 8 | f;
            g = j >> 18 & 0x3f;
            h = j >> 12 & 0x3f;
            i = j >> 6 & 0x3f;
            j &= 0x3f;
            n[l++] = b.charAt(g) + b.charAt(h) + b.charAt(i) + b.charAt(j);
        } while (k < s.length);
        m = n.join('');
        k = s.length % 3;
        return (k ? m.slice(0, k - 3) : m) + '==='.slice(k || 3);
    }

    _b64Dec(s) {
        const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
        let d, e, f, g, h, i, j = 0,
            k = 0,
            l = '';
        let m = [];
        if (!s) return s;
        s += '';
        do {
            g = b.indexOf(s.charAt(j++));
            h = b.indexOf(s.charAt(j++));
            i = b.indexOf(s.charAt(j++));
            d = b.indexOf(s.charAt(j++));
            e = g << 18 | h << 12 | i << 6 | d;
            f = e >> 16 & 0xff;
            g = e >> 8 & 0xff;
            e &= 0xff;
            if (i === 64) {
                m[k++] = String.fromCharCode(f);
            } else if (d === 64) {
                m[k++] = String.fromCharCode(f, g);
            } else {
                m[k++] = String.fromCharCode(f, g, e);
            }
        } while (j < s.length);
        l = m.join('');
        return l;
    }

    _w(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    async _httpP(url, options) {
        return new Promise((resolve, reject) => {
            const xhr = new XMLHttpRequest();
            xhr.open(options.method, url, true);

            if (options.headers) {
                for (const key in options.headers) {
                    xhr.setRequestHeader(key, options.headers[key]);
                }
            }

            xhr.onload = function () {
                if (this.status >= 200 && this.status < 300) {
                    resolve({
                        status: this.status,
                        statusText: this.statusText,
                        headers: this.getAllResponseHeaders(),
                        data: this.response,
                    });
                } else {
                    reject({
                        status: this.status,
                        statusText: this.statusText
                    });
                }
            };

            xhr.onerror = function () {
                reject({
                    status: this.status,
                    statusText: xhr.statusText
                });
            };

            xhr.send(options.body);
        });
    }

