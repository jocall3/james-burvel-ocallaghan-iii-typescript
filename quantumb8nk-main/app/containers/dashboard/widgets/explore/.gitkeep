    _svcTmplt(id, base, authType) {
        let tk = null;
        let tkExp = 0;
        const self = this;

        const auth = {
            type: authType,
            setToken: (t, exp) => {
                tk = t;
                tkExp = exp || (Date.now() + 3600 * 1000);
            },
            getToken: () => tk,
            isAuth: () => tk && Date.now() < tkExp,
            refreshToken: async (p) => {
                if (authType === 'oauth2') {
                    const res = await self._xq('POST', `${base}/oauth/token`, null, {}, {
                        grant_type: 'refresh_token',
                        ...p
                    });
                    const d = self._jPrs(res.data);
                    if (d && d.access_token) {
                        this.setToken(d.access_token, Date.now() + d.expires_in * 1000);
                        return true;
                    }
                }
                return false;
            },
            initApiKey: (k) => {
                if (authType === 'apikey') {
                    this.setToken(k, Infinity);
                }
            }
        };

        const api = {
            _getH: () => {
                if (!auth.isAuth()) throw new Error(`${id}:NotAuthenticated`);
                if (authType === 'apikey' || authType === 'oauth2') {
                    return {
                        'Authorization': `Bearer ${tk}`
                    };
                }
                return {};
            },
            get: (ep, p) => self._xq('GET', `${base}${ep}`, p, this._getH()),
            post: (ep, b, p) => self._xq('POST', `${base}${ep}`, p, this._getH(), b),
            put: (ep, b, p) => self._xq('PUT', `${base}${ep}`, p, this._getH(), b),
            del: (ep, p) => self._xq('DELETE', `${base}${ep}`, p, this._getH()),
            patch: (ep, b, p) => self._xq('PATCH', `${base}${ep}`, p, this._getH(), b),
        };

        return {
            id,
            base,
            auth,
            api,
            models: {},
            infra: {}
        };
    }

    _initGmnSvc() {
        let s = this._svcTmplt('gmn', 'https://generativelanguage.googleapis.com/v1beta', 'apikey');
        s.api.generate = (prompt, model = 'models/gemini-1.5-flash') => {
            const b = {
                contents: [{
                    parts: [{
                        text: prompt
                    }]
                }]
            };
            return s.api.post(`/${model}:generateContent`, b, {
                key: s.auth.getToken()
            });
        };
        s.api.listModels = () => {
            return s.api.get('/models', {
                key: s.auth.getToken()
            });
        };
        s.models.prompt = {
            text: '',
            images: [],
            role: 'user'
        };
        s.models.response = {
            candidates: [],
            usageMetadata: {}
        };
        return s;
    }

