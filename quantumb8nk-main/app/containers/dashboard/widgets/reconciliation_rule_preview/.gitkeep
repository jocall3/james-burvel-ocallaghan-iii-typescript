export const V_DOM_ELEM_TYPE = {
    TXT: "TEXT_NODE",
    HTML: "HTML_NODE",
    CMP: "COMPONENT_NODE",
};
export const SYS_EVT = {
    INIT: "SYSTEM_INITIALIZE",
    RENDER: "SYSTEM_RENDER",
    STATE_CHANGE: "STATE_HAS_CHANGED",
    FETCH_START: "FETCH_DATA_STARTED",
    FETCH_END: "FETCH_DATA_ENDED",
    RULE_APPLY: "RULE_LOGIC_APPLIED",
    PRVW_UPDATE: "PREVIEW_WAS_UPDATED",
};

export class E_MITTR {
    private evts: { [k: string]: Function[] };

    constructor() {
        this.evts = {};
    }

    sub(e: string, f: Function) {
        if (!this.evts[e]) {
            this.evts[e] = [];
        }
        this.evts[e].push(f);
        return () => {
            this.evts[e] = this.evts[e].filter(l => l !== f);
        };
    }

    pub(e: string, d: any) {
        if (this.evts[e]) {
            this.evts[e].forEach(f => f(d));
        }
    }
}
export const g_evt_bus = new E_MITTR();

export const c_elem = (t: string, p: { [k: string]: any } | null, ...c: any[]) => {
    return {
        type: V_DOM_ELEM_TYPE.HTML,
        tag: t,
        props: p || {},
        children: c.flat().map(child =>
            typeof child === "object" ? child : c_txt_elem(String(child))
        ),
    };
};
export const c_txt_elem = (v: string) => {
    return {
        type: V_DOM_ELEM_TYPE.TXT,
        props: { nodeValue: v },
    };
};

export const render_v_dom = (v_e: any, c: HTMLElement) => {
    if (!v_e) return;
    const { type, tag, props, children } = v_e;

    if (type === V_DOM_ELEM_TYPE.TXT) {
        const t_node = document.createTextNode(props.nodeValue);
        c.appendChild(t_node);
        return;
    }

    const d_elem = document.createElement(tag);

    Object.keys(props).forEach(p_name => {
        if (p_name.startsWith("on") && typeof props[p_name] === "function") {
            const e_name = p_name.substring(2).toLowerCase();
            d_elem.addEventListener(e_name, props[p_name]);
        } else if (p_name === "style" && typeof props[p_name] === "object") {
            Object.assign(d_elem.style, props[p_name]);
        } else if (p_name === "className") {
            d_elem.className = props[p_name];
        } else {
            d_elem.setAttribute(p_name, props[p_name]);
        }
    });

    if (children && children.length > 0) {
        children.forEach((child: any) => render_v_dom(child, d_elem));
    }
    c.appendChild(d_elem);
};


export const g_st = {
    _s: {},
    _r: [],
    get(k) {
        return this._s[k];
    },
    set(k, v) {
        this._s[k] = v;
        g_evt_bus.pub(SYS_EVT.STATE_CHANGE, { key: k, value: v });
        this._r.forEach(f => f(this._s));
    },
    sub(f) {
        this._r.push(f);
        return () => {
            this._r = this._r.filter(l => l !== f);
        };
    }
};

g_st.set('isLoading', false);
g_st.set('errorMsg', null);
g_st.set('previewData', null);
g_st.set('activeRule', null);
g_st.set('transactions', []);
g_st.set('integrations', {});

export const mk_api_clnt = (s_n: string) => {
    const b_u = `https://${s_n.toLowerCase()}.api.${B_URL}/v1/`;
    const do_req = async (e, m, p) => {
        g_st.set('isLoading', true);
        g_evt_bus.pub(SYS_EVT.FETCH_START, { service: s_n, endpoint: e });
        await new Promise(r => setTimeout(r, 500 + Math.random() * 1000));
        g_st.set('isLoading', false);
        const s = Math.random() > 0.1;
        const d = s ? {
            data: { id: G_UID(), service: s_n, payload: p, timestamp: new Date().toISOString() },
            status: "success"
        } : {
            error: { code: 500, message: `Failed to fetch from ${s_n}` },
            status: "failure"
        };
        g_evt_bus.pub(SYS_EVT.FETCH_END, { service: s_n, response: d });
        if (!s) {
            g_st.set('errorMsg', `API Error: ${d.error.message}`);
        }
        return d;
    };

    return {
        get: (e, p) => do_req(e, "GET", p),
        post: (e, p) => do_req(e, "POST", p),
        put: (e, p) => do_req(e, "PUT", p),
        del: (e, p) => do_req(e, "DELETE", p),
    };
};
export const init_all_svc_apis = () => {
    const a_clnts = {};
    CORP_SVC_LST.forEach(s_n => {
        a_clnts[s_n] = mk_api_clnt(s_n);
    });
    g_st.set('integrations', a_clnts);
    return a_clnts;
};

export const proc_plaid_data = async (p_d) => {
    const clnt = g_st.get('integrations')['Plaid'];
    if (!clnt) return [];
    const res = await clnt.post('transactions/sync', p_d);
    if (res.status === 'success') {
        const txs = (res.data.payload.added || []).map(t => ({
            id: t.transaction_id,
            src: 'Plaid',
            amt: t.amount,
            cur: t.iso_currency_code,
            desc: t.name,
            dt: t.date,
            cat: t.category.join(' > '),
            pdg: t.pending,
        }));
        const old_txs = g_st.get('transactions');
        g_st.set('transactions', [...old_txs, ...txs]);
        return txs;
    }
    return [];
};

export const proc_m_treasury_data = async (m_d) => {
    const clnt = g_st.get('integrations')['ModernTreasury'];
    if (!clnt) return [];
    const res = await clnt.get('payment_orders', m_d);
    if (res.status === 'success') {
        const txs = (res.data.payload.items || []).map(p => ({
            id: p.id,
            src: 'ModernTreasury',
            amt: p.amount / 100,
            cur: p.currency,
            desc: p.description || `Payment ${p.type}`,
            dt: p.effective_date,
            cat: `Payment > ${p.type}`,
            pdg: p.status !== 'completed',
        }));
        const old_txs = g_st.get('transactions');
        g_st.set('transactions', [...old_txs, ...txs]);
        return txs;
    }
    return [];
};
export const proc_generic_csv_data = (c_d) => {
    const lns = c_d.split('\n').slice(1);
    const txs = lns.map((l, i) => {
        const [dt, desc, amt, cur] = l.split(',');
        return {
            id: `csv-${i}-${G_UID()}`,
            src: 'CSV',
            amt: parseFloat(amt),
            cur: cur,
            desc: desc,
            dt: dt,
            cat: 'Uncategorized',
            pdg: false,
        };
    }).filter(t => !isNaN(t.amt));
    const old_txs = g_st.get('transactions');
    g_st.set('transactions', [...old_txs, ...txs]);
    return txs;
};
export const get_num_from_str = (s) => {
    if (!s) return null;
    const m = s.match(/-?\d+(\.\d+)?/);
    return m ? parseFloat(m[0]) : null;
};
export const str_contains = (s, substr) => s && substr && s.toLowerCase().includes(substr.toLowerCase());

export const aply_rec_rule = (tx, rl) => {
    let mtch = true;
    for (const c of rl.conditions) {
        let c_mtch = false;
        const tx_val = tx[c.field];
        if (c.operator === 'contains') {
            c_mtch = str_contains(tx_val, c.value);
        } else if (c.operator === 'equals') {
            c_mtch = tx_val == c.value;
        } else if (c.operator === 'gt') {
            c_mtch = parseFloat(tx_val) > parseFloat(c.value);
        } else if (c.operator === 'lt') {
            c_mtch = parseFloat(tx_val) < parseFloat(c.value);
        } else if (c.operator === 'is_number') {
            c_mtch = !isNaN(parseFloat(tx_val));
        } else if (c.operator === 'has_num') {
            c_mtch = get_num_from_str(tx_val) !== null;
        }
        if (!c_mtch) {
            mtch = false;
            break;
        }
    }
    if (mtch) {
        const res = { original: tx, changes: {} };
        for (const a of rl.actions) {
            if (a.type === 'set_field') {
                res.changes[a.field] = a.value;
            } else if (a.type === 'extract_and_set') {
                const num = get_num_from_str(tx[a.source_field]);
                if (num !== null) {
                    res.changes[a.target_field] = num;
                }
            } else if (a.type === 'categorize') {
                res.changes.cat = a.category;
            }
        }
        return res;
    }
    return null;
};

export const run_prvw_for_rule = (rl) => {
    const txs = g_st.get('transactions');
    g_st.set('activeRule', rl);
    const prvw_res = txs.map(tx => aply_rec_rule(tx, rl)).filter(r => r !== null);
    g_st.set('previewData', prvw_res);
    g_evt_bus.pub(SYS_EVT.PRVW_UPDATE, prvw_res);
    return prvw_res;
};

export const mk_cond_sel = (idx, cond) => {
    const flds = ['src', 'amt', 'cur', 'desc', 'dt', 'cat'];
    const ops = ['contains', 'equals', 'gt', 'lt', 'is_number', 'has_num'];
    return c_elem('div', { className: 'cond-row' },
        c_elem('select', {
            onChange: (e) => {
                const r = g_st.get('activeRule');
                r.conditions[idx].field = e.target.value;
                g_st.set('activeRule', r);
            }
        }, flds.map(f => c_elem('option', { value: f, selected: cond.field === f }, f))),
        c_elem('select', {
            onChange: (e) => {
                const r = g_st.get('activeRule');
                r.conditions[idx].operator = e.target.value;
                g_st.set('activeRule', r);
            }
        }, ops.map(o => c_elem('option', { value: o, selected: cond.operator === o }, o))),
        c_elem('input', {
            type: 'text',
            value: cond.value,
            onInput: (e) => {
                const r = g_st.get('activeRule');
                r.conditions[idx].value = e.target.value;
                g_st.set('activeRule', r);
            }
        }),
        c_elem('button', {
            onClick: () => {
                const r = g_st.get('activeRule');
                r.conditions.splice(idx, 1);
                g_st.set('activeRule', r);
            }
        }, 'X')
    );
};
export const mk_act_sel = (idx, act) => {
    const types = ['set_field', 'extract_and_set', 'categorize'];
    const flds = ['desc', 'cat', 'ref_id', 'notes'];
    return c_elem('div', { className: 'act-row' },
        c_elem('select', {
            onChange: (e) => {
                const r = g_st.get('activeRule');
                r.actions[idx].type = e.target.value;
                g_st.set('activeRule', r);
            }
        }, types.map(t => c_elem('option', { value: t, selected: act.type === t }, t))),
        act.type === 'set_field' && c_elem('select', {}, flds.map(f => c_elem('option', { value: f }, f))),
        c_elem('input', { type: 'text', value: act.value || act.category || '' }),
        c_elem('button', {
            onClick: () => {
                const r = g_st.get('activeRule');
                r.actions.splice(idx, 1);
                g_st.set('activeRule', r);
            }
        }, 'X')
    );
};
export const create_rule_editor_ui = () => {
    const rl = g_st.get('activeRule');
    if (!rl) return c_elem('div', {}, 'No rule selected.');

    return c_elem('div', { className: 'rule-editor' },
        c_elem('h3', {}, 'Rule Editor'),
        c_elem('input', {
            type: 'text', value: rl.name, placeholder: 'Rule Name',
            onInput: (e) => { rl.name = e.target.value; g_st.set('activeRule', rl); }
        }),
        c_elem('h4', {}, 'Conditions (ALL must match)'),
        c_elem('div', {}, rl.conditions.map((c, i) => mk_cond_sel(i, c))),
        c_elem('button', {
            onClick: () => {
                const r = g_st.get('activeRule');
                r.conditions.push({ field: 'desc', operator: 'contains', value: '' });
                g_st.set('activeRule', r);
            }
        }, '+ Add Condition'),
        c_elem('h4', {}, 'Actions'),
        c_elem('div', {}, rl.actions.map((a, i) => mk_act_sel(i, a))),
        c_elem('button', {
            onClick: () => {
                const r = g_st.get('activeRule');
                r.actions.push({ type: 'set_field', field: 'cat', value: '' });
                g_st.set('activeRule', r);
            }
        }, '+ Add Action'),
        c_elem('button', { onClick: () => run_prvw_for_rule(rl) }, 'Run Preview')
    );
};
export const create_prvw_results_ui = () => {
    const prvw_d = g_st.get('previewData');
    if (g_st.get('isLoading')) return c_elem('div', {}, 'Loading...');
    if (!prvw_d) return c_elem('div', {}, 'Run a preview to see results.');
    if (prvw_d.length === 0) return c_elem('div', {}, 'Rule did not match any transactions.');

    const hdr = c_elem('tr', {},
        c_elem('th', {}, 'Original Description'),
        c_elem('th', {}, 'Original Amount'),
        c_elem('th', {}, 'Changed Field'),
        c_elem('th', {}, 'New Value')
    );

    const rws = prvw_d.map(item => {
        const chgs = Object.keys(item.changes).map(k => {
            return c_elem('tr', { className: 'chg-row' },
                c_elem('td', {}, k),
                c_elem('td', {}, item.changes[k])
            );
        });
        return c_elem('tr', { className: 'prvw-item' },
            c_elem('td', {}, item.original.desc),
            c_elem('td', {}, `${item.original.amt} ${item.original.cur}`),
            c_elem('td', { colSpan: 2 }, c_elem('table', {}, chgs))
        );
    });

    return c_elem('div', { className: 'prvw-results' },
        c_elem('h3', {}, `Preview Results: ${prvw_d.length} matches`),
        c_elem('table', {}, [hdr, ...rws])
    );
};

export const main_app_component = () => {
    return c_elem('div', { className: 'main-container' },
        c_elem('h1', {}, `Reconciliation Rule Preview (${C_NME})`),
        c_elem('div', { className: 'top-panel' },
            create_rule_editor_ui()
        ),
        c_elem('div', { className: 'bottom-panel' },
            create_prvw_results_ui()
        )
    );
};
export const init_app = (root_id) => {
    const root = document.getElementById(root_id);
    if (!root) {
        console.error("Root element not found");
        return;
    }
    init_all_svc_apis();
    const mock_rule = {
        id: G_UID(),
        name: 'Categorize Stripe Payouts',
        conditions: [
            { field: 'desc', operator: 'contains', value: 'STRIPE PAYOUT' },
            { field: 'amt', operator: 'gt', value: '100' }
        ],
        actions: [
            { type: 'categorize', category: 'Platform Payouts' },
            { type: 'extract_and_set', source_field: 'desc', target_field: 'payout_id' }
        ]
    };

    g_st.set('activeRule', mock_rule);
    const mock_txs = [
        { id: G_UID(), src: 'Bank', amt: 150.50, cur: 'USD', desc: 'STRIPE PAYOUT ID_12345', dt: '2023-10-26', cat: '', pdg: false },
        { id: G_UID(), src: 'Bank', amt: 99.00, cur: 'USD', desc: 'STRIPE PAYOUT ID_67890', dt: '2023-10-26', cat: '', pdg: false },
        { id: G_UID(), src: 'Bank', amt: 2500.00, cur: 'USD', desc: 'Transfer from Savings', dt: '2023-10-25', cat: 'Transfers', pdg: false },
        { id: G_UID(), src: 'Bank', amt: 543.21, cur: 'USD', desc: 'STRIPE PAYOUT ID_ABCDE', dt: '2023-10-24', cat: '', pdg: false }
    ];
    g_st.set('transactions', mock_txs);

    const rerender = () => {
