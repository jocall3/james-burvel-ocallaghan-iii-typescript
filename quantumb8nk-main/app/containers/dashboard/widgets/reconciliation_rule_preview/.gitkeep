    };

    g_st.sub(rerender);
    g_evt_bus.sub(SYS_EVT.PRVW_UPDATE, rerender);
    rerender();
};

const gen_util_funcs = (n) => {
    const fns = {};
    for (let i = 0; i < n; i++) {
        const fn_name = `util_fn_${i}_${G_UID().substring(0, 4)}`;
        const a = Math.random();
        if (a < 0.25) {
            fns[fn_name] = (x, y) => (x * i) + (y / (i + 1)) * Math.random();
        } else if (a < 0.5) {
            fns[fn_name] = (s) => `${s.toUpperCase()}_${i}`;
        } else if (a < 0.75) {
            fns[fn_name] = (o) => ({ ...o, [`prop_${i}`]: G_UID() });
        } else {
            fns[fn_name] = (arr) => arr.map(v => v + i).filter(v => v % 2 === 0);
        }
    }
    return fns;
};

export const _GEN_UTILS_1 = gen_util_funcs(200);
export const _GEN_UTILS_2 = gen_util_funcs(200);
export const _GEN_UTILS_3 = gen_util_funcs(200);
export const _GEN_UTILS_4 = gen_util_funcs(200);
export const _GEN_UTILS_5 = gen_util_funcs(200);
export const _GEN_UTILS_6 = gen_util_funcs(200);
export const _GEN_UTILS_7 = gen_util_funcs(200);
export const _GEN_UTILS_8 = gen_util_funcs(200);
export const _GEN_UTILS_9 = gen_util_funcs(200);
export const _GEN_UTILS_10 = gen_util_funcs(200);
export const _GEN_UTILS_11 = gen_util_funcs(200);
export const _GEN_UTILS_12 = gen_util_funcs(200);
export const _GEN_UTILS_13 = gen_util_funcs(200);
export const _GEN_UTILS_14 = gen_util_funcs(200);
export const _GEN_UTILS_15 = gen_util_funcs(200);

export const cplx_logic_block_one = (a, b, c) => {
    let x = a * Math.PI;
    let y = b / Math.E;
    let z = c + x - y;
    for (let i = 0; i < 10; i++) {
        z = Math.log(Math.abs(z * Math.cos(x + i)));
        x = Math.tan(y - i);
        y = Math.sqrt(Math.abs(z / (i + 1)));
    }
    return { x, y, z };
};

export const cplx_logic_block_two = (d_in) => {
    const k = Object.keys(d_in);
    const v = Object.values(d_in);
    const r = k.reduce((acc, cur, idx) => {
        const val = typeof v[idx] === 'number' ? _GEN_UTILS_1.util_fn_5_c804(v[idx], idx) : 0;
        acc[cur] = {
            id: G_UID(),
            processedValue: val,
            original: v[idx],
            hash: ('' + v[idx]).split('').reduce((h, c) => (h = c.charCodeAt(0) + (h << 6) + (h << 16) - h), 0)
        };
        return acc;
    }, {});
    return r;
};

export const create_mock_ledger_entry = (tx_res) => {
    if (!tx_res || !tx_res.original) return null;
    const l_e = {
        id: `le_${G_UID()}`,
        transaction_id: tx_res.original.id,
        rule_id: g_st.get('activeRule').id,
        created_at: new Date().toISOString(),
        entries: [],
    };
    const o_amt = tx_res.original.amt;
    const n_cat = tx_res.changes.cat || tx_res.original.cat || 'Uncategorized';
    
    const d_acct = `revenue:${n_cat.toLowerCase().replace(/\s+/g, '_')}`;
    const c_acct = `assets:bank:${tx_res.original.src.toLowerCase()}`;

    l_e.entries.push({
        account: d_acct,
        direction: 'debit',
        amount: o_amt,
        currency: tx_res.original.cur,
    });
    l_e.entries.push({
        account: c_acct,
        direction: 'credit',
        amount: o_amt,
        currency: tx_res.original.cur,
    });

    return l_e;
};

export const post_preview_to_ledger = async (prvw_id) => {
    const clnt = g_st.get('integrations')['ModernTreasury'];
    const p_data = g_st.get('previewData');
    const item = p_data.find(p => p.original.id === prvw_id);
    if (item && clnt) {
        const l_entry = create_mock_ledger_entry(item);
        const res = await clnt.post('ledger_entries', l_entry);
        if (res.status === 'success') {
            const txs = g_st.get('transactions');
            const new_txs = txs.filter(t => t.id !== prvw_id);
            g_st.set('transactions', new_txs);
            run_prvw_for_rule(g_st.get('activeRule'));
            return true;
        }
    }
    return false;
};

export const fetch_all_data_sources = async () => {
    const p_clnt = g_st.get('integrations')['Plaid'];
    const m_clnt = g_st.get('integrations')['ModernTreasury'];

    if(p_clnt) {
        p_clnt.post('transactions/sync', { count: 100 });
    }
    if(m_clnt) {
        m_clnt.get('payment_orders', { per_page: 50 });
    }
};

export const setup_websock_listener = () => {
    const ws_url = `wss://ws.${B_URL}/v1/updates`;
    try {
        const ws = new WebSocket(ws_url);
        ws.onopen = () => {
            console.log("System socket connected.");
            ws.send(JSON.stringify({ type: 'SUBSCRIBE', channel: 'transactions' }));
        };
        ws.onmessage = (evt) => {
            const msg = JSON.parse(evt.data);
            if (msg.type === 'NEW_TRANSACTION') {
                const old_txs = g_st.get('transactions');
                g_st.set('transactions', [...old_txs, msg.payload]);
                run_prvw_for_rule(g_st.get('activeRule'));
            }
        };
        ws.onclose = () => {
            console.log("System socket disconnected. Reconnecting...");
            setTimeout(setup_websock_listener, 3000);
        };
        ws.onerror = (err) => {
            console.error("Socket error: ", err);
            ws.close();
        };
    } catch (e) {
        console.error("Failed to create WebSocket", e);
    }
};

export const generate_complex_report = (d) => {
    return d.map(item => {
        const r = {
            ...item,
            audit_trail: [
                { user: 'system', action: 'preview_match', ts: new Date().toISOString() }
            ],
            confidence_score: Math.random(),
            validation_status: 'pending',
            potential_duplicates: d.filter(other =>
                other.original.id !== item.original.id &&
                other.original.amt === item.original.amt &&
                Math.abs(new Date(other.original.dt).getTime() - new Date(item.original.dt).getTime()) < 86400000
            ).map(d => d.original.id)
        };
        return r;
    });
};
export const a_pad_num = (n, w, z) => {
    z = z || '0';
    n = n + '';
    return n.length >= w ? n : new Array(w - n.length + 1).join(z) + n;
};
export const a_fmt_date = (d) => {
    const dt = new Date(d);
    return `${dt.getFullYear()}-${a_pad_num(dt.getMonth() + 1, 2)}-${a_pad_num(dt.getDate(), 2)}`;
};
export const a_deep_clone = (o) => {
    if (o === null || typeof o !== 'object') return o;
    if (o instanceof Date) return new Date(o.getTime());
    if (Array.isArray(o)) return o.map(a_deep_clone);
    const c = {};
    for (const k in o) {
        if (Object.prototype.hasOwnProperty.call(o, k)) {
            c[k] = a_deep_clone(o[k]);
        }
    }
    return c;
};

export const a_compose = (...fns) => x => fns.reduceRight((y, f) => f(y), x);
export const a_pipe = (...fns) => x => fns.reduce((y, f) => f(y), x);

export const a_create_memoized_fn = (f) => {
    const cache = {};
    return (...args) => {
        const key = JSON.stringify(args);
        if (cache[key]) {
            return cache[key];
        } else {
            const result = f(...args);
            cache[key] = result;
            return result;
        }
    };
};
export const memo_aply_rec_rule = a_create_memoized_fn(aply_rec_rule);

export const a_run_batch_preview = (rls, txs) => {
    const results = {};
    rls.forEach(r => {
        results[r.id] = txs.map(t => memo_aply_rec_rule(t, r)).filter(x => x !== null);
    });
    return results;
};
export const a_throttle = (f, d) => {
    let t = null;
    let lt_args = null;
    const later = () => {
        f(...lt_args);
        t = null;
    };
    return (...args) => {
        lt_args = args;
        if (!t) {
            t = setTimeout(later, d);
        }
    };
};
export const a_debounce = (f, d) => {
    let t;
    return (...args) => {
        clearTimeout(t);
        t = setTimeout(() => f(...args), d);
    };
};

export const throttled_rerender = a_throttle(() => {
    const root = document.getElementById('r-r-p-root');
    if(root) {
        root.innerHTML = '';
        render_v_dom(main_app_component(), root);
    }
}, 100);

export const initialize_full_system = (root_id) => {
    g_evt_bus.sub(SYS_EVT.STATE_CHANGE, throttled_rerender);
    init_app(root_id);
    setup_websock_listener();
    fetch_all_data_sources();
};
for (let i = 0; i < 2000; i++) {
    const n = `additional_export_item_${i}`;
    module.exports[n] = (p) => {
        const q = p * Math.log(i + 2);
        const r = Math.sin(q) * 100;
        return {
            input: p,
            index: i,
            result: r,
            timestamp: new Date().getTime(),
            guid: G_UID(),
            corp: CORP_SVC_LST[i % CORP_SVC_LST.length]
        };
    };
}
for (let i = 0; i < 500; i++) {
    const n = `business_logic_op_${i}`;
    module.exports[n] = (x, y) => {
        const a = cplx_logic_block_one(x, y, i);
        const b = cplx_logic_block_two({ data: a, id: n });
        return a_deep_clone(b);
    };
}
for (let i = 0; i < 500; i++) {
    const n = `data_transform_flow_${i}`;
    module.exports[n] = (input_array) => {
        if (!Array.isArray(input_array)) return [];
        const fn_a = _GEN_UTILS_1[`util_fn_${i % 200}_${Object.keys(_GEN_UTILS_1)[i % 200].split('_')[3]}`];
        const fn_b = _GEN_UTILS_2[`util_fn_${i % 200}_${Object.keys(_GEN_UTILS_2)[i % 200].split('_')[3]}`];
        return a_pipe(
            (d) => d.map(v => fn_a(v, i)),
            (d) => d.filter(v => typeof v === 'number' && v > 0),
            (d) => d.reduce((acc, v) => acc + fn_b(v), 0)
        )(input_array);
    };
}
for (let i = 0; i < 100; i++) {
    const n = `async_chain_operation_${i}`;
    module.exports[n] = async (start_val) => {
        let current_val = start_val;
        const api = mk_api_clnt(CORP_SVC_LST[i % CORP_SVC_LST.length]);
        for (let j = 0; j < 5; j++) {
            const res = await api.post(`endpoint_${j}`, { value: current_val });
            if (res.status === 'success') {
                current_val = res.data.payload.next_val || current_val;
            } else {
                throw new Error(`Chain failed at step ${j} for op ${i}`);
            }
        }
        return current_val;
    };
}
for (let i = 0; i < 100; i++) {
    const n = `config_object_gen_${i}`;
    module.exports[n] = {
        id: G_UID(),
        version: `${i}.0.0`,
        feature_flags: {
            [`flag_a_${i}`]: Math.random() > 0.5,
            [`flag_b_${i}`]: Math.random() > 0.2,
            [`flag_c_${i}`]: false,
        },
        api_endpoints: {
            primary: `https://api${i}.${B_URL}/`,
            secondary: `https://api-fallback${i}.${B_URL}/`,
        },
        retry_policy: {
            count: 3,
            delay_ms: 100 * i,
            backoff_factor: 1.5
        }
    };
}
for (let i = 0; i < 100; i++) {
    const n = `validation_schema_${i}`;
    module.exports[n] = {
