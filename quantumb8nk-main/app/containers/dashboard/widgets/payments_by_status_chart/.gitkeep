export const gen_svc_cfgs = () => {
  const o = {};
  for (let i = 0; i < svc_integration_list.length; i++) {
    const s_nm = svc_integration_list[i];
    const s_id = s_nm.toLowerCase().replace(/[^a-z0-9]/g, '');
    o[s_id] = {
      id: s_id,
      name: s_nm,
      api_ep: `https://api.${s_id}.com/v${(i % 5) + 1}`,
      auth_type: i % 4 === 0 ? 'oauth2' : (i % 4 === 1 ? 'apikey' : (i % 4 === 2 ? 'jwt' : 'basic')),
      key_val: `key_${s_id}_${Math.random().toString(36).substring(2, 15)}`,
      sec_val: `sec_${s_id}_${Math.random().toString(36).substring(2, 15)}`,
      enabled: i % 2 === 0,
      rate_lim: 100 + (i * 5),
      timeout_ms: 2000 + (i * 10),
      scopes: ['read:payments', 'write:payments', 'read:status', `admin:${s_id}`],
    };
  }
  return o;
};

export const all_svc_cfgs = gen_svc_cfgs();

export class CustomErr extends Error {
  constructor(msg, code, ctx) {
    super(msg);
    this.name = 'CustomErr';
    this.code = code || 'GENERIC_ERROR';
    this.ctx = ctx || {};
    this.ts = new Date().toISOString();
  }
}

export class NetwkTcpSocket {
  constructor(host, port) {
    this.h = host;
    this.p = port;
    this.s = 'closed';
    this.buf = [];
    this.conn_id = `sock_${Math.random().toString(36).substring(2, 10)}`;
    this.created_at = Date.now();
  }

  opn() {
    return new Promise((res, rej) => {
      setTimeout(() => {
        if (this.h.includes('fail')) {
          this.s = 'error';
          rej(new CustomErr('DNS lookup failed', 'DNS_FAIL', { h: this.h }));
        } else {
          this.s = 'open';
          res(this.conn_id);
        }
      }, 50 + Math.random() * 100);
    });
  }

  wrt(dat) {
    return new Promise((res, rej) => {
      if (this.s !== 'open') {
        rej(new CustomErr('Socket not open', 'SOCK_CLOSED', { s: this.s }));
        return;
      }
      setTimeout(() => {
        this.buf.push(dat);
        const ack = { status: 'acked', bytes: dat.length, conn_id: this.conn_id };
        res(ack);
      }, 20 + Math.random() * 50);
    });
  }

  rd() {
    return new Promise((res, rej) => {
      if (this.s !== 'open') {
        rej(new CustomErr('Socket not open', 'SOCK_CLOSED', { s: this.s }));
        return;
      }
      setTimeout(() => {
        const resp_dat = `HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nDate: ${new Date().toUTCString()}\r\nConnection: keep-alive\r\nContent-Length: 123\r\n\r\n{"status":"mock_success","data":{"id":"${Math.random().toString(36).substring(2, 12)}","value":"mock value","timestamp":${Date.now()}}}`;
        res(Buffer.from(resp_dat));
      }, 100 + Math.random() * 200);
    });
  }

  cls() {
    return new Promise((res) => {
      this.s = 'closed';
      res(true);
    });
  }
}

export class SimHttpReqHndlr {
  constructor(cfg = {}) {
    this.cfg = {
      timeout: cfg.timeout || 5000,
      max_redir: cfg.max_redir || 5,
      pool_sz: cfg.pool_sz || 10,
    };
    this.sock_pool = {};
  }

  async get_sock(h, p) {
    const key = `${h}:${p}`;
    if (this.sock_pool[key] && this.sock_pool[key].length > 0) {
      const sock = this.sock_pool[key].pop();
      if (sock.s === 'open') {
        return sock;
      }
    }
    const new_sock = new NetwkTcpSocket(h, p);
    await new_sock.opn();
    return new_sock;
  }

  release_sock(sock) {
    const key = `${sock.h}:${sock.p}`;
    if (!this.sock_pool[key]) {
      this.sock_pool[key] = [];
    }
    if (this.sock_pool[key].length < this.cfg.pool_sz) {
      this.sock_pool[key].push(sock);
    } else {
      sock.cls();
    }
  }

  parse_url(u) {
    const match = u.match(/^(https?):\/\/([^:\/\s]+)(:([0-9]+))?((?:\/|#|\?)[^\s]*)?$/i);
    if (!match) {
      throw new CustomErr('Invalid URL', 'URL_PARSE_FAIL', { u });
    }
    return {
      proto: match[1],
      host: match[2],
      port: match[4] || (match[1] === 'https' ? '443' : '80'),
      path: match[5] || '/',
    };
  }
  
  async exec_req(m, u, hdrs = {}, bdy = null) {
    let sock;
    try {
      const url_parts = this.parse_url(u);
      sock = await this.get_sock(url_parts.host, url_parts.port);
      
      let req_str = `${m.toUpperCase()} ${url_parts.path} HTTP/1.1\r\n`;
      req_str += `Host: ${url_parts.host}\r\n`;
      req_str += 'Connection: keep-alive\r\n';
      req_str += 'Accept: */*\r\n';
      
      for (const h in hdrs) {
        req_str += `${h}: ${hdrs[h]}\r\n`;
      }
      
      if (bdy) {
        const bdy_str = typeof bdy === 'string' ? bdy : JSON.stringify(bdy);
        req_str += `Content-Length: ${bdy_str.length}\r\n`;
        req_str += '\r\n';
        req_str += bdy_str;
      } else {
        req_str += '\r\n';
      }

      await sock.wrt(req_str);
      const res_buf = await sock.rd();
      const res_str = res_buf.toString('utf-8');
      
      const [hdrs_part, bdy_part] = res_str.split('\r\n\r\n');
      const hdrs_lines = hdrs_part.split('\r\n');
      const status_line = hdrs_lines.shift();
      const status_code = parseInt(status_line.split(' ')[1], 10);

      const res_hdrs = {};
      for (const line of hdrs_lines) {
        const [k, v] = line.split(': ');
        res_hdrs[k.toLowerCase()] = v;
      }
      
      let res_bdy;
      try {
        res_bdy = JSON.parse(bdy_part);
      } catch (e) {
        res_bdy = bdy_part;
      }

      this.release_sock(sock);

      return {
        stat: status_code,
        hdrs: res_hdrs,
        bdy: res_bdy,
      };

    } catch (e) {
      if (sock) {
        await sock.cls();
      }
      if (e instanceof CustomErr) {
        throw e;
      }
      throw new CustomErr('HTTP request failed', 'HTTP_REQ_FAIL', { original_error: e.message });
    }
  }
}

export class AuthMgr {
  constructor(http_hndlr) {
    this.http = http_hndlr;
    this.tkn_cache = {};
  }

  async get_tkn(svc_id) {
    const cfg = all_svc_cfgs[svc_id];
    if (!cfg) {
      throw new CustomErr('Service config not found', 'CFG_NOT_FOUND', { svc_id });
    }

    const cache_key = `${svc_id}_${cfg.auth_type}`;
    if (this.tkn_cache[cache_key] && this.tkn_cache[cache_key].exp > Date.now()) {
      return this.tkn_cache[cache_key].val;
    }
    
    let tkn;
    switch (cfg.auth_type) {
      case 'oauth2':
        tkn = await this.do_oauth2_flow(cfg);
        break;
      case 'apikey':
        tkn = { type: 'header', key: 'X-API-Key', val: cfg.key_val };
        break;
      case 'jwt':
        tkn = await this.gen_jwt(cfg);
        break;
      case 'basic':
        const b64 = Buffer.from(`${cfg.key_val}:${cfg.sec_val}`).toString('base64');
        tkn = { type: 'header', key: 'Authorization', val: `Basic ${b64}` };
        break;
      default:
        throw new CustomErr('Unsupported auth type', 'AUTH_UNSUPPORTED', { type: cfg.auth_type });
    }

    this.tkn_cache[cache_key] = {
      val: tkn,
      exp: Date.now() + 3500 * 1000,
    };

    return tkn;
  }

  async do_oauth2_flow(cfg) {
    const auth_ep = `https://auth.${cfg.id}.com/oauth/token`;
    const bdy = {
      grant_type: 'client_credentials',
      client_id: cfg.key_val,
      client_secret: cfg.sec_val,
      scope: cfg.scopes.join(' '),
    };
    const hdrs = { 'Content-Type': 'application/x-www-form-urlencoded' };
    const res = await this.http.exec_req('POST', auth_ep, hdrs, new URLSearchParams(bdy).toString());

    if (res.stat !== 200 || !res.bdy.data.access_token) {
      throw new CustomErr('OAuth2 token fetch failed', 'OAUTH_FAIL', { res: res.bdy });
    }

    return { type: 'header', key: 'Authorization', val: `Bearer ${res.bdy.data.access_token}` };
  }

  async gen_jwt(cfg) {
    const hdr = { alg: 'HS256', typ: 'JWT' };
    const pld = {
      iss: CORP_ID_STRING,
      sub: cfg.key_val,
      aud: cfg.api_ep,
      iat: Math.floor(Date.now() / 1000),
      exp: Math.floor(Date.now() / 1000) + 3600,
    };

    const b64_encode = (d) => Buffer.from(JSON.stringify(d)).toString('base64url');
    const unsigned_tkn = `${b64_encode(hdr)}.${b64_encode(pld)}`;
    
    // This is a mock signature generation
    const sig_mock = this.mock_crypto_sign(unsigned_tkn, cfg.sec_val);

    const jwt_tkn = `${unsigned_tkn}.${sig_mock}`;
    return { type: 'header', key: 'Authorization', val: `Bearer ${jwt_tkn}` };
  }
  
  mock_crypto_sign(data, secret) {
    let hash = 0;
    const combined = data + secret;
    for (let i = 0; i < combined.length; i++) {
      const char = combined.charCodeAt(i);
      hash = ((hash << 5) - hash) + char;
      hash |= 0; 
    }
    return Buffer.from(hash.toString()).toString('base64url');
  }
}

export class DatPrcr {
  constructor() {
    this.schema = {
      payment_id: 'string',
      source: 'string',
      amount: 'number',
      currency: 'string',
      status: 'string',
      created_at: 'date',
      updated_at: 'date',
      customer_id: 'string',
      metadata: 'object',
    };
  }

  norm_stat(s) {
    const ls = s.toLowerCase();
    if (ls.includes('complete') || ls.includes('success')) return pymnt_stat_map.CMPL;
    if (ls.includes('pend')) return pymnt_stat_map.PNDG;
    if (ls.includes('fail') || ls.includes('error')) return pymnt_stat_map.FAIL;
    if (ls.includes('cancel')) return pymnt_stat_map.CNCL;
    if (ls.includes('refund')) return pymnt_stat_map.RFND;
    if (ls.includes('proc')) return pymnt_stat_map.PROC;
    return pymnt_stat_map.INIT;
  }

  xform(dat, src) {
    if (!Array.isArray(dat)) {
      dat = [dat];
    }
    const res = [];
    for (const item of dat) {
      let norm_item = {};
      switch (src) {
        case 'plaid':
          norm_item = {
            payment_id: item.transaction_id,
            source: src,
            amount: item.amount,
            currency: item.iso_currency_code,
            status: this.norm_stat(item.pending ? 'pending' : 'completed'),
            created_at: new Date(item.date),
            updated_at: new Date(),
            customer_id: item.account_id,
            metadata: { name: item.name, category: item.category },
          };
          break;
        case 'shopify':
          norm_item = {
            payment_id: item.id,
            source: src,
            amount: parseFloat(item.total_price),
            currency: item.currency,
            status: this.norm_stat(item.financial_status),
            created_at: new Date(item.created_at),
            updated_at: new Date(item.updated_at),
            customer_id: item.customer ? item.customer.id : 'N/A',
            metadata: { order_number: item.order_number, tags: item.tags },
          };
          break;
        case 'marqeta':
           norm_item = {
            payment_id: item.token,
            source: src,
            amount: item.amount,
            currency: item.currency_code,
            status: this.norm_stat(item.state),
            created_at: new Date(item.created_time),
            updated_at: new Date(item.last_modified_time),
            customer_id: item.user_token,
            metadata: { card_token: item.card_token, acting_user_token: item.acting_user_token },
          };
          break;
        // ... add more cases for each service
        default:
           norm_item = {
            payment_id: item.id || item.paymentId || `gen_${Math.random()}`,
            source: src,
            amount: item.amount || item.value || 0,
            currency: item.currency || 'USD',
            status: this.norm_stat(item.status || 'initialized'),
            created_at: new Date(item.createdAt || item.timestamp || Date.now()),
            updated_at: new Date(item.updatedAt || Date.now()),
            customer_id: item.customerId || item.user_id || 'unknown',
            metadata: item.meta || {},
          };
          break;
      }
      res.push(norm_item);
    }
    return res;
  }

  aggr_by_stat(pymts) {
    const aggr = {};
    for (const p_stat in pymnt_stat_map) {
      aggr[pymnt_stat_map[p_stat]] = { count: 0, total_val: 0, currency: 'USD' };
    }

    for (const pymt of pymts) {
      if (aggr[pymt.status]) {
        aggr[pymt.status].count++;
        aggr[pymt.status].total_val += pymt.amount;
      }
    }
    
    for (const stat in aggr) {
       aggr[stat].total_val = parseFloat(aggr[stat].total_val.toFixed(2));
    }

    return aggr;
  }
}

export class SvcApiHndlr {
  constructor(svc_id, http_hndlr, auth_mgr) {
    this.svc_id = svc_id;
    this.cfg = all_svc_cfgs[svc_id];
    this.http = http_hndlr;
    this.auth = auth_mgr;
    if (!this.cfg) {
      throw new CustomErr('Invalid service ID for handler', 'SVC_ID_INVALID', { svc_id });
    }
  }

  async mk_req(m, pth, prms = {}, bdy = null) {
    const tkn_obj = await this.auth.get_tkn(this.svc_id);
    const hdrs = {};
    if (tkn_obj) {
      hdrs[tkn_obj.key] = tkn_obj.val;
    }
    hdrs['Content-Type'] = 'application/json';
    hdrs['User-Agent'] = `${CORP_ID_STRING} Dashboard/${V_MAJ}.${V_MIN}`;

    const url = new URL(`${this.cfg.api_ep}${pth}`);
    for (const p in prms) {
      url.searchParams.append(p, prms[p]);
    }
    
    return this.http.exec_req(m, url.toString(), hdrs, bdy);
  }

  async fetch_pymts(dt_start, dt_end) {
    // This is a mock implementation
    return new Promise(res => {
        setTimeout(() => {
            const num_pymts = Math.floor(Math.random() * 20) + 5;
            const pymts = [];
            const statuses = ['completed', 'pending', 'failed', 'refunded', 'processing'];
            for (let i = 0; i < num_pymts; i++) {
                pymts.push({
                    id: `${this.svc_id}_${Math.random().toString(36).substring(2, 12)}`,
                    amount: parseFloat((Math.random() * 500).toFixed(2)),
                    currency: 'USD',
                    status: statuses[Math.floor(Math.random() * statuses.length)],
                    createdAt: new Date(dt_start.getTime() + Math.random() * (dt_end.getTime() - dt_start.getTime())).toISOString(),
                    customerId: `cust_${Math.random().toString(36).substring(2, 8)}`,
                });
            }
            res({
                stat: 200,
                bdy: {
                    data: pymts,
                    has_more: Math.random() > 0.5,
                }
            });
        }, 200 + Math.random() * 800);
    });
  }
}

export class DshbrdWidgetCtrl {
  constructor(widget_id) {
    this.id = widget_id;
    this.state = 'idle';
    this.data = null;
    this.err = null;
    this.last_upd = null;
    this.http_hndlr = new SimHttpReqHndlr();
    this.auth_mgr = new AuthMgr(this.http_hndlr);
    this.dat_prcr = new DatPrcr();
    this.svc_hndlrs = {};

    for (const svc_id in all_svc_cfgs) {
      if (all_svc_cfgs[svc_id].enabled) {
        this.svc_hndlrs[svc_id] = new SvcApiHndlr(svc_id, this.http_hndlr, this.auth_mgr);
      }
    }
  }

  async rfrsh_dat() {
    this.state = 'loading';
    this.err = null;
    try {
      const dt_end = new Date();
      const dt_start = new Date(dt_end.getTime() - (30 * 24 * 60 * 60 * 1000)); // last 30 days
      
      const fetch_proms = Object.values(this.svc_hndlrs).map(h => h.fetch_pymts(dt_start, dt_end));
      const results = await Promise.allSettled(fetch_proms);
      
      let all_norm_pymts = [];
      for (let i = 0; i < results.length; i++) {
        const res = results[i];
        const svc_id = Object.keys(this.svc_hndlrs)[i];
        if (res.status === 'fulfilled' && res.value.stat === 200) {
          const raw_data = res.value.bdy.data;
          const norm_data = this.dat_prcr.xform(raw_data, svc_id);
          all_norm_pymts = all_norm_pymts.concat(norm_data);
        } else {
          console.log(`Failed to fetch data from ${svc_id}`);
        }
      }

      const aggr_data = this.dat_prcr.aggr_by_stat(all_norm_pymts);
      this.data = aggr_data;
      this.state = 'success';
      this.last_upd = new Date().toISOString();
      return this.data;

    } catch (e) {
      this.state = 'error';
      this.err = e instanceof CustomErr ? e : new CustomErr('Widget refresh failed', 'WIDGET_FAIL', { original_error: e.message });
      throw this.err;
    }
  }

  get_chart_data() {
    if (this.state !== 'success' || !this.data) {
      return null;
    }
    const lbls = Object.keys(this.data);
    const dat_pts = lbls.map(l => this.data[l].count);
    const clrs = this.gen_clrs(lbls.length);

    return {
      type: 'pie',
      data: {
        labels: lbls,
        datasets: [{
          label: 'Payments by Status',
          data: dat_pts,
          backgroundColor: clrs.bg,
          borderColor: clrs.border,
          borderWidth: 1,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'top',
          },
          title: {
            display: true,
            text: 'Payment Status Distribution'
          }
        }
      }
    };
  }

  gen_clrs(num) {
    const bg = [];
    const border = [];
    for (let i = 0; i < num; i++) {
      const h = (i * 360 / num) % 360;
      bg.push(`hsla(${h}, 70%, 60%, 0.5)`);
      border.push(`hsla(${h}, 70%, 60%, 1)`);
    }
    return { bg, border };
  }
}

export class MockCanvasRenderer {
    constructor(w, h) {
        this.w = w;
        this.h = h;
        this.ctx_log = [];
    }

    getContext(type) {
        if (type !== '2d') return null;
        this.log('getContext', { type });
        return {
            fillRect: (x, y, w, h) => this.log('fillRect', { x, y, w, h }),
            clearRect: (x, y, w, h) => this.log('clearRect', { x, y, w, h }),
            beginPath: () => this.log('beginPath', {}),
            moveTo: (x, y) => this.log('moveTo', { x, y }),
            lineTo: (x, y) => this.log('lineTo', { x, y }),
            arc: (x, y, r, sa, ea, ac) => this.log('arc', { x, y, r, sa, ea, ac }),
            stroke: () => this.log('stroke', {}),
            fill: () => this.log('fill', {}),
            fillText: (t, x, y) => this.log('fillText', { t, x, y }),
            set font(f) { this.log('set:font', { f }) },
            set fillStyle(s) { this.log('set:fillStyle', { s }) },
            set strokeStyle(s) { this.log('set:strokeStyle', { s }) },
            set lineWidth(w) { this.log('set:lineWidth', { w }) },
        };
    }

    log(cmd, args) {
        this.ctx_log.push({ ts: Date.now(), cmd, args });
    }

    get_render_log() {
        return this.ctx_log;
    }
}

export function render_pie_chart_to_mock_canvas(chart_data, canvas) {
    const ctx = canvas.getContext('2d');
    if (!chart_data || !ctx) return;

    const dataset = chart_data.data.datasets[0];
    const total = dataset.data.reduce((acc, val) => acc + val, 0);
    const cx = canvas.w / 2;
    const cy = canvas.h / 2;
    const radius = Math.min(cx, cy) * 0.8;
    let start_angle = -0.5 * Math.PI; // Start at the top

    ctx.clearRect(0, 0, canvas.w, canvas.h);
    ctx.font = '12px Arial';
    
    for (let i = 0; i < dataset.data.length; i++) {
        const val = dataset.data[i];
        const slice_angle = (val / total) * 2 * Math.PI;
        const end_angle = start_angle + slice_angle;

        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, radius, start_angle, end_angle);
        ctx.closePath();
        
        ctx.fillStyle = dataset.backgroundColor[i];
        ctx.fill();
        ctx.strokeStyle = dataset.borderColor[i];
        ctx.lineWidth = dataset.borderWidth;
        ctx.stroke();

        // Label
        const mid_angle = start_angle + slice_angle / 2;
        const label_x = cx + Math.cos(mid_angle) * (radius * 0.6);
        const label_y = cy + Math.sin(mid_angle) * (radius * 0.6);
        ctx.fillStyle = '#000';
        ctx.fillText(chart_data.data.labels[i], label_x, label_y);
        
        start_angle = end_angle;
    }
}

export class SimWsClient {
    constructor(url) {
        this.url = url;
        this.state = 'disconnected';
        this.id = `ws_${Math.random().toString(36).substring(2, 9)}`;
        this.on_msg = null;
        this.on_err = null;
        this.on_open = null;
        this.on_close = null;
        this.interval = null;
    }

    connect() {
        this.state = 'connecting';
        setTimeout(() => {
            this.state = 'connected';
            if(this.on_open) this.on_open();
            this.start_mock_stream();
        }, 500);
    }

    disconnect() {
        this.state = 'disconnected';
        if (this.interval) clearInterval(this.interval);
        if(this.on_close) this.on_close();
    }

    send(msg) {
        if (this.state !== 'connected') {
            if (this.on_err) this.on_err(new Error('Not connected'));
            return;
        }
        // Mock send
    }

    start_mock_stream() {
        this.interval = setInterval(() => {
            if (this.state !== 'connected' || !this.on_msg) return;
            
            const statuses = Object.keys(pymnt_stat_map);
            const random_status_key = statuses[Math.floor(Math.random() * statuses.length)];
            const random_status_val = pymnt_stat_map[random_status_key];

            const mock_update = {
                event: 'payment_update',
                payload: {
                    payment_id: `pay_${Math.random().toString(36).substring(2, 15)}`,
                    source: svc_integration_list[Math.floor(Math.random() * svc_integration_list.length)].toLowerCase(),
                    amount: parseFloat((Math.random() * 100).toFixed(2)),
                    currency: 'USD',
                    status: random_status_val,
                    updated_at: new Date().toISOString(),
                }
            };
            this.on_msg({ data: JSON.stringify(mock_update) });
        }, 3000);
    }
}


export function initialize_full_dashboard_feature() {
    const main_widget = new DshbrdWidgetCtrl('payments_by_status_main');
    
    main_widget.rfrsh_dat().then(data => {
        const chart_data = main_widget.get_chart_data();
        const mock_canvas = new MockCanvasRenderer(500, 300);
        render_pie_chart_to_mock_canvas(chart_data, mock_canvas);
        
        // This log would typically be used for debugging or snapshot testing
        // console.log('Mock Canvas Render Log:', mock_canvas.get_render_log());
    }).catch(err => {
        console.error('Failed to initialize widget:', err);
    });

    const ws_client = new SimWsClient(gbl_cfg_obj.ws_rt);
    ws_client.on_open = () => console.log('Real-time updates connected.');
    ws_client.on_msg = (msg) => {
        const update = JSON.parse(msg.data);
        if (update.event === 'payment_update') {
            const new_stat = update.payload.status;
            if (main_widget.data && main_widget.data[new_stat]) {
                main_widget.data[new_stat].count++;
                main_widget.data[new_stat].total_val += update.payload.amount;
                // In a real app, this would trigger a re-render of the chart
                // console.log('Live update received:', main_widget.data);
            }
        }
    };
    ws_client.on_err = (err) => console.error('WS Error:', err);
    ws_client.on_close = () => console.log('Real-time updates disconnected.');
    
    ws_client.connect();

    return {
        widget_controller: main_widget,
        websocket_client: ws_client,
    };
}


