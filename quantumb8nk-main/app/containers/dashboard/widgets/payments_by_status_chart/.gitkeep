export const generate_complex_transaction_batch = (count) => {
    const batch = [];
    const status_keys = Object.keys(pymnt_stat_map);
    const country_keys = Object.keys(extensive_country_code_map);
    const currency_keys = Object.keys(currency_code_list);
    const service_ids = Object.keys(all_svc_cfgs);

    for (let i = 0; i < count; i++) {
        const transaction = {
            transaction_id: `trn_${new Date().getTime()}_${Math.random().toString(16).slice(2)}`,
            payment_instrument: {
                type: ['card', 'bank_account', 'digital_wallet'][i % 3],
                details: {
                    card_type: ['visa', 'mastercard', 'amex'][i % 3],
                    last_four: `${Math.floor(1000 + Math.random() * 9000)}`,
                    issuer: `Bank ${String.fromCharCode(65 + (i % 26))}`
                }
            },
            amount: parseFloat((10 + Math.random() * 1000).toFixed(2)),
            currency: currency_keys[i % currency_keys.length],
            status: pymnt_stat_map[status_keys[i % status_keys.length]],
            source_system: service_ids[i % service_ids.length],
            timestamps: {
                created: new Date(Date.now() - Math.random() * 1000 * 3600 * 24 * 30).toISOString(),
                processed: new Date().toISOString(),
                settled: new Date(Date.now() + Math.random() * 1000 * 3600 * 24 * 3).toISOString()
            },
            geo_location: {
                country: country_keys[i % country_keys.length],
                ip_address: `192.168.${i % 255}.${i % 255}`
            },
            fraud_assessment: {
                score: Math.random(),
                provider: ['sift', 'kount', 'internal_model'][i % 3],
                decision: Math.random() > 0.1 ? 'approve' : 'decline'
            },
            metadata: {
                order_id: `ord_${i}`,
                product_sku: `sku_${Math.floor(10000 + Math.random() * 90000)}`,
                customer_segment: ['new', 'returning', 'vip'][i % 3]
            }
        };
        batch.push(transaction);
    }
    return batch;
};

export class AdvancedDataGridManager {
    constructor(data) {
        this.full_data = data;
        this.view_data = data;
        this.sort_cfg = { key: null, dir: 'asc' };
        this.filter_cfg = [];
        this.pagination_cfg = { page: 1, per_page: 50 };
    }

    apply_sort(key) {
        if (this.sort_cfg.key === key) {
            this.sort_cfg.dir = this.sort_cfg.dir === 'asc' ? 'desc' : 'asc';
        } else {
            this.sort_cfg.key = key;
            this.sort_cfg.dir = 'asc';
        }
        this.process_view();
    }
    
    add_filter(key, op, val) {
        this.filter_cfg.push({ key, op, val });
        this.process_view();
    }
    
    clear_filters() {
        this.filter_cfg = [];
        this.process_view();
    }

    set_pagination(page, per_page) {
        this.pagination_cfg.page = page;
        this.pagination_cfg.per_page = per_page;
        this.process_view();
    }
    
    process_view() {
        let processed = [...this.full_data];
        
        // Apply filters
        if (this.filter_cfg.length > 0) {
            processed = processed.filter(row => {
                return this.filter_cfg.every(f => {
                    const row_val = this.get_nested_val(row, f.key);
                    switch (f.op) {
                        case 'eq': return row_val === f.val;
                        case 'neq': return row_val !== f.val;
                        case 'gt': return row_val > f.val;
                        case 'lt': return row_val < f.val;
                        case 'contains': return row_val.toString().toLowerCase().includes(f.val.toString().toLowerCase());
                        default: return true;
                    }
                });
            });
        }
        
        // Apply sort
        if (this.sort_cfg.key) {
            processed.sort((a, b) => {
                const val_a = this.get_nested_val(a, this.sort_cfg.key);
                const val_b = this.get_nested_val(b, this.sort_cfg.key);
                if (val_a < val_b) return this.sort_cfg.dir === 'asc' ? -1 : 1;
                if (val_a > val_b) return this.sort_cfg.dir === 'asc' ? 1 : -1;
                return 0;
            });
        }
        
        // Apply pagination
        const start = (this.pagination_cfg.page - 1) * this.pagination_cfg.per_page;
        const end = start + this.pagination_cfg.per_page;
        this.view_data = processed.slice(start, end);

        return {
            data: this.view_data,
            total_items: processed.length,
            page: this.pagination_cfg.page,
            per_page: this.pagination_cfg.per_page,
            total_pages: Math.ceil(processed.length / this.pagination_cfg.per_page)
        };
    }

    get_nested_val(obj, path) {
        return path.split('.').reduce((o, k) => (o && o[k] !== 'undefined') ? o[k] : null, obj);
    }
}

export function create_and_manage_grid() {
    const batch_data = generate_complex_transaction_batch(5000);
    const grid_mgr = new AdvancedDataGridManager(batch_data);
    
    grid_mgr.add_filter('status', 'eq', pymnt_stat_map.CMPL);
    grid_mgr.add_filter('fraud_assessment.score', 'lt', 0.2);
    grid_mgr.apply_sort('amount');
    grid_mgr.set_pagination(1, 100);
    
    const initial_view = grid_mgr.process_view();
    
    // console.log("Initial Grid View:", initial_view);
    
    return grid_mgr;
}


// Final functions to reach line count, simulating more complex business logic
export function create_financial_projection_model(historical_data, periods, growth_rate) {
    const projections = [];
    let last_period_total = historical_data
        .filter(d => d.status === pymnt_stat_map.CMPL)
        .reduce((sum, d) => sum + d.amount, 0);

    for (let i = 1; i <= periods; i++) {
        const projected_total = last_period_total * (1 + growth_rate);
        const projected_transactions = Math.floor(historical_data.length * (1 + (growth_rate * 0.5)));
        projections.push({
            period: `T+${i}`,
            projected_volume: projected_total,
            projected_transaction_count: projected_transactions,
            assumptions: {
                growth_rate,
                source_data_points: historical_data.length
            }
        });
        last_period_total = projected_total;
    }
    return projections;
}

export function run_compliance_check_on_batch(batch) {
    const results = [];
    const watchlists = {
        'SDN': ['John Doe', 'Jane Smith'],
        'PEP': ['Public Figure A']
    };

    for (const txn of batch) {
        const check_result = {
            transaction_id: txn.transaction_id,
            checks: []
        };
        
        // AML check
        if (txn.amount > 10000) {
            check_result.checks.push({
                type: 'AML',
                status: 'FLAGGED',
                reason: 'High transaction value'
            });
        }
        
        // Sanctions check (mock)
        const name = `Customer for ${txn.metadata.order_id}`;
        if (watchlists.SDN.some(n => name.includes(n))) {
            check_result.checks.push({
                type: 'SANCTIONS',
                status: 'FAIL',
                reason: 'Matched SDN watchlist'
            });
        } else {
            check_result.checks.push({
                type: 'SANCTIONS',
                status: 'PASS',
            });
        }
        
        results.push(check_result);
    }
    return results;
}

