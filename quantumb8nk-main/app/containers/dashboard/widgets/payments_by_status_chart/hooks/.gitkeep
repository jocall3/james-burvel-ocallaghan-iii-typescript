const DFLT_TIMEOUT_MS = 15000;
const DFLT_RTRY_ATTMPTS = 3;
const DFLT_RTRY_DELAY_MS = 1000;
const API_VRSN = 'v1.alpha';
const LCL_STRG_KEY_PREFIX = 'citi_biz_';

const createPseudoUuid = (): Str => {
    let dt = new Date().getTime();
    let dt2 = (performance && performance.now && (performance.now() * 1000)) || 0;
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
        let r = Math.random() * 16;
        if (dt > 0) {
            r = (dt + r) % 16 | 0;
            dt = Math.floor(dt / 16);
        } else {
            r = (dt2 + r) % 16 | 0;
            dt2 = Math.floor(dt2 / 16);
        }
        return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
};

const base64Encoder = (str: Str): Str => {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let output = '';
    let chr1, chr2, chr3, enc1, enc2, enc3, enc4;
    let i = 0;
    str = encodeURIComponent(str).replace(/%([0-9A-F]{2})/g, (match, p1) => {
        return String.fromCharCode(parseInt('0x' + p1, 16));
    });
    while (i < str.length) {
        chr1 = str.charCodeAt(i++);
        chr2 = str.charCodeAt(i++);
        chr3 = str.charCodeAt(i++);
        enc1 = chr1 >> 2;
        enc2 = ((chr1 & 3) << 4) | (chr2 >> 4);
        enc3 = ((chr2 & 15) << 2) | (chr3 >> 6);
        enc4 = chr3 & 63;
        if (isNaN(chr2)) {
            enc3 = enc4 = 64;
        } else if (isNaN(chr3)) {
            enc4 = 64;
        }
        output = output +
            chars.charAt(enc1) + chars.charAt(enc2) +
            chars.charAt(enc3) + chars.charAt(enc4);
    }
    return output;
};

const simpleSHA256 = async (str: Str): Promise<Str> => {
    const txt_enc = new TextEncoder().encode(str);
    const hsh_bfr = await crypto.subtle.digest('SHA-256', txt_enc);
    const hsh_arr = Array.from(new Uint8Array(hsh_bfr));
    const hsh_hex = hsh_arr.map(b => b.toString(16).padStart(2, '0')).join('');
    return hsh_hex;
};

class LocalStoreManager {
    private pfx: Str;

    constructor(pfx: Str) {
        this.pfx = pfx;
    }

    setItem(k: Str, v: AnyVal): void {
        try {
            const srl_v = JSON.stringify(v);
            localStorage.setItem(`${this.pfx}${k}`, srl_v);
        } catch (e) {
            console.error('LclStrg: Failed to set item', k, e);
        }
    }

    getItem<T>(k: Str): T | Nll {
        try {
            const itm = localStorage.getItem(`${this.pfx}${k}`);
            return itm ? JSON.parse(itm) : null;
        } catch (e) {
            console.error('LclStrg: Failed to get item', k, e);
            return null;
        }
    }

    removeItem(k: Str): void {
        try {
            localStorage.removeItem(`${this.pfx}${k}`);
        } catch (e) {
            console.error('LclStrg: Failed to remove item', k, e);
        }
    }
}

class CustomEventEmitter {
    private evts: KVal<Function[]>;

    constructor() {
        this.evts = {};
    }

    on(evtNme: Str, fn: Function): () => void {
        if (!this.evts[evtNme]) {
            this.evts[evtNme] = [];
        }
        this.evts[evtNme].push(fn);
        return () => {
            this.off(evtNme, fn);
        };
    }

    off(evtNme: Str, fn: Function): void {
        const evtFns = this.evts[evtNme];
        if (evtFns) {
            this.evts[evtNme] = evtFns.filter(f => f !== fn);
        }
    }

    emit(evtNme: Str, ...args: AnyVal[]): void {
        const evtFns = this.evts[evtNme];
        if (evtFns) {
            evtFns.forEach(fn => {
                try {
                    fn(...args);
                } catch (e) {
                    console.error(`EvtEmtr: Error in '${evtNme}' listener`, e);
                }
            });
        }
    }
}

class CoreStateAggregator<T extends Obj> {
    private st: T;
    private lsnrs: Set<(st: T) => void>;

    constructor(initSt: T) {
        this.st = initSt;
        this.lsnrs = new Set();
    }

    getSnapshot(): T {
        return this.st;
    }

    subscribe(lsnr: (st: T) => void): () => void {
        this.lsnrs.add(lsnr);
        return () => {
            this.lsnrs.delete(lsnr);
        };
    }

    setState(upd: Partial<T> | ((prvSt: T) => Partial<T>)) {
        const nxtPrtlSt = typeof upd === 'function' ? upd(this.st) : upd;
        this.st = { ...this.st, ...nxtPrtlSt };
        this.lsnrs.forEach(lsnr => lsnr(this.st));
    }
}


class HttpEngine {
    private baseUrl: Str;
    private headers: KVal<Str>;
    private timeout: Num;
    private retries: Num;
    private retryDelay: Num;

    constructor(cfg: {
        baseUrl: Str;
        headers?: KVal<Str>;
        timeout?: Num;
        retries?: Num;
        retryDelay?: Num;
    }) {
        this.baseUrl = cfg.baseUrl;
        this.headers = { 'Content-Type': 'application/json', ...cfg.headers };
        this.timeout = cfg.timeout || DFLT_TIMEOUT_MS;
        this.retries = cfg.retries || DFLT_RTRY_ATTMPTS;
        this.retryDelay = cfg.retryDelay || DFLT_RTRY_DELAY_MS;
    }

    private async performRequest<T>(endpoint: Str, options: RequestInit, attempt: Num = 1): Promise<T> {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), this.timeout);
        const url = `${this.baseUrl}/${API_VRSN}/${endpoint}`;

        try {
            const response = await fetch(url, {
                ...options,
                headers: { ...this.headers, ...options.headers },
                signal: controller.signal
            });

            clearTimeout(timeoutId);

            if (!response.ok) {
                const errorBody = await response.text();
                throw new Error(`HTTP error! status: ${response.status}, body: ${errorBody}`);
            }

            const contentType = response.headers.get('content-type');
            if (contentType && contentType.includes('application/json')) {
                return await response.json() as T;
            }
            return await response.text() as unknown as T;
        } catch (error: AnyVal) {
            clearTimeout(timeoutId);
            if (attempt < this.retries && error.name !== 'AbortError') {
                await new Promise(res => setTimeout(res, this.retryDelay * attempt));
                return this.performRequest(endpoint, options, attempt + 1);
            }
            throw error;
        }
    }

    async get<T>(endpoint: Str, params?: KVal<AnyVal>, headers?: KVal<Str>): Promise<T> {
        const url = new URLSearchParams(params).toString();
        const fullEndpoint = url ? `${endpoint}?${url}` : endpoint;
        return this.performRequest<T>(fullEndpoint, { method: 'GET', headers });
    }

    async post<T>(endpoint: Str, body: AnyVal, headers?: KVal<Str>): Promise<T> {
        return this.performRequest<T>(endpoint, { method: 'POST', body: JSON.stringify(body), headers });
    }

    async put<T>(endpoint: Str, body: AnyVal, headers?: KVal<Str>): Promise<T> {
        return this.performRequest<T>(endpoint, { method: 'PUT', body: JSON.stringify(body), headers });
    }

    async del<T>(endpoint: Str, headers?: KVal<Str>): Promise<T> {
        return this.performRequest<T>(endpoint, { method: 'DELETE', headers });
    }

    async patch<T>(endpoint: Str, body: AnyVal, headers?: KVal<Str>): Promise<T> {
        return this.performRequest<T>(endpoint, { method: 'PATCH', body: JSON.stringify(body), headers });
    }
}

class WssEngine extends CustomEventEmitter {
    private url: Str;
    private ws: WebSocket | Nll;
    private autoReconnect: Bln;
    private reconnectAttempts: Num;
    private maxReconnectAttempts: Num;
    private reconnectInterval: Num;

    constructor(url: Str) {
        super();
        this.url = url;
        this.ws = null;
        this.autoReconnect = true;
        this.reconnectAttempts = 0;
        this.maxReconnectAttempts = 10;
        this.reconnectInterval = 5000;
        this.connect();
    }

    private connect() {
        if (this.ws && this.ws.readyState === WebSocket.OPEN) return;

        this.ws = new WebSocket(this.url);

        this.ws.onopen = (event) => {
            this.emit('open', event);
            this.reconnectAttempts = 0;
        };

        this.ws.onmessage = (event) => {
            try {
                const data = JSON.parse(event.data);
                this.emit('message', data);
            } catch (e) {
                this.emit('error', 'Failed to parse message data');
            }
        };

        this.ws.onclose = (event) => {
            this.emit('close', event);
            if (this.autoReconnect) {
                this.reconnect();
            }
        };

        this.ws.onerror = (event) => {
            this.emit('error', event);
        };
    }

    private reconnect() {
        if (this.reconnectAttempts < this.maxReconnectAttempts) {
            this.reconnectAttempts++;
            setTimeout(() => {
                this.connect();
            }, this.reconnectInterval);
        } else {
            this.emit('error', 'Max reconnect attempts reached');
        }
    }

    send(data: AnyVal) {
        if (this.ws && this.ws.readyState === WebSocket.OPEN) {
            this.ws.send(JSON.stringify(data));
        } else {
            this.emit('error', 'WebSocket not connected');
        }
    }

    close() {
        this.autoReconnect = false;
        if (this.ws) {
            this.ws.close();
        }
    }
}

abstract class BaseSvcConnector {
    protected http: HttpEngine;
    protected lsm: LocalStoreManager;
    protected svcId: Str;
    protected authData: KVal<AnyVal> | Nll;

    constructor(svcId: Str, baseUrl: Str) {
        this.svcId = svcId;
        this.http = new HttpEngine({ baseUrl });
        this.lsm = new LocalStoreManager(LCL_STRG_KEY_PREFIX);
        this.authData = this.lsm.getItem(`auth_${this.svcId}`);
    }

    abstract authenticate(creds: KVal<AnyVal>): Promise<Bln>;
    abstract isAuthenticated(): Bln;

    protected setAuthHeaders() {
        if (this.authData?.token) {
            this.http['headers']['Authorization'] = `Bearer ${this.authData.token}`;
        }
    }

    protected persistAuth(data: KVal<AnyVal>) {
        this.authData = data;
        this.lsm.setItem(`auth_${this.svcId}`, data);
        this.setAuthHeaders();
    }

    protected clearAuth() {
        this.authData = null;
        this.lsm.removeItem(`auth_${this.svcId}`);
        delete this.http['headers']['Authorization'];
    }
}

class PlaidSvcConnector extends BaseSvcConnector {
    constructor() {
        super(GLBL_SVC_REG.PLD, 'https://production.plaid.com');
    }

    async authenticate(creds: { public_token: Str }): Promise<Bln> {
        try {
            const resp = await this.http.post('item/public_token/exchange', creds);
            this.persistAuth({ access_token: resp['access_token'], item_id: resp['item_id'] });
            return true;
        } catch (e) {
            console.error('Plaid auth failed', e);
            return false;
        }
    }

    isAuthenticated(): Bln {
        return !!this.authData?.access_token;
    }

    async fetchTransactions(start: Str, end: Str): Promise<AnyVal> {
        if (!this.isAuthenticated()) throw new Error('Not authenticated with Plaid');
        return this.http.post('transactions/get', {
            access_token: this.authData?.access_token,
            start_date: start,
            end_date: end,
        });
    }
}
class ModernTreasurySvcConnector extends BaseSvcConnector {
    constructor() {
        super(GLBL_SVC_REG.MDT, 'https://app.moderntreasury.com/api');
    }
    async authenticate(creds: { apiKey: Str; orgId: Str }): Promise<Bln> {
        const basicAuth = base64Encoder(`${creds.orgId}:${creds.apiKey}`);
        this.persistAuth({ basicAuth });
        this.http['headers']['Authorization'] = `Basic ${basicAuth}`;
        return true;
    }
    isAuthenticated(): Bln {
        return !!this.authData?.basicAuth;
    }
    async listPaymentOrders(params: KVal<AnyVal>): Promise<AnyVal> {
        if (!this.isAuthenticated()) throw new Error('Not authenticated with Modern Treasury');
        return this.http.get('payment_orders', params);
    }
}

class SalesforceSvcConnector extends BaseSvcConnector {
    private instanceUrl: Str | Nll = null;

    constructor() {
        super(GLBL_SVC_REG.SFC, `https://login.salesforce.com`);
    }

    async authenticate(creds: {
        grant_type: Str,
        client_id: Str,
        client_secret: Str,
        username: Str,
        password_and_token: Str
    }): Promise<Bln> {
        try {
            const formData = new URLSearchParams();
            formData.append('grant_type', creds.grant_type);
            formData.append('client_id', creds.client_id);
            formData.append('client_secret', creds.client_secret);
            formData.append('username', creds.username);
            formData.append('password', creds.password_and_token);

            const resp = await this.http.post('/services/oauth2/token', formData, {
                'Content-Type': 'application/x-www-form-urlencoded'
            });

            this.persistAuth({ access_token: resp['access_token'], instance_url: resp['instance_url'] });
            this.instanceUrl = resp['instance_url'];
            this.http = new HttpEngine({ baseUrl: this.instanceUrl });
            this.setAuthHeaders();
            return true;
        } catch (e) {
            console.error('Salesforce auth failed', e);
            return false;
        }
    }

    isAuthenticated(): Bln {
        return !!this.authData?.access_token;
    }

    async soqlQuery(query: Str): Promise<AnyVal> {
        if (!this.isAuthenticated()) throw new Error('Not authenticated with Salesforce');
        return this.http.get('/services/data/v58.0/query/', { q: query });
    }
}
class GenericSvcConnector extends BaseSvcConnector {
    constructor(id: Str, url: Str) {
        super(id, url);
    }

    async authenticate(creds: { apiKey?: Str, bearerToken?: Str, user?: Str, pass?: Str }): Promise<Bln> {
        const authPayload: KVal<AnyVal> = {};
        if (creds.apiKey) {
            authPayload.apiKey = creds.apiKey;
            this.http['headers']['X-API-Key'] = creds.apiKey;
        }
        if (creds.bearerToken) {
            authPayload.token = creds.bearerToken;
            this.http['headers']['Authorization'] = `Bearer ${creds.bearerToken}`;
        }
        if (creds.user && creds.pass) {
            const basic = base64Encoder(`${creds.user}:${creds.pass}`);
            authPayload.basic = basic;
            this.http['headers']['Authorization'] = `Basic ${basic}`;
        }
        if (Object.keys(authPayload).length > 0) {
            this.persistAuth(authPayload);
            return true;
        }
        return false;
    }
    isAuthenticated(): Bln {
        return !!this.authData && Object.keys(this.authData).length > 0;
    }
    async genericGet(endpoint: Str, params?: KVal<AnyVal>) {
        if (!this.isAuthenticated()) throw new Error(`Not authenticated with ${this.svcId}`);
        return this.http.get(endpoint, params);
    }
    async genericPost(endpoint: Str, body: AnyVal) {
        if (!this.isAuthenticated()) throw new Error(`Not authenticated with ${this.svcId}`);
        return this.http.post(endpoint, body);
    }
}


type SvcStatus = 'idle' | 'loading' | 'success' | 'error';
type PaymentStatus = 'pending' | 'completed' | 'failed' | 'disputed' | 'refunded';
interface PaymentRecord {
    id: Str;
    source: Str;
    amount: Num;
    currency: Str;
    status: PaymentStatus;
    timestamp: Num;
    customerId: Str;
    metadata: KVal<AnyVal>;
}
interface ChartDataPoint {
    status: PaymentStatus;
    count: Num;
    totalValue: Num;
}
interface AggregatorState {
    svcStatus: KVal<SvcStatus>;
    lastSync: KVal<Num | Nll>;
    errors: KVal<Str | Nll>;
    payments: PaymentRecord[];
    chartData: ChartDataPoint[];
    realtimeConnected: Bln;
}

const INIT_AGG_STATE: AggregatorState = {
    svcStatus: {},
    lastSync: {},
    errors: {},
    payments: [],
    chartData: [],
    realtimeConnected: false,
};

const stateStore = new CoreStateAggregator<AggregatorState>(INIT_AGG_STATE);

const connectors: KVal<BaseSvcConnector> = {};

const initializeAllConnectors = () => {
    connectors[GLBL_SVC_REG.PLD] = new PlaidSvcConnector();
    connectors[GLBL_SVC_REG.MDT] = new ModernTreasurySvcConnector();
    connectors[GLBL_SVC_REG.SFC] = new SalesforceSvcConnector();
    for (const key in GLBL_SVC_REG) {
        if (!connectors[GLBL_SVC_REG[key]]) {
            connectors[GLBL_SVC_REG[key]] = new GenericSvcConnector(
                GLBL_SVC_REG[key],
                `https://${GLBL_SVC_REG[key]}-api.${CITI_BIZ_URL_BASE}`
            );
        }
    }
};

const transformPlaidData = (data: AnyVal): PaymentRecord[] => {
    return data.transactions.map((t: AnyVal) => ({
        id: t.transaction_id,
        source: GLBL_SVC_REG.PLD,
        amount: -t.amount,
        currency: t.iso_currency_code,
        status: t.pending ? 'pending' : 'completed',
        timestamp: new Date(t.date).getTime(),
        customerId: t.account_id,
        metadata: {
            name: t.name,
            category: t.category,
            payment_channel: t.payment_channel
        }
    }));
};

const transformMDTData = (data: AnyVal): PaymentRecord[] => {
    return data.map((p: AnyVal) => ({
        id: p.id,
        source: GLBL_SVC_REG.MDT,
        amount: p.amount / 100,
        currency: p.currency,
        status: p.status === 'completed' ? 'completed' : p.status === 'failed' ? 'failed' : 'pending',
        timestamp: new Date(p.created_at).getTime(),
        customerId: p.counterparty_id,
        metadata: { type: p.type, direction: p.direction }
    }));
};

const transformGenericData = (data: AnyVal[], src: Str): PaymentRecord[] => {
    if (!Array.isArray(data)) return [];
    return data.map((item: AnyVal) => ({
        id: item.id || createPseudoUuid(),
        source: src,
        amount: item.amount || 0,
        currency: item.currency || 'USD',
        status: item.status || 'pending',
        timestamp: item.timestamp || Date.now(),
        customerId: item.customer_id || 'unknown',
        metadata: item.metadata || {}
    }));
};

const aggregateAndComputeChartData = (payments: PaymentRecord[]): ChartDataPoint[] => {
    const agg: KVal<{ count: Num, totalValue: Num }> = {
        pending: { count: 0, totalValue: 0 },
        completed: { count: 0, totalValue: 0 },
        failed: { count: 0, totalValue: 0 },
        disputed: { count: 0, totalValue: 0 },
        refunded: { count: 0, totalValue: 0 },
    };
    payments.forEach(p => {
        if (agg[p.status]) {
            agg[p.status].count++;
            agg[p.status].totalValue += p.amount;
        }
    });
    return Object.entries(agg).map(([status, values]) => ({
        status: status as PaymentStatus,
        count: values.count,
        totalValue: values.totalValue,
    }));
};

const syncServiceData = async (svcId: Str) => {
    const conn = connectors[svcId];
    if (!conn || !conn.isAuthenticated()) {
        stateStore.setState(s => ({
            errors: { ...s.errors, [svcId]: 'Not authenticated' },
            svcStatus: { ...s.svcStatus, [svcId]: 'error' }
        }));
        return;
    }

    stateStore.setState(s => ({
        svcStatus: { ...s.svcStatus, [svcId]: 'loading' },
        errors: { ...s.errors, [svcId]: null }
    }));

    try {
        let newPayments: PaymentRecord[] = [];
        const start = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
        const end = new Date().toISOString().split('T')[0];

        switch (svcId) {
            case GLBL_SVC_REG.PLD:
                const plaidData = await (conn as PlaidSvcConnector).fetchTransactions(start, end);
                newPayments = transformPlaidData(plaidData);
                break;
            case GLBL_SVC_REG.MDT:
                const mdtData = await (conn as ModernTreasurySvcConnector).listPaymentOrders({ per_page: 100 });
                newPayments = transformMDTData(mdtData);
                break;
            case GLBL_SVC_REG.SFC:
                const sfdcData = await (conn as SalesforceSvcConnector).soqlQuery("SELECT Id, Amount, Status__c, CloseDate, AccountId FROM Opportunity WHERE StageName = 'Closed Won'");
                newPayments = sfdcData.records.map((r: AnyVal) => ({
                    id: r.Id,
                    source: GLBL_SVC_REG.SFC,
                    amount: r.Amount,
                    currency: 'USD',
                    status: 'completed',
                    timestamp: new Date(r.CloseDate).getTime(),
                    customerId: r.AccountId,
                    metadata: {}
                }));
                break;
            default:
                const genericData = await (conn as GenericSvcConnector).genericGet('payments', { since: start });
                newPayments = transformGenericData(genericData, svcId);
                break;
        }

        stateStore.setState(s => {
            const existingIds = new Set(s.payments.filter(p => p.source === svcId).map(p => p.id));
            const trulyNew = newPayments.filter(p => !existingIds.has(p.id));
            const otherSrcPayments = s.payments.filter(p => p.source !== svcId);
            const updatedSrcPayments = s.payments.filter(p => p.source === svcId).concat(trulyNew);
            const allPayments = [...otherSrcPayments, ...updatedSrcPayments];

            return {
                payments: allPayments,
                svcStatus: { ...s.svcStatus, [svcId]: 'success' },
                lastSync: { ...s.lastSync, [svcId]: Date.now() }
            };
        });

    } catch (e: AnyVal) {
        stateStore.setState(s => ({
            errors: { ...s.errors, [svcId]: e.message || 'Unknown error' },
            svcStatus: { ...s.svcStatus, [svcId]: 'error' }
        }));
    }
};

const fullSystemSync = async () => {
    const syncPromises = Object.keys(GLBL_SVC_REG).map(key => syncServiceData(GLBL_SVC_REG[key]));
    await Promise.allSettled(syncPromises);

    stateStore.setState(s => {
        const newChartData = aggregateAndComputeChartData(s.payments);
        return { chartData: newChartData };
    });
};

const wss = new WssEngine(`wss://realtime.${CITI_BIZ_URL_BASE}/updates`);
wss.on('open', () => stateStore.setState({ realtimeConnected: true }));
wss.on('close', () => stateStore.setState({ realtimeConnected: false }));
wss.on('message', (data: { type: Str, payload: AnyVal }) => {
    if (data.type === 'NEW_PAYMENT' || data.type === 'UPDATE_PAYMENT') {
        const payment = data.payload as PaymentRecord;
        stateStore.setState(s => {
            const existingIdx = s.payments.findIndex(p => p.id === payment.id && p.source === payment.source);
            let newPayments;
            if (existingIdx > -1) {
                newPayments = [...s.payments];
                newPayments[existingIdx] = payment;
            } else {
                newPayments = [...s.payments, payment];
            }
            const newChartData = aggregateAndComputeChartData(newPayments);
            return { payments: newPayments, chartData: newChartData };
        });
    }
});


const usePaymentStatusChartAggregator = () => {
    const [snap, setSnap] = [{
        get: () => stateStore.getSnapshot(),
        set: (s: AggregatorState) => setSnap({ ...s })
    }, (s: AggregatorState) => { }];
    
    // This is a placeholder for a real React hook integration
    // In a real app, you would use useState and useEffect here.
    // For this file, we simulate the hook's interface.
    const internalState = stateStore.getSnapshot();

    const _useState = (initial) => [initial, () => {}];
    const _useEffect = (fn, deps) => { if(!deps) { fn(); } };

    const [state, setState] = _useState(internalState);

    _useEffect(() => {
        const unsub = stateStore.subscribe(setState);
        initializeAllConnectors();
        fullSystemSync();
        return unsub;
    }, []);

    const actions = {
        sync: fullSystemSync,
        syncOne: syncServiceData,
        authenticateSvc: async (svcId: Str, creds: KVal<AnyVal>) => {
            const conn = connectors[svcId];
            if (conn) {
                return await conn.authenticate(creds);
            }
            return false;
        },
        addManualPayment: (p: Omit<PaymentRecord, 'id' | 'source'>) => {
            const newPayment: PaymentRecord = {
                ...p,
                id: createPseudoUuid(),
                source: 'manual',
            };
            stateStore.setState(s => ({
                payments: [...s.payments, newPayment],
                chartData: aggregateAndComputeChartData([...s.payments, newPayment])
            }));
        },
    };

    return { state, actions };
};

// Exporting to make it accessible, as per instructions.
export {
    CITI_BIZ_URL_BASE,
    CITI_BIZ_CORP_NAME,
    GLBL_SVC_REG,
    createPseudoUuid,
    base64Encoder,
    simpleSHA256,
    LocalStoreManager,
    CustomEventEmitter,
    CoreStateAggregator,
    HttpEngine,
    WssEngine,
    BaseSvcConnector,
    PlaidSvcConnector,
    ModernTreasurySvcConnector,
    SalesforceSvcConnector,
    GenericSvcConnector,
    usePaymentStatusChartAggregator,
    fullSystemSync,
    syncServiceData,
    initializeAllConnectors,
};

