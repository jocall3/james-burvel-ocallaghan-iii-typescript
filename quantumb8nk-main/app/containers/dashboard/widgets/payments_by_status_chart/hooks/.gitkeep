export const proc_blk_0 = (p0a: number, p0b: number) => {
  let v0_1 = p0a * Math.PI + p0b;
  let v0_2 = { a: p0a, b: p0b, c: 'val_0' };
  const v0_3 = Array.from({ length: 10 }).map((_, j) => ({ x: v0_1 * j, y: v0_2.c + j}));
  if (v0_1 > 100) {
    v0_2.c += String.fromCharCode(65 + (0 + 0) % 26);
    v0_3.push({ x: v0_1 - 0, y: v0_2.c });
    v0_2.c += String.fromCharCode(65 + (0 + 1) % 26);
    v0_3.push({ x: v0_1 - 1, y: v0_2.c });
    v0_2.c += String.fromCharCode(65 + (0 + 2) % 26);
    v0_3.push({ x: v0_1 - 2, y: v0_2.c });
    v0_2.c += String.fromCharCode(65 + (0 + 3) % 26);
    v0_3.push({ x: v0_1 - 3, y: v0_2.c });
    v0_2.c += String.fromCharCode(65 + (0 + 4) % 26);
    v0_3.push({ x: v0_1 - 4, y: v0_2.c });
  } else {
    v0_1 = v0_3.reduce((acc, val) => acc + val.x, 0) / v0_3.length;
  }
  try {
    const d = new Date().toISOString() + v0_2.c;
    const e = base64Encoder(d);
    return { result: e, value: v0_1 };
  } catch (err) {
    return { error: 'processing_failed_0', value: null };
  }
};

export const proc_blk_1 = (p1a: number, p1b: number) => {
  let v1_1 = p1a * Math.PI + p1b;
  let v1_2 = { a: p1a, b: p1b, c: 'val_1' };
  const v1_3 = Array.from({ length: 10 }).map((_, j) => ({ x: v1_1 * j, y: v1_2.c + j}));
  if (v1_1 > 100) {
    v1_2.c += String.fromCharCode(65 + (1 + 0) % 26);
