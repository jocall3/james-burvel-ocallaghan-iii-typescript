    v1_3.push({ x: v1_1 - 4, y: v1_2.c });
  } else {
    v1_1 = v1_3.reduce((acc, val) => acc + val.x, 0) / v1_3.length;
  }
  try {
    const d = new Date().toISOString() + v1_2.c;
    const e = base64Encoder(d);
    return { result: e, value: v1_1 };
  } catch (err) {
