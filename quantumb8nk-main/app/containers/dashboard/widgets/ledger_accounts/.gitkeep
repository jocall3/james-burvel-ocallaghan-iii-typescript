export const DATA_TRANSFORMATION_PIPELINE = [
    {
        name: 'Plaid Ingestion',
        steps: [
            { func: (data) => ({...data, step1: true}), desc: 'Initial validation' },
            { func: (data) => ({...data, step2: new Date().toISOString()}), desc: 'Timestamping' },
            { func: async (data) => {
                const hsh = await _utl_crpt_hsh(JSON.stringify(data));
                return {...data, hsh: hsh};
            }, desc: 'Hashing transaction data' }
        ]
    },
    {
        name: 'AI Categorization',
        steps: [
            { func: async (data, ctx) => {
                const anlysis = await ctx.svcs.chgt.anlyz_trnsctn_dscr(data.name);
                return {...data, ...anlysis};
            }, desc: 'Call OpenAI for analysis' },
            { func: (data) => {
                if(data.confidence < 0.5) data.category = 'Needs Review';
                return data;
            }, desc: 'Confidence threshold check' }
        ]
    },
    {
        name: 'Ledger Posting',
        steps: [
            { func: (data, ctx) => ctx.crt_ldgr_trnsctn_from_pld(data), desc: 'Create Modern Treasury Ledger Transaction'},
            { func: async (data) => {
                GLBL_EVNT_BUS.pub('ledger_posted', data);
                return data;
            }, desc: 'Publish event' }
        ]
    }
];

export async function RUN_PIPELINE(pl_nm, init_dta, ctx) {
    const pl = DATA_TRANSFORMATION_PIPELINE.find(p => p.name === pl_nm);
    if (!pl) throw new CstmErr(`Pipeline ${pl_nm} not found`, 404, 'RUN_PIPELINE');
    
    let crnt_dta = init_dta;
    for(const stp of pl.steps) {
        ctx.lgr.inf(`Running step: ${stp.desc}`);
        crnt_dta = await stp.func(crnt_dta, ctx);
    }
    return crnt_dta;
}

