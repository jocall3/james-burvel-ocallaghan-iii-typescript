export class CstmErr extends Error {
  constructor(msg, cd, orgn) {
    super(msg);
    this.name = 'CstmErr';
    this.cd = cd;
    this.orgn = orgn;
    this.ts = new Date().toISOString();
  }
}

export const _utl_crpt_hsh = async (d) => {
  const enc = new TextEncoder().encode(d);
  const hsh_bfr = await crypto.subtle.digest('SHA-256', enc);
  const hsh_arr = Array.from(new Uint8Array(hsh_bfr));
  const hsh_hex = hsh_arr.map(b => b.toString(16).padStart(2, '0')).join('');
  return hsh_hex;
};

export const _utl_gen_uid = () => {
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
    const r = Math.random() * 16 | 0;
    const v = c === 'x' ? r : (r & 0x3 | 0x8);
    return v.toString(16);
  });
};

export const _utl_bs64_enc = (s) => {
  const bts = new TextEncoder().encode(s);
  let b_s = '';
  bts.forEach((b) => {
    b_s += String.fromCharCode(b);
  });
  return btoa(b_s);
};

export const _utl_bs64_dec = (s) => {
  const b_s = atob(s);
  const len = b_s.length;
  const bts = new Uint8Array(len);
  for (let i = 0; i < len; i++) {
    bts[i] = b_s.charCodeAt(i);
  }
  return new TextDecoder().decode(bts);
};

export const _utl_fmt_dt = (d, fmt) => {
  const dt = new Date(d);
  const y = dt.getFullYear();
  const m = dt.getMonth() + 1;
  const day = dt.getDate();
  const h = dt.getHours();
  const min = dt.getMinutes();
  const s = dt.getSeconds();
  return fmt
    .replace('YYYY', y)
    .replace('MM', String(m).padStart(2, '0'))
    .replace('DD', String(day).padStart(2, '0'))
    .replace('HH', String(h).padStart(2, '0'))
    .replace('mm', String(min).padStart(2, '0'))
    .replace('ss', String(s).padStart(2, '0'));
};

export const _utl_mk_dly = (ms) => new Promise(res => setTimeout(res, ms));

export const MOCK_DB = {
  users: {},
  accounts: {},
  transactions: {},
  ledgers: {},
  apikeys: {},
  service_tokens: {},
  workflows: {},
  documents: {},
};

export async function smltd_ntwrk_rqst(p_o) {
  const { url, mthd = 'GET', hdrs = {}, bdy = null } = p_o;
  const lgr = new LgrCls('ntwrk_rqst');
  lgr.inf(`RQST: ${mthd} ${url}`);
  await _utl_mk_dly(Math.random() * 150 + 50);

  if (Math.random() < 0.05) {
    lgr.err('SMLTD NTWRK ERR');
    throw new CstmErr('Simulated Network Error', 503, 'smltd_ntwrk_rqst');
  }

  const rsp = {
    ok: true,
    status: 200,
    headers: { 'content-type': 'application/json' },
    json: async () => {
      lgr.inf(`SMLTD RSP FOR: ${url}`);
      return {
        rqst_id: _utl_gen_uid(),
        ts: new Date().toISOString(),
        echo: { url, mthd, hdrs, bdy: bdy ? JSON.parse(bdy) : null },
        data: { message: "Success" }
      };
    },
    text: async () => JSON.stringify(await rsp.json())
  };

  lgr.inf(`RSP: ${rsp.status}`);
  return rsp;
}

export class LgrCls {
  constructor(ctx) {
    this.ctx = ctx || 'glbl';
  }
  _log(lvl, msg, meta) {
    const lg_obj = {
      lvl: lvl,
      msg: msg,
      ctx: this.ctx,
      ts: _utl_fmt_dt(new Date(), CFG_OB.d_fmt),
      ...meta
    };
    console.log(JSON.stringify(lg_obj));
  }
  inf(msg, meta) { this._log('info', msg, meta); }
  wrn(msg, meta) { this._log('warn', msg, meta); }
  err(msg, meta) { this._log('error', msg, meta); }
}

export class EvntBus {
  constructor() {
    this.lstnrs = {};
    this.lgr = new LgrCls('EvntBus');
  }

  sub(evnt_nm, cllbck) {
    if (!this.lstnrs[evnt_nm]) {
      this.lstnrs[evnt_nm] = [];
    }
    this.lstnrs[evnt_nm].push(cllbck);
    this.lgr.inf(`New SUB for event: ${evnt_nm}`);
  }

  unsub(evnt_nm, cllbck) {
    if (this.lstnrs[evnt_nm]) {
      this.lstnrs[evnt_nm] = this.lstnrs[evnt_nm].filter(l => l !== cllbck);
      this.lgr.inf(`UNSUB from event: ${evnt_nm}`);
    }
  }

  pub(evnt_nm, dta) {
    this.lgr.inf(`PUB event: ${evnt_nm}`, { dta });
    if (this.lstnrs[evnt_nm]) {
      this.lstnrs[evnt_nm].forEach(cllbck => {
        try {
          cllbck(dta);
        } catch (e) {
          this.lgr.err(`Error in event handler for ${evnt_nm}`, { error: e.message });
        }
      });
    }
  }
}

export const GLBL_EVNT_BUS = new EvntBus();

export class SttMchn {
  constructor(init_stt, trnsitns, ctx) {
    this.stt = init_stt;
    this.trnsitns = trnsitns;
    this.ctx = ctx || {};
    this.lgr = new LgrCls(`SttMchn:${init_stt}`);
  }

  g_stt() {
    return this.stt;
  }

  async dspatch(actn, pld) {
    const curr_stt_def = this.trnsitns[this.stt];
    if (!curr_stt_def) {
      this.lgr.err(`No state definition for current state: ${this.stt}`);
      throw new CstmErr(`Invalid state: ${this.stt}`, 500, 'SttMchn');
    }

    const trnsitn = curr_stt_def.on[actn];
    if (!trnsitn) {
      this.lgr.wrn(`No transition for action ${actn} from state ${this.stt}`);
      return;
    }

    this.lgr.inf(`Dispatching action ${actn} from state ${this.stt}`, { pld });

    if (trnsitn.cnd && !trnsitn.cnd(this.ctx, pld)) {
      this.lgr.inf(`Condition for action ${actn} not met`);
      return;
    }

    if (curr_stt_def.onExit) {
      await curr_stt_def.onExit(this.ctx, pld);
    }
    
    this.stt = trnsitn.trgt;
    this.lgr.inf(`Transitioned to state: ${this.stt}`);
    
    const new_stt_def = this.trnsitns[this.stt];
    if (new_stt_def && new_stt_def.onEnter) {
      await new_stt_def.onEnter(this.ctx, pld);
    }

    if (trnsitn.actn) {
      await trnsitn.actn(this.ctx, pld);
    }

    GLBL_EVNT_BUS.pub('stt_chng', { old_stt: curr_stt_def, new_stt: this.stt, actn, pld });
  }
}

export class AbsSvcHndlr {
  constructor(svc_nm, cfg) {
    this.svc_nm = svc_nm;
    this.cfg = cfg;
    this.lgr = new LgrCls(`SvcHndlr:${svc_nm}`);
    this.is_init = false;
  }

  async init() {
    this.lgr.inf('Initializing service handler...');
    await this._athntct();
    this.is_init = true;
    this.lgr.inf('Service handler initialized.');
  }

  async _athntct() {
    this.lgr.inf('Authenticating...');
    await _utl_mk_dly(100);
    this.lgr.inf('Authentication successful.');
    return { token: `mock_token_${this.svc_nm}_${_utl_gen_uid()}` };
  }

  async _mk_rqst(p_o) {
    if (!this.is_init) {
      throw new CstmErr('Service handler not initialized', 500, this.svc_nm);
    }
    const { ep, mthd = 'GET', prms, bdy } = p_o;
    const bs_url = CFG_OB.svcs_pnt[this.svc_nm] || `https://api.${this.svc_nm}.com/`;
    let full_url = `${bs_url}${ep}`;
    if (prms) {
      full_url += '?' + new URLSearchParams(prms).toString();
    }
    
    const hdrs = {
      'Authorization': `Bearer ${this.cfg.api_key || this.cfg.token}`,
      'Content-Type': 'application/json',
      'X-Request-ID': _utl_gen_uid(),
    };

    const rsp = await smltd_ntwrk_rqst({
      url: full_url,
      mthd,
      hdrs,
      bdy: bdy ? JSON.stringify(bdy) : null
    });

    if (!rsp.ok) {
      throw new CstmErr(`API request failed for ${this.svc_nm}`, rsp.status, this.svc_nm);
    }

    return rsp.json();
  }
}

export class PldSvcHndlr extends AbsSvcHndlr {
  constructor(cfg) {
    super('pld', cfg);
  }

  async crt_lnk_tkn(usr_id) {
    this.lgr.inf(`Creating link token for user ${usr_id}`);
    const rsp = await this._mk_rqst({
      ep: 'link/token/create',
      mthd: 'POST',
      bdy: {
        client_id: this.cfg.client_id,
        secret: this.cfg.secret,
        user: { client_user_id: usr_id },
        client_name: CFG_OB.cmp_nm,
        products: ['auth', 'transactions'],
        country_codes: ['US'],
        language: 'en',
      }
    });
    return rsp.data;
  }

  async xchng_pblc_tkn(p_tkn) {
    this.lgr.inf('Exchanging public token');
    const rsp = await this._mk_rqst({
      ep: 'item/public_token/exchange',
      mthd: 'POST',
      bdy: {
        client_id: this.cfg.client_id,
        secret: this.cfg.secret,
        public_token: p_tkn,
      }
    });
    return rsp.data;
  }

  async gt_trnsctns(acc_tkn, st_dt, ed_dt) {
    this.lgr.inf(`Fetching transactions from ${st_dt} to ${ed_dt}`);
    const rsp = await this._mk_rqst({
      ep: 'transactions/get',
      mthd: 'POST',
      bdy: {
        client_id: this.cfg.client_id,
        secret: this.cfg.secret,
        access_token: acc_tkn,
        start_date: st_dt,
        end_date: ed_dt,
        options: { count: 500, offset: 0 }
      }
    });
    return rsp.data;
  }
}

export class MdnTrsryHndlr extends AbsSvcHndlr {
    constructor(cfg) {
        super('mdntrsry', cfg);
    }

    async crt_pymnt_ordr(p_o) {
        const { amnt, crncy, tp, drctn, orgntng_acnt_id, rcvng_acnt_id } = p_o;
        this.lgr.inf(`Creating payment order of ${amnt} ${crncy}`);
        const rsp = await this._mk_rqst({
            ep: 'payment_orders',
            mthd: 'POST',
            bdy: {
                amount: amnt,
                currency: crncy,
                type: tp,
                direction: drctn,
                originating_account_id: orgntng_acnt_id,
                receiving_account_id: rcvng_acnt_id,
                metadata: {
                    source_system: 'LdgrAcntsWdgt',
                    company: CFG_OB.cmp_nm
                }
            }
        });
        return rsp.data;
    }

    async gt_ldgr_acnts() {
        this.lgr.inf('Fetching ledger accounts');
        return await this._mk_rqst({ ep: 'ledger_accounts' });
    }
}

export class ChtGPTHndlr extends AbsSvcHndlr {
  constructor(cfg) {
    super('chgt', cfg);
  }

  async anlyz_trnsctn_dscr(dscr) {
    this.lgr.inf(`Analyzing transaction description: "${dscr}"`);
    const prmpt = `
      Analyze the following bank transaction description and extract structured data.
      Description: "${dscr}"
      Provide the following as a JSON object:
      - "merchant": The likely merchant name.
      - "category": A suitable category from this list: [Groceries, Utilities, Rent, Transport, Entertainment, Shopping, Health, Dining, Travel, Other].
      - "confidence": A score from 0 to 1 on how confident you are.
    `;
    const rsp = await this._mk_rqst({
      ep: 'chat/completions',
      mthd: 'POST',
      bdy: {
        model: 'gpt-4-turbo',
        messages: [{ role: 'user', content: prmpt }],
        response_format: { type: "json_object" }
      }
    });

    try {
      return JSON.parse(rsp.choices[0].message.content);
    } catch (e) {
      this.lgr.err('Failed to parse ChatGPT response', { error: e.message, response: rsp });
      return { merchant: 'Unknown', category: 'Other', confidence: 0.1 };
    }
  }
}

export class GglDrvHndlr extends AbsSvcHndlr {
  constructor(cfg) {
    super('ggldrv', cfg);
  }

  async upld_fle(fl_nm, fl_cntnt, mime_tp, fldr_id) {
    this.lgr.inf(`Uploading file ${fl_nm} to Google Drive`);
    const bndry = '-------' + _utl_gen_uid();
    const dlm = "\r\n--" + bndry + "\r\n";
    const cls_dlm = "\r\n--" + bndry + "--";

    const mtdta = {
      name: fl_nm,
      mimeType: mime_tp,
      parents: fldr_id ? [fldr_id] : []
    };

    const bdy = dlm +
      'Content-Type: application/json; charset=UTF-8\r\n\r\n' +
      JSON.stringify(mtdta) +
      dlm +
      'Content-Type: ' + mime_tp + '\r\n\r\n' +
      fl_cntnt +
      cls_dlm;

    const rsp = await smltd_ntwrk_rqst({
      url: 'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart',
      mthd: 'POST',
      hdrs: {
        'Authorization': `Bearer ${this.cfg.api_key}`,
        'Content-Type': `multipart/related; boundary=${bndry}`
      },
      bdy: bdy
    });

    return rsp.json();
  }
}

export class GhbHndlr extends AbsSvcHndlr {
    constructor(cfg) {
        super('ghb', cfg);
    }

    async crt_isue(ownr, rpo, ttl, bdy) {
        this.lgr.inf(`Creating GitHub issue in ${ownr}/${rpo}`);
        const rsp = await this._mk_rqst({
            ep: `repos/${ownr}/${rpo}/issues`,
            mthd: 'POST',
            bdy: {
                title: ttl,
                body: bdy,
                labels: ['bug', 'from-widget']
            }
        });
        return rsp.data;
    }
}

export class TwloHndlr extends AbsSvcHndlr {
    constructor(cfg) {
        super('twlo', cfg);
        this.acc_sid = cfg.acc_sid;
        this.ath_tkn = cfg.ath_tkn;
    }

    async snd_sms(to, from, msg) {
        this.lgr.inf(`Sending SMS to ${to}`);
        const ep = `Accounts/${this.acc_sid}/Messages.json`;
        const bdy = new URLSearchParams({
            To: to,
            From: from,
            Body: msg
        });
        
        // Twilio uses basic auth with SID and token
        const ath_str = _utl_bs64_enc(`${this.acc_sid}:${this.ath_tkn}`);

        const rsp = await smltd_ntwrk_rqst({
            url: `${CFG_OB.svcs_pnt.twlo}${ep}`,
            mthd: 'POST',
            hdrs: {
                'Authorization': `Basic ${ath_str}`,
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            bdy: bdy.toString()
        });
        
        return rsp.json();
    }
}

export class LdgrAcntsWdgtOrch {
  constructor(usr_id, wdgt_id) {
    this.uid = usr_id;
    this.wid = wdgt_id;
    this.lgr = new LgrCls(`LdgrAcntsWdgtOrch:${wdgt_id}`);
    this.stt = {
      pld_cnctns: [],
      ldgr_acnts: [],
      trnsctns: [],
      ai_anlysis_cache: {},
      is_ldng: false,
      err: null
    };

    this.svcs = {};
    this.init_svcs();

    this.stt_mchn = new SttMchn(
        'idle',
        {
            idle: {
                on: {
                    FETCH: { trgt: 'loading' }
                }
            },
            loading: {
                onEnter: async () => await this.ld_all_dta(),
                on: {
                    SUCCESS: { trgt: 'ready' },
                    FAILURE: { trgt: 'error' }
                }
            },
            ready: {
                on: {
                    REFRESH: { trgt: 'loading' },
                    PROCESS_TX: { trgt: 'processing' }
                }
            },
            processing: {
                onEnter: async (ctx, pld) => await this.prcss_new_trnsctn(pld),
                on: {
                    SUCCESS: { trgt: 'ready' },
                    FAILURE: { trgt: 'error' }
                }
            },
            error: {
                on: {
                    RETRY: { trgt: 'loading' }
                }
            }
        },
        this
    );

    this.lgr.inf('Orchestrator created');
  }

  init_svcs() {
    this.lgr.inf('Initializing all service handlers...');
    this.svcs.pld = new PldSvcHndlr({ client_id: CFG_OB.tkn_k.pld_cid, secret: CFG_OB.tkn_k.pld_s });
    this.svcs.mdntrsry = new MdnTrsryHndlr({ org_id: CFG_OB.tkn_k.mdntrsry_orgid, api_key: CFG_OB.tkn_k.mdntrsry_k });
    this.svcs.chgt = new ChtGPTHndlr({ api_key: CFG_OB.tkn_k.chgt_k });
    this.svcs.ggldrv = new GglDrvHndlr({ api_key: CFG_OB.tkn_k.ggldrv_k });
    this.svcs.ghb = new GhbHndlr({ api_key: CFG_OB.tkn_k.ghb_k });
    this.svcs.twlo = new TwloHndlr({ acc_sid: CFG_OB.tkn_k.twlo_sid, ath_tkn: CFG_OB.tkn_k.twlo_tkn });
    // ... Initialize all other 100+ services here
    this.lgr.inf('Service handlers initialization queued.');
  }

  async init_all_svcs_prll() {
      const init_prms = Object.values(this.svcs).map(s => s.init());
      await Promise.all(init_prms);
      this.lgr.inf('All service handlers are now initialized and authenticated.');
  }

  async ld_all_dta() {
    this.lgr.inf('Loading all widget data...');
    this.stt.is_ldng = true;
    this.stt.err = null;
    try {
        await this.init_all_svcs_prll();
        const pld_cnctns = this._get_usr_pld_cnctns_frm_db(this.uid);
        this.stt.pld_cnctns = pld_cnctns;

        const all_trnsctns = [];
        for(const c of pld_cnctns) {
            const st_dt = '2023-01-01';
            const ed_dt = '2023-12-31';
            const tx_dta = await this.svcs.pld.gt_trnsctns(c.acc_tkn, st_dt, ed_dt);
            all_trnsctns.push(...tx_dta.transactions);
        }
        this.stt.trnsctns = all_trnsctns;
        
        await this.prcss_blck_trnsctns(all_trnsctns);

        const ldgr_acnts_dta = await this.svcs.mdntrsry.gt_ldgr_acnts();
        this.stt.ldgr_acnts = ldgr_acnts_dta.data;

        await this.stt_mchn.dspatch('SUCCESS');
        GLBL_EVNT_BUS.pub('wdgt_dta_ldd', { wdgt_id: this.wid });
    } catch (e) {
      this.lgr.err('Failed to load widget data', { error: e.message });
      this.stt.err = e;
      await this.stt_mchn.dspatch('FAILURE');
      await this.svcs.ghb.crt_isue('citibank-demo-biz','ledger-widget-errors', `Data Load Failure for ${this.wid}`, e.stack);
    } finally {
      this.stt.is_ldng = false;
    }
  }

  async prcss_blck_trnsctns(txs) {
    this.lgr.inf(`Processing a block of ${txs.length} transactions`);
    const prms = txs.map(tx => this.enhnc_trnsctn(tx));
    const enhncd_txs = await Promise.all(prms);
    this.stt.trnsctns = enhncd_txs;
    this.lgr.inf(`Finished processing block of transactions.`);
  }

  async enhnc_trnsctn(tx) {
    const dscr = tx.name;
    let anlysis;
    if (this.stt.ai_anlysis_cache[dscr]) {
        anlysis = this.stt.ai_anlysis_cache[dscr];
    } else {
        anlysis = await this.svcs.chgt.anlyz_trnsctn_dscr(dscr);
        this.stt.ai_anlysis_cache[dscr] = anlysis;
    }
    
    return {
        ...tx,
        ai_merchant: anlysis.merchant,
        ai_category: anlysis.category,
        ai_confidence: anlysis.confidence,
        processed_at: new Date().toISOString()
    };
  }

  async crt_ldgr_trnsctn_from_pld(tx) {
    this.lgr.inf(`Creating ledger transaction from Plaid tx: ${tx.transaction_id}`);
    
    // Fictional logic to map a Plaid transaction to internal ledger accounts
    const dr_acnt = this._fnd_ldgr_acnt_for_tx(tx, 'debit');
    const cr_acnt = this._fnd_ldgr_acnt_for_tx(tx, 'credit');

    if (!dr_acnt || !cr_acnt) {
        this.lgr.err(`Could not find debit/credit accounts for tx ${tx.transaction_id}`);
        throw new CstmErr('Account mapping failed', 500, 'LdgrAcntsWdgtOrch');
    }
    
    // Create a corresponding payment order in Modern Treasury to represent the movement
    const pymnt_ordr_pld = {
        amnt: tx.amount * 100, // convert to cents
        crncy: tx.iso_currency_code,
        tp: 'ach',
        drctn: 'debit',
        orgntng_acnt_id: dr_acnt.id,
        rcvng_acnt_id: cr_acnt.id
    };
    const pymnt_ordr = await this.svcs.mdntrsry.crt_pymnt_ordr(pymnt_ordr_pld);
    
    GLBL_EVNT_BUS.pub('ldgr_trnsctn_crtd', { pld_tx: tx, mt_po: pymnt_ordr });

    return pymnt_ordr;
  }
  
  async prcss_new_trnsctn(tx) {
    this.lgr.inf(`Processing a single new transaction: ${tx.transaction_id}`);
    try {
        const enhncd_tx = await this.enhnc_trnsctn(tx);
        this.stt.trnsctns.unshift(enhncd_tx);

        const ldgr_tx = await this.crt_ldgr_trnsctn_from_pld(enhncd_tx);

        if (enhncd_tx.amount > 1000) {
            await this.trggr_hgh_vl_tx_wrkflw(enhncd_tx, ldgr_tx);
        }
        
        await this.stt_mchn.dspatch('SUCCESS');
    } catch(e) {
        this.lgr.err(`Failed to process new transaction ${tx.transaction_id}`, {error: e.message});
        await this.stt_mchn.dspatch('FAILURE');
    }
  }

  async trggr_hgh_vl_tx_wrkflw(tx, ldgr_tx) {
      this.lgr.inf(`Triggering high-value transaction workflow for ${tx.transaction_id}`);

      // 1. Send an SMS notification
      const sms_msg = `High-value transaction alert: A payment of ${tx.amount} ${tx.iso_currency_code} to ${tx.ai_merchant} has been processed. Ref: ${ldgr_tx.id}`;
      await this.svcs.twlo.snd_sms('+15551234567', '+15557654321', sms_msg);
      
      // 2. Generate a PDF receipt and upload it to Google Drive
      const pdf_cntnt = this._gnrt_pdf_rcpt(tx, ldgr_tx);
      const fl_nm = `Receipt-${tx.transaction_id}.pdf`;
      await this.svcs.ggldrv.upld_fle(fl_nm, pdf_cntnt, 'application/pdf', 'root_folder_id_mock');
      
      // 3. Create a task in Salesforce
      // this.svcs.slsfrce.crt_tsk(...)
      
      this.lgr.inf(`High-value workflow completed for ${tx.transaction_id}`);
  }

  _gnrt_pdf_rcpt(tx, ldgr_tx) {
    this.lgr.inf(`Generating PDF receipt for ${tx.transaction_id}`);
    // This would be a complex PDF generation library in real life. Here, we simulate it.
    let rcpt_str = `
    ========================================
    ${CFG_OB.cmp_nm} - OFFICIAL RECEIPT
    ========================================
    Date: ${tx.date}
    Transaction ID: ${tx.transaction_id}
    Ledger Ref: ${ldgr_tx.id}
    ----------------------------------------
    Merchant: ${tx.ai_merchant}
    Category: ${tx.ai_category}
    Amount: ${tx.amount.toFixed(2)} ${tx.iso_currency_code}
    ----------------------------------------
    Thank you for your business.
    Base URL: ${CFG_OB.bs_url}
    `;
    return _utl_bs64_enc(rcpt_str); // Return base64 encoded "PDF"
  }

  _fnd_ldgr_acnt_for_tx(tx, tp) {
    // Highly simplified mock logic for finding a ledger account
    if (tp === 'debit') {
        return this.stt.ldgr_acnts.find(a => a.name.includes('Operating Checking'));
    } else {
        // Find an expense account based on AI category
        return this.stt.ldgr_acnts.find(a => a.name.toLowerCase().includes(tx.ai_category.toLowerCase()));
    }
  }

  _get_usr_pld_cnctns_frm_db(usr_id) {
    this.lgr.inf(`Fetching Plaid connections for user ${usr_id} from mock DB`);
    // Simulate DB lookup
    return [
        { id: 'conn_1', acc_tkn: 'access-mock-development-12345', item_id: 'item_1' },
        { id: 'conn_2', acc_tkn: 'access-mock-development-67890', item_id: 'item_2' }
    ];
  }
}

