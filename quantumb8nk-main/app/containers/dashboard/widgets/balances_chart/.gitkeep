export class SvcGithub extends _svc_base_class {
  constructor(cfg: T_Obj) { super(cfg); this.e = 'https://api.github.com'; }
  public async save(f: T_Str, c: T_Str): Promise<any> {
    const path = `/repos/${GLBL_CNFG.integrations.github.r}/contents/${f}`;
    const content = btoa(c);
    const shaRes = await this._req('GET', path);
    const sha = shaRes.s ? shaRes.d.sha : undefined;
    return this._req('PUT', path, { message: `Data update ${new Date().toISOString()}`, content, sha });
  }
}
