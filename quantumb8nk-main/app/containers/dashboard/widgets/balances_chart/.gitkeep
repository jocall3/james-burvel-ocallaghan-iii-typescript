const wdgtReducer = (state: I_WdgtSt, action: { type: T_Str; pld?: any }): I_WdgtSt => {
  switch (action.type) {
    case 'FETCH_INIT':
      return { ...state, stat: 'proc', err: null };
    case 'FETCH_OK':
      return { ...state, stat: 'ok', dta: action.pld, lastUpd: new Date() };
    case 'FETCH_ERR':
      return { ...state, stat: 'err', err: action.pld, dta: [] };
    case 'SET_CFG':
      return { ...state, cfg: { ...state.cfg, ...action.pld } };
    case 'SET_INTG':
      return { ...state, actIntg: action.pld };
    default:
      return state;
  }
};

export const useDataFet = (disp: React.Dispatch<any>, tmRng: T_TmRng) => {
  React.useEffect(() => {
    const fetchData = async () => {
      disp({ type: 'FETCH_INIT' });
      try {
        const resp = await fetch(`${B_URL}/balances?range=${tmRng}`);
        if (!resp.ok) throw new Error('Network response was not ok');
        const d = await resp.json();
        disp({ type: 'FETCH_OK', pld: d.data });
      } catch (e: any) {
        disp({ type: 'FETCH_ERR', pld: e.message });
      }
    };
    fetchData();
    const intId = setInterval(fetchData, DFLT_RFRSH);
    return () => clearInterval(intId);
  }, [tmRng, disp]);
};

export const useSvcInit = () => {
    return React.useMemo(() => {
        const insts: T_Obj = {};
        for (const [key, SvcClass] of Object.entries(SVC_MAP)) {
            const cfg = (GLBL_CNFG.integrations as T_Obj)[key];
            if (cfg) {
                insts[key] = new SvcClass(cfg);
            }
        }
        return insts;
    }, []);
};


export const AcctBalChrtWdgt = ({ p }: { p: { w: T_Num; h: T_Num } }) => {
  const [st, disp] = React.useReducer(wdgtReducer, {
    stat: 'idle',
    dta: [],
    cfg: { typ: GLBL_CNFG.defaultChartType, tmRng: '1M' },
    err: null,
    lastUpd: null,
    actIntg: null,
  });

  const svcs = useSvcInit();
  useDataFet(disp, st.cfg.tmRng);

  const [hoverPt, setHoverPt] = React.useState<I_Pt | null>(null);

  const handleChngTmRng = (rng: T_TmRng) => disp({ type: 'SET_CFG', pld: { tmRng: rng } });
  const handleChngChrtTyp = (typ: T_ChrtTyp) => disp({ type: 'SET_CFG', pld: { typ } });
  
  const renderLoading = () => <div style={{ color: GLBL_CNFG.theme.text }}>Loading financial data...</div>;
  const renderError = () => <div style={{ color: GLBL_CNFG.theme.error }}>Error: {st.err}</div>;

  const renderSVGChart = () => {
    const { w, h } = p;
    const m = { t: 20, r: 30, b: 40, l: 50 };
    const iw = w - m.l - m.r;
    const ih = h - m.b - m.t;
    
    if (!st.dta || st.dta.length === 0 || st.dta.every(s => s.d.length === 0)) {
        return <div style={{height: ih, display: 'flex', alignItems: 'center', justifyContent: 'center'}}>No data available</div>
    }

    const allPts = st.dta.flatMap(s => s.d);
    const xMin = Math.min(...allPts.map(pt => pt.x));
    const xMax = Math.max(...allPts.map(pt => pt.x));
    const yMin = Math.min(0, ...allPts.map(pt => pt.y));
    const yMax = Math.max(...allPts.map(pt => pt.y));

    const xScl = (v: T_Num) => (v - xMin) / (xMax - xMin) * iw;
    const yScl = (v: T_Num) => ih - (v - yMin) / (yMax - yMin) * ih;

    const genPath = (pts: I_Pt[]) => {
      if (pts.length < 2) return '';
      let p = `M ${xScl(pts[0].x)} ${yScl(pts[0].y)}`;
      for (let i = 1; i < pts.length; i++) {
        p += ` L ${xScl(pts[i].x)} ${yScl(pts[i].y)}`;
      }
      return p;
    };
    
    const renderXAxis = () => {
        const ticks = 5;
        const tickVals = Array.from({ length: ticks }, (_, i) => xMin + i * ((xMax-xMin) / (ticks - 1)));
        return (
            <g transform={`translate(0, ${ih})`}>
                {tickVals.map(v => (
                    <g key={`x-tick-${v}`} transform={`translate(${xScl(v)}, 0)`}>
                        <line y2="5" stroke={GLBL_CNFG.theme.grid} />
                        <text y="20" textAnchor="middle" fill={GLBL_CNFG.theme.text} fontSize="10">
                            {fnDtFmt(new Date(v * 1000), 'MM/DD')}
                        </text>
                    </g>
                ))}
            </g>
        )
    };
    
    const renderYAxis = () => {
        const ticks = 5;
        const tickVals = Array.from({ length: ticks }, (_, i) => yMin + i * ((yMax-yMin) / (ticks - 1)));
        return (
            <g>
                {tickVals.map(v => (
                    <g key={`y-tick-${v}`} transform={`translate(0, ${yScl(v)})`}>
                        <line x2={iw} stroke={GLBL_CNFG.theme.grid} strokeDasharray="2,2"/>
                        <text x="-10" dy="0.32em" textAnchor="end" fill={GLBL_CNFG.theme.text} fontSize="10">
                            ${(v/1000).toFixed(1)}k
                        </text>
                    </g>
                ))}
            </g>
        )
    };
    
    const handleMouseOv = (e: React.MouseEvent<SVGRectElement>) => {
        const rect = e.currentTarget.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseXVal = (mouseX / iw) * (xMax - xMin) + xMin;
        let closestPt: I_Pt | null = null;
        let minDist = Infinity;
        st.dta[0].d.forEach(pt => {
            const dist = Math.abs(pt.x - mouseXVal);
            if (dist < minDist) {
                minDist = dist;
                closestPt = pt;
            }
        });
        setHoverPt(closestPt);
    };

    return (
      <svg width={w} height={h} onMouseMove={handleMouseOv} onMouseLeave={() => setHoverPt(null)}>
        <g transform={`translate(${m.l}, ${m.t})`}>
          {renderXAxis()}
          {renderYAxis()}
          {st.dta.map(srs => (
            <path
              key={srs.id}
              d={genPath(srs.d)}
              fill="none"
              stroke={srs.clr}
              strokeWidth="2"
            />
          ))}
          {hoverPt && (
            <g>
              <line x1={xScl(hoverPt.x)} y1="0" x2={xScl(hoverPt.x)} y2={ih} stroke={GLBL_CNFG.theme.secondary} strokeDasharray="4,4" />
              <circle cx={xScl(hoverPt.x)} cy={yScl(hoverPt.y)} r="5" fill={GLBL_CNFG.theme.secondary} />
              <g transform={`translate(${xScl(hoverPt.x) + 10}, ${yScl(hoverPt.y) - 10})`}>
                  <rect x="0" y="-20" width="100" height="40" fill="rgba(255,255,255,0.8)" />
                  <text x="5" y="-5" fill={GLBL_CNFG.theme.text}>
                      {fnDtFmt(new Date(hoverPt.x * 1000), 'MM/DD/YYYY')}
                  </text>
                  <text x="5" y="10" fill={GLBL_CNFG.theme.text} fontWeight="bold">
                      ${hoverPt.y.toLocaleString()}
                  </text>
              </g>
            </g>
          )}
        </g>
      </svg>
    );
  };
  
  const renderControls = () => {
      const tmRngs: T_TmRng[] = ['1D', '5D', '1M', '3M', '6M', '1Y', 'YTD', 'MAX'];
      const chrtTyps: T_ChrtTyp[] = ['ln', 'bar', 'area'];
      return (
          <div style={{display: 'flex', justifyContent: 'space-between', padding: '10px'}}>
              <div>
                  {tmRngs.map(r => (
                      <button key={r} onClick={() => handleChngTmRng(r)} disabled={st.cfg.tmRng === r} style={{margin: '0 5px'}}>{r}</button>
                  ))}
              </div>
              <div>
                 {chrtTyps.map(t => (
                      <button key={t} onClick={() => handleChngChrtTyp(t)} disabled={st.cfg.typ === t} style={{margin: '0 5px'}}>{t.toUpperCase()}</button>
                 ))}
              </div>
          </div>
      )
  };
  
  const renderIntegrationsPanel = () => {
      return (
          <div style={{ maxHeight: '200px', overflowY: 'auto', border: `1px solid ${GLBL_CNFG.theme.grid}`, padding: '10px' }}>
              <h3>Integrations</h3>
              <div style={{ display: 'flex', flexWrap: 'wrap' }}>
                  {Object.keys(svcs).map(key => (
                      <button key={key} onClick={() => disp({type: 'SET_INTG', pld: key})} style={{ margin: '4px' }}>
                          {key}
                      </button>
                  ))}
              </div>
              {st.actIntg && (
                <div style={{marginTop: '10px', padding: '10px', backgroundColor: '#eee'}}>
                    Active: {st.actIntg} (Status: {svcs[st.actIntg].getStat()})
                </div>
              )}
          </div>
      )
  };

  return (
    <div style={{ width: p.w, height: p.h, backgroundColor: GLBL_CNFG.theme.background, fontFamily: 'sans-serif' }}>
      <div style={{display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '10px'}}>
          <h2 style={{color: GLBL_CNFG.theme.primary}}>Account Balances</h2>
          <div style={{fontSize: '12px', color: GLBL_CNFG.theme.text}}>
              {st.lastUpd ? `Last updated: ${fnDtFmt(st.lastUpd, 'hh:mm:ss')}` : ''}
          </div>
      </div>
      {renderControls()}
      <div style={{ position: 'relative' }}>
          {st.stat === 'proc' && renderLoading()}
          {st.stat === 'err' && renderError()}
          {st.stat === 'ok' && renderSVGChart()}
      </div>
      {renderIntegrationsPanel()}
    </div>
  );
};