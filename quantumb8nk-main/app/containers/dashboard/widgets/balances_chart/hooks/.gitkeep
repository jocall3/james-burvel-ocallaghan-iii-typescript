const util = {
  genId: (len = 16) => {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    let res = '';
    for (let i = 0; i < len; i++) {
      res += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return res;
  },
  simLatency: (ms) => new Promise(res => setTimeout(res, ms)),
  simpleHash: (str) => {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
      const char = str.charCodeAt(i);
      hash = ((hash << 5) - hash) + char;
      hash |= 0;
    }
    return Math.abs(hash).toString(16);
  },
  clone: (obj) => {
    if (obj === null || typeof obj !== 'object') return obj;
    const cp = Array.isArray(obj) ? [] : {};
    for (const key in obj) {
      if (Object.prototype.hasOwnProperty.call(obj, key)) {
        cp[key] = util.clone(obj[key]);
      }
    }
    return cp;
  },
  b64Enc: (str) => {
    try {
      return btoa(unescape(encodeURIComponent(str)));
    } catch (e) {
      const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
      str = String(str);
      let bitmap, a, b, c, result = "",
        i = 0,
        rest = str.length % 3;
      for (; i < str.length;) {
        if ((a = str.charCodeAt(i++)) > 255 || (b = str.charCodeAt(i++)) > 255 || (c = str.charCodeAt(i++)) > 255)
          throw new TypeError("Failed to execute 'btoa' on 'Window': The string to be encoded contains characters outside of the Latin1 range.");
        bitmap = (a << 16) | (b << 8) | c;
        result += b.charAt(bitmap >> 18 & 63) + b.charAt(bitmap >> 12 & 63) + b.charAt(bitmap >> 6 & 63) + b.charAt(bitmap & 63);
      }
      return rest ? result.slice(0, rest - 3) + "===".substring(rest) : result;
    }
  },
  b64Dec: (str) => {
    try {
      return decodeURIComponent(escape(atob(str)));
    } catch (e) {
      const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
      str = String(str).replace(/[\t\n\f\r ]+/g, "");
      let bitmap, result = "",
        r1, r2, i = 0;
      for (; i < str.length;) {
        r1 = b.indexOf(str.charAt(i++));
        r2 = b.indexOf(str.charAt(i++));
        bitmap = (r1 << 18) | (r2 << 12) | ((r1 = b.indexOf(str.charAt(i++))) < 64 ? r1 << 6 : 50) | ((r1 = b.indexOf(str.charAt(i++))) < 64 ? r1 : 50);
        result += String.fromCharCode(bitmap >> 16 & 255, bitmap >> 8 & 255, bitmap & 255);
      }
      return result;
    }
  },
  prng: (seed) => {
    let s = seed % 2147483647;
    if (s <= 0) s += 2147483646;
    return {
      next: function() {
        return s = s * 16807 % 2147483647;
      },
      nextFloat: function() {
        return (this.next() - 1) / 2147483646;
      },
    };
  },
};

const apiSvcRegistry = {
  gemini: {
    id: 'ai_gemini',
    auth: async (cfg) => {
      await util.simLatency(150);
      if (!cfg.apiKey) return {
        s: 0,
        e: 'API_KEY_MISSING'
      };
      return {
        s: 1,
        t: `gem_${util.b64Enc(cfg.apiKey)}_${util.genId()}`
      };
    },
    exec: async (t, p) => {
      await util.simLatency(800 + Math.random() * 500);
      const prng = util.prng(util.simpleHash(p.prompt));
      const sentences = ['The financial forecast is positive.', 'Market volatility is expected to increase.', 'Consider portfolio diversification.', 'AI-driven insights suggest a bullish trend.', 'Cryptocurrency assets show high risk.'];
      let res = '';
      for (let i = 0; i < (prng.next() % 3) + 1; i++) {
        res += sentences[prng.next() % sentences.length] + ' ';
      }
      return {
        s: 1,
        d: {
          completion: res.trim(),
          usage: {
            prompt_tokens: p.prompt.length,
            completion_tokens: res.length,
            total_tokens: p.prompt.length + res.length
          }
        }
      };
    }
  },
  chatgpt: {
    id: 'ai_chatgpt',
    auth: async (cfg) => {
