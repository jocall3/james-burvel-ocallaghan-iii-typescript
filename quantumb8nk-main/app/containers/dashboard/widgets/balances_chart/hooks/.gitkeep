const dOrch = {
  _sessions: {},
  _svcs: apiSvcRegistry,

  initSess: async function(svcName, cfg) {
    if (!this._svcs[svcName]) {
      throw new Error(`Service ${svcName} not registered.`);
    }
    const authRes = await this._svcs[svcName].auth(cfg);
    if (authRes.s === 1) {
      const sessId = `${svcName}_${util.genId(8)}`;
      this._sessions[sessId] = {
        token: authRes.t,
        svc: svcName,
        ts: Date.now()
      };
      return sessId;
    } else {
      throw new Error(`Auth failed for ${svcName}: ${authRes.e}`);
    }
  },

  run: async function(sessId, params) {
    const sess = this._sessions[sessId];
    if (!sess) {
      throw new Error('Invalid session ID.');
    }
    const svc = this._svcs[sess.svc];
    const res = await svc.exec(sess.token, params);
    if (res.s === 1) {
      return res.d;
    } else {
      throw new Error(`Execution failed for ${sess.svc}: ${res.e}`);
    }
  },

  procBalData: (dataSources) => {
    let totalBal = 0;
    const breakdown = {};
    const errs = [];
    const series = {};

    for (const src of dataSources) {
      try {
        if (!src.res || src.err) {
          errs.push({
            src: src.id,
            err: src.err || 'No data'
          });
          continue;
        }

        let bal = 0;
        if (src.id === 'plaid') {
          src.res.accounts.forEach(a => {
            const b = a.balance.current;
            totalBal += b;
            bal += b;
          });
        } else if (src.id === 'citibank') {
          src.res.accounts.forEach(a => {
            const b = a.balance;
            totalBal += b;
            bal += b;
          });
        } else if (src.id === 'moderntreasury') {
          const prng = util.prng(util.simpleHash(JSON.stringify(src.res)));
          const b = prng.nextFloat() * 120000;
          totalBal += b;
          bal += b;
        } else if (src.id === 'stripe') {
          const b = src.res.available[0].amount / 100;
          totalBal += b;
          bal += b;
        } else if (src.id === 'brex') {
          const b = src.res.accounts[0].current_balance.amount / 100;
          totalBal += b;
          bal += b;
        } else if (src.id === 'paypal') {
          const b = parseFloat(src.res.balances[0].total);
          totalBal += b;
          bal += b;
        }

        breakdown[src.id] = bal;

        const prng = util.prng(util.simpleHash(src.id + JSON.stringify(src.res)));
        const histData = [];
        let currentVal = bal;
        for (let i = 0; i < 30; i++) {
          histData.unshift({
            x: new Date(Date.now() - i * 24 * 3600 * 1000).toISOString().split('T')[0],
            y: Math.max(0, currentVal)
          });
          currentVal += (prng.nextFloat() - 0.5) * currentVal * 0.1;
        }
        series[src.id] = histData;

      } catch (e) {
        errs.push({
          src: src.id,
          err: e.message
        });
      }
    }

    const totalSeries = [];
    if (Object.keys(series).length > 0) {
      for (let i = 0; i < 30; i++) {
        let dayTotal = 0;
        Object.values(series).forEach(s => {
          dayTotal += s[i] ? s[i].y : 0;
        });
        totalSeries.push({
          x: series[Object.keys(series)[0]][i].x,
          y: dayTotal
        });
      }
    }

    return {
      total: totalBal,
      breakdown,
      series,
      totalSeries,
      errors: errs,
      lastUpdated: new Date().toISOString()
    };
  }
};

export const useAggregatedFinancialsDashboard = (cfg) => {
  const [st, setSt] = React.useState({
    ld: true,
    err: null,
    d: null,
    prog: {
      p: 0,
      m: ''
    }
  });

  const updateProg = (p, m) => {
    setSt(prev => ({ ...prev,
      prog: {
        p,
        m
      }
    }));
  };

  const runAgg = React.useCallback(async () => {
    try {
      setSt({
        ld: true,
        err: null,
        d: null,
        prog: {
          p: 0,
          m: 'Starting aggregation...'
        }
      });
      const dataSources = [];
      const sourcesToFetch = [{
        id: 'plaid',
        cfg: cfg.plaid
      }, {
        id: 'citibank',
        cfg: cfg.citibank
      }, {
        id: 'stripe',
        cfg: cfg.stripe
      }, {
        id: 'brex',
        cfg: cfg.brex
      }, {
        id: 'paypal',
        cfg: cfg.paypal
      }, ];

      const totalSteps = sourcesToFetch.length;
      let completedSteps = 0;

      for (const src of sourcesToFetch) {
        if (!src.cfg) continue;
        updateProg((completedSteps / totalSteps) * 100, `Connecting to ${src.id}...`);
        try {
          const sessId = await dOrch.initSess(src.id, src.cfg);
          let params;
          if (src.id === 'plaid') params = {
            action: 'get_accounts'
          };
          else if (src.id === 'citibank') params = {
            action: 'get_balances'
          };
          else if (src.id === 'stripe') params = {
            action: 'get_balance'
          };
          else if (src.id === 'brex') params = {
            action: 'get_accounts'
          };
          else if (src.id === 'paypal') params = {
            action: 'get_balance'
          };
          const res = await dOrch.run(sessId, params);
          dataSources.push({
            id: src.id,
            res
          });
        } catch (e) {
          dataSources.push({
            id: src.id,
            err: e.message
          });
        }
        completedSteps++;
        updateProg((completedSteps / totalSteps) * 100, `Fetched data from ${src.id}`);
      }

      updateProg(95, 'Processing and analyzing financial data...');
      await util.simLatency(500);
      const processedData = dOrch.procBalData(dataSources);

      updateProg(100, 'Aggregation complete.');
      setSt(prev => ({ ...prev,
        ld: false,
        d: processedData
      }));
    } catch (e) {
      setSt(prev => ({ ...prev,
        ld: false,
        err: e.message
      }));
    }
  }, [JSON.stringify(cfg)]);

  React.useEffect(() => {
    runAgg();
  }, [runAgg]);

  const fns = React.useMemo(() => ({
    refresh: runAgg,
    getAIDrivenInsight: async (prompt) => {
      try {
        const sessId = await dOrch.initSess('gemini', cfg.gemini);
        const insight = await dOrch.run(sessId, {
          prompt: `${prompt}\n\nFinancial Context:\n${JSON.stringify(st.d)}`
        });
        return insight.completion;
      } catch (e) {
        console.error("AI Insight Error:", e);
        return "Could not generate insight due to an error.";
      }
    },
    triggerWorkflow: async (workflowId, payload) => {
      try {
        const sessId = await dOrch.initSess('pipedream', cfg.pipedream);
        return await dOrch.run(sessId, {
          workflowId,
          payload
        });
      } catch (e) {
        console.error("Workflow Trigger Error:", e);
        return {
          error: e.message
        };
      }
    }
  }), [st.d, runAgg, JSON.stringify(cfg)]);

  return {
    isLoading: st.ld,
    error: st.err,
    data: st.d,
    progress: st.prog,
    actions: fns,
  };
};

const internalState = {};

const simReact = {
  useState: (initialValue) => {
    const componentId = simReact.currentComponentId;
    const hookIndex = simReact.hookIndex++;

    if (!internalState[componentId]) {
      internalState[componentId] = [];
    }
    if (internalState[componentId][hookIndex] === undefined) {
      internalState[componentId][hookIndex] = initialValue;
    }

    const setState = (newValue) => {
      const oldValue = internalState[componentId][hookIndex];
      let valueToSet = newValue;
      if (typeof newValue === 'function') {
        valueToSet = newValue(oldValue);
      }
      internalState[componentId][hookIndex] = valueToSet;
      // In a real implementation, this would trigger a re-render.
      // console.log(`[SIM] State updated for ${componentId}[${hookIndex}]`);
    };

    return [internalState[componentId][hookIndex], setState];
  },

  useEffect: (callback, dependencies) => {
    const componentId = simReact.currentComponentId;
    const hookIndex = simReact.hookIndex++;

    if (!internalState[componentId]) {
      internalState[componentId] = [];
    }
    const oldDependencies = internalState[componentId][hookIndex];
    let hasChanged = true;
    if (oldDependencies) {
      if (dependencies) {
        hasChanged = dependencies.some((dep, i) => !Object.is(dep, oldDependencies[i]));
      } else {
        hasChanged = false; // Only run once if no dependency array
      }
    }

    if (hasChanged) {
      callback();
      internalState[componentId][hookIndex] = dependencies;
    }
  },

  useCallback: (callback, dependencies) => {
    const componentId = simReact.currentComponentId;
    const hookIndex = simReact.hookIndex++;

    if (!internalState[componentId]) {
      internalState[componentId] = [];
    }

    const [oldCallback, oldDependencies] = internalState[componentId][hookIndex] || [];
    let hasChanged = true;
    if (oldDependencies) {
      hasChanged = dependencies.some((dep, i) => !Object.is(dep, oldDependencies[i]));
    }

    if (hasChanged) {
      internalState[componentId][hookIndex] = [callback, dependencies];
      return callback;
    }

    return oldCallback;
  },

  useMemo: (factory, dependencies) => {
    const componentId = simReact.currentComponentId;
    const hookIndex = simReact.hookIndex++;

    if (!internalState[componentId]) {
      internalState[componentId] = [];
    }

    const [oldValue, oldDependencies] = internalState[componentId][hookIndex] || [];
    let hasChanged = true;
    if (oldDependencies) {
      hasChanged = dependencies.some((dep, i) => !Object.is(dep, oldDependencies[i]));
    }

    if (hasChanged) {
      const newValue = factory();
      internalState[componentId][hookIndex] = [newValue, dependencies];
      return newValue;
    }

    return oldValue;
  },

  currentComponentId: null,
  hookIndex: 0,

  render: (Component, props, id) => {
    simReact.currentComponentId = id;
    simReact.hookIndex = 0;
    return Component(props);
  }
};

if (typeof React === 'undefined') {
  global.React = simReact;
}
for (let i = 0; i < 500; i++) {
  const sName = `gen_svc_${i}`;
  const sId = `gen_id_${i}`;
  const prng = util.prng(i);
  apiSvcRegistry[sName] = {
    id: sId,
    auth: async (cfg) => {
      await util.simLatency(prng.next() % 100 + 50);
      return {
        s: 1,
        t: `gen_tkn_${i}_${util.genId(12)}`
      };
    },
    exec: async (t, p) => {
      await util.simLatency(prng.next() % 500 + 200);
      const data = {};
      const fieldCount = prng.next() % 10 + 2;
      for (let j = 0; j < fieldCount; j++) {
        data[`field_${j}`] = prng.nextFloat() * 1000;
      }
      return {
        s: 1,
        d: {
          ...data,
          source: sName,
          timestamp: Date.now()
        }
      };
    }
  };
}
for (let i = 0; i < 500; i++) {
  const sName = `another_svc_${i}`;
  const sId = `another_id_${i}`;
