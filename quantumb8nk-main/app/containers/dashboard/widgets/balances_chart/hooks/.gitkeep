  apiSvcRegistry[sName] = {
    id: sId,
    auth: async (cfg) => {
      await util.simLatency(prng.next() % 120 + 60);
      if (prng.nextFloat() < 0.1) return {
        s: 0,
        e: 'RANDOM_AUTH_FAILURE'
      };
      return {
        s: 1,
        t: `athr_tkn_${i}_${util.genId(16)}`
      };
    },
    exec: async (t, p) => {
      await util.simLatency(prng.next() % 600 + 250);
      if (prng.nextFloat() < 0.15) return {
        s: 0,
        e: 'RANDOM_EXEC_FAILURE'
      };
      const arr = [];
      const itemCount = prng.next() % 20 + 1;
      for (let k = 0; k < itemCount; k++) {
        arr.push({
          itemId: k,
          value: util.genId(8),
          metric: prng.nextFloat()
        });
      }
      return {
        s: 1,
        d: {
          items: arr,
          metadata: {
            source: sName,
            query: p
          }
        }
      };
    }
  };
}
