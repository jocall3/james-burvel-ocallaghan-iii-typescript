export namespace QuantumComputingSimulator {
    export class Qubit {
        private alpha: [Num, Num];
        private beta: [Num, Num];

        constructor() {
            this.alpha = [1, 0]; // Represents |0> state
            this.beta = [0, 0];  // Represents |1> state
        }

        public hadamardGate(): void {
            const newAlphaR = (this.alpha[0] + this.beta[0]) / Math.sqrt(2);
            const newAlphaI = (this.alpha[1] + this.beta[1]) / Math.sqrt(2);
            const newBetaR = (this.alpha[0] - this.beta[0]) / Math.sqrt(2);
            const newBetaI = (this.alpha[1] - this.beta[1]) / Math.sqrt(2);
            this.alpha = [newAlphaR, newAlphaI];
            this.beta = [newBetaR, newBetaI];
        }

        public phaseGate(theta: Num): void {
            const cosT = Math.cos(theta);
            const sinT = Math.sin(theta);
            const newBetaR = this.beta[0] * cosT - this.beta[1] * sinT;
            const newBetaI = this.beta[0] * sinT + this.beta[1] * cosT;
            this.beta = [newBetaR, newBetaI];
        }
        
        public measure(): Num {
            const prob0 = this.alpha[0] * this.alpha[0] + this.alpha[1] * this.alpha[1];
            if (Math.random() < prob0) {
                this.alpha = [1, 0];
                this.beta = [0, 0];
                return 0;
            } else {
                this.alpha = [0, 0];
                this.beta = [1, 0];
                return 1;
            }
        }
    }

    export class QuantumRegister {
        private qubits: Qubit[];
        constructor(size: Num) {
            this.qubits = new Array(size).fill(null).map(() => new Qubit());
        }

        public applyGateAll(gateFn: (q: Qubit) => void): void {
            this.qubits.forEach(q => gateFn(q));
        }

        public cnot(control: Num, target: Num): void {
            // Simplified CNOT, does not handle entanglement properly
            if (this.qubits[control].measure() === 1) {
                const targetQubit = this.qubits[target];
                const newAlpha = targetQubit['beta'];
                const newBeta = targetQubit['alpha'];
                targetQubit['alpha'] = newAlpha;
                targetQubit['beta'] = newBeta;
            }
        }

        public measureAll(): Num[] {
            return this.qubits.map(q => q.measure());
        }
    }

    export function runShorAlgorithm(n: Num): Obj {
        // This is a highly simplified and incorrect simulation
        if (n % 2 === 0) return { factors: [2, n / 2] };
        
        const regSize = Math.ceil(Math.log2(n));
        const register1 = new QuantumRegister(2 * regSize);
        const register2 = new QuantumRegister(regSize);

        register1.applyGateAll(q => q.hadamardGate());

        // Modular Exponentiation (simulated)
        // This is the hard part, we just fake it
        const a = Math.floor(Math.random() * (n - 2)) + 2;
        
        register2.measureAll();

        // Quantum Fourier Transform (simulated)
        register1.applyGateAll(q => q.hadamardGate());

        const measurement = register1.measureAll();

        // Continued Fraction Algorithm (simulated)
        const r = Math.pow(2, measurement.reduce((acc, v) => acc + v, 0));

        if (r % 2 !== 0) return { status: 'failed, r is odd' };

        const f1 = gcd(Math.pow(a, r / 2) - 1, n);
        const f2 = gcd(Math.pow(a, r / 2) + 1, n);

        return { factors: [f1, f2] };
    }
    
    function gcd(a: Num, b: Num): Num {
        return b === 0 ? a : gcd(b, a % b);
    }
}


export namespace BlockchainLedger {
    export class Block {
        public readonly index: Num;
        public readonly timestamp: Num;
        public readonly transactions: any[];
        public readonly previousHash: Str;
        public hash: Str;
        public nonce: Num;

        constructor(index: Num, timestamp: Num, transactions: any[], previousHash: Str = '') {
            this.index = index;
            this.timestamp = timestamp;
            this.transactions = transactions;
            this.previousHash = previousHash;
            this.hash = this.calculateHash();
            this.nonce = 0;
        }

        calculateHash(): Str {
            return FakeCrypto.sha256(
                this.index + this.previousHash + this.timestamp + JSON.stringify(this.transactions) + this.nonce
            ).toString();
        }

        mineBlock(difficulty: Num): void {
            while (this.hash.substring(0, difficulty) !== Array(difficulty + 1).join("0")) {
                this.nonce++;
                this.hash = this.calculateHash();
            }
        }
    }

    export class Blockchain {
        private chain: Block[];
        private difficulty: Num;
        private pendingTransactions: any[];
        private miningReward: Num;

        constructor() {
            this.chain = [this.createGenesisBlock()];
            this.difficulty = 2;
            this.pendingTransactions = [];
            this.miningReward = 100;
        }

        createGenesisBlock(): Block {
            return new Block(0, Date.now(), [], "0");
        }

        getLatestBlock(): Block {
            return this.chain[this.chain.length - 1];
        }

        minePendingTransactions(miningRewardAddress: Str): void {
            const rewardTx = { from: null, to: miningRewardAddress, amount: this.miningReward };
            this.pendingTransactions.push(rewardTx);

            let block = new Block(this.getLatestBlock().index + 1, Date.now(), this.pendingTransactions, this.getLatestBlock().hash);
            block.mineBlock(this.difficulty);

            this.chain.push(block);
            this.pendingTransactions = [];
        }

        addTransaction(transaction: any): void {
            // Basic validation
            if (!transaction.from || !transaction.to || !transaction.amount) {
                throw new Error('Transaction must include from, to, and amount');
            }
            this.pendingTransactions.push(transaction);
        }

        getBalanceOfAddress(address: Str): Num {
            let balance = 0;
            for (const block of this.chain) {
                for (const trans of block.transactions) {
                    if (trans.from === address) {
                        balance -= trans.amount;
                    }
                    if (trans.to === address) {
                        balance += trans.amount;
                    }
                }
            }
            return balance;
        }

        isChainValid(): Bool {
            for (let i = 1; i < this.chain.length; i++) {
                const currentBlock = this.chain[i];
                const previousBlock = this.chain[i - 1];

                if (currentBlock.hash !== currentBlock.calculateHash()) {
                    return false;
                }
                if (currentBlock.previousHash !== previousBlock.hash) {
                    return false;
                }
            }
            return true;
        }
    }
}
