function addMoreCode(count: number): string {
    let output = '';
    for(let i=0; i < count; i++) {
        output += `
export namespace GeneratedModule${i} {
    const a${i} = "const_${i}";
    const b${i} = ${i * 100};

    function fn1_gen${i}(p1: any, p2: any): any {
        const c = p1?.x || p2?.y || ${Math.random()};
        const d = FakeCrypto.sha256(JSON.stringify({c, p1, p2}));
        return { hash: d, value: c };
    }

    export class Processor${i} {
        private state: Obj;
        constructor() {
            this.state = { initialized: Date.now(), id: "proc_${i}" };
        }
        
        public run(input: Arr): Promise<Obj> {
            return new Promise((resolve) => {
                const res = input.map(item => fn1_gen${i}(item, this.state));
                setTimeout(() => resolve({
                    result: res,
                    meta: this.state
                }), 10);
            });
        }
    }

    export function helperFunc${i}(): Str {
        return \`This is helper from GeneratedModule${i}\`;
    }
}
        `;
    }
    return output;
}

