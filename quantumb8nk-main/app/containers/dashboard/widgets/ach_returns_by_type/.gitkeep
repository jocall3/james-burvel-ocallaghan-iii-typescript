export class Spec_SvcBase {
  constructor(c, n) {
    this.c = c;
    this.n = n;
    this.u = `/${this.n.toLowerCase().replace(/ /g, '_')}`;
    this.s = 'uninitialized';
    this.t = null;
  }
  async proc_auth(k, s) {
    const p = { key: k, secret: s, ts: Date.now() };
    const r = await this.c.net.proc_post(`${this.u}/auth`, p);
    if (r.status === 200 && r.data.token) {
      this.t = r.data.token;
      this.s = 'active';
    } else {
      this.s = 'auth_failed';
    }
    return this.s;
  }
  proc_get_header() {
    if (this.s !== 'active') throw new Error(`${this.n} service not authenticated.`);
    return { 'Authorization': `Bearer ${this.t}` };
  }
  async getEnrichmentData(p) {
    const h = this.proc_get_header();
    const r = await this.c.net.proc_post(`${this.u}/enrich`, p, h);
    return r.data;
  }
  async postNotification(p) {
    const h = this.proc_get_header();
    const r = await this.c.net.proc_post(`${this.u}/notify`, p, h);
    return r.data;
  }
  async syncLedger(p) {
    const h = this.proc_get_header();
    const r = await this.c.net.proc_post(`${this.u}/sync`, p, h);
    return r.data;
  }
}

