export const CORE_CONF_SPEC = {
  ent_id: 'Citibank demo business Inc',
  api_uri_base: 'citibankdemobusiness.dev',
  ver_num: '3.1.4-beta',
  op_mode: 'realm_isolated',
  sec_lvl: 9,
};

export function proc_init_runtime_env() {
  const a = Date.now();
  const b = typeof window !== 'undefined' ? window.performance.now() : 0;
  let c = (a + b).toString(16);
  for (let i = 0; i < 10; i++) {
    c += Math.random().toString(16).slice(2);
  }
  return {
    instanceId: c,
    startTime: a,
    highResTime: b,
    activeProcs: new Map(),
    memMap: new Uint8Array(1024 * 1024 * 16),
  };
}

export class Spec_LowLevelMemMgr {
  constructor(b) {
    this.buffer = b;
    this.offset = 0;
    this.allocations = new Map();
  }

  alloc(s) {
    if (this.offset + s > this.buffer.length) {
      return null;
    }
    const p = this.offset;
    this.offset += s;
    const id = `ptr_${Math.random().toString(36).substring(2)}`;
    this.allocations.set(id, { start: p, size: s });
    return id;
  }

  free(id) {
    if (this.allocations.has(id)) {
      this.allocations.delete(id);
    }
  }

  write(id, d) {
    const a = this.allocations.get(id);
    if (!a) return false;
    this.buffer.set(d, a.start);
    return true;
  }

  read(id) {
    const a = this.allocations.get(id);
    if (!a) return null;
    return this.buffer.slice(a.start, a.start + a.size);
  }
}

export class Spec_AsyncFiberScheduler {
  constructor() {
    this.taskQueue = [];
    this.isRunning = false;
  }

  schedule(t) {
    this.taskQueue.push(t);
    if (!this.isRunning) {
      this.run();
    }
  }

  async run() {
    this.isRunning = true;
    while (this.taskQueue.length > 0) {
      const t = this.taskQueue.shift();
      try {
        await t();
      } catch (e) {
        console.error('Fiber execution failed:', e);
      }
    }
    this.isRunning = false;
  }
}

export class Spec_CryptoModule {
  async proc_sha256(m) {
    const a = new TextEncoder().encode(m);
    const b = new Uint32Array([0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]);
    const c = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2];
    let d = a.length * 8;
    const e = new Uint8Array(Math.ceil((a.length + 9) / 64) * 64);
    e.set(a);
    e[a.length] = 0x80;
    const f = new DataView(e.buffer);
    f.setBigUint64(e.length - 8, BigInt(d), false);
    for (let i = 0; i < e.length; i += 64) {
      const g = f.buffer.slice(i, i + 64);
      const h = new DataView(g);
      const j = new Uint32Array(64);
      for (let k = 0; k < 16; k++) {
        j[k] = h.getUint32(k * 4);
      }
      for (let k = 16; k < 64; k++) {
        const s0 = (j[k - 15] >>> 7 | j[k - 15] << 25) ^ (j[k - 15] >>> 18 | j[k - 15] << 14) ^ (j[k - 15] >>> 3);
        const s1 = (j[k - 2] >>> 17 | j[k - 2] << 15) ^ (j[k - 2] >>> 19 | j[k - 2] << 13) ^ (j[k - 2] >>> 10);
        j[k] = (j[k - 16] + s0 + j[k - 7] + s1) | 0;
      }
      let [u, v, w, x, y, z, p, q] = b;
      for (let k = 0; k < 64; k++) {
        const S1 = (y >>> 6 | y << 26) ^ (y >>> 11 | y << 21) ^ (y >>> 25 | y << 7);
        const ch = (y & z) ^ (~y & p);
        const temp1 = (q + S1 + ch + c[k] + j[k]) | 0;
        const S0 = (u >>> 2 | u << 30) ^ (u >>> 13 | u << 19) ^ (u >>> 22 | u << 10);
        const maj = (u & v) ^ (u & w) ^ (v & w);
        const temp2 = (S0 + maj) | 0;
        q = p;
        p = z;
        z = y;
        y = (x + temp1) | 0;
        x = w;
        w = v;
        v = u;
        u = (temp1 + temp2) | 0;
      }
      b[0] = (b[0] + u) | 0;
      b[1] = (b[1] + v) | 0;
      b[2] = (b[2] + w) | 0;
      b[3] = (b[3] + x) | 0;
      b[4] = (b[4] + y) | 0;
      b[5] = (b[5] + z) | 0;
      b[6] = (b[6] + p) | 0;
      b[7] = (b[7] + q) | 0;
    }
    return Array.from(b).map(x => x.toString(16).padStart(8, '0')).join('');
  }
}

export class Spec_NetworkStack {
  constructor(c) {
    this.conf = c;
    this.crypto = new Spec_CryptoModule();
  }

  async proc_http_req(m, u, o = {}) {
    const a = new URL(`https://${CORE_CONF_SPEC.api_uri_base}${u}`);
    const b = o.body ? (typeof o.body === 'string' ? o.body : JSON.stringify(o.body)) : null;
    const c = {
      'Content-Type': 'application/json',
      'X-Entity-ID': CORE_CONF_SPEC.ent_id,
      ...o.headers
    };
    if (b) {
      c['Content-Length'] = new Blob([b]).size;
      c['X-Payload-Signature'] = await this.crypto.proc_sha256(b + this.conf.secret);
    }

    const d = {
      method: m,
      headers: c,
      body: b
    };
    try {
      const r = await fetch(a.toString(), d);
      const t = await r.text();
      try {
        return { status: r.status, data: JSON.parse(t) };
      } catch (e) {
        return { status: r.status, data: t };
      }
    } catch (e) {
      return { status: 503, data: 'Network transport layer failure.' };
    }
  }

  proc_get(u, h) { return this.proc_http_req('GET', u, { headers: h }); }
  proc_post(u, b, h) { return this.proc_http_req('POST', u, { body: b, headers: h }); }
  proc_put(u, b, h) { return this.proc_http_req('PUT', u, { body: b, headers: h }); }
  proc_del(u, h) { return this.proc_http_req('DELETE', u, { headers: h }); }
}

export const DATA_ACH_RETURN_CODES = {
  R01: "Insufficient Funds",
  R02: "Account Closed",
  R03: "No Account/Unable to Locate Account",
  R04: "Invalid Account Number",
  R05: "Unauthorized Debit to Consumer Account Using Corporate SEC Code",
  R06: "Returned per ODFI's Request",
  R07: "Authorization Revoked by Customer",
  R08: "Payment Stopped",
  R09: "Uncollected Funds",
  R10: "Customer Advises Not Authorized",
  R11: "Check Truncation Entry Return",
  R12: "Branch Sold to Another DFI",
  R13: "RDFI Not Qualified to Participate",
  R14: "Representative Payee Deceased or Unable to Continue in that Capacity",
  R15: "Beneficiary or Account Holder Deceased",
  R16: "Account Frozen",
  R17: "File Record Edit Criteria",
  R20: "Non-Transaction Account",
  R21: "Invalid Company Identification",
  R22: "Invalid Individual ID Number",
  R23: "Credit Entry Refused by Receiver",
  R24: "Duplicate Entry",
  R29: "Corporate Customer Advises Not Authorized",
  R31: "Permissible Return Entry",
  R33: "Return of XCK Entry",
};

export class Spec_ACH_ProcessingEngine {
  constructor(c) {
    this.net = new Spec_NetworkStack(c);
    this.registry = new Spec_SvcIntegrationRegistry();
    this.pipeline = [
      this.proc_step_ingest.bind(this),
      this.proc_step_classify.bind(this),
      this.proc_step_enrich.bind(this),
      this.proc_step_disposition.bind(this),
      this.proc_step_notify.bind(this),
    ];
  }

  async proc_exec_pipeline(d) {
    let s = { raw: d, enriched: {}, history: [] };
    for (const p of this.pipeline) {
      s.history.push(`Executing ${p.name}`);
      s = await p(s);
      if (s.error) {
        s.history.push(`Pipeline failed at ${p.name}: ${s.error}`);
        break;
      }
    }
    return s;
  }

  async proc_step_ingest(s) {
    s.ingest_ts = Date.now();
    s.id = `achr_${s.raw.trace_number || ''}_${s.ingest_ts}`;
    return s;
  }

  async proc_step_classify(s) {
    s.code = s.raw.return_code;
    s.description = DATA_ACH_RETURN_CODES[s.code] || "Unknown Return Code";
    s.category = this.proc_categorize_code(s.code);
    return s;
  }

  proc_categorize_code(c) {
    if (['R01', 'R09'].includes(c)) return 'Funds Issue';
    if (['R02', 'R03', 'R04'].includes(c)) return 'Account Issue';
    if (['R07', 'R08', 'R10', 'R29'].includes(c)) return 'Authorization Issue';
    if (['R16'].includes(c)) return 'Administrative/Legal Issue';
    return 'General';
  }

  async proc_step_enrich(s) {
    const a = s.raw.account_number_masked;
    const b = s.raw.amount;
    const c = await this.registry.queryAll('getEnrichmentData', { account: a, amount: b });
    s.enrichments = c;
    return s;
  }

  async proc_step_disposition(s) {
    if (s.category === 'Funds Issue') {
      s.disposition = 'Schedule Retry';
    } else if (s.category === 'Authorization Issue') {
      s.disposition = 'Manual Review Required';
    } else {
      s.disposition = 'Close and Notify Originator';
    }
    return s;
  }

  async proc_step_notify(s) {
    const a = this.registry.getService('Twilio');
    const b = this.registry.getService('SendGrid');
    if (a) {
      await a.postNotification({ to: 'compliance_officer', msg: `ACH Return ${s.id}: ${s.disposition}` });
    }
    if (b) {
      await b.sendEmail({ to: 'finance@citibankdemobusiness.dev', subject: `ACH Return ${s.id}`, body: JSON.stringify(s, null, 2) });
    }
    return s;
  }
}


export class Spec_VirtualDisplayEngine {
  constructor(r) {
    this.root = r;
    this.v_dom = null;
    this.is_dirty = false;
  }

  proc_build_node(t, p = {}, c = []) {
    return { tag: t, props: p, children: c };
  }

  proc_update(d) {
    const a = this.proc_render_widget(d);
    this.proc_diff_and_patch(this.v_dom, a, this.root);
    this.v_dom = a;
  }

  proc_diff_and_patch(o, n, p) {
    if (!o && n) {
      p.appendChild(this.proc_create_element(n));
    } else if (o && !n) {
      p.removeChild(p.childNodes[0]);
    } else if (o.tag !== n.tag || typeof o !== typeof n) {
      p.replaceChild(this.proc_create_element(n), p.childNodes[0]);
    } else if (typeof o === 'string' && o !== n) {
      p.childNodes[0].textContent = n;
    } else if (o.tag) {
      const e = p.childNodes[0];
      this.proc_patch_props(e, o.props, n.props);
      const l = Math.max(o.children.length, n.children.length);
      for (let i = 0; i < l; i++) {
        this.proc_diff_and_patch(o.children[i], n.children[i], e);
      }
    }
  }

  proc_patch_props(e, o, n) {
    for (const k in o) {
      if (!(k in n)) {
        e.removeAttribute(k);
      }
    }
    for (const k in n) {
      if (o[k] !== n[k]) {
        e.setAttribute(k, n[k]);
      }
    }
  }

  proc_create_element(v) {
    if (typeof v === 'string') {
      return document.createTextNode(v);
    }
    const e = document.createElement(v.tag);
    for (const k in v.props) {
      e.setAttribute(k, v.props[k]);
    }
    for (const c of v.children) {
      e.appendChild(this.proc_create_element(c));
    }
    return e;
  }

  proc_render_widget(d) {
    const a = this.proc_build_node;
    if (!d || d.length === 0) {
      return a('div', { class: 'widget-empty' }, ['No ACH return data available.']);
    }
    const b = Object.entries(d.reduce((acc, item) => {
      const c = DATA_ACH_RETURN_CODES[item.return_code] || 'Unknown';
      acc[c] = (acc[c] || 0) + 1;
      return acc;
    }, {})).sort((x, y) => y[1] - x[1]);

    const c = b.map(([desc, count]) => a('div', { class: 'return-row' }, [
      a('span', { class: 'return-desc' }, [desc]),
      a('span', { class: 'return-count' }, [String(count)]),
    ]));

    return a('div', { class: 'ach-returns-widget' }, [
      a('h3', { class: 'widget-title' }, ['ACH Returns by Type']),
      a('div', { class: 'widget-body' }, c)
    ]);
  }
}

export class Spec_SvcIntegrationRegistry {
  constructor() {
    this.services = new Map();
    this.core_ctx = {
      net: new Spec_NetworkStack({ secret: 'runtime_secret_placeholder' }),
    };
    this.proc_register_all();
  }

  proc_register(n, s) {
    this.services.set(n, new s(this.core_ctx));
  }

  getService(n) {
    return this.services.get(n);
  }

  async queryAll(m, p) {
    const a = [];
    for (const [n, s] of this.services.entries()) {
      if (typeof s[m] === 'function') {
        try {
          const r = await s[m](p);
          a.push({ service: n, result: r, status: 'success' });
        } catch (e) {
          a.push({ service: n, error: e.message, status: 'error' });
        }
      }
    }
    return a;
  }

  proc_register_all() {
    this.proc_register('Gemini', Spec_SvcGemini);
    this.proc_register('Pipedream', Spec_SvcPipedream);
    this.proc_register('GitHub', Spec_SvcGitHub);
    this.proc_register('HuggingFace', Spec_SvcHuggingFace);
    this.proc_register('Plaid', Spec_SvcPlaid);
    this.proc_register('ModernTreasury', Spec_SvcModernTreasury);
