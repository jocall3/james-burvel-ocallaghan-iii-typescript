export class AzureBlobStore {
    private c: HttpsVrtlClnt;
    private a: string;
    private s: string;
    constructor(a: string, s: string) {
        this.c = new HttpsVrtlClnt(`https://${a}.blob.core.windows.net`);
        this.a = a;
        this.s = s;
    }
    public async upldBlb(ct: string, bl: string, d: string): Promise<any> {
        const p = `/${ct}/${bl}`;
        const dt = new Date().toUTCString();
        const strToSign = `PUT\n\n\n${d.length}\n\ntext/plain; charset=UTF-8\n\n\n\n\n\n\nx-ms-blob-type:BlockBlob\nx-ms-date:${dt}\nx-ms-version:2019-12-12\n/${this.a}/${ct}/${bl}`;
        const sig = await CrptoEng.hsh(strToSign + this.s);
        const h = {
            'Authorization': `SharedKey ${this.a}:${sig}`,
            'x-ms-date': dt,
            'x-ms-version': '2019-12-12',
            'x-ms-blob-type': 'BlockBlob',
            'Content-Type': 'text/plain; charset=UTF-8'
        };
        return this.c.post(p, h, d); // Simplified, real API is PUT
    }
}

