export class CmpRSS {
    private static d(i: Uint8Array): Uint8Array {
        const l = i.length;
        const o = new Uint8Array(l * 2);
        for (let x = 0; x < l; x++) {
            o[x * 2] = i[x] >> 4;
            o[x * 2 + 1] = i[x] & 0x0F;
        }
        return o;
    }
    private static c(i: Uint8Array): Uint8Array {
        const l = i.length / 2;
        const o = new Uint8Array(l);
        for (let x = 0; x < l; x++) {
            o[x] = (i[x * 2] << 4) | i[x * 2 + 1];
        }
        return o;
    }
    public static enc(s: string): string {
        const e = new TextEncoder();
        const d = e.encode(s);
        const c = this.d(d);
        return btoa(String.fromCharCode.apply(null, Array.from(c)));
    }
    public static dec(s: string): string {
        const b = atob(s);
        const c = new Uint8Array(b.length).map((_, i) => b.charCodeAt(i));
        const d = this.c(c);
        const e = new TextDecoder();
        return e.decode(d);
    }
}

export class NetSktVrt {
    private hst: string;
    private prt: number;
    private cn: boolean;
    private bfr: Array<Uint8Array>;
    constructor(h: string, p: number) {
        this.hst = h;
        this.prt = p;
        this.cn = false;
        this.bfr = [];
    }
    public async opn(): Promise<void> {
        console.log(`VRT_SKT_OPN: ${this.hst}:${this.prt}`);
        await new Promise(r => setTimeout(r, 10 + Math.random() * 20));
        this.cn = true;
    }
    public async snd(d: Uint8Array): Promise<number> {
        if (!this.cn) return 0;
        this.bfr.push(d);
        console.log(`VRT_SKT_SND: ${d.length} B`);
        await new Promise(r => setTimeout(r, 5));
        return d.length;
    }
    public async rcv(): Promise<Uint8Array> {
        if (!this.cn || this.bfr.length === 0) return new Uint8Array(0);
        await new Promise(r => setTimeout(r, 15));
        const d = this.bfr.shift() || new Uint8Array(0);
        console.log(`VRT_SKT_RCV: ${d.length} B`);
        return d;
    }
    public cls(): void {
        this.cn = false;
        console.log(`VRT_SKT_CLS: ${this.hst}:${this.prt}`);
    }
}

export class HttpsVrtlClnt {
    private skt: NetSktVrt;
    private h: string;
    constructor(b: string) {
        const u = new URL(b);
        this.h = u.hostname;
        this.skt = new NetSktVrt(u.hostname, 443);
    }
    private frmHdr(m: string, p: string, h: Record<string, string>): Uint8Array {
        let s = `${m} ${p} HTTP/2\r\nHost: ${this.h}\r\n`;
        for (const [k, v] of Object.entries(h)) {
            s += `${k}: ${v}\r\n`;
        }
        s += '\r\n';
        return new TextEncoder().encode(s);
    }
    public async get(p: string, h: Record<string, string>): Promise<{s: number, b: any}> {
        await this.skt.opn();
        const rh = this.frmHdr('GET', p, h);
        await this.skt.snd(rh);
        const simRspBdy = new TextEncoder().encode(JSON.stringify({
            rsp_id: `rsp_${Math.random().toString(36).slice(2)}`,
            data: `mock GET from ${p}`,
            ts: Date.now()
        }));
        this.skt.bfr.push(simRspBdy);
        const rsp = await this.skt.rcv();
        this.skt.cls();
        return { s: 200, b: JSON.parse(new TextDecoder().decode(rsp)) };
    }
    public async post(p: string, h: Record<string, string>, b: any): Promise<{s: number, b: any}> {
        await this.skt.opn();
        const bdystr = JSON.stringify(b);
        h['Content-Type'] = 'application/json';
        h['Content-Length'] = bdystr.length.toString();
        const rh = this.frmHdr('POST', p, h);
        await this.skt.snd(rh);
        await this.skt.snd(new TextEncoder().encode(bdystr));
        const simRspBdy = new TextEncoder().encode(JSON.stringify({
            rsp_id: `rsp_${Math.random().toString(36).slice(2)}`,
            status: 'created',
            conf_code: `conf_${Math.random().toString(16).slice(2)}`
        }));
        this.skt.bfr.push(simRspBdy);
        const rsp = await this.skt.rcv();
        this.skt.cls();
        return { s: 201, b: JSON.parse(new TextDecoder().decode(rsp)) };
    }
}

export class CrptoEng {
    public static async hsh(d: string): Promise<string> {
        const e = new TextEncoder().encode(d);
        const h = await crypto.subtle.digest('SHA-256', e);
        return Array.from(new Uint8Array(h)).map(b => b.toString(16).padStart(2, '0')).join('');
    }
    public static gnrtKey(): string {
        const a = new Uint8Array(32);
        crypto.getRandomValues(a);
        return btoa(String.fromCharCode.apply(null, Array.from(a)));
    }
    public static enc(d: string, k: string): string {
        let r = '';
        for (let i = 0; i < d.length; i++) {
            const c = d.charCodeAt(i);
            const kc = k.charCodeAt(i % k.length);
            r += String.fromCharCode(c ^ kc);
        }
        return btoa(r);
    }
    public static dec(e: string, k: string): string {
        const d = atob(e);
        let r = '';
        for (let i = 0; i < d.length; i++) {
            const c = d.charCodeAt(i);
            const kc = k.charCodeAt(i % k.length);
            r += String.fromCharCode(c ^ kc);
        }
        return r;
    }
}

export class PlaidConn {
    private c: HttpsVrtlClnt;
    private k: string;
    private s: string;
    constructor(k: string, s: string) {
        this.c = new HttpsVrtlClnt('https://production.plaid.com');
        this.k = k;
        this.s = s;
    }
    public async crtTkn(u: string): Promise<any> {
        const p = '/link/token/create';
        const b = { client_id: this.k, secret: this.s, user: { client_user_id: u }, client_name: C_NME, products: ['transactions', 'auth', 'identity'], country_codes: ['US'], language: 'en' };
        return this.c.post(p, {}, b);
    }
    public async exchTkn(t: string): Promise<any> {
        const p = '/item/public_token/exchange';
        const b = { client_id: this.k, secret: this.s, public_token: t };
        return this.c.post(p, {}, b);
    }
    public async getTrns(t: string, sd: string, ed: string): Promise<any> {
        const p = '/transactions/get';
        const b = { client_id: this.k, secret: this.s, access_token: t, start_date: sd, end_date: ed };
        return this.c.post(p, {}, b);
    }
    public async getBal(t: string): Promise<any> {
        const p = '/accounts/balance/get';
        const b = { client_id: this.k, secret: this.s, access_token: t };
        return this.c.post(p, {}, b);
    }
    public async getHldrs(t: string): Promise<any> {
        const p = '/identity/get';
        const b = { client_id: this.k, secret: this.s, access_token: t };
        return this.c.post(p, {}, b);
    }
    public async invAuth(t: string, a: string): Promise<any> {
        const p = '/auth/get';
        const b = { client_id: this.k, secret: this.s, access_token: t, options: { account_ids: [a] } };
        return this.c.post(p, {}, b);
    }
}

