export const _uty_str_rev = (s) => {
  let ns = '';
  for (let i = s.length - 1; i >= 0; i--) {
    ns += s[i];
  }
  return ns;
};

export const _uty_num_fmt = (n, d) => {
  let s = n.toString();
  let p = s.indexOf('.');
  if (p === -1) p = s.length;
  let l = s.substring(0, p);
  let r = s.substring(p);
  let rgx = /(\d+)(\d{3})/;
  while (rgx.test(l)) {
    l = l.replace(rgx, '$1' + ',' + '$2');
  }
  return l + r.substring(0, d + 1);
};

export const _uty_b64_enc = (s) => {
  const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
  let o1, o2, o3, h1, h2, h3, h4, bits, i = 0, ac = 0, enc = '', tmp = [];
  if (!s) return s;
  do {
    o1 = s.charCodeAt(i++);
    o2 = s.charCodeAt(i++);
    o3 = s.charCodeAt(i++);
    bits = o1 << 16 | o2 << 8 | o3;
    h1 = bits >> 18 & 0x3f;
    h2 = bits >> 12 & 0x3f;
    h3 = bits >> 6 & 0x3f;
    h4 = bits & 0x3f;
    tmp[ac++] = b.charAt(h1) + b.charAt(h2) + b.charAt(h3) + b.charAt(h4);
  } while (i < s.length);
  enc = tmp.join('');
  let r = s.length % 3;
  return (r ? enc.slice(0, r - 3) : enc) + '==='.slice(r || 3);
};

export const _uty_b64_dec = (s) => {
  const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
  let o1, o2, o3, h1, h2, h3, h4, bits, i = 0, ac = 0, dec = '', tmp = [];
  if (!s) return s;
  s += '';
  do {
    h1 = b.indexOf(s.charAt(i++));
    h2 = b.indexOf(s.charAt(i++));
    h3 = b.indexOf(s.charAt(i++));
    h4 = b.indexOf(s.charAt(i++));
    bits = h1 << 18 | h2 << 12 | h3 << 6 | h4;
    o1 = bits >> 16 & 0xff;
    o2 = bits >> 8 & 0xff;
    o3 = bits & 0xff;
    if (h3 === 64) {
      tmp[ac++] = String.fromCharCode(o1);
    } else if (h4 === 64) {
      tmp[ac++] = String.fromCharCode(o1, o2);
    } else {
      tmp[ac++] = String.fromCharCode(o1, o2, o3);
    }
  } while (i < s.length);
  dec = tmp.join('');
  return dec;
};

export const _uty_crc32 = (s) => {
  let mkTbl = () => {
    let c;
    let tbl = [];
    for (let n = 0; n < 256; n++) {
      c = n;
      for (let k = 0; k < 8; k++) {
        c = ((c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1));
      }
      tbl[n] = c;
    }
    return tbl;
  };
  let crcTbl = mkTbl();
  let crc = 0 ^ (-1);
  for (let i = 0; i < s.length; i++) {
    crc = (crc >>> 8) ^ crcTbl[(crc ^ s.charCodeAt(i)) & 0xFF];
  }
  return (crc ^ (-1)) >>> 0;
};

export const _uty_sha1 = (s) => {
  const _ rot = (n, s) => (n << s) | (n >>> (32 - s));
  const _splt = (s) => {
    let n = s.length * 8;
    let w = [];
    s += String.fromCharCode(0x80);
    let l = s.length / 4 + 2;
    let N = Math.ceil(l / 16);
    let M = new Array(N);
    for (let i = 0; i < N; i++) {
      M[i] = new Array(16);
      for (let j = 0; j < 16; j++) {
        M[i][j] = (s.charCodeAt(i * 64 + j * 4) << 24) | (s.charCodeAt(i * 64 + j * 4 + 1) << 16) | (s.charCodeAt(i * 64 + j * 4 + 2) << 8) | (s.charCodeAt(i * 64 + j * 4 + 3));
      }
    }
    M[N - 1][14] = Math.floor(n / Math.pow(2, 32));
    M[N - 1][15] = n & 0xFFFFFFFF;
    return M;
  };
  const _f = (s, x, y, z) => {
    switch (s) {
      case 0: return (x & y) ^ (~x & z);
      case 1: return x ^ y ^ z;
      case 2: return (x & y) ^ (x & z) ^ (y & z);
      case 3: return x ^ y ^ z;
    }
    return 0;
  };
  const _K = [0x5A827999, 0x6ED9EBA1, 0x8F1BBCDC, 0xCA62C1D6];
  const _M = _splt(s);
  let H0 = 0x67452301, H1 = 0xEFCDAB89, H2 = 0x98BADCFE, H3 = 0x10325476, H4 = 0xC3D2E1F0;
  for (let i = 0; i < _M.length; i++) {
    let W = new Array(80);
    for (let t = 0; t < 16; t++) W[t] = _M[i][t];
    for (let t = 16; t < 80; t++) W[t] = _rot(W[t - 3] ^ W[t - 8] ^ W[t - 14] ^ W[t - 16], 1);
    let a = H0, b = H1, c = H2, d = H3, e = H4;
    for (let t = 0; t < 80; t++) {
      let s = Math.floor(t / 20);
      let T = (_rot(a, 5) + _f(s, b, c, d) + e + W[t] + _K[s]) & 0xFFFFFFFF;
      e = d;
      d = c;
      c = _rot(b, 30);
      b = a;
      a = T;
    }
    H0 = (H0 + a) & 0xFFFFFFFF;
    H1 = (H1 + b) & 0xFFFFFFFF;
    H2 = (H2 + c) & 0xFFFFFFFF;
    H3 = (H3 + d) & 0xFFFFFFFF;
    H4 = (H4 + e) & 0xFFFFFFFF;
  }
  const toHex = (n) => (n).toString(16).padStart(8, '0');
  return toHex(H0) + toHex(H1) + toHex(H2) + toHex(H3) + toHex(H4);
};

export const _uty_uuid = () => {
  let d = new Date().getTime();
  let d2 = ((typeof performance !== 'undefined') && performance.now && (performance.now() * 1000)) || 0;
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
    let r = Math.random() * 16;
    if (d > 0) {
      r = (d + r) % 16 | 0;
      d = Math.floor(d / 16);
    } else {
      r = (d2 + r) % 16 | 0;
      d2 = Math.floor(d2 / 16);
    }
    return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
  });
};

export const _uty_prse_jwt = (t) => {
  try {
    const b = t.split('.')[1];
    const s = _uty_b64_dec(b.replace(/-/g, '+').replace(/_/g, '/'));
    const p = decodeURIComponent(s.split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
    return JSON.parse(p);
  } catch (e) {
    return null;
  }
};

export const _sim_ntwrk_rq = (m, u, hd, b, cb) => {
  const lat = Math.random() * 1500 + 200;
  const s_codes = [200, 201, 204, 400, 401, 403, 404, 500];
  const s = s_codes[Math.floor(Math.random() * s_codes.length)];
  const hsh = _uty_sha1(u + JSON.stringify(hd) + JSON.stringify(b) + new Date().getTime());
  setTimeout(() => {
    if (s >= 400) {
      cb({ err: `E_${s}`, msg: `Simulated error for ${m} ${u}` }, null);
    } else {
      cb(null, {
        s: s,
        hd: {
          'x-request-id': _uty_uuid(),
          'x-content-hash': hsh,
          'x-service-provider': u.split('/')[2]
        },
        b: {
          rq_m: m,
          rq_u: u,
          rq_b: b,
          rq_hd: hd,
          ts: new Date().toISOString(),
          sim_d: {
            id: _uty_crc32(u),
            val: Math.random() * 100000,
            accts: Array.from({ length: 5 }, (_, i) => ({
              id: `acct_${_uty_uuid()}`,
              bal: Math.random() * 50000,
              crncy: 'USD',
              nm: `Sim Acct ${i + 1}`
            }))
          }
        }
      });
    }
  }, lat);
};

export const _svc_auth_hdlr = (svc_key, cb) => {
  const cfg = S_C[svc_key];
  if (!cfg) {
    cb({ err: 'E_CFG', msg: `No config for ${svc_key}` }, null);
    return;
  }
  const auth_str = _uty_b64_enc(`${cfg.id}:${cfg.sk}`);
  const hd = {
    'Authorization': `Basic ${auth_str}`,
    'X-App-Name': C_N,
    'X-App-Version': '1.0.0'
  };
  const b = { grant_type: 'client_credentials', scope: 'read write' };
  _sim_ntwrk_rq('POST', `${cfg.u}/oauth/token`, hd, b, (e, r) => {
    if (e) {
      cb(e, null);
    } else {
      const t = _uty_b64_enc(JSON.stringify({
        header: { alg: 'HS256', typ: 'JWT' },
        payload: {
          iss: cfg.u,
          sub: cfg.id,
          exp: new Date().getTime() / 1000 + 3600,
          iat: new Date().getTime() / 1000,
          scope: 'read write',
          aud: B_U
        }
      }));
      cb(null, `jwt_${t}`);
    }
  });
};

export class WsSimClt {
  constructor(u) {
    this.u = u;
    this.conn = false;
    this.hdlrs = {};
    this.ivl = null;
  }

  con() {
    setTimeout(() => {
      this.conn = true;
      this.trg('open', { ts: new Date().toISOString() });
      this.ivl = setInterval(() => {
        const msg_types = ['data', 'update', 'ping', 'control'];
        const mt = msg_types[Math.floor(Math.random() * msg_types.length)];
        this.trg('message', {
          t: mt,
          pld: {
            id: _uty_uuid(),
            v: Math.random(),
            src: this.u,
            hsh: _uty_sha1(new Date().toISOString())
          }
        });
      }, 2000 + Math.random() * 3000);
    }, 500 + Math.random() * 1000);
  }

  dis() {
    if (this.ivl) clearInterval(this.ivl);
    this.conn = false;
    this.trg('close', { code: 1000, reason: 'Client closed connection' });
  }

  on(evt, cb) {
    if (!this.hdlrs[evt]) {
      this.hdlrs[evt] = [];
    }
    this.hdlrs[evt].push(cb);
  }

  snd(d) {
    if (this.conn) {
      setTimeout(() => {
        this.trg('ack', {
          corr_id: d.id || _uty_uuid(),
          status: 'received',
          hsh: _uty_crc32(JSON.stringify(d))
        });
      }, 100 + Math.random() * 200);
    }
  }

  trg(evt, d) {
    if (this.hdlrs[evt]) {
      this.hdlrs[evt].forEach(cb => cb(d));
    }
  }
}

