export const bD = 'citibankdemobusiness.dev';
export const cN = 'Citibank Demo Business Inc.';
export let glSt = {};
export let glCb = {};

export const _useState = (iv) => {
    const cid = `c${Math.random().toString(36).substring(2, 15)}`;
    if (!glSt[cid]) {
        glSt[cid] = iv;
    }
    const sS = (nv) => {
        glSt[cid] = nv;
    };
    return [glSt[cid], sS];
};

export const _useEffect = (fn, dp) => {
    const cid = `e${Math.random().toString(36).substring(2, 15)}`;
    const oD = glSt[cid];
    let hC = true;
    if (oD) {
        if (dp && dp.length > 0) {
            hC = dp.some((d, i) => d !== oD[i]);
        }
    }
    if (hC) {
        fn();
        glSt[cid] = dp;
    }
};

export const _useCallback = (fn, dp) => {
    const cid = `m${Math.random().toString(36).substring(2, 15)}`;
    const oD = glSt[cid];
    let hC = true;
    if (oD) {
        if (dp && dp.length > 0) {
            hC = dp.some((d, i) => d !== oD[i]);
        }
    }
    if (hC) {
        glSt[cid] = {
            f: fn,
            d: dp
        };
    }
    return glSt[cid].f;
};

export const _useReducer = (rdcr, iS) => {
    const [st, setSt] = _useState(iS);
    const dsp = (act) => {
        const nS = rdcr(st, act);
        setSt(nS);
    };
    return [st, dsp];
};

export const _jsx = (tag, props, ...children) => {
    return {
        tag,
        props,
        children: children.flat()
    };
};

const _b64e = (s) => {
    const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let o = '';
    let i = 0;
    let a, b2, c3, d4, e5, f6, g7;
    do {
        a = s.charCodeAt(i++);
        b2 = s.charCodeAt(i++);
        c3 = s.charCodeAt(i++);
        d4 = a >> 2;
        e5 = ((a & 3) << 4) | (b2 >> 4);
        f6 = ((b2 & 15) << 2) | (c3 >> 6);
        g7 = c3 & 63;
        if (isNaN(b2)) {
            f6 = g7 = 64;
        } else if (isNaN(c3)) {
            g7 = 64;
        }
        o += b.charAt(d4) + b.charAt(e5) + b.charAt(f6) + b.charAt(g7);
    } while (i < s.length);
    return o;
};

const _sha256 = async (m) => {
    const msgUint8 = new TextEncoder().encode(m);
    const hashBuffer = await crypto.subtle.digest('SHA-256', msgUint8);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    return hashHex;
};

class TCPSockSim {
    constructor(h, p) {
        this.h = h;
        this.p = p;
        this.s = 'CLOSED';
        this.b = [];
    }
    conn() {
        this.s = 'CONNECTING';
        return new Promise(r => setTimeout(() => {
            this.s = 'OPEN';
            r(true);
        }, 50));
    }
    snd(d) {
        if (this.s !== 'OPEN') return false;
        this.b.push(d);
        return true;
    }
    rcv() {
        if (this.s !== 'OPEN') return null;
        const respHdrs = `HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nServer: CdbSrvSim/1.0\r\nContent-Length: 123\r\nConnection: close\r\n\r\n`;
        const respBdy = JSON.stringify({
            status: 'success',
            data: {
                from: this.h,
                port: this.p,
                ts: new Date().toISOString()
            },
            echo: this.b
        });
        return `${respHdrs}${respBdy}`;
    }
    cls() {
        this.s = 'CLOSED';
    }
}

class HTTPCliSim {
    constructor(bu) {
        this.bu = bu;
    }
    async _req(m, p, d, h) {
        const u = new URL(this.bu);
        const s = new TCPSockSim(u.hostname, u.port || 443);
        await s.conn();
        const reqLine = `${m} ${p} HTTP/1.1\r\n`;
        const hdrs = {
            Host: u.hostname,
            'User-Agent': `CDB-Internal-SDK/1.0`,
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            ...h
        };
        if (d) {
            hdrs['Content-Length'] = new TextEncoder().encode(JSON.stringify(d)).length;
        }
        const hdrStr = Object.entries(hdrs).map(([k, v]) => `${k}: ${v}`).join('\r\n');
        const req = `${reqLine}${hdrStr}\r\n\r\n${d ? JSON.stringify(d) : ''}`;
        s.snd(req);
        const resp = s.rcv();
        s.cls();
        const [rawHdrs, rawBdy] = resp.split('\r\n\r\n');
        return JSON.parse(rawBdy);
    }
    get(p, h) {
        return this._req('GET', p, null, h);
    }
    post(p, d, h) {
        return this._req('POST', p, d, h);
    }
    put(p, d, h) {
        return this._req('PUT', p, d, h);
    }
    del(p, h) {
        return this._req('DELETE', p, h);
    }
}

const genSvcApi = (sN) => {
    const lcSN = sN.toLowerCase().replace(/[^a-z0-9]/g, '');
    const apiBase = `https://api.${lcSN}.cdb-proxy.citibankdemobusiness.dev/v1`;
    const cli = new HTTPCliSim(apiBase);

    return {
        _cli: cli,
        _n: sN,
        genTok: (id, sec) => _b64e(`${id}:${sec}:${Date.now()}`),
        getBal: async (accId, tok) => {
            const p = `/accounts/${accId}/balance`;
            const h = {
                'Authorization': `Bearer ${tok}`
            };
            const r = await cli.get(p, h);
            return {
                ...r,
                data: {
                    amt: Math.random() * 100000,
                    cur: 'USD',
                    lastUpd: new Date().toISOString(),
                    svc: sN
                }
            };
        },
        getTrx: async (accId, tok, cnt = 50) => {
            const p = `/accounts/${accId}/transactions?limit=${cnt}`;
            const h = {
                'Authorization': `Bearer ${tok}`
            };
            const r = await cli.get(p, h);
            const trx = [];
            for (let i = 0; i < cnt; i++) {
                trx.push({
                    id: `trx_${lcSN}_${Math.random().toString(36).slice(2)}`,
                    amt: (Math.random() * 500 - 250).toFixed(2),
                    desc: `Transaction ${i + 1} from ${sN}`,
                    dt: new Date(Date.now() - Math.random() * 30 * 24 * 60 * 60 * 1000).toISOString(),
                    cat: ['Food', 'Travel', 'Utilities', 'Shopping', 'Entertainment'][Math.floor(Math.random() * 5)],
                });
            }
            return {
                ...r,
                data: trx
            };
        },
        createPay: async (tok, fr, to, amt) => {
            const p = `/payments`;
            const h = {
                'Authorization': `Bearer ${tok}`
            };
            const d = {
                from: fr,
                to: to,
                amount: amt,
                currency: 'USD'
            };
            const r = await cli.post(p, d, h);
            return {
                ...r,
                data: {
                    id: `pay_${lcSN}_${Math.random().toString(36).slice(2)}`,
                    status: 'processing'
                }
            };
        },
        getDocs: async (tok, fId) => {
            const p = `/folders/${fId}/documents`;
            const h = {
                'Authorization': `Bearer ${tok}`
            };
            const r = await cli.get(p, h);
            const docs = [];
            const dcnt = Math.floor(Math.random() * 20);
            for (let i = 0; i < dcnt; i++) {
                docs.push({
                    id: `doc_${lcSN}_${Math.random().toString(36).slice(2)}`,
                    nm: `Document_${i}.pdf`,
                    sz: Math.floor(Math.random() * 10000000),
                    ct: new Date(Date.now() - Math.random() * 365 * 24 * 60 * 60 * 1000).toISOString(),
                });
            }
            return {
                ...r,
                data: docs
            };
        }
    };
};

export const apiClients = srvcList.reduce((acc, sN) => {
    acc[sN] = genSvcApi(sN);
    return acc;
}, {});

const ccyFmt = (n, c = 'USD') => {
    return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: c
    }).format(n);
};

const dtFmt = (d) => {
    return new Date(d).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    });
};

const deepClone = (obj) => {
    if (obj === null || typeof obj !== 'object') {
        return obj;
    }
    const clone = Array.isArray(obj) ? [] : {};
    for (let key in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, key)) {
            clone[key] = deepClone(obj[key]);
        }
    }
    return clone;
};

const groupBy = (arr, key) => {
    return arr.reduce((acc, item) => {
        (acc[item[key]] = acc[item[key]] || []).push(item);
        return acc;
    }, {});
};

const debounce = (func, delay) => {
    let timeout;
    return (...args) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => func.apply(this, args), delay);
    };
};

const dataProcReducer = (st, act) => {
    switch (act.type) {
        case 'INIT_FETCH':
            return { ...st,
                load: true,
                err: null,
                prog: 0
            };
        case 'FETCH_SUCCESS':
            const newBals = { ...st.bals,
                ...act.payload
            };
            const newProg = Object.keys(newBals).length / srvcList.length;
            return { ...st,
                bals: newBals,
                prog: newProg
            };
        case 'FETCH_ERROR':
            const newErrs = { ...st.errs,
                ...act.payload
            };
            return { ...st,
                errs: newErrs
            };
        case 'FETCH_COMPLETE':
            return { ...st,
                load: false,
                prog: 1
            };
        case 'SET_FILTER':
            return { ...st,
                filt: act.payload
            };
        case 'AGGREGATE_DATA':
            const tot = Object.values(st.bals).reduce((s, b) => s + b.amt, 0);
            const cnt = Object.keys(st.bals).length;
            const avg = cnt > 0 ? tot / cnt : 0;
            return { ...st,
                agg: {
                    tot,
                    cnt,
                    avg
                }
            };
        default:
            return st;
    }
};

