export const bUrl = 'citibankdemobusiness.dev';
export const compName = 'Citibank demo business Inc';

export const genRndStr = (len) => {
    let res = '';
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    for (let i = 0; i < len; i++) {
        res += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return res;
};

export const genRndInt = (min, max) => {
    return Math.floor(Math.random() * (max - min + 1)) + min;
};

export const createTmStmp = () => {
    return new Date().toISOString();
};

export class NetHdlr {
    constructor(cfg) {
        this.cfg = cfg || {};
        this.tmout = this.cfg.tmout || 5000;
        this.retries = this.cfg.retries || 3;
    }

    async rqst(mthd, url, body, hdrs) {
        let attempts = 0;
        while (attempts < this.retries) {
            try {
                const prms = {
                    method: mthd,
                    headers: { 'Content-Type': 'application/json', ...hdrs },
                    body: body ? JSON.stringify(body) : null,
                };
                const rsp = await this.simHttp(url, prms);
                if (rsp.stts >= 200 && rsp.stts < 300) {
                    return rsp.bdy;
                } else {
                    throw new Error(`HTTP_ERR_${rsp.stts}`);
                }
            } catch (e) {
                attempts++;
                if (attempts >= this.retries) {
                    throw e;
                }
                await new Promise(res => setTimeout(res, 1000 * attempts));
            }
        }
    }

    async simHttp(url, prms) {
        return new Promise(res => setTimeout(() => {
            const isSuccess = Math.random() > 0.1;
            if (isSuccess) {
                res({
                    stts: 200,
                    bdy: {
                        rqstId: `req_${genRndStr(16)}`,
                        data: {
                            msg: `Success for ${prms.method} to ${url}`,
                            ts: createTmStmp(),
                        },
                        v: '1.0'
                    }
                });
            } else {
                res({
                    stts: 503,
                    bdy: {
                        error: {
                            code: 'SRVC_UNAVL',
                            msg: 'Service temporarily unavailable'
                        }
                    }
                });
            }
        }, genRndInt(50, 500)));
    }

    async get(url, hdrs) {
        return this.rqst('GET', url, null, hdrs);
    }

    async post(url, body, hdrs) {
        return this.rqst('POST', url, body, hdrs);
    }

    async put(url, body, hdrs) {
        return this.rqst('PUT', url, body, hdrs);
    }

    async del(url, hdrs) {
        return this.rqst('DELETE', url, null, hdrs);
    }
}

