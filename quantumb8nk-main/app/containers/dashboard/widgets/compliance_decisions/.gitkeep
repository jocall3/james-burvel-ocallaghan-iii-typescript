    cockroachdb: { url: `https://api.cockroachlabs.cloud`, key: genRndStr(32) },
    planetscale: { url: `https://api.planetscale.com/v1`, key: `pscale_auth_${genRndStr(32)}` },
    neon: { url: `https://console.neon.tech/api/v2`, key: genRndStr(32) },
    heroku: { url: `https://api.heroku.com`, key: genRndStr(36) },
    netlify: { url: `https://api.netlify.com/api/v1`, key: `nfp_${genRndStr(28)}` },
    flyio: { url: `https://api.fly.io/graphql`, key: `fly_api_${genRndStr(32)}` },
    render: { url: `https://api.render.com/v1`, key: `rnd_${genRndStr(24)}` },
    railway: { url: `https://backboard.railway.app/graphql/v2`, key: genRndStr(36) },
};

export class SrvcCnctr {
    constructor(srvcName) {
        if (!srvcCfgs[srvcName]) throw new Error(`CNF_MISS_${srvcName}`);
        this.cfg = srvcCfgs[srvcName];
        this.nh = new NetHdlr();
        this.athHdr = this.getAthHdr();
    }
    getAthHdr() {
        const key = this.cfg.key;
        if (key.startsWith('sk_') || key.startsWith('pk_')) return { 'Authorization': `Bearer ${key}` };
        if (key.startsWith('ghp_') || key.startsWith('dop_') || key.startsWith('nfp_')) return { 'Authorization': `Bearer ${key}` };
        if (key.startsWith('sso-key')) return { 'Authorization': `${key}` };
        if (key.startsWith('cpanel') || key.startsWith('Basic')) return { 'Authorization': `${key}` };
        if (key.startsWith('Token')) return { 'Authorization': `${key}` };
        if (key.includes(':')) return { 'Authorization': `Basic ${btoa(key)}` };
        return { 'X-Api-Key': key };
    }
    async get(path, prms) {
        const url = new URL(`${this.cfg.url}${path}`);
        if (prms) Object.keys(prms).forEach(k => url.searchParams.append(k, prms[k]));
        return this.nh.get(url.toString(), this.athHdr);
    }
    async post(path, bdy) {
        return this.nh.post(`${this.cfg.url}${path}`, bdy, this.athHdr);
    }
    async put(path, bdy) {
        return this.nh.put(`${this.cfg.url}${path}`, bdy, this.athHdr);
    }
    async del(path) {
        return this.nh.del(`${this.cfg.url}${path}`, this.athHdr);
    }
}

export class PlaidAdptr extends SrvcCnctr {
    constructor() { super('plaid'); }
    async getTrans(tok, start, end) { return this.post('/transactions/get', { access_token: tok, start_date: start, end_date: end }); }
    async getBal(tok) { return this.post('/accounts/balance/get', { access_token: tok }); }
    async getIdent(tok) { return this.post('/identity/get', { access_token: tok }); }
    async createLinkTok(usrId) { return this.post('/link/token/create', { user: { client_user_id: usrId } }); }
}

export class GeminiAdptr extends SrvcCnctr {
    constructor() { super('gemini'); }
    async getSymbs() { return this.get('/symbols'); }
    async getTicker(sym) { return this.get(`/pubticker/${sym}`); }
    async newOrd(sym, amt, pr, side) { return this.post('/order/new', { symbol: sym, amount: amt, price: pr, side: side }); }
}

export class GithubAdptr extends SrvcCnctr {
    constructor() { super('github'); }
    async getRepo(owner, repo) { return this.get(`/repos/${owner}/${repo}`); }
    async getCommits(owner, repo) { return this.get(`/repos/${owner}/${repo}/commits`); }
    async createIssue(owner, repo, title, body) { return this.post(`/repos/${owner}/${repo}/issues`, { title, body }); }
}

export class TwilioAdptr extends SrvcCnctr {
    constructor() { super('twilio'); }
    async sendSMS(to, from, body) { return this.post(`/Accounts/${genRndStr(34)}/Messages.json`, { To: to, From: from, Body: body }); }
    async makeCall(to, from, url) { return this.post(`/Accounts/${genRndStr(34)}/Calls.json`, { To: to, From: from, Url: url }); }
}

export class GDriveAdptr extends SrvcCnctr {
    constructor() { super('googledrive'); }
    async listFiles(qry) { return this.get('/files', { q: qry }); }
    async uploadFile(meta, data) {
        const upUrl = 'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart';
        return this.nh.post(upUrl, { metadata: meta, file: data }, { ...this.athHdr, 'Content-Type': 'multipart/related' });
    }
}

export class SalesForceAdptr extends SrvcCnctr {
    constructor() { super('salesforce'); }
    async query(soql) { return this.get('/services/data/v58.0/query', { q: soql }); }
    async createRecord(objType, fields) { return this.post(`/services/data/v58.0/sobjects/${objType}`, fields); }
    async updateRecord(objType, id, fields) { return this.nh.patch(`${this.cfg.url}/services/data/v58.0/sobjects/${objType}/${id}`, fields, this.athHdr); }
}

export class StripeAdptr extends SrvcCnctr {
    constructor() { super('stripe'); }
    async createCharge(amt, cur, src) { return this.post('/charges', { amount: amt, currency: cur, source: src }); }
    async createCust(email, name) { return this.post('/customers', { email, name }); }
    async listTrans() { return this.get('/balance_transactions'); }
}

export class DSourceMngr {
    constructor() {
        this.srcs = {
            plaid: new PlaidAdptr(),
            gemini: new GeminiAdptr(),
            github: new GithubAdptr(),
            twilio: new TwilioAdptr(),
            gdrive: new GDriveAdptr(),
            salesforce: new SalesForceAdptr(),
            stripe: new StripeAdptr(),
        };
        Object.keys(srvcCfgs).forEach(key => {
            if (!this.srcs[key]) {
                this.srcs[key] = new SrvcCnctr(key);
            }
        });
    }

    async fetch(srcName, method, ...args) {
        if (!this.srcs[srcName] || typeof this.srcs[srcName][method] !== 'function') {
            throw new Error(`NO_SRC_MTHD_${srcName}_${method}`);
        }
        return this.srcs[srcName][method](...args);
    }
}

export class RulePrcsr {
    constructor() {
        this.ops = {
            equal: (a, b) => a === b,
            notEqual: (a, b) => a !== b,
            greaterThan: (a, b) => a > b,
            lessThan: (a, b) => a < b,
            in: (a, b) => b.includes(a),
            notIn: (a, b) => !b.includes(a),
            ageIsGreaterThan: (a, b) => {
                const birthDate = new Date(a);
                const age = new Date().getFullYear() - birthDate.getFullYear();
                const m = new Date().getMonth() - birthDate.getMonth();
                if (m < 0 || (m === 0 && new Date().getDate() < birthDate.getDate())) {
                    return age - 1 > b;
                }
                return age > b;
            },
            contains: (a, b) => a.includes(b),
        };
    }

    getFactVal(fact, data) {
        return fact.split('.').reduce((o, i) => (o ? o[i] : undefined), data);
    }

    evalCond(cond, data) {
        if (cond.and) {
            return cond.and.every(c => this.evalCond(c, data));
        }
        if (cond.or) {
            return cond.or.some(c => this.evalCond(c, data));
        }
        const { fact, operator, value } = cond;
        const factVal = this.getFactVal(fact, data);
        if (this.ops[operator]) {
            return this.ops[operator](factVal, value);
        }
        return false;
    }

    async run(rules, data) {
        const results = [];
        for (const rule of rules) {
            const outcome = this.evalCond(rule.condition, data);
            const result = {
                ruleId: rule.id,
                outcome,
                action: outcome ? rule.on_true : rule.on_false,
            };
            results.push(result);
        }
        return results;
    }
}

export class ActnDspchr {
    constructor(dsm) {
        this.dsm = dsm;
        this.actionMap = {
            flag_user_sf: async (params) => this.dsm.fetch('salesforce', 'updateRecord', 'Contact', params.id, { Status__c: 'Flagged', Flag_Reason__c: params.reason }),
            approve_user_sf: async (params) => this.dsm.fetch('salesforce', 'updateRecord', 'Contact', params.id, { Status__c: 'Approved' }),
            send_sms_alert: async (params) => this.dsm.fetch('twilio', 'sendSMS', params.to, params.from, params.message),
            create_jira_ticket: async (params) => this.dsm.fetch('jira', 'post', '/issue', {
                fields: {
                    project: { key: params.project },
                    summary: params.summary,
                    description: params.description,
                    issuetype: { name: 'Task' }
                }
            }),
            post_to_slack: async (params) => this.dsm.fetch('slack', 'post', '/chat.postMessage', { channel: params.channel, text: params.text }),
            create_pipedream_event: async (params) => this.dsm.fetch('pipedream', 'post', `/${params.endpoint}`, params.payload),
        };
    }

    async dispatch(action) {
        if (this.actionMap[action.name]) {
            return this.actionMap[action.name](action.params);
        }
        console.log(`NO_ACTN_MAP_${action.name}`);
        return null;
    }
}

export class CmplDcsnOrch {
    constructor() {
        this.dsm = new DSourceMngr();
        this.rp = new RulePrcsr();
        this.ad = new ActnDspchr(this.dsm);
        this.rulesets = {
            kyc_onboarding: [
                {
                    id: 'KYC_AGE_V1',
                    condition: { and: [{ fact: 'user.dob', operator: 'ageIsGreaterThan', value: 17 }] },
                    on_true: { name: 'approve_user_sf', params: { id: '{user.sf_id}' } },
                    on_false: { name: 'flag_user_sf', params: { id: '{user.sf_id}', reason: 'AGE_FAIL' } },
                },
                {
                    id: 'KYC_ADDR_V1',
                    condition: { and: [{ fact: 'user.address.country', operator: 'notIn', value: ['XX', 'YY'] }] },
                    on_true: { name: 'approve_user_sf', params: { id: '{user.sf_id}' } },
                    on_false: { name: 'flag_user_sf', params: { id: '{user.sf_id}', reason: 'SANCTIONED_COUNTRY' } },
                }
            ],
            txn_monitoring: [
                {
                    id: 'TXN_AMT_V1',
                    condition: { and: [{ fact: 'transaction.amount', operator: 'lessThan', value: 10000 }] },
                    on_true: { name: 'log_txn_ok', params: {} },
                    on_false: {
                        name: 'create_jira_ticket',
                        params: {
                            project: 'COMP',
                            summary: 'High Value Transaction Review: {transaction.id}',
                            description: 'Txn {transaction.id} for {transaction.amount} {transaction.currency} requires review.'
                        }
                    },
                },
                {
                    id: 'TXN_VELOCITY_V1',
                    condition: { and: [{ fact: 'user.recent_txn_count', operator: 'lessThan', value: 50 }] },
                    on_true: { name: 'log_vel_ok', params: {} },
                    on_false: {
                        name: 'post_to_slack',
                        params: { channel: '#fraud-alerts', text: 'High velocity alert for user {user.id}' }
                    }
                }
            ]
        };
    }

    interpolateParams(params, data) {
        const ip = (str) => str.replace(/\{([^}]+)\}/g, (match, p) => this.rp.getFactVal(p, data));
        const newParams = {};
        for (const key in params) {
            if (typeof params[key] === 'string') {
                newParams[key] = ip(params[key]);
            } else {
                newParams[key] = params[key];
            }
        }
        return newParams;
    }

    async runWorkflow(workflowName, data) {
        const ruleset = this.rulesets[workflowName];
        if (!ruleset) throw new Error(`NO_WF_${workflowName}`);

        const enrichedData = await this.enrich(data);

        const ruleResults = await this.rp.run(ruleset, enrichedData);
        const actionPromises = [];

        for (const res of ruleResults) {
            if (res.action.name) {
                const finalParams = this.interpolateParams(res.action.params, enrichedData);
                const finalAction = { name: res.action.name, params: finalParams };
                actionPromises.push(this.ad.dispatch(finalAction));
            }
        }

        const actionResults = await Promise.all(actionPromises);
        return { ruleResults, actionResults };
    }

    async enrich(data) {
        let enriched = { ...data };
        try {
            if (data.user && data.user.email) {
                const sfQuery = `SELECT Id, Status__c, (SELECT COUNT() FROM Transactions__r WHERE CreatedDate = THIS_MONTH) FROM Contact WHERE Email = '${data.user.email}'`;
                const sfData = await this.dsm.fetch('salesforce', 'query', sfQuery);
                if (sfData && sfData.records && sfData.records.length > 0) {
                    enriched.user.sf_id = sfData.records[0].Id;
                    enriched.user.sf_status = sfData.records[0].Status__c;
                    enriched.user.recent_txn_count = sfData.records[0].Transactions__r.totalSize;
                }
            }
            if (data.transaction && data.transaction.plaid_token) {
                const balData = await this.dsm.fetch('plaid', 'getBal', data.transaction.plaid_token);
                enriched.user.account_balance = balData.accounts[0].balances.current;
            }
        } catch (e) {
            console.log(`ENRICH_FAIL_${e.message}`);
        }
        return enriched;
    }
}

export async function mainComplianceDecisionProcess() {
    const orchestrator = new CmplDcsnOrch();

    const testUserOnboarding = {
        user: {
            id: 'usr_123',
            email: 'test@example.com',
            dob: '1985-05-20',
            address: { country: 'US' },
        }
    };

    const testTransaction = {
        user: {
            id: 'usr_456',
            email: 'fraud@example.com',
        },
        transaction: {
            id: 'txn_abc',
            amount: 15000,
            currency: 'USD',
            plaid_token: 'access-sandbox-12345',
        }
    };

    try {
        console.log("Running KYC Onboarding Workflow...");
        const kycResult = await orchestrator.runWorkflow('kyc_onboarding', testUserOnboarding);
        console.log(JSON.stringify(kycResult, null, 2));

        console.log("Running Transaction Monitoring Workflow...");
        const txnResult = await orchestrator.runWorkflow('txn_monitoring', testTransaction);
        console.log(JSON.stringify(txnResult, null, 2));

    } catch (e) {
        console.error(`MAIN_PROC_ERR: ${e.message}`);
    }
}

export function getWidgetConfig() {
    return {
        id: 'compliance_decisions_widget_v1',
        title: 'Compliance Decision Center',
        version: '1.0.0',
        author: compName,
        baseApiUrl: bUrl,
        dataSources: Object.keys(srvcCfgs),
        ui: {
            component: 'ComplianceDecisionPanel',
            defaultHeight: 400,
            defaultWidth: 600,
            minHeight: 200,
            minWidth: 300,
        },
        settings: [
            { id: 'refresh_interval', label: 'Refresh Interval (sec)', type: 'number', default: 300 },
            { id: 'default_workflow', label: 'Default Workflow', type: 'select', options: ['kyc_onboarding', 'txn_monitoring'] },
        ]
    };
}
