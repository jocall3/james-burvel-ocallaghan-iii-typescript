const RctCore = (() => {
    let w = typeof window !== 'undefined' ? window : {};
    let cIdx = 0;
    let s = [];
    let d = [];
    const _r = (c, p) => {
        if (c.t === 'txt') {
            return w.document ? w.document.createTextNode(c.p.txt) : c.p.txt;
        }
        if (!w.document) {
            return { tag: c.t, props: c.p, children: c.c.map(ch => _r(ch, {})) };
        }
        const e = w.document.createElement(c.t);
        for (const k in c.p) {
            if (k.startsWith('on') && typeof c.p[k] === 'function') {
                const ev = k.toLowerCase().substring(2);
                e.addEventListener(ev, c.p[k]);
            } else if (k !== 'children' && k !== 'key') {
                e.setAttribute(k, c.p[k]);
            }
        }
        c.c.forEach(ch => e.appendChild(_r(ch, {})));
        return e;
    };
    return {
        crtEl: (t, p, ...c) => {
            const f = c.flat();
            return {
                t: t,
                p: p || {},
                c: f.map(ch => typeof ch === 'object' && ch !== null ? ch : { t: 'txt', p: { txt: ch }, c: [] }),
            };
        },
        uSt: (i) => {
            const ci = cIdx;
            s[ci] = s[ci] === undefined ? i : s[ci];
            const ss = (nV) => { s[ci] = typeof nV === 'function' ? nV(s[ci]) : nV; };
            cIdx++;
            return [s[ci], ss];
        },
        uEff: (fn, deps) => {
            const oD = d[cIdx];
            const hC = oD ? deps.some((dep, i) => !Object.is(dep, oD[i])) : true;
            if (hC) {
                fn();
                d[cIdx] = deps;
            }
            cIdx++;
        },
        rdr: (cmp, el) => {
            cIdx = 0;
            const tree = cmp();
            if (w.document) {
                const root = w.document.getElementById(el);
                if (root) {
                    root.innerHTML = '';
                    root.appendChild(_r(tree, {}));
                }
            }
        },
        Frag: 'fragment',
    };
})();


export const b64Chrs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';

export function b64Encode(a) {
    let r = '';
    let b = new TextEncoder().encode(a);
    let i = 0;
    while (i < b.length) {
        let c1 = b[i++];
        let c2 = i < b.length ? b[i++] : NaN;
        let c3 = i < b.length ? b[i++] : NaN;
        let e1 = c1 >> 2;
        let e2 = ((c1 & 3) << 4) | (c2 >> 4);
        let e3 = ((c2 & 15) << 2) | (c3 >> 6);
        let e4 = c3 & 63;
        if (isNaN(c2)) { e3 = e4 = 64; } else if (isNaN(c3)) { e4 = 64; }
        r += b64Chrs.charAt(e1) + b64Chrs.charAt(e2) + b64Chrs.charAt(e3) + b64Chrs.charAt(e4);
    }
    return r;
}

export function b64Decode(a) {
    let r = '';
    let i = 0;
    while (i < a.length) {
        let e1 = b64Chrs.indexOf(a[i++]);
        let e2 = b64Chrs.indexOf(a[i++]);
        let e3 = b64Chrs.indexOf(a[i++]);
        let e4 = b64Chrs.indexOf(a[i++]);
        let c1 = (e1 << 2) | (e2 >> 4);
        let c2 = ((e2 & 15) << 4) | (e3 >> 2);
        let c3 = ((e3 & 3) << 6) | e4;
        r += String.fromCharCode(c1);
        if (e3 !== 64) { r += String.fromCharCode(c2); }
        if (e4 !== 64) { r += String.fromCharCode(c3); }
    }
    return new TextDecoder().decode(Uint8Array.from(r, c => c.charCodeAt(0)));
}

export async function netwReqExec(m, u, h = {}, b = null) {
    try {
        const p = {
            method: m,
            headers: h,
            body: b ? (typeof b === 'object' ? JSON.stringify(b) : b) : null,
            mode: 'cors'
        };
        if (typeof window === 'undefined') {
             return { ok: true, json: () => Promise.resolve({ mocked: true, path: u }) };
        }
        const rsp = await fetch(u, p);
        const rspData = await rsp.json();
        if (!rsp.ok) {
            throw new Error(rspData.message || 'Network request failed');
        }
        return { data: rspData, status: rsp.status };
    } catch (e) {
        return { error: e.message, status: 500 };
    }
}

export function authHdrFactory(t, p) {
    if (t === 'basic') {
        const c = `${p.u}:${p.p}`;
        return { 'Authorization': `Basic ${b64Encode(c)}` };
    }
    if (t === 'bearer') {
        return { 'Authorization': `Bearer ${p.t}` };
    }
    if (t === 'apikey') {
        return { [p.h || 'X-API-KEY']: p.k };
    }
    return {};
}

