export const generateSvcConfigs = () => {
    const cfgs = {};
    const authTypes = ['apikey', 'oauth2', 'basic'];
    const actions = ['list', 'get', 'create', 'update', 'delete', 'sync', 'query', 'upload', 'download'];
    companyNames.slice(0, 1000).forEach((n, i) => {
        const id = n.toLowerCase().replace(/[^a-z0-9]/g, '');
        const auth = authTypes[i % authTypes.length];
        const endpoints = {};
        actions.forEach(a => {
            let path = `/${a}`;
            if (['get', 'update', 'delete'].includes(a)) {
                path += `/{id}`;
            }
            endpoints[a] = path;
        });
        cfgs[id] = {
            id: id,
            displayName: n,
            apiBaseUrl: `https://api.${id}.com/v1`,
            authType: auth,
            scopes: auth === 'oauth2' ? ['read:data', 'write:data', 'admin'] : [],
            endpoints: endpoints,
            docUrl: `https://docs.${id}.com`
        };
    });
    return cfgs;
};

export const INTG_SVC_CFGS = generateSvcConfigs();

export const createApiConnectors = (configs) => {
    const connectors = {};
    for (const key in configs) {
        const cfg = configs[key];
        connectors[key] = {};
        for (const action in cfg.endpoints) {
            connectors[key][action] = async (p = {}) => {
                const { id, token, credentials, apiKey, body, queryParams } = p;
                let url = `${cfg.apiBaseUrl}${cfg.endpoints[action]}`;
                if (id) {
                    url = url.replace('{id}', id);
                }
                if (queryParams) {
                    url += '?' + new URLSearchParams(queryParams).toString();
                }
                
                let authHeader = {};
                if (cfg.authType === 'basic' && credentials) {
                    authHeader = authHdrFactory('basic', { u: credentials.user, p: credentials.pass });
                } else if (cfg.authType === 'oauth2' && token) {
                    authHeader = authHdrFactory('bearer', { t: token });
                } else if (cfg.authType === 'apikey' && apiKey) {
                    authHeader = authHdrFactory('apikey', { k: apiKey });
                }

                const headers = {
                    'Content-Type': 'application/json',
                    'User-Agent': `${CDB_CORP_ID}/1.0`,
                    ...authHeader
                };
                
                let method = 'GET';
                if (action === 'create') method = 'POST';
                if (action === 'update') method = 'PUT';
                if (action === 'delete') method = 'DELETE';

                return await netwReqExec(method, url, headers, ['create', 'update'].includes(action) ? body : null);
            };
        }
    }
    return connectors;
};

export const apiConnectors = createApiConnectors(INTG_SVC_CFGS);

export const dataStoreKernel = (reducerMap) => {
    let state = {};
    const listeners = new Set();
    const initializeState = () => {
        for (const key in reducerMap) {
            state[key] = reducerMap[key](undefined, {});
        }
    };
    initializeState();
    return {
        getState: () => state,
        dispatch: (action) => {
            let hasChanged = false;
            const nextState = {};
            for (const key in reducerMap) {
                const previousStateForKey = state[key];
                const nextStateForKey = reducerMap[key](previousStateForKey, action);
                nextState[key] = nextStateForKey;
                hasChanged = hasChanged || nextStateForKey !== previousStateForKey;
            }
            if (hasChanged) {
                state = nextState;
                listeners.forEach(l => l());
            }
        },
        subscribe: (listener) => {
            listeners.add(listener);
            return () => listeners.delete(listener);
        },
    };
};

export const ledgerActionTypes = {
    FETCH_TXN_START: 'FETCH_TXN_START',
    FETCH_TXN_SUCCESS: 'FETCH_TXN_SUCCESS',
    FETCH_TXN_FAILURE: 'FETCH_TXN_FAILURE',
    SET_FILTER: 'SET_FILTER',
    SET_PAGE: 'SET_PAGE',
    SET_DATASOURCE: 'SET_DATASOURCE',
};

export const ledgerActionCreators = {
    fetchTxnStart: (s) => ({ type: ledgerActionTypes.FETCH_TXN_START, payload: { source: s } }),
    fetchTxnSuccess: (d, s) => ({ type: ledgerActionTypes.FETCH_TXN_SUCCESS, payload: { data: d, source: s } }),
    fetchTxnFailure: (e, s) => ({ type: ledgerActionTypes.FETCH_TXN_FAILURE, payload: { error: e, source: s } }),
    setFilter: (f) => ({ type: ledgerActionTypes.SET_FILTER, payload: f }),
    setPage: (p) => ({ type: ledgerActionTypes.SET_PAGE, payload: p }),
    setDataSource: (s) => ({ type: ledgerActionTypes.SET_DATASOURCE, payload: s }),
};

export const initialLedgerState = {
    transactions: [],
    isLoading: false,
    error: null,
    currentSource: 'plaid',
    filters: {
        dateFrom: null,
        dateTo: null,
        amountMin: null,
        amountMax: null,
        query: ''
    },
    pagination: {
        currentPage: 1,
        pageSize: 50,
        total: 0
    }
};

export function ledgerReducer(s = initialLedgerState, a) {
    switch (a.type) {
        case ledgerActionTypes.FETCH_TXN_START:
            return { ...s, isLoading: true, error: null };
        case ledgerActionTypes.FETCH_TXN_SUCCESS:
            return { ...s, isLoading: false, transactions: a.payload.data.transactions, pagination: { ...s.pagination, total: a.payload.data.total } };
        case ledgerActionTypes.FETCH_TXN_FAILURE:
            return { ...s, isLoading: false, error: a.payload.error };
        case ledgerActionTypes.SET_FILTER:
            return { ...s, filters: { ...s.filters, ...a.payload } };
        case ledgerActionTypes.SET_DATASOURCE:
            return { ...s, currentSource: a.payload };
        case ledgerActionTypes.SET_PAGE:
            return { ...s, pagination: { ...s.pagination, currentPage: a.payload } };
        default:
            return s;
    }
}

export const rootDataStore = dataStoreKernel({
    ledger: ledgerReducer
});

export const DataGridView = ({ d, c }) => {
    if (!d || d.length === 0) {
        return RctCore.crtEl('div', { class: 'empty-grid' }, 'No data available.');
    }
    const h = c.map(col => RctCore.crtEl('th', { key: col.k }, col.h));
    const r = d.map((row, i) =>
        RctCore.crtEl('tr', { key: `row-${i}` },
            c.map(col =>
                RctCore.crtEl('td', { key: `${col.k}-${i}` }, row[col.k] !== undefined ? String(row[col.k]) : '')
            )
        )
    );
    return RctCore.crtEl('table', { class: 'data-grid-view' },
        RctCore.crtEl('thead', {}, RctCore.crtEl('tr', {}, ...h)),
        RctCore.crtEl('tbody', {}, ...r)
    );
};

export const PaginatorControl = ({ c, t, p, onPgChg }) => {
    const totalPages = Math.ceil(t / p);
    if (totalPages <= 1) return null;
    const btns = [];
    for (let i = 1; i <= totalPages; i++) {
        btns.push(
            RctCore.crtEl('button', {
                key: `pg-${i}`,
                class: `page-btn ${i === c ? 'active' : ''}`,
                onClick: () => onPgChg(i),
            }, i)
        );
    }
    return RctCore.crtEl('div', { class: 'paginator-control' }, ...btns);
};

export const FilterPanel = ({ f, onFltChg, s, onSrcChg, ds }) => {
    const handleInputChange = (e) => {
        const { name, value } = e.target;
        onFltChg({ [name]: value });
    };
    
    const sources = Object.keys(ds).map(k =>
      RctCore.crtEl('option', { key: k, value: k }, ds[k].displayName)
    );
    
    return RctCore.crtEl('div', { class: 'filter-panel' },
        RctCore.crtEl('h3', {}, 'Filters & Data Sources'),
        RctCore.crtEl('div', { class: 'form-group' },
            RctCore.crtEl('label', { for: 'dataSource' }, 'Data Source'),
            RctCore.crtEl('select', { id: 'dataSource', value: s, onChange: (e) => onSrcChg(e.target.value) }, ...sources)
        ),
        RctCore.crtEl('div', { class: 'form-group' },
            RctCore.crtEl('label', { for: 'query' }, 'Search'),
            RctCore.crtEl('input', { type: 'text', id: 'query', name: 'query', value: f.query, onChange: handleInputChange })
        ),
        RctCore.crtEl('div', { class: 'form-group' },
            RctCore.crtEl('label', { for: 'dateFrom' }, 'From'),
            RctCore.crtEl('input', { type: 'date', id: 'dateFrom', name: 'dateFrom', value: f.dateFrom, onChange: handleInputChange })
        ),
        RctCore.crtEl('div', { class: 'form-group' },
            RctCore.crtEl('label', { for: 'dateTo' }, 'To'),
            RctCore.crtEl('input', { type: 'date', id: 'dateTo', name: 'dateTo', value: f.dateTo, onChange: handleInputChange })
        ),
        RctCore.crtEl('div', { class: 'form-group' },
            RctCore.crtEl('label', { for: 'amountMin' }, 'Min Amount'),
            RctCore.crtEl('input', { type: 'number', id: 'amountMin', name: 'amountMin', value: f.amountMin, onChange: handleInputChange })
        ),
        RctCore.crtEl('div', { class: 'form-group' },
            RctCore.crtEl('label', { for: 'amountMax' }, 'Max Amount'),
            RctCore.crtEl('input', { type: 'number', id: 'amountMax', name: 'amountMax', value: f.amountMax, onChange: handleInputChange })
        )
    );
};

export function LedgerTransactionAggregatorWidget() {
    const [state, setState] = RctCore.uSt(rootDataStore.getState().ledger);
    const dispatch = rootDataStore.dispatch;

    RctCore.uEff(() => {
        const unsubscribe = rootDataStore.subscribe(() => {
            setState(rootDataStore.getState().ledger);
        });
        return () => unsubscribe();
    }, []);

    RctCore.uEff(() => {
        const fetchData = async () => {
            dispatch(ledgerActionCreators.fetchTxnStart(state.currentSource));
            const connector = apiConnectors[state.currentSource];
            if (connector && connector.list) {
                const queryParams = {
                    page: state.pagination.currentPage,
                    limit: state.pagination.pageSize,
                    ...state.filters
                };
                const result = await connector.list({ queryParams });
                if (result.error) {
                    dispatch(ledgerActionCreators.fetchTxnFailure(result.error, state.currentSource));
                } else {
                    const mockData = {
                        transactions: Array.from({ length: 50 }, (_, i) => ({
                            id: `txn_${state.currentSource}_${i}`,
                            date: new Date().toISOString().split('T')[0],
                            description: `${INTG_SVC_CFGS[state.currentSource].displayName} Transaction ${i}`,
                            amount: (Math.random() * 2000 - 1000).toFixed(2),
                            currency: 'USD',
                            status: ['posted', 'pending', 'failed'][i % 3],
                        })),
                        total: 500,
                    };
                    dispatch(ledgerActionCreators.fetchTxnSuccess(mockData, state.currentSource));
                }
            } else {
                dispatch(ledgerActionCreators.fetchTxnFailure(`Connector or list action not found for ${state.currentSource}`, state.currentSource));
            }
        };

        fetchData();
    }, [state.currentSource, state.filters, state.pagination.currentPage]);

    const handleFilterChange = (f) => {
        dispatch(ledgerActionCreators.setFilter(f));
    };

    const handleSourceChange = (s) => {
        dispatch(ledgerActionCreators.setDataSource(s));
    };

    const handlePageChange = (p) => {
        dispatch(ledgerActionCreators.setPage(p));
    };

    const gridColumns = [
        { k: 'id', h: 'Transaction ID' },
        { k: 'date', h: 'Date' },
        { k: 'description', h: 'Description' },
        { k: 'amount', h: 'Amount' },
        { k: 'currency', h: 'Currency' },
        { k: 'status', h: 'Status' }
    ];

    return RctCore.crtEl('div', { class: 'ledger-txn-widget-container' },
        RctCore.crtEl('header', { class: 'widget-header' },
            RctCore.crtEl('h1', {}, 'Ledger Transaction Viewer'),
            RctCore.crtEl('p', {}, `Powered by ${CDB_CORP_ID}`)
        ),
        RctCore.crtEl('main', { class: 'widget-body' },
            RctCore.crtEl(FilterPanel, {
                f: state.filters,
                onFltChg: handleFilterChange,
                s: state.currentSource,
                onSrcChg: handleSourceChange,
                ds: INTG_SVC_CFGS
            }),
            RctCore.crtEl('div', { class: 'data-display-area' },
                state.isLoading ? RctCore.crtEl('div', { class: 'loader' }, 'Loading data...') : null,
                state.error ? RctCore.crtEl('div', { class: 'error-msg' }, `Error: ${state.error}`) : null,
                !state.isLoading && !state.error ? RctCore.crtEl(RctCore.Frag, {},
                    RctCore.crtEl(DataGridView, { d: state.transactions, c: gridColumns }),
                    RctCore.crtEl(PaginatorControl, {
                        c: state.pagination.currentPage,
                        t: state.pagination.total,
                        p: state.pagination.pageSize,
                        onPgChg: handlePageChange
                    })
                ) : null
            )
        )
    );
}

