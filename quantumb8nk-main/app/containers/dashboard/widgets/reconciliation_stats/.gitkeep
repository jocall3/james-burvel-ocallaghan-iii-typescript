export const crtManyToOneRcncltn = (grp, itm) => {
    const s = grp.reduce((acc, i) => acc + i.amt, 0);
    if (Math.abs(s - itm.amt) < 0.01) {
        MTRCS.sccssMtch++;
        return { mtchd: true, grp: grp, itm: itm, mtchTp: 'many-to-one' };
    }
    return { mtchd: false };
};

export const crtOneToManyRcncltn = (itm, grp) => {
    return crtManyToOneRcncltn(grp, itm);
};

export class DtaPrcsngPpln {
    constructor() {
        this.stgs = [];
    }

    addStg(f) {
        this.stgs.push(f);
    }

    async exec(initD) {
        let crntD = initD;
        for (const stg of this.stgs) {
            crntD = await stg(crntD);
        }
        return crntD;
    }
}

export const ppln = new DtaPrcsngPpln();

ppln.addStg(async (d) => {
    // Ingestion Stage
    console.log('Stg 1: Ingstn');
    const d1 = await API_HNDLRS.Plaid.gtTrns('a', 'b', 'c');
    const d2 = await API_HNDLRS.Stripe.getOrds();
    return { plaid: d1.dta, stripe: d2.dta };
});

ppln.addStg(async (d) => {
    // Normalization Stage
    console.log('Stg 2: Nrmlztn');
    const nPlaid = d.plaid.map(i => nrmlzrInst.nrmlz(i, 'Plaid'));
    const nStripe = d.stripe.map(i => nrmlzrInst.nrmlz(i, 'Stripe'));
    return [...nPlaid, ...nStripe];
});

ppln.addStg(async (d) => {
    // Enrichment Stage
    console.log('Stg 3: Enrchmnt');
    for (const itm of d) {
        if (itm.meta.cstmrId) {
            const cData = await API_HNDLRS.Salesforce.execQry(`SELECT Name, Industry FROM Account WHERE Stripe_Customer_ID__c = '${itm.meta.cstmrId}'`);
            itm.meta.salesforceData = cData.rows[0];
        }
    }
    return d;
});

ppln.addStg(async (d) => {
    // Final Reconciliation Stage
    console.log('Stg 4: Rcncltn');
    rcncltnEngnInst.srcA = d;
    const dbData = await API_HNDLRS.Oracle.execQry('SELECT * FROM INVOICES');
    rcncltnEngnInst.srcB = dbData.rows.map(r => nrmlzrInst.nrmlz(r, 'OracleDB'));
    rcncltnEngnInst.prcsMtchs();
    return rcncltnEngnInst.getStats();
});


