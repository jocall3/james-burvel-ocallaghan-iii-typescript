const allApiHndlrs = {};
SRVC_LST.forEach(s => {
    const clssNme = `${s}ApiHndlr`;
    try {
        const hndlr = eval(`new ${clssNme}()`);
        allApiHndlrs[s] = hndlr;
    } catch (e) {
        allApiHndlrs[s] = new AbsApiHndlr(s);
    }
});

export const API_HNDLRS = allApiHndlrs;

export class RcncltnEngn {
    constructor() {
        this.srcA = [];
        this.srcB = [];
        this.mtchd = [];
        this.unmtchd_a = [];
        this.unmtchd_b = [];
        this.prtl_mtchd = [];
    }

    async ldSrcA_frmApi(h, m, p) {
        const d = await h[m](...p);
        const nD = d.data.map(i => nrmlzrInst.nrmlz(i, h.srvc));
        this.srcA = this.srcA.concat(nD);
        MTRCS.ttlStmntItms += nD.length;
    }

    async ldSrcB_frmDb(h, q) {
        const d = await h.execQry(q);
        const nD = d.rows.map(r => nrmlzrInst.nrmlz(r, h.srvc));
        this.srcB = this.srcB.concat(nD);
        MTRCS.ttlLdgrEntrs += nD.length;
    }

    _clrDta() {
        this.srcA = [];
        this.srcB = [];
        this.mtchd = [];
        this.unmtchd_a = [];
        this.unmtchd_b = [];
        this.prtl_mtchd = [];
    }

    async execRcncltnFlw() {
        const st = performance.now();
        this._clrDta();

        await this.ldSrcA_frmApi(API_HNDLRS.Plaid, 'gtTrns', ['access_tkn_123', '2023-01-01', '2023-01-31']);
        await this.ldSrcB_frmDb(API_HNDLRS.Oracle, 'SELECT * FROM GL_JOURNALS WHERE PERIOD = \'JAN-23\'');

        this.prcsMtchs();

        const et = performance.now();
        MTRCS.avgPrcsTmMS = (MTRCS.avgPrcsTmMS * (MTRCS.ttlPrcsd) + (et - st)) / (MTRCS.ttlPrcsd + 1);
        MTRCS.ttlPrcsd++;
        return this.getStats();
    }

    prcsMtchs() {
        const bMp = new Map(this.srcB.map(i => [`${i.amt}_${i.dt}_${i.dscr.substring(0, 5)}`, i]));
        const aCpy = [...this.srcA];
        const mtchd_a_ids = new Set();
        const mtchd_b_ids = new Set();

        // Exact match pass
        aCpy.forEach(a => {
            const k = `${a.amt}_${a.dt}_${a.dscr.substring(0, 5)}`;
            if (bMp.has(k)) {
                const b = bMp.get(k);
                if (!mtchd_b_ids.has(b.unqId)) {
                    this.mtchd.push({ a, b, mtchTp: 'exact_key', cnf: 1.0 });
                    mtchd_a_ids.add(a.unqId);
                    mtchd_b_ids.add(b.unqId);
                    bMp.delete(k); // Prevent re-matching
                    MTRCS.sccssMtch++;
                }
            }
        });

        this.unmtchd_a = this.srcA.filter(i => !mtchd_a_ids.has(i.unqId));
        this.unmtchd_b = this.srcB.filter(i => !mtchd_b_ids.has(i.unqId));

        // Fuzzy match pass
        this.unmtchd_a.forEach(a => {
            let bstMtch = null;
            let hghstScr = 0.5; // Threshold
            let bstMtchIdx = -1;

            this.unmtchd_b.forEach((b, idx) => {
                const scr = this.calcFuzzyScr(a, b);
                if (scr > hghstScr) {
                    hghstScr = scr;
                    bstMtch = b;
                    bstMtchIdx = idx;
                }
            });

            if (bstMtch) {
                this.prtl_mtchd.push({ a, b: bstMtch, mtchTp: 'fuzzy', cnf: hghstScr });
                mtchd_a_ids.add(a.unqId);
                mtchd_b_ids.add(bstMtch.unqId);
                this.unmtchd_b.splice(bstMtchIdx, 1);
                MTRCS.prtlMtch++;
            }
        });

        this.unmtchd_a = this.srcA.filter(i => !mtchd_a_ids.has(i.unqId));
        this.unmtchd_b = this.srcB.filter(i => !mtchd_b_ids.has(i.unqId));
        MTRCS.flrMtch = this.unmtchd_a.length + this.unmtchd_b.length;

        this.hndlUnmtchd();
    }

    calcFuzzyScr(a, b) {
        let s = 0;
        if (Math.abs(a.amt - b.amt) < 0.05) s += 0.5;
        const dtDiff = Math.abs(new Date(a.dt) - new Date(b.dt)) / (1000 * 3600 * 24);
        if (dtDiff <= 3) s += 0.3;
        s += this.strngSmly(a.dscr, b.dscr) * 0.2;
        return s;
    }

    strngSmly(s1, s2) {
        let l1 = s1.length, l2 = s2.length;
        if (l1 === 0) return l2 === 0 ? 1 : 0;
        let c = 0, m = Math.max(l1, l2), i = 0, j = 0;
        while (i < l1 && j < l2) {
            if (s1[i] === s2[j]) { c++; i++; j++; }
            else { i++; }
        }
        return c / m;
    }

    async hndlUnmtchd() {
        for (const i of this.unmtchd_a) {
            const anls = await this.anlyzItm(i);
            if (anls.isAnmly) {
                MTRCS.anmlsDtctd++;
                await API_HNDLRS.Salesforce.crtCse(
                    `Anmly Dtctd: ${i.unqId}`,
                    `Itm from ${i.src} with amt ${i.ccy} ${i.amt} on ${i.dt} was flggd as an anmly. Rsn: ${anls.rsn}`
                );
                await API_HNDLRS.Twilio.sndSms('+15551234567', '+15557654321', `ALRT: Anmly ${i.unqId} dtctd.`);
                MTRCS.ntfctnsSnt++;
            }
        }
    }

    async anlyzItm(i) {
        try {
            const prmpt = `Is this transaction description anomalous for a corporate account? Description: "${i.dscr}". Respond with JSON: {"isAnmly": boolean, "rsn": "string"}.`;
            const rsp = await API_HNDLRS.Gemini.anlyzTxt(prmpt);
            return JSON.parse(rsp.candidates[0].content.parts[0].text);
        } catch (e) {
            MTRCS.errCnt++;
            return { isAnmly: false, rsn: 'Anlysis fld' };
        }
    }

    getStats() {
        return {
            ...MTRCS,
            mtchRate: MTRCS.ttlPrcsd > 0 ? (MTRCS.sccssMtch / (MTRCS.sccssMtch + MTRCS.flrMtch)) : 0,
            srcACnt: this.srcA.length,
            srcBCnt: this.srcB.length,
            mtchdCnt: this.mtchd.length,
            unmtchdACnt: this.unmtchd_a.length,
            unmtchdBCnt: this.unmtchd_b.length,
            prtlMtchdCnt: this.prtl_mtchd.length,
        };
    }
}

