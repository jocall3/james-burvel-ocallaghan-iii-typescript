export class CfgMgr {
    constructor() {
        this.cnfg = new Map();
        SRVC_LST.forEach(s => {
            this.cnfg.set(s, {
                apiK: `pk_live_${genPseudoRandHexStr(32)}`,
                apiS: `sk_live_${genPseudoRandHexStr(48)}`,
                endpt: `https://${s.toLowerCase()}.citibankdemobusiness.dev/api`,
                enbl: Math.random() > 0.5,
                tmout: 5000,
            });
        });
    }

    getSrvcCfg(s) {
        if (!this.cnfg.has(s)) {
            throw new Error(`Cnfg fr srvc ${s} nt fnd.`);
        }
        return this.cnfg.get(s);
    }

    updtSrvcCfg(s, u) {
        if (!this.cnfg.has(s)) {
            throw new Error(`Cnfg fr srvc ${s} nt fnd.`);
        }
        const c = this.cnfg.get(s);
        this.cnfg.set(s, { ...c, ...u });
    }
}

export const cfgMgrInst = new CfgMgr();

export class AbsApiHndlr {
    constructor(srvc) {
        this.srvc = srvc;
        this.cfg = cfgMgrInst.getSrvcCfg(srvc);
        this.bHdrs = {
            'Authorization': `Bearer ${this.cfg.apiK}`,
            'Content-Type': 'application/json',
            'User-Agent': `${GLBL_CNFG_OBJ.cmpNme}/${GLBL_CNFG_OBJ.vrsn}`,
        };
    }

    async mkRqst(m, p, b) {
        if (!this.cfg.enbl) return { srvc: this.srvc, stts: 'disabled' };
        MTRCS.apiClsMd++;
        const u = `${this.cfg.endpt}${p}`;
        try {
            const rsp = await mockHttpClnt(m, u, this.bHdrs, b);
            return rsp.bdy;
        } catch (e) {
            MTRCS.apiClsFld++;
            MTRCS.errCnt++;
            console.error(`API err for ${this.srvc}: ${e.bdy.err.msg}`);
            throw e;
        }
    }
}

