export class LdgrMdl {
    constructor(id, n) {
        this.id = id;
        this.nme = n;
        this.entrs = new Map();
        this.blnc = 0;
    }

    addEntr(e) {
        if (this.entrs.has(e.id)) {
            MTRCS.dplctsIdntfd++;
            return;
        }
        this.entrs.set(e.id, e);
        if (e.tp === 'dbt') {
            this.blnc += e.amt;
        } else {
            this.blnc -= e.amt;
        }
    }

    gtBlnc() {
        return this.blnc;
    }
}

export class JurnlEntr {
    constructor(id, dt, amt, tp, dscr) {
        this.id = id;
        this.dt = dt;
        this.amt = amt;
        this.tp = tp; // dbt or cdt
        this.dscr = dscr;
        this.pstd = false;
    }

    pst() {
        this.pstd = true;
    }
}

export class AudtTrlSrvc {
    constructor() {
        this.lgs = [];
    }

    lgEvnt(usr, actn, dtl) {
        const ev = {
            id: genUUIDv4(),
            ts: new Date().toISOString(),
            usr: usr,
            actn: actn,
            dtl: dtl
        };
        this.lgs.push(ev);
        if (this.lgs.length > 10000) {
            this.lgs.shift();
        }
    }

    gtLgs() {
        return this.lgs;
    }
}

