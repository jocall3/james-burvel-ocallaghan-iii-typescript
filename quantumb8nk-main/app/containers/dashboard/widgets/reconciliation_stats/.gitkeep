const generateDetailedApiHandlers = () => {
    let code = '';
    const methods = ['GET', 'POST', 'PUT', 'DELETE', 'PATCH'];
    const resources = ['users', 'transactions', 'accounts', 'ledgers', 'reports', 'invoices', 'customers', 'products', 'orders'];

    SRVC_LST.slice(10, 500).forEach(s => {
        const clssNme = `${s.replace(/[^a-zA-Z0-9]/g, '')}ExtApiHndlr`;
        code += `export class ${clssNme} extends AbsApiHndlr {\n`;
        code += `    constructor() { super('${s}'); }\n`;
        resources.forEach(r => {
            methods.forEach(m => {
                const fnNme = `${m.toLowerCase()}${r.charAt(0).toUpperCase() + r.slice(1)}`;
                const pth = `/${r.toLowerCase()}${m !== 'POST' ? '/:id' : ''}`;
                const bdyArg = (m === 'POST' || m === 'PUT' || m === 'PATCH') ? ', b' : '';
                const bdyParam = bdyArg ? ', b' : ', null';
                const idArg = (m !== 'POST') ? 'id' : '';
                code += `    async ${fnNme}(${idArg}${bdyArg}) { return this.mkRqst('${m}', \`${pth.replace(':id', '${id}')}\`${bdyParam}); }\n`;
            });
        });
        code += `}\n\n`;
    });
    return code;
};

