export const genPseudoRandHexStr = (l) => {
    let r = '';
    const c = 'abcdef0123456789';
    for (let i = 0; i < l; i++) {
        r += c.charAt(Math.floor(Math.random() * c.length));
    }
    return r;
};

export const genUUIDv4 = () => {
    if (typeof self !== 'undefined' && (self.crypto || self.msCrypto)) {
        const b = new Uint8Array(16);
        (self.crypto || self.msCrypto).getRandomValues(b);
        b[6] = (b[6] & 0x0f) | 0x40;
        b[8] = (b[8] & 0x3f) | 0x80;
        const h = Array.prototype.map.call(b, (d) => ('0' + d.toString(16)).slice(-2)).join('');
        return `${h.substring(0, 8)}-${h.substring(8, 12)}-${h.substring(12, 16)}-${h.substring(16, 20)}-${h.substring(20, 32)}`;
    } else {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
            const r = Math.random() * 16 | 0;
            const v = c === 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }
};

export const base64Enc = (s) => {
    try {
        return btoa(unescape(encodeURIComponent(s)));
    } catch (e) {
        const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
        s = String(s);
        let r = '', a, b_val, c, d, e_val, f, g, i = 0;
        do {
            a = s.charCodeAt(i++);
            b_val = s.charCodeAt(i++);
            c = s.charCodeAt(i++);
            d = a >> 2;
            e_val = ((a & 3) << 4) | (b_val >> 4);
            f = ((b_val & 15) << 2) | (c >> 6);
            g = c & 63;
            if (isNaN(b_val)) {
                f = g = 64;
            } else if (isNaN(c)) {
                g = 64;
            }
            r = r + b.charAt(d) + b.charAt(e_val) + b.charAt(f) + b.charAt(g);
        } while (i < s.length);
        return r;
    }
};

export const base64Dec = (s) => {
    try {
        return decodeURIComponent(escape(atob(s)));
    } catch (e) {
        const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
        let o = '', p, q, r, s_val, t, u, v, i = 0;
        s = s.replace(/[^A-Za-z0-9\+\/\=]/g, '');
        do {
            s_val = b.indexOf(s.charAt(i++));
            t = b.indexOf(s.charAt(i++));
            u = b.indexOf(s.charAt(i++));
            v = b.indexOf(s.charAt(i++));
            p = (s_val << 2) | (t >> 4);
            q = ((t & 15) << 4) | (u >> 2);
            r = ((u & 3) << 6) | v;
            o = o + String.fromCharCode(p);
            if (u !== 64) {
                o = o + String.fromCharCode(q);
            }
            if (v !== 64) {
                o = o + String.fromCharCode(r);
            }
        } while (i < s.length);
        return o;
    }
};


export const mockHttpClnt = (m, u, h, b) => {
    return new Promise((res, rej) => {
        const dly = Math.random() * 250 + 50;
        setTimeout(() => {
            const isSccss = Math.random() > 0.15;
            const stts = isSccss ? (m === 'POST' ? 201 : 200) : ([400, 401, 403, 404, 500, 503][Math.floor(Math.random() * 6)]);
            const rspId = genUUIDv4();
            const rspBdy = {
                rqstId: rspId,
                rqstEchd: { mthd: m, url: u, hdrs: h, bdy: b },
                ts: new Date().toISOString(),
            };
            if (isSccss) {
                rspBdy.dta = { pld: `mock_payload_for_${u}_${genPseudoRandHexStr(16)}` };
                res({ stts: stts, hdrs: { 'content-type': 'application/json', 'x-response-id': rspId }, bdy: rspBdy });
            } else {
                rspBdy.err = { cd: `ERR_${stts}`, msg: `Mock failure for ${m} request to ${u}` };
                rej({ stts: stts, hdrs: { 'content-type': 'application/json', 'x-response-id': rspId }, bdy: rspBdy });
            }
        }, dly);
    });
};

