export class DtaNrmlzrMdl {
    constructor() {
        this.nrmlztnSchms = new Map();
    }

    dfnSchm(srcTyp, fldsMp) {
        this.nrmlztnSchms.set(srcTyp, fldsMp);
    }

    nrmlz(d, srcTyp) {
        const schm = this.nrmlztnSchms.get(srcTyp);
        if (!schm) throw new Error(`Nrmlztn schm fr ${srcTyp} nt fnd.`);
        const nrmlzdObj = {
            unqId: genUUIDv4(),
            src: srcTyp,
            origPld: d,
            nrmlzdTs: new Date().toISOString(),
            amt: 0,
            ccy: 'USD',
            dt: new Date().toISOString().split('T')[0],
            dscr: '',
            tp: 'uncategorized',
            meta: {},
        };
        for (const [trgtFld, srcFldFn] of Object.entries(schm)) {
            if (typeof srcFldFn === 'function') {
                nrmlzdObj[trgtFld] = srcFldFn(d);
            } else {
                nrmlzdObj[trgtFld] = this.getNestedVal(d, srcFldFn);
            }
        }
        return nrmlzdObj;
    }

    getNestedVal(obj, pth) {
        return pth.split('.').reduce((o, k) => (o && o[k] !== 'undefined' ? o[k] : undefined), obj);
    }
}

export const nrmlzrInst = new DtaNrmlzrMdl();

