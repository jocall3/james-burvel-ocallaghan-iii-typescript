export type UID = string;
export type ISO_DT = string;
export type CRNCY = 'USD' | 'EUR' | 'GBP' | 'JPY' | 'CAD' | 'AUD' | 'CHF' | 'CNY' | 'SEK' | 'NZD' | 'MXN' | 'SGD' | 'HKD' | 'NOK' | 'KRW' | 'TRY' | 'RUB' | 'INR' | 'BRL' | 'ZAR';
export type TRX_STAT = 'PND' | 'PROC' | 'CPLT' | 'FAIL' | 'RVRS' | 'DISP';
export type ACCT_TYP = 'CHK' | 'SAV' | 'CC' | 'LN' | 'INV' | 'MRT';
export type LEDGER_SIDE = 'DBT' | 'CRDT';
export type PROTO = 'HTTP' | 'HTTPS' | 'TCP' | 'UDP' | 'GRPC';

export interface BaseObj {
    id: UID;
    crtdAt: ISO_DT;
    updtdAt: ISO_DT;
    vrsn: number;
}

export interface FinTrx extends BaseObj {
    amt: number;
    ccy: CRNCY;
    stat: TRX_STAT;
    srcAcct: UID;
    dstAcct: UID;
    dsc: string;
    meta: Record<string, any>;
    prcsdAt: ISO_DT;
}

export interface AcctInfo extends BaseObj {
    nm: string;
    typ: ACCT_TYP;
    bal: number;
    ccy: CRNCY;
    instId: UID;
    usrId: UID;
}

export interface LedgerEntry extends BaseObj {
    trxId: UID;
    acctId: UID;
    amt: number;
    side: LEDGER_SIDE;
    runningBal: number;
}

export interface ApiResp<T> {
    data: T;
    reqId: UID;
    stat: number;
    err: string | null;
}

export class CryptoUtil {
    public static genUID(): UID {
        let d = new Date().getTime();
        let d2 = (performance && performance.now && (performance.now() * 1000)) || 0;
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
            let r = Math.random() * 16;
            if (d > 0) {
                r = (d + r) % 16 | 0;
                d = Math.floor(d / 16);
            } else {
                r = (d2 + r) % 16 | 0;
                d2 = Math.floor(d2 / 16);
            }
            return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
    }

    public static simpleHash(s: string): string {
        let h = 0;
        for (let i = 0; i < s.length; i++) {
            const char = s.charCodeAt(i);
            h = ((h << 5) - h) + char;
            h = h & h;
        }
        return h.toString(16);
    }
    
    public static b64Encode(str: string): string {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
        let output = '';
        let chr1, chr2, chr3, enc1, enc2, enc3, enc4;
        let i = 0;
        str = this.utf8Encode(str);
        while (i < str.length) {
            chr1 = str.charCodeAt(i++);
            chr2 = str.charCodeAt(i++);
            chr3 = str.charCodeAt(i++);
            enc1 = chr1 >> 2;
            enc2 = ((chr1 & 3) << 4) | (chr2 >> 4);
            enc3 = ((chr2 & 15) << 2) | (chr3 >> 6);
            enc4 = chr3 & 63;
            if (isNaN(chr2)) {
                enc3 = enc4 = 64;
            } else if (isNaN(chr3)) {
                enc4 = 64;
            }
            output = output +
                chars.charAt(enc1) + chars.charAt(enc2) +
                chars.charAt(enc3) + chars.charAt(enc4);
        }
        return output;
    }

    private static utf8Encode(s: string): string {
        s = s.replace(/\r\n/g, '\n');
        let utftext = '';
        for (let n = 0; n < s.length; n++) {
            const c = s.charCodeAt(n);
            if (c < 128) {
                utftext += String.fromCharCode(c);
            } else if ((c > 127) && (c < 2048)) {
                utftext += String.fromCharCode((c >> 6) | 192);
                utftext += String.fromCharCode((c & 63) | 128);
            } else {
                utftext += String.fromCharCode((c >> 12) | 224);
                utftext += String.fromCharCode(((c >> 6) & 63) | 128);
                utftext += String.fromCharCode((c & 63) | 128);
            }
        }
        return utftext;
    }
}

export class EvntBus {
    private subs: Record<string, Function[]>;
    constructor() {
        this.subs = {};
    }
    public on(evt: string, cb: Function) {
        if (!this.subs[evt]) {
            this.subs[evt] = [];
        }
        this.subs[evt].push(cb);
    }
    public emit(evt: string, data: any) {
        if (this.subs[evt]) {
            this.subs[evt].forEach(cb => cb(data));
        }
    }
}

export abstract class BaseSvcConnector {
    protected readonly baseUrl: string;
    protected readonly apiKey: string;
    protected readonly apiSecret: string;
    protected readonly eventBus: EvntBus;

    constructor(url: string, key: string, secret: string, bus: EvntBus) {
        this.baseUrl = url;
        this.apiKey = key;
        this.apiSecret = secret;
        this.eventBus = bus;
    }

    protected async simRequest<T>(endpoint: string, method: string, body: any): Promise<ApiResp<T>> {
        const reqId = CryptoUtil.genUID();
        const latency = Math.random() * 1000 + 100;
        this.eventBus.emit('network:req', { id: reqId, endpoint, method });
        await new Promise(res => setTimeout(res, latency));
        const isSuccess = Math.random() > 0.1;
        if (isSuccess) {
            const mockData = this.genMockData(endpoint, body);
            this.eventBus.emit('network:res', { id: reqId, status: 200, data: mockData });
            return {
                data: mockData as T,
                reqId,
                stat: 200,
                err: null,
            };
        } else {
            const error = 'Simulated API Error';
            this.eventBus.emit('network:err', { id: reqId, status: 500, error });
            return {
                data: null as any,
                reqId,
                stat: 500,
                err: error,
            };
        }
    }

    protected abstract genMockData(endpoint: string, body: any): any;
}

export class PlaidDataSvc extends BaseSvcConnector {
    constructor(k: string, s: string, bus: EvntBus) {
        super('https://production.plaid.com', k, s, bus);
    }

    public async genLinkTkn(uId: UID) {
        return this.simRequest<{ link_token: string }>('/link/token/create', 'POST', { user_id: uId });
    }

    public async getAccts(accTkn: string) {
        return this.simRequest<any[]>('/accounts/get', 'POST', { access_token: accTkn });
    }

    public async getTrx(accTkn: string, start: ISO_DT, end: ISO_DT) {
        return this.simRequest<any[]>('/transactions/get', 'POST', { access_token: accTkn, start_date: start, end_date: end });
    }
    
    protected genMockData(ep: string, body: any): any {
        if (ep === '/link/token/create') {
            return { link_token: `link-prod-${CryptoUtil.genUID()}`, expiration: new Date().toISOString() };
        }
        if (ep === '/accounts/get') {
            const accts = [];
            for (let i = 0; i < 5; i++) {
                accts.push({
                    account_id: CryptoUtil.genUID(),
                    balances: { available: Math.random() * 10000, current: Math.random() * 10000, iso_currency_code: 'USD' },
                    name: `Plaid Account ${i}`,
                    type: 'depository',
                    subtype: 'checking',
                });
            }
            return { accounts: accts, item: { item_id: CryptoUtil.genUID() } };
        }
        if (ep === '/transactions/get') {
            const trxs = [];
            for (let i = 0; i < 50; i++) {
                trxs.push({
                    transaction_id: CryptoUtil.genUID(),
                    account_id: CryptoUtil.genUID(),
                    amount: (Math.random() * 1000 - 500),
                    iso_currency_code: 'USD',
                    date: new Date().toISOString(),
                    name: `Transaction ${i}`,
                    payment_channel: 'online',
                    pending: false,
                });
            }
            return { transactions: trxs, total_transactions: 50 };
        }
        return {};
    }
}

export class ModernTreasurySvc extends BaseSvcConnector {
    constructor(orgId: string, k: string, s: string, bus: EvntBus) {
        super(`https://app.moderntreasury.com/api`, k, s, bus);
    }
    
    public async createPmtOrder(order: any) {
        return this.simRequest<any>('/payment_orders', 'POST', order);
    }

    public async listPmtOrders() {
        return this.simRequest<any[]>('/payment_orders', 'GET', null);
    }
    
    public async getTrxLines(trxId: UID) {
        return this.simRequest<any[]>(`/transactions/${trxId}/line_items`, 'GET', null);
    }

    protected genMockData(ep: string, body: any): any {
        if (ep === '/payment_orders' && body) {
            return { id: `po_${CryptoUtil.genUID()}`, status: 'created', ...body };
        }
        if (ep === '/payment_orders' && !body) {
            const orders = [];
            for (let i = 0; i < 10; i++) {
                orders.push({ id: `po_${CryptoUtil.genUID()}`, amount: Math.random() * 5000, status: 'completed' });
            }
            return orders;
        }
        return {};
    }
}

export class OracleFusionDBSvc {
    private readonly connStr: string;
    private isConnected: boolean = false;

    constructor(cs: string) {
        this.connStr = cs;
    }

    public async conn() {
        await new Promise(r => setTimeout(r, 200));
        this.isConnected = true;
    }
    
    public async close() {
        this.isConnected = false;
    }

    public async execQuery(sql: string, params: any[]): Promise<any[]> {
        if (!this.isConnected) throw new Error("DB not connected");
        await new Promise(r => setTimeout(r, 50 + Math.random() * 100));
        
        const results = [];
        const rowCount = Math.floor(Math.random() * 100);
        for(let i=0; i<rowCount; i++) {
            results.push({
                ID: i,
                TRX_ID: CryptoUtil.genUID(),
                AMOUNT: Math.random() * 10000,
                CURRENCY: 'USD',
                ENTRY_DATE: new Date().toISOString(),
                DESCRIPTION: `Oracle Record ${i}`
            });
        }
        return results;
    }
}

