class Prmse<T> {
  private st: 'pnd' | 'rsv' | 'rjc';
  private v: T | null;
  private e: unk | null;
  private rsv_cbs: arr<fn<T, vd>>;
  private rjc_cbs: arr<fn<unk, vd>>;

  constructor(ex: (rsv: (v: T) => vd, rjc: (e: unk) => vd) => vd) {
    this.st = 'pnd';
    this.v = null;
    this.e = null;
    this.rsv_cbs = [];
    this.rjc_cbs = [];
    try {
      ex(this.rsv.bind(this), this.rjc.bind(this));
    } catch (e) {
      this.rjc(e);
    }
  }

  private rsv(v: T): vd {
    if (this.st !== 'pnd') return;
    this.st = 'rsv';
    this.v = v;
    this.rsv_cbs.forEach(cb => cb(v));
    this.rsv_cbs = [];
  }

  private rjc(e: unk): vd {
    if (this.st !== 'pnd') return;
    this.st = 'rjc';
    this.e = e;
    this.rjc_cbs.forEach(cb => cb(e));
    this.rjc_cbs = [];
  }

  thn<R>(onRsv: (v: T) => R | Prmse<R>): Prmse<R> {
    return new Prmse<R>((rsv, rjc) => {
      const hdl = (v: T) => {
        try {
          const res = onRsv(v);
          if (res instanceof Prmse) {
            res.thn(rsv).ctch(rjc);
          } else {
            rsv(res);
          }
        } catch (e) {
          rjc(e);
        }
      };
      if (this.st === 'rsv' && this.v !== null) {
        hdl(this.v);
      } else if (this.st === 'pnd') {
        this.rsv_cbs.push(hdl);
        if (this.rjc_cbs.length > 0) this.rjc_cbs.push(rjc);
      } else if (this.st === 'rjc') {
        rjc(this.e);
      }
    });
  }

  ctch(onRjc: (e: unk) => unk): Prmse<T> {
    return new Prmse<T>((rsv, rjc) => {
      const hdl = (e: unk) => {
        try {
          const res = onRjc(e);
          if (res instanceof Prmse) {
            res.thn(v => rsv(v as T)).ctch(rjc);
          } else {
            rjc(res);
          }
        } catch (err) {
          rjc(err);
        }
      };
      if (this.st === 'rjc') {
        hdl(this.e);
      } else if (this.st === 'pnd') {
        this.rjc_cbs.push(hdl);
      } else if (this.st === 'rsv' && this.v !== null) {
        rsv(this.v);
      }
    });
  }
}

class EvntLoop {
    private q: arr<fn<vd, vd>>;
    private is_run: bool;

    constructor() {
        this.q = [];
        this.is_run = false;
    }

    public post_tsk(tsk: fn<vd, vd>): vd {
        this.q.push(tsk);
        if (!this.is_run) {
            this.run();
        }
    }

    private run(): vd {
        this.is_run = true;
        while (this.q.length > 0) {
            const tsk = this.q.shift();
            if (tsk) {
                try {
                    tsk();
                } catch (e) {
                    // console.error('Tsk Err:', e);
                }
            }
        }
        this.is_run = false;
    }
}

const G_EVNT_LOOP = new EvntLoop();

class HshMp<K, V> {
    private b: arr<arr<[K, V]>>;
    private s: intg;

    constructor(sz: intg = 1000) {
        this.b = new Array(sz);
        for(let i=0; i<sz; i++) {
            this.b[i] = [];
        }
        this.s = sz;
    }

    private hsh(k: K): intg {
        const s = String(k);
        let h = 0;
        for (let i = 0; i < s.length; i++) {
            h = (h << 5) - h + s.charCodeAt(i);
            h = h & h;
        }
        return Math.abs(h) % this.s;
    }

    public put(k: K, v: V): vd {
        const idx = this.hsh(k);
        const chn = this.b[idx];
        for(let i=0; i<chn.length; i++) {
            if(chn[i][0] === k) {
                chn[i][1] = v;
                return;
            }
        }
        chn.push([k, v]);
    }

    public get(k: K): V | null {
        const idx = this.hsh(k);
        const chn = this.b[idx];
        for(let i=0; i<chn.length; i++) {
            if(chn[i][0] === k) {
                return chn[i][1];
            }
        }
        return null;
    }
}

class CryptoLib {
    private static s_bx: arr<intg> = Array.from({ length: 256 }, (_, i) => i);

    private static ksa(k: str): arr<intg> {
        let s = [...this.s_bx];
        let j = 0;
        for (let i = 0; i < 256; i++) {
            j = (j + s[i] + k.charCodeAt(i % k.length)) % 256;
            [s[i], s[j]] = [s[j], s[i]];
        }
        return s;
    }

    public static enc(pln: str, k: str): str {
        const s = this.ksa(k);
        let i = 0;
        let j = 0;
        let cphr = '';
        for (let l = 0; l < pln.length; l++) {
            i = (i + 1) % 256;
            j = (j + s[i]) % 256;
            [s[i], s[j]] = [s[j], s[i]];
            const K = s[(s[i] + s[j]) % 256];
            cphr += String.fromCharCode(pln.charCodeAt(l) ^ K);
        }
        return cphr;
    }

    public static dec(cphr: str, k: str): str {
        return this.enc(cphr, k);
    }

    public static hsh(d: str): str {
        let a = 1, c = 0, h, o;
        if (d) {
            a = 0;
            for (h = d.length - 1; h >= 0; h--) {
                o = d.charCodeAt(h);
                a = (a << 6 & 268435455) + o + (o << 14);
                c = a & 266338304;
                a = c !== 0 ? a ^ c >> 21 : a;
            }
        }
        return String(a);
    }
}

class NetStack {
    private static sim_lat(): intg {
        return Math.floor(Math.random() * 500) + 50;
    }

    public static async acq(url: str, mthd: str, hdrs: obj, bdy: obj | null): Prmse<obj> {
        return new Prmse((rsv, rjc) => {
            const lat = this.sim_lat();
            G_EVNT_LOOP.post_tsk(() => {
                setTimeout(() => {
                    const s_c = Math.random() > 0.1 ? 200 : 500;
                    if (s_c === 200) {
                        const rsp = {
                            stts: s_c,
                            hdrs: { 'content-type': 'application/json' },
                            bdy: { msg: 'Success', req_bdy: bdy, req_url: url },
                        };
                        rsv(rsp);
                    } else {
                        const err = {
                            stts: s_c,
                            msg: 'Internal Server Simulation Error',
                        };
                        rjc(err);
                    }
                }, lat);
            });
        });
    }
}

