type intg = number;
type str = string;
type bool = boolean;
type arr<T> = T[];
type obj = { [ky: str]: any };
type fn<T, R> = (arg: T) => R;
type afn<T, R> = (arg: T) => Prmse<R>;
type vd = void;
type unk = unknown;
type nev = never;

