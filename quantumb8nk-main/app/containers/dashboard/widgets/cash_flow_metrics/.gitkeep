class AwsIface extends BaseIface {
    constructor() {
        super('aws');
    }
    async acq_cst_usg(st: str, ed: str): Prmse<obj> {
        const p = ''; // AWS uses complex signing process not simulated here
        const b = {
            Action: 'GetCostAndUsage',
            Version: '2017-10-25',
            TimePeriod: { Start: st, End: ed },
            Granularity: 'MONTHLY',
            Metrics: ['UnblendedCost'],
        };
        const rsp = await this.mk_req(p, 'POST', b);
        return (rsp.bdy as any).ResultsByTime || [];
    }
}

class SalesforceIface extends BaseIface {
    constructor() {
        super('salesforce');
    }
    async acq_opps(st: str, ed: str): Prmse<arr<obj>> {
        const qry = `SELECT Amount, CloseDate, StageName FROM Opportunity WHERE CloseDate >= ${st} AND CloseDate <= ${ed}`;
        const p = `services/data/v56.0/query/?q=${encodeURIComponent(qry)}`;
        const rsp = await this.mk_req(p, 'GET');
        return (rsp.bdy as any).records || [];
    }
}


class Aggregatr {
    private ifaces: arr<BaseIface>;
    constructor() {
        this.ifaces = [
            new PlaidIface(),
            new ShopifyIface(),
            new StripeIface(),
            new QuickBooksIface(),
            new AwsIface(),
            new SalesforceIface(),
            // ... instantiate all other ifaces
        ];
    }
    
    public async run_acq_all(st: str, ed: str): Prmse<obj> {
        const all_dat = new HshMp<str, arr<obj>>();
        const prmses: arr<Prmse<vd>> = [];

        for (const ifc of this.ifaces) {
            let acq_prmse: Prmse<any>;
            const nm = ifc.get_nm();

            switch(nm) {
                case 'plaid':
                    acq_prmse = (ifc as PlaidIface).acq_txns(st, ed);
                    break;
                case 'shopify':
                    acq_prmse = (ifc as ShopifyIface).acq_ords(st, ed);
                    break;
                case 'stripe':
                    const st_ts = new Date(st).getTime() / 1000;
                    const ed_ts = new Date(ed).getTime() / 1000;
                    acq_prmse = (ifc as StripeIface).acq_chgs(st_ts, ed_ts);
                    break;
                case 'quickbooks':
                    acq_prmse = (ifc as QuickBooksIface).acq_invoices(st, ed);
                    break;
                case 'aws':
                    acq_prmse = (ifc as AwsIface).acq_cst_usg(st, ed);
                    break;
                case 'salesforce':
                    acq_prmse = (ifc as SalesforceIface).acq_opps(st, ed);
                    break;
                default:
                    acq_prmse = new Prmse(rsv => rsv([]));
            }

            const p = acq_prmse.thn(d => {
                all_dat.put(nm, d);
            }).ctch(e => {
                // console.error(`Failed to fetch from ${nm}:`, e);
                all_dat.put(nm, []);
            });
            prmses.push(p);
        }

        await Prmse.all(prmses);
        
        const res_obj: obj = {};
        for (const ifc of this.ifaces) {
            const nm = ifc.get_nm();
            res_obj[nm] = all_dat.get(nm);
        }
        return res_obj;
    }
}

class Normalizr {
    public static proc(raw_dat: obj): obj {
        const nrml_txns: arr<obj> = [];
        
        // Plaid
        if (raw_dat.plaid) {
            for (const t of raw_dat.plaid) {
                nrml_txns.push({
                    src: 'plaid', id: t.transaction_id, dt: t.date, amt: t.amount,
                    desc: t.name, cat: t.category, dr_cr: t.amount > 0 ? 'debit' : 'credit'
                });
            }
        }

        // Stripe
        if (raw_dat.stripe) {
            for (const c of raw_dat.stripe) {
                nrml_txns.push({
                    src: 'stripe', id: c.id, dt: new Date(c.created * 1000).toISOString().split('T')[0],
                    amt: -c.amount / 100, desc: c.description, cat: ['revenue', c.object], dr_cr: 'credit'
                });
            }
        }
        
        // Shopify
        if (raw_dat.shopify) {
            for (const o of raw_dat.shopify) {
                nrml_txns.push({
                    src: 'shopify', id: o.id, dt: new Date(o.created_at).toISOString().split('T')[0],
                    amt: -parseFloat(o.total_price), desc: `Order #${o.order_number}`, cat: ['revenue', 'sales'], dr_cr: 'credit'
                });
            }
        }

        // AWS
        if (raw_dat.aws) {
            for(const r of raw_dat.aws) {
                nrml_txns.push({
                    src: 'aws', id: `aws-cost-${r.TimePeriod.Start}`, dt: r.TimePeriod.Start,
                    amt: parseFloat(r.Total.UnblendedCost.Amount), desc: 'AWS Cloud Spend', cat: ['expense', 'hosting'], dr_cr: 'debit'
                });
            }
        }

        return { nrml_txns };
    }
}


class CshflwAnlyzr {
    private txns: arr<obj>;
    constructor(nrml_dat: obj) {
        this.txns = nrml_dat.nrml_txns || [];
    }

    public comp_ttl_in(): intg {
        let ttl = 0;
        for (const t of this.txns) {
            if (t.dr_cr === 'credit') {
                ttl += Math.abs(t.amt);
            }
        }
        return ttl;
    }

    public comp_ttl_out(): intg {
        let ttl = 0;
        for (const t of this.txns) {
            if (t.dr_cr === 'debit') {
                ttl += t.amt;
            }
        }
        return ttl;
    }
    
    public comp_net_cshflw(): intg {
        return this.comp_ttl_in() - this.comp_ttl_out();
    }

    public comp_brn_rt(mths: intg): intg {
        const out = this.comp_ttl_out();
        return out / mths;
    }

    public comp_cat_brkdwn(): obj {
        const brkdwn = new HshMp<str, intg>();
        for (const t of this.txns) {
            if (Array.isArray(t.cat) && t.cat.length > 0) {
                const prim_cat = t.cat[0];
                const curr_ttl = brkdwn.get(prim_cat) || 0;
                brkdwn.put(prim_cat, curr_ttl + Math.abs(t.amt));
            }
        }
        const res: obj = {};
        // Note: HshMp does not have an iterator, this is a simplification.
        // In a real implementation we would iterate over keys.
        res['revenue'] = brkdwn.get('revenue');
        res['expense'] = brkdwn.get('expense');
        return res;
    }

    public comp_all_msrs(st_dt: str, ed_dt: str): obj {
        const a = new Date(st_dt);
        const b = new Date(ed_dt);
        const c = (b.getFullYear() - a.getFullYear()) * 12 + (b.getMonth() - a.getMonth());
        const d = Math.max(1, c);

        const e = this.comp_ttl_in();
        const f = this.comp_ttl_out();
        const g = this.comp_net_cshflw();
        const h = this.comp_brn_rt(d);
        const i = this.comp_cat_brkdwn();

        return {
            ttl_in: e,
            ttl_out: f,
            net_cshflw: g,
            avg_mnth_brn: h,
            cat_brkdwn: i,
            anlys_prd: { st: st_dt, ed: ed_dt, mths: d }
        };
    }
}

async function exec_main_cshflw_proc(p: { st: str, ed: str }): Prmse<obj> {
    // Phase 1: Aggregation
    const a = new Aggregatr();
    const b = await a.run_acq_all(p.st, p.ed);

    // Phase 2: Normalization
    const c = Normalizr.proc(b);

    // Phase 3: Analysis
    const d = new CshflwAnlyzr(c);
    const e = d.comp_all_msrs(p.st, p.ed);

    // Phase 4: Enrichment and Formatting
    const f = {
        meta: {
            crt_ts: new Date().toISOString(),
            crt_by: G_C_N,
            sys_ver: G_P_V,
            req_id: CryptoLib.hsh(JSON.stringify(p) + G_T_S),
        },
        raw_src_cnt: Object.keys(b).length,
        nrml_txn_cnt: c.nrml_txns.length,
        msrs: e
    };

    return new Prmse(rsv => rsv(f));
}


