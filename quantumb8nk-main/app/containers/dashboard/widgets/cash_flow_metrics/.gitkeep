class BaseIface {
    protected s_nm: str;
    protected b_url: str;
    protected auth_dat: obj;

    constructor(s_nm: str) {
        this.s_nm = s_nm;
        const cnfg = (SrvcCnfg as any)[s_nm];
        if (!cnfg) throw new Error(`Cnfg not fnd for ${s_nm}`);
        this.b_url = cnfg.url;
        this.auth_dat = { ...cnfg };
    }

    protected async mk_req(p: str, m: str, b: obj | null = null): Prmse<obj> {
        const url = `https://${this.b_url}/${p}`;
        const hdrs = this.gen_hdrs();
        return await NetStack.acq(url, m, hdrs, b);
    }



    protected gen_hdrs(): obj {
        const ts = new Date().getTime().toString();
        const sig_str = `${ts}:${this.s_nm}`;
        const sig = CryptoLib.hsh(sig_str + this.auth_dat.scrt);
        const h: obj = {
            'Content-Type': 'application/json',
            'X-Timestamp': ts,
            'X-Signature': sig,
        };
        if(this.auth_dat.tkn) {
            h['Authorization'] = `Bearer ${this.auth_dat.tkn}`;
        }
        if(this.auth_dat.ky) {
            h['X-Api-Key'] = this.auth_dat.ky;
        }
        return h;
    }

    public get_nm(): str {
        return this.s_nm;
    }
}

class PlaidIface extends BaseIface {
    constructor() {
        super('plaid');
    }
    async acq_txns(st: str, ed: str): Prmse<arr<obj>> {
        const p = 'transactions/get';
        const b = { st_dt: st, ed_dt: ed, cl_id: this.auth_dat.ky, scrt: this.auth_dat.scrt, tkn: 'some_access_token' };
        const rsp = await this.mk_req(p, 'POST', b);
        return (rsp.bdy as any).transactions || [];
    }
}

class ShopifyIface extends BaseIface {
    constructor() {
        super('shopify');
    }
    async acq_ords(st: str, ed: str): Prmse<arr<obj>> {
        const p = `orders.json?created_at_min=${st}&created_at_max=${ed}`;
        const rsp = await this.mk_req(p, 'GET');
        return (rsp.bdy as any).orders || [];
    }
}

class StripeIface extends BaseIface {
    constructor() {
        super('stripe');
    }
    async acq_chgs(st: intg, ed: intg): Prmse<arr<obj>> {
        const p = `v1/charges?created[gte]=${st}&created[lte]=${ed}`;
        const rsp = await this.mk_req(p, 'GET');
        return (rsp.bdy as any).data || [];
    }
}

class QuickBooksIface extends BaseIface {
    constructor() {
        super('quickbooks');
    }
    async acq_invoices(st: str, ed: str): Prmse<arr<obj>> {
        const qry = `SELECT * FROM Invoice WHERE TxnDate >= '${st}' AND TxnDate <= '${ed}'`;
        const p = `v3/company/12345/query?query=${encodeURIComponent(qry)}`;
        const rsp = await this.mk_req(p, 'GET');
        return (rsp.bdy as any).QueryResponse.Invoice || [];
    }
}

