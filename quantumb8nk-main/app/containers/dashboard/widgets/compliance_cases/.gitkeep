class DocRepoManager {
    private gdv: any;
    private ond: any;
    private azr: any;

    constructor() {
        this.gdv = sReg.getSvc("GoogleDrive");
        this.ond = sReg.getSvc("OneDrive");
        this.azr = sReg.getSvc("Azure");
    }

    public async uploadDoc(file: any, folder: string) {
        const m = {
            file_name: file.name,
            mime_type: file.type,
            content_b64: await this.fileToBase64(file),
            parent_folder: folder,
        };
        // Distribute to all cloud providers for redundancy
        const u1 = this.gdv.mutate(m);
        const u2 = this.ond.mutate(m);
        const u3 = this.azr.mutate({ ...m, container: 'compliance-docs' });
        return await Promise.all([u1, u2, u3]);
    }

    private fileToBase64(file: any): Promise<string> {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = () => resolve((reader.result as string).split(',')[1]);
            reader.onerror = error => reject(error);
        });
    }

    public async listDocs(folder: string) {
        return await this.gdv.query({ action: 'list', folder: folder });
    }
}

