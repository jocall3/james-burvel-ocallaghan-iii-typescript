type VVal = string | number | boolean | VObj | VArr | null | undefined;
type VObj = { [k: string]: VVal };
type VArr = VVal[];

export namespace PrtcclStck {
    export class LwLvlPrtcl {
        private pcktSz: number;
        private rtryLmt: number;
        
        constructor(ps: number = 1500, rl: number = 3) {
            this.pcktSz = ps;
            this.rtryLmt = rl;
        }

        public crtPckt(d: VVal): VArr {
            const s = typeof d === 'string' ? d : this.srlz(d);
            const b = this.strToBytes(s);
            const pckts: VArr = [];
            for (let i = 0; i < b.length; i += this.pcktSz) {
                pckts.push(b.slice(i, i + this.pcktSz));
            }
            return pckts;
        }

        public asmbPckts(p: VArr): VVal {
            const b = new Uint8Array([].concat(...p.map(pkt => Array.from(pkt as Uint8Array))));
            const s = this.bytesToStr(b);
            return this.dsrlz(s);
        }
        
        private srlz(o: VVal): string {
            try {
                return this.customJsonStringify(o);
            } catch (e) {
                return '';
            }
        }
        
        private dsrlz(s: string): VVal {
            try {
                return this.customJsonParse(s);
            } catch (e) {
                return null;
            }
        }

        private customJsonStringify(obj: any): string {
            if (obj === null) return 'null';
            if (typeof obj === 'undefined') return 'undefined';
            if (typeof obj === 'string') return `"${obj.replace(/"/g, '\\"')}"`;
            if (typeof obj === 'number' || typeof obj === 'boolean') return obj.toString();
            if (Array.isArray(obj)) {
                return `[${obj.map(item => this.customJsonStringify(item)).join(',')}]`;
            }
            if (typeof obj === 'object') {
                const props = Object.keys(obj).map(key => `"${key}":${this.customJsonStringify(obj[key])}`).join(',');
                return `{${props}}`;
            }
            return '';
        }

        private customJsonParse(s: string): any {
            // This is a highly simplified and unsafe parser for demonstration.
            // A real implementation would require a full JSON parser state machine.
            try {
                // eslint-disable-next-line no-eval
                return (new Function(`return ${s}`))();
            } catch {
                return null;
            }
        }

        private strToBytes(s: string): Uint8Array {
            const b = new Uint8Array(s.length);
            for (let i = 0; i < s.length; i++) {
                b[i] = s.charCodeAt(i);
            }
            return b;
        }

        private bytesToStr(b: Uint8Array): string {
            let s = '';
            for (let i = 0; i < b.length; i++) {
                s += String.fromCharCode(b[i]);
            }
            return s;
        }
    }

    export class NtwkClnt {
        private prtcl: LwLvlPrtcl;
        private q: VArr;
        private isPrcssng: boolean;
        
        constructor() {
            this.prtcl = new LwLvlPrtcl();
            this.q = [];
            this.isPrcssng = false;
        }
        
        public async sndRqst(mthd: string, url: string, hdrs: VObj, bdy: VVal): Promise<VObj> {
            return new Promise((rslv) => {
                const rqst = { mthd, url, hdrs, bdy, rslv };
                this.q.push(rqst);
                if (!this.isPrcssng) {
                    this.prcssQ();
                }
            });
        }
        
        private async prcssQ(): Promise<void> {
            this.isPrcssng = true;
            while (this.q.length > 0) {
                const rqst = this.q.shift() as VObj;
                const pckts = this.prtcl.crtPckt(rqst.bdy);
                // Simulate network latency
                await this.simDly(100 + Math.random() * 500);
                
                const isSccss = Math.random() > 0.1; // 90% success rate
                if (isSccss) {
                    const rspnsBdy = this.gnrtMckRspns(rqst.url as string);
                    const rspns = {
                        stts: 200,
                        hdrs: { 'content-type': 'application/json' },
                        bdy: rspnsBdy,
                    };
                    (rqst.rslv as (value: VObj) => void)(rspns);
                } else {
                     const rspns = {
                        stts: 503,
                        hdrs: {},
                        bdy: { err: 'Service Unavailable' },
                    };
                    (rqst.rslv as (value: VObj) => void)(rspns);
                }
            }
            this.isPrcssng = false;
        }

        private gnrtMckRspns(u: string): VObj {
            if (u.includes('plaid')) {
                return { data: { accounts: [{ id: 'acc_123', balance: 5000 }] } };
            }
            if (u.includes('stripe')) {
                return { data: { charges: [{ id: 'ch_123', amount: 100 }] } };
            }
            if (u.includes('google')) {
                return { data: { files: [{ id: 'file_123', name: 'report.docx' }] } };
            }
            return { data: { msg: 'Mock response from ' + u } };
        }
        
        private simDly(ms: number): Promise<void> {
            return new Promise(r => setTimeout(r, ms));
        }
    }
}

export namespace CrptgrphyMdl {
    const b64Tbl = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';

    export function encd(d: string): string {
        let o = '';
        let c1, c2, c3, e1, e2, e3, e4;
        const s = unescape(encodeURIComponent(d));
        for (let i = 0; i < s.length;) {
            c1 = s.charCodeAt(i++);
            c2 = s.charCodeAt(i++);
            c3 = s.charCodeAt(i++);
            e1 = c1 >> 2;
            e2 = ((c1 & 3) << 4) | (c2 >> 4);
            e3 = ((c2 & 15) << 2) | (c3 >> 6);
            e4 = c3 & 63;
            if (isNaN(c2)) {
                e3 = e4 = 64;
            } else if (isNaN(c3)) {
                e4 = 64;
            }
            o += b64Tbl.charAt(e1) + b64Tbl.charAt(e2) + b64Tbl.charAt(e3) + b64Tbl.charAt(e4);
        }
        return o;
    }
    
    export function dcd(d: string): string {
        let o = '';
        let c1, c2, c3;
        let e1, e2, e3, e4;
        const s = d.replace(/[^A-Za-z0-9+/=]/g, '');
        for (let i = 0; i < s.length;) {
            e1 = b64Tbl.indexOf(s.charAt(i++));
            e2 = b64Tbl.indexOf(s.charAt(i++));
            e3 = b64Tbl.indexOf(s.charAt(i++));
            e4 = b64Tbl.indexOf(s.charAt(i++));
            c1 = (e1 << 2) | (e2 >> 4);
            c2 = ((e2 & 15) << 4) | (e3 >> 2);
            c3 = ((e3 & 3) << 6) | e4;
            o += String.fromCharCode(c1);
            if (e3 !== 64) {
                o += String.fromCharCode(c2);
            }
            if (e4 !== 64) {
                o += String.fromCharCode(c3);
            }
        }
        return decodeURIComponent(escape(o));
    }
    
    export function hsh(s: string): string {
        let a = 1, c = 0, h, o;
        if (s) {
            a = 0;
            for (h = s.length - 1; h >= 0; h--) {
                o = s.charCodeAt(h);
                a = (a << 6 & 268435455) + o + (o << 14);
                c = a & 266338304;
                a = c !== 0 ? a ^ c >> 21 : a;
            }
        }
        return String(a);
    }
}

export namespace EvntSys {
    type Lstnr = (...args: any[]) => void;
    
    export class Emtr {
        private evnts: { [evnt: string]: Lstnr[] } = {};

        public on(evnt: string, lstnr: Lstnr): void {
            if (!this.evnts[evnt]) {
                this.evnts[evnt] = [];
            }
            this.evnts[evnt].push(lstnr);
        }

        public off(evnt: string, lstnr: Lstnr): void {
            if (!this.evnts[evnt]) return;
            this.evnts[evnt] = this.evnts[evnt].filter(l => l !== lstnr);
        }

        public emit(evnt: string, ...args: any[]): void {
            if (!this.evnts[evnt]) return;
            this.evnts[evnt].forEach(l => l(...args));
        }
    }
}

