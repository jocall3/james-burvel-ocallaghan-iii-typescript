export abstract class SrvcIntgrtr {
    protected clnt: PrtcclStck.NtwkClnt;
    protected c: VObj;
    protected tk: string | null = null;
    
    constructor(srvc_nm: string, auth_tk: string | null) {
        this.clnt = new PrtcclStck.NtwkClnt();
        this.c = (GlblCnfg.SRVC_MAP as any)[srvc_nm] || {};
        this.tk = auth_tk;
    }
    
    protected async gt(p: string, prms: VObj = {}): Promise<VObj> {
        const h = this.bldHdrs();
        const u = this.bldUrl(p, prms);
        return this.clnt.sndRqst('GET', u, h, null);
    }
    
    protected async pst(p: string, b: VVal): Promise<VObj> {
        const h = this.bldHdrs();
        const u = this.bldUrl(p);
        return this.clnt.sndRqst('POST', u, h, b);
    }
    
    protected bldHdrs(): VObj {
        const h: VObj = { 'Content-Type': 'application/json' };
        if (this.tk) {
            h['Authorization'] = `Bearer ${this.tk}`;
        }
        return h;
    }
    
    protected bldUrl(p: string, prms?: VObj): string {
        const ep = this.c.ep as string;
        let u = `${ep}${p}`;
        if (prms) {
            const q = Object.entries(prms).map(([k,v]) => `${k}=${encodeURIComponent(v as string)}`).join('&');
            if (q) u += `?${q}`;
        }
        return u;
    }
    
    public abstract vldtCnnctn(): Promise<boolean>;
}

export class PlaidIntgrtr extends SrvcIntgrtr {
    constructor(t: string) { super('plaid', t); }
    public async vldtCnnctn(): Promise<boolean> { return (await this.gt('/institutions/get', { institution_id: 'ins_1', country_codes: 'US'})).stts === 200; }
    public async ftchAccts(): Promise<TpDfn.PlaidAcct[]> { return (await this.pst('/accounts/get', {})).bdy as TpDfn.PlaidAcct[]; }
    public async ftchTrnsctns(a_id: string, s_dt: string, e_dt: string): Promise<TpDfn.PlaidTrnsctn[]> { return (await this.pst('/transactions/get', {account_id: a_id, start_date: s_dt, end_date: e_dt})).bdy as TpDfn.PlaidTrnsctn[]; }
    public async ftchBlncs(a_id: string): Promise<any> { return (await this.pst('/accounts/balance/get', {account_id: a_id})).bdy; }
}

