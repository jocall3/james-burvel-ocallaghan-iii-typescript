export namespace WrkflwOrchstrtr {
    export interface CnnctnStts {
        srvc: string;
        is_cnctd: boolean;
        last_chck: number;
    }

    export class CnnctnMngr {
        private stts: CnnctnStts[] = [];
        private intgrtrs: { [key: string]: SrvcIntgrtr } = {};

        public regIntgrtr(nm: string, i: SrvcIntgrtr): void {
            this.intgrtrs[nm] = i;
            this.stts.push({ srvc: nm, is_cnctd: false, last_chck: 0 });
        }

        public async chckAllStts(): Promise<CnnctnStts[]> {
            for (const s of this.stts) {
                const i = this.intgrtrs[s.srvc];
                if (i) {
                    s.is_cnctd = await i.vldtCnnctn();
                    s.last_chck = Date.now();
                }
            }
            return this.stts;
        }
    }

    export async function fnclRccltn(plaid: PlaidIntgrtr, stripe: StripeIntgrtr, shopify: ShopifyIntgrtr) {
        const pl_accts = await plaid.ftchAccts();
        const pl_trns = await plaid.ftchTrnsctns(pl_accts[0].acct_id, '2023-01-01', '2023-01-31');
        const strp_chgs = await stripe.getChrgs();
        const shpfy_ords = await shopify.getOrds();

        const rcncld: VObj[] = [];
        const unrcncld: VObj[] = [];

        for (const ord of shpfy_ords as any[]) {
            const mchng_chg = (strp_chgs as any[]).find(c => parseFloat(c.amount) / 100 === parseFloat(ord.total_price));
            const mchng_trns = (pl_trns as any[]).find(t => t.amount === parseFloat(ord.total_price) && t.name.includes('Shopify'));

            if (mchng_chg && mchng_trns) {
                rcncld.push({ ord, chg: mchng_chg, trns: mchng_trns });
            } else {
                unrcncld.push({ ord });
            }
        }
        return { rcncld, unrcncld };
    }
    
    export async function ldToCash(salesforce: SalesforceIntgrtr, stripe: StripeIntgrtr) {
        const lds = await salesforce.getLds();
        const chgs = await stripe.getChrgs();
        
        const conv_lds: VObj[] = [];
        
        for (const l of lds) {
            if (l.Status === 'Closed - Converted') {
                const mchng_chg = (chgs as any[]).find(c => c.description?.includes(l.Company));
                if (mchng_chg) {
                    conv_lds.push({ l, chg: mchng_chg });
                }
            }
        }
        return conv_lds;
    }
    
    export async function dvlprActvtyRprt(github: GithubIntgrtr, jira: JiraIntgrtr, slack: SlackIntgrtr) {
        const rps = await github.getRps();
        const isss = await jira.getMyOpnIsss();
        
        // This is a dummy example, a real one would be much more complex.
        const msg = `Dev Report: ${rps.length} repos, ${isss.length} open issues.`;
        await slack.pstMsg('dev-reports', msg);
        
        return { repo_cnt: rps.length, issue_cnt: isss.length };
    }
}

export namespace UILgcMdl {
    export interface ChrtPnt {
        x: number | string;
        y: number;
    }
    
    export interface ChrtData {
        lbls: string[];
        dsets: {
            lbl: string;
            d: number[];
            bg_clr: string;
        }[];
    }
    
    export function prprFnclSmryChrt(trns: TpDfn.PlaidTrnsctn[]): ChrtData {
        const d_by_cat: { [key: string]: number } = {};
        trns.forEach(t => {
            const cat = t.ctgry[0] || 'Uncategorized';
            if (!d_by_cat[cat]) d_by_cat[cat] = 0;
            d_by_cat[cat] += t.amt;
        });
        
        const lbls = Object.keys(d_by_cat);
        const d = Object.values(d_by_cat);
        
        return {
            lbls: lbls,
            dsets: [{
                lbl: 'Spending by Category',
                d: d,
                bg_clr: '#4A90E2'
            }]
        };
    }
    
    export function gnrtSVGPath(pnts: ChrtPnt[], w: number, h: number): string {
        if (pnts.length === 0) return '';
        
        const xs = pnts.map(p => p.x as number);
        const ys = pnts.map(p => p.y);
        const x_min = Math.min(...xs);
        const x_max = Math.max(...xs);
        const y_min = Math.min(...ys);
        const y_max = Math.max(...ys);
        
        const sclX = (v: number) => (v - x_min) / (x_max - x_min) * w;
        const sclY = (v: number) => h - (v - y_min) / (y_max - y_min) * h;
        
        let pth = `M ${sclX(pnts[0].x as number)} ${sclY(pnts[0].y)}`;
        for (let i = 1; i < pnts.length; i++) {
            pth += ` L ${sclX(pnts[i].x as number)} ${sclY(pnts[i].y)}`;
        }
        
        return pth;
    }
    
    export function cmlpTbl(hdrs: string[], rws: VArr[]): string {
        let h = '<table><thead><tr>';
        hdrs.forEach(hdr => h += `<th>${hdr}</th>`);
        h += '</tr></thead><tbody>';
        
        rws.forEach(rw => {
            h += '<tr>';
            (rw as any[]).forEach(cell => h += `<td>${cell}</td>`);
            h += '</tr>';
        });
        
        h += '</tbody></table>';
        return h;
    }
}

export class BnkAcctWdgtCntrlr {
    private evnt_emtr: EvntSys.Emtr;
    private cnn_mngr: WrkflwOrchstrtr.CnnctnMngr;
    private st: VObj;

    constructor() {
        this.evnt_emtr = new EvntSys.Emtr();
        this.cnn_mngr = new WrkflwOrchstrtr.CnnctnMngr();
        this.st = { ldng: true, err: null, d: {} };
        this.initAllIntgrtrs();
    }
    
    private initAllIntgrtrs(): void {
        const tkn = CrptgrphyMdl.hsh(`${CDB_CORP_N}-${CDB_LEGAL_ENTITY_ID}`);
        this.cnn_mngr.regIntgrtr('plaid', new PlaidIntgrtr(tkn));
        this.cnn_mngr.regIntgrtr('moderntreasury', new ModTreasuryIntgrtr(tkn));
        this.cnn_mngr.regIntgrtr('github', new GithubIntgrtr(tkn));
        this.cnn_mngr.regIntgrtr('stripe', new StripeIntgrtr(tkn));
        this.cnn_mngr.regIntgrtr('salesforce', new SalesforceIntgrtr(tkn));
        this.cnn_mngr.regIntgrtr('shopify', new ShopifyIntgrtr(tkn));
        // ... register all other 100+ integrators
    }
    
    public async ldInitD(): Promise<void> {
        this.updtSt({ ldng: true });
        try {
            const stts = await this.cnn_mngr.chckAllStts();
            const plaid = this.cnn_mngr['intgrtrs']['plaid'] as PlaidIntgrtr;
            
            const accts = await plaid.ftchAccts();
            const trns = accts.length > 0 ? await plaid.ftchTrnsctns(accts[0].acct_id, '2023-01-01', '2023-12-31') : [];
            
            this.updtSt({
                ldng: false,
                d: {
                    cnn_stts: stts,
                    plaid_accts: accts,
                    plaid_trns: trns,
                    chrt_d: UILgcMdl.prprFnclSmryChrt(trns as any),
                }
            });
        } catch (e: any) {
            this.updtSt({ ldng: false, err: e.message });
        }
    }
    
    private updtSt(newSt: VObj): void {
        this.st = { ...this.st, ...newSt };
        this.evnt_emtr.emit('state-change', this.st);
    }
    
    public getCrntSt(): VObj {
        return this.st;
    }
    
    public onStChng(cb: (st: VObj) => void): void {
        this.evnt_emtr.on('state-change', cb);
    }
}

