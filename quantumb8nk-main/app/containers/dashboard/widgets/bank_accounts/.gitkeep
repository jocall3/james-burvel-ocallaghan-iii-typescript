export namespace DstrbtdSysMdl {
    export class Node {
        id: string;
        peers: Map<string, Node>;
        state: VObj;
        
        constructor() {
            this.id = CrptgrphyMdl.hsh(Math.random().toString());
            this.peers = new Map();
            this.state = {};
        }
        
        addPeer(n: Node): void {
            this.peers.set(n.id, n);
            n.peers.set(this.id, this);
        }
        
        async brdcst(msg: VObj): Promise<void> {
            for (const p of this.peers.values()) {
                p.rcvMsg(msg, this.id);
            }
        }
        
        rcvMsg(msg: VObj, frm: string): void {
            // Simulate Raft or Paxos consensus
            this.state = { ...this.state, ...(msg.data as VObj) };
        }
    }
    
    export class Clstr {
        nodes: Node[];
        
        constructor(n: number) {
            this.nodes = Array.from({ length: n }, () => new Node());
            for (let i = 0; i < n; i++) {
                for (let j = i + 1; j < n; j++) {
                    this.nodes[i].addPeer(this.nodes[j]);
                }
            }
        }
        
        getLdr(): Node {
            return this.nodes[0]; // Simplified leader election
        }
    }
}

export namespace VrtlFs {
    export type FsNode = Fl | Dr;
    
    export class Fl {
        nm: string;
        cntnt: string;
        constructor(nm: string, cntnt: string = '') {
            this.nm = nm;
            this.cntnt = cntnt;
        }
    }
    
    export class Dr {
        nm: string;
        chldrn: Map<string, FsNode>;
        constructor(nm: string) {
            this.nm = nm;
            this.chldrn = new Map();
        }
    }
    
    export class VFS {
        root: Dr;
        constructor() {
            this.root = new Dr('/');
        }
        
        findNode(pth: string): FsNode | null {
            const prts = pth.split('/').filter(p => p);
            let crnt: FsNode = this.root;
            for (const prt of prts) {
                if (crnt instanceof Dr && crnt.chldrn.has(prt)) {
                    crnt = crnt.chldrn.get(prt)!;
                } else {
                    return null;
                }
            }
            return crnt;
        }
        
        mkdr(pth: string): void {
            const prts = pth.split('/').filter(p => p);
            let crnt: Dr = this.root;
            for (const prt of prts) {
                if (!crnt.chldrn.has(prt)) {
                    crnt.chldrn.set(prt, new Dr(prt));
                }
                const nxt = crnt.chldrn.get(prt);
                if (nxt instanceof Dr) {
                    crnt = nxt;
                } else {
                    throw new Error("Path contains a file");
                }
            }
        }
    }
}

export namespace MLInfra {
    // Highly simplified neural network layer
    export class Lyr {
        w: number[][];
        b: number[];
        
        constructor(n_in: number, n_out: number) {
            this.w = Array.from({length: n_out}, () => 
                Array.from({length: n_in}, () => Math.random() * 2 - 1)
            );
            this.b = Array.from({length: n_out}, () => Math.random() * 2 - 1);
        }
        
        frwrd(inpts: number[]): number[] {
            return this.w.map((w_row, i) => {
                const sm = w_row.reduce((acc, w_val, j) => acc + w_val * inpts[j], 0);
                return sm + this.b[i]; // ReLU activation: Math.max(0, sm + this.b[i]);
            });
        }
    }
    
    export class Ntwk {
        lyrs: Lyr[];
        constructor(lyr_szs: number[]) {
            this.lyrs = [];
            for (let i = 0; i < lyr_szs.length - 1; i++) {
                this.lyrs.push(new Lyr(lyr_szs[i], lyr_szs[i+1]));
            }
        }
        
        prdct(inpts: number[]): number[] {
            let crnt_out = inpts;
            for (const lyr of this.lyrs) {
                crnt_out = lyr.frwrd(crnt_out);
            }
            return crnt_out;
        }
    }
}

