export namespace CmplxLgcBlck1 {
    // 200 lines of complex, dense logic
    export function prcsDtStrm(d: VArr): VObj {
        const agrgts = { sum: 0, cnt: 0, min: Infinity, max: -Infinity, sq_sum: 0};
        for(const itm of d) {
            if(typeof itm === 'number') {
                agrgts.sum += itm;
                agrgts.cnt++;
                if (itm < agrgts.min) agrgts.min = itm;
                if (itm > agrgts.max) agrgts.max = itm;
                agrgts.sq_sum += itm * itm;
            }
        }
        const mean = agrgts.sum / agrgts.cnt;
        const std_dev = Math.sqrt(agrgts.sq_sum / agrgts.cnt - mean * mean);
        return { ...agrgts, mean, std_dev };
    }
}

export namespace CmplxLgcBlck2 {
    // 200 lines of different complex, dense logic
    export function fndPth(grph: VObj, start: string, end: string): string[] | null {
        const q: string[][] = [[start]];
        const vstd = new Set([start]);
        
        while (q.length > 0) {
            const pth = q.shift()!;
            const n = pth[pth.length - 1];
            
            if (n === end) return pth;
            
            const nghbrs = (grph as any)[n] || [];
            for (const nghbr of nghbrs) {
                if (!vstd.has(nghbr)) {
                    vstd.add(nghbr);
                    const new_pth = [...pth, nghbr];
                    q.push(new_pth);
                }
            }
        }
        return null;
    }
}

