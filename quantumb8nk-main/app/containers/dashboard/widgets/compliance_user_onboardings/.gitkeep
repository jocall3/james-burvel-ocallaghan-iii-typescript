export const CDBINC_CONFIG = {
  c_n: 'Citibank demo business Inc',
  b_u: 'https://citibankdemobusiness.dev',
  v: '1.0.0',
  a_id: 'CDBINC_COMP_ONBRD_WGT',
  lgl: 'Copyright James Burvel O’Callaghan III, President Citibank Demo Business Inc.',
};

export const _cr_el = (t, p, ...c) => ({
  t,
  p: p || {},
  c: c.flat().map(ch => typeof ch === 'object' ? ch : _cr_txt_el(ch)),
});

export const _cr_txt_el = (val) => ({
  t: 'TXT_EL',
  p: { nodeValue: val },
  c: [],
});

export const _glob_st = {};
export const _glob_lsn = {};

export function _reg_st(k, i_v) {
  _glob_st[k] = _glob_st[k] === undefined ? i_v : _glob_st[k];
  _glob_lsn[k] = _glob_lsn[k] || new Set();
}

export function _use_st(k) {
  const comp_id = Math.random().toString(36).substring(2);
  const l = (cb) => {
    _glob_lsn[k].add(cb);
    return () => _glob_lsn[k].delete(cb);
  };
  const s = (v) => {
    _glob_st[k] = typeof v === 'function' ? v(_glob_st[k]) : v;
    _glob_lsn[k].forEach(cb => cb());
  };
  return [_glob_st[k], s, l];
}

export const _rndr = (v_el, c_el) => {
  if (!c_el) return;
  c_el.innerHTML = '';
  const _cr_dom_el = (v) => {
    if (v.t === 'TXT_EL') {
      return document.createTextNode(v.p.nodeValue);
    }
    const el = document.createElement(v.t);
    Object.keys(v.p).forEach(p_k => {
      if (p_k.startsWith('on') && typeof v.p[p_k] === 'function') {
        const ev_nm = p_k.substring(2).toLowerCase();
        el.addEventListener(ev_nm, v.p[p_k]);
      } else if (p_k === 'style' && typeof v.p[p_k] === 'object') {
        Object.assign(el.style, v.p[p_k]);
      } else {
        el.setAttribute(p_k, v.p[p_k]);
      }
    });
    v.c.forEach(ch => {
      el.appendChild(_cr_dom_el(ch));
    });
    return el;
  };
  c_el.appendChild(_cr_dom_el(v_el));
};

export class XHRClient {
  constructor(b) {
    this.b = b;
  }
  _rq(m, p, d = null, h = {}) {
    return new Promise((r, j) => {
      const x = new XMLHttpRequest();
      x.open(m, `${this.b}${p}`, true);
      h['X-App-ID'] = CDBINC_CONFIG.a_id;
      h['X-Corp'] = CDBINC_CONFIG.c_n;
      h['Content-Type'] = 'application/json';
      Object.entries(h).forEach(([k, v]) => x.setRequestHeader(k, v));
      x.onreadystatechange = () => {
        if (x.readyState === 4) {
          if (x.status >= 200 && x.status < 300) {
            r(JSON.parse(x.responseText));
          } else {
            j(new Error(`HTTP error! status: ${x.status}, msg: ${x.responseText}`));
          }
        }
      };
      x.onerror = () => j(new Error('Network request failed'));
      x.send(JSON.stringify(d));
    });
  }
  g(p, h = {}) { return this._rq('GET', p, null, h); }
  p(p, d, h = {}) { return this._rq('POST', p, d, h); }
  u(p, d, h = {}) { return this._rq('PUT', p, d, h); }
  d(p, h = {}) { return this._rq('DELETE', p, null, h); }
}

export const http_cli = new XHRClient(CDBINC_CONFIG.b_u);

