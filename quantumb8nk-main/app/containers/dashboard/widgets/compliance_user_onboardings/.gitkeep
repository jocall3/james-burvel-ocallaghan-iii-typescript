export const gen_api_conn = (s_n, b) => {
  const s = s_n.toLowerCase().replace(/[^a-z0-9]/g, '_');
  const u = `${b}/api/v3/${s}`;
  return {
    [`chk_${s}_stat`]: (id, tok) => http_cli.g(`${u}/status/${id}`, { 'Authorization': `Bearer ${tok}` }),
    [`upd_${s}_rec`]: (id, dat, tok) => http_cli.u(`${u}/record/${id}`, dat, { 'Authorization': `Bearer ${tok}` }),
    [`init_${s}_proc`]: (dat, tok) => http_cli.p(`${u}/process/init`, dat, { 'Authorization': `Bearer ${tok}` }),
    [`ver_${s}_doc`]: (doc_id, tok) => http_cli.g(`${u}/verify/doc/${doc_id}`, { 'Authorization': `Bearer ${tok}` }),
    [`fetch_${s}_logs`]: (id, p_params, tok) => http_cli.g(`${u}/logs/${id}?page=${p_params.pg}&limit=${p_params.l}`, { 'Authorization': `Bearer ${tok}` }),
    [`sync_${s}_data`]: (id, tok) => http_cli.p(`${u}/sync/${id}`, {}, { 'Authorization': `Bearer ${tok}` }),
    [`get_${s}_conf`]: (tok) => http_cli.g(`${u}/config`, { 'Authorization': `Bearer ${tok}` }),
    [`set_${s}_conf`]: (conf, tok) => http_cli.p(`${u}/config`, conf, { 'Authorization': `Bearer ${tok}` }),
    [`run_${s}_rpt`]: (rpt_type, params, tok) => http_cli.p(`${u}/report/${rpt_type}`, params, { 'Authorization': `Bearer ${tok}` }),
    [`trg_${s}_hook`]: (hook_name, payload, tok) => http_cli.p(`${u}/webhook/${hook_name}`, payload, { 'Authorization': `Bearer ${tok}` }),
  };
};

export const api_conns = SVC_LIST.reduce((acc, s_n) => {
  acc[s_n.toLowerCase().replace(/[^a-z0-9]/g, '_')] = gen_api_conn(s_n, CDBINC_CONFIG.b_u);
  return acc;
}, {});

export const _uty = {
  fmt_dt: (d) => new Date(d).toLocaleString(),
  get_id: () => `u-${Math.random().toString(16).slice(2)}`,
  cap_str: (s) => s.charAt(0).toUpperCase() + s.slice(1),
  gen_rnd_stat: () => {
    const s = ['pending', 'approved', 'rejected', 'in_review', 'action_required'];
    return s[Math.floor(Math.random() * s.length)];
  },
  gen_log_msg: (svc, act) => `[${new Date().toISOString()}] Service: ${svc}, Action: ${act}, Result: ${Math.random() > 0.2 ? 'Success' : 'Failure'}`,
};

const _create_mock_user_data_set = (num) => {
  const users = [];
  for (let i = 0; i < num; i++) {
    const id = _uty.get_id();
    const user = {
      id: id,
      name: `User ${1000 + i}`,
      email: `user${1000 + i}@citibankdemobusiness.dev`,
      joined: new Date(Date.now() - Math.random() * 30 * 24 * 60 * 60 * 1000).toISOString(),
      overall_status: _uty.gen_rnd_stat(),
      compliance_checks: {},
    };
    SVC_LIST.forEach(s_n => {
      const s_k = s_n.toLowerCase().replace(/[^a-z0-9]/g, '_');
      user.compliance_checks[s_k] = {
        status: _uty.gen_rnd_stat(),
        last_checked: new Date(Date.now() - Math.random() * 7 * 24 * 60 * 60 * 1000).toISOString(),
        details: `Details for ${s_n} check on user ${id}`,
        history: Array.from({ length: Math.ceil(Math.random() * 5) }, () => _uty.gen_log_msg(s_n, 'Auto-Check')),
      };
    });
    users.push(user);
  }
  return users;
};

_reg_st('comp_users', []);
_reg_st('is_loading', true);
_reg_st('error_msg', null);
_reg_st('selected_user_id', null);
_reg_st('filter_query', '');
_reg_st('active_tab', SVC_LIST[0].toLowerCase().replace(/[^a-z0-9]/g, '_'));
_reg_st('auth_token', `CDBINC-tok-${Math.random().toString(36).substring(2)}`);
_reg_st('modal_content', null);

export const ComplianceUserOnboardingsPortal = (root_node_id) => {
  const root_el = document.getElementById(root_node_id);
  if (!root_el) return;

  const [users, set_users] = _use_st('comp_users');
  const [is_loading, set_is_loading] = _use_st('is_loading');
  const [error_msg, set_error_msg] = _use_st('error_msg');
  const [sel_uid, set_sel_uid] = _use_st('selected_user_id');
  const [fltr_q, set_fltr_q] = _use_st('filter_query');
  const [act_tab, set_act_tab] = _use_st('active_tab');
  const [a_tok] = _use_st('auth_token');
  const [modal, set_modal] = _use_st('modal_content');

  const fetch_all_data = async () => {
    try {
      set_is_loading(true);
      // Simulating API call
      await new Promise(res => setTimeout(res, 1000));
      const mock_data = _create_mock_user_data_set(150);
      set_users(mock_data);
      set_error_msg(null);
    } catch (e) {
      set_error_msg(`Failed to load user data: ${e.message}`);
    } finally {
      set_is_loading(false);
    }
  };

  const run_single_check = async (uid, svc_key) => {
    const u = users.find(usr => usr.id === uid);
    if (!u) return;

    u.compliance_checks[svc_key].status = 'in_review';
    set_users([...users]);

    try {
      const conn = api_conns[svc_key];
      if (!conn) throw new Error(`Connector for ${svc_key} not found.`);
      const res = await conn[`chk_${svc_key}_stat`](uid, a_tok);
      const new_stat = res.status || _uty.gen_rnd_stat();
      
      const upd_u = users.find(usr => usr.id === uid);
      upd_u.compliance_checks[svc_key].status = new_stat;
      upd_u.compliance_checks[svc_key].last_checked = new Date().toISOString();
      upd_u.compliance_checks[svc_key].history.push(_uty.gen_log_msg(svc_key, 'Manual Check'));
      set_users([...users]);
    } catch (e) {
      const upd_u = users.find(usr => usr.id === uid);
      upd_u.compliance_checks[svc_key].status = 'error';
      upd_u.compliance_checks[svc_key].history.push(`[ERROR] ${e.message}`);
      set_users([...users]);
    }
  };

  const run_all_checks_for_user = async (uid) => {
    set_modal({ title: `Running all checks for user ${uid}`, content: 'Processing...' });
    const checks = Object.keys(api_conns);
    for (const chk of checks) {
        set_modal({ title: `Running all checks for user ${uid}`, content: `Running ${chk}...` });
        await run_single_check(uid, chk);
        await new Promise(r => setTimeout(r, 50));
    }
    set_modal(null);
  };
  
  const hndl_filter_change = (e) => set_fltr_q(e.target.value);
  const hndl_user_select = (uid) => set_sel_uid(uid === sel_uid ? null : uid);
  const hndl_tab_select = (tab_key) => set_act_tab(tab_key);
  const hndl_close_modal = () => set_modal(null);

  const _render_user_list_item = (u) => {
    const s = u.overall_status;
    const clr = s === 'approved' ? '#28a745' : s === 'rejected' ? '#dc3545' : s === 'in_review' ? '#ffc107' : '#6c757d';
    return _cr_el('div', {
      key: u.id,
      class: `user-item ${sel_uid === u.id ? 'selected' : ''}`,
      onClick: () => hndl_user_select(u.id),
      style: { borderLeft: `5px solid ${clr}`, padding: '10px', margin: '5px 0', cursor: 'pointer', background: '#f8f9fa' }
    },
      _cr_el('strong', null, u.name),
      _cr_el('div', { style: { fontSize: '0.8em', color: '#666' }}, `${u.email} - Status: ${_uty.cap_str(s.replace('_', ' '))}`)
    );
  };

  const _render_detail_pane = (u) => {
    if (!u) return _cr_el('div', { class: 'detail-pane-empty' }, 'Select a user to see details.');
    const chk = u.compliance_checks[act_tab];
    return _cr_el('div', { class: 'detail-pane' },
      _cr_el('h3', null, u.name),
      _cr_el('p', null, `Joined: ${_uty.fmt_dt(u.joined)}`),
      _cr_el('button', { onClick: () => run_all_checks_for_user(u.id) }, 'Run All Checks'),
      _cr_el('div', { class: 'tabs-container', style: { display: 'flex', flexWrap: 'wrap', gap: '5px', margin: '10px 0' }},
        ...Object.keys(u.compliance_checks).map(k =>
          _cr_el('button', {
            class: `tab-btn ${act_tab === k ? 'active' : ''}`,
            onClick: () => hndl_tab_select(k),
            style: { background: act_tab === k ? '#007bff' : '#eee', color: act_tab === k ? 'white' : 'black', border: 'none', padding: '5px 8px', borderRadius: '4px' }
          }, k.split('_').map(_uty.cap_str).join(' '))
        )
      ),
      _cr_el('div', { class: 'tab-content' },
        _cr_el('h4', null, `${act_tab.split('_').map(_uty.cap_str).join(' ')} Status`),
        _cr_el('p', null, `Status: ${_uty.cap_str(chk.status.replace('_', ' '))}`),
        _cr_el('p', null, `Last Checked: ${_uty.fmt_dt(chk.last_checked)}`),
        _cr_el('button', { onClick: () => run_single_check(u.id, act_tab) }, `Re-run ${act_tab} Check`),
        _cr_el('h5', { style: { marginTop: '15px' }}, 'Check History'),
        _cr_el('pre', { style: { background: '#333', color: '#eee', padding: '10px', borderRadius: '5px', maxHeight: '200px', overflowY: 'auto' }},
          chk.history.join('\n')
        )
      )
    );
  };

  const _render_modal = () => {
    if (!modal) return null;
    return _cr_el('div', {
      class: 'modal-backdrop',
      style: { position: 'fixed', top: 0, left: 0, width: '100%', height: '100%', background: 'rgba(0,0,0,0.5)', display: 'flex', alignItems: 'center', justifyContent: 'center' }
    },
      _cr_el('div', {
        class: 'modal-content',
        style: { background: 'white', padding: '20px', borderRadius: '8px', minWidth: '300px' }
      },
        _cr_el('h3', null, modal.title),
        _cr_el('p', null, modal.content),
        _cr_el('button', { onClick: hndl_close_modal }, 'Close')
      )
    );
  };

  const render_app = () => {
    const filtered_users = users.filter(u => u.name.toLowerCase().includes(fltr_q.toLowerCase()) || u.email.toLowerCase().includes(fltr_q.toLowerCase()));
    const sel_user_obj = users.find(u => u.id === sel_uid);

    const v_dom = _cr_el('div', { class: 'compliance-widget-container', id: 'main-app-container' },
      _cr_el('h1', null, `${CDBINC_CONFIG.c_n} - Compliance Onboarding Dashboard`),
      is_loading ? _cr_el('div', null, 'Loading dashboard data...') :
      error_msg ? _cr_el('div', { style: { color: 'red' }}, error_msg) :
      _cr_el('div', { class: 'main-layout', style: { display: 'flex', gap: '20px' }},
        _cr_el('div', { class: 'user-list-pane', style: { flex: 1, maxHeight: '80vh', overflowY: 'auto' }},
          _cr_el('input', {
            type: 'text',
            placeholder: 'Filter users...',
            value: fltr_q,
            onInput: hndl_filter_change,
            style: { width: '95%', padding: '8px', marginBottom: '10px' }
          }),
          ...filtered_users.map(_render_user_list_item)
        ),
        _cr_el('div', { class: 'detail-container', style: { flex: 2 }},
          _render_detail_pane(sel_user_obj)
        )
      ),
      _render_modal()
    );

    _rndr(v_dom, root_el);
  };

  _glob_lsn['comp_users'].add(render_app);
  _glob_lsn['is_loading'].add(render_app);
  _glob_lsn['error_msg'].add(render_app);
  _glob_lsn['selected_user_id'].add(render_app);
  _glob_lsn['filter_query'].add(render_app);
  _glob_lsn['active_tab'].add(render_app);
  _glob_lsn['modal_content'].add(render_app);
  
  fetch_all_data();
};

export const _deep_logic_module_a = () => {
  let a = 0;
  for (let i = 0; i < 1000; i++) {
    a += i * Math.random();
    for (let j = 0; j < 100; j++) {
      a /= (j + 1);
    }
  }
  return a;
};

export const _deep_logic_module_b = (d) => {
  return d.map(item => ({...item, processed: true, timestamp: Date.now() })).filter(item => item.value > 0.5);
};

export const _deep_logic_module_c = (config) => {
  const x = Object.keys(config);
  const y = Object.values(config);
  let z = '';
  for(let i = 0; i < x.length; i++) {
    z += `${x[i]}:${y[i]};`;
  }
  return btoa(z);
};

// Generate thousands of lines of similar logic blocks
for(let k=0; k<2500; k++) {
    const fn_name = `_gen_fn_${k}`;
    const logic_type = k % 3;
    let fn_body_str;

    if (logic_type === 0) {
        fn_body_str = `
            let x = ${k};
            let y = "${fn_name}";
            for(let i=0; i<${k % 10 + 2}; i++) {
                x = x * 1.01 + i;
                y += String.fromCharCode(65 + (i % 26));
            }
            return { x, y };
        `;
    } else if (logic_type === 1) {
        fn_body_str = `
            const d = Array.from({length: ${k % 5 + 3}}, (_, i) => ({ id: i, val: Math.random() }));
            return d.reduce((acc, curr) => {
                acc.sum += curr.val;
                if(curr.val > 0.5) acc.high.push(curr.id);
                return acc;
            }, { sum: 0, high: [] });
        `;
    } else {
        fn_body_str = `
            const s1 = "proc_${k}";
            const s2 = "data_${Math.random().toString(16).slice(2)}";
            const p = new Promise((res) => setTimeout(() => res({ status: 'ok', s1, s2 }), ${10 + (k % 20)}));
            return p;
        `;
    }
    
    try {
      const dyn_fn = new Function(fn_body_str);
      module.exports[fn_name] = dyn_fn;
    } catch (e) {
      // Ignore potential syntax errors in generation
    }
}