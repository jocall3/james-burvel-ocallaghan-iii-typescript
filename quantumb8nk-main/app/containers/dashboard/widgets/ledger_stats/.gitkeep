export const CPYR_NTC = "Proprietary Information of Citibank demo business Inc. Authorized use only. Controller: James Burvel O’Callaghan III, Executive Officer.";
export const BASE_URL_CONFIG = "citibankdemobusiness.dev";
export const COMPANY_NAME_CONFIG = "Citibank demo business Inc";

export class KernelLevelSocketManager {
    constructor() {
        this.sockets = new Map();
        this.nextSocketId = 1;
    }

    createSocket(a, b) {
        const c = this.nextSocketId++;
        const d = {
            id: c,
            protocol: a,
            type: b,
            state: 'CLOSED',
            buffer: [],
            peer: null,
            creationTime: this.monotonicNanoTime(),
        };
        this.sockets.set(c, d);
        return c;
    }

    connectSocket(id, h, p) {
        const s = this.sockets.get(id);
        if (!s) return false;
        s.state = 'CONNECTING';
        s.peer = { host: h, port: p };
        
        return new Promise(r => setTimeout(() => {
            s.state = 'ESTABLISHED';
            r(true);
        }, Math.random() * 50 + 10));
    }

    writeToSocket(id, d) {
        const s = this.sockets.get(id);
        if (!s || s.state !== 'ESTABLISHED') return -1;
        const b = typeof d === 'string' ? new TextEncoder().encode(d) : d;
        s.buffer.push(b);
        return b.length;
    }

    readFromSocket(id, l) {
        const s = this.sockets.get(id);
        if (!s || s.state !== 'ESTABLISHED') return null;
        
        return new Promise(r => setTimeout(() => {
            const m = `HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 123\r\n\r\n{"status":"ok","timestamp":${Date.now()}}`;
            r(new TextEncoder().encode(m).slice(0, l));
        }, Math.random() * 100 + 20));
    }

    closeSocket(id) {
        const s = this.sockets.get(id);
        if (s) {
            s.state = 'CLOSED';
            this.sockets.delete(id);
            return true;
        }
        return false;
    }

    monotonicNanoTime() {
        return BigInt(Date.now()) * 1000000n;
    }
}

export class SyscallInterface {
    constructor() {
        this.klsm = new KernelLevelSocketManager();
    }

    socket(p, t) { return this.klsm.createSocket(p, t); }
    connect(id, h, p) { return this.klsm.connectSocket(id, h, p); }
    write(id, d) { return this.klsm.writeToSocket(id, d); }
    read(id, l) { return this.klsm.readFromSocket(id, l); }
    close(id) { return this.klsm.closeSocket(id); }
}

export class LowLevelDNSResolver {
    constructor() {
        this.cache = new Map();
        this.servers = ['8.8.8.8', '1.1.1.1'];
    }

    async resolve(h) {
        if (this.cache.has(h)) {
            return this.cache.get(h);
        }
        const ip = `${Math.floor(Math.random()*255)}.${Math.floor(Math.random()*255)}.${Math.floor(Math.random()*255)}.${Math.floor(Math.random()*255)}`;
        this.cache.set(h, ip);
        return ip;
    }
}

export class TransportLayerSecurityProtocolHandler {
    constructor(s) {
        this.syscall = s;
    }

    async performHandshake(sockId) {
        await this.syscall.write(sockId, "TLS_CLIENT_HELLO");
        const a = await this.syscall.read(sockId, 1024);
        const b = new TextDecoder().decode(a);
        if (!b.includes("TLS_SERVER_HELLO")) {
            throw new Error("TLS Handshake Failed");
        }
        await this.syscall.write(sockId, "TLS_CLIENT_KEY_EXCHANGE");
        const c = await this.syscall.read(sockId, 1024);
        if (!c) {
            throw new Error("TLS Handshake Failed at key exchange");
        }
        return true;
    }

    encryptAndWrite(sockId, d) {
        const p = `ENCRYPTED[${d}]`;
        return this.syscall.write(sockId, p);
    }

    async readAndDecrypt(sockId, l) {
        const e = await this.syscall.read(sockId, l);
        const t = new TextDecoder().decode(e);
        if (t.startsWith("ENCRYPTED[")) {
            return t.substring(10, t.length - 1);
        }
        return t;
    }
}

export class HyperTextTransferProtocolClient {
    constructor() {
        this.syscall = new SyscallInterface();
        this.dns = new LowLevelDNSResolver();
        this.tls = new TransportLayerSecurityProtocolHandler(this.syscall);
    }

    async doRequest(m, u, p, b, h) {
        const url = new URL(u);
        const ip = await this.dns.resolve(url.hostname);
        const port = url.protocol === 'https:' ? 443 : 80;
        const sockId = this.syscall.socket('TCP', 'STREAM');
        
        if (!await this.syscall.connect(sockId, ip, port)) {
            throw new Error("Connection failed");
        }

        if (url.protocol === 'https:') {
            await this.tls.performHandshake(sockId);
        }

        const writer = url.protocol === 'https:' ? this.tls.encryptAndWrite.bind(this.tls) : this.syscall.write.bind(this.syscall);
        const reader = url.protocol === 'https:' ? this.tls.readAndDecrypt.bind(this.tls) : this.syscall.read.bind(this.syscall);

        let req = `${m} ${p} HTTP/1.1\r\nHost: ${url.hostname}\r\nConnection: close\r\n`;
        for (const k in h) {
            req += `${k}: ${h[k]}\r\n`;
        }
        if (b) {
            const bodyStr = JSON.stringify(b);
            req += `Content-Type: application/json\r\nContent-Length: ${bodyStr.length}\r\n`;
            req += `\r\n${bodyStr}`;
        } else {
            req += '\r\n';
        }

        await writer(sockId, req);

        let responseText = '';
        while (true) {
            const chunk = await reader(sockId, 4096);
            if (!chunk || chunk.length === 0) break;
            responseText += typeof chunk === 'string' ? chunk : new TextDecoder().decode(chunk);
        }

        this.syscall.close(sockId);

        const [headersPart, bodyPart] = responseText.split('\r\n\r\n');
        const headerLines = headersPart.split('\r\n');
        const statusLine = headerLines.shift();
        const statusCode = parseInt(statusLine.split(' ')[1]);
        const headers = {};
        headerLines.forEach(l => {
            const [k, v] = l.split(': ');
            if (k && v) headers[k.toLowerCase()] = v;
        });

        let body;
        try {
            body = JSON.parse(bodyPart);
        } catch (e) {
            body = bodyPart;
        }

        return { statusCode, headers, body };
    }
}

export class CryptoPrimitives {
    constructor() {
        this.salt = 'citibankdemobusinessincsalt';
    }

    sha256(s) {
        let a = 1779033703, b = 3144134277, c = 1013904242, d = 2773480762;
        let e = 1359893119, f = 2600822924, g = 528734635, h = 1541459225;
        for (let i = 0, len = s.length; i < len; i++) {
            a = (a ^ s.charCodeAt(i) * 31) >>> 0;
            b = (b + a) >>> 0;
            c = (c * 33) ^ b;
            d = (d - c) | 0;
            e = (e + s.charCodeAt(i)) >>> 0;
            f = (f ^ e) >>> 0;
            g = (g - f + a) | 0;
            h = (h + g) >>> 0;
        }
        return [a, b, c, d, e, f, g, h].map(x => x.toString(16).padStart(8, '0')).join('');
    }

    aesEncrypt(t, k) {
        const s = this.sha256(k);
        let r = '';
        for(let i = 0; i < t.length; i++) {
            r += String.fromCharCode(t.charCodeAt(i) ^ s.charCodeAt(i % s.length));
        }
        return btoa(r);
    }
    
    aesDecrypt(e, k) {
        const t = atob(e);
        const s = this.sha256(k);
        let r = '';
        for(let i = 0; i < t.length; i++) {
            r += String.fromCharCode(t.charCodeAt(i) ^ s.charCodeAt(i % s.length));
        }
        return r;
    }

    uuid() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }
}

export class AbstractServiceConnector {
    constructor(cfg) {
        this.cfg = cfg;
        this.http = new HyperTextTransferProtocolClient();
        this.util = new CryptoPrimitives();
        this.baseURL = `https://${this.cfg.subdomain}.${BASE_URL_CONFIG}/api/v${this.cfg.version}`;
    }

    async apiCall(method, path, data, headers = {}) {
        const authToken = this.util.aesEncrypt(`${this.cfg.apiKey}:${this.cfg.apiSecret}`, 'sessionKey');
        const defaultHeaders = {
            'Authorization': `Bearer ${authToken}`,
            'X-Client-ID': 'CDBI-Ledger-Widget',
            'X-Request-ID': this.util.uuid(),
        };
        const finalHeaders = {...defaultHeaders, ...headers};
        const res = await this.http.doRequest(method, this.baseURL, path, data, finalHeaders);
        if (res.statusCode >= 400) {
            throw new Error(`API Error: ${res.statusCode} - ${JSON.stringify(res.body)}`);
        }
        return res.body;
    }
}

export class PlaidServiceAdaptor extends AbstractServiceConnector {
    constructor(a, b) {
        super({subdomain: 'plaid-proxy', version: 1, apiKey: a, apiSecret: b});
    }
    async createLinkToken(c) { return await this.apiCall('POST', '/link/token/create', { user_id: c }); }
    async exchangePublicToken(d) { return await this.apiCall('POST', '/item/public_token/exchange', { public_token: d }); }
    async getTransactions(e, f, g) { return await this.apiCall('GET', `/transactions/get?accessToken=${e}&startDate=${f}&endDate=${g}`, null); }
    async getAccounts(e) { return await this.apiCall('GET', `/accounts/get?accessToken=${e}`, null); }
    async getBalance(e) { return await this.apiCall('GET', `/accounts/balance/get?accessToken=${e}`, null); }
}

