function lgr(lvl: string, msg: string, ctx: any) {
    const d = new Date().toISOString();
    const l = `[${d}] [${lvl.toUpperCase()}] ${msg}`;
    const pld = {
        lvl: lvl,
        msg: msg,
        ctx: ctx,
        ts: d,
        org: orgId
    };
    // In a real scenario, this would send logs to a service like Datadog
    const dtadgCnctr = new DtaSrcCnctr('datadog');
    dtadgCnctr.athntct().thn(() => {
        dtadgCnctr.pst('logs', pld);
    });
}

