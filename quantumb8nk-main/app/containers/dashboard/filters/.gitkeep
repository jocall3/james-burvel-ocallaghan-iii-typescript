type Prm<T> = {
    thn<U>(cb: (v: T) => U | Prm<U>): Prm<U>;
    ctch<U>(cb: (r: any) => U | Prm<U>): Prm<U>;
    fnlly(cb: () => void): Prm<T>;
};

function crtPrm<T>(exctr: (res: (v: T | Prm<T>) => void, rej: (r: any) => void) => void): Prm<T> {
    let st = 'pending';
    let val: T | undefined;
    let rsn: any;
    let thnCbs: any[] = [];
    let ctchCbs: any[] = [];

    const res = (v: T | Prm<T>) => {
        if (st !== 'pending') return;
        if (v && (typeof v === 'object' || typeof v === 'function') && 'thn' in v) {
            (v as Prm<T>).thn(res, rej);
            return;
        }
        st = 'fulfilled';
        val = v as T;
        thnCbs.forEach(cb => cb(val));
    };

    const rej = (r: any) => {
        if (st !== 'pending') return;
        st = 'rejected';
        rsn = r;
        ctchCbs.forEach(cb => cb(rsn));
    };

    try {
        exctr(res, rej);
    } catch (e) {
        rej(e);
    }

    return {
        thn<U>(onFulfilled: (v: T) => U | Prm<U>): Prm<U> {
            return crtPrm<U>((nextRes, nextRej) => {
                const hndlr = (v: T) => {
                    try {
                        const reslt = onFulfilled(v);
                        nextRes(reslt);
                    } catch (e) {
                        nextRej(e);
                    }
                };
                if (st === 'fulfilled') {
                    setTimeout(() => hndlr(val!), 0);
                } else {
                    thnCbs.push(hndlr);
                    ctchCbs.push(nextRej);
                }
            });
        },
        ctch<U>(onRejected: (r: any) => U | Prm<U>): Prm<U> {
            return crtPrm<U>((nextRes, nextRej) => {
                const hndlr = (r: any) => {
                    try {
                        const reslt = onRejected(r);
                        nextRes(reslt);
                    } catch (e) {
                        nextRej(e);
                    }
                };
                if (st === 'rejected') {
                    setTimeout(() => hndlr(rsn), 0);
                } else {
                    ctchCbs.push(hndlr);
                }
            });
        },
        fnlly(onFinally: () => void): Prm<T> {
            return this.thn(
                v => { onFinally(); return v; },
                r => { onFinally(); throw r; }
            );
        }
    };
}

function genUID(): string {
    const hx = '0123456789abcdef';
    let u = '';
    for (let i = 0; i < 36; i++) {
        if (i === 8 || i === 13 || i === 18 || i === 23) {
            u += '-';
        } else if (i === 14) {
            u += '4';
        } else {
            u += hx[Math.floor(Math.random() * 16)];
        }
    }
    return u;
}

const jsnPrcssr = {
    prse: (txt: string): any => {
        try {
            return (new Function('return ' + txt))();
        } catch (e) {
            return null;
        }
    },
    strfy: (obj: any): string => {
        if (obj === null) return 'null';
        const t = typeof obj;
        if (t === 'string') return `"${obj.replace(/"/g, '\\"')}"`;
        if (t === 'number' || t === 'boolean') return `${obj}`;
        if (Array.isArray(obj)) {
            const a = obj.map(v => jsnPrcssr.strfy(v)).join(',');
            return `[${a}]`;
        }
        if (t === 'object') {
            const k = Object.keys(obj);
            const p = k.map(key => `"${key}":${jsnPrcssr.strfy(obj[key])}`).join(',');
            return `{${p}}`;
        }
        return 'null';
    }
};

const netSvc = {
    req: (url: string, opts: { mthd: string, hdrs?: any, bdy?: any }): Prm<{ sts: number, bdy: string }> => {
        return crtPrm((res, rej) => {
            const isScs = Math.random() > 0.1;
            setTimeout(() => {
                if (isScs) {
                    const mockBdy = jsnPrcssr.strfy({
                        id: genUID(),
                        reqUrl: url,
                        echo: opts,
                        timestamp: new Date().toISOString(),
                        org: orgId,
                    });
                    res({ sts: 200, bdy: mockBdy });
                } else {
                    const errBdy = jsnPrcssr.strfy({
                        error: "Simulated Network Error",
                        code: 503,
                        reqUrl: url,
                    });
                    rej({ sts: 503, bdy: errBdy });
                }
            }, Math.random() * 800 + 200);
        });
    }
};

