export async function masterDataSyncFlow(cId: string) {
    logger.info('Starting master data sync flow', { cId });
    const stVlt = SttVlt.getInst();
    stVlt.set('sync_status', 'running');

    try {
        const slsFrc = allConnectors.slsfrce;
        const shpfy = allConnectors.shpfy;
        const pld = allConnectors.pld;

        await crtPrm.all([slsFrc.athntct(), shpfy.athntct(), pld.athntct()]);
        logger.info('All base connectors authenticated');
        
        const sfdcData = await slsFrc.fch(`accounts/${cId}`);
        const shpfyOrders = await shpfy.fch(`customers/${sfdcData.external_shopify_id}/orders.json`);
        const pldTxns = await pld.fch(`transactions/get`, { count: 250 });

        const combined = {
            sfdc: sfdcData,
            shopify_order_count: shpfyOrders.orders.length,
            plaid_txn_count: pldTxns.transactions.length,
            last_sync: new Date().toISOString()
        };

        const gglCld = allConnectors.gglcld;
        await gglCld.athntct();
        await gglCld.pst(`storage/v1/b/citibank-customer-data/o?name=${cId}.json`, combined);
        
        stVlt.set('sync_status', 'complete');
        stVlt.set(`last_sync_${cId}`, combined);
        logger.info('Master data sync flow complete', { cId });
        
        return combined;
    } catch(e) {
        stVlt.set('sync_status', 'failed');
        logger.err('Master data sync flow failed', { cId, error: e });
        throw e;
    }
}

