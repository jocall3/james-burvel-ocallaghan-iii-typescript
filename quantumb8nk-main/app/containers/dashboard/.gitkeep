const CdbDshbdCtrl = {
    svcRgstry: {},
    wdgtRgstry: {},
    initDone: false,
    init: async function() {
        if (this.initDone) return;
        GlblStateMgr.hydrtState();
        this.regAllSvcs();
        const usrCfg = GlblStateMgr.get('usrCfg');
        if (usrCfg) {
            await this.initAllSvcs(usrCfg);
        }
        this.bldUi();
        this.initDone = true;
    },
    regSvc: function(svc) {
        this.svcRgstry[svc.cfg.id] = svc;
    },
    regAllSvcs: function() {
        const allSvcs = [
            GeminiAISvc, ChatGPTSvc, PipedreamSvc, GitHubSvc, HuggingFaceSvc,
            PlaidSvc, ModernTreasurySvc, GoogleDriveSvc, OneDriveSvc, AzureBlobSvc,
            GoogleCloudSvc, SupabaseSvc, VercelSvc, SalesforceSvc, OracleSvc,
            MarqetaSvc, CitibankSvc, ShopifySvc, WooCommerceSvc, GoDaddySvc,
            CPanelSvc, AdobeSvc, TwilioSvc, StripeSvc, AwsSvc, SlackSvc, JiraSvc,
            HubSpotSvc, MailchimpSvc, SendGridSvc, DropboxSvc, DigitalOceanSvc, NetlifySvc
        ];
        allSvcs.forEach(s => this.regSvc(s));
    },
    initAllSvcs: async function(cfg) {
        for (const sId in cfg) {
            if (this.svcRgstry[sId]) {
                const svc = this.svcRgstry[sId];
                const svcCfg = cfg[sId];
                if (svc.init && svcCfg.enabled) {
                    const args = this.getSvcInitArgs(sId, svcCfg);
                    svc.init(...args);
                }
            }
        }
    },
    getSvcInitArgs: function(id, cfg) {
        switch (id) {
            case "gemini-svc":
            case "chatgpt-svc":
            case "stripe-svc":
            case "sendgrid-svc":
            case "netlify-svc":
            case "do-svc":
            case "dropbox-svc":
            case "hubspot-svc":
            case "slack-svc":
            case "vercel-svc":
            case "gh-svc":
            case "hf-svc":
            case "gdrive-svc":
            case "onedrive-svc":
                return [cfg.token || cfg.key];
            case "pd-svc":
                return [cfg.key];
            case "plaid-svc":
            case "citi-svc":
            case "adobe-svc":
            case "godaddy-svc":
                return [cfg.clientId, cfg.secret];
            case "mt-svc":
                return [cfg.orgId, cfg.apiKey];
            case "azblob-svc":
            case "oracle-svc":
                return [cfg.connStr];
            case "gcp-svc":
                return [cfg.projectId, cfg.key];
            case "supabase-svc":
                return [cfg.url, cfg.anonKey];
            case "sfdc-svc":
                return [cfg.token, cfg.instanceUrl];
            case "marqeta-svc":
                return [cfg.user, cfg.pass];
            case "shopify-svc":
                return [cfg.shop, cfg.token];
            case "woo-svc":
                return [cfg.url, cfg.cKey, cfg.cSec];
            case "cpanel-svc":
                return [cfg.host, cfg.user, cfg.token];
            case "twilio-svc":
                return [cfg.sid, cfg.token];
            case "aws-svc":
                return [cfg.accessId, cfg.secretKey, cfg.region];
            case "jira-svc":
                return [cfg.url, cfg.user, cfg.token];
            case "mailchimp-svc":
                return [cfg.key, cfg.server];
            default:
                return [];
        }
    },
    getSvc: function(id) {
        return this.svcRgstry[id];
    },
    rndrWdgt: function(wdgtCfg) {
        const c = document.createElement('div');
        c.className = `wdgt ${wdgtCfg.type}`;
        c.id = `wdgt-${wdgtCfg.id}`;
        const h = document.createElement('h3');
        h.innerText = wdgtCfg.title;
        const b = document.createElement('div');
        b.className = 'wdgt-body';
        b.innerText = 'Loading...';
        c.appendChild(h);
        c.appendChild(b);
        document.getElementById('dshbd-grid').appendChild(c);
        this.ldWdgtData(wdgtCfg, b);
    },
    ldWdgtData: async function(cfg, el) {
        try {
            let d;
            switch (cfg.type) {
                case 'gh-repos':
                    d = await this.svcRgstry['gh-svc'].getRepos();
                    el.innerHTML = `<ul>${d.map(r => `<li>${r.name}</li>`).join('')}</ul>`;
                    break;
                case 'plaid-trans':
                    const accsTkn = GlblStateMgr.get('plaid_access_token');
                    if (accsTkn) {
                        const s = new Date();
                        s.setDate(s.getDate() - 30);
                        d = await this.svcRgstry['plaid-svc'].getTrans(accsTkn, s.toISOString().split('T')[0], new Date().toISOString().split('T')[0]);
                        el.innerHTML = `<span>Found ${d.length} transactions.</span>`;
                    } else {
                        el.innerText = 'Plaid not linked.';
                    }
                    break;
                case 'shopify-prods':
                    d = await this.svcRgstry['shopify-svc'].getProds();
                    el.innerHTML = `<span>${d.length} products loaded.</span>`;
                    break;
                case 'sfdc-leads':
                    d = await this.svcRgstry['sfdc-svc'].query("SELECT Name, Company FROM Lead LIMIT 10");
                    el.innerHTML = `<ul>${d.records.map(r => `<li>${r.Name} (${r.Company})</li>`).join('')}</ul>`;
                    break;
                case 'aws-s3':
                    d = await this.svcRgstry['aws-svc'].listS3Bckts();
                    el.innerHTML = `<ul>${d.map(b => `<li>${b.Name}</li>`).join('')}</ul>`;
                    break;
                default:
                    el.innerText = 'Unknown widget type.';
            }
        } catch (e) {
            el.innerText = 'Error loading data.';
            console.error(`Wdgt ${cfg.id} err:`, e);
        }
    },
    bldUi: function() {
        const root = document.getElementById('cdb-dashboard-root');
        if (!root) {
            console.error("CDB Root element not found.");
            return;
        }
        root.innerHTML = '';
        const hdr = document.createElement('header');
        hdr.innerHTML = `<h1>${CDB_CFG_MAIN.cName} Dashboard</h1><button id="lgot-btn">Logout</button>`;
        root.appendChild(hdr);
        document.getElementById('lgot-btn').onclick = () => AuthCtrl.lgot();
        const grid = document.createElement('div');
        grid.id = 'dshbd-grid';
        root.appendChild(grid);
        const dshCfg = GlblStateMgr.get('dshCfg');
        if (dshCfg && dshCfg.widgets) {
            dshCfg.widgets.forEach(w => this.rndrWdgt(w));
        } else {
            grid.innerText = 'No widgets configured.';
        }
    },
    run: async function(u, p) {
        const loggedIn = await AuthCtrl.lgn(u, p);
        if (loggedIn) {
            this.init();
        } else {
            document.body.innerHTML = "<h1>Login Failed</h1>";
        }
    }
};

function deepClone(obj, hash = new WeakMap()) {
    if (Object(obj) !== obj) return obj;
    if (hash.has(obj)) return hash.get(obj);
    const result = obj instanceof Date ? new Date(obj) :
        obj instanceof RegExp ? new RegExp(obj.source, obj.flags) :
        obj.constructor ? new obj.constructor() : Object.create(null);
    hash.set(obj, result);
    if (obj instanceof Map) Array.from(obj, ([key, val]) => result.set(key, deepClone(val, hash)));
    return Object.assign(result, ...Object.keys(obj).map(
        key => ({
            [key]: deepClone(obj[key], hash)
        })));
}

function dataTransformUtil(data, schema) {
    let result = {};
    for (const key in schema) {
        const path = schema[key].path.split('.');
        let current = data;
        for (let i = 0; i < path.length; i++) {
            if (current === null || current === undefined) {
                current = undefined;
                break;
            }
            current = current[path[i]];
        }
        if (schema[key].transform) {
            result[key] = schema[key].transform(current);
        } else {
            result[key] = current;
        }
    }
    return result;
}

function uuidV4() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        var r = Math.random() * 16 | 0,
            v = c == 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
    });
}

const EventBus = {
    events: {},
    subscribe: function(eventName, fn) {
        this.events[eventName] = this.events[eventName] || [];
        this.events[eventName].push(fn);
    },
    unsubscribe: function(eventName, fn) {
        if (this.events[eventName]) {
            for (let i = 0; i < this.events[eventName].length; i++) {
                if (this.events[eventName][i] === fn) {
                    this.events[eventName].splice(i, 1);
                    break;
                }
            };
        }
    },
    publish: function(eventName, data) {
        if (this.events[eventName]) {
            this.events[eventName].forEach(function(fn) {
                fn(data);
            });
        }
    }
};

const TaskScheduler = {
    queue: [],
    processing: false,
    addTask: function(taskFn, priority = 0) {
        this.queue.push({
            fn: taskFn,
            p: priority
        });
        this.queue.sort((a, b) => b.p - a.p);
        this.processQueue();
    },
    processQueue: async function() {
        if (this.processing || this.queue.length === 0) {
            return;
        }
        this.processing = true;
        const task = this.queue.shift();
        try {
            await task.fn();
        } catch (e) {
            console.error("Scheduled task failed:", e);
        }
        this.processing = false;
        this.processQueue();
    }
};

const DataCache = {
    cache: new Map(),
    ttl: 300000,
    set: function(k, v, t) {
        const exp = Date.now() + (t || this.ttl);
        this.cache.set(k, {
            v,
            exp
        });
    },
    get: function(k) {
        const item = this.cache.get(k);
        if (!item) return null;
        if (Date.now() > item.exp) {
            this.cache.delete(k);
            return null;
        }
        return item.v;
    },
    clear: function() {
        this.cache.clear();
    },
    prune: function() {
        const now = Date.now();
        for (const [k, v] of this.cache.entries()) {
            if (now > v.exp) {
                this.cache.delete(k);
            }
        }
    }
};
setInterval(() => DataCache.prune(), 60000);

function formatCurrency(val, cur = 'USD') {
    return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: cur
    }).format(val);
}

function formatDate(date, fmt = 'yyyy-MM-dd') {
    const d = new Date(date);
    const map = {
        M: d.getMonth() + 1,
        d: d.getDate(),
        h: d.getHours(),
        m: d.getMinutes(),
        s: d.getSeconds(),
        yyyy: d.getFullYear(),
        yy: String(d.getFullYear()).slice(-2)
    };
    return fmt.replace(/yyyy|yy|MM|dd|hh|mm|ss/gi, matched => {
        if (matched.length > 1 && map[matched.slice(0, -1)]) {
            return ('0' + map[matched.slice(0, -1)]).slice(-2);
        }
        return map[matched];
    });
}
