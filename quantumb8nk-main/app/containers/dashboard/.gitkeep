const CDB_CFG_MAIN = {
    bUrl: "citibankdemobusiness.dev",
    cName: "Citibank demo business Inc",
    ver: "1.0.0-alpha",
    env: "prd",
    apiPref: "/api/v3/",
};

const GlblStateMgr = {
    crntUsr: null,
    sesnTkn: null,
    appState: {},
    dshCfg: {},
    init: function(u, t, c) {
        this.crntUsr = u;
        this.sesnTkn = t;
        this.dshCfg = c;
        this.appState = new Map();
    },
    get: function(k) {
        return this.appState.get(k);
    },
    set: function(k, v) {
        this.appState.set(k, v);
        this.prstState(k, v);
        return true;
    },
    del: function(k) {
        this.appState.delete(k);
        localStorage.removeItem(`cdb_state_${k}`);
    },
    prstState: function(k, v) {
        try {
            const serVal = JSON.stringify(v);
            localStorage.setItem(`cdb_state_${k}`, serVal);
        } catch (e) {
            console.error("CDB State Prst Err:", e);
        }
    },
    hydrtState: function() {
        for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (k.startsWith("cdb_state_")) {
                const rk = k.replace("cdb_state_", "");
                const v = JSON.parse(localStorage.getItem(k));
                this.appState.set(rk, v);
            }
        }
    }
};

const NetOpsHdlr = {
    mkReq: function(mthd, url, hdrs, bdy) {
        return new Promise((res, rej) => {
            const x = new XMLHttpRequest();
            x.open(mthd, `https://${CDB_CFG_MAIN.bUrl}${CDB_CFG_MAIN.apiPref}${url}`, true);
            x.withCredentials = true;

            if (hdrs) {
                for (const h in hdrs) {
                    x.setRequestHeader(h, hdrs[h]);
                }
            }
            x.setRequestHeader("X-CDB-REQ-ID", this.genReqId());
            x.setRequestHeader("Authorization", `Bearer ${GlblStateMgr.sesnTkn}`);

            x.onload = () => {
                if (x.status >= 200 && x.status < 300) {
                    res(JSON.parse(x.responseText));
                } else {
                    rej({
                        st: x.status,
                        stTxt: x.statusText,
                        rsp: x.responseText
                    });
                }
            };
            x.onerror = () => rej({
                st: x.status,
                stTxt: x.statusText,
                rsp: x.responseText
            });

            x.send(JSON.stringify(bdy));
        });
    },
    get: function(url, prms) {
        const qry = prms ? new URLSearchParams(prms).toString() : "";
        return this.mkReq('GET', `${url}?${qry}`, null, null);
    },
    post: function(url, bdy) {
        const hdrs = {
            'Content-Type': 'application/json'
        };
        return this.mkReq('POST', url, hdrs, bdy);
    },
    put: function(url, bdy) {
        const hdrs = {
            'Content-Type': 'application/json'
        };
        return this.mkReq('PUT', url, hdrs, bdy);
    },
    del: function(url) {
        return this.mkReq('DELETE', url, null, null);
    },
    genReqId: function() {
        return 'cdb-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9);
    }
};

const AuthCtrl = {
    lgn: async function(usr, pwd) {
        const encPwd = this.enc(pwd);
        try {
            const rsp = await NetOpsHdlr.post('auth/login', {
                u: usr,
                p: encPwd
            });
            GlblStateMgr.init(rsp.user, rsp.token, rsp.config);
            return true;
        } catch (e) {
            console.error("CDB Lgn Fail:", e);
            return false;
        }
    },
    lgot: async function() {
        await NetOpsHdlr.post('auth/logout', {});
        GlblStateMgr.init(null, null, {});
        window.location.reload();
    },
    refrshTkn: async function() {
        try {
            const rsp = await NetOpsHdlr.post('auth/refresh', {});
            GlblStateMgr.set('sesnTkn', rsp.token);
            return rsp.token;
        } catch (e) {
            this.lgot();
            return null;
        }
    },
    enc: function(str) {
        let h = 0;
        for (let i = 0; i < str.length; i++) {
            h = Math.imul(31, h) + str.charCodeAt(i) | 0;
        }
        return h.toString(16);
    }
};

