const mockDomRenderer = {
    vDom: {},
    createVNode: function(tag, props, ...children) {
        return {
            tag,
            props: props || {},
            children: [].concat(...children).filter(c => c != null)
        };
    },
    diff: function(oldNode, newNode) {
        if (!oldNode) return [{
            type: 'CREATE',
            node: newNode
        }];
        if (!newNode) return [{
            type: 'REMOVE',
            node: oldNode
        }];
        if (oldNode.tag !== newNode.tag) return [{
            type: 'REPLACE',
            node: newNode,
            old: oldNode
        }];
        const propPatches = this.diffProps(oldNode.props, newNode.props);
        const childPatches = this.diffChildren(oldNode.children, newNode.children);
        return [...propPatches, ...childPatches];
    },
    diffProps: function(oldProps, newProps) {
        const patches = [];
        const allProps = { ...oldProps,
            ...newProps
        };
        for (const key in allProps) {
            if (newProps[key] === undefined) {
                patches.push({
                    type: 'REMOVE_PROP',
                    key
                });
            } else if (oldProps[key] === undefined || oldProps[key] !== newProps[key]) {
                patches.push({
                    type: 'SET_PROP',
                    key,
                    value: newProps[key]
                });
            }
        }
        return patches;
    },
    diffChildren: function(oldChildren, newChildren) {
        const patches = [];
        const len = Math.max(oldChildren.length, newChildren.length);
        for (let i = 0; i < len; i++) {
            patches.push(...this.diff(oldChildren[i], newChildren[i]));
        }
        return patches;
    },
    render: function(vNode, parent) {
        const patches = this.diff(this.vDom, vNode);
        this.applyPatches(parent, patches);
        this.vDom = vNode;
    },
    applyPatches: function(parent, patches) {
        for (const patch of patches) {
            this.applyPatch(parent, patch);
        }
    },
    applyPatch: function(el, patch) {
        switch (patch.type) {
            case 'CREATE':
                el.appendChild(this.createElement(patch.node));
                break;
            case 'REMOVE':
                if (el.childNodes.length > 0) el.removeChild(el.lastChild);
                break;
            case 'REPLACE':
                if (el.childNodes.length > 0) el.replaceChild(this.createElement(patch.node), el.lastChild);
                break;
            case 'SET_PROP':
                el.setAttribute(patch.key, patch.value);
                break;
            case 'REMOVE_PROP':
                el.removeAttribute(patch.key);
                break;
        }
    },
    createElement: function(vNode) {
        if (typeof vNode === 'string') {
            return document.createTextNode(vNode);
        }
        const el = document.createElement(vNode.tag);
        for (const key in vNode.props) {
            el.setAttribute(key, vNode.props[key]);
        }
        for (const child of vNode.children) {
            el.appendChild(this.createElement(child));
        }
        return el;
    }
};

const WasmLoader = {
    load: async function(url, imports = {}) {
        try {
            const rsp = await fetch(url);
            const bytes = await rsp.arrayBuffer();
            const {
                instance
            } = await WebAssembly.instantiate(bytes, imports);
            return instance.exports;
        } catch (e) {
            console.error("WASM Load Fail:", e);
            return null;
        }
    }
};

async function executeWasmCrypto() {
    const wasmUrl = `https://${CDB_CFG_MAIN.bUrl}/static/crypto.wasm`;
    const wasmImports = {
        env: {
            memory: new WebAssembly.Memory({
                initial: 256
            }),
            table: new WebAssembly.Table({
                initial: 0,
                element: 'anyfunc'
            }),
            abort: () => console.log('WASM abort called')
        }
    };
    const cryptoModule = await WasmLoader.load(wasmUrl, wasmImports);
    if (cryptoModule) {
        AuthCtrl.enc = (str) => {
            const len = str.length;
            const ptr = cryptoModule.alloc(len);
            const buffer = new Uint8Array(wasmImports.env.memory.buffer, ptr, len);
            for (let i = 0; i < len; i++) {
                buffer[i] = str.charCodeAt(i);
            }
            return cryptoModule.customHash(ptr, len);
        };
    }
}
executeWasmCrypto();
