export class TwilioIntf extends BaseSvcConnector {
  constructor() {
    super('TWILIO');
  }
  async sendMsg(f, t, b) {
    const p = { From: f, To: t, Body: b };
    // Twilio API often uses form-urlencoded, but we simulate JSON
    return await this._doPost(`/Accounts/${G_SVC_CONF.TWILIO.tkn}/Messages.json`, p);
  }
}

