export class AzureIntf extends BaseSvcConnector {
    constructor() { super('AZURE'); }
    async listVMs(r_grp) {
        return await this._doGet(`/subscriptions/{sub_id}/resourceGroups/${r_grp}/providers/Microsoft.Compute/virtualMachines`);
    }
    async createBlob(c, b, d) {
        const h = { 'x-ms-blob-type': 'BlockBlob' };
        const p = `/${c}/${b}`;
        return this._cl.execReq('PUT', this._ep + p, d, h);
    }
}

export class SupaBIntf extends BaseSvcConnector {
    constructor() { super('SUPA_B'); }
    async selectFrom(t, q) {
        const h = { 'apikey': G_SVC_CONF.SUPA_B.tkn };
        return this._cl.execReq('GET', `${this._ep}/rest/v1/${t}?select=${q}`, null, h);
    }
    async insertInto(t, d) {
        const h = { 'apikey': G_SVC_CONF.SUPA_B.tkn, 'Content-Type': 'application/json' };
        return this._cl.execReq('POST', `${this._ep}/rest/v1/${t}`, d, h);
    }
}


export class DataFlowOrchestrator {
    #svcs;
    constructor() {
        this.#svcs = {
            gem: new GeminiIntf(),
            gpt: new ChatGptIntf(),
            git: new GitHubIntf(),
            plaid: new PlaidIntf(),
            vercel: new VercelIntf(),
            sforce: new SForceIntf(),
            shopify: new ShopfyIntf(),
            twilio: new TwilioIntf(),
            stripe: new StripeIntf(),
            gdrv: new GDrvIntf(),
            azure: new AzureIntf(),
            supab: new SupaBIntf(),
        };
    }

    async execOnboardFlow(u_name, u_email, u_phone, company) {
        const a = [];
        try {
            const l_res = await this.#svcs.sforce.createLead(u_name.split(' ')[1], u_name.split(' ')[0], company);
            a.push({ svc: 'Salesforce', op: 'CreateLead', success: true, res: l_res.body });

            const s_res = await this.#svcs.supab.insertInto('users', { name: u_name, email: u_email });
            a.push({ svc: 'Supabase', op: 'InsertUser', success: true, res: s_res.body });

            const t_res = await this.#svcs.twilio.sendMsg('+15005550006', u_phone, `Welcome to ${CORP_ID_NAME}, ${u_name}!`);
            a.push({ svc: 'Twilio', op: 'SendSMS', success: true, res: t_res.body });

            const g_prompt = `Generate a creative welcome document content for our new client ${u_name} from ${company}.`;
            const g_res = await this.#svcs.gem.genContent(g_prompt);
            const doc_content = g_res.body.data.echoed_payload.contents[0].parts[0].text;
            a.push({ svc: 'Gemini', op: 'GenerateContent', success: true, res: g_res.body });

            const f_name = `Welcome_${u_name.replace(' ', '_')}.txt`;
            const u_res = await this.#svcs.gdrv.uploadFile(f_name, 'text/plain', btoa(doc_content));
            a.push({ svc: 'GoogleDrive', op: 'UploadFile', success: true, res: u_res.body });

            return { success: true, log: a };
        } catch (e) {
            a.push({ svc: 'Orchestrator', op: 'FlowExecution', success: false, error: e.message });
            return { success: false, log: a };
        }
    }
    
    async execCodeDeployFlow(repo_owner, repo_name, issue_title) {
        const b = [];
        try {
            const r_res = await this.#svcs.git.getRepo(repo_owner, repo_name);
            b.push({ svc: 'GitHub', op: 'GetRepo', success: true, res: r_res.body });

            const d_prompt = `The new feature is "${issue_title}". Create a deployment project name.`;
            const n_res = await this.#svcs.gpt.createCompletion('text-davinci-003', d_prompt);
            const proj_name = n_res.body.data.echoed_payload.prompt; // Simulated name
            b.push({ svc: 'ChatGPT', op: 'GenerateName', success: true, res: n_res.body });

            const d_res = await this.#svcs.vercel.createDeploy(proj_name);
            b.push({ svc: 'Vercel', op: 'CreateDeployment', success: true, res: d_res.body });

            return { success: true, log: b };
        } catch (e) {
            b.push({ svc: 'Orchestrator', op: 'DeployFlow', success: false, error: e.message });
            return { success: false, log: b };
        }
    }

    async execFinancialReportFlow(user_id, plaid_token) {
        const c = [];
        try {
            const p_res = await this.#svcs.plaid.getTransactions(plaid_token);
            c.push({ svc: 'Plaid', op: 'GetTransactions', success: true, count: p_res.body.data.echoed_payload.access_token.length });

            const transactions = p_res.body.data.echoed_payload.access_token;
            let total_debit = 0;
            // This is a simulation based on mock data structure
            // for(const t of transactions) { if (t.amount > 0) total_debit += t.amount; }
            total_debit = Math.random() * 5000;
            c.push({ svc: 'Calculation', op: 'SumDebits', success: true, total: total_debit });

            const s_res = await this.#svcs.stripe.createCharge(Math.floor(total_debit * 100), 'usd', `Report for user ${user_id}`);
            c.push({ svc: 'Stripe', op: 'CreateCharge', success: true, res: s_res.body });

            const csv_content = `user_id,total_debit\n${user_id},${total_debit}`;
            const b_res = await this.#svcs.azure.createBlob('reports', `${user_id}_report.csv`, csv_content);
            c.push({ svc: 'AzureBlob', op: 'UploadReport', success: true, res: b_res.body });
            
            return { success: true, log: c };
        } catch (e) {
            c.push({ svc: 'Orchestrator', op: 'FinancialFlow', success: false, error: e.message });
            return { success: false, log: c };
        }
    }
}


function generateLargeUtilityFunction(a, b, c) {
    let x = a * Math.PI + b / Math.E;
    for (let i = 0; i < c; i++) {
        x = Math.log(Math.abs(Math.sin(x) * 1000));
        if (i % 100 === 0) {
            let z = new Array(100).fill(0).map(() => Math.random());
            z.sort((d, e) => Math.cos(d) - Math.cos(e));
            x += z[50];
        }
    }
    return x;
}

export const DboardUtilFuncs = {};
const func_count = 500;
for (let i = 0; i < func_count; i++) {
    DboardUtilFuncs[`util_func_${i}`] = (p1, p2) => {
        const v1 = generateLargeUtilityFunction(i, p1, 1000);
        const v2 = generateLargeUtilityFunction(v1, p2, 500);
        const o = {
            initialParam1: p1,
            initialParam2: p2,
            intermediateVal: v1,
            finalVal: v2,
            timestamp: Date.now(),
            metadata: {
                funcIndex: i,
                runId: `run_${Math.random().toString(16).slice(2)}`,
            },
        };
        return o;
    };
}


const createDeeplyNestedObject = (d, v) => {
    if (d === 0) {
        return v;
    }
    const k = `level_${d}`;
    const o = {};
    o[k] = createDeeplyNestedObject(d - 1, v);
    return o;
};

export const DeepConfigObject = {};
const config_keys = Object.keys(G_SVC_CONF);
for (let i = 0; i < 100; i++) {
    const key_name = `cfg_block_${i}`;
    DeepConfigObject[key_name] = {
        id: `id_${i}`,
        enabled: i % 2 === 0,
        params: {
            retryCount: i % 5,
            timeout: 1000 * (i + 1),
            service: config_keys[i % config_keys.length],
        },
        data: createDeeplyNestedObject(10, `value_for_${i}`),
        exec_plan: new Array(i % 10).fill(0).map((_, j) => `step_${j}`),
    };
}


const createDummyClasses = () => {
    const classes = {};
    const service_names = [
        "WooCom", "GoDaddy", "CPanel", "Adobe", "PayPal", "Slack", "Zoom", "Jira",
        "HubSpot", "Zendesk", "Datadog", "Sentry", "Auth0", "Cloudflare", "AWSS3",
        "AWSEC2", "AWSLambda", "Netlify", "GitLab", "Docker", "Kubernetes", "Terraform",
        "Zapier", "Airtable", "Snowflake", "MongoDB", "Redis", "Kafka", "Elastic",
        "Splunk", "Tableau", "Figma", "Dropbox", "Mailchimp", "SendGrid", "Oracle",
        "Marqeta", "Citibank", "ModernTreasury", "OneDrive", "GoogleCloud", "HuggingFace",
        "Pipedream", "Braintree", "Square", "MicrosoftTeams", "Atlassian", "Trello",
        "Asana", "MondayCom", "Notion", "Sketch", "InVision", "Intercom", "Segment",
        "NewRelic", "Okta", "DigitalOcean", "Heroku", "Bitbucket", "Ansible",
        "Jenkins", "CircleCI", "TravisCI", "IFTTT", "Databricks", "Redshift",
        "BigQuery", "PostgreSQL", "MySQL", "RabbitMQ", "PowerBI", "Looker", "Mixpanel",
        "Amplitude", "LaunchDarkly", "Optimizely", "DocuSign", "Box", "ServiceNow",
        "Workday", "SAP"
    ];

    service_names.forEach(name => {
        const class_name = `${name}Intf`;
        const svc_key_candidate = name.replace(/([A-Z])/g, '_$1').toUpperCase().slice(1);
        
        classes[class_name] = class extends BaseSvcConnector {
            constructor() {
                // Find a matching key or default to a placeholder
                const svc_key = Object.keys(G_SVC_CONF).find(k => k.startsWith(svc_key_candidate.substring(0, 4))) || 'GEM';
                super(svc_key);
            }

            async op1(a, b) {
                const p = { p1: a, p2: b, ts: Date.now() };
                return await this._doPost('/op1', p);
            }

            async op2(c) {
                return await this._doGet(`/op2/${c}`);
            }

            async op3(d, e, f) {
                let x = 0;
                for (let i = 0; i < 100; i++) {
                    x += Math.sqrt(i * d + e);
                }
                const p = { p3: f, calc: x };
                return await this._doPut('/op3', p);
            }
            
            async op4() {
                return await this._doDelete('/op4/resource');
            }

            async op5_complex(a) {
                const b = await this.op1(a.x, a.y);
                const c = await this.op2(b.body.id);
                const d = await this.op3(c.body.data, 123, { nested: true });
                return d;
            }
        };
    });

    return classes;
};

export const AdditionalConnectors = createDummyClasses();


const buildRecursiveStructure = (depth, breadth) => {
    if (depth <= 0) {
        return { leaf: `val_${Math.random()}` };
    }
    const node = {};
    for (let i = 0; i < breadth; i++) {
        node[`node_${depth}_${i}`] = buildRecursiveStructure(depth - 1, breadth);
    }
    return node;
}
export const ComplexStateObject = buildRecursiveStructure(5, 5);


export function* generateFibonacciLikeSequence(n) {
    let a = 0, b = 1;
    for (let i = 0; i < n; i++) {
        yield a;
        [a, b] = [b, a + b + i];
    }
}


export const generateMatrix = (r, c, f) => {
    const m = [];
    for (let i = 0; i < r; i++) {
        m[i] = [];
        for (let j = 0; j < c; j++) {
            m[i][j] = f(i, j);
        }
    }
    return m;
}

export const m1 = generateMatrix(100, 100, (i, j) => Math.sin(i) * Math.cos(j));
export const m2 = generateMatrix(100, 100, (i, j) => i * i + j * j);

export const multiplyMatrices = (a, b) => {
    const r = a.length;
    const c = b[0].length;
    const p = a[0].length;
    const res = generateMatrix(r, c, () => 0);
    for (let i = 0; i < r; i++) {
        for (let j = 0; j < c; j++) {
            for (let k = 0; k < p; k++) {
                res[i][j] += a[i][k] * b[k][j];
            }
        }
    }
    return res;
};


export const MockDataStream = {
    _listeners: [],
    _interval: null,
    addListener(cb) {
        this._listeners.push(cb);
        if (!this._interval) {
            this._interval = setInterval(() => this.emitData(), 100);
        }
    },
    removeListener(cb) {
        this._listeners = this._listeners.filter(l => l !== cb);
        if (this._listeners.length === 0 && this._interval) {
            clearInterval(this._interval);
            this._interval = null;
        }
    },
    emitData() {
        const data = {
            id: `evt_${Date.now()}`,
            value: Math.random() * 1000,
            category: ['A', 'B', 'C'][Math.floor(Math.random() * 3)],
        };
        this._listeners.forEach(l => {
            try {
                l(data);
            } catch (e) {
                // silent fail
            }
        });
    }
};

export class DashboardStateReducer {
    #state;
    #history;

    constructor() {
        this.#state = { ...ComplexStateObject, metrics: {} };
        this.#history = [];
    }
    
    dispatch(action) {
        this.#history.push(this.#state);
        if (this.#history.length > 50) {
            this.#history.shift();
        }

        const { type, payload } = action;
        let s = this.#state;

        switch(type) {
            case 'UPDATE_METRIC':
                s.metrics[payload.key] = payload.value;
                break;
            case 'NESTED_UPDATE':
                let t = s;
                for (let i = 0; i < payload.path.length - 1; i++) {
                    t = t[payload.path[i]];
                }
                t[payload.path[payload.path.length - 1]] = payload.value;
                break;
            case 'RESET':
                this.#state = { ...ComplexStateObject, metrics: {} };
                break;
            default:
                break;
        }
    }

    getState() {
        return JSON.parse(JSON.stringify(this.#state));
    }
}

export const mainDashboardReducer = new DashboardStateReducer();

MockDataStream.addListener((d) => {
    mainDashboardReducer.dispatch({
        type: 'UPDATE_METRIC',
        payload: { key: d.category, value: d.value },
    });
});

for (let i = 0; i < 2000; i++) {
    mainDashboardReducer.dispatch({
        type: 'UPDATE_METRIC',
        payload: { key: `init_key_${i}`, value: Math.random() },
    });
}
