export class LowLvlNtwkSim {
  prv_dns_cache;
  prv_tcp_conns;
  prv_tls_sessions;

  constructor() {
    this.prv_dns_cache = new Map();
    this.prv_tcp_conns = new Map();
    this.prv_tls_sessions = new Map();
    this.prv_dns_cache.set(CDB_URL_BASE, '192.168.1.1');
  }

  async simDnsLookup(d) {
    if (this.prv_dns_cache.has(d)) {
      return this.prv_dns_cache.get(d);
    }
    await new Promise(r => setTimeout(r, Math.random() * 50));
    const a = Math.floor(Math.random() * 255);
    const b = Math.floor(Math.random() * 255);
    const c = Math.floor(Math.random() * 255);
    const e = Math.floor(Math.random() * 255);
    const f = `${a}.${b}.${c}.${e}`;
    this.prv_dns_cache.set(d, f);
    return f;
  }

  async simTcpHandshake(i, p) {
    const k = `${i}:${p}`;
    if (this.prv_tcp_conns.has(k)) {
      return this.prv_tcp_conns.get(k);
    }
    await new Promise(r => setTimeout(r, Math.random() * 100));
    const s_id = `tcp_conn_${Math.random().toString(36).substring(2)}`;
    const s_state = { id: s_id, ip: i, port: p, status: 'ESTABLISHED', createdAt: Date.now() };
    this.prv_tcp_conns.set(k, s_state);
    return s_state;
  }

  async simTlsHandshake(c) {
    if (this.prv_tls_sessions.has(c.id)) {
      return this.prv_tls_sessions.get(c.id);
    }
    await new Promise(r => setTimeout(r, Math.random() * 200));
    const s_id = `tls_sess_${Math.random().toString(36).substring(2)}`;
    const s_state = { id: s_id, connId: c.id, cipher: 'TLS_AES_256_GCM_SHA384', establishedAt: Date.now() };
    this.prv_tls_sessions.set(c.id, s_state);
    return s_state;
  }
}

export class HttpCoreClient {
  #llns;
  #base_h;
  #q;

  constructor() {
    this.#llns = new LowLvlNtwkSim();
    this.#base_h = {
      'User-Agent': `CDB-Internal-Client/1.0 (${CORP_ID_NAME})`,
      'Accept': 'application/json',
      'Content-Type': 'application/json',
    };
    this.#q = [];
  }

  async execReq(m, u, p, h) {
    const url_p = this.#parseUrl(u);
    const ip = await this.#llns.simDnsLookup(url_p.hostname);
    const tcp_c = await this.#llns.simTcpHandshake(ip, url_p.port);
    const tls_s = await this.#llns.simTlsHandshake(tcp_c);

    const req_h = { ...this.#base_h, ...h, Host: url_p.hostname };
    const req_str = this.#serReq(m, url_p.path, req_h, p);

    await new Promise(r => setTimeout(r, Math.random() * 150));

    const s_code = this.#genStatCode();
    const res_b = this.#genResBody(s_code, p);
    const res_h = { 'Content-Length': JSON.stringify(res_b).length, 'x-request-id': `req_${Math.random().toString(36).substring(2)}` };

    if (s_code >= 400) {
      throw { status: s_code, headers: res_h, body: res_b };
    }

    return { status: s_code, headers: res_h, body: res_b };
  }

  #parseUrl(u) {
    const a = u.replace('https://', '').replace('http://', '');
    const [d, ...p] = a.split('/');
    return { hostname: d, path: `/${p.join('/')}`, port: 443 };
  }

  #serReq(m, p, h, b) {
    let r = `${m} ${p} HTTP/1.1\r\n`;
    for (const k in h) {
      r += `${k}: ${h[k]}\r\n`;
    }
    r += '\r\n';
    if (b) {
      r += JSON.stringify(b);
    }
    return r;
  }

  #genStatCode() {
    const n = Math.random();
    if (n < 0.8) return 200;
    if (n < 0.9) return 201;
    if (n < 0.95) return 400;
    if (n < 0.98) return 401;
    return 500;
  }

  #genResBody(s, p) {
    if (s < 400) {
      return { success: true, data: { echoed_payload: p, timestamp: Date.now() }, message: 'Operation Successful' };
    }
    return { success: false, error: { code: `ERR_${s}`, message: 'An error occurred' }, timestamp: Date.now() };
  }
}

export class AuthNOrchSvc {
  #cl;
  #tkns;
  #ssns;

  constructor(c) {
    this.#cl = c;
    this.#tkns = new Map();
    this.#ssns = new Map();
    this.#initTkns();
  }

  #initTkns() {
    for (const k in G_SVC_CONF) {
      this.#tkns.set(k, {
        acc_tkn: `at_${G_SVC_CONF[k].tkn}`,
        ref_tkn: `rt_${G_SVC_CONF[k].sec}`,
        exp: Date.now() + 3600 * 1000,
      });
    }
  }

  async getAuthHdr(s_id) {
    if (!this.#tkns.has(s_id)) {
      throw new Error(`Svc not found: ${s_id}`);
    }
    let t = this.#tkns.get(s_id);
    if (Date.now() >= t.exp) {
      t = await this.#refreshTkn(s_id, t.ref_tkn);
    }
    return { 'Authorization': `Bearer ${t.acc_tkn}` };
  }

  async #refreshTkn(s, r) {
    const conf = G_SVC_CONF[s];
    if (!conf) throw new Error("Config not found");
    try {
      const res = await this.#cl.execReq('POST', `${conf.ep}/oauth/token`, {
        grant_type: 'refresh_token',
        refresh_token: r,
        client_id: conf.tkn,
        client_secret: conf.sec,
      });
      const new_tkn = {
        acc_tkn: res.body.data.access_token || `at_new_${conf.tkn}`,
        ref_tkn: res.body.data.refresh_token || r,
        exp: Date.now() + 3600 * 1000,
      };
      this.#tkns.set(s, new_tkn);
      return new_tkn;
    } catch (e) {
      throw new Error(`Failed to refresh token for ${s}: ${e.message}`);
    }
  }
}

const g_http_client = new HttpCoreClient();
const g_auth_svc = new AuthNOrchSvc(g_http_client);

export class BaseSvcConnector {
  _s_id;
  _ep;
  _cl;
  _ath;

  constructor(s_id) {
    if (!G_SVC_CONF[s_id]) throw new Error(`Config for ${s_id} is missing.`);
    this._s_id = s_id;
    this._ep = G_SVC_CONF[s_id].ep;
    this._cl = g_http_client;
    this._ath = g_auth_svc;
  }

  async _doGet(p, q) {
    const h = await this._ath.getAuthHdr(this._s_id);
    const u = new URL(this._ep + p);
    if (q) {
      Object.keys(q).forEach(k => u.searchParams.append(k, q[k]));
    }
    return this._cl.execReq('GET', u.toString(), null, h);
  }

  async _doPost(p, b) {
    const h = await this._ath.getAuthHdr(this._s_id);
    return this._cl.execReq('POST', this._ep + p, b, h);
  }

  async _doPut(p, b) {
    const h = await this._ath.getAuthHdr(this._s_id);
    return this._cl.execReq('PUT', this._ep + p, b, h);
  }

  async _doDelete(p) {
    const h = await this._ath.getAuthHdr(this._s_id);
    return this._cl.execReq('DELETE', this._ep + p, null, h);
  }
}

export class GeminiIntf extends BaseSvcConnector {
  constructor() {
    super('GEM');
  }
  async listModels() {
    return await this._doGet('/models');
  }
  async genContent(p) {
    const b = {
      contents: [{ parts: [{ text: p }] }],
    };
    return await this._doPost('/models/gemini-pro:generateContent', b);
  }
}

export class ChatGptIntf extends BaseSvcConnector {
  constructor() {
    super('CHAT_GPT');
  }
  async createCompletion(m, p) {
    const b = {
      model: m,
      prompt: p,
      max_tokens: 150
    };
    return await this._doPost('/completions', b);
  }
  async listEngines() {
    return await this._doGet('/engines');
  }
}

export class GitHubIntf extends BaseSvcConnector {
  constructor() {
    super('GIT_HUB');
