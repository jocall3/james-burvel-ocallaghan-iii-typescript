  }
  async createIssue(o, r, t, b) {
    const p = { title: t, body: b };
    return await this._doPost(`/repos/${o}/${r}/issues`, p);
  }
}

export class PlaidIntf extends BaseSvcConnector {
  constructor() {
    super('PLAID');
  }
  async createLinkTkn(u) {
    const b = {
      client_name: CORP_ID_NAME,
      user: { client_user_id: u },
      products: ['auth', 'transactions'],
      country_codes: ['US'],
      language: 'en',
    };
    return await this._doPost('/link/token/create', b);
  }
  async getTransactions(a) {
    const b = { access_token: a };
    return await this._doPost('/transactions/get', b);
  }
}

