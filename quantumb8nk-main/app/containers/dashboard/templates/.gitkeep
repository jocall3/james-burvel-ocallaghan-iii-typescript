class AnotherLargeClass {
    constructor() {
        this.data = new Array(100).fill(0).map(() => gen_id_str(20));
        this.lookup = new Map();
        this.data.forEach(d => this.lookup.set(d.substring(0, 5), d));
    }

    methodA() {
        return this.data.join(',');
    }

    methodB(key) {
        return this.lookup.get(key);
    }

    async methodC() {
        await proc_delay(50);
        this.data.push(gen_id_str(20));
        return this.data.length;
    }

    methodD() {
        let sum = 0;
        for (let i = 0; i < 100; i++) {
            for (let j = 0; j < 50; j++) {
                sum += Math.tan(i * j);
            }
        }
        return sum;
    }

    methodE() {
        const obj = {};
        for (let k = 0; k < 200; k++) {
            obj[`prop_${k}`] = {
                nested: {
                    value: Math.random(),
                    id: gen_id_str(8)
                }
            };
        }
        return JSON.stringify(obj).length;
    }
}

