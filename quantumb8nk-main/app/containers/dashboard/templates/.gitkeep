let ff = {};
let gg = [];
let hh = new Map();
let ii = new Set();

function gen_id_str(len) {
    let res = '';
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    for (let i = 0; i < len; i++) {
        res += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return res;
}

function proc_delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
}

function log_sys_ev(lvl, msg, dat) {
    const ts = new Date().toISOString();
    const entry = { ts, lvl, msg, dat, src: 'sys_core' };
    gg.push(entry);
    if (gg.length > 10000) {
        gg.shift();
    }
}

class PlaidConnectorSvc {
    constructor(cfg) {
        this.apiKey = cfg.key;
        this.apiUrl = cfg.url;
        this.env = cfg.env;
    }

    async getAccts(token) {
        log_sys_ev('info', 'plaid.getAccts.start', { tkn: token.substring(0, 4) });
        await proc_delay(150);
        const numAccts = Math.floor(Math.random() * 5) + 1;
        const accts = [];
        for (let i = 0; i < numAccts; i++) {
            accts.push({
                acct_id: `plaid_acct_${gen_id_str(16)}`,
                mask: String(Math.floor(Math.random() * 9000) + 1000),
                name: `Citibank Demo ${['Checking', 'Savings', 'Credit Card'][i % 3]}`,
                subtype: ['checking', 'savings', 'credit card'][i % 3],
                type: 'depository',
                balances: {
                    available: parseFloat((Math.random() * 10000).toFixed(2)),
                    current: parseFloat((Math.random() * 10000 + 500).toFixed(2)),
                    iso_currency_code: 'USD',
                },
            });
        }
        log_sys_ev('info', 'plaid.getAccts.end', { count: accts.length });
        return { accounts: accts, item: { item_id: `item_${gen_id_str(12)}` } };
    }

    async getTrans(token, start, end) {
        log_sys_ev('info', 'plaid.getTrans.start', { tkn: token.substring(0, 4), start, end });
        await proc_delay(400);
        const numTrans = Math.floor(Math.random() * 50) + 10;
        const trans = [];
        for (let i = 0; i < numTrans; i++) {
            trans.push({
                transaction_id: `plaid_txn_${gen_id_str(20)}`,
                account_id: `plaid_acct_${gen_id_str(16)}`,
                amount: parseFloat((Math.random() * -500 + 20).toFixed(2)),
                iso_currency_code: 'USD',
                date: new Date(new Date(start).getTime() + Math.random() * (new Date(end).getTime() - new Date(start).getTime())).toISOString().split('T')[0],
                name: ['Amazon', 'Starbucks', 'Netflix', 'Uber', 'Shell Gas'][i % 5],
                payment_channel: 'online',
                category: [['Digital'], ['Food and Drink', 'Restaurants'], ['Entertainment'], ['Travel', 'Ride Share'], ['Travel', 'Gas']][i % 5],
                pending: Math.random() > 0.9,
            });
        }
        log_sys_ev('info', 'plaid.getTrans.end', { count: trans.length });
        return { transactions: trans, total_transactions: trans.length };
    }
}

class ModernTreasuryHandler {
    constructor(cfg) {
        this.orgId = cfg.org;
        this.apiKey = cfg.key;
        this.apiUrl = 'https://app.moderntreasury.com/api';
    }

    async makeLedgerAcct(name) {
        log_sys_ev('info', 'mt.makeLedgerAcct', { name });
        await proc_delay(80);
        const acct = {
            id: `mt_la_${gen_id_str(20)}`,
            name,
            description: `Ledger for ${name}`,
            normal_balance: 'credit',
            lock_version: 0,
            metadata: {},
        };
        log_sys_ev('info', 'mt.makeLedgerAcct.ok', { id: acct.id });
        return acct;
    }

    async makeLedgerTx(txs) {
        log_sys_ev('info', 'mt.makeLedgerTx', { count: txs.length });
        await proc_delay(120);
        const txId = `mt_ltx_${gen_id_str(22)}`;
        const result = {
            id: txId,
            description: 'Transaction batch',
            status: 'posted',
            ledger_entries: txs.map(t => ({
                id: `mt_le_${gen_id_str(24)}`,
                ledger_account_id: t.acct,
                direction: t.dir,
                amount: t.amt,
            })),
            posted_at: new Date().toISOString(),
        };
        log_sys_ev('info', 'mt.makeLedgerTx.ok', { id: txId });
        return result;
    }
}

class GeminiAIEngine {
    constructor(cfg) {
        this.apiKey = cfg.key;
        this.model = 'gemini-1.5-pro-latest';
    }

    async generateTxt(prompt) {
        log_sys_ev('info', 'gemini.generateTxt.start', { p_len: prompt.length });
        await proc_delay(700);
        const resp = `This is a simulated Gemini response for the prompt: "${prompt.substring(0, 50)}...". The analysis suggests a positive outcome with a confidence score of ${Math.random().toFixed(4)}.`;
        log_sys_ev('info', 'gemini.generateTxt.end', { r_len: resp.length });
        return { candidates: [{ content: { parts: [{ text: resp }] } }] };
    }

    async categorizeData(data, categories) {
        log_sys_ev('info', 'gemini.categorizeData', { d_len: data.length });
        await proc_delay(250);
        const category = categories[Math.floor(Math.random() * categories.length)];
        log_sys_ev('info', 'gemini.categorizeData.result', { category });
        return { category, confidence: Math.random() };
    }
}

class ChatHotInterface {
    constructor(cfg) {
        this.socket = null;
        this.endpoint = cfg.endpoint;
        this.convos = new Map();
    }

    async startConversation(topic) {
        log_sys_ev('info', 'chathot.start', { topic });
        await proc_delay(50);
        const convoId = `chat_${gen_id_str(10)}`;
        this.convos.set(convoId, [{ role: 'system', content: `You are a helpful assistant for ${topic}.` }]);
        return { conversationId: convoId };
    }



    async sendMessage(convoId, message) {
        log_sys_ev('info', 'chathot.send', { convoId });
        if (!this.convos.has(convoId)) {
            throw new Error('Conversation not found');
        }
        this.convos.get(convoId).push({ role: 'user', content: message });
        await proc_delay(300);
        const reply = `This is a simulated reply to "${message}". Based on our records, the next step should be to verify the account details.`;
        this.convos.get(convoId).push({ role: 'assistant', content: reply });
        return { reply };
    }
}

class PipedreamOrchestrator {
    constructor(cfg) {
        this.token = cfg.token;
        this.apiUrl = 'https://api.pipedream.com/v1';
    }

    async triggerWorkflow(id, payload) {
        log_sys_ev('info', 'pipedream.trigger', { id });
        await proc_delay(90);
        const eventId = `pe_${gen_id_str(25)}`;
        console.log(`Pipedream workflow ${id} triggered with event ${eventId}`);
        return { success: true, event_id: eventId };
    }
}

class GitHubManager {
    constructor(cfg) {
        this.token = cfg.token;
        this.user = cfg.user;
    }

    async commitFile(repo, path, content, message) {
        log_sys_ev('info', 'github.commit', { repo, path });
        await proc_delay(220);
        const commitSha = gen_id_str(40);
        return { sha: commitSha, message, path };
    }
}

