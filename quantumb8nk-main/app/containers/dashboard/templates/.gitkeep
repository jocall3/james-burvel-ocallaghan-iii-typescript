function another_dummy_function_one(a, b, c) {
    let x = a * Math.random();
    let y = b + Math.random();
    let z = c / (Math.random() + 0.1);
    for(let i=0; i< a; i++) {
        x += Math.pow(y, 2);
        z -= Math.sqrt(x);
    }
    return {x, y, z};
}
