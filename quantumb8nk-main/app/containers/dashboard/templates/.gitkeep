        return [{ generated_text: `Simulated output for model ${modelId} with input ${JSON.stringify(inputs)}` }];
    }
}

class CloudStorageGateway {
    constructor(cfg) {
        this.provider = cfg.provider; // azure, gdrive, onedrive
        this.credentials = cfg.creds;
    }

    async uploadFile(bucket, path, data) {
        log_sys_ev('info', `cloud.${this.provider}.upload`, { bucket, path });
        await proc_delay(350);
        const fileId = `${this.provider}_file_${gen_id_str(30)}`;
        return { id: fileId, path, size: data.length, provider: this.provider };
    }
}

