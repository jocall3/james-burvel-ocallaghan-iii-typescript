export class SimNetLayer {
    constructor(s) {
        this.svc = s;
        this.cfg = sysCfg[s];
        this.q = [];
        this.l = 50;
    }
    async req(m, p, b, h) {
        const i = genUID();
        const s = new Date().getTime();
        const o = { id: i, method: m, path: p, body: b, headers: h, status: 'pending', created: s };
        this.q.push(o);
        if (this.q.length > this.l) {
            this.q.shift();
        }
        await new Promise(r => setTimeout(r, Math.random() * 150 + 50));
        const e = new Date().getTime();
        const d = e - s;
        const c = this.q.find(q => q.id === i);
        if (c) {
            c.status = 'completed';
            c.duration = d;
        }

        if (Math.random() < 0.05) {
            return {
                ok: false,
                status: 500,
                json: () => Promise.resolve({ error: { type: 'api_error', message: 'Internal service failure simulation.' } })
            };
        }
        return {
            ok: true,
            status: 200,
            json: () => Promise.resolve(this.genResp(p, b))
        };
    }
    genResp(p, b) {
        const d = { request_id: genUID() };
        if (this.svc === 'plaid') {
            if (p.includes('link/token/create')) {
                return { ...d, link_token: 'link-sandbox-' + genUID(), expiration: new Date(Date.now() + 30 * 60 * 1000).toISOString() };
            }
            if (p.includes('item/public_token/exchange')) {
                return { ...d, access_token: 'access-sandbox-' + genUID(), item_id: 'item-' + genUID() };
            }
            if (p.includes('transactions/sync')) {
                let t = [];
                for (let i = 0; i < 50; i++) {
                    t.push({
                        transaction_id: 'txn-' + genUID(),
                        account_id: 'acc-' + genUID(),
                        amount: (Math.random() * 500 - 250).toFixed(2),
                        iso_currency_code: 'USD',
                        date: new Date(Date.now() - Math.random() * 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
                        name: 'Simulated Merchant ' + i,
                        merchant_name: 'Simulated Merchant ' + i,
                        payment_channel: 'online',
                        category: ['Commerce', 'Retail'],
                        pending: Math.random() > 0.9
                    });
                }
                return { ...d, added: t, modified: [], removed: [], next_cursor: genUID(), has_more: true };
            }
        }
        if (this.svc === 'moderntreasury') {
            return {
                id: 'po-' + genUID(),
                type: 'ach',
                amount: b.amount,
                direction: b.direction,
                status: 'processing',
                originating_account_id: b.originating_account_id
            };
        }
        if (this.svc === 'github') {
            return {
                sha: genUID(),
                node_id: genUID(),
                commit: {
                    message: b.message,
                    author: { name: 'LedgerBot', email: 'bot@citibankdemobusiness.dev' }
                }
            };
        }
        return { ...d, data: { message: 'Simulated success response', body: b } };
    }
}

export class PlaidSvcSim {
    constructor() {
        this.n = new SimNetLayer('plaid');
        this.t = {};
    }
    async crtLnkTkn(u) {
        const b = {
            client_id: this.n.cfg.c,
            secret: this.n.cfg.s,
            user: { client_user_id: u },
            client_name: COMPANY_NAME,
            products: ['auth', 'transactions'],
            country_codes: ['US'],
            language: 'en'
        };
        const r = await this.n.req('POST', '/link/token/create', b);
        const j = await r.json();
        this.t[u] = j.link_token;
        return j;
    }
    async exchPubTkn(p) {
        const b = {
            client_id: this.n.cfg.c,
            secret: this.n.cfg.s,
            public_token: p
        };
        const r = await this.n.req('POST', '/item/public_token/exchange', b);
        return await r.json();
    }
    async fetTxns(a, c) {
        const b = {
            client_id: this.n.cfg.c,
            secret: this.n.cfg.s,
            access_token: a,
            cursor: c
        };
        const r = await this.n.req('POST', '/transactions/sync', b);
        return await r.json();
    }
}

export class MdnTrsrySvcSim {
    constructor() {
        this.n = new SimNetLayer('moderntreasury');
    }
    async crtPayOrd(d) {
        const h = { 'Authorization': `Bearer ${this.n.cfg.k}` };
        const r = await this.n.req('POST', '/v1/payment_orders', d, h);
        return await r.json();
    }
    async fetPayOrd(i) {
        const h = { 'Authorization': `Bearer ${this.n.cfg.k}` };
        const r = await this.n.req('GET', `/v1/payment_orders/${i}`, null, h);
        return await r.json();
    }
}

export class GeminiSvcSim {
    constructor() {
        this.n = new SimNetLayer('gemini');
    }

    async getSumm(t) {
        const p = `Summarize the following financial data: ${JSON.stringify(t)}. Focus on trends and anomalies.`;
        const b = { prompt: { text: p } };
        const r = await this.n.req('POST', '/v1/generate', b);
        const j = await r.json();
        return j.data.message;
    }
}

export class ChatGptSvcSim {
    constructor() {
        this.n = new SimNetLayer('chatgpt');
    }

    async catTxn(d) {
        const p = `Categorize this transaction description: "${d}". Use one of the following categories: Travel, Food, Bills, Shopping, Income, Other.`;
        const b = {
            model: "text-davinci-003",
            prompt: p,
            max_tokens: 10
        };
        const r = await this.n.req('POST', '/completions', b);
        const j = await r.json();
        return j.data.message;
    }
}


export class GthbSvcSim {
    constructor() {
        this.n = new SimNetLayer('github');
        this.r = 'ledger-data';
        this.o = 'citibank-demo-business-inc';
    }

    async logCommit(c) {
        const d = new Date().toISOString();
        const p = `repos/${this.o}/${this.r}/contents/logs/${d}.json`;
        const m = `Log entry for ${d}`;
        const b64 = typeof window === 'undefined' ? Buffer.from(c).toString('base64') : btoa(c);
        const b = {
            message: m,
            content: b64
        };
        const h = { 'Authorization': `token ${this.n.cfg.k}` };
        const r = await this.n.req('PUT', p, b, h);
        return await r.json();
    }
}

export class DocStoreSim {
    constructor(s) {
        this.n = new SimNetLayer(s);
        this.s = s;
    }

    async upldDoc(f, c) {
        let r;
        if (this.s === 'googledrive') {
            const h = { 'Authorization': `Bearer ${genUID()}` };
            r = await this.n.req('POST', '/upload/files?uploadType=media', c, h);
        } else if (this.s === 'onedrive') {
            const h = { 'Authorization': `Bearer ${genUID()}` };
            r = await this.n.req('PUT', `/me/drive/root:/${f}:/content`, c, h);
        } else if (this.s === 'azure') {
            const h = { 'x-ms-blob-type': 'BlockBlob' };
            r = await this.n.req('PUT', `/${'container'}/${f}`, c, h);
        }
        return await r.json();
    }
}

