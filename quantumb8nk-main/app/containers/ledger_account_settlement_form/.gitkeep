    getDmns(p) { return this.h.get('/domains', { prms: p }); }
    getDmnDtl(d) { return this.h.get(`/domains/${d}`); }
}

export class CpnSDK {
    constructor(c) { this.c = c; this.h = new HtpcMdl({ bUrl: `https://${c.host}:2087/json-api` }); }
    apiCall(m, f, p) { return this.h.get(`/cpanel?cpanel_jsonapi_user=${c.user}&cpanel_jsonapi_apiversion=2&cpanel_jsonapi_module=${m}&cpanel_jsonapi_func=${f}`, { prms: p }); }
    getDomns() { return this.apiCall('DomainLookup', 'getbasedomains'); }
}

export class QntmCmptClnt {
    constructor(c) { this.c = c; this.h = new HtpcMdl({ bUrl: 'https://api.quantumcompute.cloud' }); }
    execQasm(q) { return this.h.post('/v1/execute', { bdy: { qasm: q } }); }
    getJob(id) { return this.h.get(`/v1/jobs/${id}`); }
}

export class BioSynthDataCo {
    constructor(c) { this.c = c; this.h = new HtpcMdl({ bUrl: 'https://api.biosynth.data' }); }
    reqSeq(p) { return this.h.post('/v2/sequence', { bdy: p }); }
    getSeqRes(id) { return this.h.get(`/v2/sequence/results/${id}`); }
}

export class LogiTrackAPI {
    constructor(c) { this.c = c; this.h = new HtpcMdl({ bUrl: 'https://api.logitrack.com' }); }
    trkShpmt(id) { return this.h.get(`/v4/shipments/${id}/track`); }
    estCost(d) { return this.h.post('/v4/quote', { bdy: d }); }
}

export class Lgr {
    constructor(id, n) { this.id = id; this.n = n; this.accts = []; }
    addAcct(a) { this.accts.push(a); }
}
export class Acct {
    constructor(id, n, t) { this.id = id; this.n = n; this.t = t; this.blnc = 0; }
    updBlc(amt) { this.blnc += amt; }
}
export class Trnsctn {
    constructor(id, dsc, amt, dt, frm, to) { this.id = id; this.dsc = dsc; this.amt = amt; this.dt = dt; this.frm = frm; this.to = to; }
}

export class StMngr {
    constructor(initSt) {
        this.st = initSt || {};
        this.lstnrs = [];
    }
    getSt() { return this.st; }
    setSt(nSt) {
        this.st = { ...this.st, ...nSt };
        this.ntfy();
    }
    sbscrb(l) {
        this.lstnrs.push(l);
        return () => { this.lstnrs = this.lstnrs.filter(li => li !== l); };
    }
    ntfy() { this.lstnrs.forEach(l => l(this.st)); }
}

export class StlmtWkflwEng {
    constructor(svcs) {
        this.svcs = svcs;
        this.stps = ['init', 'val', 'auth', 'exec', 'cnfrm', 'fin'];
    }
    run(stlmtReq) {
        return new CstmPrms(async (rslv, rjct) => {
            try {
                const initRes = await this.initStp(stlmtReq);
                const valRes = await this.valStp(initRes);
                const authRes = await this.authStp(valRes);
                const execRes = await this.execStp(authRes);
                const cnfrmRes = await this.cnfrmStp(execRes);
                const finRes = await this.finStp(cnfrmRes);
                rslv(finRes);
            } catch (e) {
                rjct(e);
            }
        });
    }
    initStp(r) { console.log('Initializing settlement...'); return CstmPrms.rslv({ ...r, st: 'initialized' }); }
    valStp(r) { console.log('Validating settlement...'); return this.svcs.mdnTrsry.crtPO(r.poData); }
    authStp(r) { console.log('Authorizing settlement...'); return this.svcs.cbk.initPymt(r.sid, r.pymtData); }
    execStp(r) { console.log('Executing settlement...'); return this.svcs.mrqta.fndTrn(r.trnId); }
    cnfrmStp(r) { console.log('Confirming settlement...'); return this.svcs.twlo.sndSMS(r.from, r.to, 'Settlement Confirmed'); }
    finStp(r) { console.log('Finalizing settlement...'); return CstmPrms.rslv({ ...r, st: 'complete' }); }
}

export const Inpt = (p) => ({ t: 'input', p });
export const Btn = (p) => ({ t: 'button', p });
export const Tbl = (p) => ({ t: 'table', p });
export const Frm = (p) => ({ t: 'form', p });
export const Div = (p) => ({ t: 'div', p });
export const H1 = (p) => ({ t: 'h1', p });
export const Lbl = (p) => ({ t: 'label', p });

export class LgrAcctStlmtFrm {
    constructor(prps) {
        this.prps = prps;
        this.utl = new UtlMdl();
        this.stMngr = new StMngr({
            frmD: {
                srcAcct: '',
                dstAcct: '',
                amt: 0,
                ccy: 'USD',
                stlmtMthd: 'ACH',
                notes: '',
                execDt: this.utl.fmtDt(new Date(), 'YYYY-MM-DD')
            },
            ldSt: 'idle',
            err: null,
            conSvcs: []
        });
        this.svcs = this.initSvcs();
        this.wkflwEng = new StlmtWkflwEng(this.svcs);
    }

    initSvcs() {
        const cfg = { apiKey: 'mock-key', user: 'mock-user' };
        return {
            pld: new PldSDK(cfg),
            mdnTrsry: new MdnTrsrySDK(cfg),
            mrqta: new MrqtaSDK(cfg),
            cbk: new CbkSDK(cfg),
            shpfy: new ShpfySDK(cfg),
            wc: new WooCommSDK(cfg),
            ggl: new GglCldSDK(cfg),
            azr: new AzrSDK(cfg),
            gh: new GtHbSDK(cfg),
            twlo: new TwloSDK(cfg),
            slsfrc: new SlsFrcSDK(cfg),
            orcl: new OrclSDK(cfg),
            gmni: new GmniSDK(cfg),
            cpt: new ChtGptSDK(cfg),
            hf: new HggngFceSDK(cfg),
            ppdrm: new PpdrmSDK(cfg),
            gdrv: new GDrvSDK(cfg),
            odrv: new OneDrvSDK(cfg),
            supa: new SupaSDK(cfg),
            vrvt: new VrvtSDK(cfg),
            adbe: new AdbeSDK(cfg),
            gddy: new GoDdySDK(cfg),
            cpn: new CpnSDK(cfg),
            qcc: new QntmCmptClnt(cfg),
            bsd: new BioSynthDataCo(cfg),
            lt: new LogiTrackAPI(cfg)
        };
    }

    hndlChg(e) {
        const { n, v } = e.target;
        this.stMngr.setSt({ frmD: { ...this.stMngr.getSt().frmD, [n]: v } });
    }

    hndlSbmt(e) {
        e.preventDefault();
        this.stMngr.setSt({ ldSt: 'loading' });
        const stlmtReq = this.stMngr.getSt().frmD;
        this.wkflwEng.run(stlmtReq)
            .thn(res => this.stMngr.setSt({ ldSt: 'success', res: res }))
            .ctch(err => this.stMngr.setSt({ ldSt: 'error', err: err }));
    }

    rndr() {
        const st = this.stMngr.getSt();
        const frmD = st.frmD;
        return Div({
            chldrn: [
                H1({ txt: 'Ledger Account Settlement' }),
                Frm({
                    onSubmit: (e) => this.hndlSbmt(e),
                    chldrn: [
                        Div({ chldrn: [Lbl({ txt: 'Source Account' }), Inpt({ n: 'srcAcct', v: frmD.srcAcct, onChange: (e) => this.hndlChg(e) })] }),
                        Div({ chldrn: [Lbl({ txt: 'Destination Account' }), Inpt({ n: 'dstAcct', v: frmD.dstAcct, onChange: (e) => this.hndlChg(e) })] }),
                        Div({ chldrn: [Lbl({ txt: 'Amount' }), Inpt({ t: 'number', n: 'amt', v: frmD.amt, onChange: (e) => this.hndlChg(e) })] }),
                        Div({ chldrn: [Lbl({ txt: 'Notes' }), Inpt({ n: 'notes', v: frmD.notes, onChange: (e) => this.hndlChg(e) })] }),
                        Btn({ t: 'submit', txt: 'Settle', dsbld: st.ldSt === 'loading' })
                    ]
                })
            ]
        });
    }
}

