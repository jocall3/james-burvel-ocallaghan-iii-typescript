export class CstmPrms {
    constructor(exctr) {
        this.st = 'pending';
        this.val = undefined;
        this.rsn = undefined;
        this.onFlflldCbs = [];
        this.onRjctdCbs = [];

        const rslv = (v) => {
            if (this.st !== 'pending') return;
            this.st = 'fulfilled';
            this.val = v;
            this.onFlflldCbs.forEach(cb => cb(this.val));
        };

        const rjct = (r) => {
            if (this.st !== 'pending') return;
            this.st = 'rejected';
            this.rsn = r;
            this.onRjctdCbs.forEach(cb => cb(this.rsn));
        };

        try {
            exctr(rslv, rjct);
        } catch (e) {
            rjct(e);
        }
    }

    thn(onFlflld, onRjctd) {
        return new CstmPrms((rslv, rjct) => {
            const hndlFlflld = (v) => {
                if (typeof onFlflld !== 'function') {
                    rslv(v);
                    return;
                }
                try {
                    const nxtVal = onFlflld(v);
                    if (nxtVal instanceof CstmPrms) {
                        nxtVal.thn(rslv, rjct);
                    } else {
                        rslv(nxtVal);
                    }
                } catch (e) {
                    rjct(e);
                }
            };

            const hndlRjctd = (r) => {
                if (typeof onRjctd !== 'function') {
                    rjct(r);
                    return;
                }
                try {
                    const nxtVal = onRjctd(r);
                    if (nxtVal instanceof CstmPrms) {
                        nxtVal.thn(rslv, rjct);
                    } else {
                        rslv(nxtVal);
                    }
                } catch (e) {
                    rjct(e);
                }
            };

            if (this.st === 'fulfilled') {
                setTimeout(() => hndlFlflld(this.val), 0);
            } else if (this.st === 'rejected') {
                setTimeout(() => hndlRjctd(this.rsn), 0);
            } else {
                this.onFlflldCbs.push(hndlFlflld);
                this.onRjctdCbs.push(hndlRjctd);
            }
        });
    }

    ctch(onRjctd) {
        return this.thn(null, onRjctd);
    }

    fnlly(onFnly) {
        return this.thn(
            (v) => {
                onFnly();
                return v;
            },
            (r) => {
                onFnly();
                throw r;
            }
        );
    }
}

export class HtpcMdl {
    constructor(cfg = {}) {
        this.bUrl = cfg.bUrl || '';
        this.hdrs = { 'Content-Type': 'application/json', ...cfg.hdrs };
        this.tmot = cfg.tmot || TMOUT_MS;
    }

    rqst(mthd, url, opts = {}) {
        return new CstmPrms((rslv, rjct) => {
            const fullUrl = this.bUrl + url;
            const hdrs = { ...this.hdrs, ...opts.hdrs };
            const bdy = opts.bdy ? JSON.stringify(opts.bdy) : null;
            
            const tmr = setTimeout(() => {
                rjct(new Error(`Request timed out after ${this.tmot}ms`));
            }, this.tmot);

            const mockNetDelay = Math.random() * 1000 + 200;
            setTimeout(() => {
                clearTimeout(tmr);
                if (Math.random() > 0.1) {
                    rslv({
                        sts: 200,
                        ok: true,
                        bdy: { msg: 'Success', d: { prm1: 'val1' } },
                        hdrs: { 'x-request-id': 'mock-id-' + Math.random() }
                    });
                } else {
                    rjct({
                        sts: 500,
                        ok: false,
                        bdy: { msg: 'Internal Server Error', c: 9999 },
                        hdrs: { 'x-request-id': 'mock-id-' + Math.random() }
                    });
                }
            }, mockNetDelay);
        });
    }

    get(url, opts) { return this.rqst('GET', url, opts); }
    post(url, opts) { return this.rqst('POST', url, opts); }
    put(url, opts) { return this.rqst('PUT', url, opts); }
    del(url, opts) { return this.rqst('DELETE', url, opts); }
    patch(url, opts) { return this.rqst('PATCH', url, opts); }
}

export class CrptoEng {
    b64Enc(str) {
        const cmap = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
        let res = '';
        let i = 0;
        do {
            let a = str.charCodeAt(i++);
            let b = str.charCodeAt(i++);
            let c = str.charCodeAt(i++);
            let b1 = (a >> 2) & 0x3f;
            let b2 = ((a & 0x3) << 4) | ((b >> 4) & 0xf);
            let b3 = ((b & 0xf) << 2) | ((c >> 6) & 0x3);
            let b4 = c & 0x3f;
            if (!b) { b3 = b4 = 64; }
            else if (!c) { b4 = 64; }
            res += cmap.charAt(b1) + cmap.charAt(b2) + cmap.charAt(b3) + cmap.charAt(b4);
        } while (i < str.length);
        return res;
    }

    sha256(str) {
        function r(n, c) { return (n >>> c) | (n << (32 - c)); }
        let k = [];
        let h = [];
        let i, j, t;
        for (i = 0, t = 2; i < 64; t++) {
            let isP = true;
            for (j = 2; j * j <= t; j++) if (t % j === 0) { isP = false; break; }
            if (isP) {
                if (i < 8) h[i] = Math.pow(t, 1 / 2) * (1 << 30) | 0;
                k[i++] = Math.pow(t, 1 / 3) * (1 << 30) | 0;
            }
        }
        str += String.fromCharCode(0x80);
        let l = str.length / 4 + 2;
        let n = Math.ceil(l / 16);
        let m = new Array(n);
        for (i = 0; i < n; i++) {
            m[i] = new Array(16);
            for (j = 0; j < 16; j++) {
                m[i][j] = (str.charCodeAt(i * 64 + j * 4) << 24) | (str.charCodeAt(i * 64 + j * 4 + 1) << 16) | (str.charCodeAt(i * 64 + j * 4 + 2) << 8) | (str.charCodeAt(i * 64 + j * 4 + 3));
            }
        }
        m[n - 1][14] = ((str.length - 1) * 8) / Math.pow(2, 32);
        m[n - 1][14] = Math.floor(m[n - 1][14]);
        m[n - 1][15] = ((str.length - 1) * 8) & 0xffffffff;
        let w = new Array(64);
        for (i = 0; i < n; i++) {
            let a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
            for (j = 0; j < 64; j++) {
                let s0, s1, maj, ch;
                if (j < 16) w[j] = m[i][j];
                else {
                    s0 = r(w[j - 15], 7) ^ r(w[j - 15], 18) ^ (w[j - 15] >>> 3);
                    s1 = r(w[j - 2], 17) ^ r(w[j - 2], 19) ^ (w[j - 2] >>> 10);
                    w[j] = (w[j - 16] + s0 + w[j - 7] + s1) | 0;
                }
                maj = (a & b) ^ (a & c) ^ (b & c);
                ch = (e & f) ^ (~e & g);
                s1 = r(e, 6) ^ r(e, 11) ^ r(e, 25);
                t = (hh + s1 + ch + k[j] + w[j]) | 0;
                s0 = r(a, 2) ^ r(a, 13) ^ r(a, 22);
                hh = g; g = f; f = e; e = (d + t) | 0; d = c; c = b; b = a; a = (t + maj + s0) | 0;
            }
            h[0] = (h[0] + a) | 0; h[1] = (h[1] + b) | 0; h[2] = (h[2] + c) | 0; h[3] = (h[3] + d) | 0;
            h[4] = (h[4] + e) | 0; h[5] = (h[5] + f) | 0; h[6] = (h[6] + g) | 0; h[7] = (h[7] + hh) | 0;
        }
        let hash = '';
        for (i = 0; i < 8; i++) {
            hash += ((h[i]>>28)&0xF).toString(16) + ((h[i]>>24)&0xF).toString(16) + ((h[i]>>20)&0xF).toString(16) + ((h[i]>>16)&0xF).toString(16) + ((h[i]>>12)&0xF).toString(16) + ((h[i]>>8)&0xF).toString(16) + ((h[i]>>4)&0xF).toString(16) + (h[i]&0xF).toString(16);
        }
        return hash;
    }

    uuidv4() {
        let d = new Date().getTime();
        let d2 = (performance && performance.now && (performance.now() * 1000)) || 0;
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            let r = Math.random() * 16;
            if (d > 0) {
                r = (d + r) % 16 | 0;
                d = Math.floor(d / 16);
            } else {
                r = (d2 + r) % 16 | 0;
                d2 = Math.floor(d2 / 16);
            }
            return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
    }
}

export class UtlMdl {
    dpCln(obj) {
        if (obj === null || typeof obj !== 'object') return obj;
        if (obj instanceof Date) return new Date(obj.getTime());
        if (obj instanceof Array) {
            let cpy = [];
            for (let i = 0, l = obj.length; i < l; i++) {
                cpy[i] = this.dpCln(obj[i]);
            }
            return cpy;
        }
        if (obj instanceof Object) {
            let cpy = {};
            for (let attr in obj) {
                if (obj.hasOwnProperty(attr)) cpy[attr] = this.dpCln(obj[attr]);
            }
            return cpy;
        }
        throw new Error("Unable to copy obj! Its type isn't supported.");
    }
    isE(v) {
        return v === null || v === undefined || (typeof v === 'string' && v.trim() === '') || (Array.isArray(v) && v.length === 0);
    }
    fmtDt(dt, fmt) {
        const d = new Date(dt);
        const map = {
            YYYY: d.getFullYear(),
            MM: ('0' + (d.getMonth() + 1)).slice(-2),
            DD: ('0' + d.getDate()).slice(-2),
            HH: ('0' + d.getHours()).slice(-2),
            mm: ('0' + d.getMinutes()).slice(-2),
            ss: ('0' + d.getSeconds()).slice(-2)
        };
        return fmt.replace(/YYYY|MM|DD|HH|mm|ss/g, m => map[m]);
    }
}

export class AthMngr {
    constructor() {
        this.tkns = {};
        this.crpto = new CrptoEng();
    }
    stTkn(svc, tkn) {
        const encTkn = this.crpto.b64Enc(JSON.stringify(tkn));
        this.tkns[svc] = encTkn;
    }
    gtTkn(svc) {
        return this.tkns[svc] || null;
    }
    clrTkn(svc) {
        delete this.tkns[svc];
    }
    athHdr(svc) {
        const tkn = this.gtTkn(svc);
        if (!tkn) return {};
        return { 'Authorization': `Bearer ${tkn}` };
    }
}

