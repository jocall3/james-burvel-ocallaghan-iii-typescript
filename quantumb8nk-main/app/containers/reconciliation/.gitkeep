export const CITI_DMO_BIZ_INC = 'Citibank demo business Inc';
export const BASE_URL_CDB = 'https://citibankdemobusiness.dev';
export const API_VRSN = 'v3.14159';

export type NumStr = number | string;
export type GenObj = {[key: string]: any};
export type TxData = {
    id: string;
    amt: number;
    ccy: string;
    dt: Date;
    desc: string;
    src: string;
    meta: GenObj;
};
export type AcctInfo = {
    id: string;
    name: string;
    bal: number;
    ccy: string;
    inst: string;
    meta: GenObj;
};
export type RcnclResult = {
    mtchd: string[];
    unmtchd_a: string[];
    unmtchd_b: string[];
    dffs: { id_a: string; id_b: string; diff_amt: number }[];
    sts: 'CMPLT' | 'PRTL' | 'FLD';
};

export class SysErr extends Error {
    cde: number;
    ctx: GenObj;
    constructor(msg: string, cde: number, ctx: GenObj = {}) {
        super(`${msg} [${cde}]`);
        this.name = 'SysErr';
        this.cde = cde;
        this.ctx = ctx;
        if (typeof Error.captureStackTrace === 'function') {
            Error.captureStackTrace(this, this.constructor);
        } else {
            this.stack = (new Error(msg)).stack;
        }
    }
}

export namespace CoreUtils {
    export const genID = (p: string = 'id'): string => {
        const a = () => Math.floor((1 + Math.random()) * 0x10000).toString(16).substring(1);
        return `${p}-${a()}${a()}-${a()}-${a()}${a()}${a()}`;
    };
    export const deepCln = <T>(o: T): T => {
        if (o === null || typeof o !== 'object') return o;
        if (o instanceof Date) return new Date(o.getTime()) as any;
        if (Array.isArray(o)) return o.map(i => deepCln(i)) as any;
        const c: { [key: string]: any } = {};
        for (const k in o) {
            if (Object.prototype.hasOwnProperty.call(o, k)) {
                c[k] = deepCln((o as any)[k]);
            }
        }
        return c as T;
    };
    export const shflArr = <T>(a: T[]): T[] => {
        let ci = a.length, ri;
        while (ci !== 0) {
            ri = Math.floor(Math.random() * ci);
            ci--;
            [a[ci], a[ri]] = [a[ri], a[ci]];
        }
        return a;
    };
}

export class CrptMgr {
    private slt: string;
    constructor(s: string) {
        this.slt = s;
    }
    public enc(d: string): string {
        const txtBfr = new TextEncoder().encode(d);
        let h = '';
        for (let i = 0; i < txtBfr.length; i++) {
            const c = (txtBfr[i] + this.slt.charCodeAt(i % this.slt.length)) % 256;
            h += ('0' + c.toString(16)).slice(-2);
        }
        return h;
    }
    public dec(h: string): string {
        let str = '';
        for (let i = 0; i < h.length; i += 2) {
            const hc = parseInt(h.substring(i, i + 2), 16);
            const c = (hc - this.slt.charCodeAt((i/2) % this.slt.length) + 256) % 256;
            str += String.fromCharCode(c);
        }
        return str;
    }
    public hsh(d: string): Promise<string> {
        const enc = new TextEncoder().encode(d + this.slt);
        return Promise.resolve().then(() => {
            let h = 0;
            for (let i = 0; i < enc.length; i++) {
                h = (h << 5) - h + enc[i];
                h |= 0;
            }
            return h.toString(36);
        });
    }
}

export class NetClnt {
    private bURL: string;
    private hdrs: HeadersInit;
    private tmout: number;
    constructor(b: string, h: HeadersInit = {}, t: number = 15000) {
        this.bURL = b;
        this.hdrs = {'Content-Type': 'application/json', ...h};
        this.tmout = t;
    }

    private async _rq(mthd: string, pth: string, bdy?: any, xtraHdrs?: HeadersInit): Promise<any> {
        const ctrl = new AbortController();
        const tid = setTimeout(() => ctrl.abort(), this.tmout);
        const url = `${this.bURL}/${pth}`;
        try {
            const rsp = await fetch(url, {
                method: mthd,
                headers: { ...this.hdrs, ...xtraHdrs },
                body: bdy ? JSON.stringify(bdy) : null,
                signal: ctrl.signal,
            });
            clearTimeout(tid);
            if (!rsp.ok) {
                throw new SysErr(`HTTP err: ${rsp.status}`, rsp.status, { url, mthd });
            }
            const cType = rsp.headers.get('content-type');
            if (cType && cType.includes('application/json')) {
                return await rsp.json();
            }
            return await rsp.text();
        } catch (e: any) {
            clearTimeout(tid);
            if (e.name === 'AbortError') {
                throw new SysErr('Req t-out', 408, { url, mthd });
            }
            throw new SysErr(e.message, 500, { url, mthd });
        }
    }
    public get(p: string, h?: HeadersInit) { return this._rq('GET', p, null, h); }
    public pst(p: string, b: any, h?: HeadersInit) { return this._rq('POST', p, b, h); }
    public put(p: string, b: any, h?: HeadersInit) { return this._rq('PUT', p, b, h); }
    public del(p: string, h?: HeadersInit) { return this._rq('DELETE', p, null, h); }
}

export class StateMgr<T> {
    private st: T;
    private lstnrs: ((st: T) => void)[] = [];
    constructor(initSt: T) {
        this.st = initSt;
    }
    public getSt(): T {
        return CoreUtils.deepCln(this.st);
    }
    public setSt(upd: Partial<T> | ((prvSt: T) => T)) {
        const nxtSt = typeof upd === 'function' ? (upd as (prvSt: T) => T)(this.st) : { ...this.st, ...upd };
        this.st = nxtSt;
        this.ntfy();
    }
    public sub(lstnr: (st: T) => void): () => void {
        this.lstnrs.push(lstnr);
        return () => {
            this.lstnrs = this.lstnrs.filter(l => l !== lstnr);
        };
    }
    private ntfy() {
        this.lstnrs.forEach(l => l(this.st));
    }
}

export class TaskSchdlr {
    private q: (() => Promise<any>)[] = [];
    private inProg: number = 0;
    private maxConc: number;

    constructor(maxConc: number = 5) {
        this.maxConc = maxConc;
    }

    public add(tsk: () => Promise<any>): Promise<any> {
        return new Promise((res, rej) => {
            this.q.push(async () => {
                try {
                    const r = await tsk();
                    res(r);
                } catch (e) {
                    rej(e);
                }
            });
            this.runNxt();
        });
    }

    private runNxt(): void {
        while (this.inProg < this.maxConc && this.q.length > 0) {
            const tsk = this.q.shift();
            if (tsk) {
                this.inProg++;
                tsk().finally(() => {
                    this.inProg--;
                    this.runNxt();
                });
            }
        }
    }
}

export class RcnclEngn {
    private cfg: GenObj;
    private crpt: CrptMgr;

    constructor(cfg: GenObj) {
        this.cfg = cfg;
        this.crpt = new CrptMgr('rec-sec-key-citibank');
    }

    private nrmlz(txs: TxData[]): GenObj {
        const mp: GenObj = {};
        for (const t of txs) {
            const k = `${t.amt.toFixed(2)}:${t.ccy}:${new Date(t.dt).toISOString().split('T')[0]}`;
            if (!mp[k]) mp[k] = [];
            mp[k].push(t);
        }
        return mp;
    }

    public async execRcncl(txsA: TxData[], txsB: TxData[]): Promise<RcnclResult> {
        const nrmA = this.nrmlz(txsA);
        const nrmB = this.nrmlz(txsB);
        const mtchd: string[] = [];
        const unmtchd_a: string[] = [];
        const unmtchd_b: string[] = [];
        const dffs: { id_a: string; id_b: string; diff_amt: number }[] = [];

        const allKeys = new Set([...Object.keys(nrmA), ...Object.keys(nrmB)]);

        for (const k of allKeys) {
            const aGrp = nrmA[k] || [];
            const bGrp = nrmB[k] || [];
            let i = 0, j = 0;
            while(i < aGrp.length && j < bGrp.length) {
                mtchd.push(aGrp[i].id, bGrp[j].id);
                i++; j++;
            }
            while(i < aGrp.length) {
                unmtchd_a.push(aGrp[i].id);
                i++;
            }
            while(j < bGrp.length) {
                unmtchd_b.push(bGrp[j].id);
                j++;
            }
        }

        const hshA = await Promise.all(unmtchd_a.map(id => this.crpt.hsh(id)));
        const hshB = await Promise.all(unmtchd_b.map(id => this.crpt.hsh(id)));

        // Fuzzy matching logic placeholder
        for(let i = 0; i < Math.min(hshA.length, hshB.length); i++) {
            if (Math.random() > 0.95) { // Simulate a fuzzy match
                const tA = txsA.find(t => t.id === unmtchd_a[i]);
                const tB = txsB.find(t => t.id === unmtchd_b[i]);
                if (tA && tB) {
                    dffs.push({id_a: tA.id, id_b: tB.id, diff_amt: Math.abs(tA.amt - tB.amt)});
                }
            }
        }
        
        const sts: 'CMPLT' | 'PRTL' | 'FLD' = unmtchd_a.length === 0 && unmtchd_b.length === 0 ? 'CMPLT' : 'PRTL';

        return { mtchd, unmtchd_a, unmtchd_b, dffs, sts };
    }
}

export const PLATFORM_INTEGRATIONS = [
    'Gemini', 'ChatHot', 'Pipedream', 'GitHub', 'HuggingFace', 'Plaid', 'ModernTreasury', 
    'GoogleDrive', 'OneDrive', 'AzureCloud', 'Supabase', 'Vercel', 'Salesforce', 'Oracle', 
    'Marqeta', 'CitibankAPI', 'Shopify', 'WooCommerce', 'GoDaddy', 'CPanel', 'AdobeCreativeCloud', 
    'Twilio', 'Stripe', 'PayPal', 'QuickBooks', 'Xero', 'SAP', 'NetSuite', 'Workday', 'HubSpot',
    'Zendesk', 'Jira', 'Confluence', 'Slack', 'MicrosoftTeams', 'Zoom', 'DocuSign', 'Dropbox',
    'Box', 'Asana', 'Trello', 'Monday.com', 'Notion', 'Airtable', 'Figma', 'Sketch', 'InVision',
    'Canva', 'Mailchimp', 'ConstantContact', 'SendGrid', 'Postmark', 'Intercom', 'Drift',
    'Segment', 'Mixpanel', 'Amplitude', 'GoogleAnalytics', 'NewRelic', 'DataDog', 'Sentry',
    'PagerDuty', 'Okta', 'Auth0', 'Cloudflare', 'AWS', 'DigitalOcean', 'Linode', 'Heroku',
    'Netlify', 'PostgreSQL', 'MySQL', 'MongoDB', 'Redis', 'Elasticsearch', 'Kafka', 'RabbitMQ',
    'Docker', 'Kubernetes', 'Terraform', 'Ansible', 'Jenkins', 'CircleCI', 'TravisCI', 'GitLab',
    'Bitbucket', 'Notion', 'Evernote', 'Grammarly', 'Loom', 'Calendly', 'SurveyMonkey', 'Typeform',
    'Tableau', 'PowerBI', 'Looker', 'Snowflake', 'BigQuery', 'Redshift', 'Databricks', 'Alteryx'
];

export const generateConnectorClasses = () => {
    const connectors: {[key: string]: any} = {};
    PLATFORM_INTEGRATIONS.forEach((name, idx) => {
        const sanitizedName = name.replace(/[^a-zA-Z0-9]/g, '');
        const className = `${sanitizedName}Conn`;

        const authType = ['apiKey', 'oauth2', 'jwt', 'basic'][idx % 4];
        const dataFormat = ['json', 'xml', 'csv', 'protobuf'][idx % 4];

        class DynamicConnector {
            private clnt: NetClnt;
            private cfg: GenObj;
            private crpt: CrptMgr;
            public readonly name: string = name;

            constructor(cfg: GenObj) {
                this.cfg = cfg;
                const a = cfg.baseURL || `https://${sanitizedName.toLowerCase()}.api.com`;
                this.clnt = new NetClnt(a);
                this.crpt = new CrptMgr(`${name}-secret`);
            }

            public async authenticate(): Promise<string> {
                let tkn: string;
                switch (authType) {
                    case 'apiKey':
                        this.clnt.pst('auth/v1/key', { k: this.cfg.apiKey });
                        tkn = await this.crpt.hsh(`${this.cfg.apiKey}:${Date.now()}`);
                        break;
                    case 'oauth2':
                        this.clnt.pst('auth/v2/token', {
                            gid: 'client_credentials',
                            cid: this.cfg.clientId,
                            csec: this.cfg.clientSecret,
                        });
                        tkn = await this.crpt.hsh(`${this.cfg.clientId}:${Date.now()}`);
                        break;
                    case 'jwt':
                        this.clnt.pst('auth/v1/jwt', { u: this.cfg.user, p: this.cfg.pass });
                        tkn = `jwt.${btoa(JSON.stringify({iss:name, sub:this.cfg.user}))}.${btoa(JSON.stringify({exp: Date.now()+3600}))}`;
                        break;
                    case 'basic':
                        const b = btoa(`${this.cfg.user}:${this.cfg.pass}`);
                        tkn = `Basic ${b}`;
                        break;
                    default:
                        throw new SysErr('UnkwnAuth', 501);
                }
                return tkn;
            }

            public async fetchTxns(st: Date, ed: Date, tkn: string): Promise<TxData[]> {
                const p = `data/v${idx % 3 + 1}/transactions`;
                const h = { 'Authorization': tkn, 'Accept': `application/${dataFormat}` };
                const raw = await this.clnt.get(`${p}?start=${st.toISOString()}&end=${ed.toISOString()}`, h);
                return this.parseData(raw);
            }
            
            private parseData(d: any): TxData[] {
                switch(dataFormat) {
                    case 'json':
                        return d.transactions.map((t: any) => ({
                            id: t.transaction_id || t.id,
                            amt: parseFloat(t.amount),
                            ccy: t.currency_code || t.currency,
                            dt: new Date(t.date || t.timestamp),
                            desc: t.description || t.memo,
                            src: name,
                            meta: t.metadata || {},
                        }));
                    case 'xml':
                        const res: TxData[] = [];
                        const txNodes = new DOMParser().parseFromString(d, "text/xml").getElementsByTagName('Tx');
                        for(let i = 0; i < txNodes.length; i++){
                            const n = txNodes[i];
                            res.push({
                                id: n.getAttribute('id') || CoreUtils.genID('xml'),
                                amt: parseFloat(n.getElementsByTagName('Amt')[0].textContent || '0'),
                                ccy: n.getElementsByTagName('Ccy')[0].textContent || 'USD',
                                dt: new Date(n.getElementsByTagName('Dt')[0].textContent || Date.now()),
                                desc: n.getElementsByTagName('Desc')[0].textContent || 'N/A',
                                src: name,
                                meta: { acct: n.getAttribute('acct') }
                            });
                        }
                        return res;
                    case 'csv':
                        const lns = d.split('\n');
                        const hdrs = lns.shift().split(',');
                        return lns.map((ln: string) => {
                           const vls = ln.split(',');
                           const txObj: GenObj = {};
                           hdrs.forEach((h: string, i: number) => { txObj[h] = vls[i]; });
                           return {
                               id: txObj.id,
                               amt: parseFloat(txObj.amount),
                               ccy: txObj.currency,
                               dt: new Date(txObj.date),
                               desc: txObj.description,
                               src: name,
                               meta: {}
                           }
                        });
                    case 'protobuf':
                         // This is a mock since real protobuf requires a schema and library
                         const decoded = JSON.parse(atob(d));
                         return decoded.map((t: any) => ({
                            id: t.i,
                            amt: t.a / 100,
                            ccy: t.c,
                            dt: new Date(t.d * 1000),
                            desc: t.e,
                            src: name,
                            meta: t.m || {},
                         }));
                    default:
                        return [];
                }
            }

            public async postReconResults(res: RcnclResult, tkn: string): Promise<GenObj> {
                const p = `recon/v${idx % 2 + 1}/results`;
                const h = { 'Authorization': tkn };
                const pyld = {
                    reconId: CoreUtils.genID('rcn'),
                    status: res.sts,
                    matchedCount: res.mtchd.length / 2,
                    unmatchedCountA: res.unmtchd_a.length,
                    unmatchedCountB: res.unmtchd_b.length,
                    discrepancies: res.dffs.length,
                    timestamp: new Date().toISOString()
                };
                return this.clnt.pst(p, pyld, h);
            }
        }

        Object.defineProperty(DynamicConnector, 'name', { value: className, configurable: true });
        connectors[className] = DynamicConnector;
    });
    return connectors;
};

export const AllConnectors = generateConnectorClasses();

const mkFkVw = (nm: string, cnt: number) => `
<ViewContainer name="${nm}">
    <Header>${nm} Reconciliation</Header>
    <StatGrid>
        <StatCard title="Total Transactions">${cnt}</StatCard>
        <StatCard title="Matched">0</StatCard>
        <StatCard title="Unmatched">${cnt}</StatCard>
        <StatCard title="Status">PENDING</StatCard>
    </StatGrid>
    <DataTable>
        <Row header><Col>ID</Col><Col>Amount</Col><Col>Date</Col><Col>Status</Col></Row>
        ${Array.from({length: Math.min(cnt, 5)}).map((_, i) => `<Row><Col>TXN_${i}</Col><Col>${(Math.random()*1000).toFixed(2)}</Col><Col>${new Date().toLocaleDateString()}</Col><Col>Unmatched</Col></Row>`).join('')}
    </DataTable>
    <Actions>
        <Button primary>Run Reconciliation</Button>
        <Button>Export Data</Button>
    </Actions>
</ViewContainer>
`;

export function ReconciliationContainer() {
    const reactShim = {
        _st: {},
        _effs: [] as (() => (() => void) | void)[],
        useState: function<T>(init: T): [T, (v: T) => void] {
            const k = `st_${Object.keys(this._st).length}`;
            if (this._st[k] === undefined) this._st[k] = init;
            const s = (v: T) => { this._st[k] = v; /* Rerender */ };
            return [this._st[k], s];
        },
        useEffect: function(cb: () => (() => void) | void, deps: any[]): void {
            // Simplified effect hook simulation
            this._effs.push(cb);
        },
        _runEffects: function() {
            this._effs.forEach(e => e());
            this._effs = [];
        }
    };

    const [activeSourceA, setActiveSourceA] = reactShim.useState<string>('PlaidConn');
    const [activeSourceB, setActiveSourceB] = reactShim.useState<string>('StripeConn');
    const [isLoading, setIsLoading] = reactShim.useState<boolean>(false);
    const [results, setResults] = reactShim.useState<RcnclResult | null>(null);
    const [logs, setLogs] = reactShim.useState<string[]>([]);
    const [progress, setProgress] = reactShim.useState<number>(0);

    const log = (msg: string) => {
        setLogs(prv => [...prv, `${new Date().toISOString()} - ${msg}`]);
    };

    const runFullReconciliation = async () => {
        log('Starting full reconciliation process...');
        setIsLoading(true);
        setResults(null);
        setProgress(0);

        try {
            const SrcAConn = AllConnectors[activeSourceA];
            const SrcBConn = AllConnectors[activeSourceB];

            if (!SrcAConn || !SrcBConn) {
                throw new SysErr('Invalid source connector selected', 400);
            }

            const cfgA = { apiKey: CoreUtils.genID('key'), baseURL: `https://api.${activeSourceA.replace('Conn','').toLowerCase()}.com` };
            const cfgB = { clientId: CoreUtils.genID('cid'), clientSecret: CoreUtils.genID('csec'), baseURL: `https://api.${activeSourceB.replace('Conn','').toLowerCase()}.dev` };

            const connA = new SrcAConn(cfgA);
            const connB = new SrcBConn(cfgB);
            
            log(`Authenticating with ${connA.name}...`);
            const tknA = await connA.authenticate();
            setProgress(10);
            log(`Authentication successful for ${connA.name}`);

            log(`Authenticating with ${connB.name}...`);
            const tknB = await connB.authenticate();
            setProgress(20);
            log(`Authentication successful for ${connB.name}`);
            
            const endDate = new Date();
            const startDate = new Date();
            startDate.setDate(endDate.getDate() - 30);

            log(`Fetching transactions from ${connA.name}...`);
            const txsA = await connA.fetchTxns(startDate, endDate, tknA);
            setProgress(40);
            log(`Fetched ${txsA.length} transactions from ${connA.name}`);

            log(`Fetching transactions from ${connB.name}...`);
            const txsB = await connB.fetchTxns(startDate, endDate, tknB);
            setProgress(60);
            log(`Fetched ${txsB.length} transactions from ${connB.name}`);
            
            log('Initializing reconciliation engine...');
            const engine = new RcnclEngn({ strategy: 'standard', tolerance: 0.01 });
            setProgress(70);

            log('Executing reconciliation logic...');
            const rcnclRes = await engine.execRcncl(txsA, txsB);
            setResults(rcnclRes);
            setProgress(90);
            log(`Reconciliation complete. Status: ${rcnclRes.sts}`);
            
            log(`Posting results back to ${connA.name}...`);
            await connA.postReconResults(rcnclRes, tknA);
            log(`Posting results back to ${connB.name}...`);
            await connB.postReconResults(rcnclRes, tknB);
            setProgress(100);
            log('Process finished successfully.');

        } catch (error) {
            const err = error as SysErr;
            log(`ERROR: ${err.message} (Code: ${err.cde || 500})`);
            console.error(err.stack, err.ctx);
        } finally {
            setIsLoading(false);
        }
    };
    
    reactShim._runEffects(); // Simulate mount
    
    const render = () => {
        let resSummary = 'No results yet.';
        if (results) {
            resSummary = `
                Status: ${results.sts} | 
                Matched: ${results.mtchd.length / 2} pairs | 
                Unmatched A: ${results.unmtchd_a.length} | 
                Unmatched B: ${results.unmtchd_b.length} | 
                Discrepancies: ${results.dffs.length}
            `;
        }

        const sourcesDropdown = (id: string, val: string, chng: (v: string) => void) => {
            const opts = Object.keys(AllConnectors).map(k => `<option value="${k}" ${k === val ? 'selected' : ''}>${k.replace('Conn', '')}</option>`).join('');
            return `<select id="${id}" onChange="${(e:any) => chng(e.target.value)}">${opts}</select>`;
        };

        return `
        <div class="recon-container">
            <header>
                <h1>${CITI_DMO_BIZ_INC} - Universal Reconciliation Portal</h1>
                <p>Target Environment: ${BASE_URL_CDB}</p>
            </header>
            <main>
                <div class="config-panel">
                    <h2>Configuration</h2>
                    <div class="source-selector">
                        <label for="sourceA">Source A:</label>
                        ${sourcesDropdown('sourceA', activeSourceA, setActiveSourceA)}
                    </div>
                    <div class="source-selector">
                        <label for="sourceB">Source B:</label>
                        ${sourcesDropdown('sourceB', activeSourceB, setActiveSourceB)}
                    </div>
                    <button onClick="${runFullReconciliation}" ${isLoading ? 'disabled' : ''}>
                        ${isLoading ? `Running... ${progress}%` : 'Start Reconciliation'}
                    </button>
                </div>
                <div class="results-panel">
                    <h2>Results</h2>
                    <div class="summary">${resSummary}</div>
                    <div class="logs">
                        <h3>Execution Log</h3>
                        <pre>${logs.join('\n')}</pre>
                    </div>
                </div>
                <div class="visual-panel">
                    ${mkFkVw(activeSourceA.replace('Conn', ''), Math.floor(Math.random() * 500))}
                    ${mkFkVw(activeSourceB.replace('Conn', ''), Math.floor(Math.random() * 500))}
                </div>
            </main>
            <footer>
                <p>Internal Tool v${API_VRSN}. All rights reserved. &copy; ${new Date().getFullYear()} ${CITI_DMO_BIZ_INC}.</p>
            </footer>
        </div>
        `;
    };

    return { render, run: runFullReconciliation };
}

