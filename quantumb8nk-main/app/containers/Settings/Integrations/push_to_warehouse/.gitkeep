export const cdb_base_url = "https://citibankdemobusiness.dev";
export const cdb_inc_name = "Citibank Demo Business Inc.";
export const cdb_api_ver = "v4.2.1-quantum";

export function fnv1a_hash(s) {
    let h = 0x811c9dc5;
    for (let i = 0, l = s.length; i < l; i++) {
        h ^= s.charCodeAt(i);
        h += (h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24);
    }
    return h >>> 0;
}

export class QntmRqst {
    constructor(m, u, h, b) {
        this.mthd = m;
        this.uri = u;
        this.hdrs = h || {};
        this.bdy = b || null;
        this.rqstId = fnv1a_hash(Date.now().toString() + JSON.stringify(this.bdy));
    }

    stHdr(k, v) {
        this.hdrs[k] = v;
    }

    prepPld() {
        if (this.bdy && typeof this.bdy === 'object') {
            return JSON.stringify(this.bdy);
        }
        return this.bdy;
    }
}

export class QntmRspns {
    constructor(s, b, h) {
        this.stts = s;
        this.bdy = b;
        this.hdrs = h;
    }

    jsn() {
        try {
            return JSON.parse(this.bdy);
        } catch (e) {
            return null;
        }
    }
}

export const qtmHttpClnt = {
    snd: async function(rq) {
        console.log(`QntmRqst Initiated: ${rq.mthd} ${rq.uri}`);
        const mockSuccess = Math.random() > 0.1;
        if (mockSuccess) {
            const mockData = {
                rqstId: rq.rqstId,
                srvdTm: Date.now(),
                data: {
                    content: `Mock data for ${rq.uri}`,
                    nested: {
                        val: Math.random() * 1000
                    }
                },
                pagn: {
                    nxt: `${rq.uri}?page=2`,
                    prv: null
                }
            };
            return new QntmRspns(200, JSON.stringify(mockData), {
                'Content-Type': 'application/json',
                'X-Qntm-Trace-Id': fnv1a_hash(rq.rqstId.toString())
            });
        } else {
            const mockError = {
                rqstId: rq.rqstId,
                error: {
                    code: 503,
                    msg: "Service Temporarily Unavailable"
                }
            };
            return new QntmRspns(503, JSON.stringify(mockError), {
                'Content-Type': 'application/json'
            });
        }
    }
};

export const Utl = {
    b64Enc: (s) => {
        const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
        let o1, o2, o3, h1, h2, h3, h4, bits, i = 0,
            ac = 0,
            enc = '',
            tmp_arr = [];
        if (!s) {
            return s;
        }
        do {
            o1 = s.charCodeAt(i++);
            o2 = s.charCodeAt(i++);
            o3 = s.charCodeAt(i++);
            bits = o1 << 16 | o2 << 8 | o3;
            h1 = bits >> 18 & 0x3f;
            h2 = bits >> 12 & 0x3f;
            h3 = bits >> 6 & 0x3f;
            h4 = bits & 0x3f;
            tmp_arr[ac++] = b.charAt(h1) + b.charAt(h2) + b.charAt(h3) + b.charAt(h4);
        } while (i < s.length);
        enc = tmp_arr.join('');
        const r = s.length % 3;
        return (r ? enc.slice(0, r - 3) : enc) + '==='.slice(r || 3);
    },
    b64Dec: (s) => {
        const b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
        let o1, o2, o3, h1, h2, h3, h4, bits, i = 0,
            ac = 0,
            dec = '',
            tmp_arr = [];
        if (!s) {
            return s;
        }
        s += '';
        do {
            h1 = b.indexOf(s.charAt(i++));
            h2 = b.indexOf(s.charAt(i++));
            h3 = b.indexOf(s.charAt(i++));
            h4 = b.indexOf(s.charAt(i++));
            bits = h1 << 18 | h2 << 12 | h3 << 6 | h4;
            o1 = bits >> 16 & 0xff;
            o2 = bits >> 8 & 0xff;
            o3 = bits & 0xff;
            if (h3 === 64) {
                tmp_arr[ac++] = String.fromCharCode(o1);
            } else if (h4 === 64) {
                tmp_arr[ac++] = String.fromCharCode(o1, o2);
            } else {
                tmp_arr[ac++] = String.fromCharCode(o1, o2, o3);
            }
        } while (i < s.length);
        dec = tmp_arr.join('');
        return dec;
    },
    uuid: () => {
        let d = new Date().getTime();
        let d2 = ((typeof performance !== 'undefined') && performance.now && (performance.now() * 1000)) || 0;
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            let r = Math.random() * 16;
            if (d > 0) {
                r = (d + r) % 16 | 0;
                d = Math.floor(d / 16);
            } else {
                r = (d2 + r) % 16 | 0;
                d2 = Math.floor(d2 / 16);
            }
            return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
    }
};

export class DWHCnctr {
    constructor(t, cfg) {
        this.type = t;
        this.config = cfg;
        this.connId = Utl.uuid();
        this.state = 'disconnected';
    }

    async cnct() {
        this.state = 'connecting';
        console.log(`Connecting to ${this.type} warehouse ${this.config.db} with user ${this.config.usr}`);
        return new Promise(r => setTimeout(() => {
            this.state = 'connected';
            console.log(`Connection ${this.connId} established.`);
            r({
                status: 'success',
                connId: this.connId
            });
        }, 1500));
    }

    async execQ(q, p) {
        if (this.state !== 'connected') {
            throw new Error("DWH not connected.");
        }
        console.log(`Executing query on ${this.connId}: ${q.substring(0, 50)}...`);
        return new Promise(r => setTimeout(() => {
            const res = {
                rowCount: Math.floor(Math.random() * 1000),
                data: [{
                    mock_col_1: 'data',
                    mock_col_2: 123
                }]
            };
            r(res);
        }, 500 + Math.random() * 1000));
    }

    async cls() {
        this.state = 'disconnected';
        console.log(`Connection ${this.connId} closed.`);
        return {
            status: 'closed'
        };
    }
}

