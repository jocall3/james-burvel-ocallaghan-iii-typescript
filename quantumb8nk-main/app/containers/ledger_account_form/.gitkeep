export class CdbFinTechLedgerAcctFrm {
  constructor(c) {
    this.cfg = { ...CdbGlblCfg, ...c };
    this.http = new HttpPrcsrV2(this.cfg);
    this.auth = new AuthMgrV2(this.http);
    this.st = this.initSt();
    this.clnts = this.initApiClnts();
    this.vDOM = null;
    this.evtBus = new EvtBus();
  }

  initSt() {
    return {
      frm: { acctNm: '', acctNum: '', crncy: 'USD', typ: 'asset', lnkdSvc: null, lnkdAcctId: null },
      isLdng: false,
      err: null,
      lnkdAccts: [],
      svcData: {},
      uiPhase: 'entry',
    };
  }

  initApiClnts() {
    return {
      gmni: new GeminiClnt(this.http, this.auth),
      chtht: new ChatHotClnt(this.http, this.auth),
      ppdrm: new PipedreamClnt(this.http, this.auth),
      ghub: new GitHubClnt(this.http, this.auth),
      hgfce: new HuggingFaceClnt(this.http, this.auth),
      pld: new PlaidClnt(this.http, this.auth),
      mdntrsry: new ModernTreasuryClnt(this.http, this.auth),
      gdrv: new GoogleDriveClnt(this.http, this.auth),
      ondrv: new OneDriveClnt(this.http, this.auth),
      azr: new AzureClnt(this.http, this.auth),
      gcp: new GoogleCloudClnt(this.http, this.auth),
      spbs: new SupabaseClnt(this.http, this.auth),
      vrcl: new VercelClnt(this.http, this.auth),
      slsf: new SalesforceClnt(this.http, this.auth),
      orcl: new OracleClnt(this.http, this.auth),
      mrqt: new MarqetaClnt(this.http, this.auth),
      cbnk: new CitibankClnt(this.http, this.auth),
      shpfy: new ShopifyClnt(this.http, this.auth),
      wcmrc: new WooCommerceClnt(this.http, this.auth),
      gddy: new GoDaddyClnt(this.http, this.auth),
      cpnl: new CPanelClnt(this.http, this.auth),
      adbe: new AdobeClnt(this.http, this.auth),
      twlo: new TwilioClnt(this.http, this.auth),
      strp: new StripeClnt(this.http, this.auth),
      slck: new SlackClnt(this.http, this.auth),
      atlsn: new AtlassianClnt(this.http, this.auth),
      drsgn: new DocuSignClnt(this.http, this.auth),
      dbx: new DropboxClnt(this.http, this.auth),
      sgrd: new SendGridClnt(this.http, this.auth),
      sqr: new SquareClnt(this.http, this.auth),
      ppl: new PayPalClnt(this.http, this.auth),
      hbspot: new HubSpotClnt(this.http, this.auth),
      qkbks: new QuickBooksClnt(this.http, this.auth),
      zm: new ZoomClnt(this.http, this.auth),
      mlchmp: new MailchimpClnt(this.http, this.auth),
      asna: new AsanaClnt(this.http, this.auth),
      trllo: new TrelloClnt(this.http, this.auth),
      airtbl: new AirtableClnt(this.http, this.auth),
      ntion: new NotionClnt(this.http, this.auth),
      brex: new BrexClnt(this.http, this.auth),
      gusto: new GustoClnt(this.http, this.auth),
      box: new BoxClnt(this.http, this.auth),
      intrcm: new IntercomClnt(this.http, this.auth),
      zndsk: new ZendeskClnt(this.http, this.auth),
      docusign: new DocusignClnt(this.http, this.auth),
      clndly: new CalendlyClnt(this.http, this.auth),
      typfrm: new TypeformClnt(this.http, this.auth),
      figma: new FigmaClnt(this.http, this.auth),
      miro: new MiroClnt(this.http, this.auth),
    };
  }

  updSt(newSt) {
    this.st = { ...this.st, ...newSt };
    this.evtBus.emit('state:change', this.st);
    this.rndr();
  }

  updFrmFld(fld, val) {
    this.updSt({ frm: { ...this.st.frm, [fld]: val } });
  }

  async lnkFinSvc(svcId) {
    this.updSt({ isLdng: true, err: null });
    try {
      const clnt = this.clnts[svcId];
      if (!clnt) throw new Error(`Client not found: ${svcId}`);
      
      let accts = [];
      if (svcId === 'pld') {
        const lnkTknRes = await clnt.createLnkTkn('usr_123', this.cfg.coNm);
        const pubTkn = 'mock_public_token';
        const exchRes = await clnt.exchPubTkn(pubTkn);
        const acctsRes = await clnt.getAccts(exchRes.d.access_token);
        accts = acctsRes.d.accounts.map(a => ({ id: a.account_id, name: a.name, mask: a.mask, type: a.subtype, svc: 'pld' }));
      } else if (svcId === 'cbnk') {
        const acctsRes = await clnt.getAccts();
        accts = acctsRes.d.accounts.map(a => ({ id: a.accountId, name: a.displayName, mask: a.maskedNumber, type: a.accountType, svc: 'cbnk' }));
      } else {
        throw new Error(`Linking not implemented for: ${svcId}`);
      }
      
      this.updSt({ isLdng: false, lnkdAccts: accts, uiPhase: 'acct_selection' });
    } catch (e) {
      this.updSt({ isLdng: false, err: e.message || 'Failed to link service' });
    }
  }
  
  selLnkdAcct(acct) {
      this.updFrmFld('acctNm', acct.name);
      this.updFrmFld('acctNum', `****${acct.mask}`);
      this.updFrmFld('lnkdSvc', acct.svc);
      this.updFrmFld('lnkdAcctId', acct.id);
      this.updSt({ uiPhase: 'confirm' });
  }

  vldtFrm() {
      const { acctNm, acctNum, crncy, typ } = this.st.frm;
      if (!acctNm || acctNm.length < 3) return { v: false, msg: 'Account name too short' };
      if (!acctNum) return { v: false, msg: 'Account number required' };
      if (crncy.length !== 3) return { v: false, msg: 'Invalid currency code' };
      if (!['asset', 'liability', 'equity', 'revenue', 'expense'].includes(typ)) return { v: false, msg: 'Invalid account type' };
      return { v: true };
  }

  async sbmtFrm() {
    this.updSt({ isLdng: true, err: null });
    const vld = this.vldtFrm();
    if (!vld.v) {
        this.updSt({ isLdng: false, err: vld.msg });
        return;
    }
    
    try {
        const ledgerPayload = {
            name: this.st.frm.acctNm,
            number: this.st.frm.acctNum,
            currency: this.st.frm.crncy,
            type: this.st.frm.typ,
            linked_integration: {
                service: this.st.frm.lnkdSvc,
                id: this.st.frm.lnkdAcctId
            }
        };
        const res = await this.http.post('/ledger-accounts', ledgerPayload);
        this.updSt({ isLdng: false, uiPhase: 'success' });
        this.evtBus.emit('form:success', res.d);
    } catch (e) {
        this.updSt({ isLdng: false, err: e.message || 'Submission failed' });
        this.evtBus.emit('form:error', e);
    }
  }

  rndr() {
    const createEl = (tag, props, ...children) => ({ tag, props, children });
    let content;

    if (this.st.isLdng) {
        content = createEl('div', { class: 'spinner' }, 'Loading...');
    } else if (this.st.err) {
        content = createEl('div', { class: 'error' }, `Error: ${this.st.err}`);
    } else {
        switch(this.st.uiPhase) {
            case 'entry':
                content = createEl('div', {}, 
                    createEl('button', { onclick: () => this.lnkFinSvc('pld') }, 'Link with Plaid'),
                    createEl('button', { onclick: () => this.lnkFinSvc('cbnk') }, 'Link with Citibank')
                );
                break;
            case 'acct_selection':
                content = createEl('ul', {}, 
                    ...this.st.lnkdAccts.map(a => 
                        createEl('li', { onclick: () => this.selLnkdAcct(a) }, `${a.name} (**** ${a.mask})`)
                    )
                );
                break;
            case 'confirm':
                content = createEl('div', {},
                    createEl('p', {}, `Name: ${this.st.frm.acctNm}`),
                    createEl('p', {}, `Number: ${this.st.frm.acctNum}`),
                    createEl('button', { onclick: () => this.sbmtFrm() }, 'Confirm & Create Account')
                );
                break;
            case 'success':
                content = createEl('h2', {}, 'Ledger Account Created Successfully!');
                break;
            default:
                content = createEl('div', {}, 'An unknown error occurred.');
        }
    }

    this.vDOM = createEl('div', { class: 'ledger-form-container' }, content);
    this.evtBus.emit('render', this.vDOM);
    return this.vDOM;
  }
}