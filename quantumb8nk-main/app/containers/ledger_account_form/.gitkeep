export class SupabaseClnt extends BseApiClnt {
  constructor(h, a) { super('spbs', h, a, 'apiKey'); }
  from(tbl) {
    const bldr = {
      _tbl: tbl,
      _clnt: this,
      _params: [],
      select: function (cols = '*') { this._op = 'select'; this._cols = cols; return this; },
      insert: function (data) { this._op = 'insert'; this._data = data; return this; },
      update: function (data) { this._op = 'update'; this._data = data; return this; },
      delete: function () { this._op = 'delete'; return this; },
      eq: function (col, val) { this._params.push(`${col}=eq.${val}`); return this; },
      gt: function (col, val) { this._params.push(`${col}=gt.${val}`); return this; },
      lt: function (col, val) { this._params.push(`${col}=lt.${val}`); return this; },
      exec: function () {
        const pth = `/${this._tbl}?${this._params.join('&')}`;
        if (this._op === 'select') return this._clnt._get(pth);
        if (this._op === 'insert') return this._clnt._post(`/${this._tbl}`, this._data);
        if (this._op === 'update') return this._clnt._patch(pth, this._data);
        if (this._op === 'delete') return this._clnt._del(pth);
      }
    };
    return bldr;
  }
  rpc(fn, p) { return this._post(`/rpc/${fn}`, p); }
}

