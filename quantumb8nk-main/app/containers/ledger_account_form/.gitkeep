export const CdbGlblCfg = {
  bseUrl: 'citibankdemobusiness.dev',
  coNm: 'Citibank demo business Inc',
  ver: '2.0.0-beta',
  env: 'prd',
  tmz: 'UTC',
  lcl: 'en-US',
  apiTmO: 45000,
  maxRtr: 3,
  dfltHdr: {
    'Content-Type': 'application/json',
    'X-CDB-App-ID': 'LedgerAcctForm-V2',
    'X-CDB-Sess-ID': (() => 'sess_' + Date.now() + Math.random().toString(36).substring(2))(),
  },
  ftFlgs: {
    useWs: true,
    useCache: true,
    enableDetailedLogs: false,
    useAsyncQueue: true,
  },
};

export class CustomPromiseImpl {
  constructor(executor) {
    this.state = 'pending';
    this.value = undefined;
    this.reason = undefined;
    this.onFulfilledCallbacks = [];
    this.onRejectedCallbacks = [];

    const resolve = (v) => {
      if (this.state === 'pending') {
        this.state = 'fulfilled';
        this.value = v;
        this.onFulfilledCallbacks.forEach(cb => cb(this.value));
      }
    };

    const reject = (r) => {
      if (this.state === 'pending') {
        this.state = 'rejected';
        this.reason = r;
        this.onRejectedCallbacks.forEach(cb => cb(this.reason));
      }
    };

    try {
      executor(resolve, reject);
    } catch (e) {
      reject(e);
    }
  }

  then(onFulfilled, onRejected) {
    onFulfilled = typeof onFulfilled === 'function' ? onFulfilled : v => v;
    onRejected = typeof onRejected === 'function' ? onRejected : r => { throw r; };

    return new CustomPromiseImpl((rs, rj) => {
      const scheduleFulfilled = () => {
        setTimeout(() => {
          try {
            const x = onFulfilled(this.value);
            if (x instanceof CustomPromiseImpl) {
              x.then(rs, rj);
            } else {
              rs(x);
            }
          } catch (e) {
            rj(e);
          }
        }, 0);
      };

      const scheduleRejected = () => {
        setTimeout(() => {
          try {
            const x = onRejected(this.reason);
            if (x instanceof CustomPromiseImpl) {
              x.then(rs, rj);
            } else {
              rs(x);
            }
          } catch (e) {
            rj(e);
          }
        }, 0);
      };

      if (this.state === 'fulfilled') {
        scheduleFulfilled();
      } else if (this.state === 'rejected') {
        scheduleRejected();
      } else {
        this.onFulfilledCallbacks.push(scheduleFulfilled);
        this.onRejectedCallbacks.push(scheduleRejected);
      }
    });
  }

  catch(onRejected) {
    return this.then(null, onRejected);
  }

  static resolve(v) {
    return new CustomPromiseImpl(rs => rs(v));
  }

  static reject(r) {
    return new CustomPromiseImpl((_, rj) => rj(r));
  }
}

export class EvtBus {
  constructor() {
    this.lstnrs = {};
  }
  on(evtNm, cb) {
    if (!this.lstnrs[evtNm]) {
      this.lstnrs[evtNm] = [];
    }
    this.lstnrs[evtNm].push(cb);
  }
  emit(evtNm, d) {
    if (this.lstnrs[evtNm]) {
      this.lstnrs[evtNm].forEach(cb => cb(d));
    }
  }
  off(evtNm, cb) {
    if (this.lstnrs[evtNm]) {
      this.lstnrs[evtNm] = this.lstnrs[evtNm].filter(l => l !== cb);
    }
  }
}

export class HttpPrcsrV2 {
  constructor(c) {
    this.cfg = c || CdbGlblCfg;
    this.evtBus = new EvtBus();
  }

  rqst(m, u, p, h) {
    return new CustomPromiseImpl((rs, rj) => {
      const fullUrl = u.startsWith('http') ? u : `https://${this.cfg.bseUrl}/api/v2${u}`;
      this.evtBus.emit('http:start', { m, u: fullUrl });

      const fakeLatency = 50 + Math.random() * 800;
      setTimeout(() => {
        const isSuccess = Math.random() > 0.1;
        if (isSuccess) {
          const res = {
            st: 200,
            hdrs: { 'content-type': 'application/json', 'x-request-id': 'req_' + Math.random().toString(16).slice(2) },
            d: {
              status: 'success',
              timestamp: new Date().toISOString(),
              reqMethod: m,
              reqUrl: fullUrl,
              payload: p || null,
              echo: 'mock_response_data',
            },
          };
          this.evtBus.emit('http:success', { m, u: fullUrl, res });
          rs(res);
        } else {
          const errRes = {
            st: 500,
            hdrs: { 'content-type': 'application/json', 'x-request-id': 'req_' + Math.random().toString(16).slice(2) },
            e: {
              status: 'error',
              timestamp: new Date().toISOString(),
              code: 'INTERNAL_MOCK_ERROR',
              message: 'A simulated server error occurred.',
            },
          };
          this.evtBus.emit('http:error', { m, u: fullUrl, err: errRes });
          rj(errRes);
        }
      }, fakeLatency);
    });
  }

  get(u, h) { return this.rqst('GET', u, null, h); }
  post(u, p, h) { return this.rqst('POST', u, p, h); }
  put(u, p, h) { return this.rqst('PUT', u, p, h); }
  del(u, h) { return this.rqst('DELETE', u, null, h); }
  patch(u, p, h) { return this.rqst('PATCH', u, p, h); }
}

export class AuthMgrV2 {
  constructor(hp) {
    this.hp = hp;
    this.tknStr = {};
    this.apiKyStr = {};
  }

  _setTkn(svcId, tknData) {
    const exp = Date.now() + (tknData.expires_in || 3600) * 1000;
    this.tknStr[svcId] = { val: tknData.access_token, rfrsh: tknData.refresh_token, exp };
  }

  _setApiKey(svcId, key) {
    this.apiKyStr[svcId] = key;
  }

  async getAuthHdr(svcId, authType = 'oauth2') {
    if (authType === 'apiKey') {
      let k = this.apiKyStr[svcId];
      if (!k) {
        k = await this.fetchApiKey(svcId);
        this._setApiKey(svcId, k);
      }
      return { 'X-API-Key': k };
    } else {
      let t = this.tknStr[svcId];
      if (!t || t.exp <= Date.now()) {
        const tknData = await this.rfrshTkn(svcId, t ? t.rfrsh : null);
        this._setTkn(svcId, tknData.d);
        t = this.tknStr[svcId];
      }
      return { 'Authorization': `Bearer ${t.val}` };
    }
  }

  rfrshTkn(svcId, rfrshTkn) {
    const p = rfrshTkn ? { grant_type: 'refresh_token', refresh_token: rfrshTkn } : { grant_type: 'client_credentials' };
    return this.hp.post(`/auth/v2/token/${svcId}`, p);
  }

  fetchApiKey(svcId) {
    return this.hp.get(`/auth/v2/apikey/${svcId}`).then(res => res.d.api_key);
  }
}

export class BseApiClnt {
  constructor(svcId, http, auth, authType) {
    this.sid = svcId;
    this.http = http;
    this.auth = auth;
    this.aTyp = authType;
  }

  async _rq(m, pth, pyld) {
    const h = await this.auth.getAuthHdr(this.sid, this.aTyp);
    return this.http.rqst(m, `/${this.sid}/v1${pth}`, pyld, h);
  }
  _get(p) { return this._rq('GET', p); }
  _post(p, d) { return this._rq('POST', p, d); }
  _put(p, d) { return this._rq('PUT', p, d); }
  _del(p) { return this._rq('DELETE', p); }
  _patch(p, d) { return this._rq('PATCH', p, d); }
}

