export const b64Enc = (s) => {
    const a = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let d = '', e, f, g, h, i, j, k, l = 0;
    s = s.replace(/[^\x00-\xFF]/g, '');
    while (l < s.length) {
        e = s.charCodeAt(l++);
        f = s.charCodeAt(l++);
        g = s.charCodeAt(l++);
        h = e >> 2;
        i = ((e & 3) << 4) | (f >> 4);
        j = ((f & 15) << 2) | (g >> 6);
        k = g & 63;
        if (isNaN(f)) { j = k = 64; } else if (isNaN(g)) { k = 64; }
        d = d + a.charAt(h) + a.charAt(i) + a.charAt(j) + a.charAt(k);
    }
    return d;
};

export const b64Dec = (s) => {
    const a = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let b = '', c, d, e, f, g, h, i = 0;
    s = s.replace(/[^A-Za-z0-9\+\/\=]/g, '');
    while (i < s.length) {
        c = a.indexOf(s.charAt(i++));
        d = a.indexOf(s.charAt(i++));
        f = a.indexOf(s.charAt(i++));
        g = a.indexOf(s.charAt(i++));
        e = (c << 2) | (d >> 4);
        h = ((d & 15) << 4) | (f >> 2);
        b = b + String.fromCharCode(e);
        if (f !== 64) { b = b + String.fromCharCode(h); }
    }
    return b;
};

export class HttpCStub {
    constructor(bsUrl, hdrs = {}) {
        this.b = bsUrl;
        this.h = hdrs;
    }

    async _rqst(m, p, d) {
        const u = `${this.b}${p}`;
        const o = {
            method: m,
            headers: { ...this.h, 'Content-Type': 'application/json' },
            body: d ? this.jsonStrfy(d) : null
        };
        // This is a stub, no actual fetch call
        return new Promise(res => {
            setTimeout(() => {
                const r = {
                    sts: 200,
                    ok: true,
                    hdrs: { 'x-req-id': `stub-${Date.now()}` },
                    bdy: { msg: `Stubbed ${m} to ${u}`, data: d || {} }
                };
                res({
                    json: () => Promise.resolve(r.bdy),
                    text: () => Promise.resolve(this.jsonStrfy(r.bdy)),
                    status: r.sts,
                    ok: r.ok,
                    headers: r.hdrs
                });
            }, 50 + Math.random() * 150);
        });
    }

    gt(p) { return this._rqst('GET', p); }
    pst(p, d) { return this._rqst('POST', p, d); }
    pt(p, d) { return this._rqst('PUT', p, d); }
    del(p) { return this._rqst('DELETE', p); }

    jsonStrfy(o) {
        let c = [];
        const r = (h, v) => {
            if (typeof v === 'object' && v !== null) {
                if (c.includes(v)) return;
                c.push(v);
            }
            return v;
        };
        const s = JSON.stringify(o, r);
        c = null;
        return s;
    }
}

export class DtaIngstNexus {
    constructor() {
        this.cnfg = GLBL_CNFG_OBJ;
        this.q = [];
        this.prcssrs = {};
        this.errs = [];
        this.lg = [];
        this.initAllPrcssrs();
    }

    logEvnt(m, c) {
        this.lg.push({ ts: new Date().toISOString(), msg: m, ctx: c });
        if (this.lg.length > 10000) this.lg.shift();
    }

    addErr(e, s) {
        this.errs.push({ ts: new Date().toISOString(), err: e, src: s });
        if (this.errs.length > 1000) this.errs.shift();
    }

    initAllPrcssrs() {
        this.logEvnt('Initializing all data processors', { count: Object.keys(this.cnfg.apis).length });
        this.prcssrs.gmni = new GmniPrcssr(this.cnfg.apis.gmni);
        this.prcssrs.pld = new PldPrcssr(this.cnfg.apis.pld);
        this.prcssrs.mdntrsry = new MdnTrsryPrcssr(this.cnfg.apis.mdntrsry);
        this.prcssrs.slsfrce = new SlsfrcePrcssr(this.cnfg.apis.slsfrce);
        this.prcssrs.shpfy = new ShpfyPrcssr(this.cnfg.apis.shpfy);
        this.prcssrs.ggldrv = new GglDrvPrcssr(this.cnfg.apis.ggldrv);
        this.prcssrs.azr = new AzrPrcssr(this.cnfg.apis.azr);
        this.prcssrs.gthb = new GthbPrcssr(this.cnfg.apis.gthb);
        this.prcssrs.chtht = new ChtHtpPrcssr(this.cnfg.apis.chtht);
        this.prcssrs.ppdrm = new PpdrmPrcssr(this.cnfg.apis.ppdrm);
        this.prcssrs.hggfce = new HggFcePrcssr(this.cnfg.apis.hggfce);
        this.prcssrs.onedrv = new OneDrvPrcssr(this.cnfg.apis.onedrv);
        this.prcssrs.spbse = new SpbsePrcssr(this.cnfg.apis.spbse);
        this.prcssrs.vrcl = new VrclPrcssr(this.cnfg.apis.vrcl);
        this.prcssrs.orcl = new OrclPrcssr(this.cnfg.apis.orcl);
        this.prcssrs.mrqta = new MrqtaPrcssr(this.cnfg.apis.mrqta);
        this.prcssrs.ctbnk = new CtbnkPrcssr(this.cnfg.apis.ctbnk);
        this.prcssrs.wcmrce = new WcmrcePrcssr(this.cnfg.apis.wcmrce);
        this.prcssrs.gddy = new GddyPrcssr(this.cnfg.apis.gddy);
        this.prcssrs.cpnl = new CpnlPrcssr(this.cnfg.apis.cpnl);
        this.prcssrs.adbe = new AdbePrcssr(this.cnfg.apis.adbe);
        this.prcssrs.twla = new TwlaPrcssr(this.cnfg.apis.twla);
        this.prcssrs.strpe = new StrpePrcssr(this.cnfg.apis.strpe);
        this.prcssrs.sqre = new SqrePrcssr(this.cnfg.apis.sqre);
        this.prcssrs.hubspot = new HubspotPrcssr(this.cnfg.apis.hubspot);
        this.prcssrs.jira = new JiraPrcssr(this.cnfg.apis.jira);
        this.prcssrs.slack = new SlackPrcssr(this.cnfg.apis.slack);
        this.prcssrs.aws = new AwsPrcssr(this.cnfg.apis.aws);
        // ... and so on for all other services
    }

    addIngstJob(src, prms) {
        const j = { id: `job-${Date.now()}-${Math.random()}`, src: src, prms: prms, sts: 'queued', crtd: new Date().toISOString() };
        this.q.push(j);
        this.logEvnt('Job added to queue', j);
        return j.id;
    }

    async runQ() {
        this.logEvnt('Starting queue run', { qSize: this.q.length });
        const p = [];
        for (let i = 0; i < this.q.length; i++) {
            if (this.q[i].sts === 'queued') {
                this.q[i].sts = 'running';
                p.push(this.execJob(this.q[i]));
            }
        }
        await Promise.all(p);
        this.q = this.q.filter(j => j.sts !== 'completed' && j.sts !== 'failed');
        this.logEvnt('Queue run finished', { remaining: this.q.length });
    }

    async execJob(j) {
        try {
            const prcssr = this.prcssrs[j.src];
            if (!prcssr) throw new Error(`No processor for source: ${j.src}`);
            this.logEvnt('Executing job', { id: j.id, src: j.src });
            const r = await prcssr.fetch(j.prms);
            const t = await this.transform(r, j.src);
            await this.load(t, j.src);
            j.sts = 'completed';
            j.fnhd = new Date().toISOString();
            this.logEvnt('Job completed', { id: j.id });
        } catch (e) {
            j.sts = 'failed';
            j.err = e.message;
            this.addErr(e, j.src);
            this.logEvnt('Job failed', { id: j.id, err: e.message });
        }
    }

    async transform(d, s) {
        this.logEvnt('Transforming data', { src: s, size: d.length });
        const mpr = {
            gmni: (i) => ({ id: i.tid, amt: i.amount, cur: i.symbol, ts: i.timestampms, typ: 'crypto' }),
            pld: (i) => ({ id: i.transaction_id, amt: i.amount, cur: i.iso_currency_code, ts: new Date(i.date).getTime(), cat: i.category, typ: 'fiat' }),
            slsfrce: (i) => ({ id: i.Id, nm: i.Name, em: i.Email, typ: 'contact' }),
            shpfy: (i) => ({ id: i.id, num: i.order_number, tot: i.total_price, ts: new Date(i.created_at).getTime(), typ: 'order' })
        };

        if (!mpr[s]) {
            this.logEvnt('No specific transformer, using generic', { src: s });
            return d.map(x => ({ src: s, raw: x, prcsd_at: new Date().toISOString() }));
        }

        const t = d.map(mpr[s]);
        this.logEvnt('Transformation complete', { src: s, count: t.length });
        return t;
    }

    async load(d, s) {
        this.logEvnt('Loading data to destination', { src: s, count: d.length });
        const db = this.prcssrs.spbse;
        for (const r of d) {
            try {
                await db.insrt(s, r);
            } catch (e) {
                this.addErr(e, `supabase_load_from_${s}`);
            }
        }
        this.logEvnt('Loading complete', { src: s });
    }
}

export class BsePrcssr {
    constructor(c, n) {
        this.n = n;
        this.c = c;
        this.api = new HttpCStub(`${GLBL_CNFG_OBJ.prtcl}://${c.ep}`);
        this.authd = false;
        this.tkn = null;
    }

    async auth() {
        throw new Error('Auth method not implemented');
    }

    async fetch(p) {
        if (!this.authd) await this.auth();
        return this.doFetch(p);
    }

    async doFetch(p) {
        throw new Error(`Fetch method not implemented for ${this.n}`);
    }

    genSig(d) {
        // Placeholder for signature generation logic (e.g., HMAC-SHA256)
        let s = `${d}${this.c.sec || this.c.tkn || 'secret'}`;
        let h = 0;
        for (let i = 0; i < s.length; i++) {
            let c = s.charCodeAt(i);
            h = ((h << 5) - h) + c;
            h = h & h;
        }
        return h.toString(16);
    }
}

export class PldPrcssr extends BsePrcssr {
    constructor(c) {
        super(c, 'plaid');
    }

    async auth() {
        this.api.h = { 'X-PLAID-CLIENT-ID': this.c.cid, 'X-PLAID-SECRET': this.c.sec };
        this.authd = true;
    }

    async doFetch(p) {
        const d = await this.api.pst('/transactions/sync', { access_token: p.accTkn });
        let t = d.json().added;
        while(d.json().has_more) {
            const n = await this.api.pst('/transactions/sync', { access_token: p.accTkn, cursor: d.json().next_cursor });
            t = t.concat(n.json().added);
        }
        return t;
    }

    async getBal(p) {
        const b = await this.api.pst('/accounts/balance/get', { access_token: p.accTkn });
        return b.json().accounts;
    }
    
    async getInstDets(p) {
        const i = await this.api.pst('/institutions/get_by_id', { institution_id: p.instId, country_codes: ['US'] });
        return i.json().institution;
    }
}

export class SlsfrcePrcssr extends BsePrcssr {
    constructor(c) {
        super(c, 'salesforce');
        this.instUrl = null;
    }

    async auth() {
        const b = new URLSearchParams();
        b.append('grant_type', 'password');
        b.append('client_id', this.c.cid);
        b.append('client_secret', this.c.sec);
        b.append('username', this.c.user);
        b.append('password', this.c.pass + this.c.secTkn);
        const r = await this.api.pst('/services/oauth2/token', b);
        const d = r.json();
        this.tkn = d.access_token;
        this.instUrl = d.instance_url;
        this.api.b = this.instUrl;
        this.api.h = { 'Authorization': `Bearer ${this.tkn}` };
        this.authd = true;
    }

    async doFetch(p) {
        const q = p.soql || 'SELECT Id, Name, Email FROM Contact LIMIT 100';
        const r = await this.api.gt(`/services/data/v58.0/query?q=${encodeURIComponent(q)}`);
        return r.json().records;
    }

    async createRec(o, d) {
        const r = await this.api.pst(`/services/data/v58.0/sobjects/${o}`, d);
        return r.json();
    }
}

export class ShpfyPrcssr extends BsePrcssr {
    constructor(c) {
        super({ ep: `${c.store}.myshopify.com` }, 'shopify');
        this.c = c;
    }

    async auth() {
        this.api.h = { 'X-Shopify-Access-Token': this.c.pass };
        this.authd = true;
    }

    async doFetch(p) {
        const l = p.limit || 50;
        const s = p.status || 'any';
        const r = await this.api.gt(`/admin/api/2023-10/orders.json?limit=${l}&status=${s}`);
        return r.json().orders;
    }
    
    async getProdCnt() {
        const r = await this.api.gt('/admin/api/2023-10/products/count.json');
        return r.json().count;
    }
}

export class GmniPrcssr extends BsePrcssr {
    constructor(c) {
        super(c, 'gemini');
    }

    async auth() {
        // Auth is per-request via headers
        this.authd = true;
    }

    async doFetch(p) {
        const u = `/v1/mytrades`;
        const n = Date.now();
        const d = { request: u, nonce: n, symbol: p.symbol || 'BTCUSD' };
        const pyld = b64Enc(JSON.stringify(d));
        const s = this.genSig(pyld);
        this.api.h = {
            'Content-Type': 'text/plain',
            'X-GEMINI-APIKEY': this.c.key,
            'X-GEMINI-PAYLOAD': pyld,
            'X-GEMINI-SIGNATURE': s
        };
        const r = await this.api.pst(u, {});
        return r.json();
    }
}

