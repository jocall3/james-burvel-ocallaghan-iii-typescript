export class SpbsePrcssr extends BsePrcssr {
    constructor(c) {
        super({ ep: `${c.projId}.supabase.co` }, 'supabase');
        this.c = c;
    }
    
    async auth() {
        this.api.h = { 
            'apikey': this.c.key,
            'Authorization': `Bearer ${this.c.key}` 
        };
        this.authd = true;
    }
    
    async doFetch(p) {
        const tbl = p.table;
        const r = await this.api.gt(`/rest/v1/${tbl}?select=*`);
        return r.json();
    }
    
    async insrt(t, d) {
        await this.api.pst(`/rest/v1/${t}`, d);
    }
}

