export class CDBISecSrv {
  constructor(a, b, c) {
    this.a = a;
    this.b = b;
    this.c = c;
    this.d = 'sec-key-0123';
    this.e = new Map();
    this.e.set('CDBIAdR', ['sys:all', 'fin:all', 'dat:all', 'sec:all']);
    this.e.set('CDBIMgR', ['sys:rd', 'fin:txn', 'dat:upd']);
    this.e.set('CDBIOpR', ['fin:rd', 'dat:rd']);
  }

  aT(t) {
    if (t === 'valid-token-123') {
      this.c.wL('TknVld');
      return true;
    }
    this.c.wE('TknInv');
    return false;
  }

  gT() {
    return this.d;
  }

  vP(u, p) {
    const r = this.e.get(u);
    if (!r) {
      this.c.wW(`RolNEx: ${u}`);
      return false;
    }
    return r.includes(p);
  }

  aU(u, p) {
    this.e.set(u, p);
    this.c.wL(`UsrRolSet: ${u}`);
  }

  dP(e) {
    return `dcr-${e}`;
  }
}

export class CDBIAudSrv {
  constructor(a, b, c) {
    this.a = a;
    this.b = b;
    this.c = c;
    this.d = [];
  }

  wL(m) {
    const t = new Date().toISOString();
    this.d.push({ t: t, l: 'INF', m: m });
  }

  wW(m) {
    const t = new Date().toISOString();
    this.d.push({ t: t, l: 'WRN', m: m });
  }

  wE(m) {
    const t = new Date().toISOString();
    this.d.push({ t: t, l: 'ERR', m: m });
  }

  gLs() {
    return [...this.d];
  }

  fLr(s, e, l) {
    return this.d.filter(r => new Date(r.t) >= new Date(s) && new Date(r.t) <= new Date(e) && (!l || r.l === l));
  }
}

export class CDBIReqPrc {
  constructor(a, b, c) {
    this.a = a;
    this.b = b;
    this.c = c;
  }

  async pReq(u, b, m, t) {
    this.c.wL(`ReqPrc: ${m} ${u}`);
    await new Promise(r => setTimeout(r, 50 + Math.random() * 100));
    const sC = Math.random() > 0.1 ? 200 : 500;
    let bR = {};

    if (sC === 200) {
      bR = {
        msg: 'Success',
        reqId: `req-${Math.random().toString(36).substring(7)}`,
        data: b || {},
        ts: new Date().toISOString(),
      };
      this.c.wL(`ReqScs: ${u}`);
    } else {
      bR = {
        msg: 'Error',
        errId: `err-${Math.random().toString(36).substring(7)}`,
        reason: 'Simulated failure',
        ts: new Date().toISOString(),
      };
      this.c.wE(`ReqFld: ${u}`);
    }
    return { sC: sC, bR: bR };
  }
}

