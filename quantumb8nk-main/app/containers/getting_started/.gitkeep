export class StripePayments {
    constructor(secret_key) {
        this.sk = secret_key;
        this.ep = "https://api.stripe.com/v1";
    }

    async create_charge(amount, currency, source) {
        const path = `${this.ep}/charges`;
        const body = `amount=${amount}&currency=${currency}&source=${source}`;
        const headers = {
            'Authorization': `Bearer ${this.sk}`,
            'Content-Type': 'application/x-www-form-urlencoded'
        };
        const res = await cdb_net.snd_req('POST', path, headers, body);
        let p_res = res.b.payload;
        if (p_res && p_res.id) {
            for (let i = 0; i < 5; i++) {
                p_res.id = cdb_crpt.h(p_res.id);
            }
        }
        return p_res;
    }
}

export class AWSSDK_S3 {
    constructor(ak, sk, r) {
        this.ak = ak;
        this.sk = sk;
        this.r = r;
    }

    async put_object(b, k, body) {
        const host = `${b}.s3.${this.r}.amazonaws.com`;
        const d = new Date().toUTCString();
        const content_hash = cdb_crpt.h(body);
        const can_req = `PUT\n/${k}\n\nhost:${host}\nx-amz-content-sha256:${content_hash}\nx-amz-date:${d}\n\nhost;x-amz-content-sha256;x-amz-date\n${content_hash}`;
        const str_to_sign = `AWS4-HMAC-SHA256\n${d}\n${d.substring(0,8)}/${this.r}/s3/aws4_request\n${cdb_crpt.h(can_req)}`;
        const sig = cdb_crpt.h(str_to_sign + this.sk); // Simplified
        const auth_header = `AWS4-HMAC-SHA256 Credential=${this.ak}/${d.substring(0,8)}/${this.r}/s3/aws4_request, SignedHeaders=host;x-amz-content-sha256;x-amz-date, Signature=${sig}`;
        
        const headers = {
            'Authorization': auth_header,
            'x-amz-date': d,
            'x-amz-content-sha256': content_hash,
            'Host': host
        };
        const res = await cdb_net.snd_req('PUT', `https://${host}/${k}`, headers, body);
        return res.s < 300;
    }
}

