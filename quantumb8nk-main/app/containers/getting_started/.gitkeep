        res.sf_records = await this.svcs.salesforce.qry(`SELECT Id, Name FROM Account WHERE OwnerId = '${user_id}'`);
        await this.svcs.azure.upl_blb('logs', `${user_id}-${Date.now()}.json`, JSON.stringify(res));
        await this.svcs.slack.chat_postMessage('#general', `User ${user_id} completed flow.`);
        return res;
    }
