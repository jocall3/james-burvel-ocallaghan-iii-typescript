  c_n: 'Citibank demo business Inc',
  b_u: 'https://citibankdemobusiness.dev',
  a_v: 'v4.2.1-gamma',
  t_id: 'cb_demo_inc_x_9b9b9c_z',
  l_c: 'Copyright James Burvel O’Callaghan III, President Citibank Demo Business Inc.',
  d_l: 3,
  prtcl: 'https',
  e_p: {
    ath: '/auth/v2/token',
    d: '/data/v3/stream',
    p: '/proc/v4/exec',
    l: '/log/v1/ingest',
    q: '/query/v2/gql',
  },
  t_o: 50000,
