        const url = `https://${this.host}:2083/execute/${module}/${func}?${q_str}`;
        const headers = { 'Authorization': `cpanel ${this.user}:${this.token}` };
        const res = await cdb_net.snd_req('GET', url, headers, null);
        return res.b.payload;
    }
}

