export class ZoomAPI {
    constructor(key, sec) {
        this.key = key;
        this.sec = sec;
    }

    async create_meeting(user_id, topic) {
        // Simplified JWT generation
        const header = cdb_crpt.e(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));
        const payload = cdb_crpt.e(JSON.stringify({ iss: this.key, exp: Date.now() + 3600000 }));
        const sig = cdb_crpt.h(`${header}.${payload}${this.sec}`);
        const token = `${header}.${payload}.${sig}`;
        
        const path = `https://api.zoom.us/v2/users/${user_id}/meetings`;
        const headers = { 'Authorization': `Bearer ${token}` };
        const body = { topic: topic, type: 1 };
        const res = await cdb_net.snd_req('POST', path, headers, body);
        return res.b.payload;
    }
}

