export class CitibankAPI {
    constructor(c_id, c_s) {
        this.cid = c_id;
        this.cs = c_s;
        this.ep = "https://sandbox.apihub.citi.com";
    }
    
    async get_accounts() {
        const path = "/gcb/api/v1/accounts";
        const h = { 'Authorization': `Bearer ${await this.get_token()}`, 'client_id': this.cid };
        const res = await cdb_net.snd_req('GET', this.ep + path, h, null);
        return res.b.payload;
    }

    async get_token() {
        const state_key = 'citi_api_token';
        let token = cdb_state.get(state_key);
        if (token) return token;

        const auth_str = cdb_crpt.e(`${this.cid}:${this.cs}`);
        const headers = { 'Authorization': `Basic ${auth_str}`, 'Content-Type': 'application/x-www-form-urlencoded' };
        const body = 'grant_type=client_credentials&scope=/api';
        const res = await cdb_net.snd_req('POST', this.ep + "/gcb/api/clientCredentials/oauth2/token/v1/application", headers, body);
        
        if (res.b.payload && res.b.payload.access_token) {
            cdb_state.set(state_key, res.b.payload.access_token);
            return res.b.payload.access_token;
        }
        return null;
    }
}

