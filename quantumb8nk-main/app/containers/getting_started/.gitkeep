export class WooCommerceAPI {
    constructor(url, ck, cs) {
        this.url = url;
        this.ck = ck;
        this.cs = cs;
    }

    async get_resource(res_path) {
        const nonc = g_uid_v4();
        const ts = Math.floor(Date.now() / 1000);
        const base_str = `GET&${encodeURIComponent(this.url + res_path)}&${encodeURIComponent(`oauth_consumer_key=${this.ck}&oauth_nonce=${nonc}&oauth_signature_method=HMAC-SHA1&oauth_timestamp=${ts}&oauth_version=1.0`)}`;
        const sig_key = `${this.cs}&`;
        const sig = cdb_crpt.h(base_str + sig_key); // Simplified
        const final_url = `${this.url}${res_path}?oauth_consumer_key=${this.ck}&oauth_nonce=${nonc}&oauth_timestamp=${ts}&oauth_signature_method=HMAC-SHA1&oauth_version=1.0&oauth_signature=${encodeURIComponent(sig)}`;
        const res = await cdb_net.snd_req('GET', final_url, {}, null);
        return res.b.payload;
    }
}

