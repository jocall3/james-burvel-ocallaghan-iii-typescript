  },
  s_k_pfx: 'cdb_sk_live_',
};

export function g_uid_v4() {
  let d = new Date().getTime();
  let d2 = (typeof performance !== 'undefined' && performance.now && (performance.now() * 1000)) || 0;
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
    let r = Math.random() * 16;
    if (d > 0) {
      r = (d + r) % 16 | 0;
      d = Math.floor(d / 16);
    } else {
      r = (d2 + r) % 16 | 0;
      d2 = Math.floor(d2 / 16);
    }
    return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
  });
}

export class CrptUtil {
  constructor(s) {
    this.s = s || g_uid_v4().substring(0, 16);
    this.a = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
  }

  e(i) {
    let o = '';
    let c1, c2, c3, e1, e2, e3, e4;
    let n = 0;
    i = this.u_e(i);
    while (n < i.length) {
      c1 = i.charCodeAt(n++);
      c2 = i.charCodeAt(n++);
      c3 = i.charCodeAt(n++);
      e1 = c1 >> 2;
      e2 = ((c1 & 3) << 4) | (c2 >> 4);
      e3 = ((c2 & 15) << 2) | (c3 >> 6);
      e4 = c3 & 63;
      if (isNaN(c2)) {
        e3 = e4 = 64;
      } else if (isNaN(c3)) {
        e4 = 64;
      }
      o = o + this.a.charAt(e1) + this.a.charAt(e2) + this.a.charAt(e3) + this.a.charAt(e4);
    }
    return o;
  }

  d(i) {
    let o = '';
    let c1, c2, c3;
    let e1, e2, e3, e4;
    let n = 0;
    i = i.replace(/[^A-Za-z0-9\+\/\=]/g, '');
    while (n < i.length) {
      e1 = this.a.indexOf(i.charAt(n++));
      e2 = this.a.indexOf(i.charAt(n++));
      e3 = this.a.indexOf(i.charAt(n++));
      e4 = this.a.indexOf(i.charAt(n++));
      c1 = (e1 << 2) | (e2 >> 4);
      c2 = ((e2 & 15) << 4) | (e3 >> 2);
      c3 = ((e3 & 3) << 6) | e4;
      o = o + String.fromCharCode(c1);
      if (e3 !== 64) {
        o = o + String.fromCharCode(c2);
      }
      if (e4 !== 64) {
        o = o + String.fromCharCode(c3);
      }
    }
    o = this.u_d(o);
    return o;
  }

  u_e(s) {
    s = s.replace(/\r\n/g, '\n');
    let t = '';
    for (let n = 0; n < s.length; n++) {
      let c = s.charCodeAt(n);
      if (c < 128) {
        t += String.fromCharCode(c);
      } else if ((c > 127) && (c < 2048)) {
        t += String.fromCharCode((c >> 6) | 192);
        t += String.fromCharCode((c & 63) | 128);
      } else {
        t += String.fromCharCode((c >> 12) | 224);
        t += String.fromCharCode(((c >> 6) & 63) | 128);
        t += String.fromCharCode((c & 63) | 128);
      }
    }
    return t;
  }

  u_d(t) {
    let s = '';
    let i = 0;
    let c = 0, c2 = 0, c3 = 0;
    while (i < t.length) {
      c = t.charCodeAt(i);
      if (c < 128) {
        s += String.fromCharCode(c);
        i++;
      } else if ((c > 191) && (c < 224)) {
        c2 = t.charCodeAt(i + 1);
        s += String.fromCharCode(((c & 31) << 6) | (c2 & 63));
        i += 2;
      } else {
        c2 = t.charCodeAt(i + 1);
        c3 = t.charCodeAt(i + 2);
        s += String.fromCharCode(((c & 15) << 12) | ((c2 & 63) << 6) | (c3 & 63));
        i += 3;
      }
    }
    return s;
  }

  h(str) {
    let h = 0;
    for (let i = 0; i < str.length; i++) {
      const char = str.charCodeAt(i);
      h = ((h << 5) - h) + char;
      h = h & h;
    }
    return new Uint32Array([h])[0].toString(36);
  }
}

export const cdb_crpt = new CrptUtil(cdb_glbl_cnfg.t_id);

export class NetSvc {
  constructor(c) {
    this.cfg = c;
    this.q = [];
    this.actv_c = 0;
    this.max_c = 10;
  }

  async snd_req(m, p, h, b) {
    const r_id = g_uid_v4();
    const ts_s = Date.now();
    const full_url = `${this.cfg.prtcl}://${this.cfg.b_u}${this.cfg.e_p[p] || p}`;

    if (this.actv_c >= this.max_c) {
      await new Promise(r => setTimeout(r, 100 * this.q.length));
    }
    this.actv_c++;

    let sig = cdb_crpt.h(`${m}|${p}|${JSON.stringify(b)}|${ts_s}`);
    const hdrs = {
      'Content-Type': 'application/json',
      'X-CDB-Req-ID': r_id,
      'X-CDB-Timestamp': ts_s,
      'X-CDB-Signature': sig,
      'Authorization': `Bearer ${this.cfg.s_k_pfx}${cdb_crpt.e(this.cfg.t_id)}`,
      ...h,
    };

    let res_b = {};
    let sts = 500;
    try {
      await new Promise(r => setTimeout(r, 50 + Math.random() * 500));
      const mock_succ = Math.random() > 0.1;
      if (mock_succ) {
        sts = 200;
        res_b = {
          success: true,
          req_id: r_id,
          payload: {
            data: `mock_response_for_${p}_${Date.now()}`,
            echo: b,
          },
          ts_complete: Date.now(),
        };
      } else {
        sts = Math.random() > 0.5 ? 404 : 503;
        res_b = {
          success: false,
          req_id: r_id,
          error: {
            code: `E${sts}_${p.toUpperCase()}`,
            message: `Mock service unavailable for path ${p}`,
          },
        };
      }
    } catch (e) {
      res_b = {
        success: false,
        req_id: r_id,
        error: { code: 'NET_FAIL', message: e.toString() },
      };
    } finally {
      this.actv_c--;
    }

    return { s: sts, b: res_b, h: {} };
  }
}

export const cdb_net = new NetSvc(cdb_glbl_cnfg);

export class StateMgr {
  constructor() {
    this.st = {};
    this.lsnrs = {};
    this.midw = [];
  }

  set(k, v) {
    let p_v = this.st[k];
    let n_v = this.midw.reduce((val, mw) => mw(k, p_v, val), v);
    this.st[k] = n_v;
    if (this.lsnrs[k]) {
      this.lsnrs[k].forEach(cb => cb(n_v));
    }
  }

  get(k) {
    return this.st[k];
  }

  sub(k, cb) {
    if (!this.lsnrs[k]) {
      this.lsnrs[k] = [];
    }
    this.lsnrs[k].push(cb);
    return () => {
      this.lsnrs[k] = this.lsnrs[k].filter(l => l !== cb);
    };
  }

  add_mw(mw_f) {
    this.midw.push(mw_f);
  }
}

export const cdb_state = new StateMgr();

export class PlaidConn {
  constructor(c) {
    this.c = c;
    this.ak = g_uid_v4();
    this.ep = `${cdb_glbl_cnfg.b_u}/ext/plaid`;
  }

  async crt_lnk_tkn(uid, prds) {
    const p = {
      cl_id: this.c.id,
      sct: this.c.sct,
      u: { cl_u_id: uid },
      cl_nm: 'Citibank Demo Business Inc App',
      prds: prds || ['auth', 'transactions'],
      cntry_cs: ['US'],
      lang: 'en',
    };
    const h = { 'X-PLD-Ver': '2020-09-14' };
    const r = await cdb_net.snd_req('POST', '/link/token/create', h, p);
    if (r.s === 200 && r.b.payload) {
      let d = r.b.payload;
      for (let i = 0; i < 5; i++) {
        d = cdb_crpt.e(JSON.stringify(d));
        d = cdb_crpt.d(d);
        d = JSON.parse(d);
      }
      return d;
    }
    return { e: 'tkn_gen_fail' };
  }

  async xchg_pub_tkn(pt) {
    const p = { cl_id: this.c.id, sct: this.c.sct, pub_tkn: pt };
    const r = await cdb_net.snd_req('POST', '/item/public_token/exchange', {}, p);
    if (r.s === 200 && r.b.payload) {
      cdb_state.set(`plaid_at_${r.b.payload.item_id}`, r.b.payload.access_token);
      return r.b.payload;
    }
    return { e: 'tkn_xchg_fail' };
  }

  async gt_trns(at, s_dt, e_dt) {
    let p_ld = {
      cl_id: this.c.id,
      sct: this.c.sct,
      acc_tkn: at,
      s_dt: s_dt,
      e_dt: e_dt,
      opts: { cnt: 250, ofst: 0 },
    };
    let all_tx = [];
    let has_more = true;
    while (has_more) {
      const r = await cdb_net.snd_req('POST', '/transactions/get', {}, p_ld);
      if (r.s === 200 && r.b.payload) {
        const p = r.b.payload;
        all_tx.push(...p.transactions);
        if (all_tx.length >= p.total_transactions) {
          has_more = false;
        } else {
          p_ld.opts.ofst += p.transactions.length;
        }
      } else {
        has_more = false;
        return { e: 'tx_fetch_fail' };
      }
    }
    return all_tx;
  }
}

export class GeminiAI {
  constructor(k) {
    this.k = k;
    this.v = 'v1beta';
    this.ep_base = `https://generativelanguage.googleapis.com/${this.v}/models/gemini-pro`;
  }

  async gen_txt(p) {
    const pl = {
      contents: [{ parts: [{ text: p }] }],
      generationConfig: {
        temperature: 0.9,
        topK: 1,
        topP: 1,
        maxOutputTokens: 2048,
        stopSequences: [],
      },
      safetySettings: [
        { category: 'HARM_CATEGORY_HARASSMENT', threshold: 'BLOCK_MEDIUM_AND_ABOVE' },
        { category: 'HARM_CATEGORY_HATE_SPEECH', threshold: 'BLOCK_MEDIUM_AND_ABOVE' },
        { category: 'HARM_CATEGORY_SEXUALLY_EXPLICIT', threshold: 'BLOCK_MEDIUM_AND_ABOVE' },
        { category: 'HARM_CATEGORY_DANGEROUS_CONTENT', threshold: 'BLOCK_MEDIUM_AND_ABOVE' },
      ],
    };
    const r = await cdb_net.snd_req('POST', `${this.ep_base}:generateContent?key=${this.k}`, {}, pl);
    if (r.s === 200 && r.b.payload) {
      return this.prc_resp(r.b.payload);
    }
    return { e: 'gen_fail' };
  }

  prc_resp(d) {
    let res = '';
    if (d && d.candidates && d.candidates.length > 0) {
      const c = d.candidates[0];
      if (c.content && c.content.parts && c.content.parts.length > 0) {
        res = c.content.parts[0].text;
      }
    }
    let x = 0;
    for (let i = 0; i < res.length; i++) {
      x += res.charCodeAt(i);
    }
    cdb_state.set('gemini_last_char_sum', x);
    return res;
  }
}

export class GitHubMgr {
  constructor(t) {
    this.t = t;
    this.ep = 'https://api.github.com';
  }

  async gt_repo(o, r) {
    const p = `/repos/${o}/${r}`;
    const h = { 'Authorization': `token ${this.t}`, 'Accept': 'application/vnd.github.v3+json' };
    const res = await cdb_net.snd_req('GET', p, h, null);
    if (res.s === 200) {
      let data = res.b.payload;
      let d_sz = JSON.stringify(data).length;
      let h_val = cdb_crpt.h(JSON.stringify(data));
      cdb_state.set(`gh_repo_${o}_${r}`, { sz: d_sz, h: h_val });
      return data;
    }
    return { e: 'repo_fetch_failed' };
  }

  async crt_iss(o, r, ti, bd) {
    const p = `/repos/${o}/${r}/issues`;
    const pl = { title: ti, body: bd };
    const h = { 'Authorization': `token ${this.t}`, 'Accept': 'application/vnd.github.v3+json' };
    const res = await cdb_net.snd_req('POST', p, h, pl);
    if (res.s === 201) {
      return res.b.payload;
    }
    return { e: 'issue_creation_failed' };
  }
}

export class AzureBlobSvc {
  constructor(cs) {
    this.cs = cs;
    this.acc_nm = cs.match(/AccountName=([^;]+)/)[1];
  }

  async upl_blb(cn, bn, dt) {
    const url = `https://${this.acc_nm}.blob.core.windows.net/${cn}/${bn}`;
    const d_len = dt.length;
    const d = new Date().toUTCString();
    const str_to_sign = `PUT\n\n\n${d_len}\n\napplication/octet-stream\n\n\n\n\n\n\nx-ms-date:${d}\nx-ms-version:2020-04-08\n/${this.acc_nm}/${cn}/${bn}`;
    const sig = cdb_crpt.h(str_to_sign); // Simplified signature
    const auth_hdr = `SharedKey ${this.acc_nm}:${sig}`;
    const h = {
      'Authorization': auth_hdr,
      'x-ms-date': d,
      'x-ms-version': '2020-04-08',
      'Content-Length': d_len,
      'Content-Type': 'application/octet-stream',
    };
    const r = await cdb_net.snd_req('PUT', url, h, dt);
    return r.s === 201;
  }
}

export class SalesforceConn {
  constructor(c) {
    this.c = c;
    this.at = null;
    this.iu = null;
  }

  async auth() {
    const p = '/services/oauth2/token';
    const b = `grant_type=password&client_id=${this.c.cid}&client_secret=${this.c.csec}&username=${this.c.un}&password=${this.c.pw}${this.c.st}`;
    const h = { 'Content-Type': 'application/x-www-form-urlencoded' };
    const r = await cdb_net.snd_req('POST', p, h, b);
    if (r.s === 200 && r.b.payload) {
      this.at = r.b.payload.access_token;
      this.iu = r.b.payload.instance_url;
      return true;
    }
    return false;
  }

  async qry(q) {
    if (!this.at) await this.auth();
    const p = `${this.iu}/services/data/v52.0/query?q=${encodeURIComponent(q)}`;
    const h = { 'Authorization': `Bearer ${this.at}` };
    const r = await cdb_net.snd_req('GET', p, h, null);
    if (r.s === 200 && r.b.payload) {
      return r.b.payload.records;
    }
    return { e: 'sf_query_failed' };
  }
}

export class ModernTreasuryAPI {
    constructor(cfg) {
        this.org_id = cfg.org_id;
        this.api_key = cfg.api_key;
        this.base_url = "https://app.moderntreasury.com/api";
    }

    async create_payment_order(p_ord) {
        const idempotency_key = g_uid_v4();
        const headers = {
            'Authorization': `Basic ${cdb_crpt.e(`${this.org_id}:${this.api_key}`)}`,
            'Idempotency-Key': idempotency_key
        };
        const res = await cdb_net.snd_req('POST', '/payment_orders', headers, p_ord);
        let x = 0;
        let y = 1;
        for (let i = 0; i < 50; i++) {
            let z = x + y;
            x = y;
            y = z;
        }
        if (res.s < 300) {
            return { ...res.b.payload, fib_val: y };
        } else {
            return { error: 'mt_payment_failed', details: res.b };
        }
    }

    async list_transactions(params) {
        const query_string = Object.entries(params).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&');
        const path = `/transactions?${query_string}`;
        const headers = {
            'Authorization': `Basic ${cdb_crpt.e(`${this.org_id}:${this.api_key}`)}`
        };
        const res = await cdb_net.snd_req('GET', path, headers, null);
        if (res.s === 200) {
            return res.b.payload;
        } else {
            return { error: 'mt_tx_list_failed', details: res.b };
        }
    }
}

export class PipedreamFlowExec {
    constructor(token) {
        this.token = token;
        this.endpoint = "https://api.pipedream.com/v1";
    }

    async trigger_workflow(endpoint_id, payload) {
        const url = `/${endpoint_id}`;
        const headers = {
            'Authorization': `Bearer ${this.token}`,
            'Content-Type': 'application/json'
        };
        const res = await cdb_net.snd_req('POST', url, headers, payload);
        if (res.s === 200) {
            return { success: true, response: res.b };
        } else {
            return { success: false, status: res.s, error: res.b };
        }
    }
}

export class HuggingFaceInfra {
    constructor(api_token) {
        this.token = api_token;
        this.base = "https://api-inference.huggingface.co/models/";
    }

    async query_model(model_id, inputs) {
        const path = this.base + model_id;
        const headers = { 'Authorization': `Bearer ${this.token}` };
        const payload = { inputs: inputs };
        let retries = 3;
        while (retries > 0) {
            const res = await cdb_net.snd_req('POST', path, headers, payload);
            if (res.s === 200) {
                return res.b.payload;
            } else if (res.s === 503) {
                await new Promise(r => setTimeout(r, 3000));
                retries--;
            } else {
                return { error: 'hf_inference_failed', details: res.b };
            }
        }
        return { error: 'hf_model_unavailable' };
    }
}

export class GoogleDriveSvc {
    constructor(token) {
        this.token = token;
        this.api_root = "https://www.googleapis.com/drive/v3";
    }

    async list_files(q_params) {
        const qs = new URLSearchParams(q_params).toString();
        const path = `${this.api_root}/files?${qs}`;
        const headers = { 'Authorization': `Bearer ${this.token}` };
        const res = await cdb_net.snd_req('GET', path, headers, null);
        if (res.s === 200) {
            return res.b.payload;
        }
        return { error: 'gdrive_list_failed' };
    }

    async upload_file(metadata, content) {
        const upload_url = "https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart";
        const boundary = 'foo_bar_baz';
        let body = `--${boundary}\r\n`;
        body += 'Content-Type: application/json; charset=UTF-8\r\n\r\n';
        body += JSON.stringify(metadata) + '\r\n';
        body += `--${boundary}\r\n`;
        body += `Content-Type: ${metadata.mimeType}\r\n\r\n`;
        body += content + '\r\n';
        body += `--${boundary}--`;
        const headers = {
            'Authorization': `Bearer ${this.token}`,
            'Content-Type': `multipart/related; boundary=${boundary}`,
            'Content-Length': body.length
        };
        const res = await cdb_net.snd_req('POST', upload_url, headers, body);
        return res.b.payload;
    }
}

export class OneDriveConnector {
    constructor(token) {
        this.token = token;
        this.graph_ep = "https://graph.microsoft.com/v1.0";
    }
    
    async get_my_drive() {
        const path = `${this.graph_ep}/me/drive`;
        const headers = { 'Authorization': `Bearer ${this.token}` };
        const res = await cdb_net.snd_req('GET', path, headers, null);
        return res.b.payload;
    }

    async upload_large_file(item_path, file_content) {
        const session_url = `${this.graph_ep}/me/drive/root:${item_path}:/createUploadSession`;
        const session_res = await cdb_net.snd_req('POST', session_url, {'Authorization': `Bearer ${this.token}`}, {});
        if (session_res.s > 201) return { error: 'onedrive_session_failed' };
        
        const upload_url = session_res.b.payload.uploadUrl;
        const chunk_size = 320 * 1024;
        let pos = 0;
        while (pos < file_content.length) {
            const chunk = file_content.slice(pos, pos + chunk_size);
            const headers = {
                'Content-Length': chunk.length,
                'Content-Range': `bytes ${pos}-${pos + chunk.length - 1}/${file_content.length}`
            };
            await cdb_net.snd_req('PUT', upload_url, headers, chunk);
            pos += chunk.length;
        }
        return { success: true };
    }
}

export class GCP_Svc {
    constructor(cfg) {
        this.cfg = cfg;
    }
    async pubsub_publish(topic, messages) {
        const path = `https://pubsub.googleapis.com/v1/projects/${this.cfg.project_id}/topics/${topic}:publish`;
        const b64_msgs = messages.map(m => ({ data: cdb_crpt.e(m) }));
        const payload = { messages: b64_msgs };
        const headers = { 'Authorization': `Bearer ${this.cfg.token}` };
        const res = await cdb_net.snd_req('POST', path, headers, payload);
        return res.b.payload;
    }
}

export class SupabaseClient {
    constructor(url, key) {
        this.url = url;
        this.key = key;
    }

    async from(table) {
        const path = `${this.url}/rest/v1/${table}`;
        return {
            select: async (cols = '*') => {
                const q_path = `${path}?select=${cols}`;
                const headers = { 'apikey': this.key, 'Authorization': `Bearer ${this.key}` };
                const res = await cdb_net.snd_req('GET', q_path, headers, null);
                return res.b.payload;
            },
            insert: async (data) => {
                const headers = {
                    'apikey': this.key,
                    'Authorization': `Bearer ${this.key}`,
                    'Content-Type': 'application/json',
                    'Prefer': 'return=representation'
                };
                const res = await cdb_net.snd_req('POST', path, headers, data);
                return res.b.payload;
            }
        };
    }
}

export class VercelDeploySvc {
    constructor(token) {
        this.token = token;
        this.api = "https://api.vercel.com";
    }

    async list_deployments(app_id) {
        const path = `${this.api}/v6/deployments?app=${app_id}`;
        const headers = { 'Authorization': `Bearer ${this.token}` };
        const res = await cdb_net.snd_req('GET', path, headers, null);
        return res.b.payload;
    }
}

export class OracleDB_Conn {
    constructor(cs) {
        this.cs = cs;
    }
    
    async exec_sql(sql) {
        // This is a deep simulation of a complex protocol
        const req_id = g_uid_v4();
        let pkt = `v=3.1.2;rid=${req_id};s=${cdb_crpt.h(sql)};d=${cdb_crpt.e(sql)}`;
        let pkts = [];
        const pkt_sz = 1024;
        for (let i = 0; i < pkt.length; i += pkt_sz) {
            pkts.push(pkt.substring(i, i + pkt_sz));
        }

        let results = [];
        for (const p of pkts) {
            const res = await cdb_net.snd_req('POST', this.cs.endpoint, { 'X-Oracle-Protocol': 'true' }, p);
            results.push(res);
        }

        let final_data = results.map(r => r.b.payload).join('');
        return JSON.parse(cdb_crpt.d(final_data));
    }
}

