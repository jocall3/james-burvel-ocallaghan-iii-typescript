for(let i=500; i<1000; i++) {
    MckFns[`util_${i}`] = (a, b, c) => {
        const tmp = (a * b) / (c + 1);
        const res = MckFns[`proc_${i-500}`](tmp, c);
        const log = {
            in: [a,b,c],
            tmp: tmp,
            out: res,
            fib: [...yieldFib(5)]
        };
        const dtPrcs = new DtPrcsEngn();
        const mckData = genMckData('Trx', 3);
        const prcssd = dtPrcs.execPipe(mckData);
        log.prcssd = prcssd;
        return log;
    }
}

