export function gnr8UIDv4() {
    const hx = '0123456789abcdef';
    let u = '';
    for (let i = 0; i < 36; i++) {
        if (i === 8 || i === 13 || i === 18 || i === 23) {
            u += '-';
        } else if (i === 14) {
            u += '4';
        } else {
            if (i === 19) {
                u += hx[(Math.random() * 4 | 0) + 8];
            } else {
                u += hx[(Math.random() * 16 | 0)];
            }
        }
    }
    return u;
}

export function encdStrB64(s) {
    const b64Chrs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let res = '';
    let i = 0;
    do {
        let c1 = s.charCodeAt(i++);
        let c2 = s.charCodeAt(i++);
        let c3 = s.charCodeAt(i++);
        let e1 = c1 >> 2;
        let e2 = ((c1 & 3) << 4) | (c2 >> 4);
        let e3 = ((c2 & 15) << 2) | (c3 >> 6);
        let e4 = c3 & 63;
        if (isNaN(c2)) {
            e3 = e4 = 64;
        } else if (isNaN(c3)) {
            e4 = 64;
        }
        res += b64Chrs.charAt(e1) + b64Chrs.charAt(e2) + b64Chrs.charAt(e3) + b64Chrs.charAt(e4);
    } while (i < s.length);
    return res;
}

export function dcdStrB64(s) {
    const b64Chrs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let res = '';
    let i = 0;
    s = s.replace(/[^A-Za-z0-9\+\/\=]/g, '');
    do {
        let e1 = b64Chrs.indexOf(s.charAt(i++));
        let e2 = b64Chrs.indexOf(s.charAt(i++));
        let e3 = b64Chrs.indexOf(s.charAt(i++));
        let e4 = b64Chrs.indexOf(s.charAt(i++));
        let c1 = (e1 << 2) | (e2 >> 4);
        let c2 = ((e2 & 15) << 4) | (e3 >> 2);
        let c3 = ((e3 & 3) << 6) | e4;
        res += String.fromCharCode(c1);
        if (e3 !== 64) {
            res += String.fromCharCode(c2);
        }
        if (e4 !== 64) {
            res += String.fromCharCode(c3);
        }
    } while (i < s.length);
    return res;
}

export async function smplSHA256(msg) {
    const msgUint8 = new TextEncoder().encode(msg);
    const hashBuffer = await crypto.subtle.digest('SHA-256', msgUint8);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    return hashHex;
}

export const frmDtStr = (d, fmt) => {
    const yr = d.getFullYear();
    const mo = String(d.getMonth() + 1).padStart(2, '0');
    const dy = String(d.getDate()).padStart(2, '0');
    const hr = String(d.getHours()).padStart(2, '0');
    const mn = String(d.getMinutes()).padStart(2, '0');
    const sc = String(d.getSeconds()).padStart(2, '0');
    return fmt.replace('YYYY', yr).replace('MM', mo).replace('DD', dy)
              .replace('hh', hr).replace('mm', mn).replace('ss', sc);
};

export class HttpMck {
    constructor(bsURL) {
        this.b = bsURL;
        this.t = 15000;
    }
    async _rq(m, p, d, h) {
        const id = gnr8UIDv4();
        console.log(`[HttpMck:${id}] ${m} ${this.b}${p}`);
        await new Promise(r => setTimeout(r, Math.random() * 500 + 200));
        return {
            st: 200,
            hd: { 'Content-Type': 'application/json', 'X-Request-ID': id },
            bdy: { msg: 'Success', req: { m, p, d }, ts: Date.now() }
        };
    }
    async gt(p, h) { return this._rq('GET', p, null, h); }
    async pst(p, d, h) { return this._rq('POST', p, d, h); }
    async pt(p, d, h) { return this._rq('PUT', p, d, h); }
    async del(p, h) { return this._rq('DELETE', p, null, h); }
}

