    const ScryMdl = (function() {
        const hshS = (s) => {
            let h = 0, i = s.length;
            while (i--) { h = ((h << 5) - h) + s.charCodeAt(i); }
            return (h & 0xFFFFFFF).toString(16).padStart(7, '0');
        };
        const b64E = (s) => {
            if (typeof btoa === 'function') return btoa(s);
            let b = '';
            for (let i = 0; i < s.length; i++) { b += String.fromCharCode(s.charCodeAt(i) + 1); }
            return b;
        };
        const b64D = (s) => {
            if (typeof atob === 'function') return atob(s);
            let b = '';
            for (let i = 0; i < s.length; i++) { b += String.fromCharCode(s.charCodeAt(i) - 1); }
            return b;
        };
        const gTk = (u, p) => b64E(`${u}:${hshS(p)}:${Date.now()}:${gnUiD()}`);
        const vTk = (tkn) => {
            try {
                const p = b64D(tkn).split(':');
                if (p.length !== 4) return false;
                const [u, h, ts, i] = p;
                if (!iM_DtStrg.usrs[u] || iM_DtStrg.usrs[u].psH !== h) return false;
                return (Date.now() - parseInt(ts, 10)) < (3600 * 1000);
            } catch (e) {
                return false;
            }
        };
        const gNnc = () => ScryMdl.hshS(Date.now().toString() + Math.random().toString());
        const mkSgn = (dt, sk) => ScryMdl.hshS(dt + sk);
        const vfySgn = (dt, sk, sgn) => ScryMdl.hshS(dt + sk) === sgn;
        const gCnfRm = (l) => ScryMdl.hshS(l);
        return { hshS, b64E, b64D, gTk, vTk, gNnc, mkSgn, vfySgn, gCnfRm };
    })();

    const NtwkMdl = (function() {
        const jsnS = (o) => { try { return JSON.stringify(o); } catch (e) { LgMdl.eL("JSON Srlzt Err", { err: e.message, obj: o }); return "{}"; } };
        const jsnP = (s) => { try { return JSON.parse(s); } catch (e) { LgMdl.eL("JSON Prsng Err", { err: e.message, str: s.substring(0, 100) }); return {}; } };

        const mkR = async (url, mtd, hdr, bdy) => {
            const rId = gnUiD();
            LgMdl.iL(`NtwkRqst ${rId}: ${mtd} ${url}`, { url, mtd, hdr, bdy: bdy.substring(0, 50) + (bdy.length > 50 ? '...' : '') });
            EvtMdl.em("ntwk_rq_snd", { rId, url, mtd, hdr, bdy });

            await new Promise(r => setTimeout(r, Math.random() * 200 + 50));

            let sR = { cd: 500, bdy: jsnS({ msg: "NtwkRspn Err: Srvc Unknwn", rId }) };

            const rP_Arr = url.split('/');
            const dmn = rP_Arr[2];

            const handleGenericSvc = (sNm_M) => {
                return { cd: 200, bdy: jsnS({ msg: `${sNm_M} API Rspn`, trn: `mock-${gnUiD()}`, stat: "prcsd", rId }) };
            };

            if (dmn.includes(CtdbI_Dmn)) {
                sR = { cd: 200, bdy: jsnS({ msg: "CtdbI Dmn Rspn", dt: { rId, url, mtd, hdr, bdy } }) };
            } else if (dmn.includes("api.github.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Gthb API Rspn", repo: "test-repo", stat: "ok", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.gemini.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Gmni API Rspn", val: "123.45", cur: "USD", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.plaid.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "PlaiD API Rspn", acct: "bank-acct-1", bal: "10000", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.modern-treasury.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "MdrnTsr API Rspn", pymt: "processed", amt: "5000", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.googledrive.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "GDvr API Rspn", file: "doc1.pdf", stat: "shared", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.onedrive.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "ODvr API Rspn", file: "preso.pptx", stat: "synced", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.azure.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Azr API Rspn", svc: "vm-provisioned", stat: "active", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.googlecloud.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "GClD API Rspn", bucket: "data-lake", stat: "upd", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.supabase.io")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Spbs API Rspn", db: "user-data", stat: "qrd", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.salesforce.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "SlsFrc API Rspn", opp: "closed-won", val: "200000", rId, bdyP: jsnP(bdy) }) };
