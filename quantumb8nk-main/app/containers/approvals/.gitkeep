            { id: gnUiD(), nm: "Oracle", bU: "https://cloud.oracle.com", aK: ScryMdl.hshS("OracleAK"), sS: ScryMdl.hshS("OracleSK"), st: "active", mD: { type: "enterprise_db", category: "database", tags: ["erp"] } },
            { id: gnUiD(), nm: "MARQETA", bU: "https://api.marqeta.com/v3", aK: ScryMdl.hshS("MARQETAAK"), sS: ScryMdl.hshS("MARQETASK"), st: "active", mD: { type: "card_issuing", category: "finance", tags: ["payments", "cards"] } },
            { id: gnUiD(), nm: "Citibank", bU: "https://api.citibank.com/v1", aK: ScryMdl.hshS("CitibankAK"), sS: ScryMdl.hshS("CitibankSK"), st: "active", mD: { type: "bank", category: "finance", tags: ["banking"] } },
            { id: gnUiD(), nm: "Shopify", bU: "https://{shop}.myshopify.com/admin/api/2023-10/", aK: ScryMdl.hshS("ShopifyAK"), sS: ScryMdl.hshS("ShopifySK"), st: "active", mD: { type: "e_commerce", category: "business_app", tags: ["retail"] } },
