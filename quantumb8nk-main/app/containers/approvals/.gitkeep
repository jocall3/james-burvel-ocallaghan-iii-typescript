export const CtdbI_ApprvlSstm = (function() {

    const CtdbI_Dmn = "citibankdemobusiness.dev";
    const CtdbI_Nm = "Citibank demo business Inc";

    let uiGc = 0;
    const gnUiD = () => `id_${(uiGc++).toString(36)}${Date.now().toString(36)}`;

    const iM_DtStrg = {
        usrs: {},
