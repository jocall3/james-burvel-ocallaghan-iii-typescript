            { id: gnUiD(), nm: "OneDrive", bU: "https://graph.microsoft.com/v1.0/me/drive", aK: ScryMdl.hshS("OneDriveAK"), sS: ScryMdl.hshS("OneDriveSK"), st: "active", mD: { type: "cloud_storage", category: "storage", tags: ["files"] } },
            { id: gnUiD(), nm: "Azure", bU: "https://management.azure.com", aK: ScryMdl.hshS("AzureAK"), sS: ScryMdl.hshS("AzureSK"), st: "active", mD: { type: "cloud_platform", category: "cloud", tags: ["iaas", "paas"] } },
            { id: gnUiD(), nm: "GoogleCloud", bU: "https://cloudresourcemanager.googleapis.com/v1", aK: ScryMdl.hshS("GoogleCloudAK"), sS: ScryMdl.hshS("GoogleCloudSK"), st: "active", mD: { type: "cloud_platform", category: "cloud", tags: ["gcp"] } },
            { id: gnUiD(), nm: "Supabase", bU: "https://api.supabase.io/v1", aK: ScryMdl.hshS("SupabaseAK"), sS: ScryMdl.hshS("SupabaseSK"), st: "active", mD: { type: "backend_as_service", category: "development", tags: ["baas", "database"] } },
            { id: gnUiD(), nm: "Vervet", bU: "https://api.vervet.com/v1", aK: ScryMdl.hshS("VervetAK"), sS: ScryMdl.hshS("VervetSK"), st: "active", mD: { type: "telecom_api", category: "communication", tags: ["sms", "voice"] } },
