            } else if (dmn.includes("api.marqeta.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Mrqt API Rspn", card: "issued", trn: "approved", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.shopify.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Shpfy API Rspn", ord: "fulfilled", ttl: "1500", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.woocommerce.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Wmrc API Rspn", prod: "stock-upd", cnt: "100", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.godaddy.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "GdDy API Rspn", dom: "registered", exp: "2025-12-31", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.adobe.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Adb API Rspn", doc: "signed", fmt: "pdf", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.twilio.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Twli API Rspn", sms: "sent", to: "+1234567890", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.huggingface.co")) {
                sR = { cd: 200, bdy: jsnS({ msg: "HgFcs API Rspn", mdl: "inference", out: "text-gen", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.chathot.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "CtHt API Rspn", query: "bot-resp", resp: "AI-gen-txt", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.pipedream.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "PpDr API Rspn", wkfl: "executed", stat: "complete", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.vervet.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Vrvt API Rspn", cstmr: "activated", svc: "telecom", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.cpanel.net")) {
                sR = { cd: 200, bdy: jsnS({ msg: "Cpn API Rspn", host: "domain-add", stat: "ok", rId, bdyP: jsnP(bdy) }) };
            } else if (dmn.includes("api.citibank.com")) {
                sR = { cd: 200, bdy: jsnS({ msg: "CtBnk API Rspn", acct: "balance", amt: "999999", rId, bdyP: jsnP(bdy) }) };
            } else {
                const sNm_M = Object.keys(iM_DtStrg.svcs_cnfg).find(sn => dmn.includes(sn.toLowerCase().replace(/[^a-z0-9]/g, '')));
                if (sNm_M) {
                    sR = handleGenericSvc(sNm_M);
                }
            }

            LgMdl.iL(`NtwkRspn ${rId}: Sttus ${sR.cd}`, { cd: sR.cd, bdy: sR.bdy.substring(0, 50) + (sR.bdy.length > 50 ? '...' : '') });
            EvtMdl.em("ntwk_rsp_rcv", { rId, cd: sR.cd, bdy: sR.bdy });
            return sR;
        };
        return { mkR, jsnP, jsnS };
    })();

    const LgMdl = (function() {
        const iL = (msg, dt = {}) => {
            const lgE = { ts: Date.now(), lvl: "INFO", msg, dt, lgId: gnUiD() };
            iM_DtStrg.lgs.push(lgE);
        };
        const wL = (msg, dt = {}) => {
            const lgE = { ts: Date.now(), lvl: "WARN", msg, dt, lgId: gnUiD() };
            iM_DtStrg.lgs.push(lgE);
        };
        const eL = (msg, dt = {}) => {
            const lgE = { ts: Date.now(), lvl: "ERROR", msg, dt, lgId: gnUiD() };
            iM_DtStrg.lgs.push(lgE);
            console.error(msg, dt);
        };
        const audL = (act, usrId, objTyp, objId, chngs = {}) => {
            const audE = { ts: Date.now(), act, usrId, objTyp, objId, chngs, audId: gnUiD() };
            iM_DtStrg.audt_lgs.push(audE);
        };
        const gLs = () => [...iM_DtStrg.lgs];
        const gALs = () => [...iM_DtStrg.audt_lgs];
        return { iL, wL, eL, audL, gLs, gALs };
    })();

    const EvtMdl = (function() {
        const hs = {};
        const on = (ev, cb) => {
            if (!hs[ev]) hs[ev] = [];
            hs[ev].push(cb);
        };
        const of = (ev, cb) => {
            if (!hs[ev]) return;
            hs[ev] = hs[ev].filter(c => c !== cb);
        };
        const em = (ev, dt) => {
            LgMdl.iL(`Evt Emtd: ${ev}`, dt);
            iM_DtStrg.evts.push({ ts: Date.now(), ev, dt, evId: gnUiD() });
            if (hs[ev]) {
                hs[ev].forEach(cb => {
                    try { cb(dt); } catch (e) { LgMdl.eL(`Evt Hndlr Err for ${ev}`, { err: e.message, dt, cb: cb.name }); }
                });
            }
        };
        const gEvs = () => [...iM_DtStrg.evts];
        return { on, of, em, gEvs };
    })();

    const DtStrgMdl = (function() {
        const sDt = (ky, v) => {
            const cKy = ky;
            if (!iM_DtStrg[cKy]) iM_DtStrg[cKy] = {};
            const oldV = iM_DtStrg[cKy][Object.keys(v)[0]];
            iM_DtStrg[cKy] = { ...iM_DtStrg[cKy], ...v };
            LgMdl.iL(`DtStrg: ${cKy} upd`, { cKy, vId: Object.keys(v)[0] });
            EvtMdl.em(`dt_${cKy}_upd`, { cKy, vId: Object.keys(v)[0], oldV, newV: v[Object.keys(v)[0]] });
            return true;
        };
        const gDt = (ky, id) => {
            if (!iM_DtStrg[ky]) return null;
            return iM_DtStrg[ky][id];
        };
        const qDt = (ky, flt) => {
            if (!iM_DtStrg[ky]) return [];
            return Object.values(iM_DtStrg[ky]).filter(flt);
        };
        const dDt = (ky, id) => {
            if (!iM_DtStrg[ky] || !iM_DtStrg[ky][id]) return false;
            const rV = iM_DtStrg[ky][id];
            delete iM_DtStrg[ky][id];
            LgMdl.wL(`DtStrg: ${ky} dlt`, { ky, id, rV });
            EvtMdl.em(`dt_${ky}_dlt`, { ky, id, rV });
            return true;
        };
        return { sDt, gDt, qDt, dDt };
    })();

    const UsrRlMdl = (function() {
        DtStrgMdl.sDt("rLs", {
            "admin": { id: "admin", nm: "Admn", dsc: "Full sys acc", prmsns: ["apvl_mnt", "usr_mnt", "svc_cnfg", "sys_audt", "nfy_mgr", "data_export", "wkfl_edit", "api_key_mgr", "sec_cntrl"] },
            "manager": { id: "manager", nm: "Mngr", dsc: "Mngmt apprvls", prmsns: ["apvl_mnt", "trns_vw", "usr_vw", "report_access", "wkfl_view"] },
            "user": { id: "user", nm: "Usr", dsc: "Std user acc", prmsns: ["trns_sbmt", "trns_vw", "apvl_vw", "profile_edit"] },
            "auditor": { id: "auditor", nm: "Audtr", dsc: "Read-only audit acc", prmsns: ["sys_audt", "trns_vw", "apvl_vw", "lgs_vw"] },
            "developer": { id: "developer", nm: "Dev", dsc: "Svc intgrtn", prmsns: ["svc_cnfg", "api_key_mgr", "ntwk_tst", "lgs_vw"] }
        });

        const cU = (uN, pW, rL, extDt = {}) => {
            const eU = DtStrgMdl.gDt("usrs", uN);
            if (eU) {
                LgMdl.eL(`Usr Crte Err: Usr ${uN} alrdy exsts`);
                return null;
            }
            const hP = ScryMdl.hshS(pW);
            const nU = { uN, psH: hP, rL, crTs: Date.now(), uD: Date.now(), stt: "active", ...extDt };
            DtStrgMdl.sDt("usrs", { [uN]: nU });
            LgMdl.iL(`Usr Crtd: ${uN} with role ${rL}`);
            LgMdl.audL("CRTE_USR", "system", "user", uN, { rL });
            return nU;
        };
        const gU = (uN) => DtStrgMdl.gDt("usrs", uN);
        const lU = (uN, pW) => {
            const u = DtStrgMdl.gDt("usrs", uN);
            if (!u || u.psH !== ScryMdl.hshS(pW)) {
                LgMdl.eL(`Usr Lgn Err: Invld crds for ${uN}`);
                return null;
            }
            const tkn = ScryMdl.gTk(uN, pW);
            DtStrgMdl.sDt("tkns", { [uN]: tkn });
            LgMdl.iL(`Usr Lgnd: ${uN}`);
            LgMdl.audL("LGN_USR", uN, "user", uN, { tkn });
            return tkn;
        };
        const vPrmsn = (uN, prmsn) => {
            const u = DtStrgMdl.gDt("usrs", uN);
            if (!u) return false;
            const rL = DtStrgMdl.gDt("rLs", u.rL);
            if (!rL) return false;
            return rL.prmsns.includes(prmsn);
        };
        const uU = (uN, udt) => {
            const u = DtStrgMdl.gDt("usrs", uN);
            if (!u) return null;
            const uU = { ...u, ...udt, uD: Date.now() };
            DtStrgMdl.sDt("usrs", { [uN]: uU });
            LgMdl.audL("UPDT_USR", uN, "user", uN, { old: u, new: uU });
            return uU;
        };
        const dU = (uN) => {
            const r = DtStrgMdl.dDt("usrs", uN);
            if (r) LgMdl.audL("DEL_USR", "system", "user", uN, {});
            return r;
        };

        cU("admin1", "adpass123", "admin", { eml: "admin1@ctdb.dev" });
        cU("manager1", "mgpass123", "manager", { eml: "manager1@ctdb.dev" });
        cU("user1", "usrpass123", "user", { eml: "user1@ctdb.dev" });
        cU("auditor1", "adpass123", "auditor", { eml: "auditor1@ctdb.dev" });
        cU("developer1", "devpass123", "developer", { eml: "developer1@ctdb.dev" });

        return { cU, gU, lU, vPrmsn, uU, dU, gRls: () => Object.values(iM_DtStrg.rLs) };
    })();

    const SvcCnfgMdl = (function() {
        const _allSvcs = [
            { id: gnUiD(), nm: "Gemini", bU: "https://api.gemini.com/v1", aK: ScryMdl.hshS("GeminiAK"), sS: ScryMdl.hshS("GeminiSK"), st: "active", mD: { type: "crypto_exchange", category: "finance", tags: ["digital asset"] } },
            { id: gnUiD(), nm: "ChatHot", bU: "https://api.chathot.com/v2", aK: ScryMdl.hshS("ChatHotAK"), sS: ScryMdl.hshS("ChatHotSK"), st: "active", mD: { type: "ai_chat", category: "communication", tags: ["nlp"] } },
            { id: gnUiD(), nm: "Pipedream", bU: "https://api.pipedream.com/v1", aK: ScryMdl.hshS("PipedreamAK"), sS: ScryMdl.hshS("PipedreamSK"), st: "active", mD: { type: "workflow_automation", category: "integration", tags: ["serverless"] } },
            { id: gnUiD(), nm: "GitHub", bU: "https://api.github.com/v3", aK: ScryMdl.hshS("GitHubAK"), sS: ScryMdl.hshS("GitHubSK"), st: "active", mD: { type: "code_repo", category: "development", tags: ["version control"] } },
            { id: gnUiD(), nm: "HuggingFaces", bU: "https://api.huggingface.co/v1", aK: ScryMdl.hshS("HuggingFacesAK"), sS: ScryMdl.hshS("HuggingFacesSK"), st: "active", mD: { type: "ai_platform", category: "ai/ml", tags: ["nlp", "vision"] } },
            { id: gnUiD(), nm: "Plaid", bU: "https://api.plaid.com/v2", aK: ScryMdl.hshS("PlaidAK"), sS: ScryMdl.hshS("PlaidSK"), st: "active", mD: { type: "financial_data", category: "finance", tags: ["banking"] } },
            { id: gnUiD(), nm: "ModernTreasury", bU: "https://api.moderntreasury.com/v1", aK: ScryMdl.hshS("ModernTreasuryAK"), sS: ScryMdl.hshS("ModernTreasurySK"), st: "active", mD: { type: "payment_ops", category: "finance", tags: ["treasury", "payments"] } },
