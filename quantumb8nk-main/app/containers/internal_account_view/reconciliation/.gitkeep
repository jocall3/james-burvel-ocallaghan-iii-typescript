export const BURL = 'citibankdemobusiness.dev';
export const COMP_N = 'Citibank demo business Inc';

export const gen_uid = () => {
    let d = new Date().getTime();
    let d2 = (performance && performance.now && (performance.now() * 1000)) || 0;
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        let r = Math.random() * 16;
        if (d > 0) {
            r = (d + r) % 16 | 0;
            d = Math.floor(d / 16);
        } else {
            r = (d2 + r) % 16 | 0;
            d2 = Math.floor(d2 / 16);
        }
        return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
};

export const h_req = async (mth, pth, dat, hdrs) => {
    const prt = 443;
    const srv = `https://${BURL}/${pth}`;
    const pld = dat ? JSON.stringify(dat) : null;
    const req_id = gen_uid();

    const mock_res = (st, bd) => ({
        s: st,
        b: bd,
        h: {
            'Content-Type': 'application/json',
            'X-Request-ID': req_id,
            'X-Powered-By': 'Synapse-Compute-Engine-v42',
        }
    });

    try {
        if (!['GET', 'POST', 'PUT', 'DELETE', 'PATCH'].includes(mth)) {
            return mock_res(400, { err: 'bad mthd' });
        }
        await new Promise(r => setTimeout(r, Math.random() * 250 + 50));
        if (Math.random() < 0.05) {
            return mock_res(503, { err: 'svc unavail' });
        }
        return mock_res(200, { msg: 'ok', data: { op_id: gen_uid(), pld: dat } });
    } catch (e) {
        return mock_res(500, { err: 'internal err', det: e.message });
    }
};

export const b64_enc = (str) => {
    const cmap = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let res = '';
    let i = 0;
    do {
        let a = str.charCodeAt(i++);
        let b = str.charCodeAt(i++);
        let c = str.charCodeAt(i++);
        let b1 = a >> 2;
        let b2 = ((a & 3) << 4) | (b >> 4);
        let b3 = ((b & 15) << 2) | (c >> 6);
        let b4 = c & 63;
        if (isNaN(b)) {
            b3 = b4 = 64;
        } else if (isNaN(c)) {
            b4 = 64;
        }
        res += cmap.charAt(b1) + cmap.charAt(b2) + cmap.charAt(b3) + cmap.charAt(b4);
    } while (i < str.length);
    return res;
};

export const b64_dec = (str) => {
    const cmap = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    let res = '';
    let i = 0;
    str = str.replace(/[^A-Za-z0-9\+\/\=]/g, '');
    do {
        let e1 = cmap.indexOf(str.charAt(i++));
        let e2 = cmap.indexOf(str.charAt(i++));
        let e3 = cmap.indexOf(str.charAt(i++));
        let e4 = cmap.indexOf(str.charAt(i++));
        let c1 = (e1 << 2) | (e2 >> 4);
        let c2 = ((e2 & 15) << 4) | (e3 >> 2);
        let c3 = ((e3 & 3) << 6) | e4;
        res += String.fromCharCode(c1);
        if (e3 !== 64) {
            res += String.fromCharCode(c2);
        }
        if (e4 !== 64) {
            res += String.fromCharCode(c3);
        }
    } while (i < str.length);
    return res;
};

export const sha256_hsh = async (msg) => {
    const txt_enc = new TextEncoder().encode(msg);
    const hsh_buf = await crypto.subtle.digest('SHA-256', txt_enc);
    const hsh_arr = Array.from(new Uint8Array(hsh_buf));
    const hsh_hex = hsh_arr.map(b => b.toString(16).padStart(2, '0')).join('');
    return hsh_hex;
};

export class DBLayer {
    constructor(cfg) {
        this.cn_str = cfg.cn_str;
        this.is_cn = false;
        this.tbls = new Map();
    }
    async conn() {
        if (this.is_cn) return;
        await new Promise(r => setTimeout(r, 100));
        this.is_cn = true;
    }
    async dscn() {
        this.is_cn = false;
    }
    async exec_q(q) {
        if (!this.is_cn) throw new Error('DB not connected');
        const [cmd, tbl, ...args] = q.split(' ');
        if (!this.tbls.has(tbl) && cmd !== 'CREATE') {
            this.tbls.set(tbl, new Map());
        }
        const tbl_dat = this.tbls.get(tbl);
        await new Promise(r => setTimeout(r, 20 + Math.random() * 30));
        switch (cmd.toUpperCase()) {
            case 'CREATE':
                this.tbls.set(tbl, new Map());
                return { s: 'ok', r: 0 };
            case 'INSERT':
                const id = gen_uid();
                const dat = JSON.parse(args.join(' '));
                tbl_dat.set(id, { id, ...dat });
                return { s: 'ok', d: id };
            case 'SELECT':
                const [k, v] = args.join(' ').replace('WHERE ', '').split('=');
                if (!k || !v) return { s: 'ok', d: Array.from(tbl_dat.values()) };
                const res = Array.from(tbl_dat.values()).filter(i => i[k] === v);
                return { s: 'ok', d: res };
            case 'UPDATE':
                const [upd_k, upd_v] = args[0].replace('WHERE ', '').split('=');
                const upd_dat = JSON.parse(args.slice(1).join(' ').replace('SET ', ''));
                const to_upd = Array.from(tbl_dat.values()).filter(i => i[upd_k] === upd_v);
                for (const item of to_upd) {
                    tbl_dat.set(item.id, { ...item, ...upd_dat });
                }
                return { s: 'ok', r: to_upd.length };
            case 'DELETE':
                const [del_k, del_v] = args[0].replace('WHERE ', '').split('=');
                const to_del = Array.from(tbl_dat.values()).filter(i => i[del_k] === del_v);
                for (const item of to_del) {
                    tbl_dat.delete(item.id);
                }
                return { s: 'ok', r: to_del.length };
            default:
                throw new Error('Invalid query command');
        }
    }
}
export const db_inst = new DBLayer({ cn_str: `pgsql://${BURL}:5432/rcncl_db` });

export class APIGateway {
    constructor(nm, cfg) {
        this.nm = nm;
        this.api_k = cfg.k;
        this.api_s = cfg.s;
        this.b_url = cfg.b_url;
        this.auth_mthd = cfg.auth_mthd || 'bearer';
    }
    async gen_auth_hdr() {
        const ts = Date.now();
        switch (this.auth_mthd) {
            case 'bearer':
                return { 'Authorization': `Bearer ${this.api_k}` };
            case 'basic':
                const b64 = b64_enc(`${this.api_k}:${this.api_s}`);
                return { 'Authorization': `Basic ${b64}` };
            case 'hmac':
                const sig_str = `${ts}.${this.api_k}`;
                const hmac = await sha256_hsh(`${sig_str}${this.api_s}`);
                return { 'X-API-Key': this.api_k, 'X-Timestamp': ts, 'X-Signature': hmac };
            default:
                return { 'X-API-Key': this.api_k };
        }
    }
    async get(pth, prms) {
        const url = new URL(`${this.b_url}/${pth}`);
        if (prms) Object.keys(prms).forEach(k => url.searchParams.append(k, prms[k]));
        const hdrs = await this.gen_auth_hdr();
        return h_req('GET', url.toString(), null, { ...hdrs, 'Content-Type': 'application/json' });
    }
    async post(pth, bdy) {
        const url = `${this.b_url}/${pth}`;
        const hdrs = await this.gen_auth_hdr();
        return h_req('POST', url, bdy, { ...hdrs, 'Content-Type': 'application/json' });
    }
    async put(pth, bdy) {
        const url = `${this.b_url}/${pth}`;
        const hdrs = await this.gen_auth_hdr();
        return h_req('PUT', url, bdy, { ...hdrs, 'Content-Type': 'application/json' });
    }
}

