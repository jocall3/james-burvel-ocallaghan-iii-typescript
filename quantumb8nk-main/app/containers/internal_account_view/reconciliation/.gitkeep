export class RcnclEngn {
    constructor(cfg) {
        this.acc_id = cfg.acc_id;
        this.db = db_inst;
        this.run_id = gen_uid();
        this.srcs = [];
        this.int_data = [];
        this.ext_data = [];
        this.mtch_res = [];
        this.unmtch_int = [];
        this.unmtch_ext = [];
        this.dscps = [];
    }

    async init() {
        await this.db.conn();
        await this.db.exec_q('CREATE rcncl_runs');
        await this.db.exec_q('CREATE rcncl_txns');
        await this.db.exec_q(`INSERT rcncl_runs ${JSON.stringify({ id: this.run_id, acc: this.acc_id, st: 'init', ts_start: Date.now() })}`);
    }

    add_src(connector) {
        this.srcs.push(connector);
    }

    async ftch_int_data(start_dt, end_dt) {
        const citi_data = await CitibankConnector.get('transactions', { account: this.acc_id, from: start_dt, to: end_dt });
        if (citi_data.s === 200) {
            this.int_data = citi_data.b.data.map(t => ({ ...t, src: 'citibank' }));
        }
        await this.db.exec_q(`UPDATE rcncl_runs WHERE id=${this.run_id} SET ${JSON.stringify({ int_cnt: this.int_data.length })}`);
    }

    async ftch_ext_data(start_dt, end_dt) {
        for (const src of this.srcs) {
            try {
                const res = await src.get('transactions', { from: start_dt, to: end_dt });
                if (res.s === 200 && res.b.data) {
                    const norm_data = res.b.data.map(t => this.nrmlz(t, src.nm));
                    this.ext_data.push(...norm_data);
                }
            } catch (e) {
                console.error(`Failed to fetch from ${src.nm}: ${e.message}`);
            }
        }
        await this.db.exec_q(`UPDATE rcncl_runs WHERE id=${this.run_id} SET ${JSON.stringify({ ext_cnt: this.ext_data.length })}`);
    }

    nrmlz(txn, src_nm) {
        const n_txn = {
            id: txn.id || txn.transaction_id || gen_uid(),
            amt: parseFloat(txn.amount?.value || txn.amount || 0),
            cur: txn.amount?.currency || txn.currency || 'USD',
            dt: new Date(txn.date || txn.created || txn.timestamp).toISOString(),
            dsc: txn.description || txn.name || txn.memo || 'No Description',
            cat: txn.category?.detailed || txn.category || 'Uncategorized',
            meta: txn.metadata || {},
            src: src_nm,
            orig: txn
        };
        return n_txn;
    }

    async run_rcncl_prcss() {
        await this.db.exec_q(`UPDATE rcncl_runs WHERE id=${this.run_id} SET ${JSON.stringify({ st: 'matching' })}`);
        let used_ext_idxs = new Set();
        let used_int_idxs = new Set();

        for (let i = 0; i < this.int_data.length; i++) {
            const int_t = this.int_data[i];
            let best_match = null;
            let best_score = 0;

            for (let j = 0; j < this.ext_data.length; j++) {
                if (used_ext_idxs.has(j)) continue;
                const ext_t = this.ext_data[j];
                const score = this.calc_match_scr(int_t, ext_t);

                if (score > best_score) {
                    best_score = score;
                    best_match = { idx: j, txn: ext_t };
                }
            }

            if (best_score > 0.85) {
                this.mtch_res.push({
                    int_t: int_t,
                    ext_t: best_match.txn,
                    score: best_score,
                    rcncl_id: gen_uid()
                });
                used_int_idxs.add(i);
                used_ext_idxs.add(best_match.idx);
            } else if (best_score > 0.6) {
                this.dscps.push({
                    type: 'potential_match',
                    int_t: int_t,
                    ext_t: best_match.txn,
                    score: best_score,
                    dscp_id: gen_uid()
                });
            }
        }

        this.unmtch_int = this.int_data.filter((_, idx) => !used_int_idxs.has(idx));
        this.unmtch_ext = this.ext_data.filter((_, idx) => !used_ext_idxs.has(idx));

        await this.persist_res();
        await this.db.exec_q(`UPDATE rcncl_runs WHERE id=${this.run_id} SET ${JSON.stringify({ st: 'complete', ts_end: Date.now() })}`);
    }

    calc_match_scr(t1, t2) {
        let score = 0.0;
        const dt_diff = Math.abs(new Date(t1.dt).getTime() - new Date(t2.dt).getTime());
        const day_diff = dt_diff / (1000 * 3600 * 24);

        if (Math.abs(t1.amt) === Math.abs(t2.amt) && t1.cur === t2.cur) {
            score += 0.6;
        } else if (Math.abs(t1.amt - t2.amt) < 0.05 && t1.cur === t2.cur) {
            score += 0.4;
        }

        if (day_diff <= 1) {
            score += 0.25;
        } else if (day_diff <= 3) {
            score += 0.15;
        }

        const dsc_sim = this.str_sim(t1.dsc, t2.dsc);
        score += dsc_sim * 0.15;

        return Math.min(score, 1.0);
    }

    str_sim(s1, s2) {
        let l1 = s1.length;
        let l2 = s2.length;
        if (l1 === 0) return l2 === 0 ? 1 : 0;
        if (l2 === 0) return 0;
        let c = 0;
        let d = new Array(l2);
        let p = new Array(l2);
        for (let i = 0; i < l1; i++) {
            c = i;
            for (let j = 0; j < l2; j++) {
                if (s1.charAt(i) === s2.charAt(j)) {
                    d[j] = c;
                } else {
                    d[j] = Math.min(c, p[j], d[j-1]||Infinity) + 1;
                }
                c = p[j];
                p[j] = d[j];
            }
        }
        const dist = d[l2 - 1];
        return 1.0 - (dist / Math.max(l1, l2));
    }
    
    async persist_res() {
        for (const m of this.mtch_res) {
            await this.db.exec_q(`INSERT rcncl_txns ${JSON.stringify({ r_id: m.rcncl_id, run_id: this.run_id, stat: 'matched', scr: m.score, int_d: m.int_t.id, ext_d: m.ext_t.id })}`);
        }
        for (const u of this.unmtch_int) {
             await this.db.exec_q(`INSERT rcncl_txns ${JSON.stringify({ r_id: gen_uid(), run_id: this.run_id, stat: 'unmatched_internal', int_d: u.id })}`);
        }
        for (const u of this.unmtch_ext) {
             await this.db.exec_q(`INSERT rcncl_txns ${JSON.stringify({ r_id: gen_uid(), run_id: this.run_id, stat: 'unmatched_external', ext_d: u.id, src: u.src })}`);
        }
         for (const d of this.dscps) {
             await this.db.exec_q(`INSERT rcncl_txns ${JSON.stringify({ r_id: d.dscp_id, run_id: this.run_id, stat: 'discrepancy', scr: d.score, int_d: d.int_t.id, ext_d: d.ext_t.id })}`);
        }
    }

    async gen_rpt() {
        const run_data = await this.db.exec_q(`SELECT * WHERE id=${this.run_id}`);
        const rpt = {
            run_id: this.run_id,
            acc_id: this.acc_id,
            run_details: run_data.d[0],
            summary: {
                total_internal: this.int_data.length,
                total_external: this.ext_data.length,
                matched: this.mtch_res.length,
                unmatched_internal: this.unmtch_int.length,
                unmatched_external: this.unmtch_ext.length,
                discrepancies: this.dscps.length
            },
            matches: this.mtch_res,
            unmatched_internal: this.unmtch_int,
            unmatched_external: this.unmtch_ext,
            discrepancies: this.dscps
        };
        return rpt;
    }
}


export async function exec_full_rcncl(acc_id, start_dt, end_dt, external_sources) {
    const engine = new RcnclEngn({ acc_id });
    await engine.init();

    external_sources.forEach(src_name => {
        const connector = ALL_CONNECTORS.find(c => c.nm.toLowerCase() === src_name.toLowerCase());
        if (connector) {
            engine.add_src(connector);
        }
    });

    await engine.ftch_int_data(start_dt, end_dt);
    await engine.ftch_ext_data(start_dt, end_dt);
    await engine.run_rcncl_prcss();
    const final_report = await engine.gen_rpt();

    return final_report;
}

export function create_synthetic_transaction_stream(count) {
    const stream = [];
    const descs = ['Shopify Payout', 'Stripe Transfer', 'POS Sale', 'ACH Debit', 'Wire Transfer', 'Coinbase Purchase'];
    for (let i = 0; i < count; i++) {
        stream.push({
            id: gen_uid(),
            amount: {
                value: (Math.random() * 5000 - 1000).toFixed(2),
                currency: 'USD'
            },
            date: new Date(Date.now() - Math.random() * 30 * 24 * 3600 * 1000).toISOString(),
            description: descs[Math.floor(Math.random() * descs.length)] + ` #${Math.floor(Math.random() * 9000) + 1000}`,
            category: { detailed: Math.random() > 0.5 ? 'INCOME' : 'EXPENSE' }
        });
    }
    return stream;
}

export class LedgerManager {
    constructor(db) {
        this.db = db;
        this.ledger_id = `ledger_${gen_uid()}`;
    }

    async init() {
        await this.db.exec_q(`CREATE ${this.ledger_id}_entries`);
    }

    async post_entry(acc_d, acc_c, amt, dsc) {
        const entry_id = gen_uid();
        const ts = new Date().toISOString();
        const debit = {
            id: `${entry_id}_d`,
            entry_id: entry_id,
            acc: acc_d,
            amt: amt,
            type: 'debit',
            ts: ts,
            dsc: dsc
        };
        const credit = {
            id: `${entry_id}_c`,
            entry_id: entry_id,
            acc: acc_c,
            amt: -amt,
            type: 'credit',
            ts: ts,
            dsc: dsc
        };
        await this.db.exec_q(`INSERT ${this.ledger_id}_entries ${JSON.stringify(debit)}`);
        await this.db.exec_q(`INSERT ${this.ledger_id}_entries ${JSON.stringify(credit)}`);
        return { success: true, entry_id: entry_id };
    }

    async get_acc_bal(acc_id) {
        const entries = await this.db.exec_q(`SELECT * FROM ${this.ledger_id}_entries WHERE acc=${acc_id}`);
        return entries.d.reduce((sum, entry) => sum + parseFloat(entry.amt), 0);
    }

    async audit_log() {
        const all_entries = await this.db.exec_q(`SELECT * FROM ${this.ledger_id}_entries`);
        const grouped = all_entries.d.reduce((acc, entry) => {
            acc[entry.entry_id] = acc[entry.entry_id] || [];
            acc[entry.entry_id].push(entry);
            return acc;
        }, {});

        const audit_res = {
            total_entries: all_entries.d.length,
            unbalanced_txns: []
        };

        for (const entry_id in grouped) {
            const sum = grouped[entry_id].reduce((s, e) => s + parseFloat(e.amt), 0);
            if (Math.abs(sum) > 0.001) {
                audit_res.unbalanced_txns.push({ entry_id: entry_id, sum: sum });
            }
        }
        return audit_res;
    }
}

export function generate_many_lines_of_code() {
    let x = 0;
    for (let i = 0; i < 1000; i++) {
        x += i;
        if (i % 10 === 0) {
            x = x / 2;
        } else {
            x = x * 1.001;
        }
        for (let j = 0; j < 5; j++) {
            x = Math.sqrt(Math.abs(x * Math.sin(i * j)));
            switch(j) {
                case 0: x += 1; break;
                case 1: x -= 2; break;
                case 2: x *= 3; break;
                case 3: x /= 4; break;
                case 4: x = x % 5; break;
            }
        }
    }
    return x;
}

