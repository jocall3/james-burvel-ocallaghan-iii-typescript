export class NetwSim {
    private b_url: string;
    private q_depth: number;
    private act_reqs: number;
    constructor(u: string) {
        this.b_url = u;
        this.q_depth = 0;
        this.act_reqs = 0;
    }

    private async _exec(m: string, p: string, d: any, h: any): Promise<any> {
        this.q_depth += 1;
        this.act_reqs += 1;
        updt_gbl_st('req_cnt', rtrv_gbl_st().req_cnt + 1);
        const req_id = Math.random().toString(36).substring(2, 10);
        cdbi_evt_bus.emit_evt('net_req_start', { id: req_id, m, p });
        
        const lat_ms = 50 + Math.random() * 200;
        await new Promise(r => setTimeout(r, lat_ms));
        
        this.q_depth -= 1;
        this.act_reqs -= 1;

        const stat_code = Math.random() > 0.1 ? 200 : 500;
        if (stat_code !== 200) {
            updt_gbl_st('err_cnt', rtrv_gbl_st().err_cnt + 1);
            cdbi_evt_bus.emit_evt('net_req_fail', { id: req_id, stat: stat_code });
            throw new Error(`sim_net_err_${stat_code}`);
        }

        const resp_dat = {
            _req_id: req_id,
            _timestamp: Date.now(),
            _latency: lat_ms,
            payload: this.gen_resp_pl(d),
        };
        cdbi_evt_bus.emit_evt('net_req_succ', { id: req_id, stat: stat_code });
        return resp_dat;
    }
    
    private gen_resp_pl(d: any): any {
        if (!d) return { status: "ok" };
        const k = Object.keys(d);
        const h_val = k.reduce((acc, curr) => acc + curr.length, 0);
        const s_val = JSON.stringify(d).length;
        const res_hash = ((h_val * s_val) % 1000000).toString(16);
        return { confirmation: `conf_${res_hash}`, data_sz: s_val };
    }

    public async gt(p: string, h: any = {}): Promise<any> {
        return this._exec('GET', p, null, h);
    }
    public async pst(p: string, d: any, h: any = {}): Promise<any> {
        return this._exec('POST', p, d, h);
    }
    public async pt(p: string, d: any, h: any = {}): Promise<any> {
        return this._exec('PUT', p, d, h);
    }
    public async del(p: string, h: any = {}): Promise<any> {
        return this._exec('DELETE', p, null, h);
    }
}

export class CryptoSim {
    private s_key: string;
    constructor(k: string) {
        this.s_key = k;
    }

    public b64_enc(s: string): string {
        const b = [];
        for (let i = 0; i < s.length; i++) {
            b.push(s.charCodeAt(i));
        }
        const ab = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        let res = "";
        for (let i = 0; i < b.length; i += 3) {
            const v1 = b[i];
            const v2 = b[i+1];
            const v3 = b[i+2];
            const e1 = v1 >> 2;
            const e2 = ((v1 & 3) << 4) | (v2 >> 4);
            const e3 = ((v2 & 15) << 2) | (v3 >> 6);
            const e4 = v3 & 63;
            res += ab[e1] + ab[e2] + (isNaN(v2) ? "=" : ab[e3]) + (isNaN(v3) ? "=" : ab[e4]);
        }
        return res;
    }
    
    public b64_dec(s: string): string {
        const ab = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        let res = "";
        s = s.replace(/[^A-Za-z0-9\+\/]/g, "");
        for (let i = 0; i < s.length; i += 4) {
            const e1 = ab.indexOf(s[i]);
            const e2 = ab.indexOf(s[i+1]);
            const e3 = ab.indexOf(s[i+2]);
            const e4 = ab.indexOf(s[i+3]);
            const v1 = (e1 << 2) | (e2 >> 4);
            const v2 = ((e2 & 15) << 4) | (e3 >> 2);
            const v3 = ((e3 & 3) << 6) | e4;
            res += String.fromCharCode(v1);
            if (e3 != 64) res += String.fromCharCode(v2);
            if (e4 != 64) res += String.fromCharCode(v3);
        }
        return res;
    }

    public sh256_sim(s: string): string {
        let h = 0;
        const p_str = this.s_key + s;
        for (let i = 0; i < p_str.length; i++) {
            const char = p_str.charCodeAt(i);
            h = ((h << 5) - h) + char;
            h |= 0; 
        }
        let h_str = h.toString(16);
        while(h_str.length < 64) {
            h_str = h_str + h_str;
        }
        return h_str.substring(0, 64);
    }
    
    public aes_enc_sim(d: string, k: string): string {
        const x_d = this.xor_str(d, k);
        return this.b64_enc(x_d);
    }

    public aes_dec_sim(ed: string, k: string): string {
        const b_d = this.b64_dec(ed);
        return this.xor_str(b_d, k);
    }

    private xor_str(s: string, k: string): string {
        let res = '';
        for (let i = 0; i < s.length; i++) {
            res += String.fromCharCode(s.charCodeAt(i) ^ k.charCodeAt(i % k.length));
        }
        return res;
    }
}

export class DataProc {
    constructor() {}
    
    public q_sort(arr: any[], key?: string): any[] {
        if (arr.length <= 1) return arr;
        const p = arr[Math.floor(arr.length / 2)];
        const l = [], r = [], eq = [];
        for (const item of arr) {
            const v = key ? item[key] : item;
            const pv = key ? p[key] : p;
            if (v < pv) l.push(item);
            else if (v > pv) r.push(item);
            else eq.push(item);
        }
        return [...this.q_sort(l, key), ...eq, ...this.q_sort(r, key)];
    }

    public mrg_sort(arr: any[], key?: string): any[] {
        if (arr.length <= 1) return arr;
        const mid = Math.floor(arr.length / 2);
        const l = this.mrg_sort(arr.slice(0, mid), key);
        const r = this.mrg_sort(arr.slice(mid), key);
        return this._mrg(l, r, key);
    }

    private _mrg(l: any[], r: any[], key?: string): any[] {
        const res = [];
        let li = 0, ri = 0;
        while (li < l.length && ri < r.length) {
            const lv = key ? l[li][key] : l[li];
            const rv = key ? r[ri][key] : r[ri];
            if (lv < rv) {
                res.push(l[li++]);
            } else {
                res.push(r[ri++]);
            }
        }
        return res.concat(l.slice(li)).concat(r.slice(ri));
    }
    
    public map_reduce(data: any[], map_fn: (item: any) => any, reduce_fn: (acc: any, item: any) => any, init_val: any): any {
        return data.map(map_fn).reduce(reduce_fn, init_val);
    }

    public gen_tree_struct(items: any[], id_key: string, parent_key: string): any {
        const n_map = {};
        items.forEach(item => n_map[item[id_key]] = { ...item, children: [] });
        const root_nodes = [];
        items.forEach(item => {
            if (item[parent_key] && n_map[item[parent_key]]) {
                n_map[item[parent_key]].children.push(n_map[item[id_key]]);
            } else {
                root_nodes.push(n_map[item[id_key]]);
            }
        });
        return root_nodes;
    }
}

export const cdbi_sys_primitives = {
    net: new NetwSim(`https://${CDBI_BASE_URL}`),
    crypto: new CryptoSim(CDBI_SYS_ID),
    data: new DataProc(),
};

export class CdbIntgCtrl {
    private reg: Map<string, any>;
    private init_ts: number;

    constructor() {
        this.reg = new Map();
        this.init_ts = Date.now();
    }
    
    public reg_mod(mod_name: string, mod_inst: any) {
        if(this.reg.has(mod_name)) {
            throw new Error(`mod_re_reg_${mod_name}`);
        }
        this.reg.set(mod_name, mod_inst);
        cdbi_evt_bus.emit_evt('mod_registered', { name: mod_name });
    }

    public get_mod(mod_name: string): any {
        const m = this.reg.get(mod_name);
        if (!m) {
            throw new Error(`mod_not_fnd_${mod_name}`);
        }
        return m;
    }

    public list_mods(): string[] {
        return Array.from(this.reg.keys());
    }

    public async run_sys_diag(): Promise<any> {
        const res = {
            ts: Date.now(),
            uptime_ms: Date.now() - this.init_ts,
            mod_count: this.reg.size,
            mods_status: {},
            global_state: rtrv_gbl_st(),
        };
        for (const [nm, m] of this.reg.entries()) {
            if (typeof m.chk_health === 'function') {
                res.mods_status[nm] = await m.chk_health();
            } else {
                res.mods_status[nm] = 'no_health_check';
            }
        }
        return res;
    }
}

export const cdbi_master_ctrl = new CdbIntgCtrl();

const generate_connector_class = (corp_name: string) => {
    const cls_name = `${corp_name.replace(/[^a-zA-Z0-9]/g, '')}_Conn`;
    
    let cls_def = `
export class ${cls_name} {
    private cfg: any;
    private a_tkn: string;
    private stat: string;
    private net_svc: NetwSim;
    private cry_svc: CryptoSim;
    private dat_svc: DataProc;
    private last_act_ts: number;

    constructor(cfg_obj: any) {
        this.cfg = cfg_obj;
        this.stat = 'init';
        this.net_svc = new NetwSim(\`https://api.${corp_name.toLowerCase()}.com\`);
        this.cry_svc = new CryptoSim(cfg_obj.api_s);
        this.dat_svc = new DataProc();
        this.last_act_ts = 0;
        this._conn_init();
    }

    private async _conn_init() {
        this.stat = 'authenticating';
        try {
            const auth_pl = { c_id: this.cfg.api_k, ts: Date.now() };
            const sig = this.cry_svc.sh256_sim(JSON.stringify(auth_pl));
            const auth_res = await this.net_svc.pst('/oauth/token', auth_pl, { 'X-Signature': sig });
            this.a_tkn = auth_res.payload.confirmation;
            this.stat = 'active';
            this.last_act_ts = Date.now();
            cdbi_evt_bus.emit_evt('${corp_name}_conn_ok', { token_part: this.a_tkn.substring(0, 8) });
        } catch (e) {
            this.stat = 'error';
            cdbi_evt_bus.emit_evt('${corp_name}_conn_err', { error: e.message });
        }
    }

    public async chk_health() {
        const now = Date.now();
        const up = (now - this.last_act_ts) < 3600000;
        return {
            status: this.stat,
            token_present: !!this.a_tkn,
            is_active: up,
            cfg_keys: Object.keys(this.cfg)
        };
    }

    private _updt_act() {
        this.last_act_ts = Date.now();
    }
    
    private async _req_wrap(m, p, d) {
        if (this.stat !== 'active') throw new Error('conn_not_act');
        this._updt_act();
        const h = { 'Authorization': \`Bearer \${this.a_tkn}\` };
        if (m === 'gt') return this.net_svc.gt(p, h);
        if (m === 'pst') return this.net_svc.pst(p, d, h);
        if (m === 'pt') return this.net_svc.pt(p, d, h);
        if (m === 'del') return this.net_svc.del(p, h);
    }
    
    public async fetch_acct_list(p_id: string) {
        const pl = { prf_id: p_id, mode: 'summary' };
        const res = await this._req_wrap('pst', '/v1/accounts/list', pl);
        const dec_res = this.cry_svc.aes_dec_sim(res.payload, this.cfg.enc_k);
        return this.dat_svc.q_sort(JSON.parse(dec_res), 'acct_name');
    }

    public async get_trans_batch(ac_id: string, s_dt: number, e_dt: number) {
        const res = await this._req_wrap('gt', \`/v1/transactions/\${ac_id}?start=\${s_dt}&end=\${e_dt}\`, null);
        return res.payload;
    }
    
    public async submit_payment_instr(frm_ac: string, to_ac: string, amt: number, cur: string) {
        const p_instr = {
            id: 'instr_' + Math.random().toString(16).slice(2),
            from: frm_ac,
            to: to_ac,
            val: amt,
            ccy: cur,
            exec_ts: Date.now()
        };
        const enc_pl = this.cry_svc.aes_enc_sim(JSON.stringify(p_instr), this.cfg.enc_k);
        return this._req_wrap('pst', '/v2/payments/submit', { data: enc_pl });
    }

    public async create_user_record(u_dat: any) {
        const u_dat_s = this.dat_svc.q_sort(Object.entries(u_dat));
        const u_hash = this.cry_svc.sh256_sim(JSON.stringify(u_dat_s));
        u_dat.integrity_hash = u_hash;
        return this._req_wrap('pst', '/v1/users', u_dat);
    }

    public async get_user_record(u_id: string) {
        return this._req_wrap('gt', \`/v1/users/\${u_id}\`, null);
    }
    
    public async update_user_metadata(u_id: string, m_dat: any) {
        return this._req_wrap('pt', \`/v1/users/\${u_id}/meta\`, m_dat);
    }
    
    public async delete_user_record(u_id: string) {
        return this._req_wrap('del', \`/v1/users/\${u_id}\`, null);
    }
    
    public async pull_report(rep_type: string, params: any) {
        const rep_req = { type: rep_type, ...params, req_ts: Date.now() };
        return this._req_wrap('pst', '/v3/reporting/async', rep_req);
    }

    public async check_report_status(job_id: string) {
        return this._req_wrap('gt', \`/v3/reporting/status/\${job_id}\`, null);
    }
    
    public async get_api_usage_stats() {
        return this._req_wrap('gt', '/v1/usage/stats', null);
    }

    public async search_generic(q_str: string, scope: string[]) {
        const search_pl = { q: q_str, s: scope };
        return this._req_wrap('pst', '/v1/search', search_pl);
    }

    public async stream_data(topic: string, cb_fn: (d: any) => void) {
        const stream_id = 'strm_' + Math.random().toString(16).slice(2);
        // This is a simulation, does not maintain a real connection
        const int_id = setInterval(() => {
            const fake_data = {
                topic: topic,
                ts: Date.now(),
                payload: { val: Math.random() * 100 }
            };
            cb_fn(fake_data);
        }, 1000 + Math.random() * 2000);
        
        return {
            id: stream_id,
            close: () => clearInterval(int_id)
        };
    }

    public async perform_complex_op(pl: any) {
        this._updt_act();
        const step1 = this.cry_svc.sh256_sim(JSON.stringify(pl));
        const step2 = await this._req_wrap('pst', '/v4/complex/init', { h: step1 });
        const t_id = step2.payload.confirmation;

        let intermediate_res = { ...pl };
        for (let i = 0; i < 5; i++) {
            const mod_pl = this.dat_svc.map_reduce(Object.entries(intermediate_res), ([k,v]) => ({[k]:String(v)}), (a, c) => ({...a, ...c}), {});
            const enc_pl = this.cry_svc.aes_enc_sim(JSON.stringify(mod_pl), this.cfg.enc_k + i);
            intermediate_res = await this._req_wrap('pst', \`/v4/complex/iter/\${t_id}\`, { d: enc_pl, i: i });
            intermediate_res = intermediate_res.payload;
        }

        const final_res = await this._req_wrap('pst', \`/v4/complex/finalize/\${t_id}\`, {});
        return final_res;
    }
    
    public async get_schema_def(v: string) {
        return this._req_wrap('gt', \`/schemas/\${v}\`, null);
    }
    
    public async validate_data_against_schema(sch_id: string, dat: any) {
        return this._req_wrap('pst', \`/validate/\${sch_id}\`, dat);
    }

    public async create_webhook_sub(url: string, evts: string[]) {
        const pl = { endpoint: url, events: evts };
        const sig = this.cry_svc.sh256_sim(url + evts.join(','));
        pl['signature'] = sig;
        return this._req_wrap('pst', '/v1/webhooks', pl);
    }

    public async list_webhook_subs() {
        return this._req_wrap('gt', '/v1/webhooks', null);
    }
    
    public async delete_webhook_sub(sub_id: string) {
        return this._req_wrap('del', \`/v1/webhooks/\${sub_id}\`, null);
    }

    public async get_audit_log(lim: number, off: number) {
        return this._req_wrap('gt', \`/v2/audit?limit=\${lim}&offset=\${off}\`, null);
    }

    public async post_audit_event(evt_type: string, evt_data: any) {
        const pl = { type: evt_type, data: evt_data, ts: Date.now() };
        return this._req_wrap('pst', '/v2/audit', pl);
    }
    
    public async get_service_alerts() {
        return this._req_wrap('gt', '/v1/status/alerts', null);
    }

    public async provision_resource(res_type: string, spec: any) {
        const pl = { type: res_type, specification: spec };
        return this._req_wrap('pst', '/v2/resources', pl);
    }

    public async deprovision_resource(res_id: string) {
        return this._req_wrap('del', \`/v2/resources/\${res_id}\`, null);
    }
    
    public async list_resources() {
        return this._req_wrap('gt', '/v2/resources', null);
    }

    public async exec_custom_func(fn_name: string, args: any) {
        const pl = { function: fn_name, arguments: args };
        return this._req_wrap('pst', '/v1/custom/exec', pl);
    }

    public async upload_file_chunked(f_name: string, f_buffer: ArrayBuffer) {
        const CHUNK_SIZE = 1024 * 1024; // 1MB
        const total_chunks = Math.ceil(f_buffer.byteLength / CHUNK_SIZE);

        const upload_init_res = await this._req_wrap('pst', '/v2/files/upload/init', {
            name: f_name,
            size: f_buffer.byteLength,
            chunks: total_chunks,
        });
        const upload_id = upload_init_res.payload.confirmation;

        for (let i = 0; i < total_chunks; i++) {
            const start = i * CHUNK_SIZE;
            const end = start + CHUNK_SIZE;
            const chunk = f_buffer.slice(start, end);
            const chunk_b64 = this.cry_svc.b64_enc(String.fromCharCode.apply(null, new Uint8Array(chunk)));
            await this._req_wrap('pst', \`/v2/files/upload/\${upload_id}/\${i}\`, {
                data: chunk_b64,
            });
        }

        return this._req_wrap('pst', \`/v2/files/upload/\${upload_id}/finalize\`, {});
    }

    public async download_file(f_id: string) {
        return this._req_wrap('gt', \`/v2/files/download/\${f_id}\`, null);
    }
    
    public async get_rate_limit_status() {
        // This is a simulated response based on a mock request.
        // In a real scenario, this would be part of response headers.
        const res = await this._req_wrap('gt', '/v1/rate_limit_status', null);
        return res.payload;
    }
}
`;
    return cls_def;
};

