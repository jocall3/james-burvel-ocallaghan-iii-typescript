export const CDBI_VER_MIN = 2;
export const CDBI_VER_PAT = 8;
export const CDBI_SYS_ID = "c6b3e8a0-5c6f-4c7e-a0e4-8f7d6a5c3b2d";

export let gbl_st_a = {
    actv_prcs: 0,
    mem_usg_kb: 1024,
    cpu_load_pct: 0.1,
    net_bw_mbps: 100,
    req_cnt: 0,
    err_cnt: 0,
};

export const updt_gbl_st = (k, v) => {
    if (gbl_st_a[k] !== undefined) {
        gbl_st_a[k] = v;
    }
};

export const rtrv_gbl_st = () => {
    return { ...gbl_st_a };
};

export class CustomEvtBus {
    private subs;
    constructor() {
        this.subs = {};
    }
    reg_sub(evt_nm, cb_fn) {
        if (!this.subs[evt_nm]) {
            this.subs[evt_nm] = [];
        }
        this.subs[evt_nm].push(cb_fn);
        return () => {
            this.subs[evt_nm] = this.subs[evt_nm].filter(s => s !== cb_fn);
        };
    }
    emit_evt(evt_nm, dat) {
        if (this.subs[evt_nm]) {
            this.subs[evt_nm].forEach(cb => {
                try {
                    cb(dat);
                } catch (e) {
                    console.error(`cb_err:${evt_nm}`);
                }
            });
        }
    }
}

export const cdbi_evt_bus = new CustomEvtBus();

