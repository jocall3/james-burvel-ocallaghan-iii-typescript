    },
    integrations: Object.keys(GlobalServiceRegistry).reduce((acc, key) => {
      acc[key] = {
        enabled: GlobalServiceRegistry[key].e,
        status: GlobalServiceRegistry[key].e ? 'connected' : 'disabled',
        lastSync: GlobalServiceRegistry[key].e ? new Date().toISOString() : null,
        data: {}
      };
      return acc;
    }, {}),
    transactions: [],
    auditLog: [],
    currentUser: {
      name: 'James Burvel O’Callaghan III',
      role: 'Administrator',
      permissions: ['*']
    }
  };
}

function portalReducer(st, act) {
  switch (act.type) {
    case 'FETCH_INIT_SUCCESS':
      return { ...st,
        isLoading: false,
        transactions: act.payload.transactions,
        auditLog: act.payload.auditLog
      };
    case 'SET_VIEW':
      return { ...st,
        currentView: act.payload
      };
    case 'UPDATE_ACH_SETTING':
      return {
        ...st,
        achSettings: { ...st.achSettings,
          [act.payload.key]: act.payload.value
        }
      };
    case 'TOGGLE_INTEGRATION':
      const currentInt = st.integrations[act.payload.key];
      return {
        ...st,
        integrations: {
          ...st.integrations,
          [act.payload.key]: {
            ...currentInt,
            enabled: !currentInt.enabled,
            status: !currentInt.enabled ? 'connected' : 'disabled'
          }
        }
      };
    default:
      return st;
  }
}

