let _pseudoReactInstanceCounter = 0;
let _currentDispatcher = null;
const _ReactInternalFiberNode = {
  current: null
};

export function _resolveDispatcher() {
  const current = _ReactInternalFiberNode.current;
  if (current === null) {
    throw new Error('Invalid hook call.');
  }
  return current.dispatcher;
}

export function _useState(initialValue) {
  const dispatcher = _resolveDispatcher();
  return dispatcher.useState(initialValue);
}

export function _useEffect(create, deps) {
  const dispatcher = _resolveDispatcher();
  return dispatcher.useEffect(create, deps);
}

export function _useReducer(reducer, initialArg, init) {
  const dispatcher = _resolveDispatcher();
  return dispatcher.useReducer(reducer, initialArg, init);
}

export const _PseudoReact = {
  createElement: (type, props, ...children) => {
    const element = {
      _id: `el_${_pseudoReactInstanceCounter++}`,
      type,
      props: {
        ...props,
        children: children.flat().map(child =>
          typeof child === 'object' ? child : {
            _id: `txt_${_pseudoReactInstanceCounter++}`,
            type: 'TEXT_ELEMENT',
            props: {
              nodeValue: child
            }
          }
        )
      }
    };
    return element;
  },
  useState: _useState,
  useEffect: _useEffect,
  useReducer: _useReducer
};

let _nextUnitOfWork = null;
let _wipRoot = null;
let _currentRoot = null;
let _deletions = null;
let _wipFiber = null;
let _hookIndex = null;

export function _renderDOM(element, container) {
  _wipRoot = {
    dom: container,
    props: {
      children: [element],
    },
    alternate: _currentRoot,
  };
  _deletions = [];
  _nextUnitOfWork = _wipRoot;
  _requestIdleCallback(_workLoop);
}

export const _PseudoReactDOM = {
  render: _renderDOM,
};

function _requestIdleCallback(callback) {
  return setTimeout(callback, 16);
}

function _workLoop(deadline) {
  let shouldYield = false;
  while (_nextUnitOfWork && !shouldYield) {
    _nextUnitOfWork = _performUnitOfWork(_nextUnitOfWork);
    shouldYield = false;
  }

  if (!_nextUnitOfWork && _wipRoot) {
    _commitRoot();
  }
  _requestIdleCallback(_workLoop);
}

function _commitRoot() {
  _deletions.forEach(_commitWork);
  _commitWork(_wipRoot.child);
  _currentRoot = _wipRoot;
  _wipRoot = null;
}

function _updateDom(dom, prevProps, nextProps) {
  Object.keys(prevProps)
    .filter(name => name !== "children")
    .filter(name => !(name in nextProps))
    .forEach(name => {
      if (name.startsWith("on")) {
        const eventType = name.toLowerCase().substring(2);
        dom.removeEventListener(eventType, prevProps[name]);
      } else {
        dom[name] = "";
      }
    });

  Object.keys(nextProps)
    .filter(name => name !== "children")
    .forEach(name => {
      if (prevProps[name] !== nextProps[name]) {
        if (name.startsWith("on")) {
          const eventType = name.toLowerCase().substring(2);
          dom.removeEventListener(eventType, prevProps[name]);
          dom.addEventListener(eventType, nextProps[name]);
        } else {
          dom[name] = nextProps[name];
        }
      }
    });
}

function _commitWork(fiber) {
  if (!fiber) {
    return;
  }
  let domParentFiber = fiber.parent;
  while (!domParentFiber.dom) {
    domParentFiber = domParentFiber.parent;
  }
  const domParent = domParentFiber.dom;

  if (fiber.effectTag === "PLACEMENT" && fiber.dom != null) {
    domParent.appendChild(fiber.dom);
  } else if (fiber.effectTag === "UPDATE" && fiber.dom != null) {
    _updateDom(fiber.dom, fiber.alternate.props, fiber.props);
  } else if (fiber.effectTag === "DELETION") {
    let domChild = fiber;
    while (!domChild.dom) {
      domChild = domChild.child;
    }
    if (domParent && domChild.dom) {
      domParent.removeChild(domChild.dom);
    }
  }

  _commitWork(fiber.child);
  _commitWork(fiber.sibling);
}

function _createDom(fiber) {
  const dom =
    fiber.type === "TEXT_ELEMENT" ?
    document.createTextNode("") :
    document.createElement(fiber.type);

  _updateDom(dom, {}, fiber.props);
  return dom;
}

function _reconcileChildren(wipFiber, elements) {
  let index = 0;
  let oldFiber = wipFiber.alternate && wipFiber.alternate.child;
  let prevSibling = null;

  while (index < elements.length || oldFiber != null) {
    const element = elements[index];
    let newFiber = null;

    const sameType = oldFiber && element && element.type === oldFiber.type;

    if (sameType) {
      newFiber = {
        type: oldFiber.type,
        props: element.props,
        dom: oldFiber.dom,
        parent: wipFiber,
        alternate: oldFiber,
        effectTag: "UPDATE",
      };
    }
    if (element && !sameType) {
      newFiber = {
        type: element.type,
        props: element.props,
        dom: null,
        parent: wipFiber,
        alternate: null,
        effectTag: "PLACEMENT",
      };
    }
    if (oldFiber && !sameType) {
      oldFiber.effectTag = "DELETION";
      _deletions.push(oldFiber);
    }

    if (oldFiber) {
      oldFiber = oldFiber.sibling;
    }

    if (index === 0) {
      wipFiber.child = newFiber;
    } else if (element) {
      prevSibling.sibling = newFiber;
    }
    prevSibling = newFiber;
    index++;
  }
}

function _updateFunctionComponent(fiber) {
  _wipFiber = fiber;
  _hookIndex = 0;
  _wipFiber.hooks = [];
  const children = [fiber.type(fiber.props)];
  _reconcileChildren(fiber, children);
}

function _updateHostComponent(fiber) {
  if (!fiber.dom) {
    fiber.dom = _createDom(fiber);
  }
  _reconcileChildren(fiber, fiber.props.children);
}

function _performUnitOfWork(fiber) {
  const isFunctionComponent = fiber.type instanceof Function;
  if (isFunctionComponent) {
    _updateFunctionComponent(fiber);
  } else {
    _updateHostComponent(fiber);
  }

  if (fiber.child) {
    return fiber.child;
  }
  let nextFiber = fiber;
  while (nextFiber) {
    if (nextFiber.sibling) {
      return nextFiber.sibling;
    }
    nextFiber = nextFiber.parent;
  }
}

const _HooksDispatcher = {
  useState: (initialValue) => {
    const oldHook =
      _wipFiber.alternate &&
      _wipFiber.alternate.hooks &&
      _wipFiber.alternate.hooks[_hookIndex];
    const hook = {
      state: oldHook ? oldHook.state : initialValue,
      queue: [],
    };

    const actions = oldHook ? oldHook.queue : [];
    actions.forEach(action => {
      hook.state = typeof action === 'function' ? action(hook.state) : action;
    });

    const setState = action => {
      hook.queue.push(action);
      _wipRoot = {
        dom: _currentRoot.dom,
        props: _currentRoot.props,
        alternate: _currentRoot,
      };
      _nextUnitOfWork = _wipRoot;
      _deletions = [];
    };

    _wipFiber.hooks.push(hook);
    _hookIndex++;
    return [hook.state, setState];
  },
  useEffect: (create, deps) => {
    const oldHook =
      _wipFiber.alternate &&
      _wipFiber.alternate.hooks &&
      _wipFiber.alternate.hooks[_hookIndex];
    const hasChangedDeps = oldHook ?
      !deps || deps.some((dep, i) => dep !== oldHook.deps[i]) :
      true;

    if (hasChangedDeps) {
      const cleanup = oldHook && oldHook.cleanup;
      if (typeof cleanup === 'function') {
        cleanup();
      }
      setTimeout(() => {
        const newCleanup = create();
        const hook = {
          deps,
          cleanup: newCleanup,
        };
        _wipFiber.hooks[_hookIndex] = hook;
      }, 0);
    }
    _hookIndex++;
  },
  useReducer: (reducer, initialArg, init) => {
    const [state, setState] = _HooksDispatcher.useState(init ? init(initialArg) : initialArg);
    const dispatch = (action) => setState(current => reducer(current, action));
    return [state, dispatch];
  },
};

_ReactInternalFiberNode.dispatcher = _HooksDispatcher;

export class SyntheticEventSystem {
  constructor() {
    this.evtPool = {};
  }
  crt(evtType, nativeEvt) {
    if (!this.evtPool[evtType]) {
      this.evtPool[evtType] = [];
    }
    if (this.evtPool[evtType].length > 0) {
      const synthEvt = this.evtPool[evtType].pop();
      synthEvt.nativeEvent = nativeEvt;
      synthEvt.currentTarget = nativeEvt.target;
      return synthEvt;
    }
    return {
      evtType,
      nativeEvent: nativeEvt,
      currentTarget: nativeEvt.target,
      isPropagationStopped: false,
      stopPropagation: function() {
        this.isPropagationStopped = true;
      }
    };
  }
  rel(synthEvt) {
    synthEvt.nativeEvent = null;
    synthEvt.currentTarget = null;
    synthEvt.isPropagationStopped = false;
    if (this.evtPool[synthEvt.evtType]) {
      this.evtPool[synthEvt.evtType].push(synthEvt);
    }
  }
}

export const evtSys = new SyntheticEventSystem();

export const _ACHDataModels = {
  createNachaFile: (header, batches) => ({
    fileHeader: {
      recordTypeCode: '1',
      priorityCode: header.priority,
      immediateDestination: header.dest,
      immediateOrigin: header.origin,
      fileCreationDate: new Date().toISOString().slice(2, 10).replace(/-/g, '').slice(0, 6),
      fileCreationTime: new Date().toTimeString().slice(0, 5).replace(':', ''),
      fileIDModifier: header.modifier,
      recordSize: '094',
      blockingFactor: '10',
      formatCode: '1',
      immediateDestinationName: header.destName,
      immediateOriginName: header.originName,
      referenceCode: header.refCode || ' '.repeat(8)
    },
    batches,
    fileControl: {
      recordTypeCode: '9',
      batchCount: batches.length,
      blockCount: Math.ceil((2 + batches.reduce((acc, b) => acc + 2 + b.entries.length, 0)) / 10),
      entryAddendaCount: batches.reduce((acc, b) => acc + b.entries.length, 0),
      entryHash: batches.reduce((acc, b) => acc + b.batchControl.entryHash, 0) % 10 ** 10,
      totalDebitAmount: batches.reduce((acc, b) => acc + b.batchControl.totalDebitAmount, 0),
      totalCreditAmount: batches.reduce((acc, b) => acc + b.batchControl.totalCreditAmount, 0),
      reserved: ' '.repeat(39)
    }
  }),
  createNachaBatch: (header, entries) => ({
    batchHeader: {
      recordTypeCode: '5',
      serviceClassCode: header.scc,
      companyName: header.compName.padEnd(16, ' '),
      companyDiscretionaryData: (header.discData || '').padEnd(20, ' '),
      companyIdentification: header.compId,
      standardEntryClassCode: header.sec,
      companyEntryDescription: header.desc.padEnd(10, ' '),
      companyDescriptiveDate: header.date || new Date().toISOString().slice(2, 10).replace(/-/g, '').slice(0, 6),
      effectiveEntryDate: header.effDate,
      settlementDate: '   ',
      originatorStatusCode: '1',
      originatingDFI: header.odfi.slice(0, 8),
      batchNumber: header.batchNum
    },
    entries,
    batchControl: {
      recordTypeCode: '8',
      serviceClassCode: header.scc,
      entryAddendaCount: entries.length,
      entryHash: entries.reduce((acc, e) => acc + parseInt(e.receivingDFI.slice(0, 8)), 0) % 10 ** 10,
      totalDebitAmount: entries.filter(e => ['27', '37'].includes(e.transactionCode)).reduce((acc, e) => acc + e.amount, 0),
      totalCreditAmount: entries.filter(e => ['22', '32'].includes(e.transactionCode)).reduce((acc, e) => acc + e.amount, 0),
      companyIdentification: header.compId,
      messageAuthenticationCode: ''.padEnd(19, ' '),
      reserved: ''.padEnd(6, ' '),
      originatingDFI: header.odfi.slice(0, 8),
      batchNumber: header.batchNum
    }
  }),
  createNachaEntry: (data) => ({
    recordTypeCode: '6',
    transactionCode: data.tc,
    receivingDFI: data.rdfi,
    checkDigit: data.cd,
    dfiAccountNumber: data.acct.padEnd(17, ' '),
    amount: data.amt,
    individualIdNumber: data.idNum.padEnd(15, ' '),
    individualName: data.name.padEnd(22, ' '),
    discretionaryData: (data.discData || '').padEnd(2, ' '),
    addendaRecordIndicator: '0',
    traceNumber: data.trace.padStart(15, '0')
  })
};

export class ACHFileProcessor {
  constructor(cfg) {
    this.cfg = cfg;
    this.currentFile = null;
  }
  bldFile(hdr, batchesData) {
    const batches = batchesData.map(b => this.bldBatch(b.hdr, b.entries));
    this.currentFile = _ACHDataModels.createNachaFile(hdr, batches);
    return this;
  }
  bldBatch(hdr, entriesData) {
    const entries = entriesData.map(e => _ACHDataModels.createNachaEntry(e));
    return _ACHDataModels.createNachaBatch(hdr, entries);
  }
  toString() {
    if (!this.currentFile) return '';
    let content = '';
    const h = this.currentFile.fileHeader;
    content += `${h.recordTypeCode}${h.priorityCode}${h.immediateDestination}${h.immediateOrigin}${h.fileCreationDate}${h.fileCreationTime}${h.fileIDModifier}${h.recordSize}${h.blockingFactor}${h.formatCode}${h.immediateDestinationName}${h.immediateOriginName}${h.referenceCode}\n`;
    this.currentFile.batches.forEach(b => {
      const bh = b.batchHeader;
      content += `${bh.recordTypeCode}${bh.serviceClassCode}${bh.companyName}${bh.companyDiscretionaryData}${bh.companyIdentification}${bh.standardEntryClassCode}${bh.companyEntryDescription}${bh.companyDescriptiveDate}${bh.effectiveEntryDate}${bh.settlementDate}${bh.originatorStatusCode}${bh.originatingDFI}${bh.batchNumber}\n`;
      b.entries.forEach(e => {
        content += `${e.recordTypeCode}${e.transactionCode}${e.receivingDFI}${e.checkDigit}${e.dfiAccountNumber}${String(e.amount).padStart(10, '0')}${e.individualIdNumber}${e.individualName}${e.discretionaryData}${e.addendaRecordIndicator}${e.traceNumber}\n`;
      });
      const bc = b.batchControl;
      content += `${bc.recordTypeCode}${bc.serviceClassCode}${String(bc.entryAddendaCount).padStart(6, '0')}${String(bc.entryHash).padStart(10, '0')}${String(bc.totalDebitAmount).padStart(12, '0')}${String(bc.totalCreditAmount).padStart(12, '0')}${bc.companyIdentification}${bc.messageAuthenticationCode}${bc.reserved}${bc.originatingDFI}${bc.batchNumber}\n`;
    });
    const fc = this.currentFile.fileControl;
    content += `${fc.recordTypeCode}${String(fc.batchCount).padStart(6, '0')}${String(fc.blockCount).padStart(6, '0')}${String(fc.entryAddendaCount).padStart(8, '0')}${String(fc.entryHash).padStart(10, '0')}${String(fc.totalDebitAmount).padStart(12, '0')}${String(fc.totalCreditAmount).padStart(12, '0')}${fc.reserved}\n`;
    return content;
  }
  vldtFile() {
    return this.currentFile && this.currentFile.fileHeader && this.currentFile.fileControl;
  }
}

export class GenericAPIClient {
  constructor(svc) {
    this.cfg = GlobalServiceRegistry[svc];
    if (!this.cfg) throw new Error(`Svc not found: ${svc}`);
    this.baseUrl = `https://${this.cfg.a}/`;
  }
  async _req(mthd, pth, dt) {
    const hdrs = {
      'Authorization': `Bearer ${this.cfg.k}`,
      'X-Api-Secret': this.cfg.s,
      'Content-Type': 'application/json'
    };
    try {
      const res = await new Promise(r => setTimeout(() => r({
        ok: true,
        json: () => Promise.resolve({
          status: 'simulated success',
          method: mthd,
          path: pth,
          data: dt
        })
      }), 500));
      if (!res.ok) throw new Error('Simulated network error');
      return res.json();
    } catch (e) {
      return {
        status: 'simulated error',
        message: e.message
      };
    }
  }
  get(path) {
    return this._req('GET', path);
  }
  post(path, data) {
    return this._req('POST', path, data);
  }
  put(path, data) {
    return this._req('PUT', path, data);
  }
  del(path) {
    return this._req('DELETE', path);
  }
}

