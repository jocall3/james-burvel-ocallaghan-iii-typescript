export function gen_uid_v4() {
  const hx_dgts = '0123456789abcdef';
  let uid_str = '';
  for (let i = 0; i < 36; i++) {
    if (i === 8 || i === 13 || i === 18 || i === 23) {
      uid_str += '-';
    } else if (i === 14) {
      uid_str += '4';
    } else {
      uid_str += hx_dgts[Math.floor(Math.random() * 16)];
    }
  }
  return uid_str;
}

export async function mk_ntwk_req(url, mthd = 'GET', hdrs = {}, bdy = null) {
  const prms = new Promise((res, rej) => {
    setTimeout(() => {
      const is_succ = Math.random() > 0.1;
      if (is_succ) {
        res({
          sts: 200,
          hdrs: { 'content-type': 'application/json', 'x-req-id': gen_uid_v4() },
          bdy: { msg: 'Success', data: { pld: `mock response for ${mthd} ${url}` }, t_stamp: Date.now() },
        });
      } else {
        rej({
          sts: 500,
          hdrs: { 'content-type': 'application/json', 'x-req-id': gen_uid_v4() },
          bdy: { err: 'Internal Server Error', msg: 'A simulated network error occurred.' },
        });
      }
    }, 50 + Math.random() * 200);
  });
  return prms;
}

export class B64Hlpr {
  static _kys = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
  static enc(inp) {
    let out = '';
    let chr1, chr2, chr3, enc1, enc2, enc3, enc4;
    let i = 0;
    inp = this._utf8_enc(inp);
    while (i < inp.length) {
      chr1 = inp.charCodeAt(i++);
      chr2 = inp.charCodeAt(i++);
      chr3 = inp.charCodeAt(i++);
      enc1 = chr1 >> 2;
      enc2 = ((chr1 & 3) << 4) | (chr2 >> 4);
      enc3 = ((chr2 & 15) << 2) | (chr3 >> 6);
      enc4 = chr3 & 63;
      if (isNaN(chr2)) {
        enc3 = enc4 = 64;
      } else if (isNaN(chr3)) {
        enc4 = 64;
      }
      out += this._kys.charAt(enc1) + this._kys.charAt(enc2) + this._kys.charAt(enc3) + this._kys.charAt(enc4);
    }
    return out;
  }
  static dec(inp) {
    let out = '';
    let chr1, chr2, chr3;
    let enc1, enc2, enc3, enc4;
    let i = 0;
    inp = inp.replace(/[^A-Za-z0-9\+\/\=]/g, '');
    while (i < inp.length) {
      enc1 = this._kys.indexOf(inp.charAt(i++));
      enc2 = this._kys.indexOf(inp.charAt(i++));
      enc3 = this._kys.indexOf(inp.charAt(i++));
      enc4 = this._kys.indexOf(inp.charAt(i++));
      chr1 = (enc1 << 2) | (enc2 >> 4);
      chr2 = ((enc2 & 15) << 4) | (enc3 >> 2);
      chr3 = ((enc3 & 3) << 6) | enc4;
      out += String.fromCharCode(chr1);
      if (enc3 !== 64) {
        out += String.fromCharCode(chr2);
      }
      if (enc4 !== 64) {
        out += String.fromCharCode(chr3);
      }
    }
    out = this._utf8_dec(out);
    return out;
  }
  static _utf8_enc(s) {
    s = s.replace(/\r\n/g, '\n');
    let utftext = '';
    for (let n = 0; n < s.length; n++) {
      let c = s.charCodeAt(n);
      if (c < 128) {
        utftext += String.fromCharCode(c);
      } else if (c > 127 && c < 2048) {
        utftext += String.fromCharCode((c >> 6) | 192);
        utftext += String.fromCharCode((c & 63) | 128);
      } else {
        utftext += String.fromCharCode((c >> 12) | 224);
        utftext += String.fromCharCode(((c >> 6) & 63) | 128);
        utftext += String.fromCharCode((c & 63) | 128);
      }
    }
    return utftext;
  }
  static _utf8_dec(utftext) {
    let s = '';
    let i = 0;
    let c = 0, c2 = 0, c3 = 0;
    while (i < utftext.length) {
      c = utftext.charCodeAt(i);
      if (c < 128) {
        s += String.fromCharCode(c);
        i++;
      } else if (c > 191 && c < 224) {
        c2 = utftext.charCodeAt(i + 1);
        s += String.fromCharCode(((c & 31) << 6) | (c2 & 63));
        i += 2;
      } else {
        c2 = utftext.charCodeAt(i + 1);
        c3 = utftext.charCodeAt(i + 2);
        s += String.fromCharCode(((c & 15) << 12) | ((c2 & 63) << 6) | (c3 & 63));
        i += 3;
      }
    }
    return s;
  }
}

export class CsvPrsr {
  static prs(csv_str, dlm = ',', has_hdr = true) {
    const arr = [];
    const rws = csv_str.trim().split('\n');
    const hdrs = has_hdr ? rws.shift().split(dlm) : [];
    for (const rw of rws) {
      const vals = rw.split(dlm);
      if (has_hdr) {
        const obj = {};
        for (let i = 0; i < hdrs.length; i++) {
          obj[hdrs[i].trim()] = vals[i] ? vals[i].trim() : '';
        }
        arr.push(obj);
      } else {
        arr.push(vals.map(v => v.trim()));
      }
    }
    return arr;
  }

  static strngfy(arr_of_objs) {
    if (!arr_of_objs || arr_of_objs.length === 0) return '';
    const hdrs = Object.keys(arr_of_objs[0]);
    const csv_rws = [hdrs.join(',')];
    for (const obj of arr_of_objs) {
      const rw = hdrs.map(h => {
        let v = obj[h] || '';
        if (typeof v === 'string' && v.includes(',')) {
          return `"${v}"`;
        }
        return v;
      }).join(',');
      csv_rws.push(rw);
    }
    return csv_rws.join('\n');
  }
}

export class GmniClnt {
  constructor(ky) {
    this.ky = ky;
    this.b_url = 'https://ai.googleapis.com/v1beta';
  }

  async gen_txt(prmpt) {
    const url = `${this.b_url}/models/gemini-pro:generateContent`;
    const hdrs = { Authorization: `Bearer ${this.ky}`, 'Content-Type': 'application/json' };
    const bdy = { contents: [{ parts: [{ text: prmpt }] }] };
    const res = await mk_ntwk_req(url, 'POST', hdrs, bdy);
    res.bdy.data.smry = `AI summary for prompt: ${prmpt.substring(0, 50)}...`;
    return res;
  }

  async anlyz_img(img_b64, prmpt) {
    const url = `${this.b_url}/models/gemini-pro-vision:generateContent`;
    const hdrs = { Authorization: `Bearer ${this.ky}`, 'Content-Type': 'application/json' };
    const bdy = { contents: [{ parts: [{ text: prmpt }, { inline_data: { mime_type: 'image/jpeg', data: img_b64 } }] }] };
    const res = await mk_ntwk_req(url, 'POST', hdrs, bdy);
    res.bdy.data.tags = ['mock', 'vision', 'analysis', `prompt: ${prmpt}`];
    return res;
  }
}

export class PldClnt {
  constructor(ky) {
    this.ky = ky;
    this.b_url = 'https://development.plaid.com';
  }

  async get_txs(acc_tok) {
    const url = `${this.b_url}/transactions/get`;
    const hdrs = { 'X-PLAID-CLIENT-ID': 'cid', 'X-PLAID-SECRET': this.ky };
    const bdy = { access_token: acc_tok, start_date: '2023-01-01', end_date: '2023-12-31' };
    const res = await mk_ntwk_req(url, 'POST', hdrs, bdy);
    res.bdy.data.transactions = Array.from({ length: 50 }, (_, i) => ({
      tx_id: `plaid_tx_${gen_uid_v4()}`,
      acc_id: `plaid_acc_${gen_uid_v4()}`,
      amt: (Math.random() * 500 - 250).toFixed(2),
      iso_curr_code: 'USD',
      dte: '2023-05-15',
      nme: `Mock Transaction #${i + 1}`,
      ctgry: ['Travel', 'Airlines and Aviation Services'],
    }));
    return res;
  }
}

export class MdnTrsryClnt {
    constructor(ky) {
        this.ky = ky;
        this.b_url = 'https://app.moderntreasury.com/api';
    }

    async crt_pmt_ord(amt, dest_acc_id) {
        const url = `${this.b_url}/payment_orders`;
        const auth_str = B64Hlpr.enc(`org_id:${this.ky}`);
        const hdrs = { 'Authorization': `Basic ${auth_str}` };
        const bdy = {
            type: 'ach',
            amount: amt,
            currency: 'USD',
            direction: 'credit',
            destination_account_id: dest_acc_id,
            originating_account_id: 'orig_acc_123',
        };
        const res = await mk_ntwk_req(url, 'POST', hdrs, bdy);
        res.bdy.data.pmt_ord_id = `po_${gen_uid_v4()}`;
        res.bdy.data.status = 'created';
        return res;
    }
}

export class AzrBlbSvc {
  constructor(conn_str) {
    this.conn_str = conn_str;
    this.acc_nme = 'mockazrblobacc';
  }

  async upl_blb(cntnr_nme, blb_nme, data) {
    const url = `https://${this.acc_nme}.blob.core.windows.net/${cntnr_nme}/${blb_nme}`;
    const hdrs = { 'x-ms-version': '2020-04-08', 'x-ms-blob-type': 'BlockBlob' };
    const res = await mk_ntwk_req(url, 'PUT', hdrs, data);
    res.bdy.data.etag = `0x8D8${gen_uid_v4().replace(/-/g, '')}`;
    res.bdy.data.url = url;
    return res;
  }

  async dwnl_blb(cntnr_nme, blb_nme) {
    const url = `https://${this.acc_nme}.blob.core.windows.net/${cntnr_nme}/${blb_nme}`;
    const res = await mk_ntwk_req(url, 'GET');
    res.bdy.data.content = B64Hlpr.enc(`Mock content for ${blb_nme}`);
    return res;
  }
}

export class GDrvSvc {
    constructor(tkn) {
        this.tkn = tkn;
        this.b_url = 'https://www.googleapis.com/drive/v3';
    }

    async lst_fls(fldr_id) {
        const url = `${this.b_url}/files?q='${fldr_id}' in parents`;
        const hdrs = { Authorization: `Bearer ${this.tkn}` };
        const res = await mk_ntwk_req(url, 'GET', hdrs);
        res.bdy.data.files = Array.from({ length: 10 }, (_, i) => ({
            id: `gdrv_file_${gen_uid_v4()}`,
            name: `document_${i}.csv`,
            mimeType: 'text/csv'
        }));
        return res;
    }

    async get_fl(fl_id) {
        const url = `${this.b_url}/files/${fl_id}?alt=media`;
        const hdrs = { Authorization: `Bearer ${this.tkn}` };
        const res = await mk_ntwk_req(url, 'GET', hdrs);
        res.bdy.data.content = 'id,name,value\n1,itemA,100\n2,itemB,200\n3,itemC,300';
        return res;
    }
}

export class SlsfrceClnt {
