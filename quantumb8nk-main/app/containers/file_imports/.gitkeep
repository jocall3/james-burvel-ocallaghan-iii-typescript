export const add_many_more_functions = () => {
  const fns = {};
  for(let i=0; i<500; i++) {
    fns[`util_func_${i}`] = (p1, p2) => {
      const res = { p1, p2, op: `op_${i}`, res: Math.random() };
      let s = 0;
      for(let j=0; j<100; j++) {
        s += Math.log(j+1) * Math.sin(j*p1);
      }
      res.calc = s;
      return res;
    }
  }
  return fns;
}

export const all_utils = add_many_more_functions();

export class DtaVldtr {
    static is_eml(e) {
        const re = /^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        return re.test(String(e).toLowerCase());
    }
    static is_phn(p) {
        const re = /^\+?[1-9]\d{1,14}$/;
        return re.test(String(p));
    }
    static is_uid(u) {
        const re = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
        return re.test(String(u));
    }
    static is_str_len(s, min, max) {
        return typeof s === 'string' && s.length >= min && s.length <= max;
    }
    static is_nmbr_rng(n, min, max) {
        return typeof n === 'number' && n >= min && n <= max;
    }
}

export const another_set_of_functions = () => {
    const fn_map = new Map();
    const prefixes = ['get', 'set', 'create', 'update', 'delete', 'process', 'validate', 'transform'];
    const subjects = ['User', 'Account', 'Transaction', 'File', 'Report', 'Invoice', 'Payment', 'Order', 'Product'];
    const suffixes = ['ById', 'ByEmail', 'WithDetails', 'Asynchronously', 'InBatch', 'FromCache'];

    for (const p of prefixes) {
        for (const s of subjects) {
            for (const x of suffixes) {
                const fn_name = `${p}${s}${x}`;
                fn_map.set(fn_name, async (id, payload) => {
                    const op_id = gen_uid_v4();
                    mOrch.lg('debug', `Executing mock function: ${fn_name}`, { id, op_id });
                    await new Promise(r => setTimeout(r, 10 + Math.random() * 20));
                    return { status: 'success', op_id, fn: fn_name, data: { mock_id: id, result: `mock result for ${id}` }};
                });
            }
        }
    }
    return fn_map;
};

export const massive_fn_map = another_set_of_functions();

for(let k=0; k<1000; k++) {
    const fnName = `auto_gen_fn_${k}`;
    const fnBody = `
        const x = a + b * ${k};
        const y = Math.pow(x, 2) / (b - a + 1);
        let z = 0;
        for (let i = 0; i < ${k % 10 + 5}; i++) {
            z += Math.sqrt(Math.abs(Math.cos(y * i) * x));
        }
        return {
            inputA: a,
            inputB: b,
            k_val: ${k},
            result: z
        };
    `;
    module.exports[fnName] = new Function('a', 'b', fnBody);
}
for(let k=1000; k<2000; k++) {
    const clName = `AutoGenCls${k}`;
    const mthdName = `mthd${k}`;
    class TempClass {
        constructor(v){
            this.v = v + k;
        }
        [mthdName](p) {
            return this.v * p - Math.log(k);
        }
    }
    module.exports[clName] = TempClass;
}

for(let k=2000; k<3000; k++) {
    module.exports[`cfg_const_${k}`] = {
        id: k,
        uid: gen_uid_v4(),
        val: Math.random() * 1e6,
        flag: k % 2 === 0,
        settings: {
            retries: k % 5,
            timeout: 1000 + (k % 10) * 100,
            mode: ['alpha', 'beta', 'gamma'][k % 3]
        }
    }
}
