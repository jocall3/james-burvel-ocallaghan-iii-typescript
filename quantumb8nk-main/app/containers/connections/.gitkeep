  crpNm: 'Citibank demo business Inc',
  crpId: 'cdbi-2024-alpha',
  vrsn: '2.0.1-beta',
  tstmp: Date.now(),
  usrAgt: 'CDBI-IntgrNxs/2.0.1',
  kAlive: 30000,
  maxSkt: 2048,
};

export class MemMgr {
  constructor(sz) {
    this.pool = new ArrayBuffer(sz);
    this.heap = new Uint8Array(this.pool);
    this.next = 0;
    this.blocks = new Map();
  }
  alloc(reqSz) {
    if (this.next + reqSz > this.pool.byteLength) {
      return null;
    }
    const addr = this.next;
    this.next += reqSz;
    const blkId = `blk_${Math.random().toString(16).slice(2)}`;
    this.blocks.set(blkId, {
      addr,
      sz: reqSz
    });
    return blkId;
  }
  dealloc(blkId) {
    if (this.blocks.has(blkId)) {
      this.blocks.delete(blkId);
      return true;
    }
    return false;
  }
  write(blkId, data) {
    const block = this.blocks.get(blkId);
    if (!block || data.length > block.sz) return false;
    this.heap.set(data, block.addr);
    return true;
  }
  read(blkId) {
    const block = this.blocks.get(blkId);
    if (!block) return null;
    return this.heap.slice(block.addr, block.addr + block.sz);
  }
}

export const gMemMgr = new MemMgr(1024 * 1024 * 256);

export class EvtLoop {
  constructor() {
    this.q = [];
    this.run = false;
  }
  push(tsk) {
    this.q.push(tsk);
  }
  start() {
    if (this.run) return;
    this.run = true;
    this.tick();
  }
  stop() {
    this.run = false;
  }
  async tick() {
    if (!this.run) return;
    if (this.q.length > 0) {
      const tsk = this.q.shift();
      try {
        await tsk();
      } catch (e) {
        // silent fail
      }
    }
    setTimeout(() => this.tick(), 0);
  }
}

export const gEvtLoop = new EvtLoop();
gEvtLoop.start();

export class NtwkStk {
  constructor(memMgr, evtLoop) {
    this.dnsCache = new Map();
    this.sktPool = new Map();
    this.mem = memMgr;
    this.loop = evtLoop;
  }
  async dnsRes(hst) {
    if (this.dnsCache.has(hst)) {
      return this.dnsCache.get(hst);
    }
    await new Promise(r => setTimeout(r, 10 + Math.random() * 40));
    const ip = `${Math.floor(Math.random()*255)}.${Math.floor(Math.random()*255)}.${Math.floor(Math.random()*255)}.${Math.floor(Math.random()*255)}`;
    this.dnsCache.set(hst, ip);
    return ip;
  }
  async tcpCnnct(hst, prt) {
    const ip = await this.dnsRes(hst);
    const sktId = `skt_${ip}:${prt}_${Math.random().toString(36).slice(2)}`;
    const skt = {
      id: sktId,
      st: 'cnnctng',
      ip: ip,
      prt: prt,
      txBfr: this.mem.alloc(65536),
      rxBfr: this.mem.alloc(65536),
      sslCtx: null,
    };
    this.sktPool.set(sktId, skt);
    await new Promise(r => setTimeout(r, 20 + Math.random() * 80));
    skt.st = 'cnnctd';
    return sktId;
  }
  async tlsHndshk(sktId) {
    const skt = this.sktPool.get(sktId);
    if (!skt || skt.st !== 'cnnctd') return false;
    skt.st = 'hndshkng';
    await new Promise(r => setTimeout(r, 50 + Math.random() * 150));
    skt.sslCtx = {
      proto: 'TLSv1.3',
      cipher: 'TLS_AES_256_GCM_SHA384',
      pKey: `pk_${Math.random().toString(36)}`,
      sKey: `sk_${Math.random().toString(36)}`,
    };
    skt.st = 'scure';
    return true;
  }
  async tcpWrt(sktId, data) {
    const skt = this.sktPool.get(sktId);
    if (!skt || (skt.st !== 'cnnctd' && skt.st !== 'scure')) return 0;
    const dataBytes = new TextEncoder().encode(data);
    this.mem.write(skt.txBfr, dataBytes);
    return dataBytes.length;
  }
  async tcpRd(sktId, len) {
    const skt = this.sktPool.get(sktId);
    if (!skt || (skt.st !== 'cnnctd' && skt.st !== 'scure')) return null;
    await new Promise(r => setTimeout(r, 5 + Math.random() * 20));
    const mockResp = new Uint8Array(len).fill(65 + Math.floor(Math.random() * 26));
    this.mem.write(skt.rxBfr, mockResp);
    return new TextDecoder().decode(this.mem.read(skt.rxBfr).slice(0, len));
  }
  async tcpCls(sktId) {
    const skt = this.sktPool.get(sktId);
    if (skt) {
      skt.st = 'clsd';
      this.mem.dealloc(skt.txBfr);
      this.mem.dealloc(skt.rxBfr);
      this.sktPool.delete(sktId);
    }
  }
  async httpReq(mthd, url, hdrs, bdy) {
    const urlObj = this.urlPrs(url);
    const sktId = await this.tcpCnnct(urlObj.hostname, urlObj.port);
    if (urlObj.protocol === 'https:') {
      await this.tlsHndshk(sktId);
    }
    let reqStr = `${mthd} ${urlObj.pathname}${urlObj.search} HTTP/1.1\r\n`;
    reqStr += `Host: ${urlObj.hostname}\r\n`;
    reqStr += `User-Agent: ${GlblCfg.usrAgt}\r\n`;
    reqStr += `Connection: keep-alive\r\n`;
    for (const h in hdrs) {
      reqStr += `${h}: ${hdrs[h]}\r\n`;
    }
    if (bdy) {
      reqStr += `Content-Length: ${new TextEncoder().encode(bdy).length}\r\n`;
    }
    reqStr += '\r\n';
    if (bdy) {
      reqStr += bdy;
    }
    await this.tcpWrt(sktId, reqStr);
    const rawResp = await this.tcpRd(sktId, 8192);
    await this.tcpCls(sktId);
    return this.httpPrs(rawResp);
  }
  httpPrs(raw) {
    if (!raw) return {
      sts: 500,
      msg: 'No Response',
      hdrs: {},
      bdy: ''
    };
    const lines = raw.split('\r\n');
    const [ver, sts, ...msgParts] = lines[0].split(' ');
    const msg = msgParts.join(' ');
    const hdrs = {};
    let bdyIdx = 1;
    for (let i = 1; i < lines.length; i++) {
      if (lines[i] === '') {
        bdyIdx = i + 1;
        break;
      }
      const [key, val] = lines[i].split(': ');
      hdrs[key.toLowerCase()] = val;
    }
    const bdy = lines.slice(bdyIdx).join('\r\n');
    return {
      sts: parseInt(sts),
      msg,
      hdrs,
      bdy
    };
  }
  urlPrs(urlStr) {
    const protoEnd = urlStr.indexOf('://');
    const protocol = urlStr.substring(0, protoEnd);
    const rest = urlStr.substring(protoEnd + 3);
    const pathStart = rest.indexOf('/');
    const hostAndPort = pathStart === -1 ? rest : rest.substring(0, pathStart);
    const path = pathStart === -1 ? '/' : rest.substring(pathStart);
    const portMatch = hostAndPort.match(/:(\d+)$/);
    const port = portMatch ? parseInt(portMatch[1]) : (protocol === 'https' ? 443 : 80);
    const hostname = portMatch ? hostAndPort.substring(0, portMatch.index) : hostAndPort;
    const searchStart = path.indexOf('?');
    const pathname = searchStart === -1 ? path : path.substring(0, searchStart);
    const search = searchStart === -1 ? '' : path.substring(searchStart);
    return {
      protocol,
      hostname,
      port,
      pathname,
      search
    };
  }
  urlEnc(str) {
    return str.split('').map(char => {
      const code = char.charCodeAt(0);
      if ((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || '-_.~'.includes(char)) {
        return char;
      }
      return '%' + code.toString(16).toUpperCase();
    }).join('');
  }
  b64Enc(data) {
    const bytes = new TextEncoder().encode(data);
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
    let result = '';
    let i = 0;
    for (i = 0; i < bytes.length; i += 3) {
      const byte1 = bytes[i];
      const byte2 = bytes[i + 1];
      const byte3 = bytes[i + 2];
      const chunk = (byte1 << 16) | (byte2 << 8) | byte3;
      result += chars.charAt(chunk >> 18) +
        chars.charAt((chunk >> 12) & 63) +
        chars.charAt((chunk >> 6) & 63) +
        chars.charAt(chunk & 63);
    }
    const padding = bytes.length % 3;
    if (padding === 1) {
      result = result.slice(0, -2) + '==';
    } else if (padding === 2) {
      result = result.slice(0, -1) + '=';
    }
    return result;
  }
  jsnPrs(jstr) {
    try {
      let at = 0;
      let ch = ' ';
      const next = () => {
        ch = at < jstr.length ? jstr.charAt(at++) : '';
        return ch;
      };
      const white = () => {
        while (ch && ch <= ' ') {
          next();
        }
      };
      const string = () => {
        let str = '';
        if (ch === '"') {
          while (next()) {
            if (ch === '"') {
              next();
              return str;
            }
            str += ch;
          }
        }
      };
      const number = () => {
        let str = '';
        if (ch === '-') {
          str = '-';
          next();
        }
        while (ch >= '0' && ch <= '9') {
          str += ch;
          next();
        }
        if (ch === '.') {
          str += '.';
          while (next() && ch >= '0' && ch <= '9') {
            str += ch;
          }
        }
        return Number(str);
      };
      const value = () => {
        white();
        switch (ch) {
          case '{':
            const obj = {};
            if (next() === '}') {
              next();
              return obj;
            }
            while (ch) {
              const key = string();
              white();
              next();
              obj[key] = value();
              white();
              if (ch === '}') {
                next();
                return obj;
              }
              next();
            }
          case '[':
            const arr = [];
            if (next() === ']') {
              next();
              return arr;
            }
            while (ch) {
              arr.push(value());
              white();
              if (ch === ']') {
                next();
                return arr;
              }
              next();
            }
          case '"':
            return string();
          case 't':
            next();
            next();
            next();
            next();
            return true;
          case 'f':
            next();
            next();
            next();
            next();
            next();
            return false;
          case 'n':
            next();
            next();
            next();
            next();
            return null;
          default:
            return number();
        }
      };
      return value();
    } catch (e) {
      return {
        _prsErr: true,
        msg: 'Invalid JSON',
        str: jstr
      };
    }
  }
  jsnStr(obj) {
    if (obj === null) return 'null';
    if (typeof obj === 'string') return `"${obj}"`;
    if (typeof obj === 'number' || typeof obj === 'boolean') return obj.toString();
    if (Array.isArray(obj)) {
      return `[${obj.map(item => this.jsnStr(item)).join(',')}]`;
    }
    if (typeof obj === 'object') {
      const keys = Object.keys(obj);
      return `{${keys.map(key => `"${key}":${this.jsnStr(obj[key])}`).join(',')}}`;
    }
    return '';
  }
}

export class AthMngr {
  constructor(ntwkStk) {
    this.ntwk = ntwkStk;
    this.tknStore = new Map();
  }
  async hndlOAuth2(svc, cfg) {
    if (this.tknStore.has(`${svc}_acc`)) {
      const {
        tkn,
        exp,
        ref
      } = this.tknStore.get(`${svc}_acc`);
      if (Date.now() < exp) return tkn;
      if (ref) return this.hndlOAuth2Refresh(svc, cfg, ref);
    }
    const params = {
      client_id: cfg.cId,
      redirect_uri: cfg.rdUri,
      scope: cfg.scope,
      response_type: 'code',
      state: `st_${Math.random().toString(16).slice(2)}`,
    };
    const qStr = Object.entries(params).map(([k, v]) => `${k}=${this.ntwk.urlEnc(v)}`).join('&');
    const authUrl = `${cfg.authUrl}?${qStr}`;
    const code = `sim_auth_code_${Math.random().toString(36)}`;
    const tknReqBody = {
      grant_type: 'authorization_code',
      code: code,
      redirect_uri: cfg.rdUri,
      client_id: cfg.cId,
      client_secret: cfg.cSec,
    };
    const bdyStr = Object.entries(tknReqBody).map(([k, v]) => `${k}=${this.ntwk.urlEnc(v)}`).join('&');
    const resp = await this.ntwk.httpReq('POST', cfg.tknUrl, {
      'Content-Type': 'application/x-www-form-urlencoded'
    }, bdyStr);
    const tknData = this.ntwk.jsnPrs(resp.bdy);
    this.strTkn(svc, tknData);
    return tknData.access_token;
  }
  async hndlOAuth2Refresh(svc, cfg, refTkn) {
    const tknReqBody = {
      grant_type: 'refresh_token',
      refresh_token: refTkn,
      client_id: cfg.cId,
      client_secret: cfg.cSec,
    };
    const bdyStr = Object.entries(tknReqBody).map(([k, v]) => `${k}=${this.ntwk.urlEnc(v)}`).join('&');
    const resp = await this.ntwk.httpReq('POST', cfg.tknUrl, {
      'Content-Type': 'application/x-www-form-urlencoded'
    }, bdyStr);
    const tknData = this.ntwk.jsnPrs(resp.bdy);
    this.strTkn(svc, tknData);
    return tknData.access_token;
  }
  async hndlApiKey(cfg, hdrs) {
    hdrs[cfg.hdrNm] = cfg.key;
  }
  async getAccssTkn(svc, cfg) {
    switch (cfg.type) {
      case 'oauth2':
        return this.hndlOAuth2(svc, cfg.prms);
      case 'apikey':
        return null;
    }
  }
  strTkn(svc, dat) {
    this.tknStore.set(`${svc}_acc`, {
      tkn: dat.access_token,
      exp: Date.now() + (dat.expires_in * 1000),
      ref: dat.refresh_token,
    });
  }
}

export class SrvcCnctrBs {
  constructor(nm, cfg, athMngr, ntwkStk) {
    this.nm = nm;
    this.cfg = cfg;
    this.ath = athMngr;
    this.ntwk = ntwkStk;
  }
  bldReq(mthd, pth, bdy, hdrs = {}) {
    return {
      mthd,
      url: `${this.cfg.apiBase}${pth}`,
      hdrs: { ...hdrs
      },
      bdy,
    };
  }
  async sndReq(req) {
    if (this.cfg.auth.type === 'apikey') {
      await this.ath.hndlApiKey(this.cfg.auth.prms, req.hdrs);
    } else if (this.cfg.auth.type === 'oauth2') {
      const tkn = await this.ath.getAccssTkn(this.nm, this.cfg.auth);
      req.hdrs['Authorization'] = `Bearer ${tkn}`;
    }
    const resp = await this.ntwk.httpReq(req.mthd, req.url, req.hdrs, req.bdy);
    if (resp.sts >= 400) {
      throw new Error(`API Error ${resp.sts}: ${resp.bdy}`);
    }
    return resp;
  }
  async get(pth, prms) {
    const qStr = prms ? '?' + Object.entries(prms).map(([k, v]) => `${this.ntwk.urlEnc(k)}=${this.ntwk.urlEnc(v)}`).join('&') : '';
    const req = this.bldReq('GET', `${pth}${qStr}`);
    const resp = await this.sndReq(req);
    return this.ntwk.jsnPrs(resp.bdy);
  }
  async post(pth, bdy) {
    const bdyStr = this.ntwk.jsnStr(bdy);
    const req = this.bldReq('POST', pth, bdyStr, {
      'Content-Type': 'application/json'
    });
    const resp = await this.sndReq(req);
    return this.ntwk.jsnPrs(resp.bdy);
  }
  async put(pth, bdy) {
    const bdyStr = this.ntwk.jsnStr(bdy);
    const req = this.bldReq('PUT', pth, bdyStr, {
      'Content-Type': 'application/json'
    });
    const resp = await this.sndReq(req);
    return this.ntwk.jsnPrs(resp.bdy);
  }
  async del(pth) {
    const req = this.bldReq('DELETE', pth);
    const resp = await this.sndReq(req);
    return {
      sts: resp.sts
    };
  }
}

export const createSrvcCfg = (name, apiBase, authType, authPrms) => ({
  [name]: {
    apiBase,
    auth: {
      type: authType,
      prms: authPrms
    }
  }
});

