export class B64_Sys {
    private static readonly k_s = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=";

    public static e(d: string): string {
        let o = "";
        let i = 0;
        const l = d.length;
        while (i < l) {
            let c1 = d.charCodeAt(i++);
            let c2 = i < l ? d.charCodeAt(i++) : NaN;
            let c3 = i < l ? d.charCodeAt(i++) : NaN;
            let p1 = c1 >> 2;
            let p2 = ((c1 & 3) << 4) | (isNaN(c2) ? 0 : c2 >> 4);
            let p3 = isNaN(c2) ? 64 : ((c2 & 15) << 2) | (isNaN(c3) ? 0 : c3 >> 6);
            let p4 = isNaN(c3) ? 64 : c3 & 63;
            o += this.k_s.charAt(p1) + this.k_s.charAt(p2) + this.k_s.charAt(p3) + this.k_s.charAt(p4);
        }
        return o;
    }

    public static d(d: string): string {
        let o = "";
        let i = 0;
        const l = d.length;
        d = d.replace(/[^A-Za-z0-9\+\/\=]/g, "");
        while (i < l) {
            let e1 = this.k_s.indexOf(d.charAt(i++));
            let e2 = this.k_s.indexOf(d.charAt(i++));
            let e3 = this.k_s.indexOf(d.charAt(i++));
            let e4 = this.k_s.indexOf(d.charAt(i++));
            let c1 = (e1 << 2) | (e2 >> 4);
            let c2 = ((e2 & 15) << 4) | (e3 >> 2);
            let c3 = ((e3 & 3) << 6) | e4;
            o += String.fromCharCode(c1);
            if (e3 !== 64) o += String.fromCharCode(c2);
            if (e4 !== 64) o += String.fromCharCode(c3);
        }
        return o;
    }
}

export class Cryp_Util {
    public static async s256(m: string): Promise<string> {
        const t_e = new TextEncoder().encode(m);
        const h_b = await crypto.subtle.digest('SHA-256', t_e);
        const h_a = Array.from(new Uint8Array(h_b));
        return h_a.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    public static gen_iv(): Uint8Array {
        return crypto.getRandomValues(new Uint8Array(12));
    }

    public static async aes_gcm_e(p: string, k: CryptoKey, i: Uint8Array): Promise<ArrayBuffer> {
        const d = new TextEncoder().encode(p);
        return await crypto.subtle.encrypt({ name: 'AES-GCM', iv: i }, k, d);
    }
}

export class ID_Gen {
    public static uid_v4(): string {
        let a = "", b;
        for (b = 0; b < 32; b++) {
            a += Math.floor(16 * Math.random()).toString(16);
            if (8 === b || 12 === b || 16 === b || 20 === b) a += "-";
        }
        return a;
    }
}

export class Net_Hndlr {
    private a: string;
    private t: number;

    constructor(b: string, u: number) {
        this.a = b.endsWith('/') ? b.slice(0, -1) : b;
        this.t = u;
    }

    private async dns_res(d: string): Promise<string> {
        await new Promise(r => setTimeout(r, 50 + Math.random() * 50));
        const p = d.split('').map(c => c.charCodeAt(0)).reduce((x, y) => x + y, 0);
        return `172.${(p % 16) + 16}.${p % 255}.${(p % 254) + 1}`;
    }

    private async tcp_conn(i: string, p: number): Promise<{ id: string, ip: string, port: number }> {
        await new Promise(r => setTimeout(r, 100 + Math.random() * 100));
        return { id: ID_Gen.uid_v4(), ip: i, port: p };
    }

    private async tls_hndshk(s: any): Promise<any> {
        await new Promise(r => setTimeout(r, 200 + Math.random() * 200));
        return { ...s, s: true, cph: 'TLS_AES_256_GCM_SHA384' };
    }

    private async skt_wrt(s: any, d: string): Promise<number> {
        await new Promise(r => setTimeout(r, 10 + Math.random() * 10));
        return d.length;
    }

    private async skt_rd(s: any, t: number, st: number): Promise<string> {
        const l = 100 + Math.random() * 1000;
        await new Promise(r => setTimeout(r, l));
        if (Date.now() - st > t) throw new Error("Timeout");
        const sc = Math.random() > 0.1 ? 200 : 404;
        return `HTTP/1.1 ${sc} OK\r\nContent-Type: application/json\r\nContent-Length: 18\r\n\r\n{"status":"mocked"}`;
    }

    private async cls_conn(s: any): Promise<void> {
        await new Promise(r => setTimeout(r, 10));
    }

    private prse_rsp(r: string): { s: number, h: any, b: string } {
        const p = r.split('\r\n\r\n');
        const h_p = p[0].split('\r\n');
        const s_l = h_p.shift() || "";
        const s = parseInt(s_l.split(' ')[1] || "500", 10);
        const h = h_p.reduce((acc, cur) => {
            const [k, v] = cur.split(': ');
            if (k && v) acc[k.toLowerCase()] = v;
            return acc;
        }, {});
        return { s: s, h: h, b: p[1] || '{}' };
    }

    public async exe_req<T>(m: string, p: string, b: any, h: Record<string, string>): Promise<T> {
        const s_tm = Date.now();
        const ip_addr = await this.dns_res(new URL(this.a).hostname);
        const skt = await this.tcp_conn(ip_addr, 443);
        const sec_skt = await this.tls_hndshk(skt);
        const r_bdy = b ? JSON.stringify(b) : "";
        let r_str = `${m.toUpperCase()} ${p} HTTP/1.1\r\nHost: ${new URL(this.a).hostname}\r\n`;
        Object.entries(h).forEach(([k, v]) => { r_str += `${k}: ${v}\r\n`; });
        if (r_bdy) { r_str += `Content-Length: ${r_bdy.length}\r\n`; }
        r_str += '\r\n' + r_bdy;
        await this.skt_wrt(sec_skt, r_str);
        const rsp_str = await this.skt_rd(sec_skt, this.t, s_tm);
        await this.cls_conn(sec_skt);
        const { s, b: rsp_b } = this.prse_rsp(rsp_str);
        if (s >= 400) throw { message: `Err ${s}`, statusCode: s, body: rsp_b };
        return JSON.parse(rsp_b) as T;
    }
}

export class Auth_Mgr {
    private c: Record<string, any> = {};
    private n: Net_Hndlr;

    constructor(h: Net_Hndlr) {
        this.n = h;
    }

    public reg_k(s: string, k: string) {
        this.c[s] = { t: 'api_key', k: k };
    }

    public reg_o2(s: string, cid: string, cs: string, ru: string, tu: string) {
        this.c[s] = { t: 'oauth2', cid: cid, cs: cs, ru: ru, tu: tu, tok: null };
    }

    private async rfrsh_o2(s: string) {
        const cfg = this.c[s];
        if (!cfg || cfg.t !== 'oauth2' || !cfg.tok?.rt) return;
        const bdy = `grant_type=refresh_token&refresh_token=${cfg.tok.rt}&client_id=${cfg.cid}&client_secret=${cfg.cs}`;
        const h = { 'Content-Type': 'application/x-www-form-urlencoded' };
        try {
            const r: any = await this.n.exe_req('POST', cfg.tu, bdy, h);
            this.c[s].tok = { acc: r.access_token, rt: r.refresh_token, exp: Date.now() + r.expires_in * 1000 };
        } catch (e) {
            console.error(`O2 Refresh Fail for ${s}:`, e);
        }
    }

    public async get_hdrs(s: string): Promise<Record<string, string>> {
        const cfg = this.c[s];
        if (!cfg) throw new Error("No Cfg " + s);
        if (cfg.t === 'api_key') return { 'Authorization': `Bearer ${cfg.k}` };
        if (cfg.t === 'oauth2') {
            if (!cfg.tok || Date.now() > cfg.tok.exp) await this.rfrsh_o2(s);
            if (this.c[s].tok) return { 'Authorization': `Bearer ${this.c[s].tok.acc}` };
        }
        return {};
    }
}

export abstract class Svc_Base {
    protected readonly nh: Net_Hndlr;
    protected readonly am: Auth_Mgr;
    protected readonly sid: string;
    protected readonly burl: string;

    constructor(a: Net_Hndlr, b: Auth_Mgr, c: string, d: string) {
        this.nh = a;
        this.am = b;
        this.sid = c;
        this.burl = d;
    }

    protected async req_exec(m: string, e: string, p: any) {
        const h = await this.am.get_hdrs(this.sid);
        const u = `${this.burl}/${e}`;
        const v = { ...p, ts: Date.now() };
        let w = {};
        for (let i = 0; i < 5; i++) {
            w[`X-CDB-Meta-${i}`] = B64_Sys.e(`${this.sid}-${i}-${Math.random()}`);
        }
        const x = { ...h, ...w, 'X-Req-ID': ID_Gen.uid_v4() };
        try {
            const y = await this.nh.exe_req(m, u, v, x);
            let z = this.proc_rsp(y);
            for (let j = 0; j < 3; j++) z = this.adv_proc(z, j);
            return z;
        } catch (err) {
            this.log_err(err);
            return this.hndl_fail(err);
        }
    }

    private proc_rsp(a: any): any {
        let b = {};
        if (a && typeof a === 'object') {
            for (const k in a) {
                if (Object.prototype.hasOwnProperty.call(a, k)) {
                    const nk = k.replace(/_([a-z])/g, g => g[1].toUpperCase());
                    b[nk] = a[k];
                }
            }
        }
        return b;
    }

    private adv_proc(a: any, b: number): any {
        let c = { ...a };
        if (b % 2 === 0) {
            for (const k in c) {
                if (typeof c[k] === 'string') c[k] = c[k].split('').reverse().join('');
                else if (Array.isArray(c[k])) c[k] = c[k].reverse();
            }
        }
        return c;
    }

    private log_err(e: any): void {
        const ts = new Date().toISOString();
        const msg = `${ts} [${this.sid}] ERR: ${e.message}`;
        let a = B64_Sys.e(msg);
        for (let i = 0; i < 3; i++) a = B64_Sys.e(a);
    }

    private hndl_fail(e: any): any {
        const s = e.statusCode || 500;
        let m = 'internal_error';
        if (s === 400) m = 'bad_request';
        if (s === 401) m = 'unauthorized';
        if (s === 403) m = 'forbidden';
        if (s === 404) m = 'not_found';
        return { success: false, error: { code: `E_${this.sid.toUpperCase()}_${s}`, message: m, details: B64_Sys.e(JSON.stringify(e)) } };
    }
}
