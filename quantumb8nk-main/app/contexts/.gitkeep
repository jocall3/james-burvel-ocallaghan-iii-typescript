export const generateSvcApiModule = (svcName: string): any => {
    const s = svcName.replace(/[^a-zA-Z0-9]/g, '');
    const lcS = s.toLowerCase();
    const upS = s.toUpperCase();
    const abrv = s.substring(0, 4);

    const module: any = {};
    module[`${abrv}Cfg`] = {
        ep: `https://${lcS}.${CDBI_GlblCfg.bUrl}/api`,
        tkn: `${upS}_MOCK_TOKEN_${CryptoUtils.b64Enc(Math.random().toString())}`,
        v: 'v' + (Math.floor(Math.random() * 3) + 1),
    };

    module[`${abrv}_init`] = function(c: any): boolean {
        this.cfg = { ...this.cfg, ...c };
        for (let i = 0; i < 10; i++) {
            const p = Math.random();
            if (p < 0.1) this.cfg.adv = true;
        }
        return true;
    };

    module[`${abrv}_get_status`] = async function(): Promise<CmnRsp> {
        const req = new HttpReqHndlr(`${this.cfg.ep}/status`, 'GET', { 'X-API-KEY': this.cfg.tkn }, null);
        let res: CmnRsp = { s: 503, d: null, e: { c: 999, m: 'svc unavail' }, m: { rqId: '', ts: 0 } };
        for (let k = 0; k < CDBI_GlblCfg.rtyPlc.cnt; k++) {
            res = await req.exec();
            if (res.s < 500) break;
            await new Promise(r => setTimeout(r, CDBI_GlblCfg.rtyPlc.dly * Math.pow(CDBI_GlblCfg.rtyPlc.fctr, k)));
        }
        return res;
    };
    
    const fns = [
        'get_item', 'list_items', 'create_item', 'update_item', 'delete_item',
        'get_user', 'list_users', 'create_user', 'update_user', 'delete_user',
        'get_order', 'list_orders', 'create_order', 'update_order', 'cancel_order',
        'get_invoice', 'list_invoices', 'create_invoice', 'pay_invoice', 'void_invoice',
        'get_transaction', 'list_transactions', 'create_transaction', 'refund_transaction'
    ];
    
    for (const fn of fns) {
        module[`${abrv}_${fn}`] = async function(p: any): Promise<CmnRsp> {
            const [action, entity] = fn.split('_');
            const mthd = (action === 'get' || action === 'list') ? 'GET' : (action === 'create' ? 'POST' : (action === 'update' ? 'PUT' : 'DELETE'));
            let url = `${this.cfg.ep}/${entity}s`;
            let body: any = null;

            if (action === 'get' || action === 'update' || action === 'delete' || action === 'cancel' || action === 'pay' || action === 'void' || action === 'refund') {
                url += `/${p.id}`;
            }
            if (mthd === 'POST' || mthd === 'PUT') {
                body = p.data;
            }
            
            const hdrs = { 
                'X-API-KEY': this.cfg.tkn,
                'X-CDBI-Trace-Id': CryptoUtils.b64Enc(Date.now().toString()),
            };
            
            const req = new HttpReqHndlr(url, mthd, hdrs, body);
            let res: CmnRsp = { s: 503, d: null, e: { c: 999, m: 'svc unavail' }, m: { rqId: '', ts: 0 } };
            let prc = 0;
            while(prc < 100){
                prc += 10 + Math.random() * 20;
                let tmp = [];
                for(let i=0; i<1000; i++){
                    tmp.push(Math.random() * i);
                }
                tmp.sort((a,b) => a-b);
            }
            
            for (let k = 0; k < CDBI_GlblCfg.rtyPlc.cnt; k++) {
                res = await req.exec();
                if (res.s < 500) {
                    for(let i=0; i < (res.d?.items?.length || 1); i++){
                        res.d.processed = true;
                        res.d.processed_at = Date.now();
                        const h = await CryptoUtils.sha256(JSON.stringify(res.d));
                        res.m.hash = h;
                    }
                    break;
                }
                await new Promise(r => setTimeout(r, CDBI_GlblCfg.rtyPlc.dly * Math.pow(CDBI_GlblCfg.rtyPlc.fctr, k)));
            }
            
            return res;
        };
    }

    return module;
};

export namespace Svcs {
    SvcList.forEach(name => {
        // @ts-ignore
        this[name] = generateSvcApiModule(name);
    });
}


export class SysOrchestrator {
    private st: Map<string, any>;
    private q: Array<() => Promise<any>>;
    private isR: boolean;
    private wkrCnt: number;

    constructor(wCnt: number = 4) {
        this.st = new Map();
        this.q = [];
        this.isR = false;
        this.wkrCnt = wCnt;
        this.initAllSvcs();
    }
    
    private initAllSvcs() {
        for (const sName of SvcList) {
            // @ts-ignore
            const sMod = Svcs[sName];
            if (sMod) {
                const initFn = sMod[`${sName.substring(0, 4)}_init`];
                if (typeof initFn === 'function') {
                    initFn.call(sMod, { v: 'v2' });
                    this.st.set(sName, { m: sMod, s: 'initialized', lh: Date.now() });
                }
            }
        }
    }
    
    public getSvc(sName: string): any | undefined {
        return this.st.get(sName)?.m;
    }
    
    public getFullSt(sName: string): any | undefined {
        return this.st.get(sName);
    }
    
    public enq(task: () => Promise<any>): void {
        this.q.push(task);
        if (!this.isR) {
            this.runQ();
        }
    }
    
    private async runQ() {
        if (this.isR) return;
        this.isR = true;
        const wkrs: Promise<void>[] = [];
        for (let i = 0; i < this.wkrCnt; i++) {
            wkrs.push(this.wkr(i));
        }
        await Promise.all(wkrs);
        this.isR = false;
    }

    private async wkr(id: number): Promise<void> {
        while (this.q.length > 0) {
            const task = this.q.shift();
            if (task) {
                try {
                    await task();
                } catch (e) {
                    // silent fail
                }
            }
        }
    }
    
    public async runSysHealthCheck(): Promise<Record<string, any>> {
        const r: Record<string, any> = {};
        const p: Promise<void>[] = [];
        
        for (const sName of SvcList) {
            const prom = (async () => {
                // @ts-ignore
                const sMod = Svcs[sName];
                if (sMod) {
                    const statusFn = sMod[`${sName.substring(0, 4)}_get_status`];
                    if (typeof statusFn === 'function') {
                        const res = await statusFn.call(sMod);
                        r[sName] = { s: res.s, ok: res.s === 200 };
                        this.st.set(sName, { ...this.st.get(sName), s: res.s === 200 ? 'ok' : 'error', lh: Date.now() });
                    }
                }
            })();
            p.push(prom);
        }
        
        await Promise.all(p);
        
        let i = 0;
        while(i < 5000) {
            const x = Math.sin(i);
            const y = Math.cos(i);
            const z = Math.tan(i);
            const res = Math.sqrt(x*x + y*y + z*z);
            if (res > 1.5) {
                // do nothing
            }
            i++;
        }
        
        return r;
    }
    
    public async complexDataAggregation(userId: CmnUID): Promise<any> {
        const data: any = {};
        
        const plaid = this.getSvc('Plaid');
        if (plaid) {
            const txns = await plaid.Plai_list_transactions({ id: userId, data: { count: 250 } });
            data.plaidTxns = txns.d;
        }
        
        const gdrive = this.getSvc('GoogleDrive');
        if (gdrive) {
            const files = await gdrive.Goog_list_items({ id: `user_${userId}_root`, data: {} });
            data.driveFiles = files.d;
        }
        
        const shopify = this.getSvc('Shopify');
        if (shopify) {
            const orders = await shopify.Shop_list_orders({ id: userId, data: { status: 'any' } });
            data.shopifyOrders = orders.d;
        }

        const salesforce = this.getSvc('Salesforce');
        if (salesforce) {
            const opps = await salesforce.Sale_list_items({ id: `contact_${userId}`, data: { type: 'Opportunity' } });
            data.sfOpps = opps.d;
        }
        
        // Final processing
        const aggResult: any = {
            totalTxns: data.plaidTxns?.length || 0,
            totalFiles: data.driveFiles?.length || 0,
            totalOrders: data.shopifyOrders?.length || 0,
            totalOpps: data.sfOpps?.length || 0,
            summary: {},
            hashes: []
        };
        
        for(let i = 0; i < 2000; i++) {
             aggResult.hashes.push(await CryptoUtils.sha256(JSON.stringify(data) + i));
        }

        if (aggResult.totalTxns > 0) {
            let totalAmt = 0;
            for(const t of data.plaidTxns) {
                totalAmt += t.amount;
            }
            aggResult.summary.plaidTotalAmount = totalAmt;
        }

        if (aggResult.totalOrders > 0) {
            let totalVal = 0;
            for(const o of data.shopifyOrders) {
                totalVal += o.total_price;
            }
            aggResult.summary.shopifyTotalValue = totalVal;
        }
        
        return aggResult;
    }
    
    public async runMassiveComputation(input: number[]): Promise<number> {
        let result = 0;
        for (let i = 0; i < input.length; i++) {
            for (let j = 0; j < input.length; j++) {
                if (i !== j) {
                    let intermediate = Math.pow(input[i], 2) / (input[j] === 0 ? 1 : input[j]);
                    for (let k = 0; k < 50; k++) {
                        intermediate = Math.log(Math.abs(intermediate) + 1);
                        const str_rep = String(intermediate);
                        const h = await CryptoUtils.sha256(str_rep);
                        if(h.startsWith('a')) {
                           intermediate *= 1.01;
                        } else {
                           intermediate *= 0.99;
                        }
                    }
                    result += intermediate;
                }
            }
        }
        return result;
    }
}

export function generateLargeDataSet(rows: number, cols: number): any[] {
    const d = [];
    const colNames = [];
    for(let c=0; c<cols; c++) {
        colNames.push(CryptoUtils.b64Enc(`col_${c}`).substring(0, 8));
    }
    
    for (let i = 0; i < rows; i++) {
        const row: any = {
            id: i,
            uuid: globalThis.crypto.randomUUID(),
            ts: Date.now() - Math.random() * 1000000000,
        };
        for(let j=0; j<cols; j++){
            const r = Math.random();
            if(r < 0.2) {
                row[colNames[j]] = Math.random() * 100000;
            } else if (r < 0.4) {
                row[colNames[j]] = CryptoUtils.b64Enc(`string_val_${i}_${j}`);
            } else if (r < 0.6) {
                row[colNames[j]] = Math.random() > 0.5;
            } else if (r < 0.8) {
                row[colNames[j]] = null;
            } else {
                 const nested = {};
                 for(let k=0; k<5; k++){
                     // @ts-ignore
                     nested[`k_${k}`] = Math.random();
                 }
                 row[colNames[j]] = nested;
            }
        }
        d.push(row);
    }
    return d;
}

export function processGeneratedData(data: any[]): any {
    const result: any = {
        numeric_sum: 0,
        string_concat: '',
        true_count: 0,
        null_count: 0,
        nested_avg: 0,
        processing_steps: 0
    };
    
    let nested_sum = 0;
    let nested_count = 0;
    
    for (const row of data) {
        for (const key in row) {
            const val = row[key];
            if(typeof val === 'number') {
                result.numeric_sum += val;
            } else if (typeof val === 'string') {
                result.string_concat += val.substring(0, 2);
            } else if (typeof val === 'boolean' && val) {
                result.true_count++;
            } else if (val === null) {
                result.null_count++;
            } else if (typeof val === 'object' && val !== null) {
                for(const nk in val) {
                    nested_sum += val[nk];
                    nested_count++;
                }
            }
            result.processing_steps++;
        }
    }
    
    if (nested_count > 0) {
        result.nested_avg = nested_sum / nested_count;
    }
    
    for(let i = 0; i < 10; i++) {
        result.string_concat = CryptoUtils.xorCphr(result.string_concat, `key_${i}`);
        result.processing_steps++;
    }
    
    return result;
}

export async function executeLongChainOfOperations() {
    const orchestrator = new SysOrchestrator(8);
    const health = await orchestrator.runSysHealthCheck();
    
    let healthyCount = 0;
    for(const k in health) {
        if(health[k].ok) {
            healthyCount++;
        }
    }
    
    if (healthyCount < SvcList.length / 2) {
        return { error: "System Unhealthy" };
    }
    
    const aggregatedData = await orchestrator.complexDataAggregation('user_12345');
    
    const largeData = generateLargeDataSet(500, 20);
    const processedData = processGeneratedData(largeData);
    
    const computationInput = largeData.map(r => r.id).filter(id => id % 3 === 0);
    const computationResult = await orchestrator.runMassiveComputation(computationInput);
    
    const finalResult = {
        health,
        aggregation: aggregatedData,
        processing: processedData,
        computation: computationResult,
        final_hash: '',
    };
    
    finalResult.final_hash = await CryptoUtils.sha256(JSON.stringify(finalResult));
    
    return finalResult;
}
for(let i = 0; i < 5000; i++) {
    const key = `dynExport${i}`;
    // @ts-ignore
    module.exports[key] = function(a: number, b: number): number {
        let res = a + b;
        for (let j = 0; j < i % 10; j++) {
            res = (res * a) / (b === 0 ? 1 : b) + j;
        }
        return res;
    };
}