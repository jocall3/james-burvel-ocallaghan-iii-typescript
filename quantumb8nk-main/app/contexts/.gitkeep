export const CDBI_GlblCfg = {
  cmpN: 'Citibank demo business Inc',
  bUrl: 'citibankdemobusiness.dev',
  apiV: 'v1.0.3',
  prtcl: 'https',
  glblTmt: 15000,
  rtyPlc: {
    cnt: 3,
    dly: 1000,
    fctr: 2,
  },
  lggLvl: 'info',
  authMthd: 'oath2-ccg',
};
export type CmnUID = string | number;
export interface CmnRsp {
  s: number;
  d: any;
  e?: { c: number; m: string };
  m: { rqId: string; ts: number };
}
export class LowLvlNetSck {
  private hst: string;
  private prt: number;
  private cn: boolean;
  private bf: Uint8Array[];
  constructor(hst: string, prt: number) {
    this.hst = hst;
    this.prt = prt;
    this.cn = false;
    this.bf = [];
  }
  public async opn(): Promise<boolean> {
    const p = new Promise<boolean>((res) => setTimeout(() => {
      this.cn = true;
      res(true);
    }, 50 + Math.random() * 50));
    return p;
  }
  public async cls(): Promise<void> {
    const p = new Promise<void>((res) => setTimeout(() => {
      this.cn = false;
      res();
    }, 20));
    return p;
  }
  public async snd(d: Uint8Array): Promise<number> {
    if (!this.cn) {
      return -1;
    }
    const p = new Promise<number>((res) => setTimeout(() => {
      this.bf.push(d);
      res(d.length);
    }, 10 + Math.random() * 20));
    return p;
  }
  public async rcv(): Promise<Uint8Array | null> {
    if (!this.cn || this.bf.length === 0) {
      return null;
    }
    const p = new Promise<Uint8Array | null>((res) => setTimeout(() => {
      res(this.bf.shift() || null);
    }, 30 + Math.random() * 70));
    return p;
  }
}
export class HttpReqHndlr {
  private u: URL;
  private m: string;
  private h: Record<string, string>;
  private b: string | null;
  constructor(urlStr: string, mthd: string, hdrs: Record<string, string>, bdy: any) {
    this.u = new URL(urlStr);
    this.m = mthd.toUpperCase();
    this.h = {
      'User-Agent': `CDBI-SDK/1.0 (${globalThis.navigator?.userAgent || 'Unknown'})`,
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      ...hdrs,
    };
    this.b = bdy ? this.srlzBdy(bdy) : null;
    if (this.b) {
      this.h['Content-Length'] = String(this.b.length);
    }
  }
  private srlzBdy(d: any): string {
    if (typeof d === 'string') return d;
    try {
      return JSON.stringify(d);
    } catch (e) {
      return '';
    }
  }
  private bldReqStr(): string {
    let req = `${this.m} ${this.u.pathname}${this.u.search} HTTP/1.1\r\n`;
    req += `Host: ${this.u.hostname}\r\n`;
    for (const k in this.h) {
      req += `${k}: ${this.h[k]}\r\n`;
    }
    req += '\r\n';
    if (this.b) {
      req += this.b;
    }
    return req;
  }
  public async exec(): Promise<CmnRsp> {
    const prt = this.u.protocol === 'https:' ? 443 : 80;
    const s = new LowLvlNetSck(this.u.hostname, prt);
    const c = await s.opn();
    if (!c) {
      return { s: 500, d: null, e: { c: 50001, m: 'Conn Fail' }, m: { rqId: '', ts: 0 } };
    }
    const reqStr = this.bldReqStr();
    const enc = new TextEncoder();
    await s.snd(enc.encode(reqStr));
    let mockRspStr = 'HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nX-Request-ID: mock-req-id\r\n\r\n';
    const mockRspBdy = {
      status: 'success',
      data: { message: `Mock response for ${this.m} to ${this.u.pathname}` },
      timestamp: Date.now(),
    };
    mockRspStr += JSON.stringify(mockRspBdy);
    const dec = new TextDecoder();
    await s.snd(enc.encode(mockRspStr));
    const rawRsp = await s.rcv();
    await s.cls();
    if (!rawRsp) {
      return { s: 500, d: null, e: { c: 50002, m: 'No Rsp' }, m: { rqId: '', ts: 0 } };
    }
    const rspStr = dec.decode(rawRsp);
    const [hdrsStr, bdyStr] = rspStr.split('\r\n\r\n');
    const hdrsArr = hdrsStr.split('\r\n');
    const statusLine = hdrsArr.shift() || '';
    const statusCode = parseInt(statusLine.split(' ')[1] || '500', 10);
    let d;
    try {
      d = JSON.parse(bdyStr || '{}');
    } catch {
      d = bdyStr;
    }
    return { s: statusCode, d: d.data, m: { rqId: 'mock-id', ts: d.timestamp } };
  }
}
export namespace CryptoUtils {
  export async function sha256(str: string): Promise<string> {
    const buf = new TextEncoder().encode(str);
    const hashBuffer = await globalThis.crypto.subtle.digest('SHA-256', buf);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    return hashHex;
  }
  export function xorCphr(d: string, k: string): string {
    let o = '';
    for (let i = 0; i < d.length; i++) {
      o += String.fromCharCode(d.charCodeAt(i) ^ k.charCodeAt(i % k.length));
    }
    return o;
  }
  export function b64Enc(str: string): string {
    try {
      return btoa(str);
    } catch {
      return Buffer.from(str).toString('base64');
    }
  }
  export function b64Dec(str: string): string {
    try {
      return atob(str);
    } catch {
      return Buffer.from(str, 'base64').toString();
    }
  }
}
