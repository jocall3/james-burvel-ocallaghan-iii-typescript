export const accountService = {
  getAccountOverview: (currency?: CurrencyEnum) => {
    const { apolloClient, isAuthenticated } = useAuth();
    return useQuery<AccountCurrencyMetricsData, AccountCurrencyMetricsVariables>(GET_ACCOUNT_CURRENCY_METRICS, {
      variables: { currency },
      client: apolloClient || undefined,
      skip: !isAuthenticated || !apolloClient,
    });
  },
  getAccounts: () => {
    const { apolloClient, isAuthenticated } = useAuth();
    return useQuery<{ accounts: Account[] }>(GET_ALL_ACCOUNTS, {
      client: apolloClient || undefined,
      skip: !isAuthenticated || !apolloClient,
    });
  },
  getTransactions: (accountId: string, startDate?: string, endDate?: string, type?: TransactionTypeEnum, limit: number = TRANSACTION_PAGE_SIZE, offset: number = 0) => {
    const { apolloClient, isAuthenticated } = useAuth();
    return useQuery<{ transactions: Transaction[] }>(GET_TRANSACTIONS_BY_ACCOUNT, {
      variables: { accountId, startDate, endDate, type, limit, offset },
      client: apolloClient || undefined,
      skip: !isAuthenticated || !apolloClient || !accountId,
      fetchPolicy: 'network-only', // Ensure fresh data for transactions
    });
  },
  transferFunds: () => {
    const { apolloClient, isAuthenticated } = useAuth();
    const [mutate, { loading, error, data }] = useMutation(CREATE_FUNDS_TRANSFER, {
      client: apolloClient || undefined,
      skip: !isAuthenticated || !apolloClient,
    });
    return { transfer: mutate, loading, error, data };
  },
  getBeneficiaries: () => {
    const { apolloClient, isAuthenticated } = useAuth();
    return useQuery<{ beneficiaries: Beneficiary[] }>(GET_BENEFICIARIES, {
      client: apolloClient || undefined,
      skip: !isAuthenticated || !apolloClient,
    });
  },
  addBeneficiary: () => {
    const { apolloClient, isAuthenticated } = useAuth();
    const [mutate, { loading, error, data }] = useMutation(ADD_BENEFICIARY, {
      client: apolloClient || undefined,
      skip: !isAuthenticated || !apolloClient,
      refetchQueries: [{ query: GET_BENEFICIARIES }],
    });
    return { add: mutate, loading, error, data };
  },
};

