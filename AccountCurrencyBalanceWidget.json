// --- GraphQL Client Setup ---
const createApolloClient = (token: string | null) => {
  return new ApolloClient({
    uri: API_BASE_URL,
    cache: new InMemoryCache(),
    headers: {
      authorization: token ? `Bearer ${token}` : '',
    },
  });
};

// --- Utility Functions ---

const formatCurrency = (amount: number, currency: CurrencyEnum, locale: string = DEFAULT_LOCALE): string => {
  try {
    return new Intl.NumberFormat(locale, {
      style: 'currency',
      currency: currency,
    }).format(amount);
  } catch (error) {
    console.error('Error formatting currency:', error);
    return `${currency} ${amount.toFixed(2)}`; // Fallback
  }
};

const formatDate = (dateString: string, formatStr: string = 'PP', locale: string = DEFAULT_LOCALE): string => {
  try {
    const dateLocale = {
      'en-US': enUS,
      'es': es,
      'fr': fr,
      // Add more locales as needed
    }[locale] || enUS;
    return format(parseISO(dateString), formatStr, { locale: dateLocale });
  } catch (error) {
    console.error('Error formatting date:', error);
    return dateString; // Fallback
  }
};

const generateUUID = (): string => {
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
    const r = (Math.random() * 16) | 0;
    const v = c === 'x' ? r : (r & 0x3) | 0x8;
    return v.toString(16);
  });
};

const debounce = <T extends (...args: any[]) => void>(func: T, delay: number) => {
  let timeout: NodeJS.Timeout;
  return function (this: ThisParameterType<T>, ...args: Parameters<T>) {
    const context = this;
    clearTimeout(timeout);
    timeout = setTimeout(() => func.apply(context, args), delay);
  };
};

const getLocaleDateFnsObject = (localeString: string) => {
  switch (localeString) {
    case 'en-US':
      return enUS;
    case 'es':
      return es;
    case 'fr':
      return fr;
    default:
      return enUS;
  }
};

// --- React Contexts ---

interface AuthContextType {
  isAuthenticated: boolean;
  user: User | null;
  loading: boolean;
  login: (token: string, refreshToken: string, user: User) => Promise<void>;
  logout: () => void;
  refreshToken: () => Promise<boolean>;
  updateUser: (newUser: Partial<User>) => void;
  apolloClient: ApolloClient<any> | null;
}

const AuthContext = createContext<AuthContextType | undefined>(undefined);

export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [isAuthenticated, setIsAuthenticated] = useState<boolean>(false);
  const [user, setUser] = useState<User | null>(null);
  const [loading, setLoading] = useState<boolean>(true);
  const [authToken, setAuthToken] = useState<string | null>(null);
  const [currentApolloClient, setCurrentApolloClient] = useState<ApolloClient<any> | null>(null);
  const sessionTimeoutRef = useRef<NodeJS.Timeout | null>(null);

  const resetSessionTimeout = useCallback(() => {
    if (sessionTimeoutRef.current) {
      clearTimeout(sessionTimeoutRef.current);
    }
    sessionTimeoutRef.current = setTimeout(() => {
      console.warn('Session timed out. Logging out.');
      logout();
    }, SESSION_TIMEOUT_MS);
  }, []);

  useEffect(() => {
    const storedToken = localStorage.getItem(AUTH_TOKEN_STORAGE_KEY);
    const storedRefreshToken = localStorage.getItem(REFRESH_TOKEN_STORAGE_KEY);

    if (storedToken && storedRefreshToken) {
      setAuthToken(storedToken);
      setIsAuthenticated(true);
      setCurrentApolloClient(createApolloClient(storedToken));
      // In a real app, you'd fetch user profile here to hydrate the `user` state
      // For now, we'll assume a successful login has provided user details.
      // Or, this could be done via a dedicated `fetchUserProfile` service.
      setLoading(false);
      resetSessionTimeout();
    } else {
      setLoading(false);
    }

    const handleActivity = () => resetSessionTimeout();
    window.addEventListener('mousemove', handleActivity);
    window.addEventListener('keydown', handleActivity);

    return () => {
      if (sessionTimeoutRef.current) {
        clearTimeout(sessionTimeoutRef.current);
      }
      window.removeEventListener('mousemove', handleActivity);
      window.removeEventListener('keydown', handleActivity);
    };
  }, [resetSessionTimeout]);

  const login = useCallback(async (token: string, refreshToken: string, userData: User) => {
    localStorage.setItem(AUTH_TOKEN_STORAGE_KEY, token);
    localStorage.setItem(REFRESH_TOKEN_STORAGE_KEY, refreshToken);
    setAuthToken(token);
    setIsAuthenticated(true);
    setUser(userData);
    setCurrentApolloClient(createApolloClient(token));
    resetSessionTimeout();
  }, [resetSessionTimeout]);

  const logout = useCallback(() => {
    localStorage.removeItem(AUTH_TOKEN_STORAGE_KEY);
    localStorage.removeItem(REFRESH_TOKEN_STORAGE_KEY);
    setAuthToken(null);
    setIsAuthenticated(false);
    setUser(null);
    setCurrentApolloClient(null);
    if (sessionTimeoutRef.current) {
      clearTimeout(sessionTimeoutRef.current);
    }
    console.log('User logged out.');
    // Redirect to login page or home
    window.location.href = '/login';
  }, []);

  const refreshToken = useCallback(async (): Promise<boolean> => {
    const currentRefreshToken = localStorage.getItem(REFRESH_TOKEN_STORAGE_KEY);
    if (!currentRefreshToken) {
      logout();
      return false;
    }

    try {
      // In a real application, this would be an API call to refresh the token
      // For this demo, we'll simulate a refresh
      console.log('Attempting to refresh token...');
      const response = await fetch(`${API_BASE_URL}/refresh-token`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ refreshToken: currentRefreshToken }),
      });

      if (!response.ok) {
        throw new Error('Failed to refresh token');
      }

      const { accessToken: newAccessToken, refreshToken: newRefreshToken, user: newUserData } = await response.json();
      localStorage.setItem(AUTH_TOKEN_STORAGE_KEY, newAccessToken);
      localStorage.setItem(REFRESH_TOKEN_STORAGE_KEY, newRefreshToken);
      setAuthToken(newAccessToken);
      setUser(newUserData); // Update user data if it comes with refresh
      setCurrentApolloClient(createApolloClient(newAccessToken));
      setIsAuthenticated(true);
      resetSessionTimeout();
      console.log('Token refreshed successfully.');
      return true;
    } catch (error) {
      console.error('Token refresh failed:', error);
      logout();
      return false;
    }
  }, [logout, resetSessionTimeout]);

  const updateUser = useCallback((newUser: Partial<User>) => {
    setUser(prevUser => (prevUser ? { ...prevUser, ...newUser } : null));
  }, []);

  const value = useMemo(
    () => ({
      isAuthenticated,
      user,
      loading,
      login,
      logout,
      refreshToken,
      updateUser,
      apolloClient: currentApolloClient,
    }),
    [isAuthenticated, user, loading, login, logout, refreshToken, updateUser, currentApolloClient]
  );

  if (loading) {
    return <LoadingSpinner message="Authenticating..." />;
  }

  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
};

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (context === undefined) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
};

interface ThemeContextType {
  themeMode: ThemeMode;
  toggleTheme: () => void;
}

const ThemeContext = createContext<ThemeContextType | undefined>(undefined);

export const ThemeProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [themeMode, setThemeMode] = useState<ThemeMode>(() => {
    const storedTheme = localStorage.getItem(THEME_STORAGE_KEY);
    return (storedTheme as ThemeMode) || ThemeMode.LIGHT;
  });

  useEffect(() => {
    document.documentElement.setAttribute('data-theme', themeMode);
    localStorage.setItem(THEME_STORAGE_KEY, themeMode);
  }, [themeMode]);

  const toggleTheme = useCallback(() => {
    setThemeMode(prevMode => (prevMode === ThemeMode.LIGHT ? ThemeMode.DARK : ThemeMode.LIGHT));
  }, []);

  const value = useMemo(() => ({ themeMode, toggleTheme }), [themeMode, toggleTheme]);

  return <ThemeContext.Provider value={value}>{children}</ThemeContext.Provider>;
};

export const useTheme = () => {
  const context = useContext(ThemeContext);
  if (context === undefined) {
    throw new Error('useTheme must be used within a ThemeProvider');
  }
  return context;
};

interface NotificationContextType {
  notifications: Notification[];
  addNotification: (notification: Omit<Notification, 'id' | 'read' | 'timestamp'>) => void;
  markNotificationRead: (id: string) => void;
  clearNotification: (id: string) => void;
  clearAllNotifications: () => void;
}

const NotificationContext = createContext<NotificationContextType | undefined>(undefined);

export const NotificationProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [notifications, setNotifications] = useState<Notification[]>([]);

  const addNotification = useCallback((newNotification: Omit<Notification, 'id' | 'read' | 'timestamp'>) => {
    setNotifications(prev => [
      ...prev,
      {
        ...newNotification,
        id: generateUUID(),
        read: false,
        timestamp: new Date().toISOString(),
      },
    ]);
  }, []);

  const markNotificationRead = useCallback((id: string) => {
    setNotifications(prev => prev.map(n => (n.id === id ? { ...n, read: true } : n)));
  }, []);

  const clearNotification = useCallback((id: string) => {
    setNotifications(prev => prev.filter(n => n.id !== id));
  }, []);

  const clearAllNotifications = useCallback(() => {
    setNotifications([]);
  }, []);

  const value = useMemo(
    () => ({
      notifications,
      addNotification,
      markNotificationRead,
      clearNotification,
      clearAllNotifications,
    }),
    [notifications, addNotification, markNotificationRead, clearNotification, clearAllNotifications]
  );

  return <NotificationContext.Provider value={value}>{children}</NotificationContext.Provider>;
};

export const useNotification = () => {
  const context = useContext(NotificationContext);
  if (context === undefined) {
    throw new Error('useNotification must be used within a NotificationProvider');
  }
  return context;
};

interface LocaleContextType {
  locale: string;
  setLocale: (newLocale: string) => void;
  dateFnsLocale: Locale;
}

const LocaleContext = createContext<LocaleContextType | undefined>(undefined);

export const LocaleProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [locale, setLocale] = useState<string>(DEFAULT_LOCALE);
  const dateFnsLocale = useMemo(() => getLocaleDateFnsObject(locale), [locale]);

  const value = useMemo(() => ({ locale, setLocale, dateFnsLocale }), [locale, setLocale, dateFnsLocale]);

  return <LocaleContext.Provider value={value}>{children}</LocaleContext.Provider>;
};

export const useLocale = () => {
  const context = useContext(LocaleContext);
  if (context === undefined) {
    throw new Error('useLocale must be used within a LocaleProvider');
  }
  return context;
};

// --- Custom Hooks ---

export const useUserProfile = () => {
  const { apolloClient, isAuthenticated, updateUser: updateAuthUser } = useAuth();
  const { loading, error, data, refetch } = useQuery<
    { userProfile: User },
    {}
  >(GET_USER_PROFILE, {
    client: apolloClient || undefined,
    skip: !isAuthenticated || !apolloClient,
    onCompleted: (data) => {
      if (data?.userProfile) {
        updateAuthUser(data.userProfile);
      }
    }
  });

  const [updateUserMutation, { loading: updateLoading, error: updateError }] = useMutation(UPDATE_USER_PROFILE, {
    client: apolloClient || undefined,
    onCompleted: (data) => {
      if (data?.updateUserProfile) {
        updateAuthUser(data.updateUserProfile);
        refetch(); // Re-fetch to ensure consistency
      }
    }
  });

  const updateProfile = useCallback(async (updates: Partial<User>) => {
    try {
      await updateUserMutation({ variables: updates });
      return { success: true };
    } catch (e) {
      console.error('Error updating profile:', e);
      return { success: false, error: (e as Error).message };
    }
  }, [updateUserMutation]);

  return {
    userProfile: data?.userProfile,
    loading: loading || updateLoading,
    error: error || updateError,
    refetchUserProfile: refetch,
    updateProfile,
  };
};

