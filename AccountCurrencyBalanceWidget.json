  const { setStatus: setMfaStatusMutation, loading: mfaLoading, error: mfaError } = securityService.setMfaStatus();

  const handleToggleMFA = useCallback(async () => {
    if (!user) return;
    try {
      await setMfaStatusMutation({ variables: { enable: !user.mfaEnabled } });
      addNotification({
        title: 'MFA Status Updated',
        message: `Multi-Factor Authentication ${!user.mfaEnabled ? 'enabled' : 'disabled'} successfully.`,
        severity: NotificationSeverity.SUCCESS,
      });
      refetchUserProfile(); // Ensure auth context user is updated
    } catch (e) {
      console.error('Failed to toggle MFA:', e);
      addNotification({
        title: 'MFA Update Failed',
        message: `Error: ${(e as Error).message}`,
        severity: NotificationSeverity.ERROR,
      });