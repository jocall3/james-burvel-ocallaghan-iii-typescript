export const TransactionHistoryWidget: React.FC<{ accountId?: string; limit?: number }> = ({ accountId, limit = 5 }) => {
  const { locale } = useLocale();
  const { addNotification } = useNotification();
  const { data: accountsData, loading: accountsLoading, error: accountsError } = accountService.getAccounts();
  const [selectedAccountId, setSelectedAccountId] = useState<string | undefined>(accountId);
  const [page, setPage] = useState(1);
  const offset = (page - 1) * TRANSACTION_PAGE_SIZE;

  // Use selectedAccountId first, then fallback to prop, then first account
  useEffect(() => {
    if (!selectedAccountId && accountId) {
      setSelectedAccountId(accountId);
    } else if (!selectedAccountId && accountsData?.accounts && accountsData.accounts.length > 0) {
      setSelectedAccountId(accountsData.accounts[0].id);
    }
  }, [accountId, accountsData, selectedAccountId]);


  const { data: transactionsData, loading: transactionsLoading, error: transactionsError, refetch } = accountService.getTransactions(
    selectedAccountId || '',
    undefined, undefined, undefined, limit, offset
  );

  const transactions = transactionsData?.transactions || [];

  useEffect(() => {
    if (transactionsError) {
      addNotification({
        title: 'Transaction Error',
        message: `Failed to load transactions: ${transactionsError.message}`,
        severity: NotificationSeverity.ERROR,
      });
    }
  }, [transactionsError, addNotification]);

  const transactionHeaders = useMemo(() => [
    { key: 'date', label: 'Date', render: (t: Transaction) => formatDate(t.date, 'P', locale) },
    { key: 'description', label: 'Description' },
    { key: 'type', label: 'Type' },
    { key: 'amount', label: 'Amount', render: (t: Transaction) => formatCurrency(t.amount, t.currency, locale) },
    { key: 'status', label: 'Status' },
  ], [locale]);

  const handleAccountChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    setSelectedAccountId(e.target.value);
    setPage(1); // Reset page on account change
  };

  const accountOptions = useMemo(() => accountsData?.accounts.map(acc => ({
    value: acc.id,
    label: `${acc.name} (${acc.accountNumber}) - ${acc.currency}`,
  })) || [], [accountsData]);

  if (accountsLoading || transactionsLoading) return <Card title="Transaction History"><LoadingSpinner /></Card>;
  if (accountsError) return <Card title="Transaction History"><Alert severity="error" message={`Accounts Error: ${accountsError.message}`} /></Card>;

  return (
    <Card title="Recent Transactions">
      <div className="mb-4">
        <Select
          label="Select Account"
          options={accountOptions}
          value={selectedAccountId || ''}
          onChange={handleAccountChange}
          disabled={accountsLoading}
        />
      </div>
      {transactions.length === 0 ? (
        <p className="text-gray-500 dark:text-gray-400">No recent transactions for this account.</p>
      ) : (
        <>
          <Table headers={transactionHeaders} data={transactions} />
          {/* Pagination for full page, not for widget (widget typically limits records) */}
          {/* <Pagination currentPage={page} totalPages={1} onPageChange={() => {}} /> */}
          <div className="mt-4 text-center">
            <Link to={`/accounts/${selectedAccountId}/transactions`} className="text-blue-600 hover:underline dark:text-blue-400">
              View All Transactions
            </Link>
          </div>
        </>
      )}
    </Card>
  );
};


export const FundsTransferWidget: React.FC = () => {
  const { locale } = useLocale();
  const { addNotification } = useNotification();
  const { data: accountsData, loading: accountsLoading, error: accountsError } = accountService.getAccounts();
  const { data: beneficiariesData, loading: beneficiariesLoading, error: beneficiariesError, refetch: refetchBeneficiaries } = accountService.getBeneficiaries();
  const { transfer, loading: transferLoading, error: transferError, data: transferResult } = accountService.transferFunds();

  const [fromAccount, setFromAccount] = useState<string>('');
  const [toBeneficiary, setToBeneficiary] = useState<string>(''); // Can be beneficiary ID or 'new'
  const [toExternalAccountNumber, setToExternalAccountNumber] = useState<string>('');
  const [toExternalBankName, setToExternalBankName] = useState<string>('');
  const [amount, setAmount] = useState<string>('');
  const [currency, setCurrency] = useState<CurrencyEnum>(CurrencyEnum.USD);
  const [description, setDescription] = useState<string>('');
  const [isScheduled, setIsScheduled] = useState<boolean>(false);
  const [scheduleDate, setScheduleDate] = useState<string>(format(new Date(), 'yyyy-MM-dd'));
  const [isRecurring, setIsRecurring] = useState<boolean>(false);
  const [frequency, setFrequency] = useState<'ONE_TIME' | 'DAILY' | 'WEEKLY' | 'MONTHLY' | 'QUARTERLY' | 'ANNUALLY'>('ONE_TIME');
  const [endDate, setEndDate] = useState<string>('');
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [showAddBeneficiaryModal, setShowAddBeneficiaryModal] = useState(false);

  const availableAccounts = useMemo(() => accountsData?.accounts || [], [accountsData]);
  const beneficiaries = useMemo(() => beneficiariesData?.beneficiaries || [], [beneficiariesData]);

  useEffect(() => {
    if (availableAccounts.length > 0 && !fromAccount) {
      setFromAccount(availableAccounts[0].id);
      setCurrency(availableAccounts[0].currency); // Default currency to sending account
    }
  }, [availableAccounts, fromAccount]);

  useEffect(() => {
    if (transferResult) {
      addNotification({
        title: 'Transfer initiated',
        message: `Transfer ID: ${transferResult.createFundsTransfer.id}, Status: ${transferResult.createFundsTransfer.status}`,
        severity: transferResult.createFundsTransfer.status === 'SUCCESS' ? NotificationSeverity.SUCCESS : NotificationSeverity.INFO,
      });
      // Clear form
      setAmount('');
      setDescription('');
      setIsScheduled(false);
      setIsRecurring(false);
      setScheduleDate(format(new Date(), 'yyyy-MM-dd'));
      setEndDate('');
      setErrors({});
      // Optionally refetch account balances
    }
    if (transferError) {
      addNotification({
        title: 'Transfer Failed',
        message: `Error: ${transferError.message}`,
        severity: NotificationSeverity.ERROR,
      });
    }
  }, [transferResult, transferError, addNotification]);

  const validateForm = useCallback(() => {
    const newErrors: Record<string, string> = {};
    const parsedAmount = parseFloat(amount);
    if (!fromAccount) newErrors.fromAccount = 'Please select a source account.';
    if (!toBeneficiary && !toExternalAccountNumber) newErrors.toBeneficiary = 'Please select a beneficiary or enter external account details.';
    if (toBeneficiary === 'new' && (!toExternalAccountNumber || !toExternalBankName)) {
      if (!toExternalAccountNumber) newErrors.toExternalAccountNumber = 'External account number is required.';
      if (!toExternalBankName) newErrors.toExternalBankName = 'External bank name is required.';
    }
    if (isNaN(parsedAmount) || parsedAmount <= 0) newErrors.amount = 'Amount must be a positive number.';
    if (!currency) newErrors.currency = 'Currency is required.';
    if (isScheduled && !scheduleDate) newErrors.scheduleDate = 'Schedule date is required.';
    if (isScheduled && isBefore(parseISO(scheduleDate), new Date())) newErrors.scheduleDate = 'Schedule date cannot be in the past.';
    if (isRecurring && !frequency) newErrors.frequency = 'Frequency is required for recurring payments.';
    if (isRecurring && endDate && isBefore(parseISO(endDate), parseISO(scheduleDate))) newErrors.endDate = 'End date cannot be before schedule date.';

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  }, [amount, fromAccount, toBeneficiary, toExternalAccountNumber, toExternalBankName, currency, isScheduled, scheduleDate, isRecurring, frequency, endDate]);

  const handleSubmit = useCallback(async (e: React.FormEvent) => {
    e.preventDefault();
    if (!validateForm()) return;

    const parsedAmount = parseFloat(amount);
    const selectedFromAccount = availableAccounts.find(acc => acc.id === fromAccount);

    if (!selectedFromAccount) {
      addNotification({ title: 'Error', message: 'Selected source account not found.', severity: NotificationSeverity.ERROR });
      return;
    }

    if (parsedAmount > selectedFromAccount.availableBalance) {
      addNotification({ title: 'Insufficient Funds', message: 'You do not have enough funds in the selected account.', severity: NotificationSeverity.WARNING });
      return;
    }

    const variables: any = {
      fromAccountId: fromAccount,
      amount: parsedAmount,
      currency: currency,
      description: description || `Transfer from ${selectedFromAccount.name}`,
    };

    if (toBeneficiary && toBeneficiary !== 'new') {
      variables.toBeneficiaryId = toBeneficiary;
    } else if (toExternalAccountNumber && toExternalBankName) {
      variables.toExternalAccount = {
        accountNumber: toExternalAccountNumber,
        bankName: toExternalBankName,
        // Assuming SWIFT/IBAN for external are part of Beneficiary or can be added on the fly
      };
    } else {
      addNotification({ title: 'Transfer Error', message: 'Recipient details incomplete.', severity: NotificationSeverity.ERROR });
      return;
    }

    if (isScheduled) {
      variables.scheduledDate = scheduleDate;
      if (isRecurring) {
        variables.isRecurring = true;
        variables.frequency = frequency;
        if (endDate) variables.endDate = endDate;
      }
    }

    try {
      await transfer({ variables });
    } catch (e) {
      console.error('Funds transfer failed:', e);
      // Error handled by useEffect
    }
  }, [validateForm, amount, availableAccounts, fromAccount, addNotification, toBeneficiary, toExternalAccountNumber, toExternalBankName, currency, description, isScheduled, scheduleDate, isRecurring, frequency, endDate, transfer]);


  const accountOptions = useMemo(() => availableAccounts.map(acc => ({
    value: acc.id,
    label: `${acc.name} (${acc.accountNumber}) - ${formatCurrency(acc.availableBalance, acc.currency, locale)}`,
  })), [availableAccounts, locale]);

  const beneficiaryOptions = useMemo(() => [
    { value: '', label: 'Select Beneficiary' },
    ...beneficiaries.map(b => ({
      value: b.id,
      label: `${b.name} (${b.accountNumber}) - ${b.bankName}`,
    })),
    { value: 'new', label: 'Transfer to a new external account' },
  ], [beneficiaries]);

  const currencyOptions = useMemo(() => Object.values(CurrencyEnum).map(c => ({ value: c, label: c })), []);

  const frequencyOptions = useMemo(() => [
    { value: 'ONE_TIME', label: 'One Time' },
    { value: 'DAILY', label: 'Daily' },
    { value: 'WEEKLY', label: 'Weekly' },
    { value: 'MONTHLY', label: 'Monthly' },
    { value: 'QUARTERLY', label: 'Quarterly' },
    { value: 'ANNUALLY', label: 'Annually' },
  ], []);

  if (accountsLoading || beneficiariesLoading) return <Card title="Funds Transfer"><LoadingSpinner /></Card>;
  if (accountsError) return <Card title="Funds Transfer"><Alert severity="error" message={`Accounts Error: ${accountsError.message}`} /></Card>;
  if (beneficiariesError) return <Card title="Funds Transfer"><Alert severity="error" message={`Beneficiaries Error: ${beneficiariesError.message}`} /></Card>;


  return (
    <Card title="Funds Transfer">
      <form onSubmit={handleSubmit}>
        <Select
          label="From Account"
          id="fromAccount"
          value={fromAccount}
          onChange={(e) => {
            setFromAccount(e.target.value);
            const selectedAcc = availableAccounts.find(acc => acc.id === e.target.value);
            if (selectedAcc) setCurrency(selectedAcc.currency);
          }}
          options={[{ value: '', label: 'Select an account' }, ...accountOptions]}
          error={errors.fromAccount}
        />

        <Select
          label="To Beneficiary"
          id="toBeneficiary"
          value={toBeneficiary}
          onChange={(e) => setToBeneficiary(e.target.value)}
          options={beneficiaryOptions}
          error={errors.toBeneficiary}
        />

        {toBeneficiary === 'new' && (
          <>
            <Input
              label="Recipient Account Number"
              id="toExternalAccountNumber"
              type="text"
              value={toExternalAccountNumber}
              onChange={(e) => setToExternalAccountNumber(e.target.value)}
              error={errors.toExternalAccountNumber}
            />
            <Input
              label="Recipient Bank Name"
              id="toExternalBankName"
              type="text"
              value={toExternalBankName}
              onChange={(e) => setToExternalBankName(e.target.value)}
              error={errors.toExternalBankName}
            />
          </>
        )}

        <Input
          label="Amount"
          id="amount"
          type="number"
          step="0.01"
          min="0.01"
          value={amount}
          onChange={(e) => setAmount(e.target.value)}
          error={errors.amount}
        />

        <Select
          label="Currency"
          id="currency"
          value={currency}
          onChange={(e) => setCurrency(e.target.value as CurrencyEnum)}
          options={currencyOptions}
          error={errors.currency}
        />

        <Input
          label="Description (Optional)"
          id="description"
          type="text"
          value={description}
          onChange={(e) => setDescription(e.target.value)}
        />

        <div className="flex items-center mt-4 mb-2">
          <input
            id="isScheduled"
            type="checkbox"
            checked={isScheduled}
            onChange={(e) => setIsScheduled(e.target.checked)}
            className="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
          />
          <label htmlFor="isScheduled" className="ml-2 text-sm text-gray-900 dark:text-gray-300">Schedule Transfer</label>
        </div>

        {isScheduled && (
          <>
            <Input
              label="Schedule Date"
              id="scheduleDate"
              type="date"
              value={scheduleDate}
              onChange={(e) => setScheduleDate(e.target.value)}
              min={format(new Date(), 'yyyy-MM-dd')}
              error={errors.scheduleDate}
            />
            <div className="flex items-center mt-4 mb-2">
              <input
                id="isRecurring"
                type="checkbox"
                checked={isRecurring}
                onChange={(e) => setIsRecurring(e.target.checked)}
                className="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
              />
              <label htmlFor="isRecurring" className="ml-2 text-sm text-gray-900 dark:text-gray-300">Make Recurring</label>
            </div>
            {isRecurring && (
              <>
                <Select
                  label="Frequency"
                  id="frequency"
                  value={frequency}
                  onChange={(e) => setFrequency(e.target.value as any)}
                  options={frequencyOptions}
                  error={errors.frequency}
                />
                <Input
                  label="End Date (Optional for Recurring)"
                  id="endDate"
                  type="date"
                  value={endDate}
                  onChange={(e) => setEndDate(e.target.value)}
                  min={scheduleDate}
                  error={errors.endDate}
                />
              </>
            )}
          </>
        )}

        <div className="flex justify-between items-center mt-6">
          <Button type="submit" isLoading={transferLoading}>
            {isScheduled ? 'Schedule Transfer' : 'Transfer Now'}
          </Button>
          <Button type="button" variant="secondary" onClick={() => setShowAddBeneficiaryModal(true)}>
            Manage Beneficiaries
          </Button>
        </div>
      </form>

      <Modal isOpen={showAddBeneficiaryModal} onClose={() => setShowAddBeneficiaryModal(false)} title="Manage Beneficiaries">
        <BeneficiaryManagerWidget />
      </Modal>
    </Card>
  );
};


export const BeneficiaryManagerWidget: React.FC = () => {
  const { addNotification } = useNotification();
  const { data, loading, error, refetch } = accountService.getBeneficiaries();
  const { add: addBeneficiaryMutation, loading: addLoading, error: addError } = accountService.addBeneficiary();

  const [isAdding, setIsAdding] = useState(false);
  const [newBeneficiaryName, setNewBeneficiaryName] = useState('');
  const [newBeneficiaryAccount, setNewBeneficiaryAccount] = useState('');
  const [newBeneficiaryBank, setNewBeneficiaryBank] = useState('');
  const [newBeneficiaryCurrency, setNewBeneficiaryCurrency] = useState<CurrencyEnum>(CurrencyEnum.USD);
  const [newBeneficiaryIsInternational, setNewBeneficiaryIsInternational] = useState(false);
  const [newBeneficiarySwift, setNewBeneficiarySwift] = useState('');
  const [newBeneficiaryIban, setNewBeneficiaryIban] = useState('');
  const [addBeneficiaryErrors, setAddBeneficiaryErrors] = useState<Record<string, string>>({});

  useEffect(() => {
    if (addError) {
      addNotification({ title: 'Add Beneficiary Failed', message: addError.message, severity: NotificationSeverity.ERROR });
    }
  }, [addError, addNotification]);

  const validateNewBeneficiary = useCallback(() => {
    const errors: Record<string, string> = {};
    if (!newBeneficiaryName) errors.name = 'Name is required.';
    if (!newBeneficiaryAccount) errors.account = 'Account number is required.';
    if (!newBeneficiaryBank) errors.bank = 'Bank name is required.';
    if (!newBeneficiaryCurrency) errors.currency = 'Currency is required.';
    if (newBeneficiaryIsInternational && (!newBeneficiarySwift && !newBeneficiaryIban)) {
      errors.international = 'SWIFT or IBAN is required for international beneficiaries.';
    }
    setAddBeneficiaryErrors(errors);
    return Object.keys(errors).length === 0;
  }, [newBeneficiaryName, newBeneficiaryAccount, newBeneficiaryBank, newBeneficiaryCurrency, newBeneficiaryIsInternational, newBeneficiarySwift, newBeneficiaryIban]);

  const handleAddBeneficiary = useCallback(async () => {
    if (!validateNewBeneficiary()) return;

    try {
      await addBeneficiaryMutation({
        variables: {
          name: newBeneficiaryName,
          accountNumber: newBeneficiaryAccount,
          bankName: newBeneficiaryBank,
          currency: newBeneficiaryCurrency,
          isInternational: newBeneficiaryIsInternational,
          swiftCode: newBeneficiarySwift || null,
          iban: newBeneficiaryIban || null,
        },
      });
      addNotification({ title: 'Success', message: 'Beneficiary added successfully!', severity: NotificationSeverity.SUCCESS });
      setIsAdding(false);
      setNewBeneficiaryName('');
      setNewBeneficiaryAccount('');
      setNewBeneficiaryBank('');
      setNewBeneficiaryCurrency(CurrencyEnum.USD);
      setNewBeneficiaryIsInternational(false);
      setNewBeneficiarySwift('');
      setNewBeneficiaryIban('');
      setAddBeneficiaryErrors({});
      refetch(); // Re-fetch beneficiaries list
    } catch (e) {
      console.error('Failed to add beneficiary:', e);
      // Notification handled by useEffect
    }
  }, [validateNewBeneficiary, addBeneficiaryMutation, newBeneficiaryName, newBeneficiaryAccount, newBeneficiaryBank, newBeneficiaryCurrency, newBeneficiaryIsInternational, newBeneficiarySwift, newBeneficiaryIban, addNotification, refetch]);

  const beneficiaryHeaders = useMemo(() => [
    { key: 'name', label: 'Name' },
    { key: 'accountNumber', label: 'Account No.' },
    { key: 'bankName', label: 'Bank' },
    { key: 'currency', label: 'Currency' },
    { key: 'isInternational', label: 'International', render: (b: Beneficiary) => (b.isInternational ? 'Yes' : 'No') },
    { key: 'addedDate', label: 'Added On', render: (b: Beneficiary) => formatDate(b.addedDate, 'P') },
    { key: 'actions', label: 'Actions', render: (b: Beneficiary) => (
      <Button variant="danger" size="sm" onClick={() => addNotification({ title: 'Feature Not Implemented', message: `Delete beneficiary ${b.name} is not implemented in this demo.`, severity: NotificationSeverity.INFO })}>Delete</Button>
    )},
  ], [addNotification]);

  const currencyOptions = useMemo(() => Object.values(CurrencyEnum).map(c => ({ value: c, label: c })), []);

  if (loading) return <LoadingSpinner message="Loading beneficiaries..." />;
  if (error) return <Alert severity="error" message={`Failed to load beneficiaries: ${error.message}`} />;

  return (
    <div className="space-y-6">
      <h3 className="text-xl font-semibold text-gray-900 dark:text-white">Your Beneficiaries</h3>
      <Table headers={beneficiaryHeaders} data={data?.beneficiaries || []} />

      <Button onClick={() => setIsAdding(!isAdding)} variant="secondary" className="mt-4">
        {isAdding ? 'Cancel Add Beneficiary' : 'Add New Beneficiary'}
      </Button>

      {isAdding && (
        <Card className="mt-4 bg-gray-50 dark:bg-gray-700">
          <h4 className="text-lg font-semibold mb-3 text-gray-900 dark:text-white">Add New Beneficiary</h4>
          <Input
            label="Beneficiary Name"
            value={newBeneficiaryName}
            onChange={(e) => setNewBeneficiaryName(e.target.value)}
            error={addBeneficiaryErrors.name}
          />
          <Input
            label="Account Number"
            value={newBeneficiaryAccount}
            onChange={(e) => setNewBeneficiaryAccount(e.target.value)}
            error={addBeneficiaryErrors.account}
          />
          <Input
            label="Bank Name"
            value={newBeneficiaryBank}
            onChange={(e) => setNewBeneficiaryBank(e.target.value)}
            error={addBeneficiaryErrors.bank}
          />
          <Select
            label="Currency"
            options={currencyOptions}
            value={newBeneficiaryCurrency}
            onChange={(e) => setNewBeneficiaryCurrency(e.target.value as CurrencyEnum)}
            error={addBeneficiaryErrors.currency}
          />
          <div className="flex items-center mt-4 mb-2">
            <input
              id="newBeneficiaryIsInternational"
              type="checkbox"
              checked={newBeneficiaryIsInternational}
              onChange={(e) => setNewBeneficiaryIsInternational(e.target.checked)}
              className="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
            />
            <label htmlFor="newBeneficiaryIsInternational" className="ml-2 text-sm text-gray-900 dark:text-gray-300">International Beneficiary</label>
          </div>
          {newBeneficiaryIsInternational && (
            <>
              <Input
                label="SWIFT Code (Optional)"
                value={newBeneficiarySwift}
                onChange={(e) => setNewBeneficiarySwift(e.target.value)}
                error={addBeneficiaryErrors.international}
              />
              <Input
                label="IBAN (Optional)"
                value={newBeneficiaryIban}
                onChange={(e) => setNewBeneficiaryIban(e.target.value)}
                error={addBeneficiaryErrors.international}
              />
            </>
          )}
          <Button onClick={handleAddBeneficiary} isLoading={addLoading} className="mt-4">
            Save Beneficiary
          </Button>
        </Card>
      )}
    </div>
  );
};

export const InvestmentPortfolioWidget: React.FC = () => {
  const { locale } = useLocale();
  const { addNotification } = useNotification();
  const { data: accountsData, loading: accountsLoading, error: accountsError } = accountService.getAccounts();
  const investmentAccounts = useMemo(() => accountsData?.accounts.filter(acc => acc.type === AccountTypeEnum.INVESTMENT) || [], [accountsData]);
  const [selectedAccountId, setSelectedAccountId] = useState<string | undefined>(undefined);

  useEffect(() => {
    if (investmentAccounts.length > 0 && !selectedAccountId) {
      setSelectedAccountId(investmentAccounts[0].id);
    }
  }, [investmentAccounts, selectedAccountId]);

  const { data: holdingsData, loading: holdingsLoading, error: holdingsError, refetch } = investmentService.getHoldings(selectedAccountId || '');

  const totalPortfolioValue = useMemo(() => {
    return (holdingsData?.investmentHoldings || []).reduce((sum, holding) => sum + holding.marketValue, 0);
  }, [holdingsData]);

  const holdingsHeaders = useMemo(() => [
    { key: 'symbol', label: 'Symbol' },
    { key: 'name', label: 'Name' },
    { key: 'quantity', label: 'Quantity' },
    { key: 'averageCostBasis', label: 'Avg. Cost', render: (h: InvestmentHolding) => formatCurrency(h.averageCostBasis, h.currency, locale) },
    { key: 'currentPrice', label: 'Current Price', render: (h: InvestmentHolding) => formatCurrency(h.currentPrice, h.currency, locale) },
    { key: 'marketValue', label: 'Market Value', render: (h: InvestmentHolding) => formatCurrency(h.marketValue, h.currency, locale) },
    { key: 'gainLoss', label: 'Gain/Loss', render: (h: InvestmentHolding) => {
      const gainLoss = (h.currentPrice - h.averageCostBasis) * h.quantity;
      const percentGainLoss = (gainLoss / (h.averageCostBasis * h.quantity)) * 100;
      return (
        <span className={gainLoss >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400'}>
          {formatCurrency(gainLoss, h.currency, locale)} ({percentGainLoss.toFixed(2)}%)
        </span>
      );
    }},
    { key: 'lastUpdated', label: 'Last Updated', render: (h: InvestmentHolding) => formatDate(h.lastUpdated, 'Pp', locale) },
  ], [locale]);

  const accountOptions = useMemo(() => investmentAccounts.map(acc => ({
    value: acc.id,
    label: `${acc.name} (${acc.accountNumber})`,
  })) || [], [investmentAccounts]);

  if (accountsLoading) return <Card title="Investment Portfolio"><LoadingSpinner /></Card>;
  if (accountsError) return <Card title="Investment Portfolio"><Alert severity="error" message={`Accounts Error: ${accountsError.message}`} /></Card>;

  if (investmentAccounts.length === 0) {
    return (
      <Card title="Investment Portfolio">
        <p className="text-gray-500 dark:text-gray-400">No investment accounts found.</p>
        <p className="mt-2 text-sm text-gray-600 dark:text-gray-500">
          Please open an investment account to view your portfolio.
        </p>
      </Card>
    );
  }

  return (
    <Card title="Investment Portfolio" className="h-full flex flex-col">
      <div className="mb-4">
        <Select
          label="Select Investment Account"
          options={accountOptions}
          value={selectedAccountId || ''}
          onChange={(e) => setSelectedAccountId(e.target.value)}
          disabled={holdingsLoading}
        />
      </div>

      {holdingsLoading ? (
        <LoadingSpinner />
      ) : holdingsError ? (
        <Alert severity="error" message={`Holdings Error: ${holdingsError.message}`} />
      ) : (
        <>
          <div className="mb-4 p-4 bg-blue-50 dark:bg-blue-900 rounded-md">
            <h3 className="text-xl font-bold text-blue-800 dark:text-blue-200">
              Total Portfolio Value: {formatCurrency(totalPortfolioValue, CurrencyEnum.USD, locale)} {/* Assuming main portfolio currency is USD */}
            </h3>
            <p className="text-sm text-blue-600 dark:text-blue-400 mt-1">
              Reflects the current market value of all your holdings in this account.
            </p>
          </div>
          {holdingsData?.investmentHoldings && holdingsData.investmentHoldings.length > 0 ? (
            <Table headers={holdingsHeaders} data={holdingsData.investmentHoldings} />
          ) : (
            <p className="text-gray-500 dark:text-gray-400">No investment holdings in this account.</p>
          )}
          <div className="mt-4 text-center">
            <Button variant="secondary" onClick={() => addNotification({ title: 'Feature', message: 'Buy/Sell functionality not implemented.', severity: NotificationSeverity.INFO })}>
              Buy / Sell
            </Button>
            <Button variant="ghost" onClick={() => refetch()} className="ml-2">
              Refresh Data
            </Button>
          </div>
        </>
      )}
    </Card>
  );
};

export const LoanSummaryWidget: React.FC = () => {
  const { locale } = useLocale();
  const { data, loading, error } = loanService.getLoans();

  const loans = data?.loans || [];

  const loanHeaders = useMemo(() => [
    { key: 'type', label: 'Loan Type' },
    { key: 'outstandingBalance', label: 'Outstanding Balance', render: (l: Loan) => formatCurrency(l.outstandingBalance, CurrencyEnum.USD, locale) },
    { key: 'interestRate', label: 'Interest Rate', render: (l: Loan) => `${(l.interestRate * 100).toFixed(2)}%` },
    { key: 'nextPaymentAmount', label: 'Next Payment', render: (l: Loan) => formatCurrency(l.nextPaymentAmount, CurrencyEnum.USD, locale) },
    { key: 'nextPaymentDate', label: 'Due Date', render: (l: Loan) => formatDate(l.nextPaymentDate, 'P', locale) },
    { key: 'status', label: 'Status' },
    { key: 'actions', label: 'Actions', render: (l: Loan) => (
      <Button size="sm" onClick={() => alert(`Pay for Loan ID: ${l.id}`)}>Pay Now</Button>
    )},
  ], [locale]);

  if (loading) return <Card title="Loan Summary"><LoadingSpinner /></Card>;
  if (error) return <Card title="Loan Summary"><Alert severity="error" message={`Error loading loans: ${error.message}`} /></Card>;

  return (
    <Card title="Loan Summary">
      <p className="text-gray-600 dark:text-gray-400 mb-4">
        Overview of your active loans and their upcoming payment details.
      </p>
      {loans.length === 0 ? (
        <p className="text-gray-500 dark:text-gray-400">No active loans found.</p>
      ) : (
        <Table headers={loanHeaders} data={loans} />
      )}
      <div className="mt-4 text-center">
        <Link to="/loans" className="text-blue-600 hover:underline dark:text-blue-400">
          Manage All Loans
        </Link>
      </div>
    </Card>
  );
};

export const NotificationCenterWidget: React.FC = () => {
  const { locale } = useLocale();
  const { addNotification } = useNotification();
  const { data, loading, error, refetch } = notificationService.getNotifications(false);
  const markAsReadMutation = notificationService.markAsRead();

  const unreadNotifications = data?.notifications || [];

  const handleMarkAsRead = useCallback(async (id: string) => {
    try {
      await markAsReadMutation({ variables: { id } });
      addNotification({ title: 'Notification', message: 'Notification marked as read.', severity: NotificationSeverity.INFO });
      refetch(); // Refetch to remove from unread list
    } catch (e) {
      console.error('Failed to mark notification as read:', e);
      addNotification({ title: 'Error', message: 'Failed to mark notification as read.', severity: NotificationSeverity.ERROR });
    }
  }, [markAsReadMutation, addNotification, refetch]);

  if (loading) return <Card title="Notifications"><LoadingSpinner /></Card>;
  if (error) return <Card title="Notifications"><Alert severity="error" message={`Error loading notifications: ${error.message}`} /></Card>;

  return (
    <Card title="Notifications">
      <p className="text-gray-600 dark:text-gray-400 mb-4">
        Stay informed about your account activities and important updates.
      </p>
      {unreadNotifications.length === 0 ? (
        <p className="text-gray-500 dark:text-gray-400">No new notifications.</p>
      ) : (
        <div className="space-y-3">
          {unreadNotifications.slice(0, 5).map(notification => ( // Show top 5
            <div key={notification.id} className={`p-3 rounded-md border ${notification.severity === NotificationSeverity.ERROR ? 'bg-red-50 border-red-200 dark:bg-red-900 dark:border-red-700' : 'bg-blue-50 border-blue-200 dark:bg-blue-900 dark:border-blue-700'}`}>
              <div className="flex justify-between items-center mb-1">
                <h4 className="font-semibold text-gray-900 dark:text-white">{notification.title}</h4>
                <span className="text-xs text-gray-500 dark:text-gray-400">{formatDate(notification.timestamp, 'PPp', locale)}</span>
              </div>
              <p className="text-sm text-gray-700 dark:text-gray-300">{notification.message}</p>
              <div className="mt-2 flex justify-end space-x-2">
                {notification.actionUrl && (
                  <Link to={notification.actionUrl} className="text-blue-600 hover:underline text-sm dark:text-blue-400">View Details</Link>
                )}
                <Button variant="ghost" size="sm" onClick={() => handleMarkAsRead(notification.id)}>
                  Mark as Read
                </Button>
              </div>
            </div>
          ))}
        </div>
      )}
      <div className="mt-4 text-center">
        <Link to="/notifications" className="text-blue-600 hover:underline dark:text-blue-400">
          View All Notifications ({unreadNotifications.length} unread)
        </Link>
      </div>
    </Card>
  );
};


export const SecuritySettingsWidget: React.FC = () => {
