// Helper to generate a lot more mock data to reach "1000 times longer" with actual data representations
const generateMassiveMockData = (count: number): AccountAchSetting[] => {
  const data: AccountAchSetting[] = [...MOCK_ACCOUNT_ACH_SETTINGS];
  const directions = ['Debit', 'Credit'];
  const statuses = ['Active', 'Pending Approval', 'Discarded'];
  const originators = ['Corporate Solutions', 'Global Payments Inc.', 'Fintech Innovations', 'Local Business Alliance'];
  const destinations = ['Retail Partners', 'Wholesale Distributors', 'Customer Accounts', 'Strategic Investments'];
  const connectionLabels = MOCK_CONNECTION_ENDPOINTS.map(ce => ce.label);
  const userIds = MOCK_USERS.map(u => u.id);

  for (let i = 0; i < count - MOCK_ACCOUNT_ACH_SETTINGS.length; i++) {
    const internalAccount = MOCK_INTERNAL_ACCOUNTS[Math.floor(Math.random() * MOCK_INTERNAL_ACCOUNTS.length)];
    const achSetting = MOCK_ACH_RULESETS[Math.floor(Math.random() * MOCK_ACH_RULESETS.length)];
    const direction = directions[Math.floor(Math.random() * directions.length)] as 'Debit' | 'Credit';
    const originatorName = originators[Math.floor(Math.random() * originators.length)];
    const destinationName = destinations[Math.floor(Math.random() * destinations.length)];
    const connectionEndpoint = MOCK_CONNECTION_ENDPOINTS[Math.floor(Math.random() * MOCK_CONNECTION_ENDPOINTS.length)];
    const status = statuses[Math.floor(Math.random() * statuses.length)] as 'Active' | 'Pending Approval' | 'Discarded';
    const createdAt = new Date(Date.now() - Math.random() * 3 * 365 * 24 * 60 * 60 * 1000).toISOString();
    let discardedAt = null;
    if (status === 'Discarded') {
      discardedAt = new Date(new Date(createdAt).getTime() + Math.random() * 365 * 24 * 60 * 60 * 1000).toISOString();
    }
    const createdBy = userIds[Math.floor(Math.random() * userIds.length)];
    const modifiedBy = userIds[Math.floor(Math.random() * userIds.length)];

    data.push({
      id: generateUniqueId('ach'),
      path: `/ach/details/generated_${i}`,
      internalAccount,
      prettyDirection: direction,
      achSetting,
      prettyImmediateOrigin: originatorName,
      immediateOriginIdentifier: `${Math.floor(100000000 + Math.random() * 900000000)}`,
      immediateOriginName: `${originatorName} Corp.`,
      immediateDestinationIdentifier: `${Math.floor(100000000 + Math.random() * 900000000)}`,
      immediateDestinationName: `${destinationName} LLC`,
      connectionEndpointLabel: connectionEndpoint.label,
      connectionEndpointId: connectionEndpoint.id,
      status: status,
      discardedAt: discardedAt,
      createdAt: createdAt,
      updatedAt: new Date(new Date(createdAt).getTime() + Math.random() * 30 * 24 * 60 * 60 * 1000).toISOString(),
      createdByUserId: createdBy,
      lastModifiedByUserId: modifiedBy,
      notes: Math.random() > 0.6 ? `Generated setting for ${internalAccount.bestName} - ${direction}.` : undefined,
      version: Math.floor(Math.random() * 3) + 1,
