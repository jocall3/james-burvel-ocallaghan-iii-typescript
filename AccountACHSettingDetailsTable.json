                    <span style={styles.notificationItemType(n.type)}>{n.type}</span>
                    <p style={styles.notificationMessage}>{n.message}</p>
                    <small style={styles.notificationTimestamp}>{formatDate(n.timestamp, true)}</small>
                  </div>
                  {!n.isRead && (
                    <button onClick={() => markAsRead(n.id)} style={styles.markAsReadButton}>Mark as Read</button>
                  )}
                  {n.link && <a href={n.link} style={styles.notificationLink} onClick={() => { markAsRead(n.id); toggleOpen(); }}>View</a>}
                </div>
              ))
            )}
          </div>
        </div>
      )}
    </div>
  );
};

