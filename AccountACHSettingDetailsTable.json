  const unreadCount = useMemo(() => notifications.filter(n => !n.isRead).length, [notifications]);

  const toggleOpen = () => setIsOpen(prev => !prev);

  return (
    <div style={styles.notificationCenterContainer}>
      <button onClick={toggleOpen} style={styles.notificationToggleButton}>
        <span style={styles.notificationIcon}>🔔</span>
        {unreadCount > 0 && <span style={styles.notificationBadge}>{unreadCount}</span>}
      </button>
      {isOpen && (
        <div style={styles.notificationDropdown}>
          <div style={styles.notificationHeader}>
            <h4 style={styles.notificationTitle}>Notifications ({unreadCount} Unread)</h4>
            <button onClick={clearAllNotifications} style={styles.clearNotificationsButton}>Clear All</button>
          </div>
          <div style={styles.notificationList}>
            {notifications.length === 0 ? (
              <p style={styles.notificationEmpty}>No new notifications.</p>
