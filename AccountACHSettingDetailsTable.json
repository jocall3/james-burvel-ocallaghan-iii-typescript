import React, { useState, useEffect, useMemo, ChangeEvent, FormEvent, createContext, useContext, useCallback } from 'react';
import { createRoot } from 'react-dom/client';

// region: Core Interfaces - Expanded
// Define interfaces based on the GraphQL query structure provided and extended for a commercial application
export interface InternalAccount {
  id: string;
  bestName: string; // User-friendly name
  path: string; // Internal system path/identifier
  accountNumber: string; // Masked for display, e.g., 'XXXX-1234'
  accountType: 'Checking' | 'Savings' | 'Money Market' | 'Loan' | 'Credit Card'; // More detailed types
  currency: string; // e.g., 'USD', 'EUR'
  availableBalance: number; // For display purposes, typically fetched elsewhere
  status: 'Active' | 'Inactive' | 'Pending';
  associatedUsers: string[]; // User IDs who have access/are linked
  branchId?: string;
  bankId?: string; // ID of the internal bank entity
  lastActivityDate?: string; // ISO Date string
  typename?: string; // __typename
}

export interface AchSetting {
  id: string;
  path: string; // Path specific to the ACH setting config
  name: string; // User-friendly name for this ACH Rule Set (e.g., "Corporate Payroll Debit Rules")
  achRuleSetId: string; // Link to a predefined set of ACH rules (e.g., fraud, limits)
  defaultTransactionCode: string; // e.g., '22' (Credit PPD), '27' (Debit PPD)
  settlementAccountId: string; // Which internal account is used for settlement
  dailyTransactionLimit: number; // Max number of transactions per day
  dailyAmountLimit: number; // Max total amount per day
  perTransactionAmountLimit: number; // Max amount per single transaction
  isHighValueEnabled: boolean; // Flag for special handling of large amounts
  requiresDualApproval: boolean; // Whether changes to this setting need two approvals
  effectiveStartDate: string; // ISO Date string
  effectiveEndDate: string | null; // ISO Date string or null, if setting expires
  riskProfile: 'Low' | 'Medium' | 'High' | 'Custom';
  // Additional fields for ACH specific rules
  allowedEntryDescriptions: string[]; // List of allowed descriptions in ACH entries
  restrictedOriginatorIds: string[]; // Specific IDs that cannot use this setting
  blockInternational: boolean; // Prevent international ACH transactions
  typename?: string; // __typename
}

export interface AccountAchSetting {
  id: string;
  path: string; // Unique path for this specific account-ACH setting linkage
  internalAccount: InternalAccount;
  prettyDirection: 'Debit' | 'Credit'; // "Debit", "Credit"
  achSetting: AchSetting; // The specific ACH rule set applied
  prettyImmediateOrigin: string; // User-friendly name of the originating bank/entity
  immediateOriginIdentifier: string; // e.g., ABA/Routing for origin
  immediateOriginName: string; // Name of the Originator company/individual
  immediateDestinationIdentifier: string; // e.g., ABA/Routing for destination
  immediateDestinationName: string; // Name of the Recipient company/individual
  connectionEndpointLabel: string; // User-defined label for the connection
  connectionEndpointId: string; // ID of the actual network endpoint (e.g., SFTP, API Gateway)
  status: 'Active' | 'Pending Approval' | 'Discarded'; // Lifecycle status
  discardedAt: string | null; // ISO Date string or null
  createdAt: string; // ISO Date string
  updatedAt: string; // ISO Date string, tracks last modification
  createdByUserId: string;
  lastModifiedByUserId: string;
  notes?: string; // Any internal notes for this setting
  version: number; // For tracking changes over time
  typename?: string; // __typename
}

// User and Role Management Interfaces
export type UserRole = 'Admin' | 'Approver' | 'Editor' | 'Viewer';

export interface User {
  id: string;
  username: string;
  email: string;
  firstName: string;
  lastName: string;
  role: UserRole;
  isActive: boolean;
  lastLogin?: string; // ISO Date string
  permissions: Permission[]; // Direct permissions, supplementing role
  department: string;
  title: string;
  typename?: string;
}

export interface Permission {
  id: string;
  name: string; // e.g., "ach_setting.create", "ach_setting.approve"
  description: string;
  typename?: string;
}

// Approval Workflow Interfaces
export type ApprovalStatus = 'Pending' | 'Approved' | 'Rejected' | 'Cancelled';
export type ApprovalAction = 'Create' | 'Update' | 'Discard';

export interface ApprovalRequest {
  id: string;
  targetEntityType: 'AccountAchSetting' | 'AchSetting' | 'InternalAccount';
  targetEntityId: string; // ID of the entity being changed
  action: ApprovalAction;
  requestedByUserId: string;
  requestedAt: string; // ISO Date string
  status: ApprovalStatus;
  approverUserId: string | null;
  approvedAt: string | null; // ISO Date string
  rejectionReason: string | null;
  currentValue: Partial<AccountAchSetting> | Partial<AchSetting> | Partial<InternalAccount>; // Snapshot before change
  proposedValue: Partial<AccountAchSetting> | Partial<AchSetting> | Partial<InternalAccount>; // The requested change
  comments?: string;
  typename?: string;
}

// Audit Log Interface
export interface AuditLogEntry {
  id: string;
  entityType: 'AccountAchSetting' | 'AchSetting' | 'InternalAccount' | 'User' | 'ApprovalRequest';
  entityId: string;
  action: 'Created' | 'Updated' | 'Discarded' | 'Approved' | 'Rejected' | 'Logged In' | 'Logged Out';
  timestamp: string; // ISO Date string
  userId: string;
  details: Record<string, any>; // JSON object with specific changes or context
  ipAddress?: string;
  typename?: string;
}

// Notification Interface
export type NotificationType = 'Info' | 'Warning' | 'Error' | 'Success' | 'ApprovalNeeded';

export interface Notification {
  id: string;
  userId: string; // Target user
  message: string;
  type: NotificationType;
  timestamp: string; // ISO Date string
  isRead: boolean;
  link?: string; // Link to relevant part of the app
  typename?: string;
}

// Connection Endpoint Interface
export interface ConnectionEndpoint {
  id: string;
  label: string;
  type: 'SFTP' | 'API' | 'MQ' | 'FileDrop';
  configuration: Record<string, any>; // e.g., { host, port, username, path }
  status: 'Online' | 'Offline' | 'Degraded';
  lastStatusCheck: string; // ISO Date string
  primaryContact: string; // User ID
  secondaryContact: string; // User ID
  description: string;
  typename?: string;
}

// Fraud Profile Interface
export interface FraudProfile {
  id: string;
  name: string;
  description: string;
  rules: string[]; // e.g., ['BLOCK_HIGH_RISK_GEOS', 'FLAG_ABNORMAL_AMOUNTS', 'REQUIRES_MANUAL_REVIEW_OVER_500K']
  thresholds: Record<string, number>; // e.g., { maxDailyTransactions: 100, maxSingleTransaction: 100000 }
  isActive: boolean;
  typename?: string;
}
// endregion

