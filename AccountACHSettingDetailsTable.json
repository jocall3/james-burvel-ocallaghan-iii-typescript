          </div>
          <div style={styles.metricCard}>
            <h3 style={styles.metricTitle}>Active Internal Accounts</h3>
            <p style={styles.metricValue}>{EXPANDED_MOCK_INTERNAL_ACCOUNTS.filter(acc => acc.status === 'Active').length}</p>
            <p style={styles.metricDescription}>Accounts enabled for ACH operations.</p>
          </div>
        </div>
      )}

      <div style={styles.recentActivity}>
        <h3 style={styles.subSectionTitle}>Recent Activity</h3>
        <p style={styles.infoText}>Displaying up to 5 most recent audit logs relevant to your roles.</p>
        <AdvancedTable
          data={ALL_MOCK_AUDIT_LOGS.slice(0, 5)}
          columns={[
            { key: 'timestamp', header: 'Timestamp', render: (item) => formatDate(item.timestamp, true) },
            { key: 'action', header: 'Action' },
            { key: 'entityType', header: 'Entity Type' },
            { key: 'entityId', header: 'Entity ID' },
            { key: 'userId', header: 'User' },
          ]}
          pageSize={5}
          initialSortBy="timestamp"
          initialSortDirection="desc"
          emptyMessage="No recent activity to display."
        />
      </div>
    </section>
  );
};

export const AchSettingsFilterPanel: React.FC<{ onFilter: (filters: any) => void }> = ({ onFilter }) => {
  const [direction, setDirection] = useState<'All' | 'Debit' | 'Credit'>('All');
  const [status, setStatus] = useState<'All' | 'Active' | 'Pending Approval' | 'Discarded'>('All');
  const [internalAccountId, setInternalAccountId] = useState('All');
  const [originatorName, setOriginatorName] = useState('');
  const [connectionLabel, setConnectionLabel] = useState('');

  const handleApplyFilters = () => {
    onFilter({
      direction: direction === 'All' ? undefined : direction,
      status: status === 'All' ? undefined : status,
      internalAccountId: internalAccountId === 'All' ? undefined : internalAccountId,
      originatorName: originatorName || undefined,
      connectionLabel: connectionLabel || undefined,
    });
  };

  const handleClearFilters = () => {
    setDirection('All');
    setStatus('All');
    setInternalAccountId('All');
    setOriginatorName('');
    setConnectionLabel('');
    onFilter({}); // Clear all filters
  };

  return (
    <div style={styles.filterPanel}>
      <h3 style={styles.filterPanelTitle}>Filter Settings</h3>
      <div style={styles.filterGroup}>
        <label style={styles.formLabel}>Direction:</label>
        <select value={direction} onChange={(e) => setDirection(e.target.value as any)} style={styles.formInput}>
          <option value="All">All</option>
          <option value="Debit">Debit</option>
          <option value="Credit">Credit</option>
        </select>
      </div>
      <div style={styles.filterGroup}>
        <label style={styles.formLabel}>Status:</label>
        <select value={status} onChange={(e) => setStatus(e.target.value as any)} style={styles.formInput}>
          <option value="All">All</option>
          <option value="Active">Active</option>
          <option value="Pending Approval">Pending Approval</option>
          <option value="Discarded">Discarded</option>
        </select>
      </div>
      <div style={styles.filterGroup}>
        <label style={styles.formLabel}>Internal Account:</label>
        <select value={internalAccountId} onChange={(e) => setInternalAccountId(e.target.value)} style={styles.formInput}>
          <option value="All">All</option>
          {EXPANDED_MOCK_INTERNAL_ACCOUNTS.map(acc => (
            <option key={acc.id} value={acc.id}>{acc.bestName} ({acc.accountNumber})</option>
          ))}
        </select>
      </div>
      <div style={styles.filterGroup}>
        <label style={styles.formLabel}>Originator Name:</label>
        <input type="text" value={originatorName} onChange={(e) => setOriginatorName(e.target.value)} style={styles.formInput} placeholder="e.g., Corporate Payer" />
      </div>
       <div style={styles.filterGroup}>
        <label style={styles.formLabel}>Connection Label:</label>
        <input type="text" value={connectionLabel} onChange={(e) => setConnectionLabel(e.target.value)} style={styles.formInput} placeholder="e.g., Production Endpoint" />
      </div>
      <div style={styles.formActions} >
        <button onClick={handleApplyFilters} style={{ ...styles.button, ...styles.primaryButton }}>Apply Filters</button>
        <button onClick={handleClearFilters} style={{ ...styles.button, ...styles.secondaryButton }}>Clear Filters</button>
      </div>
    </div>
  );
};


export const AchSettingsListView: React.FC<{
  onEdit: (setting: AccountAchSetting) => void;
  onViewDetails: (setting: AccountAchSetting) => void;
  onDiscard: (id: string) => void;
  onToggleActive: (id: string, currentStatus: string) => void; // for activation/deactivation/soft-delete
  onBulkAction: (action: 'discard' | 'approve' | 'export', selectedIds: string[]) => void;
  addNotification: (notification: Omit<Notification, 'id' | 'timestamp' | 'isRead'> & { userId?: string }) => void;
}> = ({ onEdit, onViewDetails, onDiscard, onToggleActive, onBulkAction, addNotification }) => {
  const [achSettings, setAchSettings] = useState<AccountAchSetting[]>([]);
  const [loading, setLoading] = useState(true);
  const [currentFilters, setCurrentFilters] = useState<any>({});
  const [selectedRows, setSelectedRows] = useState<Set<string>>(new Set());
  const { currentUser, hasPermission } = useAuth();

  useEffect(() => {
    setLoading(true);
    simulateApiCall(MASSIVE_MOCK_ACCOUNT_ACH_SETTINGS, 800).then(data => {
      setAchSettings(data);
    }).catch((error: any) => {
      console.error("Failed to fetch ACH settings:", error);
      addNotification({ message: `Error fetching ACH settings: ${error.message}`, type: 'Error', userId: currentUser?.id });
    }).finally(() => {
      setLoading(false);
    });
  }, [addNotification, currentUser]);

  const handleFilterChange = (filters: any) => {
    setCurrentFilters(filters);
    setSelectedRows(new Set()); // Clear selections on filter change
  };

  const filteredData = useMemo(() => {
    return achSettings.filter(setting => {
      if (currentFilters.direction && setting.prettyDirection !== currentFilters.direction) return false;
      if (currentFilters.status && setting.status !== currentFilters.status) return false;
      if (currentFilters.internalAccountId && setting.internalAccount.id !== currentFilters.internalAccountId) return false;
      if (currentFilters.originatorName && !setting.immediateOriginName.toLowerCase().includes(currentFilters.originatorName.toLowerCase())) return false;
      if (currentFilters.connectionLabel && !setting.connectionEndpointLabel.toLowerCase().includes(currentFilters.connectionLabel.toLowerCase())) return false;
      return true;
    });
  }, [achSettings, currentFilters]);

  const handleRowCheckboxChange = (id: string, checked: boolean) => {
    setSelectedRows(prev => {
      const newSelection = new Set(prev);
      if (checked) {
        newSelection.add(id);
      } else {
        newSelection.delete(id);
      }
      return newSelection;
    });
  };

  const handleSelectAllRows = (checked: boolean) => {
    if (checked) {
      setSelectedRows(new Set(filteredData.map(s => s.id)));
    } else {
      setSelectedRows(new Set());
    }
  };

  const isAllRowsSelected = selectedRows.size > 0 && selectedRows.size === filteredData.length;

  const handleBulkDiscard = () => {
    if (selectedRows.size === 0) {
      addNotification({ message: 'No settings selected for discard.', type: 'Warning', userId: currentUser?.id });
      return;
    }
    if (window.confirm(`Are you sure you want to discard ${selectedRows.size} selected ACH settings?`)) {
      onBulkAction('discard', Array.from(selectedRows));
      setSelectedRows(new Set()); // Clear selection after action
    }
  };

  const handleBulkExport = () => {
    if (selectedRows.size === 0) {
       addNotification({ message: 'No settings selected for export.', type: 'Warning', userId: currentUser?.id });
       return;
    }
    alert(`Simulating export of ${selectedRows.size} settings.`);
    addNotification({ message: `Export initiated for ${selectedRows.size} settings.`, type: 'Info', userId: currentUser?.id });
    // In a real app, trigger a backend job for export
    setSelectedRows(new Set());
  };

  const columns: ColumnDef<AccountAchSetting>[] = [
    {
      key: 'select',
      header: <input type="checkbox" checked={isAllRowsSelected} onChange={(e) => handleSelectAllRows(e.target.checked)} style={styles.checkboxInput} />,
      render: (item) => (
        <input
          type="checkbox"
          checked={selectedRows.has(item.id)}
          onChange={(e) => handleRowCheckboxChange(item.id, e.target.checked)}
          onClick={(e) => e.stopPropagation()} // Prevent row click from firing
          style={styles.checkboxInput}
        />
      ),
      sortable: false,
    },
    { key: 'id', header: 'ID', sortable: true },
    { key: 'internalAccount.bestName', header: 'Account Name', sortable: true, render: (item) => item.internalAccount.bestName },
    { key: 'prettyDirection', header: 'Direction', sortable: true, filterType: 'select', options: [{value: 'Debit', label: 'Debit'}, {value: 'Credit', label: 'Credit'}] },
    { key: 'immediateOriginName', header: 'Originator', sortable: true, filterType: 'text' },
    { key: 'immediateDestinationName', header: 'Recipient', sortable: true, filterType: 'text' },
    { key: 'connectionEndpointLabel', header: 'Connection', sortable: true, filterType: 'text' },
    { key: 'status', header: 'Status', sortable: true, filterType: 'select', options: [{value: 'Active', label: 'Active'}, {value: 'Pending Approval', label: 'Pending Approval'}, {value: 'Discarded', label: 'Discarded'}] },
    {
      key: 'discardedAt',
      header: 'Discarded',
      render: (item) => (item.discardedAt ? `Yes (${formatDate(item.discardedAt)})` : 'No'),
      sortable: true
    },
    { key: 'createdAt', header: 'Created At', render: (item) => formatDate(item.createdAt), sortable: true, filterType: 'date' },
    { key: 'createdByUserId', header: 'Created By', render: (item) => MOCK_USERS.find(u => u.id === item.createdByUserId)?.username || item.createdByUserId, sortable: true },
  ];

  if (loading) {
    return <p style={styles.loadingText}>Loading ACH settings...</p>;
  }

  return (
    <section id="settings-list" style={styles.section}>
      <h2 style={styles.sectionTitle}>Account ACH Settings Management</h2>
      <p style={styles.infoText}>This table lists all configured ACH settings. Use the filters to refine your view or the search bar for global keyword search.</p>

      <div style={styles.settingsListControls}>
        <AchSettingsFilterPanel onFilter={handleFilterChange} />
        <div style={styles.bulkActions}>
          <h4 style={styles.subSectionTitle}>Bulk Actions ({selectedRows.size} selected)</h4>
          {hasPermission('ach_setting.discard') && (
            <button onClick={handleBulkDiscard} disabled={selectedRows.size === 0} style={{ ...styles.button, ...styles.deleteButton }}>
              Discard Selected ({selectedRows.size})
            </button>
          )}
          {hasPermission('ach_setting.export') && (
            <button onClick={handleBulkExport} disabled={selectedRows.size === 0} style={{ ...styles.button, ...styles.secondaryButton }}>
              Export Selected ({selectedRows.size})
            </button>
          )}
           {hasPermission('ach_setting.create') && (
            <button onClick={() => onEdit(null as any)} style={{ ...styles.button, ...styles.primaryButton, marginLeft: 'auto' }}>
              + Add New Setting
            </button>
          )}
        </div>
      </div>

      <AdvancedTable<AccountAchSetting>
        data={filteredData}
        columns={columns}
        pageSize={15} // More rows per page
        initialSortBy="createdAt"
        initialSortDirection="desc"
        searchableKeys={[
          'id',
          'prettyDirection',
          'immediateOriginName',
          'immediateDestinationName',
          'connectionEndpointLabel',
          'status',
          'notes',
          'internalAccount.bestName',
          'internalAccount.accountNumber',
          'achSetting.achRuleSetId',
        ]}
        title="Current ACH Settings"
        emptyMessage="No ACH settings found matching your criteria. Try adjusting your filters or add a new one!"
        actions={(setting) => (
          <div style={styles.tableActions}>
            <button onClick={(e) => { e.stopPropagation(); onViewDetails(setting); }} style={styles.detailButton}>View</button>
            {hasPermission('ach_setting.update') && setting.status !== 'Discarded' && (
              <button onClick={(e) => { e.stopPropagation(); onEdit(setting); }} style={styles.editButton}>Edit</button>
            )}
            {hasPermission('ach_setting.discard') && setting.status !== 'Discarded' && (
              <button onClick={(e) => { e.stopPropagation(); onDiscard(setting.id); }} style={styles.deleteButton}>Discard</button>
            )}
            {hasPermission('ach_setting.activate') && setting.status === 'Discarded' && (
              <button onClick={(e) => { e.stopPropagation(); onToggleActive(setting.id, setting.status); }} style={styles.activateButton}>Activate</button>
            )}
             {hasPermission('ach_setting.approve') && setting.status === 'Pending Approval' && (
              <button onClick={(e) => { e.stopPropagation(); addNotification({ message: `Approval request for ${setting.id} sent to Approver workflow.`, type: 'Info', userId: currentUser?.id }); }} style={styles.approveButton}>Review Approval</button>
            )}
          </div>
        )}
      />
    </section>
  );
};


export const AchSettingForm: React.FC<{
  selectedSetting: AccountAchSetting | null;
  onSave: (setting: AccountAchSetting, isNew: boolean) => void;
  onCancel: () => void;
  addNotification: (notification: Omit<Notification, 'id' | 'timestamp' | 'isRead'> & { userId?: string }) => void;
}> = ({ selectedSetting, onSave, onCancel, addNotification }) => {
  const { currentUser, hasPermission } = useAuth();
  const isNew = !selectedSetting?.id;

  const initialFormState: Partial<AccountAchSetting> = useMemo(() => ({
    id: '',
    path: '',
    internalAccount: { id: '', bestName: '', path: '', accountNumber: '', accountType: 'Checking', currency: 'USD', availableBalance: 0, status: 'Active', associatedUsers: [], typename: 'InternalAccount' },
    prettyDirection: 'Debit',
    achSetting: { id: '', name: '', path: '', achRuleSetId: '', defaultTransactionCode: '22', settlementAccountId: '', dailyTransactionLimit: 0, dailyAmountLimit: 0, perTransactionAmountLimit: 0, isHighValueEnabled: false, requiresDualApproval: false, effectiveStartDate: '', effectiveEndDate: null, riskProfile: 'Low', allowedEntryDescriptions: [], restrictedOriginatorIds: [], blockInternational: false, typename: 'AchSetting' },
    prettyImmediateOrigin: '',
    immediateOriginIdentifier: '',
    immediateOriginName: '',
    immediateDestinationIdentifier: '',
    immediateDestinationName: '',
    connectionEndpointLabel: '',
    connectionEndpointId: '',
    status: 'Active',
    discardedAt: null,
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString(),
    createdByUserId: currentUser?.id || 'unknown',
    lastModifiedByUserId: currentUser?.id || 'unknown',
    version: 1,
    typename: 'AccountAchSetting',
  }), [currentUser]);

  const [formData, setFormData] = useState<Partial<AccountAchSetting>>(initialFormState);
  const [formErrors, setFormErrors] = useState<{ [key: string]: string }>({});
  const [formSuccess, setFormSuccess] = useState<string | null>(null);

  useEffect(() => {
    if (selectedSetting) {
      setFormData({ ...selectedSetting });
    } else {
      setFormData(initialFormState);
    }
    setFormErrors({});
    setFormSuccess(null);
  }, [selectedSetting, initialFormState]);

  const handleInputChange = (e: ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {
    const { name, value, type, checked } = e.target as HTMLInputElement;

    if (name.startsWith('internal