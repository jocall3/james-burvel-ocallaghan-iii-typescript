  return data;
};

const MASSIVE_MOCK_ACCOUNT_ACH_SETTINGS = generateMassiveMockData(200);
const userIds = MOCK_USERS.map(u => u.id); // Re-declare for scope if needed in helper functions

const generateAuditLogsForSettings = (settings: AccountAchSetting[]): AuditLogEntry[] => {
  const logs: AuditLogEntry[] = [];
  settings.forEach(setting => {
    logs.push({
      id: generateUniqueId('aud'),
      entityType: 'AccountAchSetting',
      entityId: setting.id,
      action: 'Created',
      timestamp: setting.createdAt,
      userId: setting.createdByUserId,
      details: { initial: { ...setting } },
      typename: 'AuditLogEntry'
    });
    if (setting.status === 'Discarded' && setting.discardedAt) {
      logs.push({
        id: generateUniqueId('aud'),
        entityType: 'AccountAchSetting',
        entityId: setting.id,
        action: 'Discarded',
        timestamp: setting.discardedAt,
        userId: setting.lastModifiedByUserId, // Assuming discarder is last modifier
        details: { status: 'Discarded' },
        typename: 'AuditLogEntry'
      });
    } else if (setting.status === 'Pending Approval') {
       logs.push({
        id: generateUniqueId('aud'),
        entityType: 'AccountAchSetting',
        entityId: setting.id,
        action: 'Updated', // Or Created, depending on context
        timestamp: setting.updatedAt,
        userId: setting.lastModifiedByUserId,
        details: { status: 'Pending Approval', changeRequest: 'Some change' },
        typename: 'AuditLogEntry'
      });
    }
     if (setting.version > 1) {
        // Simulate previous updates for versions > 1
        for (let i = 1; i < setting.version; i++) {
          logs.push({
            id: generateUniqueId('aud'),
            entityType: 'AccountAchSetting',
            entityId: setting.id,
            action: 'Updated',
            timestamp: new Date(new Date(setting.createdAt).getTime() + (i * 10 * 24 * 60 * 60 * 1000)).toISOString(), // Fictional update time
            userId: userIds[Math.floor(Math.random() * userIds.length)],
            details: { versionChange: `v${i} to v${i + 1}` },
            typename: 'AuditLogEntry'
          });
        }
    }
  });
  return logs;
};

const generateNotificationsForUsers = (): Notification[] => {
  const notifications: Notification[] = [];
  MOCK_USERS.forEach(user => {
    if (user.role === 'Approver') {
      const pendingApprovals = MOCK_APPROVAL_REQUESTS.filter(req => req.status === 'Pending');
      pendingApprovals.forEach(apr => {
