/**
 * The main application component, bringing all contexts and components together.
 * This is the expanded version of the `AccountGroupSelectOptions.json` schema concept.
 */
export const App: React.FC = () => {
  const { isAuthenticated, user, isLoadingAuth } = useAuth();
  const { t } = useI18n();
  const [isSidebarOpen, setIsSidebarOpen] = useState(true);
  const [currentPage, setCurrentPage] = useState<string>('/dashboard'); // Simulates routing
  const [selectedAccountGroup, setSelectedAccountGroup] = useState<AccountGroupOption | null>(null);

  useEffect(() => {
    // Set default group from user preferences on login if available
    if (isAuthenticated && user && !selectedAccountGroup && user.preferences.defaultAccountGroupId) {
      // Need to fetch options to find the actual group object
      graphQLClient.queryAccountGroupSelectOptions().then(options => {
        const defaultGroup = options.find(opt => opt.value === user.preferences.defaultAccountGroupId);
        if (defaultGroup) {
          setSelectedAccountGroup(defaultGroup);
        }
      }).catch(console.error);
    }
  }, [isAuthenticated, user, selectedAccountGroup]);

  // Simulate routing by intercepting link clicks for demo purposes
  useEffect(() => {
    const handleLinkClick = (event: MouseEvent) => {
      const target = event.target as HTMLAnchorElement;
      if (target.tagName === 'A' && target.href.startsWith(window.location.origin)) {
        event.preventDefault();
        const path = target.pathname;
        setCurrentPage(path);
      }
    };
    document.addEventListener('click', handleLinkClick);
    return () => document.removeEventListener('click', handleLinkClick);
  }, []);

  if (isLoadingAuth) {
    return (
      <div className="flex justify-center items-center h-screen bg-gray-100 dark:bg-gray-900">
        <LoadingSpinner size={48} color="blue-600" />
        <span className="ml-4 text-xl text-gray-700 dark:text-gray-300">Loading application...</span>
      </div>
    );
  }

  return (
    <div className="flex min-h-screen bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-200">
      {isAuthenticated ? (
        <>
          <Sidebar isOpen={isSidebarOpen} onClose={() => setIsSidebarOpen(false)} />
          <div className={`flex flex-col flex-1 transition-all duration-300 ease-in-out ${isSidebarOpen ? 'ml-64' : 'ml-0'}`}>
            <Header onToggleSidebar={() => setIsSidebarOpen(!isSidebarOpen)} isSidebarOpen={isSidebarOpen} />
            <div className="p-8 flex-1">
              {/* This AccountGroupSelector is rendered outside MainContentRouter
                  to persist across different routes for authenticated users */}
              <AccountGroupSelector
                selectedGroup={selectedAccountGroup}
                onSelectGroup={setSelectedAccountGroup}
              />
              <MainContentRouter currentPage={currentPage} selectedGroup={selectedAccountGroup} />
            </div>
            <Footer />
          </div>
        </>
      ) : (
        <div className="flex flex-col justify-center items-center flex-1">
          <Card title={t('login')} className="w-96">
            <LoginForm />
          </Card>
        </div>
      )}
    </div>
  );
};

export const LoginForm: React.FC = () => {
  const { login, isLoadingAuth, authError } = useAuth();
  const { t } = useI18n();
  const [username, setUsername] = useState('jdoe'); // Default for demo
  const [password, setPassword] = useState('securepass'); // Default for demo

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      await login(username, password);
    } catch (err) {
      // Error already handled by AuthProvider and set in authError state
    }
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-4">
      <div>
        <label htmlFor="username" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{t('username')}</label>
        <Input
          id="username"
          type="text"
          value={username}
          onChange={(e) => setUsername(e.target.value)}
          required
          disabled={isLoadingAuth}
        />
      </div>
      <div>
        <label htmlFor="password" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{t('password')}</label>
        <Input
          id="password"
          type="password"
          value={password}
          onChange={(e) => setPassword(e.target.value)}
          required
          disabled={isLoadingAuth}
        />
      </div>
      {authError && <Alert type="error" message={authError.message} />}
      <Button type="submit" className="w-full" disabled={isLoadingAuth}>
        {isLoadingAuth ? <LoadingSpinner size={20} color="white" /> : t('login')}
      </Button>
      <p className="text-center text-sm text-gray-500 dark:text-gray-400 mt-4">
        Demo credentials: <br/>
        User: `jdoe` / `securepass` <br/>
        Admin: `admin` / `adminpass`
      </p>
    </form>
  );
};

