// -----------------------------------------------------------------------------
// III.C. Transactions List with Filtering/Sorting
// -----------------------------------------------------------------------------

type TransactionFilterState = {
  startDate: string;
  endDate: string;
  minAmount: number | '';
  maxAmount: number | '';
  category: string;
  type: '' | 'DEBIT' | 'CREDIT';
  status: '' | 'COMPLETED' | 'PENDING' | 'FAILED' | 'REVERSED';
  search: string;
};

type TransactionFilterAction =
  | { type: 'SET_START_DATE'; payload: string }
  | { type: 'SET_END_DATE'; payload: string }
  | { type: 'SET_MIN_AMOUNT'; payload: number | '' }
  | { type: 'SET_MAX_AMOUNT'; payload: number | '' }
  | { type: 'SET_CATEGORY'; payload: string }
  | { type: 'SET_TYPE'; payload: '' | 'DEBIT' | 'CREDIT' }
  | { type: 'SET_STATUS'; payload: '' | 'COMPLETED' | 'PENDING' | 'FAILED' | 'REVERSED' }
  | { type: 'SET_SEARCH'; payload: string }
  | { type: 'RESET_FILTERS' };

const transactionFilterReducer = (state: TransactionFilterState, action: TransactionFilterAction): TransactionFilterState => {
  switch (action.type) {
    case 'SET_START_DATE': return { ...state, startDate: action.payload };
    case 'SET_END_DATE': return { ...state, endDate: action.payload };
    case 'SET_MIN_AMOUNT': return { ...state, minAmount: action.payload };
    case 'SET_MAX_AMOUNT': return { ...state, maxAmount: action.payload };
    case 'SET_CATEGORY': return { ...state, category: action.payload };
    case 'SET_TYPE': return { ...state, type: action.payload };
    case 'SET_STATUS': return { ...state, status: action.payload };
    case 'SET_SEARCH': return { ...state, search: action.payload };
    case 'RESET_FILTERS':
      return {
        startDate: '',
        endDate: '',
        minAmount: '',
        maxAmount: '',
        category: '',
        type: '',
        status: '',
        search: '',
      };
    default: return state;
  }
};

const initialFilterState: TransactionFilterState = {
  startDate: '',
  endDate: '',
  minAmount: '',
  maxAmount: '',
  category: '',
  type: '',
  status: '',
  search: '',
};

export const TransactionsList: React.FC<{ group: AccountGroupOption | null }> = ({ group }) => {
  const { t } = useI18n();
  const [showFilters, setShowFilters] = useState(false);
  const [filterState, dispatch] = useReducer(transactionFilterReducer, initialFilterState);
  const [sortConfig, setSortConfig] = useState<{ key: keyof Transaction; direction: 'ascending' | 'descending' } | null>(null);

  const accountIds = group?.accountIds || [];
  const { data: transactions, loading, error, refetch } = useTransactionsByAccounts(accountIds);

  const allCategories = Array.from(new Set(transactions?.map(t => t.category) || []));

  const applyFilters = useCallback((transactionsToFilter: Transaction[]): Transaction[] => {
    return transactionsToFilter.filter(txn => {
      const txnDate = new Date(txn.date).getTime();
      const startDate = filterState.startDate ? new Date(filterState.startDate).getTime() : 0;
      const endDate = filterState.endDate ? new Date(filterState.endDate).getTime() : Infinity;

      if (filterState.startDate && txnDate < startDate) return false;
      if (filterState.endDate && txnDate > endDate) return false;
      if (filterState.minAmount !== '' && txn.amount < filterState.minAmount) return false;
      if (filterState.maxAmount !== '' && txn.amount > filterState.maxAmount) return false;
      if (filterState.category && txn.category !== filterState.category) return false;
      if (filterState.type && txn.type !== filterState.type) return false;
      if (filterState.status && txn.status !== filterState.status) return false;
      if (filterState.search && !txn.description.toLowerCase().includes(filterState.search.toLowerCase()) && !txn.referenceNumber.toLowerCase().includes(filterState.search.toLowerCase())) return false;
      return true;
    });
  }, [filterState]);

  const sortedTransactions = useCallback((transactionsToSort: Transaction[]): Transaction[] => {
    if (!sortConfig) return transactionsToSort;
    return [...transactionsToSort].sort((a, b) => {
      const aValue = a[sortConfig.key];
      const bValue = b[sortConfig.key];

      if (aValue === undefined || bValue === undefined) return 0;

      if (typeof aValue === 'string' && typeof bValue === 'string') {
        return sortConfig.direction === 'ascending'
          ? aValue.localeCompare(bValue)
          : bValue.localeCompare(aValue);
      }
      if (typeof aValue === 'number' && typeof bValue === 'number') {
        return sortConfig.direction === 'ascending'
          ? aValue - bValue
          : bValue - aValue;
      }
      // Fallback for dates
      if (sortConfig.key === 'date') {
        const dateA = new Date(aValue as string).getTime();
        const dateB = new Date(bValue as string).getTime();
        return sortConfig.direction === 'ascending' ? dateA - dateB : dateB - dateA;
      }
      return 0;
    });
  }, [sortConfig]);

  const filteredAndSortedTransactions = sortedTransactions(applyFilters(transactions || []));

  const requestSort = (key: keyof Transaction) => {
    let direction: 'ascending' | 'descending' = 'ascending';
    if (sortConfig && sortConfig.key === key && sortConfig.direction === 'ascending') {
      direction = 'descending';
    }
    setSortConfig({ key, direction });
  };

  const getSortIndicator = (key: keyof Transaction) => {
    if (!sortConfig || sortConfig.key !== key) {
      return '';
    }
    return sortConfig.direction === 'ascending' ? ' ⬆️' : ' ⬇️';
  };

  if (!group) {
    return <Alert type="info" message={t('noAccountsSelected')} className="mb-6" />;
  }

  return (
    <Card title={t('transactionsForGroup', { groupName: group.label })}>
      <div className="flex justify-between items-center mb-4">
        <Button onClick={() => setShowFilters(!showFilters)} className="bg-gray-200 text-gray-800 hover:bg-gray-300 dark:bg-gray-600 dark:text-white dark:hover:bg-gray-500">
          {showFilters ? 'Hide Filters' : 'Show Filters'}
        </Button>
        <Button onClick={refetch} className="bg-green-600 hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-800">
          Refresh Transactions
        </Button>
      </div>

      {showFilters && (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 p-4 border border-gray-200 dark:border-gray-700 rounded-md mb-6 bg-gray-50 dark:bg-gray-700">
          <div>
            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">{t('search')}</label>
            <Input
              type="text"
              value={filterState.search}
              onChange={(e) => dispatch({ type: 'SET_SEARCH', payload: e.target.value })}
              placeholder="Search description or ref. #"
            />
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">{t('date')} ({t('from')})</label>
            <Input
              type="date"
              value={filterState.startDate}
              onChange={(e) => dispatch({ type: 'SET_START_DATE', payload: e.target.value })}
            />
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">{t('date')} ({t('to')})</label>
            <Input
              type="date"
              value={filterState.endDate}
              onChange={(e) => dispatch({ type: 'SET_END_DATE', payload: e.target.value })}
            />
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Min {t('amount')}</label>
            <Input
              type="number"
              value={filterState.minAmount}
              onChange={(e) => dispatch({ type: 'SET_MIN_AMOUNT', payload: e.target.value === '' ? '' : parseFloat(e.target.value) })}
            />
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Max {t('amount')}</label>
            <Input
              type="number"
              value={filterState.maxAmount}
              onChange={(e) => dispatch({ type: 'SET_MAX_AMOUNT', payload: e.target.value === '' ? '' : parseFloat(e.target.value) })}
            />
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">{t('category')}</label>
            <Select
              value={filterState.category}
              onChange={(e) => dispatch({ type: 'SET_CATEGORY', payload: e.target.value })}
            >
              <option value="">All Categories</option>
              {allCategories.map(cat => <option key={cat} value={cat}>{cat}</option>)}
            </Select>
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">{t('type')}</label>
            <Select
              value={filterState.type}
              onChange={(e) => dispatch({ type: 'SET_TYPE', payload: e.target.value as '' | 'DEBIT' | 'CREDIT' })}
            >
              <option value="">All Types</option>
              <option value="DEBIT">Debit</option>
              <option value="CREDIT">Credit</option>
            </Select>
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">{t('status')}</label>
            <Select
              value={filterState.status}
              onChange={(e) => dispatch({ type: 'SET_STATUS', payload: e.target.value as '' | 'COMPLETED' | 'PENDING' | 'FAILED' | 'REVERSED' })}
            >
              <option value="">All Statuses</option>
              <option value="COMPLETED">Completed</option>
              <option value="PENDING">Pending</option>
              <option value="FAILED">Failed</option>
              <option value="REVERSED">Reversed</option>
            </Select>
          </div>
          <div className="col-span-full flex justify-end space-x-2">
            <Button onClick={() => dispatch({ type: 'RESET_FILTERS' })} className="bg-red-500 hover:bg-red-600 dark:bg-red-700 dark:hover:bg-red-800 text-white">
              {t('resetFilters')}
            </Button>
          </div>
        </div>
      )}

      {loading && <LoadingSpinner />}
      {error && <Alert type="error" message={t('errorFetchingData', { message: error.message })} />}
      {!loading && filteredAndSortedTransactions.length === 0 && <Alert type="info" message={t('noTransactions')} />}
      {!loading && filteredAndSortedTransactions && filteredAndSortedTransactions.length > 0 && (
        <Table headers={[
          <span key="date-header" onClick={() => requestSort('date')} className="cursor-pointer hover:text-blue-600 dark:hover:text-blue-400">{t('date')}{getSortIndicator('date')}</span>,
          <span key="desc-header" onClick={() => requestSort('description')} className="cursor-pointer hover:text-blue-600 dark:hover:text-blue-400">{t('description')}{getSortIndicator('description')}</span>,
          <span key="amount-header" onClick={() => requestSort('amount')} className="cursor-pointer hover:text-blue-600 dark:hover:text-blue-400">{t('amount')}{getSortIndicator('amount')}</span>,
          <span key="currency-header" onClick={() => requestSort('currency')} className="cursor-pointer hover:text-blue-600 dark:hover:text-blue-400">{t('currency')}{getSortIndicator('currency')}</span>,
          <span key="type-header" onClick={() => requestSort('type')} className="cursor-pointer hover:text-blue-600 dark:hover:text-blue-400">{t('type')}{getSortIndicator('type')}</span>,
          <span key="category-header" onClick={() => requestSort('category')} className="cursor-pointer hover:text-blue-600 dark:hover:text-blue-400">{t('category')}{getSortIndicator('category')}</span>,
          <span key="status-header" onClick={() => requestSort('status')} className="cursor-pointer hover:text-blue-600 dark:hover:text-blue-400">{t('status')}{getSortIndicator('status')}</span>,
        ]}>
          {filteredAndSortedTransactions.map((txn) => (
            <tr key={txn.id} className="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">{new Date(txn.date).toLocaleDateString()}</td>
              <td className="px-6 py-4 text-sm font-medium text-gray-900 dark:text-gray-200">{txn.description}</td>
              <td className={`px-6 py-4 whitespace-nowrap text-sm font-semibold ${txn.type === 'DEBIT' ? 'text-red-600 dark:text-red-400' : 'text-green-600 dark:text-green-400'}`}>
                {txn.type === 'DEBIT' ? '-' : '+'} {txn.amount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
              </td>
              <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">{txn.currency}</td>
              <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">{txn.type}</td>
              <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">{txn.category}</td>
              <td className="px-6 py-4 whitespace-nowrap text-sm">
                <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
                  txn.status === 'COMPLETED' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' :
                  txn.status === 'PENDING' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' :
                  'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'
                }`}>
                  {txn.status}
                </span>
              </td>
            </tr>
          ))}
        </Table>
      )}
    </Card>
  );
};

// -----------------------------------------------------------------------------
// III.D. User Settings/Preferences
// -----------------------------------------------------------------------------

export const UserSettings: React.FC = () => {
  const { t, locale, setLocale: setI18nLocale } = useI18n();
  const { user, updateUserPreferences, isLoadingAuth, authError } = useAuth();
  const { theme, setTheme: setAppTheme } = useTheme();

  const [formState, setFormState] = useState<UserProfile['preferences'] | null>(null);
  const [saveStatus, setSaveStatus] = useState<'idle' | 'saving' | 'success' | 'error'>('idle');

  useEffect(() => {
    if (user) {
      setFormState(user.preferences);
    }
  }, [user]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value, type, checked } = e.target as HTMLInputElement;
    setFormState(prev => {
      if (!prev) return null;
      if (name.startsWith('notificationSettings.')) {
        const notificationKey = name.split('.')[1] as keyof UserProfile['preferences']['notificationSettings'];
        return {
          ...prev,
          notificationSettings: {
            ...prev.notificationSettings,
            [notificationKey]: checked,
          },
        };
      }
      return {
        ...prev,
        [name]: type === 'checkbox' ? checked : value,
      };
    });
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!formState || !user) return;

    setSaveStatus('saving');
    try {
      await updateUserPreferences(formState);
      setSaveStatus('success');
      setI18nLocale(formState.locale); // Update global i18n context
      setAppTheme(formState.theme); // Update global theme context
      setTimeout(() => setSaveStatus('idle'), 3000);
    } catch (err) {
      setSaveStatus('error');
      console.error('Failed to save preferences:', err);
      setTimeout(() => setSaveStatus('idle'), 5000);
    }
  };

  if (isLoadingAuth) {
    return <Card><LoadingSpinner /></Card>;
  }

  if (authError || !user || !formState) {
    return <Card><Alert type="error" message={t('errorFetchingData', { message: authError?.message || 'User data not available.' })} /></Card>;
  }

  return (
    <Card title={t('preferences')} className="max-w-2xl mx-auto">
      <form onSubmit={handleSubmit} className="space-y-6">
        <div>
          <label htmlFor="locale" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('language')}
          </label>
          <Select id="locale" name="locale" value={formState.locale} onChange={handleChange}>
            <option value="en-US">English (US)</option>
            <option value="es-ES">Español (ES)</option>
            {/* Add more language options */}
          </Select>
        </div>

        <div>
          <label htmlFor="theme" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('theme')}
          </label>
          <Select id="theme" name="theme" value={formState.theme} onChange={handleChange}>
            <option value="light">{t('light')}</option>
            <option value="dark">{t('dark')}</option>
          </Select>
        </div>

        <fieldset>
          <legend className="text-base font-medium text-gray-900 dark:text-white mb-2">Notification Settings</legend>
          <div className="space-y-2">
            <div className="flex items-center">
              <input
                id="emailNotifications"
                name="notificationSettings.email"
                type="checkbox"
                checked={formState.notificationSettings.email}
                onChange={handleChange}
                className="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 rounded dark:bg-gray-700 dark:border-gray-600"
              />
              <label htmlFor="emailNotifications" className="ml-2 block text-sm text-gray-900 dark:text-gray-200">
                {t('emailNotifications')}
              </label>
            </div>
            <div className="flex items-center">
              <input
                id="smsNotifications"
                name="notificationSettings.sms"
                type="checkbox"
                checked={formState.notificationSettings.sms}
                onChange={handleChange}
                className="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 rounded dark:bg-gray-700 dark:border-gray-600"
              />
              <label htmlFor="smsNotifications" className="ml-2 block text-sm text-gray-900 dark:text-gray-200">
                {t('smsNotifications')}
              </label>
            </div>
            <div className="flex items-center">
              <input
                id="pushNotifications"
                name="notificationSettings.push"
                type="checkbox"
                checked={formState.notificationSettings.push}
                onChange={handleChange}
                className="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 rounded dark:bg-gray-700 dark:border-gray-600"
              />
              <label htmlFor="pushNotifications" className="ml-2 block text-sm text-gray-900 dark:text-gray-200">
                {t('pushNotifications')}
              </label>
            </div>
          </div>
        </fieldset>

        <div className="flex justify-end items-center space-x-4">
          {saveStatus === 'saving' && <LoadingSpinner size={20} />}
          {saveStatus === 'success' && <Alert type="success" message={t('preferenceUpdateSuccess')} className="inline-block p-2" />}
          {saveStatus === 'error' && <Alert type="error" message={t('preferenceUpdateError')} className="inline-block p-2" />}
          <Button type="submit" disabled={saveStatus === 'saving'}>
            {t('savePreferences')}
          </Button>
        </div>
      </form>
    </Card>
  );
};

// -----------------------------------------------------------------------------
// III.E. Currency Converter
// -----------------------------------------------------------------------------

const mockExchangeRates: { [key: string]: { [key: string]: number } } = {
  USD: { EUR: 0.92, GBP: 0.79, CAD: 1.37, USD: 1 },
  EUR: { USD: 1.09, GBP: 0.86, CAD: 1.49, EUR: 1 },
  GBP: { USD: 1.26, EUR: 1.16, CAD: 1.74, GBP: 1 },
  CAD: { USD: 0.73, EUR: 0.67, GBP: 0.57, CAD: 1 },
};

export const CurrencyConverter: React.FC = () => {
  const { t } = useI18n();
  const [fromCurrency, setFromCurrency] = useState<string>('USD');
  const [toCurrency, setToCurrency] = useState<string>('EUR');
  const [amount, setAmount] = useState<number | ''>('');
  const [convertedAmount, setConvertedAmount] = useState<number | null>(null);
  const [exchangeRate, setExchangeRate] = useState<number | null>(null);
  const [error, setError] = useState<string | null>(null);

  const availableCurrencies = Object.keys(mockExchangeRates);

  const getRate = useCallback((from: string, to: string) => {
    return mockExchangeRates[from]?.[to] || null;
  }, []);

  useEffect(() => {
    const rate = getRate(fromCurrency, toCurrency);
    setExchangeRate(rate);
    if (!rate) {
      setError('No exchange rate available for selected currencies.');
    } else {
      setError(null);
    }
  }, [fromCurrency, toCurrency, getRate]);

  const handleConvert = () => {
    setError(null);
    if (amount === '' || isNaN(Number(amount)) || Number(amount) <= 0) {
      setError('Please enter a valid amount.');
      setConvertedAmount(null);
      return;
    }
    if (!exchangeRate) {
      setError('Cannot convert, exchange rate not available.');
      setConvertedAmount(null);
      return;
    }

    const result = Number(amount) * exchangeRate;
    setConvertedAmount(result);
  };

  return (
    <Card title={t('currencyConverter')} className="max-w-xl mx-auto">
      <div className="space-y-4">
        <div>
          <label htmlFor="convertAmount" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{t('convertAmount')}</label>
          <Input
            id="convertAmount"
            type="number"
            value={amount}
            onChange={(e) => setAmount(e.target.value === '' ? '' : parseFloat(e.target.value))}
            placeholder="100.00"
            min="0"
          />
        </div>
        <div className="grid grid-cols-2 gap-4">
          <div>
            <label htmlFor="fromCurrency" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{t('from')}</label>
            <Select id="fromCurrency" value={fromCurrency} onChange={(e) => setFromCurrency(e.target.value)}>
              {availableCurrencies.map(c => <option key={c} value={c}>{c}</option>)}
            </Select>
          </div>
          <div>
            <label htmlFor="toCurrency" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">{t('to')}</label>
            <Select id="toCurrency" value={toCurrency} onChange={(e) => setToCurrency(e.target.value)}>
              {availableCurrencies.map(c => <option key={c} value={c}>{c}</option>)}
            </Select>
          </div>
        </div>
        {exchangeRate !== null && (
          <p className="text-sm text-gray-600 dark:text-gray-400">
            {t('rate')}: 1 {fromCurrency} = {exchangeRate.toFixed(4)} {toCurrency}
          </p>
        )}
        {error && <Alert type="error" message={error} />}
        <Button onClick={handleConvert} className="w-full">
          {t('convert')}
        </Button>
        {convertedAmount !== null && (
          <Alert type="success" message={`${t('convertedAmount')}: ${toCurrency} ${convertedAmount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`} />
        )}
      </div>
    </Card>
  );
};

