        <h1 className="text-2xl font-bold text-gray-900 dark:text-white">{t('appName')}</h1>
      </div>
      <div className="flex items-center space-x-4">
        <Button onClick={toggleTheme} className="p-2 bg-transparent text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
          {theme === 'light' ? '☀️' : '🌙'}
        </Button>
        <div className="relative">
          <Button onClick={() => setShowNotifications(!showNotifications)} className="p-2 bg-transparent text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
            🔔
            {unreadCount > 0 && (
              <span className="absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-red-100 bg-red-600 rounded-full">
                {unreadCount}
              </span>
            )}
          </Button>
          {showNotifications && (
            <div className="absolute right-0 mt-2 w-80 bg-white dark:bg-gray-700 rounded-md shadow-lg py-2 z-50">
              <h4 className="px-4 py-2 text-md font-semibold text-gray-900 dark:text-white">{t('notifications')}</h4>
              {loadingNotifications && <div className="px-4 py-2"><LoadingSpinner size={16} /></div>}
