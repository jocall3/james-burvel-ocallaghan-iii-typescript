              <div className="flex justify-end px-4 py-2">
                <Button onClick={() => { /* Implement mark all as read */ refetchNotifications?.(); setShowNotifications(false); }} className="text-xs bg-gray-200 dark:bg-gray-600 text-gray-800 dark:text-white mr-2">{t('markAsRead')}</Button>
