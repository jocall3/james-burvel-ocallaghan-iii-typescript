export const AccountGroupSelector: React.FC<{
  selectedGroup: AccountGroupOption | null;
  onSelectGroup: (group: AccountGroupOption | null) => void;
}> = ({ selectedGroup, onSelectGroup }) => {
  const { t } = useI18n();
  const [currencyFilter, setCurrencyFilter] = useState<string>('');
  const { data: options, loading, error, refetch } = useAccountGroupSelectOptions(currencyFilter ? [currencyFilter] : undefined);

  const availableCurrencies = Array.from(new Set(options?.map(o => o.primaryCurrency) || []));

  useEffect(() => {
    // If a group was selected, but it's not in the current options (e.g., due to filter change), clear selection
    if (selectedGroup && options && !options.some(opt => opt.value === selectedGroup.value)) {
      onSelectGroup(null);
    }
    // If no group is selected, and there's a default in user preferences, set it
    // This logic could be more complex, e.g., only set on first load
  }, [options, selectedGroup, onSelectGroup]);

  const handleSelectChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const value = e.target.value;
    if (value === '') {
      onSelectGroup(null);
    } else {
      const group = options?.find(o => o.value === value);
      if (group) {
        onSelectGroup(group);
      }
    }
  };

  return (
    <Card title={t('selectAccountGroup')} className="mb-6">
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label htmlFor="currency-filter" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('filterByCurrency')}
          </label>
          <Select
            id="currency-filter"
            value={currencyFilter}
            onChange={(e) => setCurrencyFilter(e.target.value)}
          >
            <option value="">{t('allCurrencies')}</option>
            {availableCurrencies.map((currency) => (
              <option key={currency} value={currency}>{currency}</option>
            ))}
          </Select>
        </div>
        <div>
          <label htmlFor="account-group-select" className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            {t('selectAccountGroup')}
          </label>
          <Select
            id="account-group-select"
            value={selectedGroup?.value || ''}
            onChange={handleSelectChange}
            disabled={loading}
          >
            <option value="">{t('selectAccountGroup')}...</option>
            {options?.map((option) => (
              <option key={option.value} value={option.value}>
                {option.label} ({option.primaryCurrency})
              </option>
            ))}
          </Select>
        </div>
      </div>

      {loading && <div className="mt-4"><LoadingSpinner /></div>}
      {error && <Alert type="error" message={t('errorFetchingData', { message: error.message })} className="mt-4" />}

      <div className="mt-4 flex justify-end space-x-2">
        <Button onClick={() => setCurrencyFilter('')} disabled={!currencyFilter} className="bg-gray-200 text-gray-800 hover:bg-gray-300 dark:bg-gray-600 dark:text-white dark:hover:bg-gray-500">
          {t('resetFilters')}
        </Button>
        <Button onClick={() => onSelectGroup(null)} disabled={!selectedGroup} className="bg-gray-200 text-gray-800 hover:bg-gray-300 dark:bg-gray-600 dark:text-white dark:hover:bg-gray-500">
          {t('clearSelection')}
        </Button>
        <Button onClick={refetch} className="bg-green-600 hover:bg-green-700 dark:bg-green-700 dark:hover:bg-green-800">
          Refresh
        </Button>
      </div>
    </Card>
  );
};

