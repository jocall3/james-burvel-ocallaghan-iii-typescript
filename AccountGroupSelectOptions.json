export const AdminAuditLogs: React.FC = () => {
  const { t } = useI18n();
  const { user } = useAuth();
  // No specific hook for audit logs, would integrate with a backend API directly
  // This is a placeholder for a more robust audit log viewer.

  if (!user?.roles.includes('ADMIN')) {
    return <Alert type="error" message="Access Denied: You do not have permission to view this page." />;
  }

  const [logs, setLogs] = useState<AuditLogEntry[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<Error | null>(null);

  const fetchAuditLogs = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      // In a real app, this would query a dedicated audit log API endpoint
      // For demo purposes, we'll just show some static logs
      const mockLogs: AuditLogEntry[] = [
        { id: 'log-001', timestamp: new Date(Date.now() - 1000 * 60 * 5).toISOString(), userId: 'user-001', action: 'LOGIN_SUCCESS', details: { username: 'admin' }, ipAddress: '192.168.1.1', status: 'SUCCESS' },
        { id: 'log-002', timestamp: new Date(Date.now() - 1000 * 60 * 10).toISOString(), userId: 'user-002', action: 'UPDATE_ACCOUNT_DETAILS', details: { accountId: 'acc-001', field: 'name', oldValue: 'Checking', newValue: 'Primary Checking' }, ipAddress: '10.0.0.5', status: 'SUCCESS' },
        { id: 'log-003', timestamp: new Date(Date.now() - 1000 * 60 * 15).toISOString(), userId: 'user-001', action: 'USER_LOGIN', details: { username: 'invalid_user' }, ipAddress: '192.168.1.1', status: 'FAILURE' },
        { id: 'log-004', timestamp: new Date(Date.now() - 1000 * 60 * 20).toISOString(), userId: 'user-002', action: 'PASSWORD_CHANGE', details: { success: true }, ipAddress: '10.0.0.5', status: 'SUCCESS' },
        { id: 'log-005', timestamp: new Date(Date.now() - 1000 * 60 * 30).toISOString(), userId: 'user-001', action: 'SYSTEM_CONFIG_UPDATE', details: { configKey: 'max_transaction_limit', oldValue: '10000', newValue: '20000' }, ipAddress: '192.168.1.2', status: 'SUCCESS' },
      ].sort((a,b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());
      await new Promise(res => setTimeout(res, 500)); // Simulate API call
      setLogs(mockLogs);
    } catch (err: any) {
      setError(err);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchAuditLogs();
  }, [fetchAuditLogs]);

  return (
    <Card title={t('auditLogs')} className="max-w-full mx-auto">
      <Alert type="info" message="This section provides a detailed immutable log of all significant activities within the application for compliance and security auditing." className="mb-4" />
      <div className="flex justify-end mb-4">
        <Button onClick={fetchAuditLogs}>Refresh Logs</Button>
      </div>

      {loading && <LoadingSpinner />}
      {error && <Alert type="error" message={t('errorFetchingData', { message: error.message })} />}
      {!loading && logs.length === 0 && <Alert type="info" message="No audit logs found." />}
      {!loading && logs.length > 0 && (
        <Table headers={['Timestamp', 'User ID', 'Action', 'Details', 'IP Address', 'Status']}>
          {logs.map(log => (
            <tr key={log.id} className="hover:bg-gray-50 dark:hover:bg-gray-700 text-sm">
              <td className="px-6 py-4 whitespace-nowrap">{new Date(log.timestamp).toLocaleString()}</td>
              <td className="px-6 py-4 whitespace-nowrap">{log.userId}</td>
              <td className="px-6 py-4 whitespace-nowrap">{log.action}</td>
              <td className="px-6 py-4 text-xs font-mono text-gray-700 dark:text-gray-300">{JSON.stringify(log.details)}</td>
              <td className="px-6 py-4 whitespace-nowrap">{log.ipAddress}</td>
              <td className="px-6 py-4 whitespace-nowrap">
                <span className={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
                  log.status === 'SUCCESS' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' :
                  'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'
                }`}>
                  {log.status}
                </span>
              </td>
            </tr>
          ))}
        </Table>
      )}
    </Card>
  );
};

