// This file simulates a comprehensive commercial banking application's main component,
// built around the concept of account group selection, expanding the initial JSON
// schema into a full-fledged TypeScript React application. It demonstrates advanced
// features, state management, UI components, and business logic relevant to a bank.

import React, {
  useState,
  useEffect,
  useContext,
  createContext,
  useCallback,
  useReducer,
  useRef,
} from 'react';

// =============================================================================
// I. Core Application Contexts & Hooks
// =============================================================================

// -----------------------------------------------------------------------------
// I.A. Global Types and Interfaces
// -----------------------------------------------------------------------------

/**
 * Represents a simple select option as derived from the original JSON schema.
 */
export interface SelectSimpleOption {
  value: string;
  label: string;
  __typename: 'SelectSimpleOption';
}

/**
 * Extends SelectSimpleOption with additional banking-specific metadata for an account group.
 */
export interface AccountGroupOption extends SelectSimpleOption {
  groupType: 'CHECKING' | 'SAVINGS' | 'INVESTMENT' | 'LOAN' | 'CREDIT_CARD' | 'MORTGAGE' | 'BUSINESS' | 'GENERAL';
  accountIds: string[];
  primaryCurrency: string;
  totalBalance: number;
  lastUpdated: string; // ISO Date string
  memberCount: number; // Number of accounts in this group
  hasJointAccounts: boolean;
  status: 'ACTIVE' | 'INACTIVE' | 'PENDING';
}

/**
 * Represents a single financial account within an account group.
 */
export interface BankAccount {
  id: string;
  accountNumber: string;
  name: string;
  balance: number;
  currency: string;
  type: 'CHECKING' | 'SAVINGS' | 'INVESTMENT' | 'LOAN' | 'CREDIT_CARD';
  status: 'OPEN' | 'CLOSED' | 'FROZEN';
  openingDate: string; // ISO Date string
  lastTransactionDate: string; // ISO Date string
  interestRate?: number;
  creditLimit?: number;
  availableCredit?: number;
  beneficiaries?: string[];
  isJoint: boolean;
  linkedAccountId?: string; // e.g., for credit card linked to checking for payments
}

/**
 * Represents a financial transaction.
 */
export interface Transaction {
  id: string;
  accountId: string;
  date: string; // ISO Date string
  description: string;
  amount: number;
  currency: string;
  type: 'DEBIT' | 'CREDIT';
  category: string; // e.g., 'Groceries', 'Salary', 'Rent', 'Transfer'
  status: 'COMPLETED' | 'PENDING' | 'FAILED' | 'REVERSED';
  referenceNumber: string;
  merchantName?: string;
  tags?: string[];
}

/**
 * Represents a user profile in the banking application.
 */
export interface UserProfile {
  id: string;
  username: string;
  firstName: string;
  lastName: string;
  email: string;
  roles: ('CUSTOMER' | 'ADMIN' | 'RELATIONSHIP_MANAGER' | 'SUPPORT')[];
  preferences: {
    locale: string;
    theme: 'light' | 'dark';
    notificationSettings: {
      email: boolean;
      sms: boolean;
      push: boolean;
    };
    defaultAccountGroupId?: string;
  };
  lastLogin: string; // ISO Date string
}

/**
 * Represents a notification for the user.
 */
export interface AppNotification {
  id: string;
  type: 'INFO' | 'WARNING' | 'ERROR' | 'SUCCESS';
  message: string;
  timestamp: string; // ISO Date string
  read: boolean;
  link?: string;
}

/**
 * Represents an audit log entry for security and compliance.
 */
export interface AuditLogEntry {
  id: string;
  timestamp: string; // ISO Date string
  userId: string;
  action: string;
  details: Record<string, any>;
  ipAddress: string;
  status: 'SUCCESS' | 'FAILURE';
}

/**
 * Common properties for API response wrappers.
 */
export interface ApiResponse<T> {
  data: T | null;
  loading: boolean;
  error: Error | null;
  refetch?: () => void;
}

