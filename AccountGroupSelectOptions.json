export const graphQLClient = new MockGraphQLClient(); // Singleton instance

/**
 * Custom hook to simulate GraphQL queries.
 */
export function useGraphQLQuery<T, V>(
  queryFn: (variables: V) => Promise<T>,
  variables: V,
  skip: boolean = false
): ApiResponse<T> {
  const [data, setData] = useState<T | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<Error | null>(null);
  const queryFnRef = useRef(queryFn); // Persist queryFn to prevent re-renders triggering effect

  const fetchData = useCallback(async () => {
    if (skip) {
      setLoading(false);
      return;
    }
    setLoading(true);
    setError(null);
    try {
      const result = await queryFnRef.current(variables);
      setData(result);
    } catch (err: any) {
      setError(err);
      console.error('GraphQL query error:', err);
    } finally {
      setLoading(false);
    }
  }, [variables, skip]);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  return { data, loading, error, refetch: fetchData };
}

/**
 * Custom hook to fetch `AccountGroupSelectOptions`.
 */
export function useAccountGroupSelectOptions(currencies?: string[]): ApiResponse<AccountGroupOption[]> {
  return useGraphQLQuery(graphQLClient.queryAccountGroupSelectOptions.bind(graphQLClient), { currencies });
}

/**
 * Custom hook to fetch detailed accounts for specific group IDs.
 */
export function useAccountsByGroup(groupIds: string[]): ApiResponse<BankAccount[]> {
  return useGraphQLQuery(graphQLClient.queryAccountsByGroup.bind(graphQLClient), { groupIds }, groupIds.length === 0);
}

/**
 * Custom hook to fetch transactions for specific account IDs.
 */
export function useTransactionsByAccounts(accountIds: string[]): ApiResponse<Transaction[]> {
  return useGraphQLQuery(graphQLClient.queryTransactionsByAccounts.bind(graphQLClient), { accountIds }, accountIds.length === 0);
}

/**
 * Custom hook to fetch notifications for a user.
 */
export function useUserNotifications(userId: string | null): ApiResponse<AppNotification[]> {
  return useGraphQLQuery(graphQLClient.fetchNotifications.bind(graphQLClient), { userId: userId! }, !userId);
}

// -----------------------------------------------------------------------------
// I.C. Authentication Context
// -----------------------------------------------------------------------------

interface AuthContextType {
  user: UserProfile | null;
  isAuthenticated: boolean;
  login: (username: string, passwordHash: string) => Promise<void>;
  logout: () => void;
  updateUserPreferences: (prefs: Partial<UserProfile['preferences']>) => void;
  isLoadingAuth: boolean;
  authError: Error | null;
}

export const AuthContext = createContext<AuthContextType | undefined>(undefined);

export const AuthProvider: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
  const [user, setUser] = useState<UserProfile | null>(null);
  const [isLoadingAuth, setIsLoadingAuth] = useState(true);
  const [authError, setAuthError] = useState<Error | null>(null);

  useEffect(() => {
    // Simulate checking for a session or token in localStorage
    const savedUser = localStorage.getItem('currentUser');
    if (savedUser) {
      setUser(JSON.parse(savedUser));
    }
    setIsLoadingAuth(false);
  }, []);

  const login = useCallback(async (username, passwordHash) => {
    setIsLoadingAuth(true);
    setAuthError(null);
    try {
      const authenticatedUser = await graphQLClient.authenticate(username, passwordHash);
      setUser(authenticatedUser);
      localStorage.setItem('currentUser', JSON.stringify(authenticatedUser));
      await graphQLClient.recordAuditLog({
        userId: authenticatedUser.id,
        action: 'USER_LOGIN',
        details: { username },
        ipAddress: '127.0.0.1',
      });
    } catch (err: any) {
      setAuthError(err);
      console.error('Login failed:', err);
      await graphQLClient.recordAuditLog({
        userId: 'UNKNOWN', // Or try to extract from err
        action: 'LOGIN_ATTEMPT_FAILED',
        details: { username, error: err.message },
        ipAddress: '127.0.0.1',
      });
      throw err; // Re-throw to allow UI to handle
    } finally {
      setIsLoadingAuth(false);
    }
  }, []);

  const logout = useCallback(() => {
    if (user) {
      graphQLClient.recordAuditLog({
        userId: user.id,
        action: 'USER_LOGOUT',
        details: {},
        ipAddress: '127.0.0.1',
      });
    }
    setUser(null);
    localStorage.removeItem('currentUser');
    setAuthError(null);
  }, [user]);

  const updateUserPreferences = useCallback((prefs: Partial<UserProfile['preferences']>) => {
    setUser((prevUser) => {
      if (!prevUser) return null;
      const updatedUser = {
        ...prevUser,
        preferences: {
          ...prevUser.preferences,
          ...prefs,
        },
      };
      localStorage.setItem('currentUser', JSON.stringify(updatedUser));
      graphQLClient.recordAuditLog({
        userId: prevUser.id,
        action: 'UPDATE_USER_PREFERENCES',
        details: { newPreferences: prefs },
        ipAddress: '127.0.0.1',
      });
      return updatedUser;
    });
  }, []);

  const value = {
    user,
    isAuthenticated: !!user,
    login,
    logout,
    updateUserPreferences,
    isLoadingAuth,
    authError,
  };

  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
};

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (context === undefined) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
};

// -----------------------------------------------------------------------------
// I.D. Theme Context (for light/dark mode)
// -----------------------------------------------------------------------------

type Theme = 'light' | 'dark';

interface ThemeContextType {
  theme: Theme;
  toggleTheme: () => void;
  setTheme: (theme: Theme) => void;
}

export const ThemeContext = createContext<ThemeContextType | undefined>(undefined);

export const ThemeProvider: React.FC<React.PropsWithChildren<{}>> = ({ children }) => {
  const { user, updateUserPreferences, isAuthenticated } = useAuth();
  const [localTheme, setLocalTheme] = useState<Theme>('light');

  useEffect(() => {
    if (isAuthenticated && user?.preferences.theme) {
      setLocalTheme(user.preferences.theme);
    } else {
      const savedTheme = localStorage.getItem('appTheme') as Theme;
      if (savedTheme) {
        setLocalTheme(savedTheme);
      } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        setLocalTheme('dark');
      }
    }
  }, [isAuthenticated, user?.preferences.theme]);

  useEffect(() => {
    document.documentElement.setAttribute('data-theme', localTheme);
    localStorage.setItem('appTheme', localTheme);
  }, [localTheme]);

  const toggleTheme = useCallback(() => {
    const newTheme = localTheme === 'light' ? 'dark' : 'light';
    setLocalTheme(newTheme);
    if (isAuthenticated) {
      updateUserPreferences({ theme: newTheme });
    }
  }, [localTheme, isAuthenticated, updateUserPreferences]);

  const setTheme = useCallback((theme: Theme) => {
    setLocalTheme(theme);
    if (isAuthenticated) {
      updateUserPreferences({ theme: theme });
    }
  }, [isAuthenticated, updateUserPreferences]);

  const value = { theme: localTheme, toggleTheme, setTheme };

  return <ThemeContext.Provider value={value}>{children}</ThemeContext.Provider>;
};

export const useTheme = () => {
  const context = useContext(ThemeContext);
  if (context === undefined) {
    throw new Error('useTheme must be used within a ThemeProvider');
  }
  return context;
};

