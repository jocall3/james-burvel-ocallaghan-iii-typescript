// Simulating React and its hooks since external imports are disallowed.
// In a real application, these would be imported from 'react'.
declare global {
  namespace JSX {
    interface IntrinsicElements {
      [elemName: string]: any; // Allows any HTML element
    }
  }
}

// Minimal React shim for standalone compilation without imports
const React = {
  useState: <T>(initialValue: T): [T, (newValue: T) => void] => {
    // This is a dummy implementation. In a real React app, this is handled by the React runtime.
    // For the purpose of making the code syntactically valid and expandable without imports,
    // we just return a placeholder.
    let value = initialValue;
    const setter = (newValue: T) => { value = newValue; /* In a real app, this would trigger re-render */ };
    return [value, setter];
  },
  useEffect: (effect: () => (() => void) | void, deps?: any[]) => {
    // Dummy implementation
    // In a real app, this would run effects and cleanup based on dependencies.
  },
  useContext: <T>(context: React.Context<T>): T => {
    // Dummy implementation. Assumes a default value or mock for context.
    // In a real app, this would access the nearest provider's value.
    return context._currentValue as T; // Accessing a non-public property for simulation
  },
  createContext: <T>(defaultValue: T) => {
    let _currentValue = defaultValue;
    return {
      Provider: ({ children, value }: { children: any; value: T }) => {
        _currentValue = value; // Update the "context" value
        return children;
      },
      _currentValue: defaultValue // Storing the current value for useContext
    } as unknown as React.Context<T>; // Type assertion for our shim
  },
  useReducer: <S, A>(reducer: (state: S, action: A) => S, initialState: S): [S, (action: A) => void] => {
    let state = initialState;
    const dispatch = (action: A) => {
      state = reducer(state, action);
      // In a real app, this would trigger re-render
    };
    return [state, dispatch];
  },
  memo: <P>(Component: React.ComponentType<P>) => Component, // Simple passthrough for memo
  useCallback: <T extends (...args: any[]) => any>(callback: T, deps: any[]) => callback, // Simple passthrough for useCallback
  useRef: <T>(initialValue: T | null) => ({ current: initialValue }), // Simple passthrough for useRef
  // Add other hooks as needed for realism
};

// ==============================================================================
// 1. Core Data Models and Enums
// ==============================================================================

/**
 * Represents the status of an Account Collection Flow.
 * Used for tracking the lifecycle of a financial collection process.
 */
export enum FlowStatus {
  Draft = 'DRAFT',
  PendingApproval = 'PENDING_APPROVAL',
  Approved = 'APPROVED',
  Rejected = 'REJECTED',
  Active = 'ACTIVE',
  Paused = 'PAUSED',
  Completed = 'COMPLETED',
  Archived = 'ARCHIVED',
  Failed = 'FAILED',
  Cancelled = 'CANCELLED',
}

/**
 * Represents different types of payment instruments or methods.
 * This list can be extensively customized based on banking system requirements.
 */
export enum PaymentType {
  ACH = 'ACH',
  SEPA = 'SEPA',
  SWIFT = 'SWIFT',
  FasterPayments = 'FASTER_PAYMENTS',
  RTP = 'RTP', // Real-Time Payments
  Card = 'CARD',
  Wallet = 'WALLET',
  Check = 'CHECK',
  WireTransfer = 'WIRE_TRANSFER',
  DirectDebit = 'DIRECT_DEBIT',
  Interac = 'INTERAC', // Canada
  Pix = 'PIX', // Brazil
  PromptPay = 'PROMPT_PAY', // Thailand
  GIRO = 'GIRO', // Singapore/Malaysia
  CHAPS = 'CHAPS', // UK
  FEDWIRE = 'FEDWIRE', // US
  NACH = 'NACH', // India
}

/**
 * Represents a geographical country, primarily for identifying valid receiving jurisdictions.
 */
export interface ICountry {
  code: string; // ISO 3166-1 alpha-2 code, e.g., "US", "GB", "DE"
  name: string;
  currencyCode: string; // ISO 4217 currency code, e.g., "USD", "GBP", "EUR"
  supportedPaymentTypes: PaymentType[];
  isSanctioned: boolean;
}

/**
 * Represents a counterparty involved in the collection flow.
 * This could be another bank, a corporate client, or an individual.
 */
export interface ICounterparty {
  id: string;
  name: string;
  legalName?: string;
  taxId?: string;
  address: {
    street: string;
    city: string;
    state?: string;
    zipCode: string;
    countryCode: string; // ISO 3166-1 alpha-2
  };
  contactEmail: string;
  contactPhone?: string;
  bankAccounts: Array<{
    id: string;
    accountNumber: string;
    routingNumber?: string; // e.g., ABA for US, BIC/SWIFT for international
    bankName: string;
    currencyCode: string;
    isPrimary?: boolean;
  }>;
  riskRating: 'Low' | 'Medium' | 'High' | 'Blocked';
  kycStatus: 'Verified' | 'Pending' | 'Rejected';
  dateAdded: string; // ISO 8601 date string
  lastUpdated: string;
}

/**
 * Represents a single Account Collection Flow, extending the original GraphQL schema.
 * This is the central entity for this application.
 */
export interface IAccountCollectionFlow {
  id: string;
  name: string; // A user-friendly name for the flow
  description: string;
  clientToken: string; // Unique token for client-side integration
  counterpartyId: string; // ID of the counterparty involved
  paymentTypes: PaymentType[]; // Supported payment types for this flow
  receivingCountries: string[]; // ISO 3166-1 alpha-2 codes of countries
  flowStatus: FlowStatus;
  creationDate: string; // ISO 8601 date string
  lastModifiedDate: string;
  startDate?: string; // Optional start date for the flow
  endDate?: string; // Optional end date for the flow
  createdByUserId: string;
  approvedByUserId?: string;
  deactivationReason?: string; // Reason for pausing/cancelling/failing
  recurrencePattern?: 'Daily' | 'Weekly' | 'Monthly' | 'Quarterly' | 'Annually' | 'One-Time';
  amountLimitPerTransaction?: number; // Max amount per collection transaction
  totalAmountLimit?: number; // Overall limit for the flow
  currency: string; // The primary currency for this flow (e.g., USD)
  complianceFlags: string[]; // e.g., "AML_CHECK_REQUIRED", "OFAC_SCREENING"
  tags: string[]; // User-defined tags for organization
  version: number; // For optimistic locking or version tracking
  isArchived: boolean;
  __typename: "AccountCollectionFlow";
}

/**
 * Represents an entry in the audit trail for a flow.
 * Critical for compliance and tracking changes.
 */
export interface IAuditEntry {
  id: string;
  flowId: string;
  timestamp: string; // ISO 8601 date string
  userId: string;
  action: string; // e.g., "CREATED", "UPDATED_STATUS", "FIELD_CHANGE:name", "APPROVED"
  details: string; // Human-readable description of the change
  previousValue?: any;
  newValue?: any;
}

/**
 * Represents a step in an approval workflow.
 * Multi-stage approvals are common in banking.
 */
export enum ApprovalStatus {
  Pending = 'PENDING',
  Approved = 'APPROVED',
  Rejected = 'REJECTED',
  Skipped = 'SKIPPED',
}

export interface IApprovalStep {
  id: string;
  flowId: string;
  stepName: string; // e.g., "Compliance Review", "Manager Approval", "Risk Assessment"
  assignedToUserId?: string; // User ID of the person responsible for this step
  roleRequired: UserRole; // Role required to approve this step
  status: ApprovalStatus;
  comments?: string;
  timestamp: string; // ISO 8601 date string
  approvedByUserId?: string;
  order: number; // Order of approval steps
  approvalDueDate?: string;
}

/**
 * Represents an in-app notification for a user.
 */
export enum NotificationType {
  Info = 'INFO',
  Warning = 'WARNING',
  Error = 'ERROR',
  Success = 'SUCCESS',
  ActionRequired = 'ACTION_REQUIRED',
}

export interface INotification {
  id: string;
  userId: string;
  message: string;
  type: NotificationType;
  isRead: boolean;
  timestamp: string; // ISO 8601 date string
  link?: string; // Optional link to related resource
}

/**
 * Represents a user in the system with their roles and permissions.
 */
export enum UserRole {
  Admin = 'ADMIN',
  Approver = 'APPROVER',
  Creator = 'CREATOR',
  Viewer = 'VIEWER',
  Compliance = 'COMPLIANCE',
  Risk = 'RISK',
}

export interface IUser {
  id: string;
  username: string;
  email: string;
  firstName: string;
  lastName: string;
  roles: UserRole[];
  isActive: boolean;
  lastLogin: string; // ISO 8601 date string
  department: string;
  permissions: { [key: string]: boolean }; // Fine-grained permissions
}

