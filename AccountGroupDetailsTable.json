      { id: 'branchId', label: 'Branch ID', type: 'text', sortColumn: 'branchId', viewOptions: { detailsTable: { default: false } }, __typename: 'DisplayColumn' },
      { id: 'relationshipManager', label: 'RM', type: 'association', sortColumn: 'relationshipManager.name', viewOptions: { detailsTable: { default: false } }, displayTypeOptions: { typename: 'AssociationOption', associatedEntityLabelField: 'name' }, __typename: 'DisplayColumn' },
      { id: 'complianceRiskRating', label: 'Compliance Risk', type: 'statusIndicator', sortColumn: 'complianceRiskRating', viewOptions: { detailsTable: { default: false } }, displayTypeOptions: { typename: 'StatusIndicatorOption', statusIndicatorCurrentStatusField: 'complianceRiskRating' }, __typename: 'DisplayColumn' },
    ],
