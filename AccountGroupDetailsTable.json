// --- Mock Data Generation Utilities ---

const CURRENCIES = ['USD', 'EUR', 'GBP', 'JPY', 'CAD', 'AUD', 'CHF'];
const ACCOUNT_TYPES = ['Checking', 'Savings', 'Investment', 'Loan', 'Credit Line', 'Escrow'];
const ACCOUNT_STATUSES = ['Active', 'Inactive', 'Frozen', 'Closed', 'Pending Review'];
const GROUP_STATUSES = ['Operational', 'Under Review', 'Suspended', 'Archived'];
const COMPLIANCE_STATUSES = ['Compliant', 'Non-Compliant', 'Warning', 'Exempt'];
const RISK_SCORES = [1, 2, 3, 4, 5]; // 1 being low risk, 5 being high risk

function getRandomInt(min: number, max: number): number {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

function getRandomFloat(min: number, max: number, decimals: number = 2): number {
  const str = (Math.random() * (max - min) + min).toFixed(decimals);
  return parseFloat(str);
}

function getRandomDate(start: Date, end: Date): string {
  return dayjs(start.getTime() + Math.random() * (end.getTime() - start.getTime())).toISOString();
}

function generateMockInternalAccount(accountId: string, currency: string, associatedClientId: string): InternalAccount {
  const balanceAmount = getRandomFloat(1000, 10000000);
  return {
    typename: 'InternalAccount',
    id: accountId,
    bestName: `Account-${accountId.substring(0, 8)}`,
    path: `/client/${associatedClientId}/account/${accountId}`,
    balance: { amount: balanceAmount.toFixed(2), currency, __typename: 'Amount' },
    status: ACCOUNT_STATUSES[getRandomInt(0, ACCOUNT_STATUSES.length - 1)],
    accountType: ACCOUNT_TYPES[getRandomInt(0, ACCOUNT_TYPES.length - 1)],
    creationDate: getRandomDate(new Date(2010, 0, 1), new Date(2022, 11, 31)),
    lastActivityDate: getRandomDate(new Date(2023, 0, 1), new Date()),
    associatedClientId,
  };
}

function generateMockAccountGroup(id: string): AccountGroupDetailsTableQuery {
  const groupCurrency = CURRENCIES[getRandomInt(0, CURRENCIES.length - 1)];
  const internalAccountCount = getRandomInt(5, 50);
  const associatedClientId = `CL${uuidv4().split('-')[0].toUpperCase()}`;

  const internalAccounts = Array.from({ length: internalAccountCount }).map((_, i) =>
    generateMockInternalAccount(`IA${uuidv4()}`, groupCurrency, associatedClientId)
  );

  const totalBalance = internalAccounts.reduce((sum, acc) => sum + parseFloat(acc.balance?.amount || '0'), 0);

  return {
    accountGroup: {
      name: `Premier Banking Group ${id.substring(0, 8).toUpperCase()}`,
      currency: groupCurrency,
      description: `Comprehensive banking solutions for high-net-worth individuals and corporate clients. This group encompasses ${internalAccountCount} diverse internal accounts designed for optimal financial management and growth.`,
      internalAccountsUnpaginated: internalAccounts,
      internalAccountCount: internalAccountCount,
      groupBalance: { amount: totalBalance.toFixed(2), currency: groupCurrency, __typename: 'Amount' },
      groupStatus: GROUP_STATUSES[getRandomInt(0, GROUP_STATUSES.length - 1)],
      riskScore: RISK_SCORES[getRandomInt(0, RISK_SCORES.length - 1)],
      complianceStatus: COMPLIANCE_STATUSES[getRandomInt(0, COMPLIANCE_STATUSES.length - 1)],
      lastReviewDate: getRandomDate(new Date(2023, 0, 1), new Date()),
      reviewDueDate: getRandomDate(new Date(), dayjs().add(1, 'year').toDate()),
      parentGroupId: Math.random() > 0.7 ? `PG${uuidv4().split('-')[0].toUpperCase()}` : undefined,
      __typename: 'AccountGroup',
    },
    displayColumns: [
      { id: 'id', label: 'Account ID', type: 'text', sortColumn: 'id', viewOptions: { detailsTable: { primaryColumn: true, copyable: true, default: true } }, __typename: 'DisplayColumn' },
      { id: 'bestName', label: 'Account Name', type: 'text', sortColumn: 'bestName', viewOptions: { detailsTable: { default: true } }, __typename: 'DisplayColumn' },
      { id: 'balance', label: 'Current Balance', type: 'amount', sortColumn: 'balance.amount', viewOptions: { detailsTable: { default: true } }, __typename: 'DisplayColumn' },
      { id: 'currency', label: 'Currency', type: 'text', sortColumn: 'currency', viewOptions: { detailsTable: { hideIfNull: true, default: true } }, __typename: 'DisplayColumn' },
      { id: 'status', label: 'Status', type: 'statusIndicator', sortColumn: 'status', displayTypeOptions: { typename: 'StatusIndicatorOption', statusIndicatorCurrentStatusField: 'status' }, viewOptions: { detailsTable: { default: true } }, __typename: 'DisplayColumn' },
      { id: 'accountType', label: 'Type', type: 'tag', sortColumn: 'accountType', displayTypeOptions: { typename: 'TagOption', tagColorField: 'tagColor', tagIconField: 'tagIcon' }, viewOptions: { detailsTable: { default: true } }, __typename: 'DisplayColumn' },
      { id: 'creationDate', label: 'Created On', type: 'date', sortColumn: 'creationDate', viewOptions: { detailsTable: { default: true } }, __typename: 'DisplayColumn' },
      { id: 'lastActivityDate', label: 'Last Activity', type: 'date', sortColumn: 'lastActivityDate', viewOptions: { detailsTable: { default: true } }, __typename: 'DisplayColumn' },
      { id: 'associatedClientId', label: 'Client ID', type: 'link', sortColumn: 'associatedClientId', displayTypeOptions: { typename: 'LinkOption', displayNameField: 'associatedClientId', openNewTab: true }, viewOptions: { detailsTable: { default: true } }, __typename: 'DisplayColumn' },
      // Adding more potential columns that a bank might use, defaulted to false for demonstration
