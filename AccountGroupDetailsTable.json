      // Mock Transaction Volume (last 6 months)
      const volumeData = Array.from({ length: 6 }).map((_, i) => {
        const date = dayjs().subtract(5 - i, 'month');
        return {
          month: date.format('MMM YY'),
          debits: getRandomFloat(10000, 500000, 0),
          credits: getRandomFloat(15000, 600000, 0),
        };
      });
      setTransactionVolumeData(volumeData);

      setLoading(false);
    }, getRandomInt(800, 1500));
  }, [accountGroup]);

  const PIE_COLORS = ['#0088FE', '#00C49F', '#FFBB28', '#FF8042', '#8884d8', '#82ca9d'];

  if (loading) return <LoadingSpinner />;

  return (
    <div style={styles.card as React.CSSProperties}>
      <h3 style={styles.sectionHeader as React.CSSProperties}>{t('accountGroup.analytics')}</h3>
      <div style={styles.gridTwoColumns as React.CSSProperties}>
        <div style={styles.card as React.CSSProperties}>
          <h4 style={{ ...(TYPOGRAPHY.bodyLarge as React.CSSProperties), marginTop: 0, marginBottom: SPACING.md }}>{t('chart.balanceTrend')}</h4>
          <div style={styles.chartContainer as React.CSSProperties}>
            <ResponsiveContainer width="100%" height="100%">
              <AreaChart data={balanceTrendData} margin={{ top: 10, right: 30, left: 0, bottom: 0 }}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="name" />
                <YAxis tickFormatter={(value) => formatCurrency(value.toFixed(2), accountGroup.currency, locale)} />
                <Tooltip formatter={(value: number) => formatCurrency(value.toFixed(2), accountGroup.currency, locale)} />
