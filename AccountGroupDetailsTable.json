// --- Reusable Components (Built on Design System) ---

export const Button: React.FC<React.ButtonHTMLAttributes<HTMLButtonElement> & { variant?: 'primary' | 'secondary' | 'outline' | 'danger', icon?: string }> = ({ children, variant = 'primary', icon, style, ...props }) => {
  const buttonStyle = useMemo(() => {
    let baseStyle = styles.button as React.CSSProperties; // Cast to bypass dynamic properties
    switch (variant) {
      case 'secondary': baseStyle = { ...baseStyle, ...(styles.buttonSecondary as React.CSSProperties) }; break;
      case 'outline': baseStyle = { ...baseStyle, ...(styles.buttonOutline as React.CSSProperties) }; break;
      case 'danger': baseStyle = { ...baseStyle, ...(styles.buttonDanger as React.CSSProperties) }; break;
      default: baseStyle = { ...baseStyle, ...(styles.buttonPrimary as React.CSSProperties) }; break;
    }
    return { ...baseStyle, ...style };
  }, [variant, style]);

  return (
    <button style={buttonStyle} {...props}>
      {icon && <Icon name={icon} />}
      {children}
    </button>
  );
};

export const Input: React.FC<React.InputHTMLAttributes<HTMLInputElement> & { label?: string }> = ({ label, id, style, ...props }) => {
