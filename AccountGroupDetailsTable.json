export const Modal: React.FC<{
  title: string;
  isOpen: boolean;
  onClose: () => void;
  children: React.ReactNode;
  width?: string;
}> = ({ title, isOpen, onClose, children, width }) => {
  if (!isOpen) return null;

  const modalStyle = width ? { ...(styles.modalContent as React.CSSProperties), width, maxWidth: '90%' } : (styles.modalContent as React.CSSProperties);

  return createPortal(
    <div style={styles.modalOverlay as React.CSSProperties} onClick={onClose}>
      <div style={modalStyle} onClick={e => e.stopPropagation()}>
        <div style={styles.modalHeader as React.CSSProperties}>
          <span>{title}</span>
          <button style={styles.modalCloseButton as React.CSSProperties} onClick={onClose}><Icon name="close" /></button>
        </div>
        {children}
      </div>
    </div>,
    document.body // Or a specific modal root element
  );
};

export const NotificationCenter: React.FC = () => {
  const { state, dispatch } = useAppContext();

  useEffect(() => {
    if (state.notifications.length > 0) {
      const timer = setTimeout(() => {
        dispatch({ type: 'CLEAR_NOTIFICATIONS' });
      }, 5000); // Clear after 5 seconds
      return () => clearTimeout(timer);
    }
  }, [state.notifications, dispatch]);

  return (
    <div style={styles.notificationCenter as React.CSSProperties}>
      {state.notifications.map((notification, index) => (
        <div key={index} style={styles.notificationItem('info') as React.CSSProperties}> {/* Default to info, can be extended to handle types */}
          <span><Icon name="info" /> {notification}</span>
          <button style={{ background: 'none', border: 'none', color: COLORS.light, cursor: 'pointer' }} onClick={() => dispatch({ type: 'CLEAR_NOTIFICATIONS' })}><Icon name="close" /></button>
        </div>
      ))}
    </div>
  );
};

export const StatusPill: React.FC<{ status: string }> = ({ status }) => (
  <span style={styles.statusIndicator(status) as React.CSSProperties}>{status}</span>
);

export const RiskPill: React.FC<{ score: number }> = ({ score }) => {
  const { t } = useTranslation();
  let label = '';
  if (score === 1) label = t('risk.level.low');
  else if (score >= 2 && score <= 3) label = t('risk.level.medium');
  else if (score >= 4 && score <= 5) label = t('risk.level.high');
  return <span style={styles.riskScoreIndicator(score) as React.CSSProperties}>{label} ({score})</span>;
};

// Data Formatting Utilities
export const formatCurrency = (amount: string, currency: string, locale: string = APP_CONFIG.DEFAULT_LOCALE): string => {
  try {
    return new Intl.NumberFormat(locale, { style: 'currency', currency }).format(parseFloat(amount));
  } catch (e) {
    return `${amount} ${currency}`; // Fallback
  }
};

export const formatDate = (dateString: string, locale: string = APP_CONFIG.DEFAULT_LOCALE): string => {
  if (!dateString) return 'N/A';
  return dayjs(dateString).locale(locale).format('LLL'); // Localized date and time
};

export const formatRelativeTime = (dateString: string): string => {
  if (!dateString) return 'N/A';
  return dayjs(dateString).fromNow();
};


// --- Complex Sub-Components ---

interface SortConfig<T> {
  key: keyof T;
  direction: 'asc' | 'desc';
}

export interface DataTableColumn<T> {
  id: string;
  label: string;
  accessor: keyof T | ((row: T) => React.ReactNode);
  sortable?: boolean;
  render?: (row: T) => React.ReactNode;
  headerRender?: (column: DataTableColumn<T>, currentSort: SortConfig<T> | null, onSort: (key: keyof T) => void) => React.ReactNode;
  width?: string;
}

export interface DataTableProps<T> {
  data: T[];
  columns: DataTableColumn<T>[];
  pageSize?: number;
  currentPage?: number;
  onPageChange?: (page: number) => void;
  onSort?: (sort: SortConfig<T>) => void;
  sortConfig?: SortConfig<T> | null;
  loading?: boolean;
  emptyMessage?: string;
  toolbar?: React.ReactNode;
  totalRows?: number; // For server-side pagination
}

export const DataTable = <T extends Record<string, any>>({
  data,
  columns,
  pageSize = APP_CONFIG.DEFAULT_PAGE_SIZE,
  currentPage = 1,
  onPageChange,
  onSort,
  sortConfig,
  loading,
  emptyMessage,
  toolbar,
  totalRows,
}: DataTableProps<T>) => {
  const { t } = useTranslation();
  const [internalPage, setInternalPage] = useState(currentPage);
  const [internalSortConfig, setInternalSortConfig] = useState<SortConfig<T> | null>(sortConfig || null);

  useEffect(() => {
    setInternalPage(currentPage);
  }, [currentPage]);

  useEffect(() => {
    setInternalSortConfig(sortConfig);
  }, [sortConfig]);

  const handleSort = (key: keyof T) => {
    let direction: 'asc' | 'desc' = 'asc';
    if (internalSortConfig && internalSortConfig.key === key && internalSortConfig.direction === 'asc') {
      direction = 'desc';
    }
    const newSortConfig = { key, direction };
    setInternalSortConfig(newSortConfig);
    onSort?.(newSortConfig); // Notify parent if onSort is provided
  };

  const currentData = useMemo(() => {
    if (onPageChange || onSort) { // Server-side pagination/sorting
      return data;
    }

    // Client-side pagination and sorting
    let sortableData = [...data];
    if (internalSortConfig) {
      sortableData.sort((a, b) => {
        const aValue = a[internalSortConfig.key];
        const bValue = b[internalSortConfig.key];
        if (typeof aValue === 'string' && typeof bValue === 'string') {
          return internalSortConfig.direction === 'asc' ? aValue.localeCompare(bValue) : bValue.localeCompare(aValue);
        }
        if (typeof aValue === 'number' && typeof bValue === 'number') {
          return internalSortConfig.direction === 'asc' ? aValue - bValue : bValue - aValue;
        }
        // Fallback for other types or complex objects
        return 0;
      });
    }

    const startIndex = (internalPage - 1) * pageSize;
    const endIndex = startIndex + pageSize;
    return sortableData.slice(startIndex, endIndex);
  }, [data, internalPage, pageSize, internalSortConfig, onPageChange, onSort]);

  const totalPages = totalRows ? Math.ceil(totalRows / pageSize) : Math.ceil(data.length / pageSize);
  const displayTotal = totalRows ?? data.length;

  const handlePageChange = (newPage: number) => {
    if (newPage > 0 && newPage <= totalPages) {
      setInternalPage(newPage);
      onPageChange?.(newPage);
    }
  };

  const getCellValue = (row: T, accessor: keyof T | ((row: T) => React.ReactNode)): React.ReactNode => {
    if (typeof accessor === 'function') {
      return accessor(row);
    }
    const value = row[accessor];
    if (typeof value === 'object' && value !== null && 'amount' in value && 'currency' in value) {
      return formatCurrency((value as Amount).amount, (value as Amount).currency);
    }
    return value;
  };

  if (loading) {
    return <LoadingSpinner />;
  }

  if (data.length === 0 && !loading) {
    return <div style={styles.emptyState as React.CSSProperties}>{emptyMessage || t('empty.data')}</div>;
  }

  return (
    <div style={styles.tableContainer as React.CSSProperties}>
      {toolbar && <div style={styles.toolbar as React.CSSProperties}>{toolbar}</div>}
      <table style={styles.table as React.CSSProperties}>
        <thead>
          <tr>
            {columns.map(column => (
              <th
                key={column.id}
                style={{
                  ...(styles.th as React.CSSProperties),
                  width: column.width,
                  ...(column.sortable ? { cursor: 'pointer' } : {}),
                }}
                onClick={() => column.sortable && handleSort(column.accessor as keyof T)}
              >
                {column.headerRender
                  ? column.headerRender(column, internalSortConfig, handleSort)
                  : (
                    <>
                      {column.label}
                      {column.sortable && internalSortConfig && internalSortConfig.key === column.accessor && (
                        <span style={{ marginLeft: SPACING.xs }}>
                          {internalSortConfig.direction === 'asc' ? '⬆️' : '⬇️'}
                        </span>
                      )}
                    </>
                  )}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {currentData.map((row, rowIndex) => (
            <tr key={rowIndex} style={styles.tr as React.CSSProperties}>
              {columns.map(column => (
                <td key={column.id} style={{ ...(styles.td as React.CSSProperties), width: column.width }}>
                  {column.render ? column.render(row) : getCellValue(row, column.accessor)}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      {(onPageChange || data.length > pageSize) && (
        <div style={styles.pagination as React.CSSProperties}>
          <Button
            variant="outline"
            onClick={() => handlePageChange(internalPage - 1)}
            disabled={internalPage === 1}
            style={styles.paginationButton as React.CSSProperties}
          >
            Prev
          </Button>
          <span style={styles.paginationInfo as React.CSSProperties}>
            Page {internalPage} of {totalPages} ({displayTotal} {displayTotal === 1 ? 'item' : 'items'})
          </span>
          <Button
            variant="outline"
            onClick={() => handlePageChange(internalPage + 1)}
            disabled={internalPage === totalPages}
            style={styles.paginationButton as React.CSSProperties}
          >
            Next
          </Button>
        </div>
      )}
    </div>
  );
};


interface AuditLogEntry {
  id: string;
  timestamp: string;
  user: string;
  action: string;
  entityId: string;
  entityType: string;
  details: Record<string, any>;
}

function generateMockAuditLogs(entityId: string, count: number = 10): AuditLogEntry[] {
  const actions = [
    'ACCOUNT_GROUP_UPDATED',
    'INTERNAL_ACCOUNT_ADDED',
    'DESCRIPTION_CHANGED',
    'RISK_SCORE_ADJUSTED',
    'COMPLIANCE_REVIEW_COMPLETED',
    'STATUS_CHANGED',
  ];
  const users = ['john.doe', 'jane.smith', 'admin'];
  const logs: AuditLogEntry[] = [];

  for (let i = 0; i < count; i++) {
    const action = actions[getRandomInt(0, actions.length - 1)];
    const details: Record<string, any> = {};

    switch (action) {
      case 'ACCOUNT_GROUP_UPDATED':
        details.field = 'name';
        details.oldValue = 'Old Name';
        details.newValue = 'New Name';
        break;
      case 'INTERNAL_ACCOUNT_ADDED':
        details.accountId = `IA${uuidv4().substring(0, 8)}`;
        details.accountName = `New Account ${i}`;
        break;
      case 'DESCRIPTION_CHANGED':
        details.oldDescription = 'Old description...';
        details.newDescription = 'Updated description.';
        break;
      case 'RISK_SCORE_ADJUSTED':
        details.oldScore = getRandomInt(1, 4);
        details.newScore = getRandomInt(details.oldScore + 1, 5);
        break;
      case 'COMPLIANCE_REVIEW_COMPLETED':
        details.reviewer = users[getRandomInt(0, users.length - 1)];
        details.status = COMPLIANCE_STATUSES[getRandomInt(0, COMPLIANCE_STATUSES.length - 1)];
        break;
      case 'STATUS_CHANGED':
        details.oldStatus = GROUP_STATUSES[getRandomInt(0, GROUP_STATUSES.length - 2)];
        details.newStatus = GROUP_STATUSES[getRandomInt(0, GROUP_STATUSES.length - 1)];
        break;
    }

    logs.push({
      id: `AL${uuidv4()}`,
      timestamp: getRandomDate(dayjs().subtract(3, 'months').toDate(), new Date()),
      user: users[getRandomInt(0, users.length - 1)],
      action,
      entityId,
      entityType: 'AccountGroup',
      details,
    });
  }
  return logs.sort((a, b) => dayjs(b.timestamp).valueOf() - dayjs(a.timestamp).valueOf());
}


export const AuditLogViewer: React.FC<{ entityId: string }> = ({ entityId }) => {
  const { t, locale } = useTranslation();
  const [logs, setLogs] = useState<AuditLogEntry[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [selectedLog, setSelectedLog] = useState<AuditLogEntry | null>(null);

  useEffect(() => {
    setLoading(true);
    setError(null);
    setTimeout(() => {
      try {
        const mockLogs = generateMockAuditLogs(entityId, getRandomInt(20, 50));
        setLogs(mockLogs);
      } catch (e: any) {
        setError(e.message || t('notification.error.general'));
      } finally {
        setLoading(false);
      }
    }, getRandomInt(300, 800));
  }, [entityId, t]);

  const columns: DataTableColumn<AuditLogEntry>[] = useMemo(() => [
    { id: 'timestamp', label: t('auditLog.timestamp'), accessor: 'timestamp', sortable: true, render: (row) => formatDate(row.timestamp, locale) },
    { id: 'user', label: t('auditLog.user'), accessor: 'user', sortable: true, width: '100px' },
    { id: 'action', label: t('auditLog.action'), accessor: 'action', sortable: true, width: '150px' },
    { id: 'summary', label: t('auditLog.details'), accessor: (row) => {
        // Generate a human-readable summary
        switch (row.action) {
          case 'ACCOUNT_GROUP_UPDATED': return `Updated '${row.details.field}' from '${row.details.oldValue}' to '${row.details.newValue}'`;
          case 'INTERNAL_ACCOUNT_ADDED': return `Added account '${row.details.accountName}' (ID: ${row.details.accountId})`;
          case 'DESCRIPTION_CHANGED': return `Description changed`;
          case 'RISK_SCORE_ADJUSTED': return `Risk score adjusted from ${row.details.oldScore} to ${row.details.newScore}`;
          case 'COMPLIANCE_REVIEW_COMPLETED': return `Compliance review completed with status '${row.details.status}' by ${row.details.reviewer}`;
          case 'STATUS_CHANGED': return `Status changed from '${row.details.oldStatus}' to '${row.details.newStatus}'`;
          default: return JSON.stringify(row.details);
        }
      }
    },
    {
      id: 'actions', label: t('table.actions'), accessor: 'id', width: '80px', render: (row) => (
        <Button variant="outline" size="sm" onClick={() => setSelectedLog(row)}>
          <Icon name="view" style={{ fontSize: '0.8em' }} /> {t('auditLog.viewDetails')}
        </Button>
      ),
    },
  ], [t, locale]);

  return (
    <div style={styles.card as React.CSSProperties}>
      <h4 style={{ ...(TYPOGRAPHY.bodyLarge as React.CSSProperties), margin: 0, marginBottom: SPACING.md }}>{t('auditLog.title')}</h4>
      {error && <ErrorMessage message={error} />}
      <DataTable
        data={logs}
        columns={columns}
        loading={loading}
        emptyMessage={t('empty.auditLogs')}
        pageSize={5}
      />
      <Modal
        title={`${t('auditLog.details')} - ${selectedLog?.action}`}
        isOpen={!!selectedLog}
        onClose={() => setSelectedLog(null)}
        width="600px"
      >
        {selectedLog && (
          <div>
            <p style={TYPOGRAPHY.bodyMedium as React.CSSProperties}><strong>{t('auditLog.timestamp')}:</strong> {formatDate(selectedLog.timestamp, locale)}</p>
            <p style={TYPOGRAPHY.bodyMedium as React.CSSProperties}><strong>{t('auditLog.user')}:</strong> {selectedLog.user}</p>
            <p style={TYPOGRAPHY.bodyMedium as React.CSSProperties}><strong>{t('auditLog.action')}:</strong> {selectedLog.action}</p>
            <p style={TYPOGRAPHY.bodyMedium as React.CSSProperties}><strong>{t('auditLog.entityType')}:</strong> {selectedLog.entityType} (ID: {selectedLog.entityId})</p>
            <h5 style={{ ...(TYPOGRAPHY.bodyMedium as React.CSSProperties), fontWeight: 600, marginTop: SPACING.md }}>Raw Details:</h5>
            <pre style={{ ...(styles.background as React.CSSProperties), padding: SPACING.sm, borderRadius: BORDER_RADIUS, overflowX: 'auto', ...(TYPOGRAPHY.bodySmall as React.CSSProperties) }}>
              {JSON.stringify(selectedLog.details, null, 2)}
            </pre>
          </div>
        )}
      </Modal>
    </div>
  );
};


interface Transaction {
  id: string;
  date: string;
  description: string;
  amount: Amount;
  type: 'Debit' | 'Credit';
  status: 'Completed' | 'Pending' | 'Failed';
  accountId: string;
  counterparty: string;
}

function generateMockTransactions(internalAccounts: InternalAccount[], count: number = 20): Transaction[] {
  const transactions: Transaction[] = [];
  const descriptions = [
    'Wire Transfer', 'ACH Deposit', 'POS Purchase', 'ATM Withdrawal',
    'Payroll Deposit', 'Service Fee', 'Interest Payment', 'Online Payment',
    'Inter-account Transfer', 'Foreign Exchange',
  ];
  const counterparties = [
    'Global Corp Inc.', 'Mega Retail Solutions', 'Digital Innovations LLC',
    'Govt. Tax Authority', 'Employee Salaries', 'Vendor Payments', 'Client X',
    'Bank Y', 'Forex Trading Desk', 'Internal Transfer',
  ];

  for (let i = 0; i < count; i++) {
    const account = internalAccounts[getRandomInt(0, internalAccounts.length - 1)];
    if (!account) continue;

    const amountValue = getRandomFloat(10, 50000);
    const type = Math.random() > 0.5 ? 'Debit' : 'Credit';
    const status = ['Completed', 'Pending', 'Failed'][getRandomInt(0, 2)] as 'Completed' | 'Pending' | 'Failed';

    transactions.push({
      id: `TX${uuidv4()}`,
      date: getRandomDate(dayjs().subtract(3, 'months').toDate(), new Date()),
      description: descriptions[getRandomInt(0, descriptions.length - 1)],
      amount: { amount: amountValue.toFixed(2), currency: account.balance?.currency || 'USD', __typename: 'Amount' },
      type,
      status,
      accountId: account.id,
      counterparty: counterparties[getRandomInt(0, counterparties.length - 1)],
    });
  }
  return transactions.sort((a, b) => dayjs(b.date).valueOf() - dayjs(a.date).valueOf());
}


export const TransactionHistory: React.FC<{ internalAccounts: InternalAccount[] }> = ({ internalAccounts }) => {
  const { t, locale } = useTranslation();
  const [transactions, setTransactions] = useState<Transaction[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [filterAccount, setFilterAccount] = useState<string>('');
  const [filterType, setFilterType] = useState<string>('');
  const [searchTerm, setSearchTerm] = useState<string>('');
  const [currentPage, setCurrentPage] = useState(1);
  const pageSize = useAppContext().state.user?.preferences.pageSize || APP_CONFIG.DEFAULT_PAGE_SIZE;

  useEffect(() => {
    setLoading(true);
    setError(null);
    setTimeout(() => {
      try {
        const mockTxs = generateMockTransactions(internalAccounts, getRandomInt(50, 200));
        setTransactions(mockTxs);
      } catch (e: any) {
        setError(e.message || t('notification.error.general'));
      } finally {
        setLoading(false);
      }
    }, getRandomInt(300, 800));
  }, [internalAccounts, t]);

  const filteredTransactions = useMemo(() => {
    let filtered = transactions;
    if (filterAccount) {
      filtered = filtered.filter(tx => tx.accountId === filterAccount);
    }
    if (filterType) {
      filtered = filtered.filter(tx => tx.type === filterType);
    }
    if (searchTerm) {
      const lowerSearchTerm = searchTerm.toLowerCase();
      filtered = filtered.filter(tx =>
        tx.description.toLowerCase().includes(lowerSearchTerm) ||
        tx.counterparty.toLowerCase().includes(lowerSearchTerm) ||
        tx.id.toLowerCase().includes(lowerSearchTerm) ||
        tx.accountId.toLowerCase().includes(lowerSearchTerm)
      );
    }
    return filtered;
  }, [transactions, filterAccount, filterType, searchTerm]);

  const columns: DataTableColumn<Transaction>[] = useMemo(() => [
    { id: 'date', label: t('table.column.date'), accessor: 'date', sortable: true, render: (row) => formatDate(row.date, locale) },
    { id: 'description', label: t('label.description'), accessor: 'description', width: '200px' },
    { id: 'amount', label: t('table.column.balance'), accessor: 'amount', sortable: true, render: (row) => <span style={{ color: row.type === 'Debit' ? COLORS.danger : COLORS.success, fontWeight: 500 }}>{row.type === 'Debit' ? '-' : '+'}{formatCurrency(row.amount.amount, row.amount.currency, locale)}</span> },
    { id: 'type', label: t('table.column.type'), accessor: 'type', render: (row) => <StatusPill status={row.type} /> },
    { id: 'status', label: t('table.column.status'), accessor: 'status', render: (row) => <StatusPill status={row.status} /> },
    { id: 'counterparty', label: 'Counterparty', accessor: 'counterparty' },
    { id: 'accountId', label: 'Account ID', accessor: 'accountId', render: (row) => <a href={`#account-${row.accountId}`} style={{ color: COLORS.accentBlue }}>{row.accountId.substring(0, 8)}...</a> },
  ], [t, locale]);

  const accountOptions = useMemo(() => [
    { value: '', label: 'All Accounts' },
    ...internalAccounts.map(acc => ({ value: acc.id, label: `${acc.bestName} (${acc.id.substring(0, 8)}...)` }))
  ], [internalAccounts]);

  const typeOptions = useMemo(() => [
    { value: '', label: 'All Types' },
    { value: 'Debit', label: 'Debit' },
    { value: 'Credit', label: 'Credit' },
  ], []);

  return (
    <div style={styles.card as React.CSSProperties}>
      <h3 style={styles.sectionHeader as React.CSSProperties}>{t('accountGroup.transactions')}</h3>
      {error && <ErrorMessage message={error} />}
      <DataTable
        data={filteredTransactions}
        columns={columns}
        loading={loading}
        emptyMessage={t('empty.transactions')}
        pageSize={pageSize}
        currentPage={currentPage}
        onPageChange={setCurrentPage}
        totalRows={filteredTransactions.length}
        toolbar={
          <div style={styles.toolbar as React.CSSProperties}>
            <Input
              type="search"
              placeholder={t('search.placeholder')}
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              style={{ width: '250px' }}
            />
            <Select
              options={accountOptions}
              value={filterAccount}
              onChange={(e) => {
                setFilterAccount(e.target.value);
                setCurrentPage(1);
              }}
              style={{ width: '200px' }}
            />
            <Select
              options={typeOptions}
              value={filterType}
              onChange={(e) => {
                setFilterType(e.target.value);
                setCurrentPage(1);
              }}
              style={{ width: '150px' }}
            />
            <div style={styles.toolbarActions as React.CSSProperties}>
              <Button variant="outline" icon="refresh" onClick={() => {
                setLoading(true);
                setTimeout(() => {
                  setTransactions(generateMockTransactions(internalAccounts, getRandomInt(50, 200)));
                  setLoading(false);
                }, 500);
              }}>{t('refresh')}</Button>
              <Button variant="primary" icon="export">{t('button.export')}</Button>
            </div>
          </div>
        }
      />
    </div>
  );
};


