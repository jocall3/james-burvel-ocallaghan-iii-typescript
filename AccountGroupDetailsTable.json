const GQL_ACCOUNT_GROUP_DETAILS_TABLE = `
  query AccountGroupDetailsTable($id: ID!) {
    accountGroup(id: $id) {
      name
      currency
      description
      internalAccountsUnpaginated {
        typename: __typename
        id
        bestName
        path
        balance {
          amount
          currency
          __typename
        }
        status
        accountType
        creationDate
        lastActivityDate
        associatedClientId
      }
      internalAccountCount
      groupBalance {
        amount
        currency
        __typename
      }
      groupStatus
      riskScore
      complianceStatus
      lastReviewDate
      reviewDueDate
      parentGroupId
      __typename
    }
    displayColumns(resource: account_group, viewType: "details_table") {
      ...displayColumn
      __typename
    }
  }

  fragment displayColumn on DisplayColumn {
    viewOptions {
      detailsTable {
        hideIfNull
        copyable
        default
        primaryColumn
        __typename
      }
      listView {
        default
        label
        __typename
      }
      __typename
    }
    label
    id
    type
    resource
    sortColumn
    displayTypeOptions {
      ... on AssociationOption {
        typename: __typename
        associatedEntityLabelField
        associatedEntityLabelFieldType
        drawerEnabled
        linkEnabled
      }
      ... on AssociationListOption {
        typename: __typename
        associatedEntityLabelField
        associatedEntityLabelFieldType
        drawerEnabled
        linkEnabled
      }
      ... on PolymorphicAssociationOption {
        associationPrefix
        drawerEnabled
        stackedDrawerEnabled
        __typename
      }
      ... on AuditableJSONOption {
        auditableFieldName
        __typename
      }
      ... on CountdownOption {
        countdownType
        __typename
      }
      ... on LabelWithCountOption {
        countField
        prettyCountField
        truncateMiddle
        __typename
      }
      ... on AmountDifferenceOption {
        highlightAmountDifferenceField
        __typename
      }
      ... on StatusIndicatorOption {
        statusIndicatorCurrentStatusField
        statusIndicatorDescriptorField
        statusIndicatorVerboseField
        __typename
      }
      ... on TagOption {
        tagColorField
        tagIconField
        __typename
      }
      ... on TagButtonListOption {
        tagButtonColorsField
        tagButtonIconsField
        tagButtonHrefsField
        tagButtonTooltipsField
