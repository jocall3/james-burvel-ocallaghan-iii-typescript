export const useTranslation = () => {
  const { state } = useAppContext();
  const locale = state.user?.preferences.locale || APP_CONFIG.DEFAULT_LOCALE;

  const t = (key: string, replacements?: Record<string, string | number>) => {
    let message = translations[locale]?.[key] || translations[APP_CONFIG.DEFAULT_LOCALE]?.[key] || key;
    if (replacements) {
      for (const [k, v] of Object.entries(replacements)) {
        message = message.replace(`{${k}}`, String(v));
      }
    }
    return message;
  };
  return { t, locale };
};

