export const AccountGroupSettings: React.FC<{ accountGroup: AccountGroup, onUpdate: (updatedGroup: Partial<AccountGroup>) => void, initialDisplayColumns: DisplayColumn[] }> = ({ accountGroup, onUpdate, initialDisplayColumns }) => {
  const { t, locale } = useTranslation();
  const { dispatch } = useAppContext();
  const [name, setName] = useState(accountGroup.name);
  const [description, setDescription] = useState(accountGroup.description || '');
  const [currency, setCurrency] = useState(accountGroup.currency);
  const [status, setStatus] = useState(accountGroup.groupStatus || '');
  const [riskScore, setRiskScore] = useState(String(accountGroup.riskScore || ''));
  const [complianceStatus, setComplianceStatus] = useState(accountGroup.complianceStatus || '');
  const [isSaving, setIsSaving] = useState(false);

  useEffect(() => {
    setName(accountGroup.name);
    setDescription(accountGroup.description || '');
    setCurrency(accountGroup.currency);
    setStatus(accountGroup.groupStatus || '');
    setRiskScore(String(accountGroup.riskScore || ''));
    setComplianceStatus(accountGroup.complianceStatus || '');
  }, [accountGroup]);

  const handleSave = async () => {
    setIsSaving(true);
    // Simulate API call
    await new Promise(resolve => setTimeout(resolve, 1000));
    try {
      const updatedGroup: Partial<AccountGroup> = {
        name,
        description,
        currency,
        groupStatus: status,
        riskScore: parseInt(riskScore, 10),
        complianceStatus,
      };
      onUpdate(updatedGroup);
      dispatch({ type: 'ADD_NOTIFICATION', payload: t('notification.success.update') });
    } catch (error) {
      console.error("Failed to update account group:", error);
      dispatch({ type: 'ADD_NOTIFICATION', payload: t('notification.error.general') });
    } finally {
      setIsSaving(false);
    }
  };

  const statusOptions = useMemo(() => GROUP_STATUSES.map(s => ({ value: s, label: s })), []);
  const riskOptions = useMemo(() => RISK_SCORES.map(s => ({ value: String(s), label: String(s) })), []);
  const complianceOptions = useMemo(() => COMPLIANCE_STATUSES.map(s => ({ value: s, label: s })), []);
  const currencyOptions = useMemo(() => CURRENCIES.map(c => ({ value: c, label: c })), []);


  // --- Display Column Management (New feature to satisfy "make it 1000x longer") ---
  const [displayColumnsConfig, setDisplayColumnsConfig] = useState<DisplayColumn[]>(initialDisplayColumns);

  useEffect(() => {
    setDisplayColumnsConfig(initialDisplayColumns);
  }, [initialDisplayColumns]);

  const handleColumnVisibilityToggle = (columnId: string) => {
    setDisplayColumnsConfig(prev =>
      prev.map(col =>
        col.id === columnId
          ? { ...col, viewOptions: { ...col.viewOptions, detailsTable: { ...col.viewOptions?.detailsTable, default: !col.viewOptions?.detailsTable?.default } } }
          : col
      )
    );
  };

  const handleColumnOrderChange = (columnId: string, direction: 'up' | 'down') => {
    setDisplayColumnsConfig(prev => {
      const index = prev.findIndex(col => col.id === columnId);
      if (index === -1) return prev;

      const newArr = [...prev];
      if (direction === 'up' && index > 0) {
        [newArr[index - 1], newArr[index]] = [newArr[index], newArr[index - 1]];
      } else if (direction === 'down' && index < newArr.length - 1) {
        [newArr[index + 1], newArr[index]] = [newArr[index], newArr[index + 1]];
      }
      return newArr;
    });
  };

  const handleSaveColumnConfig = async () => {
    setIsSaving(true);
    await new Promise(resolve => setTimeout(resolve, 800)); // Simulate API call
    // In a real app, this would send `displayColumnsConfig` to a backend API
    dispatch({ type: 'ADD_NOTIFICATION', payload: "Display columns configuration saved!" });
    setIsSaving(false);
  };

  const handleResetColumnConfig = () => {
    // Reset to initial mock columns, assuming these are the "defaults"
    const defaultCols = generateMockAccountGroup(accountGroup.id).displayColumns;
    setDisplayColumnsConfig(defaultCols);
    dispatch({ type: 'ADD_NOTIFICATION', payload: "Display columns reset to default." });
  };
  // --- End Display Column Management ---


  return (
    <div style={styles.card as React.CSSProperties}>
      <h3 style={styles.sectionHeader as React.CSSProperties}>{t('accountGroup.settings')}</h3>

      <div style={styles.card as React.CSSProperties}>
        <h4 style={{ ...(TYPOGRAPHY.bodyLarge as React.CSSProperties), marginTop: 0, marginBottom: SPACING.md }}>General Group Information</h4>
        <Input label={t('label.name')} id="groupName" value={name} onChange={(e) => setName(e.target.value)} />
        <TextArea label={t('label.description')} id="groupDescription" value={description} onChange={(e) => setDescription(e.target.value)} />
        <div style={styles.gridTwoColumns as React.CSSProperties}>
          <Select label={t('label.currency')} id="groupCurrency" value={currency} options={currencyOptions} onChange={(e) => setCurrency(e.target.value as string)} />
          <Select label={t('label.status')} id="groupStatus" value={status} options={statusOptions} onChange={(e) => setStatus(e.target.value)} />
        </div>
        <div style={styles.gridTwoColumns as React.CSSProperties}>
          <Select label={t('label.riskScore')} id="groupRiskScore" value={riskScore} options={riskOptions} onChange={(e) => setRiskScore(e.target.value)} />
          <Select label={t('label.complianceStatus')} id="groupComplianceStatus" value={complianceStatus} options={complianceOptions} onChange={(e) => setComplianceStatus(e.target.value)} />
        </div>
        <div style={styles.buttonGroup as React.CSSProperties}>
          <Button onClick={handleSave} disabled={isSaving}>
            {isSaving ? 'Saving...' : t('settings.columnManager.save')}
          </Button>
        </div>
      </div>

      <div style={styles.card as React.CSSProperties}>
        <h4 style={{ ...(TYPOGRAPHY.bodyLarge as React.CSSProperties), marginTop: 0, marginBottom: SPACING.md }}>{t('label.internalAccountSettings')}</h4>
        <p style={TYPOGRAPHY.bodyMedium as React.CSSProperties}>
          Configure specific settings related to internal accounts within this group, such as default transaction limits,
          reporting preferences, or integration hooks.
        </p>
        <div style={styles.formGroup as React.CSSProperties}>
          <label style={styles.label as React.CSSProperties}>Default Transaction Limit (USD)</label>
          <Input type="number" placeholder="100000" />
        </div>
        <div style={styles.formGroup as React.CSSProperties}>
          <label style={styles.label as React.CSSProperties}>Real-time Transaction Notifications</label>
          <input type="checkbox" style={{ marginLeft: SPACING.xs }} /> Enable
        </div>
        <Button onClick={() => alert('Internal Account Settings Saved!')} style={{ marginTop: SPACING.md }}>Save Internal Account Settings</Button>
      </div>

      <div style={styles.card as React.CSSProperties}>
        <h4 style={{ ...(TYPOGRAPHY.bodyLarge as React.CSSProperties), marginTop: 0, marginBottom: SPACING.md }}>{t('settings.columnManager.title')}</h4>
        <p style={TYPOGRAPHY.bodyMedium as React.CSSProperties}>
          Customize which columns are visible in the internal accounts table and their display order.
          Changes here will reflect across all users in your department, unless overridden by personal preferences.
        </p>
        <div style={{ maxHeight: '300px', overflowY: 'auto', border: `1px solid ${COLORS.border}`, borderRadius: BORDER_RADIUS, marginBottom: SPACING.md }}>
          <table style={{ ...(styles.table as React.CSSProperties), boxShadow: 'none' }}>
            <thead>
              <tr>
                <th style={{ ...(styles.th as React.CSSProperties), width: '50px' }}>{t('settings.columnManager.order')}</th>
                <th style={styles.th as React.CSSProperties}>{t('settings.columnManager.column')}</th>
                <th style={{ ...(styles.th as React.CSSProperties), width: '80px' }}>{t('settings.columnManager.visible')}</th>
                <th style={{ ...(styles.th as React.CSSProperties), width: '100px' }}>Actions</th>
              </tr>
            </thead>
            <tbody>
              {displayColumnsConfig.map((col, index) => (
                <tr key={col.id} style={styles.tr as React.CSSProperties}>
                  <td style={styles.td as React.CSSProperties}>{index + 1}</td>
                  <td style={styles.td as React.CSSProperties}>{col.label}</td>
                  <td style={styles.td as React.CSSProperties}>
                    <input
                      type="checkbox"
                      checked={col.viewOptions?.detailsTable?.default || false}
                      onChange={() => handleColumnVisibilityToggle(col.id)}
                    />
                  </td>
                  <td style={styles.td as React.CSSProperties}>
                    <Button
                      variant="outline"
                      size="sm"
                      onClick={() => handleColumnOrderChange(col.id, 'up')}
                      disabled={index === 0}
                      style={{ marginRight: SPACING.xs }}
                    >
                      ▲
                    </Button>
                    <Button
                      variant="outline"
                      size="sm"
                      onClick={() => handleColumnOrderChange(col.id, 'down')}
                      disabled={index === displayColumnsConfig.length - 1}
                    >
                      ▼
                    </Button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div style={styles.buttonGroup as React.CSSProperties}>
          <Button onClick={handleSaveColumnConfig} disabled={isSaving}>{t('settings.columnManager.save')}</Button>
          <Button variant="outline" onClick={handleResetColumnConfig}>{t('settings.columnManager.reset')}</Button>
        </div>
      </div>

      <div style={styles.card as React.CSSProperties}>
        <h4 style={{ ...(TYPOGRAPHY.bodyLarge as React.CSSProperties), marginTop: 0, marginBottom: SPACING.md }}>Security & Access Control</h4>
        <p style={TYPOGRAPHY.bodyMedium as React.CSSProperties}>
          Manage user roles and permissions specific to this account group. Implement multi-factor authentication requirements
          and define data masking rules for sensitive information access.
        </p>
        <Button variant="secondary" onClick={() => alert('Manage Permissions Modal Placeholder')}>Manage Permissions</Button>
        <Button variant="outline" style={{marginLeft: SPACING.md}} onClick={() => alert('View Access Logs Modal Placeholder')}>View Access Logs</Button>
      </div>

      <div style={styles.card as React.CSSProperties}>
        <h4 style={{ ...(TYPOGRAPHY.bodyLarge as React.CSSProperties), marginTop: 0, marginBottom: SPACING.md }}>Archiving & Deletion</h4>
        <p style={TYPOGRAPHY.bodyMedium as React.CSSProperties}>
          Carefully manage the lifecycle of this account group. Archiving will hide it from active views but retain all data.
          Deletion is permanent and requires elevated permissions and multi-level approvals.
        </p>
        <div style={styles.buttonGroup as React.CSSProperties}>
          <Button variant="danger" icon="archive" onClick={() => alert('Archive functionality placeholder')}>Archive Group</Button>
          <Button variant="danger" icon="delete" onClick={() => alert('Delete functionality placeholder')}>Delete Group</Button>
        </div>
        <p style={{...(TYPOGRAPHY.bodySmall as React.CSSProperties), color: COLORS.dark, marginTop: SPACING.md}}>
          Deletion requires a secondary approval from a compliance officer and cannot be undone.
        </p>
      </div>
    </div>
  );
};


// --- Main Application Component ---
export const AccountGroupDetailsTableApp: React.FC<{ accountGroupId: string }> = ({ accountGroupId }) => {
  const { state, dispatch } = useAppContext();
  const { t, locale } = useTranslation();
  const { data, loading, error, refetch } = useGraphQLQuery<AccountGroupDetailsTableQuery, AccountGroupDetailsTableQueryVariables>(
    GQL_ACCOUNT_GROUP_DETAILS_TABLE,
    { id: accountGroupId },
    generateMockAccountGroup
  );

  const [activeTab, setActiveTab] = useState('overview');
  const [showEditModal, setShowEditModal] = useState(false);
  const [showCreateAccountModal, setShowCreateAccountModal] = useState(false);
  const [showConfirmDeleteModal, setShowConfirmDeleteModal] = useState(false);

  // Sync global loading state
  useEffect(() => {
    dispatch({ type: 'SET_GLOBAL_LOADING', payload: loading });
  }, [loading, dispatch]);


  const handleGroupUpdate = useCallback((updatedFields: Partial<AccountGroup>) => {
    if (data) {
      const updatedAccountGroup = { ...data.accountGroup, ...updatedFields };
      // Simulate refetching data after update
      // In a real app, this would trigger a mutation and then a refetch or cache update.
      refetch({ id: accountGroupId });
      setShowEditModal(false);
    }
  }, [data, accountGroupId, refetch]);

  const handleCreateInternalAccount = useCallback(async (newAccountDetails: Omit<InternalAccount, 'id' | 'typename' | 'path' | 'creationDate' | 'lastActivityDate' | 'associatedClientId'>) => {
    if (!data) return;
    dispatch({ type: 'SET_GLOBAL_LOADING', payload: true });
    await new Promise(resolve => setTimeout(resolve, 1000)); // Simulate API call
    const newAccountId = `IA${uuidv4()}`;
    const mockNewAccount: InternalAccount = {
      typename: 'InternalAccount',
      id: newAccountId,
      bestName: newAccountDetails.bestName,
      path: `/client/${data.accountGroup.internalAccountsUnpaginated[0]?.associatedClientId || 'CLUNKNOWN'}/account/${newAccountId}`,
      balance: newAccountDetails.balance || { amount: '0.00', currency: data.accountGroup.currency, __typename: 'Amount' },
      status: newAccountDetails.status || 'Active',
      accountType: newAccountDetails.accountType || 'Checking',
      creationDate: dayjs().toISOString(),
      lastActivityDate: dayjs().toISOString(),
      associatedClientId: data.accountGroup.internalAccountsUnpaginated[0]?.associatedClientId || 'CLUNKNOWN',
    };

    // Optimistically update or refetch
    refetch({ id: accountGroupId }); // A full refetch for simplicity in mock, real app might update cache
    dispatch({ type: 'ADD_NOTIFICATION', payload: t('notification.success.createAccount') });
    dispatch({ type: 'SET_GLOBAL_LOADING', payload: false });
    setShowCreateAccountModal(false);
  }, [data, accountGroupId, refetch, dispatch, t]);

  const internalAccountColumns: DataTableColumn<InternalAccount>[] = useMemo(() => {
    if (!data?.displayColumns) return [];

    return data.displayColumns
      .filter(col => col.viewOptions?.detailsTable?.default !== false) // Only show default columns
      .sort((a, b) => { // Sort based on some arbitrary order for demonstration (e.g., label alphabetically)
        if (a.id === 'id') return -1; // ID always first
        if (b.id === 'id') return 1;
        return a.label.localeCompare(b.label);
      })
      .map(col => {
        const baseColumn: DataTableColumn<InternalAccount> = {
          id: col.id,
          label: col.label,
          accessor: col.id as keyof InternalAccount,
          sortable: col.sortColumn === col.id,
          width: col.id === 'description' ? 'auto' : (col.id === 'id' ? '120px' : '100px'), // Example widths
        };

        // Custom renderers based on column type or displayTypeOptions
        if (col.type === 'amount' && col.id === 'balance') {
          baseColumn.render = (row) => formatCurrency(row.balance?.amount || '0', row.balance?.currency || data.accountGroup.currency, locale);
        } else if (col.type === 'date') {
          baseColumn.render = (row) => {
            const dateValue = (row as any)[col.id]; // Access dynamically
            return dateValue ? formatDate(dateValue, locale) : 'N/A';
          };
        } else if (col.type === 'statusIndicator') {
          baseColumn.render = (row) => {
            const status = (row as any)[col.id];
            return status ? <StatusPill status={status} /> : 'N/A';
          };
        } else if (col.type === 'tag') {
          baseColumn.render = (row) => {
            const tagValue = (row as any)[col.id];
            return tagValue ? <span style={styles.tag as React.CSSProperties}>{tagValue}</span> : 'N/A';
          };
        } else if (col.type === 'link') {
          baseColumn.render = (row) => {
            const linkValue = (row as any)[col.id];
            return linkValue ? <a href={`#${col.id}-${linkValue}`} style={{color: COLORS.accentBlue}}>{linkValue}</a> : 'N/A';
          };
        }
        return baseColumn;
      })
      .concat([
        { // Add actions column for each row
          id: 'actions',
          label: t('table.actions'),
          accessor: 'id',
          width: '100px',
          render: (row) => (
            <div style={{ display: 'flex', gap: SPACING.xs }}>
              <Button variant="outline" size="sm" onClick={() => alert(`Viewing account ${row.bestName} (${row.id})`)}>
                <Icon name="view" style={{ fontSize: '0.8em' }} />
              </Button>
              <Button variant="outline" size="sm" onClick={() => alert(`Editing account ${row.bestName} (${row.id})`)}>
                <Icon name="edit" style={{ fontSize: '0.8em' }} />
              </Button>
            </div>
          ),
        }
      ]);
  }, [data?.displayColumns, data?.accountGroup.currency, t, locale]);


  if (loading) return <LoadingSpinner />;
  if (error) return <ErrorMessage message={`${t('error.fetch')} - ${error.message}`} />;
  if (!data?.accountGroup) return <ErrorMessage message={t('empty.data')} />;

  const accountGroup = data.accountGroup;

  return (
    <div style={styles.appContainer as React.CSSProperties}>
      <header style={styles.header as React.CSSProperties}>
        <h1 style={styles.headerTitle as React.CSSProperties}>{t('app.title')}</h1>
        <div style={{ display: 'flex', alignItems: 'center', gap: SPACING.md }}>
          <span style={TYPOGRAPHY.bodyMedium as React.CSSProperties}>Welcome, {state.user?.name}</span>
          <Select
            options={APP_CONFIG.SUPPORTED_LOCALES.map(loc => ({ value: loc, label: loc }))}
            value={locale}
            onChange={(e) => {
              if (state.user) {
                dispatch({ type: 'SET_USER', payload: { ...state.user, preferences: { ...state.user.preferences, locale: e.target.value } } });
                localStorage.setItem('userPreferences', JSON.stringify({ ...state.user.preferences, locale: e.target.value }));
              }
            }}
            style={{ width: '100px', padding: '5px', border: 'none', borderRadius: BORDER_RADIUS }}
          />
          <Button variant="outline" icon="settings" style={{color: COLORS.light, borderColor: COLORS.light}} onClick={() => alert('User Profile Settings')}>Profile</Button>
        </div>
      </header>
      <div style={styles.mainContent as React.CSSProperties}>
        <aside style={styles.sidebar as React.CSSProperties}>
          <h3 style={{ ...(TYPOGRAPHY.h3 as React.CSSProperties), margin: `${SPACING.sm} 0 ${SPACING.md} 0` }}>
            <Icon name="group" /> {accountGroup.name}
          </h3>
