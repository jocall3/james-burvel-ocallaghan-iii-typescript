/**
 * Utility Functions
 */

export const generateUniqueId = (): ID => Math.random().toString(36).substring(2, 15);

export const formatCurrency = (amount: number, locale: string = APP_CONFIG.defaultLocale): string => {
  return new Intl.NumberFormat(locale, { style: 'currency', currency: 'USD' }).format(amount);
};

export const formatDate = (dateString: DateTime, locale: string = APP_CONFIG.defaultLocale, options?: Intl.DateTimeFormatOptions): string => {
  if (!dateString) return 'N/A';
  try {
    const date = new Date(dateString);
    return new Intl.DateTimeFormat(locale, options).format(date);
  } catch (error) {
    console.error('Invalid date string:', dateString);
    return 'Invalid Date';
  }
};

export const formatDateTime = (dateString: DateTime, locale: string = APP_CONFIG.defaultLocale): string => {
  return formatDate(dateString, locale, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
};

export const getNestedValue = <T>(obj: any, path: string, defaultValue: T | null = null): T | null => {
  const parts = path.split('.');
  let current: any = obj;
  for (const part of parts) {
    if (current === null || typeof current !== 'object' || !(part in current)) {
      return defaultValue;
    }
    current = current[part];
  }
  return current as T;
};

export const deepClone = <T>(obj: T): T => JSON.parse(JSON.stringify(obj));

export const objectDiff = (obj1: JSONObject, obj2: JSONObject): JSONObject => {
  const diff: JSONObject = {};
  for (const key in obj1) {
    if (Object.prototype.hasOwnProperty.call(obj1, key)) {
      if (!Object.prototype.hasOwnProperty.call(obj2, key) || obj1[key] !== obj2[key]) {
        diff[key] = { oldValue: obj1[key], newValue: obj2[key] };
      }
    }
  }
  for (const key in obj2) {
    if (Object.prototype.hasOwnProperty.call(obj2, key)) {
      if (!Object.prototype.hasOwnProperty.call(obj1, key)) {
        diff[key] = { oldValue: undefined, newValue: obj2[key] };
      }
    }
  }
  return diff;
};

