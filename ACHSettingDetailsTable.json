  immediateDestinationName: string; // Name of the destination bank
  createdAt: DateTime;
  updatedAt?: DateTime;
  discardedAt?: DateTime;
  status: ACHStatus;
  achType: ACHSettingType;
  paymentMethod: ACHPaymentMethod;
  originatorType: ACHOriginatorType;
  originatorCompanyId: string; // E.g., Employer Identification Number (EIN)
  originatorCompanyName: string;
  settlementAccount: BankAccountDetails;
  effectiveDate: DateTime;
  expirationDate?: DateTime;
  dailyTransactionLimit?: ACHTransactionLimit;
  monthlyTransactionLimit?: ACHTransactionLimit;
  perTransactionLimit?: ACHTransactionLimit;
  riskAssessment?: ACHRiskAssessment;
  securityProfileId: ID; // Link to a security profile
  approvalWorkflowId?: ID; // Link to an active approval workflow
  lastApprovedBy?: UserProfile;
  lastApprovedAt?: DateTime;
  createdBy: UserProfile;
  isRecurring: boolean;
  recurrencePattern?: string; // E.g., 'WEEKLY', 'MONTHLY_DAY_15'
  memo?: string;
  tags: string[];
  version: number;
  auditTrail: ACHSettingAuditEntry[];
  associatedDocuments: DocumentMetadata[]; // Enhanced feature
  __typename: 'ACHSetting';
}

