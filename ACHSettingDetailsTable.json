/**
 * Type Definitions based on the original GraphQL schema
 */

// Basic GraphQL scalar types (simplified for client-side representation)
export type ID = string;
export type DateTime = string; // ISO 8601 string
export type JSONValue = string | number | boolean | null | JSONObject | JSONArray;
export interface JSONObject {
  [k: string]: JSONValue;
}
export type JSONArray = Array<JSONValue>;

export enum ACHSettingType {
  Outgoing = 'OUTGOING',
  Incoming = 'INCOMING',
  Both = 'BOTH',
}

export enum ACHStatus {
  Active = 'ACTIVE',
  PendingApproval = 'PENDING_APPROVAL',
  Discarded = 'DISCARDED',
  Inactive = 'INACTIVE',
  Expired = 'EXPIRED',
  UnderReview = 'UNDER_REVIEW',
}

export enum ACHPaymentMethod {
  DirectDeposit = 'DIRECT_DEPOSIT',
  DirectPayment = 'DIRECT_PAYMENT',
  Payroll = 'PAYROLL',
  TaxPayment = 'TAX_PAYMENT',
  Other = 'OTHER',
}

export enum ACHOriginatorType {
  Bank = 'BANK',
  Customer = 'CUSTOMER',
  ThirdParty = 'THIRD_PARTY',
}

export enum ACHSettlementAccountType {
  DDA = 'DDA', // Demand Deposit Account
  Savings = 'SAVINGS',
  GL = 'GL', // General Ledger Account
}

export enum PermissionScope {
  GLOBAL = 'GLOBAL',
  ACH_SETTING_CREATE = 'ACH_SETTING_CREATE',
  ACH_SETTING_VIEW = 'ACH_SETTING_VIEW',
  ACH_SETTING_EDIT = 'ACH_SETTING_EDIT',
  ACH_SETTING_DISCARD = 'ACH_SETTING_DISCARD',
  ACH_SETTING_APPROVE = 'ACH_SETTING_APPROVE',
  ACH_SETTING_AUDIT_VIEW = 'ACH_SETTING_AUDIT_VIEW',
  USER_MANAGEMENT = 'USER_MANAGEMENT',
  ROLE_MANAGEMENT = 'ROLE_MANAGEMENT',
  SYSTEM_SETTINGS_EDIT = 'SYSTEM_SETTINGS_EDIT',
  REPORT_GENERATION = 'REPORT_GENERATION',
  // ... many more permissions for a real bank app
}

