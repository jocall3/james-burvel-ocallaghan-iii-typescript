export const Button: React.FC<React.ButtonHTMLAttributes<HTMLButtonElement> & { variant?: 'primary' | 'secondary' | 'danger' | 'ghost' }> = ({
  children,
  className = '',
  variant = 'primary',
  ...props
}) => {
  let baseStyle = 'px-4 py-2 rounded-md font-medium text-sm focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed';
  if (variant === 'primary') baseStyle += ' bg-blue-600 text-white hover:bg-blue-700 focus:ring-blue-500';
  if (variant === 'secondary') baseStyle += ' bg-gray-200 text-gray-800 hover:bg-gray-300 focus:ring-gray-400 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600';
  if (variant === 'danger') baseStyle += ' bg-red-600 text-white hover:bg-red-700 focus:ring-red-500';
  if (variant === 'ghost') baseStyle += ' bg-transparent text-gray-700 hover:bg-gray-100 focus:ring-gray-200 dark:text-gray-300 dark:hover:bg-gray-800';

  return (
    <button className={`${baseStyle} ${className}`} {...props}>
      {children}
    </button>
  );
};

