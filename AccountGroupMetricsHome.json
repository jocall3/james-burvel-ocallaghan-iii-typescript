/**
 * @exports CurrencyEnum
 * @description Defines the supported currencies within the banking system.
 * This enum is derived directly from the GraphQL schema.
 */
export enum CurrencyEnum {
  USD = "USD",
  EUR = "EUR",
  GBP = "GBP",
  JPY = "JPY",
  CAD = "CAD",
  AUD = "AUD",
  CHF = "CHF",
  CNY = "CNY",
  SEK = "SEK",
  NZD = "NZD",
  MXN = "MXN",
  SGD = "SGD",
  HKD = "HKD",
  NOK = "NOK",
  KRW = "KRW",
  TRY = "TRY",
  RUB = "RUB",
  INR = "INR",
  BRL = "BRL",
  ZAR = "ZAR",
  // Additional currencies for future expansion or specific regional requirements
  PLN = "PLN",
  CZK = "CZK",
  HUF = "HUF",
  DKK = "DKK",
  SGD_USD = "SGD-USD", // Example of a complex "currency" type, e.g., for specific cross-currency products
}

/**
 * @exports AccountGroupMetricNode
 * @description Represents a single account group metric node, containing detailed financial data.
 * This interface is derived from the `AccountGroupMetricList` fragment in the GraphQL schema.
 */
export interface AccountGroupMetricNode {
  typename: string; // The GraphQL __typename for this object.
  id: string; // Unique identifier for the account group.
  bestName: string; // A user-friendly, descriptive name for the account group.
  currency: CurrencyEnum; // The primary currency of the account group.
  priorDayBalance: number; // Raw numeric value for prior day balance (derived from prettyPriorDayBalance).
  prettyPriorDayBalance: string; // Formatted string representation of the prior day balance.
  availableBalance: number; // Raw numeric value for available balance (derived from prettyAvailableBalance).
  prettyAvailableBalance: string; // Formatted string representation of the available balance.
  ledgerVariance: number; // Raw numeric value for ledger variance (derived from prettyLedgerVariance).
  prettyLedgerVariance: string; // Formatted string representation of the ledger variance.
  highlightLedgerVariance: boolean; // Flag to indicate if the ledger variance should be highlighted (e.g., negative).
  unreconciledAmount: number; // Raw numeric value for unreconciled amount (derived from prettyUnreconciledAmount).
  prettyUnreconciledAmount: string; // Formatted string representation of the unreconciled amount.
  unreconciledPercent: number; // Percentage of unreconciled amount relative to total balance.
  path: string; // Hierarchical path of the account group (e.g., "Region/Country/Branch/AccountType").
  lastUpdated: string; // ISO 8601 string of the last data update timestamp.
  status: 'ACTIVE' | 'INACTIVE' | 'PENDING_REVIEW' | 'FROZEN'; // Operational status of the account group.
  responsibleManagerId: string; // ID of the manager responsible for this group.
  riskScore: 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL'; // Calculated risk score.
  complianceStatus: 'COMPLIANT' | 'NON_COMPLIANT' | 'REVIEW_REQUIRED'; // Compliance status.
  tags: string[]; // Arbitrary tags for categorization and search.
  associatedBranches: string[]; // List of branch IDs associated with this account group.
  customMetadata: Record<string, any>; // Flexible field for additional, unstructured data.
}

/**
 * @exports AccountGroupMetricEdge
 * @description Represents an edge in the GraphQL connection, holding a node and its typename.
 */
export interface AccountGroupMetricEdge {
  node: AccountGroupMetricNode;
  __typename: string;
}

