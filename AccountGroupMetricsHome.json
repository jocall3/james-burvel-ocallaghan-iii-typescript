/**
 * @exports Table
 * @description A responsive table component with sorting capabilities.
 */
export interface TableProps<T> {
  data: T[];
  columns: TableColumn<T>[];
  onSort?: (sortBy: string, sortOrder: 'ASC' | 'DESC') => void;
  currentSortBy?: string | null;
  currentSortOrder?: 'ASC' | 'DESC' | null;
  onRowClick?: (row: T) => void;
  isLoading?: boolean;
  emptyMessage?: string;
  className?: string;
}

export const Table = <T extends { id: string }>({
  data,
  columns,
  onSort,
  currentSortBy,
  currentSortOrder,
  onRowClick,
  isLoading,
  emptyMessage,
  className = '',
}: TableProps<T>) => {
  const { t } = useTranslation();

  return (
    <div className={`overflow-x-auto relative shadow-md sm:rounded-lg ${className}`}>
      <table className="w-full text-sm text-left text-gray-500 dark:text-gray-400">
        <thead className="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
          <tr>
            {columns.filter(col => col.isVisible).map((column) => (
              <th
                key={column.id as string}
                scope="col"
                className={`px-6 py-3 ${column.isSortable ? 'cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-600' : ''}`}
                onClick={() => column.isSortable && onSort && onSort(
                  column.id as string,
                  currentSortBy === column.id && currentSortOrder === 'ASC' ? 'DESC' : 'ASC'
                )}
                style={{ width: column.width, textAlign: column.alignment || 'left' }}
                title={column.tooltip}
              >
                <div className="flex items-center">
                  {column.header}
                  {column.isSortable && currentSortBy === column.id && (
                    <span className="ml-1">
                      {currentSortOrder === 'ASC' ? '⬆️' : '⬇️'}
                    </span>
                  )}
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {isLoading ? (
            <tr>
              <td colSpan={columns.filter(col => col.isVisible).length} className="px-6 py-4 text-center">
                {t('loadingData')}
              </td>
            </tr>
          ) : data.length === 0 ? (
            <tr>
              <td colSpan={columns.filter(col => col.isVisible).length} className="px-6 py-4 text-center">
                {emptyMessage || t('noDataFound')}
              </td>
            </tr>
          ) : (
            data.map((row) => (
              <tr
                key={row.id}
                className="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600"
                onClick={() => onRowClick && onRowClick(row)}
                role={onRowClick ? 'button' : undefined}
                tabIndex={onRowClick ? 0 : undefined}
              >
                {columns.filter(col => col.isVisible).map((column) => (
                  <td key={`${row.id}-${column.id as string}`} className="px-6 py-4" style={{ textAlign: column.alignment || 'left' }}>
                    {column.accessor(row)}
                  </td>
                ))}
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  );
};

