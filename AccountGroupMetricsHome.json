// --- [4. Mock Data Generation and API Service Simulation] ---

const generateMockAccountGroupMetric = (id: string, namePrefix: string, index: number): AccountGroupMetricNode => {
  const currencies = Object.values(CurrencyEnum);
  const randomCurrency = currencies[Math.floor(Math.random() * currencies.length)];
  const priorDay = parseFloat((Math.random() * 10000000).toFixed(2));
  const available = priorDay * (0.95 + Math.random() * 0.1); // +/- 5%
  const variance = priorDay - available;
  const unreconciled = available * Math.random() * 0.15; // Up to 15% unreconciled
  const unreconciledPct = (unreconciled / available) * 100;

  const riskScores: AccountGroupMetricNode['riskScore'][] = ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'];
  const statuses: AccountGroupMetricNode['status'][] = ['ACTIVE', 'INACTIVE', 'PENDING_REVIEW', 'FROZEN'];
  const complianceStatuses: AccountGroupMetricNode['complianceStatus'][] = ['COMPLIANT', 'NON_COMPLIANT', 'REVIEW_REQUIRED'];
  const possibleTags = ['Corporate', 'Retail', 'Investment', 'Treasury', 'Wealth', 'Trust', 'International'];

  const numTags = Math.floor(Math.random() * 3) + 1; // 1 to 3 tags
  const selectedTags = Array.from({ length: numTags }, () => possibleTags[Math.floor(Math.random() * possibleTags.length)]);

  const numBranches = Math.floor(Math.random() * 3) + 1; // 1 to 3 branches
  const associatedBranches = Array.from({ length: numBranches }, (_, i) => `BRN${100 + i + index}`);

  return {
    typename: 'AccountGroupMetric',
    id: id,
    bestName: `${namePrefix} - Group ${index + 1} ${id.substring(0, 4)}`,
    currency: randomCurrency,
    priorDayBalance: priorDay,
    prettyPriorDayBalance: formatCurrency(priorDay, randomCurrency),
    availableBalance: available,
    prettyAvailableBalance: formatCurrency(available, randomCurrency),
    ledgerVariance: variance,
    prettyLedgerVariance: formatCurrency(variance, randomCurrency),
    highlightLedgerVariance: variance < 0 || Math.abs(variance) > (priorDay * 0.01), // Highlight if negative or >1% variance
    unreconciledAmount: unreconciled,
    prettyUnreconciledAmount: formatCurrency(unreconciled, randomCurrency),
    unreconciledPercent: parseFloat(unreconciledPct.toFixed(2)),
    path: `Region/Country/City/Branch${Math.floor(Math.random() * 5 + 1)}/Dept${Math.floor(Math.random() * 3 + 1)}`,
    lastUpdated: moment().subtract(Math.random() * 30, 'days').toISOString(),
    status: statuses[Math.floor(Math.random() * statuses.length)],
    responsibleManagerId: `MGR${Math.floor(Math.random() * 1000)}`,
    riskScore: riskScores[Math.floor(Math.random() * riskScores.length)],
    complianceStatus: complianceStatuses[Math.floor(Math.random() * complianceStatuses.length)],
    tags: Array.from(new Set(selectedTags)), // Ensure unique tags
    associatedBranches: associatedBranches,
    customMetadata: {
      accountType: Math.random() > 0.5 ? 'Checking' : 'Savings',
      segment: Math.random() > 0.7 ? 'Small Business' : (Math.random() > 0.3 ? 'Corporate' : 'Retail'),
      fundingSource: 'Internal',
    },
  };
};

// Generate a large number of mock records
const totalMockRecords = 500; // Increased for demonstrating scale
let MOCK_DATA: AccountGroupMetricNode[] = Array.from({ length: totalMockRecords }, (_, i) =>
  generateMockAccountGroupMetric(uuidv4(), "Global Bank Account", i)
);

// Function to simulate backend API call
export const fetchAccountGroupMetrics = async (
  variables: AccountGroupMetricsHomeVariables
): Promise<AccountGroupMetricsHomeResponse> => {
  return new Promise((resolve) => {
    setTimeout(() => {
      let filteredData = [...MOCK_DATA];

      // Apply filters
      if (variables.name) {
        const searchLower = variables.name.toLowerCase();
        filteredData = filteredData.filter(node =>
          node.bestName.toLowerCase().includes(searchLower) ||
          node.id.toLowerCase().includes(searchLower) ||
          node.path.toLowerCase().includes(searchLower) ||
          node.tags.some(tag => tag.toLowerCase().includes(searchLower))
        );
      }
      if (variables.currency && variables.currency !== ALL_CURRENCIES_OPTION) {
        filteredData = filteredData.filter(node => node.currency === variables.currency);
      }
      if (variables.status && variables.status !== ALL_STATUSES_OPTION) {
        filteredData = filteredData.filter(node => node.status === variables.status);
      }
      if (variables.riskScore && variables.riskScore !== ALL_RISK_SCORES_OPTION) {
        filteredData = filteredData.filter(node => node.riskScore === variables.riskScore);
      }
      if (variables.minBalance !== null && variables.minBalance !== undefined) {
        filteredData = filteredData.filter(node => node.availableBalance >= variables.minBalance!);
      }
      if (variables.maxBalance !== null && variables.maxBalance !== undefined) {
        filteredData = filteredData.filter(node => node.availableBalance <= variables.maxBalance!);
      }
      if (variables.tags && variables.tags.length > 0) {
        filteredData = filteredData.filter(node => variables.tags!.every(tag => node.tags.includes(tag)));
      }

      // Apply sorting
      if (variables.sortBy && variables.sortOrder) {
        filteredData.sort((a, b) => {
          const aVal = a[variables.sortBy as keyof AccountGroupMetricNode] as any;
          const bVal = b[variables.sortBy as keyof AccountGroupMetricNode] as any;

          if (typeof aVal === 'string' && typeof bVal === 'string') {
            return variables.sortOrder === 'ASC' ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
          }
          if (typeof aVal === 'number' && typeof bVal === 'number') {
            return variables.sortOrder === 'ASC' ? aVal - bVal : bVal - aVal;
          }
          // Fallback for other types or if values are incomparable
          return 0;
        });
      }


      // Apply pagination
      const pageSize = variables.first || variables.last || DEFAULT_PAGE_SIZE;
      const totalFilteredCount = filteredData.length;
      let startIndex = 0;
      let endIndex = pageSize;
      let hasNextPage = false;
      let hasPreviousPage = false;

      if (variables.after) {
        const afterIndex = filteredData.findIndex(node => node.id === variables.after);
        if (afterIndex !== -1) {
          startIndex = afterIndex + 1;
          endIndex = startIndex + pageSize;
        }
      } else if (variables.before) {
        const beforeIndex = filteredData.findIndex(node => node.id === variables.before);
        if (beforeIndex !== -1) {
          endIndex = beforeIndex;
          startIndex = Math.max(0, endIndex - pageSize);
        }
      }

      const paginatedData = filteredData.slice(startIndex, endIndex);

      if (filteredData.length > 0) {
        hasNextPage = endIndex < totalFilteredCount;
        hasPreviousPage = startIndex > 0;
      }

      const edges: AccountGroupMetricEdge[] = paginatedData.map(node => ({
        node,
        __typename: 'AccountGroupMetricEdge',
      }));

      const pageInfo: PageInfo = {
        startCursor: paginatedData.length > 0 ? paginatedData[0].id : null,
        endCursor: paginatedData.length > 0 ? paginatedData[paginatedData.length - 1].id : null,
        hasNextPage: hasNextPage,
        hasPreviousPage: hasPreviousPage,
        __typename: 'PageInfo',
      };

      resolve({
        accountGroupMetrics: {
          edges,
          pageInfo,
          __typename: 'AccountGroupMetricConnection',
          totalCount: totalFilteredCount,
        },
      });
    }, 500); // Simulate network latency
  });
};

/**
 * @exports updateAccountGroupMetric
 * @description Simulates an API call to update an existing account group metric.
 */
export const updateAccountGroupMetric = async (id: string, updates: Partial<AccountGroupMetricNode>): Promise<AccountGroupMetricNode> => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      const index = MOCK_DATA.findIndex(a => a.id === id);
      if (index === -1) {
        return reject(new Error('Account not found'));
      }
      const updatedAccount = { ...MOCK_DATA[index], ...updates, lastUpdated: moment().toISOString() };
      MOCK_DATA[index] = updatedAccount;
      console.log(`MOCK: Updated account ${id}`, updatedAccount);
      resolve(updatedAccount);
    }, 300);
  });
};

/**
 * @exports deleteAccountGroupMetric
 * @description Simulates an API call to delete an account group metric.
 */
export const deleteAccountGroupMetric = async (id: string): Promise<void> => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      const initialLength = MOCK_DATA.length;
      MOCK_DATA = MOCK_DATA.filter(a => a.id !== id);
      if (MOCK_DATA.length === initialLength) {
        return reject(new Error('Account not found for deletion'));
      }
      console.log(`MOCK: Deleted account ${id}`);
      resolve();
    }, 300);
  });
};

/**
 * @exports initiateReconciliationProcess
 * @description Simulates an API call to initiate a reconciliation workflow.
 */
export const initiateReconciliationProcess = async (accountId: string, userId: string): Promise<{ success: boolean; message: string }> => {
  return new Promise((resolve) => {
    setTimeout(() => {
      console.log(`MOCK: Reconciliation process initiated for account ${accountId} by user ${userId}`);
      resolve({ success: true, message: `Reconciliation workflow for ${accountId} successfully started.` });
    }, 700);
  });
};


// --- [5. Utility Functions and Hooks] ---

/**
 * @exports formatCurrency
 * @description Formats a number into a currency string based on the provided currency enum.
 */
export const formatCurrency = (amount: number, currency: CurrencyEnum | string, locale: string = 'en-US'): string => {
  try {
    const formatter = new Intl.NumberFormat(locale, {
      style: 'currency',
      currency: currency as string, // Cast to string as Intl.NumberFormat expects string
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });
    return formatter.format(amount);
  } catch (error) {
    console.warn(`Failed to format currency for ${amount} ${currency}:`, error);
    return `${currency} ${amount.toFixed(2)}`; // Fallback
  }
};

/**
 * @exports getCurrencySymbol
 * @description Returns the currency symbol for a given CurrencyEnum.
 */
export const getCurrencySymbol = (currency: CurrencyEnum | string): string => {
  try {
    return (0)
      .toLocaleString('en-US', {
        style: 'currency',
        currency: currency as string,
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
      })
      .replace(/\d/g, '')
      .trim();
  } catch {
    return currency; // Fallback
  }
};

/**
 * @exports formatPercentage
 * @description Formats a number as a percentage.
 */
export const formatPercentage = (value: number, locale: string = 'en-US'): string => {
  return new Intl.NumberFormat(locale, {
    style: 'percent',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(value / 100);
};

/**
 * @exports useUserPermissions
 * @description A hook to simulate fetching and managing user permissions.
 * In a real app, this would come from an authentication context or API.
 */
export const useUserPermissions = () => {
  // Mock permissions for different roles
  const [permissions, setPermissions] = useState<{
    canViewAllAccounts: boolean;
    canEditAccount: boolean;
    canDeleteAccount: boolean;
    canInitiateReconciliation: boolean;
    canExportData: boolean;
    canManageUserPreferences: boolean;
    canViewAuditLog: boolean;
  }>({
    canViewAllAccounts: true,
    canEditAccount: true,
    canDeleteAccount: false, // Default: Deletion requires higher privilege
    canInitiateReconciliation: true,
    canExportData: true,
    canManageUserPreferences: true,
    canViewAuditLog: true,
  });

  // Example of changing permissions based on a 'role'
  const setUserRole = (role: 'admin' | 'manager' | 'viewer') => {
    switch (role) {
      case 'admin':
        setPermissions({
          canViewAllAccounts: true,
          canEditAccount: true,
          canDeleteAccount: true,
          canInitiateReconciliation: true,
          canExportData: true,
          canManageUserPreferences: true,
          canViewAuditLog: true,
        });
        break;
      case 'manager':
        setPermissions({
          canViewAllAccounts: true,
          canEditAccount: true,
          canDeleteAccount: false,
          canInitiateReconciliation: true,
          canExportData: true,
          canManageUserPreferences: true,
          canViewAuditLog: true,
        });
        break;
      case 'viewer':
        setPermissions({
          canViewAllAccounts: true,
          canEditAccount: false,
          canDeleteAccount: false,
          canInitiateReconciliation: false,
          canExportData: true,
          canManageUserPreferences: false,
          canViewAuditLog: true,
        });
        break;
      default: // default is manager-like
        setPermissions({
          canViewAllAccounts: true,
          canEditAccount: true,
          canDeleteAccount: false,
          canInitiateReconciliation: true,
          canExportData: true,
          canManageUserPreferences: true,
          canViewAuditLog: true,
        });
    }
  };

  useEffect(() => {
    // In a real app, fetch user role from auth context/API
    // For demo, we might set a default or allow changing via a dev tool
    setUserRole('manager');
  }, []);

  return { permissions, setUserRole };
};

