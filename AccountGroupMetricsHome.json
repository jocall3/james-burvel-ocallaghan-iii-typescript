        tooltip: 'Difference between Prior Day Balance and Available Balance. Highlighted if significant.'
      },
      { id: 'prettyUnreconciledAmount', header: t('unreconciledAmount'), accessor: (row) => <span className="font-mono">{row.prettyUnreconciledAmount}</span>, isSortable: true, isVisible: userPreferences.tableColumnVisibility.prettyUnreconciledAmount, width: '150px', alignment: 'right' },
      { id: 'unreconciledPercent', header: t('unreconciledPercent'), accessor: (row) => formatPercentage(row.unreconciledPercent, i18n.language), isSortable: true, isVisible: userPreferences.tableColumnVisibility.unreconciledPercent, width: '100px', alignment: 'right' },
      { id: 'path', header: t('path'), accessor: (row) => row.path, isSortable: true, isVisible: userPreferences.tableColumnVisibility.path, width: '250px' },
      { id: 'lastUpdated', header: t('lastUpdated'), accessor: (row) => moment(row.lastUpdated).format('YYYY-MM-DD HH:mm'), isSortable: true, isVisible: userPreferences.tableColumnVisibility.lastUpdated, width: '150px' },
      { id: 'status', header: t('status'), accessor: (row) => <span className={`px-2 py-1 text-xs font-semibold rounded-full ${row.status === 'ACTIVE' ? 'bg-green-100 text-green-800' : row.status === 'PENDING_REVIEW' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800'} dark:bg-opacity-20`}>{row.status}</span>, isSortable: true, isVisible: userPreferences.tableColumnVisibility.status, width: '120px', alignment: 'center' },
      { id: 'riskScore', header: t('riskScore'), accessor: (row) => <span className={`px-2 py-1 text-xs font-semibold rounded-full ${row.riskScore === 'CRITICAL' ? 'bg-red-100 text-red-800' : row.riskScore === 'HIGH' ? 'bg-orange-100 text-orange-800' : 'bg-green-100 text-green-800'} dark:bg-opacity-20`}>{row.riskScore}</span>, isSortable: true, isVisible: userPreferences.tableColumnVisibility.riskScore, width: '100px', alignment: 'center' },
      { id: 'complianceStatus', header: t('complianceStatus'), accessor: (row) => <span className={`px-2 py-1 text-xs font-semibold rounded-full ${row.complianceStatus === 'NON_COMPLIANT' ? 'bg-red-100 text-red-800' : row.complianceStatus === 'REVIEW_REQUIRED' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800'} dark:bg-opacity-20`}>{row.complianceStatus}</span>, isSortable: true, isVisible: userPreferences.tableColumnVisibility.complianceStatus, width: '150px', alignment: 'center' },
      { id: 'tags', header: t('tags'), accessor: (row) => <div className="flex flex-wrap gap-1">{row.tags.map(tag => <span key={tag} className="text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full dark:bg-blue-900 dark:text-blue-200">{tag}</span>)}</div>, isSortable: false, isVisible: userPreferences.tableColumnVisibility.tags, width: '180px' },
      { id: 'responsibleManagerId', header: t('currentManager'), accessor: (row) => row.responsibleManagerId, isSortable: true, isVisible: userPreferences.tableColumnVisibility.responsibleManagerId, width: '120px' },
      { id: 'associatedBranches', header: t('associatedBranches'), accessor: (row) => row.associatedBranches.join(', '), isSortable: false, isVisible: userPreferences.tableColumnVisibility.associatedBranches, width: '150px' },
      {
        id: 'actions',
        header: t('actions'),
        accessor: (row) => (
          <div className="flex space-x-2">
            <Button variant="ghost" onClick={(e) => { e.stopPropagation(); handleViewDetails(row); }} aria-label={t('viewDetails')}>{t('viewDetails')}</Button>
            {permissions.canInitiateReconciliation && (
              <Button variant="ghost" onClick={(e) => { e.stopPropagation(); handleInitiateReconciliation(row.id, row.bestName); }} aria-label={t('initiateReconciliation')}>{t('initiateReconciliation')}</Button>
            )}
            {permissions.canEditAccount && (
              <Button variant="ghost" onClick={(e) => { e.stopPropagation(); handleEditAccount(row); }} aria-label={t('edit')}>{t('edit')}</Button>
            )}
            {permissions.canDeleteAccount && (
              <Button variant="danger" onClick={(e) => { e.stopPropagation(); handleConfirmDelete(row); }} aria-label={t('delete')}>{t('delete')}</Button>
            )}
          </div>
        ),
        isSortable: false,
        isVisible: userPreferences.tableColumnVisibility.actions,
        width: '250px',
        alignment: 'center',
        isSticky: 'right', // Example sticky column
      },
    ];

    // Filter columns based on visibility preferences, preserving order.
    return baseColumns.filter(col => col.isVisible || col.id === 'actions'); // Ensure actions column is always considered for rendering, even if hidden by preference.
  }, [t, userPreferences.tableColumnVisibility, permissions, i18n.language]);


  // --- Data Fetching and Effects ---

  const fetchAndSetData = useCallback(async (
    page: number,
    pageSize: number,
    currentFilter: AccountGroupMetricFilterState,
    sortById: string | null,
    sortOrderDir: 'ASC' | 'DESC',
    cursor?: { after?: string | null; before?: string | null }
  ) => {
    setLoading(true);
    setError(null);
    try {
      const variables: AccountGroupMetricsHomeVariables = {
        first: cursor?.after ? pageSize : null,
        after: cursor?.after || null,
        last: cursor?.before ? pageSize : null,
        before: cursor?.before || null,
        name: currentFilter.searchName || null,
        currency: currentFilter.selectedCurrency !== ALL_CURRENCIES_OPTION ? currentFilter.selectedCurrency : null,
        status: currentFilter.statusFilter !== ALL_STATUSES_OPTION ? currentFilter.statusFilter : null,
        riskScore: currentFilter.riskScoreFilter !== ALL_RISK_SCORES_OPTION ? currentFilter.riskScoreFilter : null,
        minBalance: currentFilter.minAvailableBalance,
        maxBalance: currentFilter.maxAvailableBalance,
        tags: currentFilter.selectedTags.length > 0 ? currentFilter.selectedTags : null,
        sortBy: sortById,
        sortOrder: sortOrderDir,
        // In a real app, dateRangeStart/End would be handled by the backend API.
      };

      const response = await fetchAccountGroupMetrics(variables);
      const newNodes = response.accountGroupMetrics.edges.map(edge => edge.node);
      setData(newNodes);
      setTotalCount(response.accountGroupMetrics.totalCount);
      setStartCursor(response.accountGroupMetrics.pageInfo.startCursor);
      setEndCursor(response.accountGroupMetrics.pageInfo.endCursor);
      setHasNextPage(response.accountGroupMetrics.pageInfo.hasNextPage);
      setHasPreviousPage(response.accountGroupMetrics.pageInfo.hasPreviousPage);
      addAuditLogEntry(`Fetched data with filters: ${JSON.stringify(currentFilter)}`, 'AccountGroupMetrics', 'N/A');
    } catch (err: any) {
      setError(t('errorFetchingData', { message: err.message }));
      addNotification(t('errorFetchingData', { message: err.message }), 'error');
      console.error("Error fetching account group metrics:", err);
    } finally {
      setLoading(false);
    }
  }, [t, addNotification]);

  // Debounced version of the fetch function for search/filter inputs
  const debouncedFetchAndSetData = useCallback(
    debounce((
      page: number,
      pageSize: number,
      currentFilter: AccountGroupMetricFilterState,
      sortById: string | null,
      sortOrderDir: 'ASC' | 'DESC',
      cursor?: { after?: string | null; before?: string | null }
    ) => {
      fetchAndSetData(page, pageSize, currentFilter, sortById, sortOrderDir, cursor);
    }, DEBOUNCE_TIME_MS),
    [fetchAndSetData]
  );

  // Initial data load and whenever filter/sort/pagination changes
  useEffect(() => {
    // Determine cursor based on current page state
    let cursor: { after?: string | null; before?: string | null } | undefined;
    if (currentPage === 1 && !hasPreviousPage) { // First page
      cursor = undefined;
    } else if (currentPage > 1 && !hasPreviousPage) { // Back to page 1 from a deeper page
      // Reset cursor logic, effectively refetch from start
      cursor = undefined;
    } else if (hasPreviousPage) {
      // Logic for navigating to a specific page or previous page using 'before' cursor
      // For simple pagination, we might just re-fetch with `first` and `offset` which is not GraphQL standard cursor
      // For actual cursor-based pagination, we need to manage previous cursors.
      // If `before` is used, it should be when we navigate backward.
    }


    fetchAndSetData(currentPage, itemsPerPage, filter, sortBy, sortOrder);

    // Auto-refresh mechanism
    let refreshInterval: NodeJS.Timeout | undefined;
    if (userPreferences.autoRefreshInterval > 0) {
      refreshInterval = setInterval(() => {
        addNotification(t('refreshData') + ' (Auto)', 'info', 2000);
        fetchAndSetData(currentPage, itemsPerPage, filter, sortBy, sortOrder);
      }, userPreferences.autoRefreshInterval * 1000);
    }

    return () => {
      debouncedFetchAndSetData.cancel();
      if (refreshInterval) {
        clearInterval(refreshInterval);
      }
    };
  }, [currentPage, itemsPerPage, sortBy, sortOrder, filter, userPreferences.autoRefreshInterval, fetchAndSetData, debouncedFetchAndSetData, t, addNotification]);


  // Effect for loading user preferences from localStorage
  useEffect(() => {
    try {
      const storedPreferences = localStorage.getItem('userPreferences');
      if (storedPreferences) {
        const parsedPrefs: UserPreferences = JSON.parse(storedPreferences);
        setUserPreferences(prev => ({ ...prev, ...parsedPrefs }));
        setItemsPerPage(parsedPrefs.itemsPerPage);
        // Apply theme from preferences
        setTheme(parsedPrefs.theme);
      }
    } catch (e) {
      console.error("Failed to load user preferences from localStorage", e);
    }
  }, [setTheme]);

  // --- Handlers for User Interactions ---

  const handlePageChange = useCallback((newPage: number) => {
    if (newPage < 1) newPage = 1;
    const totalPages = Math.ceil(totalCount / itemsPerPage);
    if (newPage > totalPages && totalPages > 0) newPage = totalPages;

    setCurrentPage(newPage);
    // When changing page, we usually reset cursors and apply `first` with `offset` logic or rely purely on `after`/`before`
    // For this simple mock, just changing currentPage effectively makes the fetch logic re-calculate pagination.
  }, [totalCount, itemsPerPage]);

  const handleItemsPerPageChange = useCallback((e: React.ChangeEvent<HTMLSelectElement>) => {
    const newSize = Number(e.target.value);
    setItemsPerPage(newSize);
    setCurrentPage(1); // Reset to first page when page size changes
    addAuditLogEntry(`Changed items per page to ${newSize}`, 'UserPreferences', 'N/A');
  }, [addAuditLogEntry]);

  const handleSort = useCallback((columnId: string, order: 'ASC' | 'DESC') => {
    setSortBy(columnId);
    setSortOrder(order);
    setCurrentPage(1); // Reset to first page on new sort
    addAuditLogEntry(`Sorted by ${columnId} in ${order} order`, 'AccountGroupMetrics', 'N/A');
  }, [addAuditLogEntry]);

  const handleFilterChange = useCallback((field: keyof AccountGroupMetricFilterState, value: any) => {
    setFilter(prev => ({ ...prev, [field]: value }));
    setCurrentPage(1); // Reset to first page on filter change
    if (field === 'searchName' || field === 'minAvailableBalance' || field === 'maxAvailableBalance') {
      debouncedFetchAndSetData(currentPage, itemsPerPage, { ...filter, [field]: value }, sortBy, sortOrder);
    } else {
      fetchAndSetData(currentPage, itemsPerPage, { ...filter, [field]: value }, sortBy, sortOrder);
    }
    addAuditLogEntry(`Filter '${field}' changed to '${value}'`, 'AccountGroupMetrics', 'N/A');
  }, [currentPage, itemsPerPage, sortBy, sortOrder, filter, debouncedFetchAndSetData, fetchAndSetData, addAuditLogEntry]);

  const handleApplyFilters = useCallback(() => {
    setCurrentPage(1);
    fetchAndSetData(currentPage, itemsPerPage, filter, sortBy, sortOrder);
    addNotification(t('applyFilters') + '...', 'info', 2000);
    addAuditLogEntry('Applied filters', 'AccountGroupMetrics', 'N/A');
  }, [currentPage, itemsPerPage, filter, sortBy, sortOrder, fetchAndSetData, t, addNotification, addAuditLogEntry]);

  const handleResetFilters = useCallback(() => {
    const resetFilterState: AccountGroupMetricFilterState = {
      searchName: '',
      selectedCurrency: ALL_CURRENCIES_OPTION,
      minAvailableBalance: null,
      maxAvailableBalance: null,
      riskScoreFilter: ALL_RISK_SCORES_OPTION,
      statusFilter: ALL_STATUSES_OPTION,
      selectedTags: [],
      dateRangeStart: null,
      dateRangeEnd: null,
    };
    setFilter(resetFilterState);
    setCurrentPage(1);
    fetchAndSetData(1, itemsPerPage, resetFilterState, sortBy, sortOrder);
    addNotification(t('resetFilters') + '...', 'info', 2000);
    addAuditLogEntry('Reset filters', 'AccountGroupMetrics', 'N/A');
  }, [itemsPerPage, sortBy, sortOrder, fetchAndSetData, t, addNotification, addAuditLogEntry]);

  const handleRefreshData = useCallback(() => {
    fetchAndSetData(currentPage, itemsPerPage, filter, sortBy, sortOrder);
    addNotification(t('refreshData') + '...', 'info', 2000);
    addAuditLogEntry('Manually refreshed data', 'AccountGroupMetrics', 'N/A');
  }, [currentPage, itemsPerPage, filter, sortBy, sortOrder, fetchAndSetData, t, addNotification, addAuditLogEntry]);

  const handleViewDetails = useCallback((account: AccountGroupMetricNode) => {
    setSelectedAccountForDetails(account);
    setIsAccountDetailsModalOpen(true);
    addAuditLogEntry(`Viewed details for account: ${account.id}`, 'AccountGroupMetric', account.id);
  }, [addAuditLogEntry]);

  const handleEditAccount = useCallback((account: AccountGroupMetricNode) => {
    // In a full application, this would open an editing modal or navigate to an edit page.
    // For now, we'll simulate a prompt and direct update.
    const newName = prompt(`Edit name for ${account.bestName}:`, account.bestName);
    if (newName && newName !== account.bestName) {
      updateAccountGroupMetric(account.id, { bestName: newName })
        .then(() => {
          fetchAndSetData(currentPage, itemsPerPage, filter, sortBy, sortOrder); // Re-fetch to update table
          addNotification(t('updateSuccess', { name: newName }), 'success');
          addAuditLogEntry(`Updated account name to '${newName}' for account: ${account.id}`, 'AccountGroupMetric', account.id);
        })
        .catch(err => {
          addNotification(t('errorFetchingData', { message: err.message }), 'error');
          console.error("Error updating account:", err);
        });
    }
  }, [addNotification, t, fetchAndSetData, currentPage, itemsPerPage, filter, sortBy, sortOrder, addAuditLogEntry]);

  const handleConfirmDelete = useCallback((account: AccountGroupMetricNode) => {
    setAccountToDelete(account);
    setIsConfirmDeleteModalOpen(true);
  }, []);

  const handleDeleteAccount = useCallback(async () => {
    if (accountToDelete) {
      setLoading(true);
      try {
        await deleteAccountGroupMetric(accountToDelete.id);
        addNotification(t('deleteSuccess', { name: accountToDelete.bestName }), 'success');
        addAuditLogEntry(`Deleted account: ${accountToDelete.id}`, 'AccountGroupMetric', accountToDelete.id);
        // Refresh data to reflect deletion, also adjust current page if it became empty
        await fetchAndSetData(currentPage, itemsPerPage, filter, sortBy, sortOrder);
      } catch (err: any) {
        addNotification(t('errorFetchingData', { message: err.message }), 'error');
        console.error("Error deleting account:", err);
      } finally {
        setLoading(false);
        setIsConfirmDeleteModalOpen(false);
        setAccountToDelete(null);
      }
    }
  }, [accountToDelete, addNotification, t, fetchAndSetData, currentPage, itemsPerPage, filter, sortBy, sortOrder, addAuditLogEntry]);

  const handleInitiateReconciliation = useCallback(async (accountId: string, accountName: string) => {
    setLoading(true);
    try {
      const result = await initiateReconciliationProcess(accountId, userId);
      if (result.success) {
        addNotification(t('reconciliationInitiated', { name: accountName }), 'success');
        addAuditLogEntry(`Initiated reconciliation for account: ${accountId}`, 'AccountGroupMetric', accountId);
      } else {
        addNotification(`Failed to initiate reconciliation for ${accountName}: ${result.message}`, 'error');
      }
    } catch (err: any) {
      addNotification(`Error initiating reconciliation for ${accountName}: ${err.message}`, 'error');
      console.error("Error initiating reconciliation:", err);
    } finally {
      setLoading(false);
    }
  }, [addNotification, t, userId, addAuditLogEntry]);

  const handleColumnVisibilityChange = useCallback((columnId: string, isVisible: boolean) => {
    setUserPreferences(prev => ({
      ...prev,
      tableColumnVisibility: {
        ...prev.tableColumnVisibility,
        [columnId]: isVisible,
      },
    }));
  }, []);

  const handleSaveUserPreferences = useCallback(() => {
    // Persist preferences to localStorage (or a backend API in a real app)
    localStorage.setItem('userPreferences', JSON.stringify(userPreferences));
    setIsPreferencesModalOpen(false);
    addNotification(t('savePreferences') + '...', 'success', 2000);
    addAuditLogEntry('User preferences saved', 'UserPreferences', 'N/A');
    // Re-fetch data if itemsPerPage or defaultCurrencyFilter changed, as it impacts the query.
    fetchAndSetData(currentPage, userPreferences.itemsPerPage, filter, sortBy, sortOrder);
  }, [userPreferences, t, addNotification, fetchAndSetData, currentPage, filter, sortBy, sortOrder, addAuditLogEntry]);

  const addAuditLogEntry = useCallback((action: string, entityType: string, entityId: string, details: Record<string, any> = {}) => {
    const newEntry: AuditLogEntry = {
      id: uuidv4(),
      timestamp: moment().toISOString(),
      userId: userId,
      action: action,
      entityType: entityType,
      entityId: entityId,
      details: details,
    };
    setAuditLogEntries(prev => [newEntry, ...prev].slice(0, 100)); // Keep last 100 entries
  }, [userId]);


  // --- Export Functionality ---
  const exportToCSV = useCallback(() => {
    if (!data || data.length === 0) {
      addNotification(t('noDataFound'), 'warning');
      return;
    }

    const csvData = data.map(node => {
      const row: Record<string, string | number | boolean> = {};
      columns.filter(col => col.isVisible && col.id !== 'actions').forEach(col => {
        // Handle complex accessor types, e.g., ReactNode
        const value = col.accessor(node);
        if (typeof value === 'object' && value !== null && 'props' in value && 'children' in value.props) {
          row[col.header] = value.props.children.toString(); // Extract text from ReactNode like <span>
        } else {
          row[col.header] = String(value); // Convert any direct value to string
        }
      });
      return row;
    });

    const csv = Papa.unparse(csvData);
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.setAttribute('download', `AccountGroupMetrics_${moment().format('YYYYMMDD_HHmmss')}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    addNotification(t('exportToCSV') + ' ' + t('success'), 'success');
    addAuditLogEntry('Exported account group metrics to CSV', 'AccountGroupMetrics', 'N/A');
  }, [data, columns, t, addNotification, addAuditLogEntry]);

  const exportToPDF = useCallback(() => {
    if (!tableRef.current) {
      addNotification(t('errorFetchingData', { message: 'Table element not found for PDF export.' }), 'error');
      return;
    }

    setLoading(true);
    const element = tableRef.current;
    html2pdf().from(element).set({
      margin: 1,
      filename: `AccountGroupMetrics_${moment().format('YYYYMMDD_HHmmss')}.pdf`,
      html2canvas: { scale: 2 },
      jsPDF: { unit: 'in', format: 'letter', orientation: 'landscape' },
    }).save().then(() => {
      addNotification(t('exportToPDF') + ' ' + t('success'), 'success');
      addAuditLogEntry('Exported account group metrics to PDF', 'AccountGroupMetrics', 'N/A');
    }).catch(err => {
      addNotification(t('errorFetchingData', { message: `PDF export failed: ${err.message}` }), 'error');
      console.error("PDF export error:", err);
    }).finally(() => {
      setLoading(false);
    });
  }, [addNotification, t, addAuditLogEntry]);

  // --- Chart Data Preparation ---
  const chartData = useMemo(() => {
    // Aggregate data for charting
    const currencyBalances: { [key: string]: number } = {};
    const varianceByStatus: { [key: string]: number } = {
      ACTIVE: 0,
      INACTIVE: 0,
      PENDING_REVIEW: 0,
      FROZEN: 0,
    };
    const unreconciledByRisk: { [key: string]: number } = {
      LOW: 0,
      MEDIUM: 0,
      HIGH: 0,
      CRITICAL: 0,
    };

    data.forEach(node => {
      currencyBalances[node.currency] = (currencyBalances[node.currency] || 0) + node.availableBalance;
      varianceByStatus[node.status] = (varianceByStatus[node.status] || 0) + node.ledgerVariance;
      unreconciledByRisk[node.riskScore] = (unreconciledByRisk[node.riskScore] || 0) + node.unreconciledAmount;
    });

    return { currencyBalances, varianceByStatus, unreconciledByRisk };
  }, [data]);

  // --- Main Render Structure ---

  if (!isAuthenticated) {
    return (
      <div className="flex items-center justify-center min-h-screen bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100">
        <div className="text-center p-8 bg-white dark:bg-gray-800 rounded-lg shadow-md">
          <h2 className="text-2xl font-bold mb-4">{t('appTitle')}</h2>
          <p className="mb-6">{t('authenticationRequired') || 'Authentication required to access this application.'}</p>
          <Button onClick={() => addNotification('Simulating login...', 'info', 3000)}>{t('login') || 'Login'}</Button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-sans p-6 transition-colors duration-200">
      {/* Header Section */}
      <header className="flex justify-between items-center mb-6 pb-4 border-b border-gray-200 dark:border-gray-700">
        <h1 className="text-3xl font-bold">{t('appTitle')}</h1>
        <div className="flex items-center space-x-4">
          <Select value={i18n.language} onChange={(e) => i18n.changeLanguage(e.target.value)} aria-label="Select language">
            {SUPPORTED_LOCALES.map(lang => (
              <option key={lang} value={lang}>{lang.toUpperCase()}</option>
            ))}
          </Select>
          <Button variant="secondary" onClick={() => setIsPreferencesModalOpen(true)} aria-label={t('userPreferences')}>
            ⚙️ {t('configuration')}
          </Button>
          <Button variant="secondary" onClick={handleRefreshData} disabled={loading} aria-label={t('refreshData')}>
            🔄 {t('refreshData')}
          </Button>
          {permissions.canExportData && (
            <div className="relative group">
              <Button variant="secondary" aria-haspopup="true" aria-expanded="false" aria-label={t('export')}>
                ⬇️ {t('export')}
              </Button>
              <div className="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-700 rounded-md shadow-lg py-1 z-10 hidden group-hover:block transition-all duration-150 ease-in-out">
                <Button variant="ghost" className="block w-full text-left px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600" onClick={exportToCSV}>{t('exportToCSV')}</Button>
                <Button variant="ghost" className="block w-full text-left px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600" onClick={exportToPDF}>{t('exportToPDF')}</Button>
                {permissions.canViewAuditLog && (
                  <Button variant="ghost" className="block w-full text-left px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-600" onClick={() => { /* Export audit log logic */ addNotification(t('auditLogExport') + '...', 'info', 2000); }}>{t('auditLogExport')}</Button>
                )}
              </div>
            </div>
          )}
        </div>
      </header>

      {/* Dashboard Widgets Layout */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        {userPreferences.dashboardWidgetOrder.includes('balanceOverview') && (
          <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">
            <h2 className="text-xl font-semibold mb-4">{t('balanceOverview')}</h2>
            {loading ? (
              <p>{t('loadingChart')}</p>
            ) : error ? (
              <p className="text-red-500">{error}</p>
            ) : (
              <Chart
                options={{
                  chart: {
                    type: 'donut',
                    background: 'transparent',
                  },
                  labels: Object.keys(chartData.currencyBalances),
                  colors: ['#3B82F6', '#EF4444', '#10B981', '#F59E0B', '#6366F1', '#EC4899', '#06B6D4'],
                  dataLabels: {
                    enabled: true,
                    formatter: function (val: any, opts: any) {
                      return `${opts.w.globals.seriesTotals[opts.seriesIndex].toFixed(2)}`;
                    },
                  },
                  tooltip: {
                    y: {
                      formatter: function (val: any) {
                        const currency = Object.keys(chartData.currencyBalances)[this.seriesIndex];
                        return formatCurrency(val, currency);
                      }
                    }
                  },
                  responsive: [{
                    breakpoint: 480,
                    options: {
                      chart: {
                        width: 200
                      },
                      legend: {
                        position: 'bottom'
                      }
                    }
                  }]
                }}
                series={Object.values(chartData.currencyBalances)}
                type="donut"
                height={280}
              />
            )}
          </div>
        )}

        {userPreferences.dashboardWidgetOrder.includes('varianceTrend') && (
          <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">
            <h2 className="text-xl font-semibold mb-4">{t('varianceTrend')}</h2>
            {loading ? (
              <p>{t('loadingChart')}</p>
            ) : error ? (
              <p className="text-red-500">{error}</p>
            ) : (
              <Chart
                options={{
                  chart: { type: 'bar', stacked: true, background: 'transparent' },
                  xaxis: { categories: Object.keys(chartData.varianceByStatus), title: { text: t('status') } },
                  yaxis: { title: { text: t('ledgerVariance') } },
                  tooltip: { y: { formatter: (val: any) => formatCurrency(val, CurrencyEnum.USD) } }, // Assuming USD for variance display if mixed currencies
                  plotOptions: { bar: { horizontal: false, columnWidth: '55%', endingShape: 'rounded' } },
                  dataLabels: { enabled: false },
                  colors: ['#3B82F6', '#EF4444', '#F59E0B', '#6366F1'],
                  responsive: [{
                    breakpoint: 480,
                    options: { chart: { width: 200 }, legend: { position: 'bottom' } }
                  }]
                }}
                series={[{ name: t('ledgerVariance'), data: Object.values(chartData.varianceByStatus) }]}
                type="bar"
                height={280}
              />
            )}
          </div>
        )}

        {userPreferences.dashboardWidgetOrder.includes('unreconciledBreakdown') && (
          <div className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">
            <h2 className="text-xl font-semibold mb-4">{t('unreconciledBreakdown')}</h2>
            {loading ? (
              <p>{t('loadingChart')}</p>
            ) : error ? (
              <p className="text-red-500">{error}</p>
            ) : (
              <Chart
                options={{
                  chart: { type: 'pie', background: 'transparent' },
                  labels: Object.keys(chartData.unreconciledByRisk),
                  colors: ['#10B981', '#F59E0B', '#EF4444', '#6366F1'], // Green, Amber, Red, Indigo
                  tooltip: {
                    y: {
                      formatter: function (val: any) {
                        return formatCurrency(val, CurrencyEnum.USD); // Assuming USD for mixed currency unreconciled amounts
                      }
                    }
                  },
                  responsive: [{
                    breakpoint: 480,
                    options: { chart: { width: 200 }, legend: { position: 'bottom' } }
                  }]
                }}
                series={Object.values(chartData.unreconciledByRisk)}
                type="pie"
                height={280}
              />
            )}
          </div>
        )}
      </div>

      {/* Filters Section */}
      <section className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md mb-8 border border-gray-200 dark:border-gray-700">
        <h2 className="text-xl font-semibold mb-4">{t('applyFilters')}</h2>
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          <div>
            <Label htmlFor="searchName">{t('searchByName')}</Label>
            <Input
              id="searchName"
              type="text"
              value={filter.searchName}
              onChange={(e) => handleFilterChange('searchName', e.target.value)}
              placeholder={t('searchByName')}
              aria-label={t('searchByName')}
            />
          </div>
          <div>
            <Label htmlFor="currencyFilter">{t('currencyFilter')}</Label>
            <Select
              id="currencyFilter"
              value={filter.selectedCurrency}
              onChange={(e) => handleFilterChange('selectedCurrency', e.target.value)}
              aria-label={t('currencyFilter')}
            >
              <option value={ALL_CURRENCIES_OPTION}>{t('all')}</option>
              {Object.values(CurrencyEnum).map((curr) => (
                <option key={curr} value={curr}>{curr}</option>
              ))}
            </Select>
          </div>
          <div>
            <Label htmlFor="minAvailableBalance">{t('minAvailableBalance')}</Label>
            <Input
              id="minAvailableBalance"
              type="number"
              value={filter.minAvailableBalance ?? ''}
              onChange={(e) => handleFilterChange('minAvailableBalance', e.target.value === '' ? null : Number(e.target.value))}
              placeholder="0"
              aria-label={t('minAvailableBalance')}
            />
          </div>
          <div>
            <Label htmlFor="maxAvailableBalance">{t('maxAvailableBalance')}</Label>
            <Input
              id="maxAvailableBalance"
              type="number"
              value={filter.maxAvailableBalance ?? ''}
              onChange={(e) => handleFilterChange('maxAvailableBalance', e.target.value === '' ? null : Number(e.target.value))}
              placeholder="1000000"
              aria-label={t('maxAvailableBalance')}
            />
          </div>
          <div>
            <Label htmlFor="riskScoreFilter">{t('riskScoreFilter')}</Label>
            <Select
              id="riskScoreFilter"
              value={filter.riskScoreFilter}
              onChange={(e) => handleFilterChange('riskScoreFilter', e.target.value)}
              aria-label={t('riskScoreFilter')}
            >
              <option value={ALL_RISK_SCORES_OPTION}>{t('all')}</option>
              <option value="LOW">LOW</option>
              <option value="MEDIUM">MEDIUM</option>
              <option value="HIGH">HIGH</option>
              <option value="CRITICAL">CRITICAL</option>
            </Select>
          </div>
          <div>
            <Label htmlFor="statusFilter">{t('statusFilter')}</Label>
            <Select
              id="statusFilter"
              value={filter.statusFilter}
              onChange={(e) => handleFilterChange('statusFilter', e.target.value)}
              aria-label={t('statusFilter')}
            >
              <option value={ALL_STATUSES_OPTION}>{t('all')}</option>
              <option value="ACTIVE">ACTIVE</option>
              <option value="INACTIVE">INACTIVE</option>
              <option value="PENDING_REVIEW">PENDING_REVIEW</option>
              <option value="FROZEN">FROZEN</option>
            </Select>
          </div>
          {/* Advanced tag filtering (multi-select might require a custom component) */}
          <div className="col-span-full md:col-span-1">
            <Label htmlFor="tagsFilter">{t('tagsFilter')}</Label>
            <Select
              id="tagsFilter"
              multiple
              value={filter.selectedTags}
              onChange={(e) => handleFilterChange('selectedTags', Array.from(e.target.selectedOptions, option => option.value))}
              aria-label={t('tagsFilter')}
              className="h-24" // Make multi-select taller
            >
              {availableTags.map(tag => (
                <option key={tag} value={tag}>{tag}</option>
              ))}
            </Select>
          </div>
          {/* Date Range Filter (would use a date picker component in a real app) */}
          <div className="col-span-full md:col-span-2 flex flex-col justify-end space-y-2">
            <Label htmlFor="dateRangeStart">{t('dateRangeFilter')}</Label>
            <div className="flex space-x-2">
              <Input
                id="dateRangeStart"
                type="date"
                value={filter.dateRangeStart || ''}
                onChange={(e) => handleFilterChange('dateRangeStart', e.target.value)}
                aria-label={`${t('dateRangeFilter')} ${t('start')}`}
              />
              <Input
                id="dateRangeEnd"
                type="date"
                value={filter.dateRangeEnd || ''}
                onChange={(e) => handleFilterChange('dateRangeEnd', e.target.value)}
                aria-label={`${t('dateRangeFilter')} ${t('end')}`}
              />
            </div>
          </div>
        </div>
        <div className="flex justify-end space-x-2 mt-6">
          <Button variant="secondary" onClick={handleResetFilters} aria-label={t('resetFilters')}>{t('resetFilters')}</Button>
          <Button onClick={handleApplyFilters} aria-label={t('applyFilters')}>{t('applyFilters')}</Button>
        </div>
      </section>

      {/* Account Group Metrics Table Section */}
      <section className="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md border border-gray-200 dark:border-gray-700">
        <h2 className="text-xl font-semibold mb-4">{t('accountGroupMetrics')}</h2>

        {error && (
          <div className="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <strong className="font-bold">Error!</strong>
            <span className="block sm:inline"> {error}</span>
          </div>
        )}

        <div className="mb-4 flex justify-between items-center">
          <span className="text-sm text-gray-600 dark:text-gray-400">
            {t('totalRecords', { count: totalCount })}
          </span>
          <Button variant="secondary" onClick={() => setIsColumnCustomizationModalOpen(true)} aria-label={t('customizeColumns')}>
            {t('customizeColumns')}
          </Button>
        </div>

        <div ref={tableRef}> {/* Ref for PDF export */}
          <Table<AccountGroupMetricNode>
            data={data}
            columns={columns}
            onSort={handleSort}
            currentSortBy={sortBy}
            currentSortOrder={sortOrder}
            onRowClick={handleViewDetails}
            isLoading={loading}
          />
        </div>

        {/* Pagination Controls */}
        <div className="flex justify-between items-center mt-6">
          <div className="flex items-center space-x-2">
            <Label htmlFor="itemsPerPageSelect">{t('itemsPerPage')}</Label>
            <Select id="itemsPerPageSelect" value={itemsPerPage} onChange={handleItemsPerPageChange} aria-label={t('itemsPerPage')}>
              {[10, 25, 50, 100].map(size => (
                <option key={size} value={size}>{size}</option>
              ))}
            </Select>
          </div>
          <div className="flex items-center space-x-4">
            <Button
              variant="secondary"
              onClick={() => handlePageChange(1)}
              disabled={currentPage === 1 || loading}
              aria-label={t('firstPage')}
            >
              &laquo; {t('firstPage')}
            </Button>
            <Button
              variant="secondary"
              onClick={() => handlePageChange(currentPage - 1)}
              disabled={currentPage === 1 || loading}
              aria-label={t('previousPage')}
            >
              &lsaquo; {t('previousPage')}
            </Button>
            <span className="text-sm">
              {t('page')} {currentPage} {t('of')} {Math.ceil(totalCount / itemsPerPage) || 1}
            </span>
            <Button
              variant="secondary"
              onClick={() => handlePageChange(currentPage + 1)}
              disabled={!hasNextPage || loading}
              aria-label={t('nextPage')}
            >
              {t('nextPage')} &rsaquo;
            </Button>
            <Button
              variant="secondary"
              onClick={() => handlePageChange(Math.ceil(totalCount / itemsPerPage) || 1)}
              disabled={currentPage === (Math.ceil(totalCount / itemsPerPage) || 1) || loading}
              aria-label={t('lastPage')}
            >
              {t('lastPage')} &raquo;
            </Button>
          </div>
        </div>
      </section>

      {/* --- Modals --- */}

      {/* Column Customization Modal */}
      <Modal
        isOpen={isColumnCustomizationModalOpen}
        onClose={() => setIsColumnCustomizationModalOpen(false)}
        title={t('customizeColumns')}
        footer={
          <Button onClick={() => setIsColumnCustomizationModalOpen(false)}>{t('close')}</Button>
        }
      >
        <div className="grid grid-cols-2 gap-4 max-h-80 overflow-y-auto pr-2">
          {columns.map((col) => (
            <div key={col.id as string} className="flex items-center">
              <Checkbox
                id={`col-toggle-${col.id as string}`}
                checked={userPreferences.tableColumnVisibility[col.id as string]}
                onChange={(e) => handleColumnVisibilityChange(col.id as string, e.target.checked)}
                disabled={col.id === 'actions'} // Actions column cannot be hidden
              />
              <Label htmlFor={`col-toggle-${col.id as string}`} className="ml-2 cursor-pointer dark:text-gray-300">
                {col.header}
              </Label>
            </div>
          ))}
        </div>
      </Modal>

      {/* User Preferences Modal */}
      <Modal
        isOpen={isPreferencesModalOpen}
        onClose={() => setIsPreferencesModalOpen(false)}
        title={t('userPreferences')}
        footer={
          <>
            <Button variant="secondary" onClick={() => setIsPreferencesModalOpen(false)}>{t('cancel')}</Button>
            <Button onClick={handleSaveUserPreferences}>{t('savePreferences')}</Button>
          </>
        }
      >
        <div className="space-y-4">
          <div>
            <Label htmlFor="pref-itemsPerPage">{t('itemsPerPage')}</Label>
            <Select
              id="pref-itemsPerPage"
              value={userPreferences.itemsPerPage}
              onChange={(e) => setUserPreferences(prev => ({ ...prev, itemsPerPage: Number(e.target.value) }))}
              aria-label={t('itemsPerPage')}
            >
              {[10, 25, 50, 100].map(size => (
                <option key={size} value={size}>{size}</option>
              ))}
            </Select>
          </div>
          <div>
            <Label htmlFor="pref-defaultCurrency">{t('defaultCurrencyFilter')}</Label>
            <Select
              id="pref-defaultCurrency"
              value={userPreferences.defaultCurrencyFilter}
              onChange={(e) => setUserPreferences(prev => ({ ...prev, defaultCurrencyFilter: e.target.value as CurrencyEnum | 'ALL' }))}
              aria-label={t('defaultCurrencyFilter')}
            >
              <option value={ALL_CURRENCIES_OPTION}>{t('all')}</option>
              {Object.values(CurrencyEnum).map((curr) => (
                <option key={curr} value={curr}>{curr}</option>
              ))}
            </Select>
          </div>
          <div>
            <Label htmlFor="pref-theme">{t('theme')}</Label>
            <Select
              id="pref-theme"
              value={userPreferences.theme}
              onChange={(e) => setUserPreferences(prev => ({ ...prev, theme: e.target.value as 'light' | 'dark' | 'system' }))}
              aria-label={t('theme')}
            >
              <option value="light">Light</option>
              <option value="dark">Dark</option>
              <option value="system">System</option>
            </Select>
          </div>
          <div>
            <Label htmlFor="pref-autoRefresh">{t('autoRefresh')}</Label>
            <Input
              id="pref-autoRefresh"
              type="number"
              min="0"
              value={userPreferences.autoRefreshInterval}
              onChange={(e) => setUserPreferences(prev => ({ ...prev, autoRefreshInterval: Number(e.target.value) }))}
              aria-label={t('autoRefresh')}
            />
            <span className="ml-2 text-sm text-gray-500 dark:text-gray-400">{t('seconds')} (0 for disabled)</span>
          </div>
          <div className="flex items-center">
            <Checkbox
              id="pref-criticalAlerts"
              checked={userPreferences.notificationSettings.criticalAlerts}
              onChange={(e) => setUserPreferences(prev => ({ ...prev, notificationSettings: { ...prev.notificationSettings, criticalAlerts: e.target.checked } }))}
            />
            <Label htmlFor="pref-criticalAlerts" className="ml-2 cursor-pointer dark:text-gray-300">
              {t('criticalAlerts')}
            </Label>
          </div>
          <div className="flex items-center">
            <Checkbox
              id="pref-reconciliationReminders"
              checked={userPreferences.notificationSettings.reconciliationReminders}
              onChange={(e) => setUserPreferences(prev => ({ ...prev, notificationSettings: { ...prev.notificationSettings, reconciliationReminders: e.target.checked } }))}
            />
            <Label htmlFor="pref-reconciliationReminders" className="ml-2 cursor-pointer dark:text-gray-300">
              {t('reconciliationReminders')}
            </Label>
          </div>
          {/* Widget Order customization could be a drag-and-drop list here */}
        </div>
      </Modal>

      {/* Account Details Modal */}
      <Modal
        isOpen={isAccountDetailsModalOpen}
        onClose={() => setIsAccountDetailsModalOpen(false)}
        title={t('accountDetailsModalTitle', { accountName: selectedAccountForDetails?.bestName || '' })}
        footer={
          <>
            {permissions.canEditAccount && selectedAccountForDetails && (
              <Button onClick={() => handleEditAccount(selectedAccountForDetails)}>{t('edit')}</Button>
            )}
            <Button variant="secondary" onClick={() => setIsAccountDetailsModalOpen(false)}>{t('close')}</Button>
          </>
        }
      >
        {selectedAccountForDetails && (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <p><strong className="dark:text-white">{t('id')}:</strong> {selectedAccountForDetails.id}</p>
            <p><strong className="dark:text-white">{t('accountName')}:</strong> {selectedAccountForDetails.bestName}</p>
            <p><strong className="dark:text-white">{t('currency')}:</strong> {selectedAccountForDetails.currency}</p>
            <p><strong className="dark:text-white">{t('priorDayBalance')}:</strong> {selectedAccountForDetails.prettyPriorDayBalance}</p>
            <p><strong className="dark:text-white">{t('availableBalance')}:</strong> {selectedAccountForDetails.prettyAvailableBalance}</p>
            <p><strong className="dark:text-white">{t('ledgerVariance')}:</strong> {selectedAccountForDetails.prettyLedgerVariance}</p>
            <p><strong className="dark:text-white">{t('unreconciledAmount')}:</strong> {selectedAccountForDetails.prettyUnreconciledAmount}</p>
            <p><strong className="dark:text-white">{t('unreconciledPercent')}:</strong> {formatPercentage(selectedAccountForDetails.unreconciledPercent, i18n.language)}</p>
            <p><strong className="dark:text-white">{t('path')}:</strong> {selectedAccountForDetails.path}</p>
            <p><strong className="dark:text-white">{t('lastUpdated')}:</strong> {moment(selectedAccountForDetails.lastUpdated).format('YYYY-MM-DD HH:mm:ss')}</p>
            <p><strong className="dark:text-white">{t('status')}:</strong> <span className={`px-2 py-0.5 text-xs font-semibold rounded-full ${selectedAccountForDetails.status === 'ACTIVE' ? 'bg-green-100 text-green-800' : selectedAccountForDetails.status === 'PENDING_REVIEW' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800'} dark:bg-opacity-20`}>{selectedAccountForDetails.status}</span></p>
            <p><strong className="dark:text-white">{t('riskScore')}:</strong> <span className={`px-2 py-0.5 text-xs font-semibold rounded-full ${selectedAccountForDetails.riskScore === 'CRITICAL' ? 'bg-red-100 text-red-800' : selectedAccountForDetails.riskScore === 'HIGH' ? 'bg-orange-100 text-orange-800' : 'bg-green-100 text-green-800'} dark:bg-opacity-20`}>{selectedAccountForDetails.riskScore}</span></p>
            <p><strong className="dark:text-white">{t('complianceStatus')}:</strong> <span className={`px-2 py-0.5 text-xs font-semibold rounded-full ${selectedAccountForDetails.complianceStatus === 'NON_COMPLIANT' ? 'bg-red-100 text-red-800' : selectedAccountForDetails.complianceStatus === 'REVIEW_REQUIRED' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800'} dark:bg-opacity-20`}>{selectedAccountForDetails.complianceStatus}</span></p>
            <p><strong className="dark:text-white">{t('currentManager')}:</strong> {selectedAccountForDetails.responsibleManagerId}</p>
            <div className="col-span-full">
              <p><strong className="dark:text-white">{t('tags')}:</strong> {selectedAccountForDetails.tags.map(tag => <span key={tag} className="text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full mr-1 mb-1 inline-block dark:bg-blue-900 dark:text-blue-200">{tag}</span>)}</p>
            </div>
            <div className="col-span-full">
              <p><strong className="dark:text-white">{t('associatedBranches')}:</strong> {selectedAccountForDetails.associatedBranches.join(', ')}</p>
            </div>
            <div className="col-span-full">
              <p><strong className="dark:text-white">{t('customMetadata')}:</strong></p>
              <pre className="bg-gray-100 dark:bg-gray-700 p-2 rounded text-xs overflow-x-auto">
                {JSON.stringify(selectedAccountForDetails.customMetadata, null, 2)}
              </pre>
            </div>
          </div>
        )}
      </Modal>

      {/* Confirm Delete Modal */}
      <Modal
        isOpen={isConfirmDeleteModalOpen}
        onClose={() => setIsConfirmDeleteModalOpen(false)}
        title={t('confirmAction')}
        footer={
          <>
            <Button variant="secondary" onClick={() => setIsConfirmDeleteModalOpen(false)}>{t('cancel')}</Button>
            <Button variant="danger" onClick={handleDeleteAccount} disabled={loading}>{t('delete')}</Button>
          </>
        }
      >
        <p className="text-red-600 dark:text-red-400 text-lg">
          {t('confirmDelete')}
        </p>
        <p className="text-gray-700 dark:text-gray-300 mt-2">
          {accountToDelete?.bestName} ({accountToDelete?.id})
        </p>
        <p className="text-gray-500 dark:text-gray-400 text-sm mt-1">
          This action cannot be undone.
        </p>
      </Modal>

      {/* Audit Log Modal */}
      {permissions.canViewAuditLog && (
        <Modal
          isOpen={isAuditLogModalOpen}
          onClose={() => setIsAuditLogModalOpen(false)}
          title={t('auditLog')}
          footer={
            <Button onClick={() => setIsAuditLogModalOpen(false)}>{t('close')}</Button>
          }
        >
          <div className="max-h-96 overflow-y-auto">
            <table className="min-w-full text-xs text-left text-gray-500 dark:text-gray-400">
              <thead className="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400 sticky top-0">
                <tr>
                  <th scope="col" className="px-3 py-2">{t('date')}</th>
                  <th scope="col" className="px-3 py-2">{t('user')}</th>
                  <th scope="col" className="px-3 py-2">{t('action')}</th>
                  <th scope="col" className="px-3 py-2">{t('entity')}</th>
                  <th scope="col" className="px-3 py-2">{t('details')}</th>
                </tr>
              </thead>
              <tbody>
                {auditLogEntries.length === 0 ? (
                  <tr>
                    <td colSpan={5} className="px-3 py-2 text-center">No audit log entries.</td>
                  </tr>
                ) : (
                  auditLogEntries.map(entry => (
                    <tr key={entry.id} className="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
                      <td className="px-3 py-2">{moment(entry.timestamp).format('YYYY-MM-DD HH:mm:ss')}</td>
                      <td className="px-3 py-2">{entry.userId}</td>
                      <td className="px-3 py-2">{entry.action}</td>
                      <td className="px-3 py-2">{entry.entityType} ({entry.entityId})</td>
                      <td className="px-3 py-2 break-all text-ellipsis overflow-hidden max-w-xs">{JSON.stringify(entry.details)}</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
          <div className="flex justify-end mt-4">
            <Button variant="secondary" onClick={() => { /* Export audit log data */ addNotification('Exporting audit log...', 'info'); }}>{t('auditLogExport')}</Button>
          </div>
        </Modal>
      )}

      {/* Floating Action Button for Audit Log (optional, for quick access) */}
      {permissions.canViewAuditLog && (
        <div className="fixed bottom-6 right-6 z-40">
          <Button
            onClick={() => setIsAuditLogModalOpen(true)}
            className="rounded-full w-14 h-14 flex items-center justify-center text-lg shadow-lg hover:shadow-xl"
            aria-label={t('showAuditLog')}
          >
            📋
          </Button>
        </div>
      )}

    </div>
  );
};

// --- [9. Application Bootstrap] ---
// This is the entry point for rendering the React application.
// In a full commercial application, this might be in index.tsx or main.tsx.

if (typeof document !== 'undefined') {
  const rootElement = document.getElementById('root');
  if (!rootElement) {
    console.error('Root element not found. Please ensure an element with id="root" exists in your HTML.');
  } else {
    ReactDOM.createRoot(rootElement).render(
      <React.StrictMode>
        <AuthProvider>
          <ThemeProvider>
            <NotificationProvider>
              <AccountGroupMetricsHomeApp />
            </NotificationProvider>
          </ThemeProvider>
        </AuthProvider>
      </React.StrictMode>
    );
  }
}